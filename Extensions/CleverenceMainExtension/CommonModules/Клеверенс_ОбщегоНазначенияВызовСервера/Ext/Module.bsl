
// Выполняет инициализацию основного функционала расширения
//
Процедура Клеверенс_Инициализация() Экспорт
	
	//Получение из настроек
	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS();
	
	ТипИнтеграционнойОбработки 		= Неопределено;
	ПутьИнтеграционнойОбработки		= Неопределено;
	ОтключитьРаботуСКнопкамиОбмена	= Истина;
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда

		ПараметрыПодключенияMS.Свойство("ТипОбработки", 					ТипИнтеграционнойОбработки);			
		ПараметрыПодключенияMS.Свойство("ПутьИнтеграционнойОбработки", 		ПутьИнтеграционнойОбработки);
		Если ПараметрыПодключенияMS.Свойство("ОтключитьРаботуСКнопкамиОбмена") Тогда
			ОтключитьРаботуСКнопкамиОбмена = ПараметрыПодключенияMS.ОтключитьРаботуСКнопкамиОбмена;
		КонецЕсли;
			
	КонецЕсли;
		
	ВидыОбмена = Новый Массив;
	ВидыОбмена.Добавить("ЗагрузкаДокументов");
	ВидыОбмена.Добавить("ВыгрузкаДокументов");
	ВидыОбмена.Добавить("ВыгрузкаСправочников");
	ВидыОбмена.Добавить("ИменаФормЗагрузкиДокументов");
	ВидыОбмена.Добавить("ИменаФормВыгрузкиДокументов");
	ВидыОбмена.Добавить("МестаВстраиванияКнопкиЗагрузки");
	ВидыОбмена.Добавить("МестаВстраиванияКнопкиВыгрузки");
	
	ИмяПолныеПрава = ?(Метаданные.Роли.Найти("ПолныеПрава") = Неопределено, "FullAccess", "ПолныеПрава");
	
	Если ОтключитьРаботуСКнопкамиОбмена = Истина
		ИЛИ НЕ ЗначениеЗаполнено(ПутьИнтеграционнойОбработки) 
		ИЛИ (НЕ РольДоступна(ИмяПолныеПрава) И НЕ РольДоступна("Клеверенс_Кнопки")) Тогда
		
		// Очистка настроек имен объектов, участвующих в выгрузке/загрузке в MS
		Для каждого ВидОбмена ИЗ ВидыОбмена Цикл
			Клеверенс_ОбщегоНазначенияСервер.ОчиститьИменаОбъектовОбмена(ВидОбмена);
		КонецЦикла;	
	
	ИначеЕсли ОтключитьРаботуСКнопкамиОбмена = Ложь
		И ЗначениеЗаполнено(ПутьИнтеграционнойОбработки)
		И (РольДоступна(ИмяПолныеПрава) ИЛИ РольДоступна("Клеверенс_Кнопки")) Тогда
		
		ИнтеграционнаяОбработка = ПодключитьОбработкуНаСервере(ПутьИнтеграционнойОбработки, ТипИнтеграционнойОбработки);
		
		Если ИнтеграционнаяОбработка <> Неопределено Тогда
			// Запись в настройки имен объектов, участвующих в выгрузке/загрузке в MS
			Для каждого ВидОбмена ИЗ ВидыОбмена Цикл
				Клеверенс_ОбщегоНазначенияСервер.СохранитьИменаОбъектовОбмена(ИнтеграционнаяОбработка, ВидОбмена);
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;
	
	// Сохраним в хранилище пользователя структуру, которую будем использовать для хранения данных на время сеанса
	Клеверенс_ОбщегоНазначенияСервер.ГлЯдро_СохранитьДанныеВХранилище1С("CleverenceButtonsExtension_КэшДанных", Новый Структура);
	
КонецПроцедуры

// Проверяет, существует ли объект метаданных
//
// Параметры:
//  ПолноеИмя  - Строка - полное имя объекта метаданных (например, Справочник.Номенклатура, Документ.ПриемНаРаботу.)
//
// Возвращаемое значение:
//   Булево   - признак наличия объекта метаданных
//
Функция ПроверитьОбъектМетаданныхСуществует(ПолноеИмя) Экспорт
	
	ОбъектСуществует = Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено;
	
	Возврат ОбъектСуществует;
	
КонецФункции

Процедура ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньСтрокой, Комментарий)  Экспорт
	
    Клеверенс_ОбщегоНазначенияСервер.ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньСтрокой, Комментарий);
	
КонецПроцедуры

Функция ПолучитьСсылкуИзЗначенияСтрокиСписка(ЗначениеСтрокиСписка) Экспорт
    
	Попытка
		Ссылка = ЗначениеСтрокиСписка.Ссылка;
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
	
КонецФункции

// См. Клеверенс_ОбщегоНазначенияСервер.ПодключитьОбработку()
Функция ПодключитьОбработкуНаСервере(ПутьОбработки, ТипОбработки) Экспорт
	Возврат Клеверенс_ОбщегоНазначенияСервер.ПодключитьОбработку(ПутьОбработки, ТипОбработки);
КонецФункции

// См. Клеверенс_ОбщегоНазначенияСервер.ПодключитьОбработку()
Процедура ПодключитьОбработку(ПутьОбработки, ТипОбработки) Экспорт
	Клеверенс_ОбщегоНазначенияСервер.ПодключитьОбработку(ПутьОбработки, ТипОбработки);
КонецПроцедуры

Функция ПолучитьОбъектИнтеграционнойОбработки() Экспорт
	
	//Получение из настроек
	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS();
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда

		ТипИнтеграционнойОбработки 		= Неопределено;
		ПутьИнтеграционнойОбработки		= Неопределено;
		
		ПараметрыПодключенияMS.Свойство("ТипОбработки", 				ТипИнтеграционнойОбработки);			
		ПараметрыПодключенияMS.Свойство("ПутьИнтеграционнойОбработки", 	ПутьИнтеграционнойОбработки);
			
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ПутьИнтеграционнойОбработки) Тогда		
		ИнтеграционнаяОбработка = ПодключитьОбработкуНаСервере(ПутьИнтеграционнойОбработки, ТипИнтеграционнойОбработки);
	Иначе
		ИнтеграционнаяОбработка = Неопределено;
	КонецЕсли;
	
	Возврат ИнтеграционнаяОбработка;
		
КонецФункции

//Проверяет, созданы ли ПрофилиГруппДоступа и ГруппыДоступа для ролей Клеверенс
Процедура ПроверитьСоздатьПрофилиПользователей() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка	
		ВерсияСовместимости = СтрЗаменить(Метаданные.РежимСовместимости,"Версия","");
		ВерсияСовместимости = СтрЗаменить(ВерсияСовместимости, "Version", "");
		ВерсияМассив = СтрРазделить(ВерсияСовместимости,"_");
		
		ВерсияМассивЧисло= Новый Массив;
		Для Каждого Стр Из ВерсияМассив Цикл
			Стр = Число(Стр);
			ВерсияМассивЧисло.Добавить(Стр);
		КонецЦикла;
		
		Если НЕ (ВерсияМассивЧисло[0] >= 8 И ВерсияМассивЧисло[1] >= 3 И ВерсияМассивЧисло[2] >= 14)  Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Метаданные.Справочники.Найти("ГруппыДоступа") = Неопределено Тогда
		ENМетаданные = Истина;
		ИмяГруппыДоступа = "AccessGroups";
		ИмяПрофилиГруппДоступа = "AccessGroupProfiles";
		ИмяИдентификаторыОбъектовМетаданных = "MetadataObjectIDs";
		ИмяПрофиль = "Profile";
		НаименованиеГлавноеМеню = "Cleverence main menu";
		НаименованиеКнопкиДокументов = "Cleverence exchange buttons in documents";
	Иначе
		ENМетаданные = Ложь;
		ИмяГруппыДоступа = "ГруппыДоступа";
		ИмяПрофилиГруппДоступа = "ПрофилиГруппДоступа";
		ИмяИдентификаторыОбъектовМетаданных = "ИдентификаторыОбъектовМетаданных";
		ИмяПрофиль = "Профиль";
		НаименованиеГлавноеМеню = "Клеверенс главное меню";
		НаименованиеКнопкиДокументов = "Клеверенс кнопки в документах";
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти(ИмяПрофилиГруппДоступа) = Неопределено ИЛИ Метаданные.Справочники.Найти(ИмяГруппыДоступа) = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	СправочникИдентификаторыСуществует = Метаданные.Справочники.Найти(ИмяИдентификаторыОбъектовМетаданных) <> Неопределено;
	
	СправочникМенеджер = Справочники[ИмяПрофилиГруппДоступа]; 	
	
	ПроФильМеню = СправочникМенеджер.НайтиПоНаименованию(НаименованиеГлавноеМеню);
	ПроФильКнопок = СправочникМенеджер.НайтиПоНаименованию(НаименованиеКнопкиДокументов);
	
	Если (ПроФильМеню = СправочникМенеджер.ПустаяСсылка()) ИЛИ  (ПроФильКнопок = СправочникМенеджер.ПустаяСсылка()) Тогда
		
		ТипРолиВПрофилеГруппДоступа = Неопределено;
		
		СтараяКонфигурация = Ложь;
		
		Попытка
			Если ENМетаданные Тогда
				ТипРолиВПрофилеГруппДоступа = Тип(Метаданные.Справочники.AccessGroupProfiles.ТабличныеЧасти.Roles.Реквизиты.Role.Тип);
			Иначе
				ТипРолиВПрофилеГруппДоступа = Тип(Метаданные.Справочники.ПрофилиГруппДоступа.ТабличныеЧасти.Роли.Реквизиты.Роль.Тип);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		Если ТипРолиВПрофилеГруппДоступа = ТипЗнч("Строка") Тогда  //проверим тип значнеия роли в ПрофилеГруппыДоступа
			
			СтараяКонфигурация = Истина; 
			
			РольОсновное = "Клеверенс_Основное"; 
			РольГлавноеМеню= "Клеверенс_ГлавноеМеню";
			РольКнопки = "Клеверенс_Кнопки";
		Иначе
			
			Если ENМетаданные Тогда
				РольОсновное = "Role.Клеверенс_Основное"; 
				РольГлавноеМеню= "Role.Клеверенс_ГлавноеМеню";
				РольКнопки = "Role.Клеверенс_Кнопки";
			Иначе
				РольОсновное = "Роль.Клеверенс_Основное"; 
				РольГлавноеМеню= "Роль.Клеверенс_ГлавноеМеню";
				РольКнопки = "Роль.Клеверенс_Кнопки";
			КонецЕсли;
					
			Роли = Новый Массив;
			Роли.Добавить(РольОсновное);
			Роли.Добавить(РольГлавноеМеню);
			Роли.Добавить(РольКнопки);	
			
			Если СправочникИдентификаторыСуществует Тогда
				Попытка
					Если ENМетаданные Тогда
						ИдентификаторыРолей = Справочники[ИмяИдентификаторыОбъектовМетаданных].MetadataObjectIDs(Роли, ложь);
					Иначе
						ИдентификаторыРолей = Справочники[ИмяИдентификаторыОбъектовМетаданных].ИдентификаторыОбъектовМетаданных(Роли, ложь);
					КонецЕсли;
				Исключение
					Возврат
				КонецПопытки
			КонецЕсли;
			
		КонецЕсли;
		
		// Создаем ПрофильГруппыДоступа
		
		ТзПрофилиГрупп = Новый ТаблицаЗначений;
		ТзПрофилиГрупп.Колонки.Добавить("Имя");
		ТзПрофилиГрупп.Колонки.Добавить("Ссылка");
		ТзПрофилиГрупп.Колонки.Добавить("Роли");
		
		НовСтр= ТзПрофилиГрупп.Добавить();
		Новстр.Имя =НаименованиеГлавноеМеню;
		НовСтр.Ссылка = СправочникМенеджер.НайтиПоНаименованию(Новстр.Имя);
		РолиПрофиля = Новый Массив;
		РолиПрофиля.Добавить(РольОсновное);
		РолиПрофиля.Добавить(РольГлавноеМеню);
		НовСтр.роли = РолиПрофиля;
		
		НовСтр= ТзПрофилиГрупп.Добавить();
		Новстр.Имя = НаименованиеКнопкиДокументов;
		НовСтр.Ссылка = СправочникМенеджер.НайтиПоНаименованию(Новстр.Имя);
		РолиПрофиля = Новый Массив;
		РолиПрофиля.Добавить(РольОсновное);
		РолиПрофиля.Добавить(РольКнопки);
		НовСтр.роли = РолиПрофиля;
		
		Если ENМетаданные Тогда
			ИмяТЧНазначение = "Purpose";
			ИмяТЧРоли = "Roles";
			ИмяТипПользователей = "UsersType";
			ИмяРоль = "Role";
			ТипПользователей = ПредопределенноеЗначение("Справочник.Users.ПустаяСсылка")
		Иначе
			ИмяТЧНазначение = "Назначение";
			ИмяТЧРоли = "Роли";
			ИмяТипПользователей = "ТипПользователей";
			ИмяРоль = "Роль";
			ТипПользователей = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка")
		КонецЕсли;
		
		Для Каждого ПрофильГруппы Из ТзПрофилиГрупп Цикл
			Если ПрофильГруппы.Ссылка = СправочникМенеджер.ПустаяСсылка() Тогда
				
				НовОбъект = СправочникМенеджер.СоздатьЭлемент();
				НовОбъект.Наименование = ПрофильГруппы.имя;
				
				Если НЕ СтараяКонфигурация Тогда
					СтНазначение = НовОбъект[ИмяТЧНазначение].Добавить();    
					СтНазначение[ИмяТипПользователей] = ТипПользователей;
				КонецЕсли;
				
				Для Каждого Роль из ПрофильГруппы.Роли Цикл
					ДобавляемаяРоль = НовОбъект[ИмяТЧРоли].Добавить();
					Если СтараяКонфигурация Тогда
						ДобавляемаяРоль[ИмяРоль] = Роль;
					Иначе
						ЗначениеРоли = ИдентификаторыРолей.Получить(Роль);
						ДобавляемаяРоль[ИмяРоль] = ЗначениеРоли;
					КонецЕсли;
					НовОбъект.Записать();
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ПроФильМеню = СправочникМенеджер.НайтиПоНаименованию(НаименованиеГлавноеМеню); // обновим ссылки
		ПроФильКнопок = СправочникМенеджер.НайтиПоНаименованию(НаименованиеКнопкиДокументов);
	КонецЕсли;
	
	// Создаем ГруппыДоступа
	СправочникМенеджер = Справочники[ИмяГруппыДоступа];	
	
	ГруппаМеню = СправочникМенеджер.НайтиПоНаименованию(НаименованиеГлавноеМеню);
	ГруппаКнопок = СправочникМенеджер.НайтиПоНаименованию(НаименованиеКнопкиДокументов);
	
	Если ГруппаМеню = СправочникМенеджер.ПустаяСсылка() Тогда 
		НовГруппа = СправочникМенеджер.СоздатьЭлемент();
		НовГруппа.Наименование = НаименованиеГлавноеМеню;
		НовГруппа[ИмяПрофиль] = ПроФильМеню;
		НовГруппа.Записать();
	КонецЕсли;
	
	Если ГруппаКнопок = СправочникМенеджер.ПустаяСсылка() Тогда 
		НовГруппа = СправочникМенеджер.СоздатьЭлемент();
		НовГруппа.Наименование = НаименованиеКнопкиДокументов;
		НовГруппа[ИмяПрофиль] = ПроФильКнопок;
		НовГруппа.Наименование = ПроФильКнопок;
		НовГруппа.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

#Область ГлобальныйКонтекст

