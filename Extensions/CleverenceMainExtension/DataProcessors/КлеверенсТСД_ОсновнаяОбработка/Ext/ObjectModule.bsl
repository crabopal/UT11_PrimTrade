Процедура ГлЯдро_ДополнитьНоменклатуруИзображением(ТаблицаТоваров, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ДополнитьНоменклатуруИзображением";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТаблицаТоваров",
		ТаблицаТоваров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Попытка
		СтруктураПараметров = Новый Структура;
		СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
		Если ИнтеграционнаяОбработка <> Неопределено Тогда
			СтрокаВызова = ГлЯдро_СтрШаблон("Параметры.ИнтеграционнаяОбработка.ПолучитьИзображение(""%1"")", ТаблицаТоваров[0].Product_Id);
			СтруктураПараметров.Вставить("ИнтеграционнаяОбработка", ИнтеграционнаяОбработка);
			Изображение = ГлЯдро_ВычислитьВБезопасномРежиме(СтрокаВызова, СтруктураПараметров);
			Если Изображение <> "" Тогда
				ТаблицаТоваров.Колонки.Добавить("Product_Изображение", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));	
			КонецЕсли;
			ТаблицаТоваров.ЗаполнитьЗначения(Изображение, "Product_Изображение"); 
		КонецЕсли;
	Исключение
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Ошибка при вызове функции: %1';
							|en = 'Error when calling the function: %1'; be = 'Памылка пры выкліку функцыі: %1'; es = 'Error al llamar a la función: %1'; ka = 'შეცდომა ფუნქციის გამოძახებისას: %1'; kk = 'Функцияны шақыру кезінде қате: %1'; ro = 'Eroare la apelarea funcției: %1'; tr = 'İşlev çağrılırken hata oluştu: %1'; uk = 'Помилка виклику функції: %1'; uz = 'Funktsiyani chaqirishda xato: %1'";
		пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяСобытия);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ИмяСобытия",
			ИмяСобытия);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
	КонецПопытки;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область REST_API

// Возвращает тип установленного продукта по коду продукта из BaseInfo (productCode).
//
// Параметры:
//	КодПродукта - Строка - код продукта, например "WH15", "RTL15".
//
// Возвращаемое значение:
//	Строка - "Склад", "Магазин", "Прайсчекер", "Курьер", "Фабрика" или пустая строка, если код неизвестен/не задан.
Функция ГлЯдро_ПолучитьТипПродуктаПоКодуПродукта(КодПродукта) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодПродукта) Тогда
		Возврат "";
	КонецЕсли;
	
	КодПродукта = ВРег(СокрЛП(КодПродукта));
	
	ТипПродукта = "";
	Если КодПродукта = "WH15" Тогда
		ТипПродукта = "Склад";
	ИначеЕсли КодПродукта = "RTL15" Тогда
		ТипПродукта = "Магазин";
	ИначеЕсли КодПродукта = "PC15" Тогда
		ТипПродукта = "Прайсчекер";
	ИначеЕсли КодПродукта = "EXPR" ИЛИ КодПродукта = "EXPR15" Тогда
		ТипПродукта = "Курьер";
	ИначеЕсли КодПродукта = "FC15" Тогда
		ТипПродукта = "Фабрика";
	КонецЕсли;
	
	Возврат ТипПродукта;
	
КонецФункции

// Возвращает уровень приложения строкой по коду уровня продукта из BaseInfo (productLevelCode).
//
// Параметры:
//	КодУровняПродукта - Строка - код уровня продукта.
//
// Возвращаемое значение:
//	Строка - "Минимум", "Базовый", "Расширенный", "Полный" или пустая строка (если маппинг не задан/код неизвестен).
Функция ГлЯдро_ПолучитьУровеньПродуктаПоКодуПродукта(КодУровняПродукта) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодУровняПродукта) Тогда
		Возврат "";
	КонецЕсли;
	
	КодУровняПродукта = ВРег(СокрЛП(КодУровняПродукта));
	
	УровеньПриложения = "";
	
	// Маппинг кодов уровней продукта (productLevelCode) нужно заполнить отдельно.
	// Пока маппинг не задан — возвращаем пустую строку, чтобы отработал существующий fallback по старым правилам.
	
	Возврат УровеньПриложения;
	
КонецФункции

Функция REST_API_ПолучитьОписаниеБазы(ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьОписаниеБазы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера") Тогда
		ТекстОшибки = "Произошла ошибка при подключении к базе Клеверенс. Подробности см. в журнале регистрации";
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("ТекстСообщения", ТекстОшибки);
		
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаПодключения = СтруктураПодключения.СтрокаПодключенияСМАРТС;
	
	ОписаниеБазы = СтруктураОтвета.ОтветСервера;
	appDescription = ОписаниеБазы.Получить("appDescription");
	
	СтруктураДанныеБазы = Новый Структура;
	
	СтруктураДанныеБазы.Вставить("Ид", 						ОписаниеБазы.Получить("id"));
	СтруктураДанныеБазы.Вставить("Имя", 					ОписаниеБазы.Получить("name"));
	СтруктураДанныеБазы.Вставить("Комментарий", 			ОписаниеБазы.Получить("comment"));
	СтруктураДанныеБазы.Вставить("СтрокаПодключения", 		СтрокаПодключения);
	СтруктураДанныеБазы.Вставить("РабочийКаталог", 			ОписаниеБазы.Получить("folder"));
	СтруктураДанныеБазы.Вставить("ИдПриложения", 			ОписаниеБазы.Получить("appId"));
	СтруктураДанныеБазы.Вставить("ИмяПриложения", 			ОписаниеБазы.Получить("appName"));
	СтруктураДанныеБазы.Вставить("УровеньПриложения", 		100); 			// ОписаниеБазы.Получить("appLevel")); Пока не реализованно
	СтруктураДанныеБазы.Вставить("ИдОсновногоПриложения", 	Неопределено); 	// ОписаниеБазы.Приложение.ParentId); Пока не реализованно
	СтруктураДанныеБазы.Вставить("ПапкаОбмена", 			""); 			// НастройкиБазыСМАРТС.ПолучитьТекущуюПапкуОбмена()); Пока не реализованно
	
	ИнформацияОПродукте = ГлЯдро_ПолучитьИнформациюОПродукте(СтруктураДанныеБазы);
	
	КодПродукта = appDescription.Получить("productCode");
	Если ЗначениеЗаполнено(КодПродукта) Тогда
		
		ТипПоКодуПродукта = ГлЯдро_ПолучитьТипПродуктаПоКодуПродукта(КодПродукта);
		Если ЗначениеЗаполнено(ТипПоКодуПродукта) Тогда
			ИнформацияОПродукте.Вставить("ТипУстановленногоПродукта", ТипПоКодуПродукта);
		КонецЕсли;
		
	КонецЕсли;
	
	КодУровняПродукта = appDescription.Получить("productLevelCode");
	Если ЗначениеЗаполнено(КодУровняПродукта) Тогда
		
		УровеньПоКодуПродукта = ГлЯдро_ПолучитьУровеньПродуктаПоКодуПродукта(КодУровняПродукта);
		Если ЗначениеЗаполнено(УровеньПоКодуПродукта) Тогда
			ИнформацияОПродукте.Вставить("УровеньПриложения", УровеньПоКодуПродукта);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДанныеБазы.Вставить("УровеньПриложенияСтрокой", 	?(ЗначениеЗаполнено(ИнформацияОПродукте.УровеньПриложения), ИнформацияОПродукте.УровеньПриложения, ГлЯдро_ПолучитьУровеньПриложения(СтруктураДанныеБазы.УровеньПриложения)));
	СтруктураДанныеБазы.Вставить("ТипУстановленногоПродукта", 	ИнформацияОПродукте.ТипУстановленногоПродукта);
	СтруктураДанныеБазы.Вставить("АвторизацияВключена", 		Ложь);
	СтруктураДанныеБазы.Вставить("АвторизацияТокен", 			"");
	СтруктураДанныеБазы.Вставить("АвторизацияРефрешТокен", 		"");
	СтруктураДанныеБазы.Вставить("АвторизацияТип", 				Неопределено);
	СтруктураДанныеБазы.Вставить("СтрокаПодключенияСМАРТС", 	СтрокаПодключения);
	СтруктураДанныеБазы.Вставить("IdBaseSMARTS", 				ОписаниеБазы.Получить("id"));
	СтруктураДанныеБазы.Вставить("QR", 							ОписаниеБазы.Получить("connectionQRCode"));
	СтруктураДанныеБазы.Вставить("ВерсияПриложения", 			ОписаниеБазы.Получить("appDescription").Получить("appVersion"));
	СтруктураДанныеБазы.Вставить("ВерсияКонфигурацииSMARTS", 	ОписаниеБазы.Получить("configurationVersion"));
	СтруктураДанныеБазы.Вставить("ВерсияПлатформыSMARTS", 		ОписаниеБазы.Получить("serverVersion"));
	СтруктураДанныеБазы.Вставить("ИдСервераSMARTS", 			ОписаниеБазы.Получить("serverId"));
	СтруктураДанныеБазы.Вставить("REST_API_Версия", 			ГлЯдро_ВерсияAPIПоДаннымБазыSMARTS(СтруктураДанныеБазы.ВерсияПлатформыSMARTS, АдресаПеременных));
	
	Если НЕ ЗначениеЗаполнено(СтруктураДанныеБазы.ИмяПриложения) Тогда
		СтруктураДанныеБазы.Вставить("ИмяПриложения", ОписаниеБазы.Получить("appDescription").Получить("appName"));
	КонецЕсли;
	
	appInstanceSettings = ОписаниеБазы.Получить("appInstanceSettings");
	Если appInstanceSettings <> Неопределено Тогда
		mode = appInstanceSettings.Получить("mode");
		СтруктураДанныеБазы.Вставить("РаботаСУстройствомНапрямую", 	mode = "Device");
		СтруктураДанныеБазы.Вставить("РаботаСКаталогом", 			mode = "Folder");
		СтруктураДанныеБазы.Вставить("РаботаССервером", 			mode = "Server");
		СтруктураДанныеБазы.Вставить("РаботаСЛокальнымСервером", 	Неопределено);
		СтруктураДанныеБазы.Вставить("РаботаСУдаленнымСервером", 	Неопределено);
	КонецЕсли;
	
	Если СтруктураПодключения.Свойство("АвторизацияВключена")
		И СтруктураПодключения.АвторизацияВключена = Истина Тогда
		СтруктураДанныеБазы.АвторизацияВключена = Истина;
		
		КопируемыеСвойства = Новый Массив;
		КопируемыеСвойства.Добавить("АвторизацияТокен");
		КопируемыеСвойства.Добавить("АвторизацияРефрешТокен");
		КопируемыеСвойства.Добавить("АвторизацияТип");
		
		Для Каждого КопируемоеСвойство Из КопируемыеСвойства Цикл
			Если СтруктураПодключения.Свойство(КопируемоеСвойство) Тогда
				СтруктураДанныеБазы[КопируемоеСвойство] = СтруктураПодключения[КопируемоеСвойство];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ИмяИнтеграционнойОбработкиКонфигурации1С", 	Неопределено);
	СтруктураНастроек.Вставить("ПутьИнтеграционнойОбработкиКонфигурации1С", Неопределено);
	СтруктураНастроек.Вставить("ТипОбработки", 								Неопределено);
	СтруктураНастроек.Вставить("ПутьОсновнойОбработки", 					Неопределено);
	СтруктураНастроек.Вставить("ТипОсновнойОбработки", 						Неопределено);
	СтруктураНастроек.Вставить("ОтключитьРаботуСКнопкамиОбмена", 			Истина);
	
	ПараметрыЗаполненияНастроек = Новый Структура;
	ПараметрыЗаполненияНастроек.Вставить("СтруктураПодключения", СтруктураПодключения);
	ПараметрыЗаполненияНастроек.Вставить("НеИспользоватьАтрибуты", Истина);
	
	REST_API_ЗаполнитьНастройкиSMARTS(СтруктураНастроек,,, ПараметрыЗаполненияНастроек, АдресаПеременных);
	
	ИмяИнтеграционнойОбработки 		= СтруктураНастроек.ИмяИнтеграционнойОбработкиКонфигурации1С;
	ПутьИнтеграционнойОбработки 	= СтруктураНастроек.ПутьИнтеграционнойОбработкиКонфигурации1С;
	ТипОбработки 					= СтруктураНастроек.ТипОбработки;
	ПутьОсновнойОбработки 			= СтруктураНастроек.ПутьОсновнойОбработки;
	ТипОсновнойОбработки 			= СтруктураНастроек.ТипОсновнойОбработки;
	ОтключитьРаботуСКнопкамиОбмена 	= СтруктураНастроек.ОтключитьРаботуСКнопкамиОбмена;
	
	Если ТипОбработки = "СправочникСсылка" Тогда
		Попытка
			ПутьИО = ГлЯдро_ЗначениеИзСтрокиXML(ПутьИнтеграционнойОбработки);
		Исключение
			ПутьИО = Неопределено;
		КонецПопытки;
	Иначе
		ПутьИО = ПутьИнтеграционнойОбработки;
	КонецЕсли;
	
	// Заплатка
	Если ТипЗнч(ПутьИО) = Тип("COMОбъект") Тогда
		ПутьИО = Неопределено;
	КонецЕсли;
	
	СтруктураДанныеБазы.Вставить("ТипОбработки", ?(ЗначениеЗаполнено(ТипОбработки),
		ТипОбработки, "ФайлНаДиске"));
	СтруктураДанныеБазы.Вставить("ИмяИнтеграционнойОбработки", ?(ЗначениеЗаполнено(ИмяИнтеграционнойОбработки),
		ИмяИнтеграционнойОбработки, ""));
	СтруктураДанныеБазы.Вставить("ПутьИнтеграционнойОбработки", ?(ЗначениеЗаполнено(ПутьИО),
		ПутьИО, "\Обработки 1С\Integrations\"));
		
	Если ТипОсновнойОбработки = "СправочникСсылка" Тогда
		Попытка
			ПутьОО = ГлЯдро_ЗначениеИзСтрокиXML(ПутьОсновнойОбработки);
		Исключение
			ПутьОО = Неопределено;
		КонецПопытки;
	Иначе
		ПутьОО = ПутьОсновнойОбработки;
	КонецЕсли;
	
	// Заплатка
	Если ТипЗнч(ПутьОО) = Тип("COMОбъект") Тогда
		ПутьОО = Неопределено;
	КонецЕсли;
	
	СтруктураДанныеБазы.Вставить("ТипОсновнойОбработки", 			ТипОсновнойОбработки);
	СтруктураДанныеБазы.Вставить("ПутьОсновнойОбработки", 			ПутьОО);
	СтруктураДанныеБазы.Вставить("ОтключитьРаботуСКнопкамиОбмена", 	ОтключитьРаботуСКнопкамиОбмена);
	
	СтруктураДанныеБазы.Вставить("ОнлайнОбменАктивен", REST_API_ОнлайнОбменАктивен(СтруктураПодключения, АдресаПеременных));
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанныеБазы);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураДанныеБазы;
	
КонецФункции

// Проверяет активность онлайн обмена SMARTS с базой 1С
//
// Параметры:
//  СтруктураПодключения - Структура - структура подключения к базе SMARTS
//  АдресаПеременных     - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//  Булево, Неопределено - Истина/Ложь по значению connected из ответа сервера,
//                         Неопределено если эндпоинт недоступен.
//
Функция REST_API_ОнлайнОбменАктивен(СтруктураПодключения, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ОнлайнОбменАктивен";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения",
		СтруктураПодключения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
	СтруктураЗапроса.Вставить("Метод", 		"Operations/CheckConnection");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, Новый Структура, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния)
		ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера") Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ОтветСервера = СтруктураОтвета.ОтветСервера;
	Если ТипЗнч(ОтветСервера) <> Тип("Соответствие") Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ОбменАктивен = ОтветСервера.Получить("enabled") = Истина;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ОбменАктивен);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ОбменАктивен;
	
КонецФункции

Функция REST_API_ПолучитьЗначениеНастройкиБазыSMARTS(СтруктураПодключения, КлючНастройки, ID_Узла, ДополнительныеПараметры, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьЗначениеНастройкиБазыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,КлючНастройки,ID_Узла,ДополнительныеПараметры",
		СтруктураПодключения, КлючНастройки, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ЗначениеПоУмолчанию = Новый Соответствие;
	
	СтрокаФильтра = "?$filter=" + REST_API_ПолучитьСтрокуФильтраПоКлючуНастройки(КлючНастройки, ID_Узла, ДополнительныеПараметры);
	
	КодыОшибок = Новый Соответствие;
	КодыОшибок.Вставить(404, "Информация");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод",	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"CustomSettings" + СтрокаФильтра);
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
	СтруктураЗапроса.Вставить("УровеньЖурналаКодыОшибок", КодыОшибок);
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначениеПоУмолчанию);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	МассивРезультат = СтруктураОтвета.ОтветСервера.Получить("value");
	Если НЕ МассивРезультат.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначениеПоУмолчанию);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивРезультат[0]);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивРезультат[0];
	
КонецФункции

Функция REST_API_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS = Неопределено, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	Перем ТипБазы, СтруктураПодключения, НеИспользоватьАтрибуты;
	
	ИмяСобытия = "REST_API_ЗаполнитьНастройкиSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры.Свойство("ТипБазы", 				ТипБазы);
		ДополнительныеПараметры.Свойство("СтруктураПодключения",	СтруктураПодключения);
		ДополнительныеПараметры.Свойство("НеИспользоватьАтрибуты",	НеИспользоватьАтрибуты);
	КонецЕсли;
	
	Если ТипБазы = Неопределено Тогда
		ТипБазы = "Основная";
	КонецЕсли;
	
	Если СтруктураПодключения = Неопределено Тогда
		Если ТипБазы = "Частная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
		ИначеЕсли ТипБазы = "Временная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
		Иначе
			КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
		КонецЕсли;
		
		СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных); 
	КонецЕсли;
	
	Если СтруктураПодключения = Неопределено Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		Возврат Неопределено;
	КонецЕсли;
	
	Если НеИспользоватьАтрибуты = Неопределено Тогда
		НеИспользоватьАтрибуты = Ложь;	
	КонецЕсли;
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
		Если КатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
		КонецЕсли;
	КонецЕсли;
	
	УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
	НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
	НастройкиПоУмолчанию = КатегорииНастроекMS.НастройкиПоУмолчанию;
	ИспользуютсяАтрибуты = ВерсияAPI = 2 И НЕ НеИспользоватьАтрибуты;
	
	АтрибутыНастроекMS_Default = Неопределено;
	АтрибутыНастроекMS_Custom = Неопределено;
	
	Если ИспользуютсяАтрибуты Тогда
		АтрибутыНастроекMS_Default = ГлЯдро_ПолучитьАтрибутыНастроекMS(, Истина, АдресаПеременных);
		
		ПроверятьОбеВерсииСтруктуры = Ложь;
		Если ДополнительныеПараметры.Свойство("АтрибутыНастроекMS", АтрибутыНастроекMS_Custom) Тогда
			ПроверятьОбеВерсииСтруктуры = Истина;
		Иначе	
			АтрибутыНастроекMS_Custom = ГлЯдро_ПолучитьАтрибутыНастроекMS(,, АдресаПеременных);
			
			ВерсияСтруктурыАтрибутов_Default = КомЯдро_ПолучитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_ПоУмолчанию", АдресаПеременных);
			ВерсияСтруктурыАтрибутов_Custom = КомЯдро_ПолучитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_Пользовательские", АдресаПеременных);
			Если НЕ ВерсияСтруктурыАтрибутов_Default = ВерсияСтруктурыАтрибутов_Custom Тогда
				ПроверятьОбеВерсииСтруктуры = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверятьОбеВерсииСтруктуры Тогда
			ПроверяемыеСтруктурыАтрибутовMS = Новый Массив;
			ПроверяемыеСтруктурыАтрибутовMS.Добавить(АтрибутыНастроекMS_Default);
			ПроверяемыеСтруктурыАтрибутовMS.Добавить(АтрибутыНастроекMS_Custom);
		Иначе
			ПроверяемыеСтруктурыАтрибутовMS = АтрибутыНастроекMS_Custom;
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторыНастроекMS = Новый Структура;
	
	КодыОшибок = Новый Соответствие;
	КодыОшибок.Вставить(404, "Информация");
	
	//Пока не реализованно получение настроек по умолчанию
	Если Ложь И СтруктураНастроек.Количество() > 3 Тогда
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
		СтруктураЗапроса.Вставить("Метод", 		"CustomSettings");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
		СтруктураЗапроса.Вставить("УровеньЖурналаКодыОшибок", КодыОшибок);
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("УровеньЖурнала", КодыОшибок.Получить(СтруктураОтвета.КодСостояния));
			
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
			Возврат Неопределено;
		КонецЕсли;
		
		МассивНастроек = СтруктураОтвета.ОтветСервера.Получить("value");	
		Для каждого СоответствиеНастройка Из МассивНастроек Цикл
			ИтоговыйКлючНастройки = REST_API_ПолучитьКлючНастройкиПоАтрибутам(СоответствиеНастройка, ID_Узла, ПроверяемыеСтруктурыАтрибутовMS);
			
			Если СтруктураНастроек.Свойство(ИтоговыйКлючНастройки) Тогда
				ЗначениеНастройки = СоответствиеНастройка.Получить("value");
				УИДНастройки = СоответствиеНастройка.Получить("uid");
				
				// Для совместимости со старыми настройками
				Если ЗначениеНастройки = Неопределено 
					И Найти(ИтоговыйКлючНастройки, "ПроизвольныеКоды_") > 0 Тогда
					ПараметрыФильтра = Новый Структура;	
					ПараметрыФильтра.Вставить("ИспользоватьАтрибуты", Ложь);
					ПараметрыФильтра.Вставить("КатегорииНастроекMS",  КатегорииНастроекMS);
					ПараметрыФильтра.Вставить("АтрибутыНастроекMS",	  Неопределено);
					
					СоответствиеНастройка = REST_API_ПолучитьЗначениеНастройкиБазыSMARTS(СтруктураПодключения,
						СтрЗаменить(ИтоговыйКлючНастройки, "ПроизвольныеКоды_", "ПроизвольныйКод_"), ID_Узла, ПараметрыФильтра, АдресаПеременных);
					ЗначениеНастройки = СоответствиеНастройка.Получить("value");
					УИДНастройки = СоответствиеНастройка.Получить("uid");
				КонецЕсли;
				// Для совместимости со старыми настройками
				Если ЗначениеНастройки = "Да" Тогда
					ЗначениеНастройки = Истина;
				ИначеЕсли ЗначениеНастройки = "Нет" Тогда
					ЗначениеНастройки = Ложь;	
				КонецЕсли;
				СтруктураНастроек.Вставить(ИтоговыйКлючНастройки, ЗначениеНастройки);
				
				Если ВерсияAPI = 2 Тогда
					ИдентификаторНастройкиMS = ИтоговыйКлючНастройки;
					Если НЕ УзловыеНастройки.Найти(ИдентификаторНастройкиMS) = Неопределено Тогда
						ИдентификаторНастройкиMS = ИдентификаторНастройкиMS + ?(ID_Узла = "", "", "_" + ID_Узла);
					КонецЕсли;
					
					ИдентификаторыНастроекMS.Вставить(ИдентификаторНастройкиMS, УИДНастройки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли СтруктураНастроек.Количество() Тогда
		//Получение настроек по фильтру
		СтрокаФильтра = "?$filter=";
		ПервыйПараметр = Истина;
		Икс=0;
		МассивНастроек = Новый Массив;
		Для Каждого Настройка Из СтруктураНастроек Цикл
			ИспользоватьАтрибуты = Ложь;
			Если ИспользуютсяАтрибуты Тогда
				АтрибутыНастроекMS = ?(НастройкиПоУмолчанию.Найти(Настройка.Ключ) = Неопределено,
				    АтрибутыНастроекMS_Custom,
					АтрибутыНастроекMS_Default);
					
				Если НЕ АтрибутыНастроекMS = Неопределено Тогда
					ИспользоватьАтрибуты = Истина;
				КонецЕсли;
			КонецЕсли;
			
			ПараметрыФильтра = Новый Структура;	
			ПараметрыФильтра.Вставить("ИспользоватьАтрибуты", ИспользоватьАтрибуты);
			ПараметрыФильтра.Вставить("КатегорииНастроекMS",  КатегорииНастроекMS);
			ПараметрыФильтра.Вставить("АтрибутыНастроекMS",	  АтрибутыНастроекMS);
			
			ДополнениеФильтра = REST_API_ПолучитьСтрокуФильтраПоКлючуНастройки(Настройка.Ключ, ID_Узла, ПараметрыФильтра);
			
			СтрокаФильтра = СтрокаФильтра + ?(НЕ ПервыйПараметр, " or ", "") + ДополнениеФильтра;
			Если ПервыйПараметр Тогда
				ПервыйПараметр = Ложь;
			КонецЕсли;
			Икс=Икс+1;
			Если Икс = 5 ИЛИ Икс = СтруктураНастроек.Количество() Тогда
				Если СтрокаФильтра = "?$filter=" Тогда
					ПервыйПараметр = Истина;
					Икс = 0;	
					Продолжить;
				КонецЕсли;
				СтруктураЗапроса = Новый Структура;
				СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
				СтруктураЗапроса.Вставить("Метод", 		"CustomSettings" + СтрокаФильтра);
				СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
				СтруктураЗапроса.Вставить("УровеньЖурналаКодыОшибок", КодыОшибок);
				
				СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
				СтрокаФильтра = "?$filter=";
				ПервыйПараметр = Истина;
				Икс=0;
				Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
					ПараметрыЗаписи = Новый Структура;
					ПараметрыЗаписи.Вставить("УровеньЖурнала", КодыОшибок.Получить(СтруктураОтвета.КодСостояния));
					
					REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
					Продолжить;
				КонецЕсли;
				МассивРезультат = СтруктураОтвета.ОтветСервера.Получить("value");
				Для каждого Настройка из МассивРезультат Цикл
					МассивНастроек.Добавить(Настройка);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаФильтра <> "?$filter=" Тогда
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
			СтруктураЗапроса.Вставить("Метод", 		"CustomSettings" + СтрокаФильтра);
			СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
			СтруктураЗапроса.Вставить("УровеньЖурналаКодыОшибок", КодыОшибок);
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
			
			Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("УровеньЖурнала", КодыОшибок.Получить(СтруктураОтвета.КодСостояния));
				
				REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
				//Возврат Неопределено;
			Иначе
				МассивРезультат = СтруктураОтвета.ОтветСервера.Получить("value");
				Для каждого Настройка из МассивРезультат Цикл
					МассивНастроек.Добавить(Настройка);
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		
		Для каждого СоответствиеНастройка Из МассивНастроек Цикл
			ИтоговыйКлючНастройки = REST_API_ПолучитьКлючНастройкиПоАтрибутам(СоответствиеНастройка, ID_Узла, ПроверяемыеСтруктурыАтрибутовMS);
			
			Если СтруктураНастроек.Свойство(ИтоговыйКлючНастройки) Тогда
				ЗначениеНастройки = СоответствиеНастройка.Получить("value");
				УИДНастройки = СоответствиеНастройка.Получить("uid");
				
				// Для совместимости со старыми настройками
				Если ЗначениеНастройки = Неопределено 
					И Найти(ИтоговыйКлючНастройки, "ПроизвольныеКоды_") > 0 Тогда
					ПараметрыФильтра = Новый Структура;	
					ПараметрыФильтра.Вставить("ИспользоватьАтрибуты", Ложь);
					ПараметрыФильтра.Вставить("КатегорииНастроекMS",  КатегорииНастроекMS);
					ПараметрыФильтра.Вставить("АтрибутыНастроекMS",	  Неопределено);
					
					СоответствиеНастройка = REST_API_ПолучитьЗначениеНастройкиБазыSMARTS(СтруктураПодключения,
						СтрЗаменить(ИтоговыйКлючНастройки, "ПроизвольныеКоды_", "ПроизвольныйКод_"), ID_Узла, ПараметрыФильтра, АдресаПеременных);
					ЗначениеНастройки = СоответствиеНастройка.Получить("value");
					УИДНастройки = СоответствиеНастройка.Получить("uid");
				КонецЕсли;
				// Для совместимости со старыми настройками
				Если ЗначениеНастройки = "Да" Тогда
					ЗначениеНастройки = Истина;
				ИначеЕсли ЗначениеНастройки = "Нет" Тогда
					ЗначениеНастройки = Ложь;	
				КонецЕсли;
				СтруктураНастроек.Вставить(ИтоговыйКлючНастройки, ЗначениеНастройки);
				
				Если ВерсияAPI = 2 Тогда
					ИдентификаторНастройкиMS = ИтоговыйКлючНастройки;
					Если НЕ УзловыеНастройки.Найти(ИдентификаторНастройкиMS) = Неопределено Тогда
						ИдентификаторНастройкиMS = ИдентификаторНастройкиMS + ?(ID_Узла = "", "", "_" + ID_Узла);
					КонецЕсли;
					
					ИдентификаторыНастроекMS.Вставить(ИдентификаторНастройкиMS, УИДНастройки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИдентификаторыНастроекMS.Количество() Тогда
		ГлЯдро_СохранитьИдентификаторыНастроекMS(ИдентификаторыНастроекMS, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции

Функция REST_API_ПолучитьАтрибутыПоКлючуНастройки(КлючНастройки, АтрибутыНастроекMS, СоответствиеАтрибутов = Неопределено)

	Если СоответствиеАтрибутов = Неопределено Тогда
		СоответствиеАтрибутов = Новый Соответствие;
	КонецЕсли;
	
	Если ПустаяСтрока(КлючНастройки) Тогда
		Возврат СоответствиеАтрибутов;
	КонецЕсли;
	
	ЧастиИмени = ГлЯдро_СтрРазделить(КлючНастройки, "_");
	
	БазовоеИмя = ЧастиИмени[0];
	
	СоответствиеАтрибутов.Вставить("name", БазовоеИмя);
	
	СтруктураАтрибутов = АтрибутыНастроекMS.Получить(БазовоеИмя);
	Если СтруктураАтрибутов = Неопределено Тогда
		Возврат СоответствиеАтрибутов;
	КонецЕсли;
	
	// Заполним значения атрибутов из имени по совпадениям с допустимыми значениями
	Для каждого СвойстваАтрибута ИЗ СтруктураАтрибутов Цикл
		СоответствиеАтрибутов.Вставить(СвойстваАтрибута.Ключ, "Empty");
		
		ВозможныеЗначения = СвойстваАтрибута.Значение;
		Для каждого ПроверяемоеЗначение ИЗ ВозможныеЗначения Цикл
			НайденныйЭлемент = ЧастиИмени.Найти(ПроверяемоеЗначение);
			
			Если НЕ НайденныйЭлемент = Неопределено Тогда
				СоответствиеАтрибутов.Вставить(СвойстваАтрибута.Ключ, ПроверяемоеЗначение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СоответствиеАтрибутов;

КонецФункции

Функция REST_API_ПолучитьСтрокуФильтраПоКлючуНастройки(КлючНастройки, ID_Узла = "", ДополнительныеПараметры)

	Перем ИспользоватьАтрибуты, КатегорииНастроекMS, АтрибутыНастроекMS;
	
	ДополнительныеПараметры.Свойство("ИспользоватьАтрибуты", ИспользоватьАтрибуты);
	ДополнительныеПараметры.Свойство("КатегорииНастроекMS",  КатегорииНастроекMS);
	ДополнительныеПараметры.Свойство("АтрибутыНастроекMS", 	 АтрибутыНастроекMS);
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
	
	СтрокаФильтра = "";
	
	ЭтоУзловаяНастройка = НЕ УзловыеНастройки.Найти(КлючНастройки) = Неопределено;
			
	Если ИспользоватьАтрибуты Тогда
		ЭтоНастройкаСАтрибутами = НЕ НастройкиСАтрибутами.Найти(КлючНастройки) = Неопределено;
		
		Если ЭтоНастройкаСАтрибутами Тогда
			СоответствиеАтрибутов = REST_API_ПолучитьАтрибутыПоКлючуНастройки(КлючНастройки, АтрибутыНастроекMS);
			Для каждого ДанныеАтрибута ИЗ СоответствиеАтрибутов Цикл
				СтрокаФильтра = СтрокаФильтра + ?(ПустаяСтрока(СтрокаФильтра), "", " and ")
					+ ГлЯдро_СтрШаблон("%1 eq '%2'", ДанныеАтрибута.Ключ, ДанныеАтрибута.Значение);
			КонецЦикла;
		Иначе
			СтрокаФильтра = ГлЯдро_СтрШаблон("%1 eq '%2'", "name", КлючНастройки);
		КонецЕсли;
			
		Если ЭтоУзловаяНастройка Тогда
			СтрокаФильтра = СтрокаФильтра + " and " + ГлЯдро_СтрШаблон("%1 eq '%2'", "nodeId", ?(ID_Узла = "", "Empty", ID_Узла));
		КонецЕсли;
	Иначе
		ИтоговыйКлючНастройки = КлючНастройки;
		Если ЭтоУзловаяНастройка Тогда
			ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
		КонецЕсли;
				
		СтрокаФильтра = ГлЯдро_СтрШаблон("%1 eq '%2'", "name", ИтоговыйКлючНастройки);
	КонецЕсли;	
	
	Возврат СтрокаФильтра;
	
КонецФункции

Функция REST_API_ПолучитьКлючНастройкиПоАтрибутам(СоответствиеНастройка, ID_Узла = "", ПроверяемыеАтрибутыMS)

	ИтоговыйКлючНастройки = СоответствиеНастройка.Получить("name");
	
	Если НЕ ПустаяСтрока(ID_Узла) Тогда
		ИтоговыйКлючНастройки = СтрЗаменить(ИтоговыйКлючНастройки, "_" + ID_Узла, "");
	КонецЕсли;
	
	// Мы не знаем, откуда была получена настройка (CustomSettings или CustomSettings.Dflt), поэтому получаем структуру атрибутов по фактическому составу атрибутов
	Если ТипЗнч(ПроверяемыеАтрибутыMS) = Тип("Массив") Тогда
		АтрибутыНастроекMS = REST_API_ПолучитьСтруктуруАтрибутовПоЗначениямАтрибутов(
			ИтоговыйКлючНастройки, СоответствиеНастройка, ПроверяемыеАтрибутыMS);
	Иначе
		АтрибутыНастроекMS = ПроверяемыеАтрибутыMS;
	КонецЕсли;
	
	Если АтрибутыНастроекMS = Неопределено Тогда
		Возврат ИтоговыйКлючНастройки;
	КонецЕсли;
	
	СтруктураАтрибутов = АтрибутыНастроекMS.Получить(ИтоговыйКлючНастройки);
	Если СтруктураАтрибутов = Неопределено Тогда
		Возврат ИтоговыйКлючНастройки;
	КонецЕсли;
		
	Для каждого СвойстваАтрибута ИЗ СтруктураАтрибутов Цикл
		ЗначениеАтрибута = СоответствиеНастройка.Получить(СвойстваАтрибута.Ключ);
		     
		Если НЕ ЗначениеАтрибута = Неопределено
			И НЕ ПустаяСтрока(ЗначениеАтрибута)
			И НЕ ВРег(ЗначениеАтрибута) = "EMPTY" Тогда
			ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + "_" + ЗначениеАтрибута;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИтоговыйКлючНастройки;
	
КонецФункции

Функция REST_API_ПолучитьСтруктуруАтрибутовПоЗначениямАтрибутов(КлючНастройки, СоответствиеНастройка, ПроверяемыеАтрибутыMS)

	Если НЕ ПроверяемыеАтрибутыMS.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИменаАтрибутов = Новый Структура;
	
	Для каждого СвойстваАтрибута ИЗ СоответствиеНастройка Цикл
		Если НРег(СвойстваАтрибута.Ключ) = "uid"
			ИЛИ НРег(СвойстваАтрибута.Ключ) = "name"
			ИЛИ НРег(СвойстваАтрибута.Ключ) = "value" Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаАтрибутов.Вставить(СвойстваАтрибута.Ключ);
	КонецЦикла;
	
	МаксимумСовпадений = -1;
	
	Для Индекс = 0 ПО ПроверяемыеАтрибутыMS.ВГраница() Цикл
		АтрибутыНастроекMS = ПроверяемыеАтрибутыMS[Индекс];
		
		КоличествоСовпадений = 0;
		
		Если НЕ АтрибутыНастроекMS = Неопределено Тогда
			СтруктураАтрибутов = АтрибутыНастроекMS.Получить(КлючНастройки);
			Если НЕ СтруктураАтрибутов = Неопределено Тогда
				Для каждого СвойстваАтрибута ИЗ СтруктураАтрибутов Цикл
					Если ИменаАтрибутов.Свойство(СвойстваАтрибута.Ключ) Тогда
						КоличествоСовпадений = КоличествоСовпадений + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если КоличествоСовпадений > МаксимумСовпадений Тогда
			ТекущийИндекс = Индекс;
			
			МаксимумСовпадений = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;

	Возврат ПроверяемыеАтрибутыMS[ТекущийИндекс];
	
КонецФункции

Функция REST_API_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы = Неопределено, ОбновитьНастройкиВКэше = Истина, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьТокенSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Логин,Пароль,ТипБазы,ОбновитьНастройкиВКэше",
		СтруктураПодключения, Логин, Пароль, ТипБазы, ОбновитьНастройкиВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// <Лог>
	ЯзСтрока = "ru = 'Выполняется получение нового токена авторизации.
				|Логин: %1
				|Пароль: %2'";
	пСообщение = НСтр(ЯзСтрока);
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Логин, Пароль);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Логин,Пароль",
		Логин, Пароль);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 		"POST");
	СтруктураЗапроса.Вставить("Метод", 			"connect/token");
	СтруктураЗапроса.Вставить("Заголовки", 		Заголовки);
	СтруктураЗапроса.Вставить("ВерсияAPI", 		"");
	СтруктураЗапроса.Вставить("СтрокаЗапроса", 	"<Авторизация Mobile SMARTS>");
	
	ОтправляемыеДанные = "scope=all offline_access&username=" + Логин + "&password=" + Пароль + "&grant_type=password&client_id=ext_client&client_secret=ext_client_secret";
	
	// <Лог>
	ЯзСтрока = "ru = 'Выполняется получение токена авторизации через connect/token.
		| Данные запроса: %1'";
	пСообщение = НСтр(ЯзСтрока);
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ОтправляемыеДанные);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураЗапроса,ОтправляемыеДанные",
		СтруктураЗапроса, ОтправляемыеДанные);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	Если СтруктураОтвета <> Ложь И ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации через connect/token. REST_API_ВыполнитьМетод вернул результат: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураОтвета",
			СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	Если СтруктураОтвета <> Ложь И СтруктураОтвета.Свойство("ТекстОшибки") И ЗначениеЗаполнено(СтруктураОтвета.ТекстОшибки) Тогда
		// <Лог>
		ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации через connect/token. Текст ошибки: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета.ТекстОшибки);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураОтвета",
			СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, СтруктураОтвета.ТекстОшибки,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	ТокенПолучен = Истина;
	Если СтруктураОтвета = Ложь
		ИЛИ СтруктураОтвета.КодСостояния <> 200 Тогда
		ТокенПолучен = Ложь;
	КонецЕсли;
	
	Если НЕ ТокенПолучен Тогда
		// <Лог>
		КодСостояния 					= "";
		СтатусОтвета 					= "";
		ТекстОшибки 					= "";
		ОтветСервераНеРасшифрованный 	= "";
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
			СтруктураОтвета.Свойство("КодСостояния", КодСостояния);
			СтруктураОтвета.Свойство("Статус", СтатусОтвета);
			СтруктураОтвета.Свойство("ТекстОшибки", ТекстОшибки);
			СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
		КонецЕсли;
		
		ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации через connect/token. 
							|Код состояния: %1
							|Статус: %2
							|Текст ошибки: %3
							|Ответ сервера: %4";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, КодСостояния, СтатусОтвета, ТекстОшибки, ОтветСервераНеРасшифрованный);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураЗапроса,ОтправляемыеДанные,СтруктураОтвета",
			СтруктураЗапроса, ОтправляемыеДанные, СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		// </Лог>
		
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Content-Type", "application/json");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 		"GET");
		СтруктураЗапроса.Вставить("Метод", 			"session?username=" + Логин + "&password=" + Пароль);
		СтруктураЗапроса.Вставить("Заголовки", 		Заголовки);
		СтруктураЗапроса.Вставить("СтрокаЗапроса", 	"<Авторизация Mobile SMARTS>");
		
		// <Лог>
		ЯзСтрока 	= "ru = 'Выполняется получение токена авторизации через session. 
							|Метод запроса: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураЗапроса.Метод);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураЗапроса",
			СтруктураЗапроса);
		ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
		// </Лог>
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		Если СтруктураОтвета <> Ложь И ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
			// <Лог>
			ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации через session. REST_API_ВыполнитьМетод вернул результат: %1'";
			пСообщение 	= НСтр(ЯзСтрока);
			пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"СтруктураОтвета",
				СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		КонецЕсли;
		
		Если СтруктураОтвета <> Ложь И СтруктураОтвета.Свойство("ТекстОшибки") И ЗначениеЗаполнено(СтруктураОтвета.ТекстОшибки) Тогда
			// <Лог>
			ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации через session. Текст ошибки: %1'";
			пСообщение 	= НСтр(ЯзСтрока);
			пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета.ТекстОшибки);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"СтруктураОтвета",
				СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, СтруктураОтвета.ТекстОшибки,, АдресаПеременных);
			// </Лог>
		КонецЕсли;
		
		Если СтруктураОтвета = Ложь ИЛИ СтруктураОтвета.КодСостояния <> 200 Тогда
			// <Лог>
			КодСостояния 					= "";
			СтатусОтвета 					= "";
			ТекстОшибки 					= "";
			ОтветСервераНеРасшифрованный 	= "";
			Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
				СтруктураОтвета.Свойство("КодСостояния", КодСостояния);
				СтруктураОтвета.Свойство("Статус", СтатусОтвета);
				СтруктураОтвета.Свойство("ТекстОшибки", ТекстОшибки);
				СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
			КонецЕсли;
			
			ЯзСтрока = "ru = 'Ошибка при получении токена авторизации через session.
							|Код состояния: %1
							|Статус: %2
							|Текст ошибки: %3
							|Ответ сервера: %4'";
			пСообщение = НСтр(ЯзСтрока);
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, КодСостояния, СтатусОтвета, ТекстОшибки, ОтветСервераНеРасшифрованный);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"СтруктураЗапроса,СтруктураОтвета",
				СтруктураЗапроса, СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ОтветСервера = Неопределено;
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура")
		ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
		// <Лог>
		ОтветСервераНеРасшифрованный = "";
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
			СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
		КонецЕсли;
		
		ЯзСтрока 	= "ru = 'Ошибка при получении токена авторизации. В ответе отсутствует поле ОтветСервера. Ответ сервера: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, ОтветСервераНеРасшифрованный);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "СтруктураОтвета", СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаПодключения = "";
	Если ТипЗнч(СтруктураПодключения) = Тип("Строка") Тогда
		СтрокаПодключения = СтруктураПодключения;
	ИначеЕсли ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС") Тогда
		СтрокаПодключения = СтруктураПодключения.СтрокаПодключенияСМАРТС;
	КонецЕсли;
	
	Access_token = ОтветСервера.Получить("Access_token");
	Если Access_token = Неопределено Тогда
		Access_token = ОтветСервера.Получить("access_token");
	КонецЕсли;
	Refresh_token = ОтветСервера.Получить("Refresh_token");
	Если Refresh_token = Неопределено Тогда
		Refresh_token = ОтветСервера.Получить("refresh_token");
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("Access_token, Refresh_token", Access_token, Refresh_token);
	
	// <Лог>
	ЯзСтрока 	= "ru = 'Получены токены авторизации. 
						|Access_token: %1
						|Refresh_token: %2'";
	пСообщение 	= НСтр(ЯзСтрока);
	пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, Access_token, Refresh_token);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОтветСервера,СтруктураВозврата",
		ОтветСервера, СтруктураВозврата);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	Если НЕ ЗначениеЗаполнено(Access_token) ИЛИ НЕ ЗначениеЗаполнено(Refresh_token) Тогда
		// <Лог>
		ЯзСтрока 	= "ru = 'Ошибка при разборе ответа получения токена авторизации. 
						|Access_token: %1
						|Refresh_token: %2'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, Access_token, Refresh_token);
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ОтветСервера,СтруктураВозврата",
			ОтветСервера, СтруктураВозврата);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	Если ОбновитьНастройкиВКэше Тогда
		ГлЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, СтруктураВозврата, ТипБазы, "REST_API",, СтруктураОтвета.ОтветСервера, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция REST_API_ОбновитьТокенSMARTS(СтруктураПодключения, Refresh_token = "", ТипБазы = Неопределено, ОбновитьНастройкиВКэше = Истина, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ОбновитьТокенSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Refresh_token,ТипБазы,ОбновитьНастройкиВКэше",
		СтруктураПодключения, Refresh_token, ТипБазы, ОбновитьНастройкиВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// Данные авторизации в кэше могут быть неактуальными, дополнительно будем пытаться получить актуальные рефреш-токены
	ПараметрыПодключенияMS = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Refresh_token) Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
			И ПараметрыПодключенияMS.Свойство("АвторизацияРефрешТокен") Тогда
			Refresh_token = ПараметрыПодключенияMS.АвторизацияРефрешТокен;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Refresh_token) Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка при обновлении токена авторизации. Refresh-токен не заполнен.'";
			пСообщение = НСтр(ЯзСтрока);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "ПараметрыПодключенияMS", ПараметрыПодключенияMS);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЯзСтрока 	= "ru = 'Выполняется обновление токена авторизации. Refresh-токен: %1'";
	пСообщение 	= НСтр(ЯзСтрока);
	пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, Refresh_token);
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "Refresh_token", Refresh_token);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 			"POST");
	СтруктураЗапроса.Вставить("Метод", 				"connect/token");
	СтруктураЗапроса.Вставить("Заголовки", 			Заголовки);
	СтруктураЗапроса.Вставить("ВерсияAPI", 			"");
	СтруктураЗапроса.Вставить("СтрокаЗапроса", 		"<Авторизация Mobile SMARTS>");
	СтруктураЗапроса.Вставить("ОбновлениеТокена", 	Истина);
	
	ОтправляемыеДанные = "scope=refresh_token offline_access&refresh_token=" + Refresh_token + "&grant_type=refresh_token&client_id=ext_client&client_secret=ext_client_secret";
	
	// <Лог>
	ЯзСтрока 	= "ru = 'Выполняется обновление токена авторизации через connect/token. 
						|Данные запроса: %1'";
	пСообщение 	= НСтр(ЯзСтрока);
	пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, ОтправляемыеДанные);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураЗапроса,ОтправляемыеДанные",
		СтруктураЗапроса, ОтправляемыеДанные);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации через connect/token. REST_API_ВыполнитьМетод вернул результат: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "СтруктураОтвета", СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ТокенПолучен = Истина;
	Если СтруктураОтвета = Ложь
		ИЛИ СтруктураОтвета.КодСостояния <> 200 Тогда
		ТокенПолучен = Ложь;
	КонецЕсли;
	
	Если НЕ ТокенПолучен Тогда
		// <Лог>
		КодСостояния 					= "";
		СтатусОтвета 					= "";
		ТекстОшибки 					= "";
		ОтветСервераНеРасшифрованный 	= "";
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
			СтруктураОтвета.Свойство("КодСостояния", КодСостояния);
			СтруктураОтвета.Свойство("Статус", СтатусОтвета);
			СтруктураОтвета.Свойство("ТекстОшибки", ТекстОшибки);
			СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
		КонецЕсли;
		
		ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации через connect/token. 
							|Код состояния: %1
							|Статус: %2
							|Текст ошибки: %3
							|Ответ сервера: %4'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, КодСостояния, СтатусОтвета, ТекстОшибки, ОтветСервераНеРасшифрованный);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураЗапроса,ОтправляемыеДанные,СтруктураОтвета",
			СтруктураЗапроса, ОтправляемыеДанные, СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		// </Лог>
		
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 			"POST");
		СтруктураЗапроса.Вставить("Метод", 				"session");
		СтруктураЗапроса.Вставить("Заголовки", 			Заголовки);
		СтруктураЗапроса.Вставить("СтрокаЗапроса", 		"<Авторизация Mobile SMARTS>");
		СтруктураЗапроса.Вставить("ОбновлениеТокена", 	Истина);
		
		ОтправляемыеДанные = "grant_type=refresh_token&client_id=&client_secret=&refresh_token=" + Refresh_token;
		
		// <Лог>
		ЯзСтрока 	= "ru = 'Выполняется обновление токена авторизации через session. 
							|Данные запроса: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, ОтправляемыеДанные);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"СтруктураЗапроса,ОтправляемыеДанные",
			СтруктураЗапроса, ОтправляемыеДанные);
		ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
		// </Лог>
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
		Если ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
			// <Лог>
			ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации через session. REST_API_ВыполнитьМетод вернул результат: %1'";
			пСообщение 	= НСтр(ЯзСтрока);
			пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "СтруктураОтвета", СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтруктураОтвета <> Ложь И СтруктураОтвета.Свойство("ТекстОшибки") И ЗначениеЗаполнено(СтруктураОтвета.ТекстОшибки) Тогда
			// <Лог>
			ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации через session. Текст ошибки: %1'";
			пСообщение 	= НСтр(ЯзСтрока);
			пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, СтруктураОтвета.ТекстОшибки);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "СтруктураОтвета", СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, СтруктураОтвета.ТекстОшибки,, АдресаПеременных);
			// </Лог>
		КонецЕсли;
		
		Если СтруктураОтвета = Ложь ИЛИ СтруктураОтвета.КодСостояния <> 200 Тогда
			// <Лог>
			КодСостояния 					= "";
			СтатусОтвета 					= "";
			ТекстОшибки 					= "";
			ОтветСервераНеРасшифрованный 	= "";
			Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
				СтруктураОтвета.Свойство("КодСостояния", КодСостояния);
				СтруктураОтвета.Свойство("Статус", СтатусОтвета);
				СтруктураОтвета.Свойство("ТекстОшибки", ТекстОшибки);
				СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
			КонецЕсли;
			
			ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации через session. 
								|Код состояния: %1
								|Статус: %2
								|Текст ошибки: %3
								|Ответ сервера: %4'";
			пСообщение 	= НСтр(ЯзСтрока);
			пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, КодСостояния, СтатусОтвета, ТекстОшибки, ОтветСервераНеРасшифрованный);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"СтруктураЗапроса,ОтправляемыеДанные,СтруктураОтвета",
				СтруктураЗапроса, ОтправляемыеДанные, СтруктураОтвета);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ОтветСервера = Неопределено;
	Если НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
		// <Лог>
		ОтветСервераНеРасшифрованный = "";
		СтруктураОтвета.Свойство("ОтветСервераНеРасшифрованный", ОтветСервераНеРасшифрованный);
		
		ЯзСтрока 	= "ru = 'Ошибка при обновлении токена авторизации. В ответе отсутствует поле ОтветСервера. Ответ сервера: %1'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, ОтветСервераНеРасшифрованный);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "СтруктураОтвета", СтруктураОтвета);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаПодключения = "";
	Если ТипЗнч(СтруктураПодключения) = Тип("Строка") Тогда
		СтрокаПодключения = СтруктураПодключения;
	ИначеЕсли ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС") Тогда
		СтрокаПодключения = СтруктураПодключения.СтрокаПодключенияСМАРТС;
	КонецЕсли;
	
	Access_token = ОтветСервера.Получить("Access_token");
	Если Access_token = Неопределено Тогда
		Access_token = ОтветСервера.Получить("access_token");
	КонецЕсли;
	Refresh_token = ОтветСервера.Получить("Refresh_token");
	Если Refresh_token = Неопределено Тогда
		Refresh_token = ОтветСервера.Получить("refresh_token");
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("Access_token, Refresh_token", Access_token, Refresh_token);
	
	// <Лог>
	ЯзСтрока 	= "ru = 'Получены токены авторизации. 
						|Access_token: %1
						|Refresh_token: %2'";
	пСообщение 	= НСтр(ЯзСтрока);
	пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, Access_token, Refresh_token);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОтветСервера,СтруктураВозврата",
		ОтветСервера, СтруктураВозврата);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	Если НЕ ЗначениеЗаполнено(Access_token) ИЛИ НЕ ЗначениеЗаполнено(Refresh_token) Тогда
		// <Лог>
		ЯзСтрока 	= "ru = 'Ошибка при разборе ответа обновления токена авторизации. 
							|Access_token: %1
							|Refresh_token: %2'";
		пСообщение 	= НСтр(ЯзСтрока);
		пСообщение 	= ГлЯдро_СтрШаблон(пСообщение, Access_token, Refresh_token);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ОтветСервера,СтруктураВозврата",
			ОтветСервера, СтруктураВозврата);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	Если ОбновитьНастройкиВКэше Тогда
		ГлЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, СтруктураВозврата, ТипБазы, "REST_API",, СтруктураОтвета.ОтветСервера, АдресаПеременных);
	КонецЕсли;
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция REST_API_ПолучитьТокеныИзХранилища1С(СтруктураПодключения, АдресаПеременных)

	ИмяСобытия = "REST_API_ПолучитьТокеныИзХранилища1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения",
		СтруктураПодключения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	пСообщение = НСтр("ru = 'Получение токенов из хранилища 1С, Начало';
						|en = 'Getting tokens from the 1C repository, The Beginning'; be = 'Атрыманне токенаў з сховішчы 1С, Пачатак'; es = 'Obtención de tokens del repositorio 1C, Inicio'; ka = 'მიღების სიმბოლოს 1c საცავი, დასაწყისში'; kk = '1С қоймасынан токендерді алу, бастау'; ro = 'Obținerea jetoanelor din depozitul 1C, începutul'; tr = '1C deposundan jeton alma, Başlangıç'; uk = 'Отримання токенов зі сховища 1С, початок'; uz = '1C omboridan tokenlarni olish, boshlash'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	ТокеныАвторизации = Новый Структура;
	ТокеныАвторизации.Вставить("Access_token",  "");
	ТокеныАвторизации.Вставить("Refresh_token", "");
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	КонецЕсли;
	
	Если НЕ ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось получить параметры подключения MS';
							|en = 'Couldn''t get the Cleverence connection parameters'; be = 'Не ўдалося атрымаць параметры падлучэння Cleverence'; es = 'No se pudo obtener la configuración de conexión de Cleverence'; ka = 'ვერ მივიღე Cleverence კავშირის პარამეტრები'; kk = 'Cleverence қосылым параметрлерін алу мүмкін болмады'; ro = 'Nu am putut obține parametrii de conectare Cleverence'; tr = 'Cleverence bağlantı parametreleri alınamadı'; uk = 'Не вдалося отримати параметри підключення Cleverence'; uz = 'Cleverence ulanish parametrlarini olish mumkin emas'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТокеныАвторизации);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ТокеныАвторизации;
	КонецЕсли;
	
	СтрокаПодключения = "";
	Если ТипЗнч(СтруктураПодключения) = Тип("Строка") Тогда
		СтрокаПодключения = СтруктураПодключения;
	ИначеЕсли ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС") Тогда
		СтрокаПодключения = СтруктураПодключения.СтрокаПодключенияСМАРТС;
	КонецЕсли;
	
	Если НЕ ГлЯдро_СтрокиПодключенияСовпадают(ПараметрыПодключенияMS.СтрокаПодключения, СтрокаПодключения) Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Текущие параметры подключения MS отличаются от сохраненных';
							|en = 'The current Cleverence connection settings differ from the saved ones';
							|be = 'Бягучыя параметры падлучэння Cleverence адрозніваюцца ад захаваных'; es = 'La configuración de conexión actual de Cleverence es diferente de la configuración guardada'; ka = 'Cleverence კავშირის ამჟამინდელი პარამეტრები განსხვავდება შენახული პარამეტრებისგან'; kk = 'Ағымдағы Cleverence қосылым параметрлері сақталған опциялардан ерекшеленеді'; ro = 'Setările actuale ale conexiunii Cleverence diferă de cele salvate'; tr = 'Mevcut Cleverence bağlantı ayarları kaydedilenlerden farklıdır'; uk = 'Поточні параметри підключення Cleverence відрізняються від збережених'; uz = 'Joriy Cleverence ulanish parametrlari saqlanganlardan farq qiladi'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТокеныАвторизации);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ТокеныАвторизации;
	КонецЕсли;
	
	Access_token  = "";
	Refresh_token = "";
	Если ПараметрыПодключенияMS.Свойство("АвторизацияТокен", Access_token) Тогда КонецЕсли;
	Если ПараметрыПодключенияMS.Свойство("АвторизацияРефрешТокен", Refresh_token) Тогда КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Access_token)
		ИЛИ НЕ ЗначениеЗаполнено(Refresh_token) Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не заполнены токены в сохраненных параметрах подключения MS';
							|en = 'Tokens are not filled in the saved parameters of the Cleverence connection';
							|be = 'Не запоўненыя токены ў захаваных параметрах падлучэння Cleverence'; es = 'No se han llenado los tokens en las opciones de conexión de Cleverence guardadas'; ka = 'სიმბოლოები არ არის შევსებული Cleverence კავშირის შენახული პარამეტრებით'; kk = 'Сақталған Cleverence қосылым параметрлеріндегі таңбалауыштар толтырылмаған'; ro = 'Jetoanele nu sunt completate în parametrii salvați ai conexiunii Cleverence'; tr = 'Kaydedilen Cleverence bağlantı ayarlarında belirteçler doldurulmadı'; uk = 'Не заповнені токени в збережених параметрах підключення Cleverence'; uz = 'Tokenlar Cleverence ulanishining saqlangan parametrlariga to''ldirilmaydi'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТокеныАвторизации);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ТокеныАвторизации;
	КонецЕсли;
	
	ТокеныАвторизации.Вставить("Access_token",  Access_token);
	ТокеныАвторизации.Вставить("Refresh_token", Refresh_token);
	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "Получены токены из хранилища 1С:" 
		+ Символы.ПС + "- access: " + Строка(Access_token)
		+ Символы.ПС + "- refresh: " + Строка(Refresh_token),, АдресаПеременных);
	
	ГлЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, ТокеныАвторизации,, "REST_API", Ложь,, АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Получение токенов из хранилища 1С, Конец';
						|en = 'Getting tokens from the 1C repository, End'; be = 'Атрыманне токенаў з сховішчы 1С, Канец'; es = 'Obtención de tokens del repositorio 1C, Fin'; ka = 'მიღების სიმბოლოს 1c საცავი, ბოლოს'; kk = '1С қоймасынан токендерді алу, соңы'; ro = 'Obținerea jetoanelor din depozitul 1C, sfârșit'; tr = '1C deposundan jeton alma, Son'; uk = 'Отримання токенов зі сховища 1С, кінець'; uz = '1C omboridan tokenlarni olish, tugatish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТокеныАвторизации);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ТокеныАвторизации;
	
КонецФункции

// Выполняет проверочный REST-запрос указанной версии API.
//
// Параметры:
//  СтруктураПодключения - Структура - параметры подключения к базе Клеверенс.
//  ВерсияAPI - Число - проверяемая версия REST API.
//  МетодПроверки - Строка - имя метода REST API для проверки контракта.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура - ответ REST API.
//
Функция REST_API_ВыполнитьПроверкуКонтракта(СтруктураПодключения, ВерсияAPI, МетодПроверки, АдресаПеременных)
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		МетодПроверки);
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	СтруктураЗапроса.Вставить("ВерсияAPI", 	ГлЯдро_СтрШаблон("/api/v%1", ВерсияAPI));
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Возврат СтруктураОтвета;
	
КонецФункции

// Заполняет результат проверки контракта по ответу REST API.
//
// Параметры:
//  РезультатПроверки - Структура - изменяемый результат проверки контракта.
//  СтруктураОтвета - Структура, Неопределено - ответ REST API.
//  ВерсияAPI - Число - проверяемая версия REST API.
//  МетодПроверки - Строка - имя метода REST API для проверки контракта.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура REST_API_ЗаполнитьРезультатПроверкиКонтракта(РезультатПроверки, СтруктураОтвета, ВерсияAPI, МетодПроверки, АдресаПеременных)
	
	КодСостояния = Неопределено;
	Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
		СтруктураОтвета.Свойство("КодСостояния", КодСостояния);
	КонецЕсли;
	
	РезультатПроверки.КодСостояния 		= КодСостояния;
	РезультатПроверки.ВерсияAPI 		= ВерсияAPI;
	РезультатПроверки.МетодПроверки 	= МетодПроверки;
	РезультатПроверки.СтруктураОтвета 	= СтруктураОтвета;
	
	Если REST_API_КодСостоянияУспешно(КодСостояния) Тогда
		РезультатПроверки.Статус = Истина;
		РезультатПроверки.ВерсияПодтверждена = Истина;
		КомЯдро_СохранитьЗначениеПеременной("Версия_REST_API", ВерсияAPI, АдресаПеременных);
	ИначеЕсли КодСостояния = 401
		ИЛИ КодСостояния = 403 Тогда
		РезультатПроверки.Статус = Истина;
		РезультатПроверки.ТребуетсяАвторизация = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет контракт REST API для подключения к базе Клеверенс.
//
// Параметры:
//  СтруктураПодключения - Структура - параметры подключения к базе Клеверенс.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура - результат проверки контракта, возможные свойства:
//   * Статус - Булево - Истина, если проверка выполнена или требуется авторизация.
//   * ВерсияAPI - Число, Неопределено - версия REST API, для которой получен ответ.
//   * ВерсияПодтверждена - Булево - Истина, если контракт подтвержден.
//   * МетодПроверки - Строка - имя метода REST API, для которого получен ответ.
//   * ТребуетсяАвторизация - Булево - Истина, если для подключения нужна авторизация.
//   * КодСостояния - Число, Неопределено - HTTP-код ответа.
//   * СтруктураОтвета - Структура, Неопределено - ответ REST API.
//
Функция REST_API_ПроверитьКонтрактПодключения(СтруктураПодключения, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПроверитьКонтрактПодключения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения",
		СтруктураПодключения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("Статус", 				Ложь);
	РезультатПроверки.Вставить("ВерсияAPI", 			Неопределено);
	РезультатПроверки.Вставить("ВерсияПодтверждена", 	Ложь);
	РезультатПроверки.Вставить("МетодПроверки", 		"");
	РезультатПроверки.Вставить("ТребуетсяАвторизация", 	Ложь);
	РезультатПроверки.Вставить("КодСостояния", 			Неопределено);
	РезультатПроверки.Вставить("СтруктураОтвета", 		Неопределено);
	
	СтруктураОтветаV2 = REST_API_ВыполнитьПроверкуКонтракта(СтруктураПодключения, 2, "LocationSchema", АдресаПеременных);
	REST_API_ЗаполнитьРезультатПроверкиКонтракта(РезультатПроверки, СтруктураОтветаV2, 2, "LocationSchema", АдресаПеременных);
	
	// <Лог>
	ЯзСтрока = "ru = 'Проверен контракт REST API. 
					|Версия API: %1
					|Метод проверки: %2
					|Код состояния HTTP: %3
					|Статус проверки: %4
					|Версия подтверждена: %5
					|Требуется авторизация: %6.'";
	пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока),
		РезультатПроверки.ВерсияAPI,
		РезультатПроверки.МетодПроверки,
		РезультатПроверки.КодСостояния,
		РезультатПроверки.Статус,
		РезультатПроверки.ВерсияПодтверждена,
		РезультатПроверки.ТребуетсяАвторизация);
		
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "РезультатПроверки", РезультатПроверки);
	
	Если РезультатПроверки.Статус
		И РезультатПроверки.ВерсияПодтверждена Тогда
		ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	ИначеЕсли РезультатПроверки.Статус
		ИЛИ РезультатПроверки.КодСостояния = 404 Тогда
		ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	Иначе
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
	КонецЕсли;
	// </Лог>
	
	Если НЕ РезультатПроверки.ВерсияПодтверждена
		И РезультатПроверки.КодСостояния = 404 Тогда
		
		СтруктураОтветаV1 = REST_API_ВыполнитьПроверкуКонтракта(СтруктураПодключения, 1, "Warehouses", АдресаПеременных);
		REST_API_ЗаполнитьРезультатПроверкиКонтракта(РезультатПроверки, СтруктураОтветаV1, 1, "Warehouses", АдресаПеременных);
		
		// <Лог>
		ЯзСтрока = "ru = 'Проверен контракт REST API. 
					|Версия API: %1
					|Метод проверки: %2
					|Код состояния HTTP: %3
					|Статус проверки: %4
					|Версия подтверждена: %5
					|Требуется авторизация: %6.'";
		пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока),
			РезультатПроверки.ВерсияAPI,
			РезультатПроверки.МетодПроверки,
			РезультатПроверки.КодСостояния,
			РезультатПроверки.Статус,
			РезультатПроверки.ВерсияПодтверждена,
			РезультатПроверки.ТребуетсяАвторизация);
			
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "РезультатПроверки", РезультатПроверки);
		
		Если РезультатПроверки.Статус
			И РезультатПроверки.ВерсияПодтверждена Тогда
			ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
		ИначеЕсли РезультатПроверки.Статус 
			ИЛИ РезультатПроверки.КодСостояния = 404 Тогда
			ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
		Иначе
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		КонецЕсли;
		// </Лог>
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПроверки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатПроверки;
	
КонецФункции

// Выполняет подключение к базе Клеверенс при работе с типом интерфейса REST_API
//
// Параметры:
//	СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//  Интерактивно - Булево - флаг работы в интерактивном режиме
//	НеПроверятьАвторизацию - Булево - признак необходимости проверки авторизации
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - если требуется авторизация в интерактивном режиме - содержит:
//  	* Статус - Строка	
//      * СтрокаПодключения - Строка
//      * ИмяБазы - Строка
//      * Логин - Строка
//      * ТипБазы - Строка
//      * ДопПараметры - Структура - содержит:
//			** СтрокаПодключения - Строка
//          ** ТипБазы - Строка
//          ** СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//          ** СохранятьАвторизацию - Булево
//          ** ИмяБазы - Строка
//          ** Логин - Строка
//	- Булево - флаг успешности подключения к базе Клеверенс
Функция REST_API_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Интерактивно, НеПроверятьАвторизацию = Ложь, АдресаПеременных) Экспорт

	ИмяСобытия = "REST_API_ПодключитьсяКБазеSMARTS";

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Интерактивно,НеПроверятьАвторизацию",
		СтруктураПодключения, Интерактивно, НеПроверятьАвторизацию);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ЭтоВнешнееСоединение = Ложь;
		
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	
	Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
		ДатаАктуальностиСоединения = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_REST_API_ДатаАктуальностиСоединения");
		Если ТипЗнч(ДатаАктуальностиСоединения) = Тип("Дата") 
			И ТекущаяДата() - ДатаАктуальностиСоединения < 3600 Тогда //Если настройки не устарели то не проверяем подключение, 1ч.
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;	
	
	СтрокаПодключения = "";
	Если ТипЗнч(СтруктураПодключения) = Тип("Структура") Тогда
		Если НЕ СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС")
			И НЕ СтруктураПодключения.Свойство("СтрокаПодключения") Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		Иначе
			СтрокаПодключения = ?(СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС"), СтруктураПодключения.СтрокаПодключенияСМАРТС, СтруктураПодключения.СтрокаПодключения);
		КонецЕсли;
	КонецЕсли;
	
	РезультатПроверкиКонтракта = REST_API_ПроверитьКонтрактПодключения(СтруктураПодключения, АдресаПеременных);
	СтруктураОтвета = РезультатПроверкиКонтракта.СтруктураОтвета;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("СтрокаПодключения", 		СтрокаПодключения);
	ДопПараметры.Вставить("СтруктураПодключения", 	СтруктураПодключения);
	ДопПараметры.Вставить("ТипБазы", 				СтруктураПодключения.ТипБазы);
	ДопПараметры.Вставить("ИмяБазы", 				"REST API");
	
	TempUid = "";
	ПодключениеПоTempUid = НЕ НеПроверятьАвторизацию
		И СтруктураПодключения.Свойство("TempUid", TempUid)
		И НЕ ПустаяСтрока(TempUid);
	
	ТребуетсяАвторизация 	= РезультатПроверкиКонтракта.ТребуетсяАвторизация;
	ВерсияAPI 				= РезультатПроверкиКонтракта.ВерсияAPI;
	ТекстОшибки 			= "";
	
	Если НЕ РезультатПроверкиКонтракта.Статус
		ИЛИ СтруктураОтвета = Ложь
		ИЛИ РезультатПроверкиКонтракта.КодСостояния = Неопределено Тогда
		
		Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
			СтруктураПараметровONLEX = Новый Структура;
			СтруктураПараметровONLEX.Вставить("ИмяПользователяВ1С", ГлЯдро_ПолучитьНаименованиеТекущегоПользователя());
			СтруктураПараметровONLEX.Вставить("СтрокаПодключения",  СтрокаПодключения);
			
			ОписаниеОшибкиONLEX = Новый Структура;
			ОписаниеОшибкиONLEX.Вставить("КодОшибкиONLEX", "ONLEX003");
			ОписаниеОшибкиONLEX.Вставить("СтруктураПараметровONLEX", СтруктураПараметровONLEX);
			
			КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", ОписаниеОшибкиONLEX, АдресаПеременных);
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	Если РезультатПроверкиКонтракта.КодСостояния = 403 Тогда
		ЯзСтрока = "ru = 'У данного пользователя Клеверенс недостаточно прав для подключения к базе!
					|Пользователь должен находиться в группе ""Администраторы"" или ""Внешние подключения"".'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		// <Лог>
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
		// </Лог>
		
	КонецЕсли;
	
	Если РезультатПроверкиКонтракта.ВерсияПодтверждена
		И НЕ ТребуетсяАвторизация
		И НЕ ПодключениеПоTempUid Тогда
		
		Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_REST_API_ДатаАктуальностиСоединения", ТекущаяДата());
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Истина;
	КонецЕсли;
	
	Если ПодключениеПоTempUid Тогда
		ТребуетсяАвторизация = Истина;
	КонецЕсли;
	
	Если ТребуетсяАвторизация Тогда
		// Сохраняем в структуре подключения информацию о том, что в базе включена авторизация
		СтруктураПодключения.Вставить("АвторизацияВключена", Истина);
		
		КомЯдро_СохранитьЗначениеПеременной("АвторизацияВключенаНаСервере", Истина, АдресаПеременных);
		//
		
		Если СтруктураПодключения.ТипБазы = "Частная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
		ИначеЕсли СтруктураПодключения.ТипБазы = "Временная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
		Иначе
			КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
		КонецЕсли;
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
		
		СохранятьДанныеАвторизации = ТипЗнч(СтруктураПодключенияБазыMS) = Тип("Структура");
		
		// Если в строке подключения передан tempuid для упрощенной авторизации, пробуем получить токен по нему
		ПолученТокенПоTempUid = Ложь;
		ТекстОшибкиTempUid	  = "";
		TempUid = "";
		Если НЕ НеПроверятьАвторизацию
			И СтруктураПодключения.Свойство("TempUid", TempUid)
			И НЕ ПустаяСтрока(TempUid) Тогда
			
			РезультатПроверкиКонтракта = REST_API_ПроверитьКонтрактПодключения(СтруктураПодключения, АдресаПеременных);
			СтруктураОтвета = РезультатПроверкиКонтракта.СтруктураОтвета;
			Если РезультатПроверкиКонтракта.ВерсияПодтверждена Тогда
				ВерсияAPI = РезультатПроверкиКонтракта.ВерсияAPI;
				ПолученТокенПоTempUid = Истина;
				Если СохранятьДанныеАвторизации Тогда
					СтруктураПодключенияБазыMS.Вставить("АвторизацияТокен", 	  ?(СтруктураПодключения.Свойство("АвторизацияТокен"), 		 СтруктураПодключения.АвторизацияТокен, 	  ""));
					СтруктураПодключенияБазыMS.Вставить("АвторизацияРефрешТокен", ?(СтруктураПодключения.Свойство("АвторизацияРефрешТокен"), СтруктураПодключения.АвторизацияРефрешТокен, ""));
					СтруктураПодключенияБазыMS.Вставить("АвторизацияТип",		  "tempuid");
				КонецЕсли;
			Иначе
				ТекстОшибкиTempUid = "Ссылка для подключения устарела. Получите новую ссылку и попробуйте еще раз.";
			КонецЕсли;
		КонецЕсли;
		
		Если СохранятьДанныеАвторизации Тогда
			СтруктураПодключенияБазыMS.Вставить("АвторизацияВключена", Истина);
			КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, СтруктураПодключенияБазыMS, АдресаПеременных);
		КонецЕсли;
		
		Если НеПроверятьАвторизацию Тогда
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Истина;
		ИначеЕсли ПолученТокенПоTempUid Тогда	
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Истина;
		ИначеЕсли Интерактивно
			И НЕ ПустаяСтрока(ТекстОшибкиTempUid) Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТекстОшибкиTempUid);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат ТекстОшибкиTempUid;
		ИначеЕсли Интерактивно Тогда
			// Определяем имя базы
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
			СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
			СтруктураЗапроса.Вставить("ТипЗапроса", "ПроверкаСоединения");
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
			
			ИмяБазы = "<Не удалось определить...>";
			Если СтруктураОтвета.КодСостояния = 200 Тогда
				ИмяБазы = СтруктураОтвета.ОтветСервера.Получить("name");
				Если ИмяБазы = Неопределено Тогда
					ИмяБазы = "<Не удалось определить...>";
				КонецЕсли;
			ИначеЕсли СохранятьДанныеАвторизации
				И СтруктураПодключенияБазыMS.Свойство("Имя")
				И ЗначениеЗаполнено(СтруктураПодключенияБазыMS.Имя) Тогда
				ИмяБазы = СтруктураПодключенияБазыMS.Имя;
			ИначеЕсли ЗначениеЗаполнено(СтрокаПодключения) Тогда
				ИмяБазы = СтрокаПодключения;
			КонецЕсли;
			
			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("Статус", 			"ОшибкаАвторизации");
			СтруктураВозврата.Вставить("СтрокаПодключения", СтрокаПодключения);
			СтруктураВозврата.Вставить("ТипБазы", 			СтруктураПодключения.ТипБазы);
			СтруктураВозврата.Вставить("ИмяБазы", 			ИмяБазы);
			СтруктураВозврата.Вставить("ДопПараметры", 		ДопПараметры);
			СтруктураВозврата.Вставить("ТекстОшибки", 		ТекстОшибки);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат СтруктураВозврата;
		Иначе
			Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
				СтруктураПараметровONLEX = Новый Структура;
				СтруктураПараметровONLEX.Вставить("ИмяПользователяВ1С", ГлЯдро_ПолучитьНаименованиеТекущегоПользователя());
				СтруктураПараметровONLEX.Вставить("СтрокаПодключения",  СтрокаПодключения);
				
				ОписаниеОшибкиONLEX = Новый Структура;
				ОписаниеОшибкиONLEX.Вставить("КодОшибкиONLEX", "ONLEX003");
				ОписаниеОшибкиONLEX.Вставить("СтруктураПараметровONLEX", СтруктураПараметровONLEX);
				
				КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", ОписаниеОшибкиONLEX, АдресаПеременных);
			КонецЕсли;
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция REST_API_ПолучитьМетаданныеДокументовMS(ТипБазы, ИмяПеременнойНастройки, АдресаПеременных)

	Перем Users;
	
	ИмяСобытия = "REST_API_ПолучитьМетаданныеДокументовMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы,ИмяПеременнойНастройки",
		ТипБазы, ИмяПеременнойНастройки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	// DocTypes
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"DocTypes?$expand=tables");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		DocumentTypes = Неопределено;
	Иначе
		DocumentTypes = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	// TablesInfo
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"TablesInfo?$expand=fields");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Tables = Неопределено;	
	Иначе
		Tables = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;
		
	// Users
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Users");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Users = Неопределено;	
	Иначе
		Users = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;
		
	// Devices
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Devices");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Devices = Неопределено;
	Иначе
		Devices = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMSПоСтруктуреБазы(ТипБазы, АдресаПеременных);
	
	Если ЯзыкПлатформыMS = "EN" Тогда
		AcceptLanguage = "en";
	Иначе
		AcceptLanguage = "ru";
	КонецЕсли;
	
	МетаданныеДокументовMS = Новый Структура;
	
	СписокОбязательныхПолей 	= ГлЯдро_СписокОбязательныхПолейДокументаMS(АдресаПеременных);
	СписокДополнительныхПолей	= ГлЯдро_СписокДополнительныхПолейДокументаMS(АдресаПеременных);
	СписокОбязательныхПолейТЧ 	= ГлЯдро_СписокОбязательныхПолейТЧДокументаMS(АдресаПеременных);
	РеквизитыСерии 				= ГлЯдро_СписокРеквизитовСерииДокументаMS(АдресаПеременных);
	РеквизитыСерийныеНомера 	= ГлЯдро_СписокРеквизитовСерийныеНомераДокументаMS(АдресаПеременных);
	СоответствияИмен 			= ГлЯдро_СоответствиеИмениПоляMSВнутреннемуИдентификатору();
	
	ГлЯдро_ПреобразоватьUni(СписокОбязательныхПолей);
	ГлЯдро_ПреобразоватьUni(СписокДополнительныхПолей);
	ГлЯдро_ПреобразоватьUni(СписокОбязательныхПолейТЧ);
	ГлЯдро_ПреобразоватьUni(РеквизитыСерии);
	ГлЯдро_ПреобразоватьUni(РеквизитыСерийныеНомера);
	
	ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокОбязательныхПолей, СоответствияИмен);
	ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокДополнительныхПолей, СоответствияИмен);
	ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокОбязательныхПолейТЧ, СоответствияИмен);
	
	Если DocumentTypes <> Неопределено Тогда
		Для Каждого ТипДокумента из DocumentTypes Цикл
			
			Если ТипДокумента.Получить("virtual") Тогда // Виртуальный
				Продолжить;
			КонецЕсли;
			
			uni = ГлЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(ТипДокумента.Получить("uni"));
			name = ТипДокумента.Получить("name");
			
			Если ГлЯдро_ПроверитьПервыйСимволНаЦифру(name)
				ИЛИ ГлЯдро_ПроверитьПервыйСимволНаЦифру(uni) Тогда
				
				// <Лог>
				ЯзСтрока = "Имя документа %1 нельзя использовать в интеграции с 1С. Имя документа не должно начинаться с цифры.";
				ТекстОшибки = ГлЯдро_СтрШаблон(ЯзСтрока, name);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"name",
					name);
				ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст,,, АдресаПеременных);
				// </Лог>
				
				Продолжить;
			КонецЕсли;
			
			СтруктураДокумента = Новый Структура();
			СтруктураДокумента.Вставить("uni", uni);
			СтруктураДокумента.Вставить("Имя", name);
			СтруктураДокумента.Вставить("Синоним", ТипДокумента.Получить("displayName"));
			
			// реквизиты документа
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод",		"GET");
			СтруктураЗапроса.Вставить("Метод", 			"DocTypes('" + СтруктураДокумента.uni + "')?$expand=fields");
			СтруктураЗапроса.Вставить("ТипЗапроса", 	"ПолучениеМетаданных");
			СтруктураЗапроса.Вставить("AcceptLanguage",	AcceptLanguage);
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
			
			Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
				REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
				
				Fields = Неопределено;
			Иначе
				Fields = СтруктураОтвета.ОтветСервера.Получить("fields");	
			КонецЕсли;
			
			Если Fields <> Неопределено Тогда
				СписокРеквизитов = REST_API_ПолучитьСписокРеквизитовСущностиMS(Fields);
				ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокРеквизитов, СоответствияИмен);
				
				Для Каждого ДополнительныйЭлемент Из СписокОбязательныхПолей Цикл
					СписокРеквизитов.Добавить(ДополнительныйЭлемент);
				КонецЦикла;
		
				СтруктураДокумента.Вставить("Реквизиты", СписокРеквизитов);
			Иначе	
				СтруктураДокумента.Вставить("Реквизиты", Новый СписокЗначений());
			КонецЕсли;
			
			СтруктураДокумента.Вставить("ДополнительныеРеквизиты", СписокДополнительныхПолей);
			
			// реквизиты табличной части
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод",		"GET");
			СтруктураЗапроса.Вставить("Метод", 			"DocTypes('" + СтруктураДокумента.uni + "')?$expand=columns");
			СтруктураЗапроса.Вставить("ТипЗапроса", 	"ПолучениеМетаданных");
			СтруктураЗапроса.Вставить("AcceptLanguage",	AcceptLanguage);
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
			
			Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
				REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
				
				Columns = Неопределено;	
			Иначе
				Columns = СтруктураОтвета.ОтветСервера.Получить("columns");	
			КонецЕсли;
			
			Если Columns <> Неопределено Тогда
				СписокРеквизитов = REST_API_ПолучитьСписокРеквизитовСущностиMS(Columns);
				ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокРеквизитов, СоответствияИмен);
				
				Для Каждого ДополнительныйЭлемент Из СписокОбязательныхПолейТЧ Цикл
					СписокРеквизитов.Добавить(ДополнительныйЭлемент);
				КонецЦикла;
				
				СтруктураДокумента.Вставить("РеквизитыТЧ", СписокРеквизитов);
			Иначе
				СтруктураДокумента.Вставить("РеквизитыТЧ", Новый СписокЗначений());
			КонецЕсли;
			
			// серии и серийные номера
			СтруктураДокумента.Вставить("РеквизитыСерии", РеквизитыСерии);
			СтруктураДокумента.Вставить("РеквизитыСерийныеНомера", РеквизитыСерийныеНомера);
			
			// Дополнительные таблицы
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод",		"GET");
			СтруктураЗапроса.Вставить("Метод", 			"DocTypes('" + СтруктураДокумента.uni + "')?$expand=tables($expand=fields)");
			СтруктураЗапроса.Вставить("ТипЗапроса", 	"ПолучениеМетаданных");
			СтруктураЗапроса.Вставить("AcceptLanguage",	AcceptLanguage);
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
			
			Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
				REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
				
				DocTables = Неопределено;
			Иначе
				DocTables = СтруктураОтвета.ОтветСервера.Получить("tables");	
			КонецЕсли;
			
			СписокДополнительныхТаблиц = Новый СписокЗначений();
			Если DocTables <> Неопределено Тогда
				Для каждого ДопТаблица из DocTables Цикл
					СписокПолейДопТаблицы = REST_API_ПолучитьСписокРеквизитовСущностиMS(ДопТаблица.Получить("fields"));	
					СписокДополнительныхТаблиц.Добавить(СписокПолейДопТаблицы, ДопТаблица.Получить("name"));
				КонецЦикла;
			КонецЕсли;
										
			СтруктураДокумента.Вставить("ДополнительныеТаблицы", СписокДополнительныхТаблиц);									
			
			СоответствиеРеквизитовИмена = ГлЯдро_ПолучитьСоответствиеРеквизитовMS(СтруктураДокумента, "ШапкаДокумента", "Значение", "Имя");
			СтруктураДокумента.Вставить("СоответствиеРеквизитовИмена", СоответствиеРеквизитовИмена);
			
			ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ТипДокумента.Получить("name"));
			МетаданныеДокументовMS.Вставить(ИмяТипаДокумента, СтруктураДокумента);
			
		КонецЦикла;
	КонецЕсли;
	
	Таблицы = Новый СписокЗначений;	
	Если Tables <> Неопределено Тогда
		Для Каждого ДопТаблица ИЗ Tables Цикл
			
			// Реквизиты таблицы
			Fields = ДопТаблица.Получить("fields");
			Если Fields = Неопределено Тогда
				СписокРеквизитов = Новый Массив;
			Иначе
				СписокРеквизитов = REST_API_ПолучитьСписокРеквизитовСущностиMS(Fields,, Истина);
			КонецЕсли;
			
			Таблицы.Добавить(СписокРеквизитов, ДопТаблица.Получить("name"));
				
		КонецЦикла;
	КонецЕсли;
		
	СписокПользователейMS = Новый СписокЗначений;
	
	СписокПользователейMS.Добавить("Выгружать всем;Выгружать всем"); 	
	СписокПользователейMS.Добавить("Спрашивать при выгрузке;Спрашивать при выгрузке");	
	Если Users <> Неопределено Тогда
		Для Каждого ТекущийПользователь ИЗ Users Цикл
			СписокПользователейMS.Добавить(ТекущийПользователь.Получить("id") + ";" + ТекущийПользователь.Получить("name"), ТекущийПользователь.Получить("groupId") + ";" + ТекущийПользователь.Получить("groupName"));
		КонецЦикла;	
	КонецЕсли;
	
	ПризнакЛегкогоОблака = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(Новый Структура("InternetGateOption"), 
		ГлЯдро_ПолучитьКатегорииНастроекMS(),
		, 
		,
		АдресаПеременных);
	Если ТипЗнч(ПризнакЛегкогоОблака) = Тип("Структура") И ПризнакЛегкогоОблака.Свойство("InternetGateOption") Тогда
		InternetGateOption = ПризнакЛегкогоОблака.InternetGateOption;
	Иначе
		InternetGateOption = Ложь;
	КонецЕсли;
	
	Если InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE" Тогда
		флЛегкоеОблако = Истина;
	Иначе
		флЛегкоеОблако = Ложь;
	КонецЕсли;
	
	// Устройства Клеверенс
	СтруктураДанныхУстройств = REST_API_ЗаполнитьМассивУстройств(Devices,флЛегкоеОблако);
	СписокУстройствMS 						= СтруктураДанныхУстройств.СписокУстройствMS;
	ПлатформаПоддерживаетSupportUntilDate 	= СтруктураДанныхУстройств.ПлатформаПоддерживаетSupportUntilDate;
	
	СоответствиеПолейНоменклатуры = Новый Соответствие;
	СоответствиеПолейНоменклатуры.Вставить("ИмяСерии","serial");
	СоответствиеПолейНоменклатуры.Вставить("Колво","qty");
	СоответствиеПолейНоменклатуры.Вставить("Цена","price");
	СоответствиеПолейНоменклатуры.Вставить("ИмяХарактеристики","descr");
	СоответствиеПолейНоменклатуры.Вставить("ПоСН","withsn");
	СоответствиеПолейНоменклатуры.Вставить("ПоСериям","withserial");
	СоответствиеПолейНоменклатуры.Вставить("Весовой","Vesovoj");
	СоответствиеПолейНоменклатуры.Вставить("КлючСерий","KlyuchSerij");
	СоответствиеПолейНоменклатуры.Вставить("ВидНоменклатуры","VidNomenklatury");
	СоответствиеПолейНоменклатуры.Вставить("ИдСерии","serialId");
	СоответствиеПолейНоменклатуры.Вставить("Алко","Alko");
	СоответствиеПолейНоменклатуры.Вставить("АлкоВидЛиц","AlkoVidLic");
	СоответствиеПолейНоменклатуры.Вставить("АлкоМарк","AlkoMark");
	СоответствиеПолейНоменклатуры.Вставить("АлкоКодВ","AlkoKodV");
	СоответствиеПолейНоменклатуры.Вставить("АлкоНаимВ","AlkoNaimV");
	СоответствиеПолейНоменклатуры.Вставить("АлкоОбъем","AlkoObem");
	СоответствиеПолейНоменклатуры.Вставить("АлкоКрепость","AlkoKrepost");
	СоответствиеПолейНоменклатуры.Вставить("АлкоПроизводитель","AlkoProizvoditel");
	СоответствиеПолейНоменклатуры.Вставить("АлкоПроизвИНН","AlkoProizvINN");
	СоответствиеПолейНоменклатуры.Вставить("АлкоПроизвКПП","AlkoProizvKPP");
	СоответствиеПолейНоменклатуры.Вставить("АлкоКод","AlkoKod");
	СоответствиеПолейНоменклатуры.Вставить("ЭтоГруппа","EtoGruppa");
	СоответствиеПолейНоменклатуры.Вставить("Продавец","sellerName");
	СоответствиеПолейНоменклатуры.Вставить("АдресПродавца","sellerAddress");
	СоответствиеПолейНоменклатуры.Вставить("АдресПроизв","producerAddress");
	СоответствиеПолейНоменклатуры.Вставить("СтранаПроизв","producerCountry");
	СоответствиеПолейНоменклатуры.Вставить("Поставщик","supplierName");
	СоответствиеПолейНоменклатуры.Вставить("АдресПоставщика","supplierAddress");
	СоответствиеПолейНоменклатуры.Вставить("ДопИнфо","AdditionInfo");
	СоответствиеПолейНоменклатуры.Вставить("КлючХарактеристик","KlyuchHarakteristik");
	СоответствиеПолейНоменклатуры.Вставить("ПоХарактеристикам","PoHarakteristikam");
	СоответствиеПолейНоменклатуры.Вставить("Серия","Seriya");
	СоответствиеПолейНоменклатуры.Вставить("Характеристика","Harakteristika");
	СоответствиеПолейНоменклатуры.Вставить("ИдХарактеристики","descrId");
	СоответствиеПолейНоменклатуры.Вставить("ИдЕдиницыИзмерения","unitId");
	СоответствиеПолейНоменклатуры.Вставить("КИЗ","KIZ");
	СоответствиеПолейНоменклатуры.Вставить("АлкоНаим","AlkoNaim");
	СоответствиеПолейНоменклатуры.Вставить("ШК","barcode");
	
	ГлЯдро_ПреобразоватьUni(СоответствиеПолейНоменклатуры);	
		
	МассивВыгружаемыхПолейНоменклатурыMS = ГлЯдро_ПолучитьМассивВыгружаемыхПолейНоменклатурыMS(АдресаПеременных);
	МассивВыгружаемыхПолейЯчеекMS = ГлЯдро_ПолучитьМассивВыгружаемыхПолейЯчеекMS(АдресаПеременных);
		
	СтрРезультат = Новый Структура;
	СтрРезультат.Вставить("ДокументыMS",							МетаданныеДокументовMS);
	СтрРезультат.Вставить("Tables",									Таблицы);
	СтрРезультат.Вставить("ПользователиMS",							СписокПользователейMS);
	СтрРезультат.Вставить("УстройстваMS",							СписокУстройствMS);
	СтрРезультат.Вставить("UniПолейНоменклатуры",					СоответствиеПолейНоменклатуры);
	СтрРезультат.Вставить("ВыгружаемыеПоляНоменклатурыMS", 			МассивВыгружаемыхПолейНоменклатурыMS);
	СтрРезультат.Вставить("ВыгружаемыеПоляЯчеекMS", 				МассивВыгружаемыхПолейЯчеекMS);
	СтрРезультат.Вставить("ПлатформаПоддерживаетSupportUntilDate", 	ПлатформаПоддерживаетSupportUntilDate);
	СтрРезультат.Вставить("ЯзыкПлатформыMS",						ЯзыкПлатформыMS);
	
	ГлЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойНастройки, СтрРезультат);
	
	ПользователиMSАдрес = ГлЯдро_ДеревоПользователейВоВременноеХранилище(СписокПользователейMS);
	УстройстваMSАдрес 	= ГлЯдро_ДеревоУстройствВоВременноеХранилище(СписокУстройствMS, флЛегкоеОблако);
	
	СтрРезультат.Вставить("ПользователиMS", ПользователиMSАдрес);
	СтрРезультат.Вставить("УстройстваMSДеревом", УстройстваMSАдрес);
	
	// Сброс даты актуальности настроек
	ПостфиксБазы = ?(СтруктураПодключения.Свойство("IdBaseSMARTS"),
		СтрЗаменить(СтруктураПодключения.IdBaseSMARTS, "-", "_"), "");
	
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиНастроек_" + ПостфиксБазы, ТекущаяДата());
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_REST_API_ДатаАктуальностиСоединения", Неопределено);
	пСообщение = НСтр("ru = 'Сброшена дата актуальности настроек, постфикс базы: %1';
						|en = 'The date of the current settings has been reset, the database postfix is %1';
						|be = 'Скінутая дата актуальнасці налад, постфикс базы: %1'; es = 'Se ha restablecido la fecha de actualización de la configuración, postfix base: %1'; ka = 'მიმდინარე პარამეტრების თარიღი გადატვირთულია, მონაცემთა ბაზის postfix არის %1'; kk = 'Параметрлердің жаңартылған күні, базаның постфиксі қалпына келтірілді: %1'; ro = 'Data setărilor curente a fost resetată, baza de date postfix este %1'; tr = 'Ayarların güncel olduğu tarih sıfırlandı, taban sonrası düzeltme: % 1'; uk = 'Скинута дата актуальності налаштувань, постфікс бази: %1'; uz = 'Sozlamalar yangilangan sana, postfiks bazasi: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ?(ПостфиксБазы = "", "<нет>", ПостфиксБазы));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтрРезультат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтрРезультат;
	
КонецФункции

Функция REST_API_ПолучитьМетаданныеMSИзХранилища1С(ТипБазы, ИмяПеременнойНастройки, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьМетаданныеMSИзХранилища1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы,ИмяПеременнойНастройки",
		ТипБазы, ИмяПеременнойНастройки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	пСтруктураМетаданных = ГлЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойНастройки);
	Если ТипЗнч(пСтруктураМетаданных) <> Тип("Структура") Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;		
	КонецЕсли;
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;	
	
	ПризнакЛегкогоОблака = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(Новый Структура("InternetGateOption"), КатегорииНастроекMS,,, АдресаПеременных);
	Если ТипЗнч(ПризнакЛегкогоОблака) = Тип("Структура") И ПризнакЛегкогоОблака.Свойство("InternetGateOption") Тогда
		InternetGateOption = ПризнакЛегкогоОблака.InternetGateOption;
	Иначе
		InternetGateOption = Ложь;
	КонецЕсли;
	
	Если InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE" Тогда
		флЛегкоеОблако = Истина;
	Иначе
		флЛегкоеОблако = Ложь;
	КонецЕсли;
	
	ЭтоВнешнееСоединение = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	ИспользоватьКэш = ЭтоWebСервис ИЛИ ЭтоВнешнееСоединение;
	
	СписокПользователейMS = пСтруктураМетаданных.ПользователиMS;
	СписокУстройствMS 	  = пСтруктураМетаданных.УстройстваMS;
	
	ОбновитьСписокПользователей = ТипЗнч(СписокПользователейMS) <> Тип("СписокЗначений");
    ОбновитьСписокУстройств		= (НЕ ИспользоватьКэш) ИЛИ ТипЗнч(СписокУстройствMS) <> Тип("Массив");
	
	Если ОбновитьСписокПользователей ИЛИ ОбновитьСписокУстройств Тогда
		Если ТипБазы = "Частная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
		ИначеЕсли ТипБазы = "Временная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
		Иначе
			КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
		КонецЕсли;
		
		СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	КонецЕсли;

	Если ОбновитьСписокПользователей Тогда
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
		СтруктураЗапроса.Вставить("Метод", 		"Users");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
			
			Users = Неопределено;
		Иначе
			Users = СтруктураОтвета.ОтветСервера.Получить("value");	
		КонецЕсли;
			
		СписокПользователейMS = Новый СписокЗначений;
		СписокПользователейMS.Добавить("Выгружать всем;Выгружать всем"); 	
		СписокПользователейMS.Добавить("Спрашивать при выгрузке;Спрашивать при выгрузке");	
		Если Users <> Неопределено Тогда
			Для Каждого ТекущийПользователь ИЗ Users Цикл
				СписокПользователейMS.Добавить(ТекущийПользователь.Получить("id") + ";" + ТекущийПользователь.Получить("name"), ТекущийПользователь.Получить("groupId") + ";" + ТекущийПользователь.Получить("groupName"));
			КонецЦикла;	
		КонецЕсли;
		
		пСтруктураМетаданных.Вставить("ПользователиMS", СписокПользователейMS);
	КонецЕсли;
	
	Если ОбновитьСписокУстройств Тогда
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
		СтруктураЗапроса.Вставить("Метод", 		"Devices");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
			
			Devices = Неопределено;
		Иначе
			Devices = СтруктураОтвета.ОтветСервера.Получить("value");	
		КонецЕсли;
	    				
		СтруктураДанныхУстройств = REST_API_ЗаполнитьМассивУстройств(Devices,флЛегкоеОблако);
		СписокУстройствMS 						= СтруктураДанныхУстройств.СписокУстройствMS;
		ПлатформаПоддерживаетSupportUntilDate 	= СтруктураДанныхУстройств.ПлатформаПоддерживаетSupportUntilDate;
		
		пСтруктураМетаданных.Вставить("ПлатформаПоддерживаетSupportUntilDate", ПлатформаПоддерживаетSupportUntilDate);
		пСтруктураМетаданных.Вставить("УстройстваMS", СписокУстройствMS);
	КонецЕсли;	

	Если ОбновитьСписокПользователей ИЛИ ОбновитьСписокУстройств Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойНастройки, пСтруктураМетаданных);
	КонецЕсли;
	
	ПользователиMSАдрес = ГлЯдро_ДеревоПользователейВоВременноеХранилище(СписокПользователейMS);
	УстройстваMSАдрес 	= ГлЯдро_ДеревоУстройствВоВременноеХранилище(СписокУстройствMS, флЛегкоеОблако);
	
	пСтруктураМетаданных.Вставить("ПользователиMS", ПользователиMSАдрес);
	пСтруктураМетаданных.Вставить("УстройстваMSДеревом",	УстройстваMSАдрес);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", пСтруктураМетаданных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат пСтруктураМетаданных;
	
КонецФункции

Функция REST_API_ЗаполнитьМассивУстройств(Devices = Неопределено,флЛегкоеОблако = Ложь) 
	СписокУстройствMS = Новый Массив;		
	ПлатформаПоддерживаетSupportUntilDate = Ложь;
	
	Если Devices <> Неопределено Тогда
		Для Каждого ТекущееУстройство ИЗ Devices Цикл                  
			
			DeviceId   	 = СокрЛП(ТекущееУстройство.Получить("deviceId"));
			DeviceName 	 = СокрЛП(ТекущееУстройство.Получить("deviceName"));
			Pincode 	 = ?(флЛегкоеОблако,СокрЛП(ТекущееУстройство.Получить("pincode")),"");
			lastInfoTime = REST_API_ПреобразоватьКДате(СокрЛП(ТекущееУстройство.Получить("lastInfoTime")));
			
			ДатаПоддержкиУстройства = '00010101';
			SupportUntilDate = ТекущееУстройство.Получить("deviceSupportUntilDate");
			Если SupportUntilDate <> Неопределено Тогда
				ПлатформаПоддерживаетSupportUntilDate = Истина;
				ДатаПоддержкиУстройства = REST_API_ПреобразоватьКДате(СокрЛП(SupportUntilDate));
			КонецЕсли;
			СписокУстройствMS.Добавить(ГлЯдро_СтруктураОписанияУстройстваSMARTS(DeviceId,DeviceName,lastInfoTime,ДатаПоддержкиУстройства,Pincode));
		КонецЦикла;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура("СписокУстройствMS,ПлатформаПоддерживаетSupportUntilDate",СписокУстройствMS,ПлатформаПоддерживаетSupportUntilDate);
	
	Возврат СтруктураРезультата;
КонецФункции

Функция REST_API_ОбновитьМетаданныеТаблицMS(ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ОбновитьМетаданныеТаблицMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"TablesInfo?$expand=fields");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Tables = Неопределено;	
	Иначе
		Tables = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;
		
	Таблицы = Новый СписокЗначений;	
	Если Tables <> Неопределено Тогда
		Для Каждого ДопТаблица ИЗ Tables Цикл
			
			// Реквизиты таблицы
			Fields = ДопТаблица.Получить("fields");
			Если Fields = Неопределено Тогда
				СписокРеквизитов = Новый Массив;
			Иначе
				СписокРеквизитов = REST_API_ПолучитьСписокРеквизитовСущностиMS(Fields,, Истина);
			КонецЕсли;
			
			Таблицы.Добавить(СписокРеквизитов, ДопТаблица.Получить("name"));
				
		КонецЦикла;
	КонецЕсли;
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Таблицы);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Таблицы;
	
КонецФункции

// Проверяет совместимость платформы для работы обмена с Клеверенс через REST, путем выполнения REST-запроса при первом запуске
// Если запрос выполнился, платформа считается совместимой
//
// Параметры:
//	СтруктураПодключения - Структура - содержит:
//		* ТипБазы - Строка
//		* СтрокаПодключенияСМАРТС - Строка
//		* IdBaseSMARTS - Строка
//		* ТипИнтерфейса - Строка
//		* РежимВыбораБазы - Строка
//
// Возвращаемое значение:
//	Булево - признак актуальности платформы
Функция REST_API_ПроверитьСовместимостьПлатформы(СтруктураПодключения, АдресаПеременных)

	Результат = Ложь;
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, Новый Структура("HTTPМетод,Метод","GET","DocTypes?$expand=tables"),, АдресаПеременных);
	Если СтруктураОтвета.КодСостояния = 200 
		И СтруктураОтвета.Свойство("ОтветСервера") Тогда
		DocumentTypes = СтруктураОтвета.ОтветСервера.Получить("value");
		Если ТипЗнч(DocumentTypes) = Тип("Массив") И DocumentTypes.Количество() > 0 Тогда
			ТипДокумента = Неопределено;
			Для каждого ТипДокумента ИЗ DocumentTypes Цикл
				Если ТипДокумента.Получить("virtual") ИЛИ ТипДокумента.Получить("removeAfterFinish") Тогда
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Если ТипДокумента <> Неопределено Тогда
				СтруктураДокумента = Новый Структура();
				СтруктураДокумента.Вставить("uni", ТипДокумента.Получить("uni"));
				СтруктураДокумента.Вставить("Имя", ТипДокумента.Получить("name"));
				СтруктураДокумента.Вставить("Синоним", ТипДокумента.Получить("displayName"));
									
				СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, Новый Структура("HTTPМетод,Метод","GET","DocTypes('" + СтруктураДокумента.uni + "')?$expand=fields"),, АдресаПеременных);
				Если СтруктураОтвета.КодСостояния = 200 Тогда
					Результат = Истина;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;							   
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция REST_API_ПолучитьПользователейSMARTS(ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьПользователейSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Users");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		UsersList = Неопределено;	
	Иначе
		UsersList = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;
		
	МассивПользователейMS = Новый Массив;
	
	Если UsersList <> Неопределено Тогда
		
		Для Каждого ТекущийПользователь ИЗ UsersList Цикл
			
			стрПользователиMS = Новый Структура("Ид,Имя,ИдГруппы,ИмяГруппы,Пароль,Описание,Штрихкод,ИдСкладов");
			стрПользователиMS.Ид 		= ТекущийПользователь.Получить("id");
			стрПользователиMS.Имя 		= ТекущийПользователь.Получить("name");
			стрПользователиMS.ИдГруппы 	= ТекущийПользователь.Получить("groupId");
			стрПользователиMS.ИмяГруппы = ТекущийПользователь.Получить("groupName");
			стрПользователиMS.Описание 	= ТекущийПользователь.Получить("description");			
			стрПользователиMS.Пароль 	= ТекущийПользователь.Получить("password");			
			стрПользователиMS.Штрихкод 	= ТекущийПользователь.Получить("barcode");   			
			
			СписокСкладов = Новый СписокЗначений;
			Warehouses = ТекущийПользователь.Получить("warehouseIds");                     
			Если Warehouses <> Неопределено Тогда 
				Для Каждого Warehouse Из Warehouses Цикл
					СписокСкладов.Добавить(Warehouse);
				КонецЦикла;
			КонецЕсли;
			
			стрПользователиMS.ИдСкладов = СписокСкладов;
			
			МассивПользователейMS.Добавить(стрПользователиMS);
			
		КонецЦикла;	 		
		
	КонецЕсли;

	АдресПользователейВХранилище = ПоместитьВоВременноеХранилище(МассивПользователейMS, Новый УникальныйИдентификатор());
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресПользователейВХранилище);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АдресПользователейВХранилище;
	
КонецФункции

