	Возврат Истина;	
	
КонецФункции

// Добавление нового поля Типовой в настройки выгрузки полей
Функция ГлЯдро_ОбновлениеНастроекДоВерсии_2_1_0_2(ВерсияНастроек,ОбновлениеКэша,ИзмененияВСтруктуре,КлючНастройки,АдресаПеременных) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КлючНастройки) Тогда
		// Обновляем только настройки ПоУмолчанию
		КлючНастройки = ?(ОбновлениеКэша, "НастройкиБизнесПроцессов_ПоУмолчанию", "НастройкиБизнесПроцессов_Пользовательские");
		Если ИзмененияВСтруктуре.Свойство(КлючНастройки) Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре[КлючНастройки];
		Иначе
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;
			СтруктураНастроекБизнесПроцессов.ВерсияНастроек = ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки();
		КонецЕсли;                                                 				
	Иначе
		Если КлючНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию" И ИзмененияВСтруктуре.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре.НастройкиБизнесПроцессов_ПоУмолчанию;
		Иначе	
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
	Иначе
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов;	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Строка") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("ТаблицаЗначений") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	// +++
	Типовой = КлючНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию";
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Массив") Тогда
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
			
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// Поля шапки выгрузки
			ИмяНастройки = "НастройкаВыгрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				
				НовыйМассивПолей = Новый Массив;
				ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаВыгрузкиПолейШапки());
				НовыйМассивПолей.Добавить(ОписаниеТЧ);
				
				Для каждого СтрокаПоля Из МассивПолей Цикл
					
					Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
					НовоеПоле.Вставить("Типовой", Типовой);
					НовыйМассивПолей.Добавить(НовоеПоле);
					
				КонецЦикла;
				
				НастройкаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
				
			КонецЕсли;
			
			// ТЧ выгрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаВыгрузкиТЧ", НастройкиТЧ);
			Если ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				
				НовыеНастройкиТЧ = Новый Массив;
				ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаВыгрузкиТЧ());
				НовыеНастройкиТЧ.Добавить(ОписаниеТЧ);
				
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрокаТаблицы = ГлЯдро_СкопироватьСтруктуру(СтрокаТаблицы);
					НоваяСтрокаТаблицы.Вставить("Типовой", Типовой);
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					НоваяСтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					НовыйМассивПолей = Новый Массив;
					ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаВыгрузкиПолейТЧ());
					НовыйМассивПолей.Добавить(ОписаниеТЧ);
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						Для каждого СтрокаПоля Из МассивПолей Цикл
							
							Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
								Продолжить;
							КонецЕсли;
							
							НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
							НовоеПоле.Вставить("Типовой", Типовой);
							НовыйМассивПолей.Добавить(НовоеПоле);
							
						КонецЦикла;
					КонецЕсли;
					НоваяСтрокаТаблицы.Вставить(ИмяНастройки, НовыйМассивПолей);
					НовыеНастройкиТЧ.Добавить(НоваяСтрокаТаблицы);
					
				КонецЦикла;
				
				НастройкаБП.Вставить("НастройкаВыгрузкиТЧ", НовыеНастройкиТЧ);
				
			КонецЕсли;
			
			// Поля шапки загрузки
			ИмяНастройки = "НастройкаЗагрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				
				НовыйМассивПолей = Новый Массив;
				ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаЗагрузкиПолейШапки());
				НовыйМассивПолей.Добавить(ОписаниеТЧ);
				
				Для каждого СтрокаПоля Из МассивПолей Цикл
					
					Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
					НовоеПоле.Вставить("Типовой", Типовой);
					НовыйМассивПолей.Добавить(НовоеПоле);
					
				КонецЦикла;
				
				НастройкаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
				
			КонецЕсли;
			
			// ТЧ загрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаЗагрузкиТЧ", НастройкиТЧ);
			Если ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				
				НовыеНастройкиТЧ = Новый Массив;
				ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаЗагрузкиТЧ());
				НовыеНастройкиТЧ.Добавить(ОписаниеТЧ);
				
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрокаТаблицы = ГлЯдро_СкопироватьСтруктуру(СтрокаТаблицы);
					НоваяСтрокаТаблицы.Вставить("Типовой", Типовой);
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					НоваяСтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					НовыйМассивПолей = Новый Массив;
					ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаЗагрузкиПолейТЧ());
					НовыйМассивПолей.Добавить(ОписаниеТЧ);
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						Для каждого СтрокаПоля Из МассивПолей Цикл
							
							Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
								Продолжить;
							КонецЕсли;
							
							НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
							НовоеПоле.Вставить("Типовой", Типовой);
							НовыйМассивПолей.Добавить(НовоеПоле);
							
						КонецЦикла;
					КонецЕсли;
					НоваяСтрокаТаблицы.Вставить(ИмяНастройки, НовыйМассивПолей);
					НовыеНастройкиТЧ.Добавить(НоваяСтрокаТаблицы);
					
				КонецЦикла;
				
				НастройкаБП.Вставить("НастройкаЗагрузкиТЧ", НовыеНастройкиТЧ);
				
			КонецЕсли;
			
			// СвязиТабличныхЧастей
			ИмяНастройки = "СвязиТабличныхЧастей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			
			Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				
				ПерваяСтрока = Истина;
				НовыйМассивПолей = Новый Массив;
				Для каждого СтрокаПоля Из МассивПолей Цикл
					
					Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
					НовоеПоле.Вставить("Типовой", Типовой);
					
					Если ПерваяСтрока Тогда
						НовыйМассивПолей.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(НовоеПоле));
						ПерваяСтрока = Ложь;	
					КонецЕсли;
					НовыйМассивПолей.Добавить(НовоеПоле);
					
				КонецЦикла;
				
				НастройкаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
    // ---
	
	НовыйФорматНастроек = КомЯдро_ПолучитьЗначениеПеременной("НовыеНастройкиБизнесПроцессов", АдресаПеременных);
	Если НовыйФорматНастроек Тогда	                                                                		
		Если ТипЗнч(СтруктураНастроекБизнесПроцессов) <> Тип("Структура") Тогда
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;						
		КонецЕсли;              		
		СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов = НастройкиБизнесПроцессов;	
	Иначе
		СтруктураНастроекБизнесПроцессов = НастройкиБизнесПроцессов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючНастройки) Тогда
		ИзмененияВСтруктуре.Вставить(?(ОбновлениеКэша, "НастройкиБизнесПроцессов_ПоУмолчанию", "НастройкиБизнесПроцессов_Пользовательские"), СтруктураНастроекБизнесПроцессов);
	Иначе
		ИзмененияВСтруктуре.Вставить(КлючНастройки, СтруктураНастроекБизнесПроцессов);
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

// Удаление не используемых и дублей полей в сопоставлении реквизитов НастройкиБизнесПроцессов_ПоУмолчанию
Функция ГлЯдро_ОбновлениеНастроекДоВерсии_2_1_0_3(ВерсияНастроек,ОбновлениеКэша,ИзмененияВСтруктуре,КлючНастройки,АдресаПеременных) Экспорт
	
	Если НЕ ОбновлениеКэша Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КлючНастройки) Тогда
		// Обновляем только настройки ПоУмолчанию
		пКлюч = "НастройкиБизнесПроцессов_ПоУмолчанию";
		Если ИзмененияВСтруктуре.Свойство(пКлюч) Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре[пКлюч];
		Иначе
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;
			СтруктураНастроекБизнесПроцессов.ВерсияНастроек = ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки();
		КонецЕсли;                                                 				
	Иначе
		Если КлючНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию" И ИзмененияВСтруктуре.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре.НастройкиБизнесПроцессов_ПоУмолчанию;
		Иначе	
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
	Иначе
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов;	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Строка") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("ТаблицаЗначений") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	// +++
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Массив") Тогда
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
			
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// Если документ создается на ТСД или выгружается в обработчике, то удаляем настройки выгрузки шапки и ТЧ
			ДоступныНастройкиВыгрузки = ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) 
					И НЕ НастройкаБП.ВыполнитьТолькоПроизвольныйКодВыгрузка = Истина;
			
			// Если документ загружается в обработчике, то удаляем настройки загрузки шапки и ТЧ
			ДоступныНастройкиЗагрузки = ЗначениеЗаполнено(НастройкаБП.ТипРезультирующегоДокумента1С) 
					И НЕ НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина;
			
			// Поля шапки выгрузки
			ИмяНастройки = "НастройкаВыгрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			НовыйМассивПолей = Неопределено;
			
			Если ДоступныНастройкиВыгрузки И ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей);
				НовыйМассивПолей = МассивПолей;
			КонецЕсли;
			НастройкаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
			
			// ТЧ выгрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаВыгрузкиТЧ", НастройкиТЧ);
			НовыеНастройкиТЧ = Неопределено;
			
			Если ДоступныНастройкиВыгрузки И ТипЗнч(НастройкиТЧ) = Тип("Массив")Тогда
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					ИмяНастройки = "ТабличнаяЧастьДокументаMS";
					МассивПолей = Неопределено;
					СтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей);
						СтрокаТаблицы.Вставить(ИмяНастройки, МассивПолей);
					КонецЕсли;
					
				КонецЦикла;
				НовыеНастройкиТЧ = НастройкиТЧ;
			КонецЕсли;
			НастройкаБП.Вставить("НастройкаВыгрузкиТЧ", НовыеНастройкиТЧ);
			
			// Поля шапки загрузки
			ИмяНастройки = "НастройкаЗагрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			НовыйМассивПолей = Неопределено;
			
			Если ДоступныНастройкиЗагрузки И ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей);
				НовыйМассивПолей = МассивПолей;
			КонецЕсли;
			НастройкаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
			
			// ТЧ загрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаЗагрузкиТЧ", НастройкиТЧ);
			НовыеНастройкиТЧ = Неопределено;
			
			Если ДоступныНастройкиЗагрузки И ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					СтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей);
						СтрокаТаблицы.Вставить(ИмяНастройки, МассивПолей);
					КонецЕсли;
					
				КонецЦикла;
				НовыеНастройкиТЧ = НастройкиТЧ;
			КонецЕсли;
			НастройкаБП.Вставить("НастройкаЗагрузкиТЧ", НовыеНастройкиТЧ);
			
		КонецЦикла;
	КонецЕсли;
    // ---
	
	НовыйФорматНастроек = КомЯдро_ПолучитьЗначениеПеременной("НовыеНастройкиБизнесПроцессов", АдресаПеременных);
	Если НовыйФорматНастроек Тогда	                                                                		
		Если ТипЗнч(СтруктураНастроекБизнесПроцессов) <> Тип("Структура") Тогда
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;						
		КонецЕсли;              		
		СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов = НастройкиБизнесПроцессов;	
	Иначе
		СтруктураНастроекБизнесПроцессов = НастройкиБизнесПроцессов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючНастройки) Тогда
		ИзмененияВСтруктуре.Вставить(?(ОбновлениеКэша, "НастройкиБизнесПроцессов_ПоУмолчанию", "НастройкиБизнесПроцессов_Пользовательские"), СтруктураНастроекБизнесПроцессов);
	Иначе
		ИзмененияВСтруктуре.Вставить(КлючНастройки, СтруктураНастроекБизнесПроцессов);
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

// Удаление поля ИдСклада/WarehouseId из настроек выгрузки шапки
Функция ГлЯдро_ОбновлениеНастроекДоВерсии_2_1_0_4(ВерсияНастроек,ОбновлениеКэша,ИзмененияВСтруктуре,КлючНастройки,АдресаПеременных) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КлючНастройки) Тогда
		пКлюч = ?(ОбновлениеКэша, "НастройкиБизнесПроцессов_ПоУмолчанию", "НастройкиБизнесПроцессов_Пользовательские");
		Если ИзмененияВСтруктуре.Свойство(пКлюч) Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре[пКлюч];
		Иначе
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;
			СтруктураНастроекБизнесПроцессов.ВерсияНастроек = ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки();
		КонецЕсли;                                                 				
	Иначе
		Если КлючНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию" И ИзмененияВСтруктуре.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
			СтруктураНастроекБизнесПроцессов = ИзмененияВСтруктуре.НастройкиБизнесПроцессов_ПоУмолчанию;
		Иначе	
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;	
	Иначе
		НастройкиБизнесПроцессов = СтруктураНастроекБизнесПроцессов;	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Строка") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("ТаблицаЗначений") Тогда
		НастройкиБизнесПроцессов = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов);	
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	
	ПоляИдентификаторСклада = Новый Массив;
	ПоляИдентификаторСклада.Добавить("ИДСКЛАДА");
	ПоляИдентификаторСклада.Добавить("WAREHOUSEID");
	
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Массив") Тогда
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НастройкаВыгрузкиПолей = Неопределено;
			Если НЕ НастройкаБП.Свойство("НастройкаВыгрузкиПолей", НастройкаВыгрузкиПолей)
				ИЛИ НЕ ТипЗнч(НастройкаВыгрузкиПолей) = Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			
			Индекс = НастройкаВыгрузкиПолей.ВГраница();
			
			Пока Индекс >= 0 Цикл	
				НастройкаПоля = НастройкаВыгрузкиПолей[Индекс];
				
				Если НЕ НастройкаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
					ЭтоИдентификаторСклада = ВРег(НастройкаПоля.ТипПриемника) = "РЕКВИЗИТMS"
						И НЕ ПоляИдентификаторСклада.Найти(ВРег(НастройкаПоля.ИмяПриемника)) = Неопределено;
						
					Если ЭтоИдентификаторСклада Тогда
						НастройкаВыгрузкиПолей.Удалить(Индекс);
					КонецЕсли;
				КонецЕсли;
					
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	
	НовыйФорматНастроек = КомЯдро_ПолучитьЗначениеПеременной("НовыеНастройкиБизнесПроцессов", АдресаПеременных);
	
	Если НовыйФорматНастроек Тогда	                                                                		
		Если ТипЗнч(СтруктураНастроекБизнесПроцессов) <> Тип("Структура") Тогда
			Если ОбновлениеКэша Тогда
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
			Иначе
				СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
			КонецЕсли;						
		КонецЕсли;              		
		СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов = НастройкиБизнесПроцессов;	
	Иначе
		СтруктураНастроекБизнесПроцессов = НастройкиБизнесПроцессов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючНастройки) Тогда
		ИзмененияВСтруктуре.Вставить(?(ОбновлениеКэша, "НастройкиБизнесПроцессов_ПоУмолчанию", "НастройкиБизнесПроцессов_Пользовательские"), СтруктураНастроекБизнесПроцессов);
	Иначе
		ИзмененияВСтруктуре.Вставить(КлючНастройки, СтруктураНастроекБизнесПроцессов);
	КонецЕсли;
	
	Возврат Истина;	
	
КонецФункции

Процедура ГлЯдро_ПроверитьАктуальностьСтруктурыАтрибутов(КатегорииНастроекMS, АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ПроверитьАктуальностьСтруктурыАтрибутов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"КатегорииНастроекMS",
		КатегорииНастроекMS);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	Если ВерсияAPI = 1 Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ВерсияAPI",
			ВерсияAPI);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		Возврат;
	КонецЕсли;
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	ВерсияОбработки = СведенияОВнешнейОбработке().ВерсияСтруктурыАтрибутов;
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ВерсияСтруктурыАтрибутов_ПоУмолчанию", Ложь);
	СтруктураНастроек.Вставить("ВерсияСтруктурыАтрибутов_Пользовательские", Ложь);
	
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроекMS,,, АдресаПеременных);
	
	ВерсияСтруктурыАтрибутов_ПоУмолчанию = СтруктураНастроек.ВерсияСтруктурыАтрибутов_ПоУмолчанию;
	ВерсияСтруктурыАтрибутов_Пользовательские = СтруктураНастроек.ВерсияСтруктурыАтрибутов_Пользовательские;
	
	Если ТипЗнч(ВерсияСтруктурыАтрибутов_Пользовательские) = Тип("Строка") Тогда
		ВерсияСтруктурыАтрибутов_Пользовательские = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияСтруктурыАтрибутов_Пользовательские);
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_ПоУмолчанию",	ВерсияСтруктурыАтрибутов_ПоУмолчанию, АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияСтруктурыАтрибутов_Пользовательские, АдресаПеременных);
	
	ВерсияОбработкиЧислом = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработки);
	
	Если НЕ ЗначениеЗаполнено(ВерсияСтруктурыАтрибутов_ПоУмолчанию)
		ИЛИ ВерсияСтруктурыАтрибутов_ПоУмолчанию = Ложь Тогда
		ВерсияСтруктурыАтрибутов_ПоУмолчанию = 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВерсияСтруктурыАтрибутов_Пользовательские)
		ИЛИ ВерсияСтруктурыАтрибутов_Пользовательские = Ложь Тогда
		ВерсияСтруктурыАтрибутов_Пользовательские = 0;
	КонецЕсли;
	
	Если ВерсияОбработкиЧислом < ВерсияСтруктурыАтрибутов_ПоУмолчанию
		ИЛИ ВерсияОбработкиЧислом < ВерсияСтруктурыАтрибутов_Пользовательские Тогда
		
		// <Лог>
		ЯзСтрока = "ru = 'Версия настроек в базе Клеверенс выше версии текущей основной обработки!'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ВерсияОбработкиЧислом,ВерсияСтруктурыАтрибутов_ПоУмолчанию,ВерсияСтруктурыАтрибутов_Пользовательские",
			ВерсияОбработкиЧислом, ВерсияСтруктурыАтрибутов_ПоУмолчанию, ВерсияСтруктурыАтрибутов_Пользовательские);
			
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		логПоток = Логирование_ПолучитьПоток(АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных); // Закрываем поток, т.к это исключение нигде не ловится попыткой
		// </Лог>
		
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Версию структуры атрибутов в пользовательских настройках поднимаем до версии текущей основной обработки, но не выше версии в настройках по умолчанию
	Если ВерсияСтруктурыАтрибутов_ПоУмолчанию = 0 Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ВерсияAPI",
			ВерсияAPI);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если ВерсияОбработкиЧислом > ВерсияСтруктурыАтрибутов_Пользовательские Тогда
		Попытка
			ВерсияНастроекКонечная = Мин(ВерсияОбработкиЧислом, ВерсияСтруктурыАтрибутов_ПоУмолчанию);
			
			Если НЕ ВерсияСтруктурыАтрибутов_Пользовательские = ВерсияНастроекКонечная Тогда
				ГлЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления(ВерсияСтруктурыАтрибутов_Пользовательские, ВерсияНастроекКонечная, АдресаПеременных);
			КонецЕсли;
		Исключение
			
			// <Лог>
			ИнфоОшибка 	= ИнформацияОбОшибке();
			ЯзСтрока 	= "ru = 'Ошибка при обновлении структуры атрибутов.'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ВерсияСтруктурыАтрибутов_Пользовательские,ВерсияНастроекКонечная",
				ВерсияСтруктурыАтрибутов_Пользовательские, ВерсияНастроекКонечная);
				
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
				
		КонецПопытки;
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ОбновлениеАтрибутов_ВерсияСтруктурыАтрибутов() Экспорт

	Возврат СведенияОВнешнейОбработке().ВерсияСтруктурыАтрибутов;

КонецФункции

Функция ГлЯдро_ОбновлениеАтрибутов_МассивПереходныхВерсий() Экспорт
	
	МассивПереходныхВерсий = Новый СписокЗначений;
	МассивПереходныхВерсий.Добавить(2000000001, "2_0_0_1");
	//МассивПереходныхВерсий.Добавить(2000000002, "2_0_0_2");
	//МассивПереходныхВерсий.Добавить(2001000001, "2_1_0_1");
	//МассивПереходныхВерсий.Добавить(2001000002, "2_1_0_2");
	//МассивПереходныхВерсий.Добавить(2001000003, "2_1_0_3");
	
	Возврат МассивПереходныхВерсий;

КонецФункции

Функция ГлЯдро_ОбновлениеАтрибутов_РазницаСтруктур(СоответствиеАтрибутов1, СоответствиеАтрибутов2) Экспорт

	МассивКлючейНастроек = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(СоответствиеАтрибутов1) ИЛИ СоответствиеАтрибутов1 = Ложь Тогда
		Если НЕ ЗначениеЗаполнено(СоответствиеАтрибутов2) ИЛИ СоответствиеАтрибутов2 = Ложь Тогда
			Возврат МассивКлючейНастроек;
		КонецЕсли;
		
		Для каждого СтруктураНастройки ИЗ СоответствиеАтрибутов2 Цикл
			МассивКлючейНастроек.Добавить(СтруктураНастройки.Ключ);
		КонецЦикла;
		
		Возврат МассивКлючейНастроек;
	КонецЕсли;
	
	Для каждого СтруктураНастройки ИЗ СоответствиеАтрибутов1 Цикл
		ИмяНастройки = СтруктураНастройки.Ключ;
		
		СтруктураАтрибутов2 = СоответствиеАтрибутов2.Получить(ИмяНастройки);
		Если СтруктураАтрибутов2 = Неопределено Тогда
			МассивКлючейНастроек.Добавить(ИмяНастройки);
			Продолжить;
		КонецЕсли;
		
		СтруктураАтрибутов1 = СоответствиеАтрибутов1.Получить(ИмяНастройки);
		Если ГлЯдро_ОбновлениеАтрибутов_ЕстьРазличия(СтруктураАтрибутов1, СтруктураАтрибутов2) Тогда
			МассивКлючейНастроек.Добавить(ИмяНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтруктураНастройки ИЗ СоответствиеАтрибутов2 Цикл
		ИмяНастройки = СтруктураНастройки.Ключ;
		
		Если СоответствиеАтрибутов1.Получить(ИмяНастройки) = Неопределено Тогда
			МассивКлючейНастроек.Добавить(ИмяНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивКлючейНастроек;
	
КонецФункции

Функция ГлЯдро_ОбновлениеАтрибутов_ЕстьРазличия(СтруктураАтрибутов1, СтруктураАтрибутов2)
	
	ЕстьРазличия = Ложь;
	
	Для каждого СтруктураАтрибута ИЗ СтруктураАтрибутов1 Цикл
		ИмяАтрибута = СтруктураАтрибута.Ключ;
		
		Если НЕ СтруктураАтрибутов2.Свойство(ИмяАтрибута) Тогда
			Возврат Истина;
		КонецЕсли;
		
		ВозможныеЗначения1 = СтруктураАтрибутов1[ИмяАтрибута];
		ВозможныеЗначения2 = СтруктураАтрибутов2[ИмяАтрибута];
		
		Если НЕ ВозможныеЗначения1.Количество() = ВозможныеЗначения2.Количество() Тогда
			Возврат Истина;
		КонецЕсли;
		
		Для Индекс = 0 ПО ВозможныеЗначения1.ВГраница() Цикл
			Если НЕ ВозможныеЗначения1[Индекс] = ВозможныеЗначения2[Индекс] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого СтруктураАтрибута ИЗ СтруктураАтрибутов2 Цикл
		ИмяАтрибута = СтруктураАтрибута.Ключ;
		
		Если НЕ СтруктураАтрибутов1.Свойство(ИмяАтрибута) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьРазличия;
	
КонецФункции

Функция ГлЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления(ВерсияНастроекНачальная, ВерсияНастроекКонечная, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияНастроекНачальная,ВерсияНастроекКонечная",
		ВерсияНастроекНачальная, ВерсияНастроекКонечная);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураАтрибутовНачальная = ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияНастроекНачальная, АдресаПеременных);
	СтруктураАтрибутовКонечная 	= ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияНастроекКонечная, АдресаПеременных);
	
	ОбновляемыеНастройки = ГлЯдро_ОбновлениеАтрибутов_РазницаСтруктур(СтруктураАтрибутовНачальная, СтруктураАтрибутовКонечная);
	
	Если НЕ ОбновляемыеНастройки.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	НастройкиПоУмолчанию = КатегорииНастроекMS.НастройкиПоУмолчанию;
	НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
	УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
	
	// Получение значений настроек для перезаписи (главный узел)
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Узлы", Ложь);
	Для каждого КлючНастройки ИЗ НастройкиСАтрибутами Цикл
		Если НЕ НастройкиПоУмолчанию.Найти(КлючНастройки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Позиция_ = ГлЯдро_СтрНайти(КлючНастройки, "_");
		Если Позиция_ Тогда
			КлючДляФильтрации = Лев(КлючНастройки, Позиция_ - 1);
			Если ОбновляемыеНастройки.Найти(КлючДляФильтрации) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураНастроек.Вставить(КлючНастройки, Ложь);
	КонецЦикла;
	
	ПараметрыЗаполненияНастроек = Новый Структура;
	ПараметрыЗаполненияНастроек.Вставить("НеКэшировать", 			Истина);
	ПараметрыЗаполненияНастроек.Вставить("НеПроверятьАктуальность", Истина);
	ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS",		СтруктураАтрибутовНачальная);
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроекMS,,
		ПараметрыЗаполненияНастроек, АдресаПеременных);
	
	СтруктураНастроекДляИдентификаторов = Новый Структура;
	
	НастройкиКЗаписи = Новый Структура;
	Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
		Если СтрокаНастройки.Ключ = "Узлы"
			ИЛИ СтрокаНастройки.Значение = Ложь Тогда
			Продолжить;
		КонецЕсли;
		НастройкиКЗаписи.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		
		СтруктураНастроекДляИдентификаторов.Вставить(СтрокаНастройки.Ключ, Неопределено);
	КонецЦикла;
	
	СоответствиеНастроекПоУзлам = Новый Соответствие;
	СоответствиеНастроекПоУзлам.Вставить("ГлавныйУзел", НастройкиКЗаписи);
	
	// Получение идентификаторов настроек для удаления (главный узел)
	ПараметрыПолученияИдентификаторов = Новый Структура;
	ПараметрыПолученияИдентификаторов.Вставить("НеПроверятьАктуальность", Ложь);
	ПараметрыПолученияИдентификаторов.Вставить("АтрибутыНастроекMS",	  СтруктураАтрибутовНачальная);
	ИдентификаторыНастроек = ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроекДляИдентификаторов,,
		ПараметрыПолученияИдентификаторов, АдресаПеременных);
		
	НастройкиКУдалению = Новый Структура;
	Для каждого ИдентификаторНастройки ИЗ ИдентификаторыНастроек Цикл
		Если ИдентификаторНастройки.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НастройкиКУдалению.Вставить(ИдентификаторНастройки.Ключ, ИдентификаторНастройки.Значение);
	КонецЦикла;
	
	СоответствиеИдентификаторовПоУзлам = Новый Соответствие;
	СоответствиеИдентификаторовПоУзлам.Вставить("ГлавныйУзел", НастройкиКУдалению);	
	
	ВсеУзлы = СтруктураНастроек.Узлы;
	
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// Получение значений настроек для перезаписи (торговые объекты)
			СтруктураНастроек = Новый Структура;
			Для каждого КлючНастройки ИЗ УзловыеНастройки Цикл
				// При первом обновлении структуры атрибутов пересохраняем все узловые настройки, при последующих - только атрибутивные
				Если НЕ СтруктураАтрибутовНачальная = Неопределено Тогда
					Позиция_ = ГлЯдро_СтрНайти(КлючНастройки, "_");
					Если Позиция_ Тогда
						КлючДляФильтрации = Лев(КлючНастройки, Позиция_ - 1);
						Если ОбновляемыеНастройки.Найти(КлючДляФильтрации) = Неопределено Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				СтруктураНастроек.Вставить(КлючНастройки, Ложь);
			КонецЦикла;
			
			ПараметрыЗаполненияНастроек = Новый Структура;
			ПараметрыЗаполненияНастроек.Вставить("НеКэшировать", 			Истина);
			ПараметрыЗаполненияНастроек.Вставить("НеПроверятьАктуальность", Истина);
			ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS",		СтруктураАтрибутовНачальная);
			СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроекMS, СтрокаУзла.ID_Узла,
				ПараметрыЗаполненияНастроек, АдресаПеременных);
	
			СтруктураНастроекДляИдентификаторов = Новый Структура;	
				
			НастройкиКЗаписи = Новый Структура;	
			Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
				Если СтрокаНастройки.Значение = Ложь Тогда
					Продолжить;
				КонецЕсли;
				НастройкиКЗаписи.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
				
				СтруктураНастроекДляИдентификаторов.Вставить(СтрокаНастройки.Ключ, Неопределено);
			КонецЦикла;
			
			СоответствиеНастроекПоУзлам.Вставить(СтрокаУзла.ID_Узла, НастройкиКЗаписи);	
			
			// Получение идентификаторов настроек для удаления (торговые объекты)
			ИдентификаторыНастроек = ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроекДляИдентификаторов,
				СтрокаУзла.ID_Узла, ПараметрыПолученияИдентификаторов, АдресаПеременных);
				
			НастройкиКУдалению = Новый Структура;
			Для каждого ИдентификаторНастройки ИЗ ИдентификаторыНастроек Цикл
				Если ИдентификаторНастройки.Значение = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НастройкиКУдалению.Вставить(ИдентификаторНастройки.Ключ, ИдентификаторНастройки.Значение);
			КонецЦикла;
			
			СоответствиеИдентификаторовПоУзлам.Вставить(СтрокаУзла.ID_Узла, НастройкиКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	// Сохранение настроек в базе Mobile SMARTS (новые ключи)
	ПараметрыЗаписиНастроек = Новый Структура;
	ПараметрыЗаписиНастроек.Вставить("АтрибутыНастроекMS", СтруктураАтрибутовКонечная);
	
	Для каждого НастройкиУзла ИЗ СоответствиеНастроекПоУзлам Цикл
		ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиУзла.Значение, ?(НастройкиУзла.Ключ = "ГлавныйУзел", "", НастройкиУзла.Ключ),
			ПараметрыЗаписиНастроек, АдресаПеременных);
	КонецЦикла;
	
	// Если новые настройки сохранены под прежними идентификаторами, удалять их нельзя
	ПараметрыПолученияИдентификаторов = Новый Структура;
	ПараметрыПолученияИдентификаторов.Вставить("НеПроверятьАктуальность", Истина);
	ПараметрыПолученияИдентификаторов.Вставить("НеИспользоватьАтрибуты",  Ложь);
	ПараметрыПолученияИдентификаторов.Вставить("АтрибутыНастроекMS",	  СтруктураАтрибутовКонечная);
	
	Для каждого НастройкиУзла ИЗ СоответствиеНастроекПоУзлам Цикл
		НовыеИдентификаторыНастроек = ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(НастройкиУзла.Значение,
			?(НастройкиУзла.Ключ = "ГлавныйУзел", "", НастройкиУзла.Ключ), ПараметрыПолученияИдентификаторов, АдресаПеременных);		
			
		СтарыеИдентификаторыНастроек = СоответствиеИдентификаторовПоУзлам.Получить(НастройкиУзла.Ключ);
		Если СтарыеИдентификаторыНастроек = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Для каждого ТекущаяНастройка ИЗ НовыеИдентификаторыНастроек Цикл
			Если СтарыеИдентификаторыНастроек.Свойство(ТекущаяНастройка.Ключ)
				И СтарыеИдентификаторыНастроек[ТекущаяНастройка.Ключ] = НовыеИдентификаторыНастроек[ТекущаяНастройка.Ключ] Тогда
				СтарыеИдентификаторыНастроек.Удалить(ТекущаяНастройка.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Удаление настроек в базе Mobile SMARTS (старые ключи)
	Для каждого ИдентификаторыУзла ИЗ СоответствиеИдентификаторовПоУзлам Цикл
		НастройкиКУдалению = ИдентификаторыУзла.Значение;
		
		REST_API_УдалитьНастройкиSMARTSПоИдентификаторам(НастройкиКУдалению, АдресаПеременных);
	КонецЦикла;
	
	ГлЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияНастроекКонечная,, АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияНастроекКонечная, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

Функция ГлЯдро_ОбновитьНастройкиТаймаутов(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновитьНастройкиТаймаутов";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТаймаутыПоУмолчанию = ГлЯдро_ТаймаутыПоУмолчанию(АдресаПеременных);
	
	ОбновленныеНастройки = Ложь;
	
	ТекущаяНастройка = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов",Ложь,АдресаПеременных);
	Если ТекущаяНастройка = Неопределено 
		Или ТекущаяНастройка = Ложь Тогда
		ОбновленныеНастройки =  ТаймаутыПоУмолчанию;
	Иначе
		ТаблицаТекущихНастроек 	= ГлЯдро_МассивСтруктурВТаблицуЗначений(ТекущаяНастройка);
		ТаблицаПоУмолчанию 		= ГлЯдро_МассивСтруктурВТаблицуЗначений(ТаймаутыПоУмолчанию);
		Для Каждого СтрокаНастройки Из ТаблицаПоУмолчанию Цикл
			Если ТаблицаТекущихНастроек.Найти(СтрокаНастройки.ТипЗапроса, "ТипЗапроса") = Неопределено Тогда
				НС = ТаблицаТекущихНастроек.Добавить();
				ЗаполнитьЗначенияСвойств(НС,СтрокаНастройки);
			КонецЕсли;
		КонецЦикла;
		ОбновленныеНастройки = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ТаблицаТекущихНастроек);
	КонецЕсли;
	
	ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиТаймаутов",ОбновленныеНастройки,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ОбновленныеНастройки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ОбновленныеНастройки;
КонецФункции

// Изменение структуры глобальных параметров:
// 	1. ГлобальныеПараметры разделены на ГлобальныеПараметры_ПоУмолчанию и ГлобальныеПараметры_Пользовательские
// 	2. Для хранения параметров главного узла используется настройка ГлобальныеПараметры_Значения вместо ГлобальныеПараметры
// 	3. Настройка ЗначенияПараметровУзлов_[УзелN] переименована в ГлобальныеПараметры_Значения_[УзелN]
Функция ГлЯдро_ВыполнитьОбновлениеГлобальныхПараметров(ИзмененияВСтруктуре, ИзмененияВКэше, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ВыполнитьОбновлениеГлобальныхПараметров";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИзмененияВСтруктуре,ИзмененияВКэше",
		ИзмененияВСтруктуре, ИзмененияВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	ГлобальныеПараметры = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры",, АдресаПеременных);
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
		ГлобальныеПараметры_Значения 		 = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения",,, 	 АдресаПеременных);
	    ГлобальныеПараметры_ПоУмолчанию 	 = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_ПоУмолчанию",, 	 АдресаПеременных);
		ГлобальныеПараметры_Пользовательские = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_Пользовательские",, АдресаПеременных);
		
		ЕстьГлобальныеПараметры_Значения 		 = ЗначениеЗаполнено(ГлобальныеПараметры_Значения) И НЕ ГлобальныеПараметры_Значения = Ложь;
		ЕстьГлобальныеПараметры_ПоУмолчанию 	 = ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь;
		ЕстьГлобальныеПараметры_Пользовательские = ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь;
		
		Если НЕ ЕстьГлобальныеПараметры_Значения Тогда
			ГлобальныеПараметры_Значения = Новый Массив;
			ГлобальныеПараметры_Значения.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
		КонецЕсли;
		
		Если НЕ ЕстьГлобальныеПараметры_Пользовательские Тогда
			ГлобальныеПараметры_Пользовательские = Новый Массив;
			ГлобальныеПараметры_Пользовательские.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
		КонецЕсли;
			
		Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры Цикл	
			Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
						
			// Дополняем ключ ГлобальныеПараметры_Значения значениями ключа ГлобальныеПараметры
			НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", СтрокаПараметра.ID_Параметра);
			Если НайденныйПараметр = Неопределено Тогда
				ГлобальныеПараметры_Значения.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПараметра));	
			КонецЕсли;
						
			// Дополняем ключ ГлобальныеПараметры_Пользовательские по наличию настроек в ключе ГлобальныеПараметры_ПоУмолчанию
			Если ЕстьГлобальныеПараметры_ПоУмолчанию Тогда
				НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаПараметра.ID_Параметра);
				Если НайденныйПараметр <> Неопределено Тогда
					Продолжить;						
				КонецЕсли;
						
				НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Пользовательские, "ID_Параметра", СтрокаПараметра.ID_Параметра);
				Если НайденныйПараметр = Неопределено Тогда
					ГлобальныеПараметры_Пользовательские.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПараметра));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ГлЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("ГлобальныеПараметры"),,, АдресаПеременных);
		ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", Неопределено, "", АдресаПеременных);
		
		// Если нет ключа ГлобальныеПараметры_ПоУмолчанию, дополняем ключ ГлобальныеПараметры_Пользовательские по наличию настроек в ключе ГлобальныеПараметры 
		Если НЕ ЕстьГлобальныеПараметры_ПоУмолчанию Тогда
            ГлобальныеПараметры_ПоУмолчанию = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры",,, АдресаПеременных);
			Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
                Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры Цикл	
					Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
				
					НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр <> Неопределено Тогда
						Продолжить;						
					КонецЕсли;
							
					НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Пользовательские, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						ГлобальныеПараметры_Пользовательские.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПараметра));
					КонецЕсли;
				КонецЦикла;
				
				ИзмененияВКэше.Вставить("ГлобальныеПараметры_ПоУмолчанию", ГлобальныеПараметры_ПоУмолчанию);
			КонецЕсли;
			ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", Неопределено, "", АдресаПеременных);
		КонецЕсли;
		
		ИзмененияВСтруктуре.Вставить("ГлобальныеПараметры_Значения", 		 ГлобальныеПараметры_Значения);
		ИзмененияВСтруктуре.Вставить("ГлобальныеПараметры_Пользовательские", ГлобальныеПараметры_Пользовательские);
		
		ИзмененияВКэше.Вставить("ГлобальныеПараметры_Пользовательские", 	 ГлобальныеПараметры_Пользовательские);
		ИзмененияВКэше.Вставить("ГлобальныеПараметры", 						 Неопределено);
		
		Если ID_ТекущегоУзла = "" Тогда
			ИзмененияВКэше.Вставить("ГлобальныеПараметры_Значения", 	 	 ГлобальныеПараметры_Пользовательские);	
		КонецЕсли;
	КонецЕсли;
	
	ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ID_Узла = СтрокаУзла.ID_Узла;
			
			// ЗначенияПараметровУзлов_[Узел] заменяем на ГлобальныеПараметры_Значения_[Узел]
			ЗначенияПараметровУзлов = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ЗначенияПараметровУзлов", ID_Узла,, АдресаПеременных);
			Если ЗначениеЗаполнено(ЗначенияПараметровУзлов) И НЕ ЗначенияПараметровУзлов = Ложь Тогда
				ГлобальныеПараметры_Значения = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения", ID_Узла,, АдресаПеременных);
			    
				ЕстьГлобальныеПараметры_Значения = ЗначениеЗаполнено(ГлобальныеПараметры_Значения) И НЕ ГлобальныеПараметры_Значения = Ложь;
				Если НЕ ЕстьГлобальныеПараметры_Значения Тогда
					ГлобальныеПараметры_Значения = Новый Массив;
					ГлобальныеПараметры_Значения.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
				КонецЕсли;
				
				Для каждого СтрокаПараметра ИЗ ЗначенияПараметровУзлов Цикл	
					Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
								
					// Дополняем ключ ГлобальныеПараметры_Значения_[Узел] значениями ключа ЗначенияПараметровУзлов_[Узел]
					НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						ГлобальныеПараметры_Значения.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПараметра));	
					КонецЕсли;
				КонецЦикла;
				
				ГлЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("ЗначенияПараметровУзлов"),, ID_Узла, АдресаПеременных);
				
				ГлЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Значения, ID_Узла, АдресаПеременных);
				
				Если ID_ТекущегоУзла = ID_Узла Тогда
					ИзмененияВКэше.Вставить("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Пользовательские);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ГлЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияГлобальныеПараметры", 1003014000,, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Истина;	
	
КонецФункции

// Изменение структуры НастройкиОбменаСправочников задача PRODUCTS-17494:
//	Разделить НастройкиОбменаСправочников на 
//		НастройкиОтборовСправочников_Интерактивный 	- оставить разделение по ТО только для частных баз. Хранит настройки СКД и текст получения параметров.
//		НастройкиОтборовСправочников_Автообмен 		- оставить разделение по ТО только для частных баз. Хранит настройки СКД и текст получения параметров.
//		НастройкиОтборовСправочников_Онлайн 			- оставить разделение по ТО для всех. Хранит настройки СКД и текст получения параметров.
//		НастройкиОбменаСправочников 				- основная таблица используется как основной источник настроек и не разделяется по ТО. 
//														Хранит способы выгрузки, тексты запросов, общие настройки для всех режимов выгрузки.
//
Функция ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2(ИзмененияВСтруктуре, ИзмененияВКэше, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИзмененияВСтруктуре,ИзмененияВКэше",
		ИзмененияВСтруктуре, ИзмененияВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ГлЯдро_СобратьНастройкиОбменаСправочников(, АдресаПеременных);
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;
	
	// Получаем настройки по всем узлам.
	НастройкиГлавногоУзла = Новый Структура;
	НастройкиГлавногоУзла.Вставить("НастройкиОбменаСправочников");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Онлайн");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Интерактивный");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Автообмен");
	
	НастройкиГлавногоУзла = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиГлавногоУзла,,,, АдресаПеременных);
	
	// Формируем новые массивы настроек
	КолонкиТаблицы = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОбменаСправочников) = Тип("Массив") Тогда
		НастройкиОбменаСправочников = НастройкиГлавногоУзла.НастройкиОбменаСправочников;
	Иначе
		НастройкиОбменаСправочников = Новый Массив;
		НастройкиОбменаСправочников.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников()));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Онлайн) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Онлайн = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Онлайн;
	Иначе
		НастройкиОтборовСправочников_Онлайн = Новый Массив;
		НастройкиОтборовСправочников_Онлайн.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Интерактивный) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Интерактивный = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Интерактивный;
	Иначе
		НастройкиОтборовСправочников_Интерактивный = Новый Массив;
		НастройкиОтборовСправочников_Интерактивный.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Автообмен) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Автообмен = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Автообмен;
	Иначе
		НастройкиОтборовСправочников_Автообмен = Новый Массив;
		НастройкиОтборовСправочников_Автообмен.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	НастройкиОбменаСправочников_Узлы 					= Новый Структура;
	НастройкиОтборовСправочников_Онлайн_Узлы 			= Новый Структура;
	НастройкиОтборовСправочников_Интерактивный_Узлы 	= Новый Структура;
	НастройкиОтборовСправочников_Автообмен_Узлы 		= Новый Структура;
	
	// НастройкиОбменаСправочников больше не являются узловыми настройками,
	// 	но чтобы получить узловые значения, временно добавим их в список узловых.
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	пКатегорииНастроекMS = ГлЯдро_СкопироватьСтруктуру(КатегорииНастроекMS);
	пКатегорииНастроекMS.УзловыеНастройки.Добавить("НастройкиОбменаСправочников");
	
	ИдентификаторыУзлов = Новый Структура;
	
	ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ID_Узла = "";
			Если СтрокаУзла.Свойство("ID_Узла") Тогда
				ID_Узла = СтрокаУзла.ID_Узла;
			КонецЕсли;
			
			Если ПустаяСтрока(ID_Узла) Тогда
				Продолжить;
			КонецЕсли;
			
			ИспользоватьЧастнуюБазу = СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу") И СтрокаУзла.ИспользоватьЧастнуюБазу = Истина;
			ИдентификаторыУзлов.Вставить(ID_Узла, ИспользоватьЧастнуюБазу);
			
			СтруктураНастроек = Новый Структура;
			СтруктураНастроек.Вставить("НастройкиОбменаСправочников");
			СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Онлайн");
			
			Если ИспользоватьЧастнуюБазу Тогда
				СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Интерактивный");
				СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Автообмен");
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("НеКэшировать", Истина);
			ДополнительныеПараметры.Вставить("НеПроверятьАктуальность", Истина);
			СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, пКатегорииНастроекMS, ID_Узла, ДополнительныеПараметры, АдресаПеременных);
			
			// НастройкиОбменаСправочников
			ЗначениеУзла = СтруктураНастроек.НастройкиОбменаСправочников;
			Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
				ЗначениеУзла = ГлЯдро_СкопироватьМассив(НастройкиОбменаСправочников);
			КонецЕсли;
			НастройкиОбменаСправочников_Узлы.Вставить(ID_Узла, ЗначениеУзла);
			
			// НастройкиОтборовСправочников_Онлайн
			ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Онлайн;
			Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
				ЗначениеУзла = ГлЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Онлайн);
			КонецЕсли;
			НастройкиОтборовСправочников_Онлайн_Узлы.Вставить(ID_Узла, ЗначениеУзла);
			
			Если ИспользоватьЧастнуюБазу Тогда
				
				// НастройкиОтборовСправочников_Интерактивный
				ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Интерактивный;
				Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
					ЗначениеУзла = ГлЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Интерактивный);
				КонецЕсли;
				НастройкиОтборовСправочников_Интерактивный_Узлы.Вставить(ID_Узла, ЗначениеУзла);
				
				// НастройкиОтборовСправочников_Онлайн
				ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Автообмен;
				Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
					ЗначениеУзла = ГлЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Автообмен);
				КонецЕсли;
				НастройкиОтборовСправочников_Автообмен_Узлы.Вставить(ID_Узла, ЗначениеУзла);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Для каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл	
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаНастройки = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки, СтрокаНастройки);
		
		ИмяТаблицы = НоваяСтрокаНастройки.ИмяТаблицы;
		
		// Значения главного узла (обновление/добавление)
		Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Онлайн, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Онлайн.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Обновляем значение из НастройкиОбменаСправочников, т.к в старой версии ОО настройка могла быть изменена
			ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Онлайн[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Интерактивный, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Интерактивный.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
			//ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Интерактивный[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Автообмен, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Автообмен.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
			//ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Автообмен[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		// Значения узлов (обновление/добавление)
		Для каждого КлючЗначение Из ИдентификаторыУзлов Цикл
			
			ID_Узла = КлючЗначение.Ключ;
			ЭтоЧастнаяБаза = КлючЗначение.Значение;
			
			СтрокаНастройкиУзла = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОбменаСправочников_Узлы[ID_Узла], "ИмяТаблицы", СтрокаНастройки.ИмяТаблицы);
			Если СтрокаНастройкиУзла <> Неопределено Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки, СтрокаНастройкиУзла);
				
				ЗначениеУзла = НастройкиОтборовСправочников_Онлайн_Узлы[ID_Узла];
				Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
				Если Индекс = Неопределено Тогда
					ЗначениеУзла.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
				Иначе
					// Обновляем значение из НастройкиОбменаСправочников, т.к в старой версии ОО настройка могла быть изменена
					ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
				КонецЕсли;
				
				// В интерактивном и автообмене разделение по узлам оставляем только в частных базах
				Если ЭтоЧастнаяБаза Тогда
					
					ЗначениеУзла = НастройкиОтборовСправочников_Интерактивный_Узлы[ID_Узла];
					Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
					Если Индекс = Неопределено Тогда
						ЗначениеУзла.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
					Иначе
						// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
						//ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
					КонецЕсли;
					
					ЗначениеУзла = НастройкиОтборовСправочников_Автообмен_Узлы[ID_Узла];
					Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
					Если Индекс = Неопределено Тогда
						ЗначениеУзла.Добавить(ГлЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
					Иначе
						// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
						//ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	// Сохраняем настройки в базе МС:
	// - общие настройки и значения главного узла (без ID_Узла) пишем одним вызовом
	// - узловые настройки пишем отдельным вызовом на каждый ID_Узла
	НастройкиКСохранению = Новый Структура;
	НастройкиКСохранению.Вставить("НастройкиОбменаСправочников", 					НастройкиОбменаСправочников);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Онлайн", 			НастройкиОтборовСправочников_Онлайн);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Интерактивный", 	НастройкиОтборовСправочников_Интерактивный);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Автообмен", 		НастройкиОтборовСправочников_Автообмен);
	
	ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению, "",, АдресаПеременных);
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Онлайн_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Онлайн", КлючЗначение.Значение);
		ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ,, АдресаПеременных);
	КонецЦикла;
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Интерактивный_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Интерактивный", КлючЗначение.Значение);
		ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ,, АдресаПеременных);
	КонецЦикла;
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Автообмен_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Автообмен", КлючЗначение.Значение);
		ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ,, АдресаПеременных);
	КонецЦикла;
	
	// Сохраняем узловые настройки в кэш
	ИзмененияВКэше.Вставить("НастройкиОбменаСправочников", 	 НастройкиОбменаСправочников);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Онлайн", 			НастройкиОтборовСправочников_Онлайн);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Интерактивный", 	НастройкиОтборовСправочников_Интерактивный);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Автообмен", 		НастройкиОтборовСправочников_Автообмен);
	Если НЕ ПустаяСтрока(ID_ТекущегоУзла) Тогда
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Онлайн_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Онлайн", ЗначениеНастройки);
		КонецЕсли;
		
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Интерактивный_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Интерактивный", ЗначениеНастройки);
		КонецЕсли;
		
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Автообмен_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Автообмен", ЗначениеНастройки);
		КонецЕсли;
	КонецЕсли;
	
	ГлЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияНастройкиОбменаСправочников", 1003025002,, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Истина;	
	
КонецФункции

// Миграция настроек справочников между новым и старым форматами:
//
// - ВерсияСтруктурыНастроек_ПоУмолчанию отсутствует (ключ не задан) - поддерживается совместимость НастройкиОбменаСправочников с ОО 1.7.0.
//    При подключении к старой базе при каждой инициализации выполняется обновление 1_3_25_2.
//    Это необходимо для актуализации узловых настроек НастройкиОтборовСправочников 
//		из НастройкиОбменаСправочников на случай, если они были изменены в старых версиях ОО.
//
// - ВерсияСтруктурыНастроек_ПоУмолчанию = 2 - поддержка старого формата прекращена, считается, что выполнен полный переход на ОО 2.0.
//    При подключении к базе версии 2.0 обновление выполняется один раз.
//
Функция ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5(ИзмененияВСтруктуре, ИзмененияВКэше, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИзмененияВСтруктуре,ИзмененияВКэше",
		ИзмененияВСтруктуре, ИзмененияВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ВерсияСтруктурыНастроек_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияСтруктурыНастроек_ПоУмолчанию",, АдресаПеременных);
	ВерсияСтруктурыНастроек_ПоУмолчанию = ГлЯдро_НормализоватьВерсиюВЧисло(ВерсияСтруктурыНастроек_ПоУмолчанию);
	
	Если ВерсияСтруктурыНастроек_ПоУмолчанию < 2000000001 Тогда
		
		// ДатаАктуальностиМиграцииНастроек — дублирует ДатаАктуальностиКэшируемыхНастроек.
		// Используется для отслеживания запуска старых версий ОО.
		// Если даты не совпадают, значит выполнялся запуск версии ОО 1.7.0, и будет произведена повторная миграция настроек.
		
		ДатаАктуальностиМиграцииНастроек = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ДатаАктуальностиМиграцииНастроек",,, АдресаПеременных);
		Если ТипЗнч(ДатаАктуальностиМиграцииНастроек) = Тип("Строка") Тогда
			ДатаАктуальностиМиграцииНастроек = REST_API_ПреобразоватьКДате(ДатаАктуальностиМиграцииНастроек);
		КонецЕсли;
		
		Если ТипЗнч(ДатаАктуальностиМиграцииНастроек) = Тип("Дата") Тогда
			
			ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
			Если ПараметрыПодключенияMS = Неопределено Тогда
				ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
			КонецЕсли;
			
			ИдентификаторБазыMS = "";
			Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
				ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_"), "");
			КонецЕсли;
			
			СохраненнаяДатаАктуальности = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ДатаАктуальностиКэшируемыхНастроек_" + ИдентификаторБазыMS);
			
			Если ЗначениеЗаполнено(СохраненнаяДатаАктуальности)
				И СохраненнаяДатаАктуальности <> Ложь 
				И ДатаАктуальностиМиграцииНастроек < СохраненнаяДатаАктуальности Тогда
				
				ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2(ИзмененияВСтруктуре, ИзмененияВКэше, АдресаПеременных);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияНастройкиОбменаСправочников", 2001000005,, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ГлобальныйКонтекст_СправочникиИТаблицы

// Преобразует массив структур в таблицу значений
//
// Параметры:
//  МассивСтруктур - Массив из Структура - исходный массив структур
//
// Возвращаемое значение:
//	ТаблицаЗначений - полученная таблица значений
Функция ГлЯдро_МассивСтруктурВТаблицуЗначений(МассивСтруктур) Экспорт
	
	ТекстОшибки = "";
	
	Если ТипЗнч(МассивСтруктур) <> Тип("Массив") Тогда
	    ТекстОшибки = НСтр("ru = 'Ошибка преобразования массива структур в таблицу значений: Параметр не является массивом!';
							|en = 'Error converting an array of structures to a table of values: The parameter is not an array!';
							|be = 'Памылка пераўтварэнні масіва структур у табліцу значэнняў: Параметр не з''яўляецца масівам!'; es = 'Error al convertir una matriz de estructuras en una tabla de valores: ¡el Parámetro no es una matriz!'; ka = 'შეცდომა კონვერტაცია მასივი სტრუქტურების მაგიდასთან ღირებულებები: პარამეტრი არ არის მასივი!'; kk = 'Құрылым массивін мәндер кестесіне түрлендіру қатесі: Параметр массив емес!'; ro = 'Eroare la conversia unei matrice de structuri într-un tabel de valori: parametrul nu este o matrice!'; tr = 'Yapı dizisini değer tablosuna dönüştürme hatası: Parametre bir dizi değil!'; uk = 'Помилка перетворення масиву структур у таблицю значень: Параметр не є масивом!'; uz = 'Tuzilmalar qatorini qiymatlar jadvaliga aylantirishda xato: parametr qator emas!'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить(); // tr
		Возврат Неопределено;
	КонецЕсли; 
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеТЗ = МассивСтруктур[0];
	Если ТипЗнч(ОписаниеТЗ) <> Тип("Структура") Тогда
		ТекстОшибки = НСтр("ru = 'Ошибка преобразования массива структур в таблицу значений: Не обнаружено описание таблицы значений!';
							|en = 'Error converting an array of structures to a table of values: No description of the table of values was found!';
							|be = 'Памылка пераўтварэння масіва структур у табліцу значэнняў: не выяўлена Апісанне табліцы значэнняў!'; es = 'Error al convertir una matriz de estructuras en una tabla de valores: ¡no se encontró una descripción de la tabla de valores!'; ka = 'შეცდომა კონვერტაცია მასივი სტრუქტურების მაგიდასთან ღირებულებები: არ აღწერა მაგიდასთან ღირებულებები იქნა ნაპოვნი!'; kk = 'Құрылым массивін мәндер кестесіне түрлендіру қатесі: мәндер кестесінің сипаттамасы табылмады!'; ro = 'Eroare la conversia unei matrice de structuri într-un tabel de valori: nu a fost găsită nicio descriere a tabelului de valori!'; tr = 'Yapı dizisi değer tablosuna dönüştürülürken hata oluştu: Değer tablosu açıklaması algılanmadı!'; uk = 'Помилка перетворення масиву структур у таблицю значень: не виявлено опис таблиці значень!'; uz = 'Tuzilmalar qatorini qiymatlar jadvaliga aylantirishda xato: qiymatlar jadvalining tavsifi topilmadi!'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить(); 
		Возврат Неопределено;
	КонецЕсли;
	
	КолонкиТЗ = "";
	Если НЕ ОписаниеТЗ.Свойство("ЭтоТаблицаЗначений") ИЛИ НЕ ОписаниеТЗ.Свойство("КолонкиТаблицыЗначений") Тогда
		МассивКолонок = Новый Массив;
		Для Каждого Колонка Из ОписаниеТЗ Цикл
			МассивКолонок.Добавить(Колонка.Ключ);	
		КонецЦикла;
		ИндексНачала = 0;
	Иначе 
		КолонкиТЗ = ОписаниеТЗ.КолонкиТаблицыЗначений;
		МассивКолонок = ГлЯдро_РазложитьСтрокуВМассивПодстрок(КолонкиТЗ, ",");
		ИндексНачала = 1;
	КонецЕсли;
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для каждого НаименованиеКолонки Из МассивКолонок Цикл
		ТаблицаЗначений.Колонки.Добавить(НаименованиеКолонки);
	КонецЦикла; 
	
	Для Сч = ИндексНачала По МассивСтруктур.Количество() - 1 Цикл
		
		Если ТипЗнч(МассивСтруктур[Сч]) = Тип("Структура") Тогда
			НоваяСтрока = ТаблицаЗначений.Добавить();
			Результат = Новый Структура();
			Для каждого Элемент Из МассивСтруктур[Сч] Цикл
			
				Если ТипЗнч(Элемент.Значение) = Тип("Массив")Тогда
				
					Результат.Вставить(Элемент.Ключ, ГлЯдро_МассивСтруктурВТаблицуЗначений(Элемент.Значение));
					
				Иначе
					
					Результат.Вставить(Элемент.Ключ, Элемент.Значение);
					
				КонецЕсли; 
			
			КонецЦикла; 
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат);
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ТаблицаЗначений;

КонецФункции

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Параметры:
//	ТаблицаЗначений - ТаблицаЗначений - исходная таблица значений.
//
// Возвращаемое значение:
//	Массив из Структура - коллекция строк таблицы в виде структур.
Функция ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ТаблицаЗначений) Экспорт
	
	Если ТипЗнч(ТаблицаЗначений) = Тип("Массив") Тогда
		Возврат ТаблицаЗначений;
	КонецЕсли;
	
	Массив = Новый Массив();
	
	Если ТипЗнч(ТаблицаЗначений) <> Тип("ТаблицаЗначений") И ТипЗнч(ТаблицаЗначений) <> Тип("ДеревоЗначений") Тогда
	    Возврат Массив;
	КонецЕсли; 

	СтруктураСтрокой = "";
	НужнаЗапятая = Ложь;
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если НужнаЗапятая Тогда
			СтруктураСтрокой = СтруктураСтрокой + ",";
		КонецЕсли;
		СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
		НужнаЗапятая = Истина;
	КонецЦикла;
	
	СтруктураСтрокой = СтруктураСтрокой;
	
	ОписаниеТаблицыЗначений = Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, СтруктураСтрокой); 
	Массив.Добавить(ОписаниеТаблицыЗначений);
	
	Для Каждого Строка Из ТаблицаЗначений Цикл
		НоваяСтрока = Новый Структура(СтруктураСтрокой);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Для каждого ЭлементСтруктуры Из НоваяСтрока Цикл
		
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
				НоваяСтрока.Вставить(ЭлементСтруктуры.Ключ, ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ЭлементСтруктуры.Значение));
			КонецЕсли; 
		
		КонецЦикла; 
		Массив.Добавить(НоваяСтрока);
	КонецЦикла;
	
	Возврат Массив;

КонецФункции

// Создает массив копированием исходного по заданному отбору
//
// Параметры:
//	МассивИсточник - Массив из Произвольный - исходный массив
//	Отбор - Неопределено, Структура - отбор, применяемый в случае, когда элементами исходного массива являются структуры
//
// Возвращаемое значение:
//	- Массив из Произвольный - полученный массив
//  - Неопределено - если в параметр МассивИсточник передан не массив
Функция ГлЯдро_СкопироватьМассив(МассивИсточник,Отбор = Неопределено) Экспорт
	Если ТипЗнч(МассивИсточник)<>Тип("Массив") Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	МассивПриемник = Новый Массив;
	Для Каждого ЭлементМассива Из МассивИсточник Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
			Если Отбор <> Неопределено 
				И НЕ ГлЯдро_СтруктураПодходитПодОтбор(ЭлементМассива,Отбор) Тогда
				Продолжить;
			КонецЕсли;
			МассивПриемник.Добавить(ГлЯдро_СкопироватьСтруктуру(ЭлементМассива));
		ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("Массив") Тогда
			МассивПриемник.Добавить(ГлЯдро_СкопироватьМассив(ЭлементМассива));
		Иначе
			МассивПриемник.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;	
	Возврат МассивПриемник;
КонецФункции

// Создает структуру копированием исходной
//
// Параметры:
//	СтруктураИсточник - Структура - исходная структура.
//	СписокКолонок - Неопределено, Строка - список ключей структуры, разделенных запятыми, которые необходимо скопировать.
//										   Если параметр не передан, копируются все ключи.
//
// Возвращаемое значение:
//	Структура - полученная структура.
Функция ГлЯдро_СкопироватьСтруктуру(СтруктураИсточник,СписокКолонок = Неопределено) Экспорт
	СтруктураПриемник = Новый Структура;
	
	Если СписокКолонок <> Неопределено Тогда
		Колонки = ГлЯдро_РазложитьСтрокуВМассивПодстрок(СписокКолонок, ",");
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из СтруктураИсточник Цикл
		
		Если СписокКолонок <> Неопределено 
			И Колонки.Найти(ЭлементСтруктуры.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Структура") Тогда
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ГлЯдро_СкопироватьСтруктуру(ЭлементСтруктуры.Значение));
		ИначеЕсли ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив") Тогда
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ГлЯдро_СкопироватьМассив(ЭлементСтруктуры.Значение));
		Иначе
			СтруктураПриемник.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураПриемник;
КонецФункции

// Проверяет соответствие произвольной структуры переданному отбору
// Соответствие подразумевает, что в структуре есть все ключи, содержащиеся в отборе,
// и значения структуры и отбора по одинаковым ключам совпадают.
//
// Параметры:
//	Структура - Структура - структура, которую требуется проверить на соответствие отбору.
//	Отбор - Структура - отбор, по которому требуется проверить соответствие.
//
// Возвращаемое значение:
//	Булево - признак соответствия структуры переданному отбору.
Функция ГлЯдро_СтруктураПодходитПодОтбор(Структура,Отбор) Экспорт
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если НЕ Структура.Свойство(ЭлементОтбора.Ключ)
			ИЛИ Структура[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Вызывает функции преобразования данных выгружаемой таблицы и выгрузки подготовленной таблицы на сервер Клеверенс 
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	ТаблицаДляВыгрузки - ТаблицаЗначений, Массив из Структура, Структура - данные выгружаемой таблицы
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы		
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
Функция ГлЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицы, Знач ТаблицаДляВыгрузки, ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТаблицаДляВыгрузки,ТипБазы",
		ИмяТаблицы, ТаблицаДляВыгрузки, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ЭтоАдресВременногоХранилища(ТаблицаДляВыгрузки) Тогда
		ТаблицаДляВыгрузки = ПолучитьИзВременногоХранилища(ТаблицаДляВыгрузки);
	КонецЕсли;
	
	ДанныеДляВыгрузки = ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц(ИмяТаблицы, ТаблицаДляВыгрузки, ТипБазы, АдресаПеременных);
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных); // ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Начало, Выгрузка подготовленной таблицы на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Getting started, Uploading the prepared table to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Пачатак, Выгрузка падрыхтаванай табліцы на сервер Cleverence. Імя табліцы: %1, тып інтэрфейсу: %2'; es = 'Inicio, Descarga la tabla preparada en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'დაწყება, მომზადებული ცხრილის ატვირთვა Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Бастау, дайындалған кестені Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'Noțiuni de bază, încărcarea tabelului pregătit pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Başlangıç, Hazırlanan tablonun Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Початок, вивантаження підготовленої таблиці на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Boshlash, tayyorlangan jadvalni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
		ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
		ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
	Иначе
		ПараметрыВыгрузки = ГлЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника(ИмяТаблицы, "Интерактивный", АдресаПеременных);
		ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда
		РезультатВыгрузки = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);		
	Иначе
		РезультатВыгрузки = КомЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);
	КонецЕсли;
	
	Если НЕ РезультатВыгрузки.Статус Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"РезультатВыгрузки",
			РезультатВыгрузки);
		ЛогОшибка(логСобытие, РезультатВыгрузки.Сообщение,, логКонтекст,,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выгрузка подготовленной таблицы на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Finally, the prepared table is uploaded to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Канец, Выгрузка падрыхтаванай табліцы на сервер Cleverence. Імя табліцы: %1, Тып інтэрфейсу: %2'; es = 'Fin, Carga la tabla preparada en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'დაბოლოს, მომზადებული ცხრილი ატვირთულია Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Соңы, дайындалған кестені Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'În cele din urmă, tabelul pregătit este încărcat pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Son, Hazırlanan tablonun Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Кінець, вивантаження підготовленої таблиці на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Tugatish, tayyorlangan jadvalni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

Функция ГлЯдро_ОбщийМодуль(НазваниеМодуля)
	
	Если Метаданные.ОбщиеМодули.Найти(НазваниеМодуля) <> Неопределено Тогда
        Модуль = ГлЯдро_ВычислитьВБезопасномРежиме(НазваниеМодуля);
    Иначе
        Модуль = Неопределено;
    КонецЕсли;
    
    Возврат Модуль;
	
КонецФункции

Функция ГлЯдро_ОбщийМодульСуществует(НазваниеМодуля) Экспорт
	
	Возврат Метаданные.ОбщиеМодули.Найти(НазваниеМодуля) <> Неопределено;
	
КонецФункции

Процедура ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяСправочника = Неопределено, Прогресс = Неопределено)
	
	Если ПрогрессВыгрузкиСправочников = Неопределено Тогда // инициализируется для фонового задания
		Возврат;
	КонецЕсли;	
	
	ТекстПрогресса = "";
	Для Каждого ПрогрессВыгрузки Из ПрогрессВыгрузкиСправочников Цикл
		Если ПрогрессВыгрузки.ИмяСправочника = ИмяСправочника Тогда
			ПрогрессВыгрузки.Прогресс = Прогресс;
		КонецЕсли;
		ТекстПрогресса = ТекстПрогресса + Символы.ПС + ПрогрессВыгрузки.ИмяТаблицыПредставление + " - " + ПрогрессВыгрузки.Прогресс;
	КонецЦикла;
	
	Если ГлЯдро_ОбщийМодульСуществует("ДлительныеОперации") Тогда
		ГлЯдро_ОбщийМодуль("ДлительныеОперации").СообщитьПрогресс(, ТекстПрогресса);
	ИначеЕсли ГлЯдро_ОбщийМодульСуществует("TimeConsumingOperations") Тогда
		ГлЯдро_ОбщийМодуль("TimeConsumingOperations").ReportProgress(, ТекстПрогресса);
	КонецЕсли;	
	
КонецПроцедуры

Функция ГлЯдро_ВыгрузитьТаблицыНаСерверSMARTS(Параметры, АдресРезультата = Неопределено) Экспорт

	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ГлЯдро_ВыгрузитьТаблицыНаСерверSMARTS";
		
	РезультатВыгрузки = Новый Массив;
	
	ЗапускВФоне = ТипЗнч(АдресРезультата) = Тип("Строка");
	
	АдресаПеременных = ?(ЗапускВФоне, Параметры.ЗначенияПеременных, АдресРезультата);
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия,, АдресаПеременных);
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Параметры,ЗапускВФоне",
		Параметры, ЗапускВФоне);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст,, АдресаПеременных);
	// </Лог>
	
	ПараметрыВыгрузкиСправочников = Неопределено;
	Параметры.Свойство("ПараметрыВыгрузкиСправочников", ПараметрыВыгрузкиСправочников);
	
	СписокИспользуемыхСправочников = Неопределено;
	
	Если ПараметрыВыгрузкиСправочников = Неопределено Тогда		
		СписокИспользуемыхСправочников = ГлЯдро_ПолучитьСписокИспользуемыхСправочников(АдресаПеременных);		
	КонецЕсли;
	
	МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
	
	//Может вернуться неопределено в случае, если нет интеграционной обработки
	//Попробуем получить ИО снова
	Если  МетаданныеНСИ = Неопределено
		ИЛИ (ПараметрыВыгрузкиСправочников = Неопределено и СписокИспользуемыхСправочников = Неопределено) Тогда
		
		ГлЯдро_ПодключитьИнтеграционнуюОбработку(,,,,АдресаПеременных);
		
		МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
		
		Если ПараметрыВыгрузкиСправочников = Неопределено Тогда
			СписокИспользуемыхСправочников = ГлЯдро_ПолучитьСписокИспользуемыхСправочников(АдресаПеременных);
			Если  МетаданныеНСИ = Неопределено
				ИЛИ СписокИспользуемыхСправочников = Неопределено Тогда
				// <Лог>
				ЯзСтрока = "ru = 'Не удалось получить список используемых справочников';
									|en = 'Couldn''t get a list of used directories';
									|be = 'Не ўдалося атрымаць спіс выкарыстоўваюцца даведнікаў'; es = 'No se pudo obtener la lista de referencias utilizadas'; ka = 'ვერ მივიღე გამოყენებული დირექტორიების სია'; kk = 'Пайдаланылған анықтамалықтардың тізімін алу мүмкін болмады'; ro = 'Nu s-a putut obține o listă de directoare utilizate'; tr = 'Kullanılan dizinlerin listesi alınamadı'; uk = 'Не вдалося отримати список використовуваних довідників'; uz = 'Ishlatilgan kataloglar ro''yxatini ololmadim'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
				// </Лог>
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	АвтотестКлеверенс = Неопределено;
	Если Не Параметры.Свойство("Автотест", АвтотестКлеверенс) Тогда
		АвтотестКлеверенс = Ложь;
	КонецЕсли;
	
	// В Автотесте принудительно выгружаем справочники два раза: 1 раз всегда с перезаписью, второй раз с дозаписью. 
	КоличествоВыгрузок = 1;
	Если АвтотестКлеверенс Тогда
		КоличествоВыгрузок = 2;
	КонецЕсли;
	
	// Инициализируем прогресс выгрузки
	Если ЗапускВФоне Тогда
		ПрогрессВыгрузкиСправочников = Новый Массив;
		Для Каждого ПараметрыВыгрузкиСправочника Из ПараметрыВыгрузкиСправочников Цикл
			ИмяСправочника = ПараметрыВыгрузкиСправочника.ИмяСправочника;
			ИмяТаблицыПредставление = Неопределено;
			Если Не ПараметрыВыгрузкиСправочника.ПараметрыВыгрузки.Свойство("ИмяТаблицыПредставление", ИмяТаблицыПредставление) Тогда
				ИмяТаблицыПредставление = ИмяСправочника;
			КонецЕсли;
			ПрогрессВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ИмяТаблицыПредставление, Прогресс", ИмяСправочника, ИмяТаблицыПредставление, 
				НСтр("ru = 'Ожидает';
						|en = 'Awaiting'; be = 'Чакаць'; es = 'Espera'; ka = 'ელოდება'; kk = 'Күтеді'; ro = 'În așteptare'; tr = 'Bekliyor'; uk = 'Очікувавши'; uz = 'Kutmoqda'")
			));
		КонецЦикла;	
		ГлЯдро_СообщитьПрогрессВыгрузкиСправочников();
	КонецЕсли;

	ТипБазы = Неопределено;
	
	НастройкаКомпоновщикаСтрокой = "";
	
	СоответствиеПараметровПорционнойВыгрузки = ГлЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки(АдресаПеременных);
	
	// цикл по справочникам
	НомерВыгрузки = 1;
	Пока НомерВыгрузки <= КоличествоВыгрузок Цикл
		Для Каждого ПараметрыВыгрузкиСправочника ИЗ ПараметрыВыгрузкиСправочников Цикл
			
			СправочникИмя 		= ПараметрыВыгрузкиСправочника.ИмяСправочника;
			ПараметрыВыгрузки 	= ПараметрыВыгрузкиСправочника.ПараметрыВыгрузки;
			
			Если НЕ ТипЗнч(ПараметрыВыгрузки) = Тип("Структура") ИЛИ НЕ ПараметрыВыгрузки.Свойство("НастройкаКомпоновщикаСтрокой", НастройкаКомпоновщикаСтрокой) Тогда
				НастройкаКомпоновщикаСтрокой = "";	
			КонецЕсли;
			
			НастройкиКомпоновщика = Ложь;
			Если НЕ ПустаяСтрока(НастройкаКомпоновщикаСтрокой) Тогда
				НастройкиКомпоновщика = ГлЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
			КонецЕсли;
			
			Если НЕ ТипЗнч(ПараметрыВыгрузки) = Тип("Структура") ИЛИ НЕ ПараметрыВыгрузки.Свойство("ТипБазы", ТипБазы) Тогда
				ТипБазы = Неопределено;	
			КонецЕсли;
			
			ИмяТаблицыПредставление = Неопределено;
			Если Не ПараметрыВыгрузки.Свойство("ИмяТаблицыПредставление", ИмяТаблицыПредставление) Тогда
				ИмяТаблицыПредставление = ИмяСправочника;
			КонецЕсли;
			
			Если ЗапускВФоне Тогда
				пСообщение = НСтр("ru = 'Выгрузка справочника [%1]';
									|en = 'Uploading the directory [%1]'; be = 'Выгрузка даведніка [%1]'; es = 'Descarga del directorio [%1]'; ka = 'ატვირთვა დირექტორია [%1]'; kk = 'Анықтамалықты түсіру [%1]'; ro = 'Încărcarea directorului [%1]'; tr = 'El kitabının boşaltılması [%1]'; uk = 'Вивантаження довідника [%1]'; uz = 'Katalogni yuklash [%1]'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицыПредставление);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Полный.Информация", пСообщение, , АдресаПеременных);
			КонецЕсли;
			
			Результат = Неопределено;
			
			Если АвтотестКлеверенс Тогда
				ПараметрыВыгрузки.ОчищатьПередВыгрузкой = ?(НомерВыгрузки = 1, Истина, Ложь);
			КонецЕсли;
			
			ПараметрыСпособаВыгрузки = Новый Структура;
			ПараметрыСпособаВыгрузки.Вставить("СправочникИмя", СправочникИмя);
			ПараметрыСпособаВыгрузки.Вставить("ПараметрыВыгрузки", ПараметрыВыгрузки);
			ПараметрыСпособаВыгрузки.Вставить("СоответствиеПараметровПорционнойВыгрузки", СоответствиеПараметровПорционнойВыгрузки);
			ПараметрыСпособаВыгрузки.Вставить("МетаданныеНСИ", МетаданныеНСИ);
			
			СтруктураСпособаВыгрузки = ГлЯдро_ОпределитьСпособВыгрузкиСправочника(ПараметрыСпособаВыгрузки, АдресаПеременных);
			
			Если СтруктураСпособаВыгрузки.ВыгрузитьСправочник Тогда
				Если СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки <> Неопределено Тогда
					ПараметрыВыгрузки.Вставить("ПараметрыПорционнойВыгрузки", СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки);
					Результат = ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями(СправочникИмя, НастройкиКомпоновщика,, ТипБазы,, СтруктураСпособаВыгрузки.РазмерПорции,, ПараметрыВыгрузки, АдресаПеременных);
				Иначе
					Результат = ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS(СправочникИмя, НастройкиКомпоновщика,, ТипБазы,,, ПараметрыВыгрузки, АдресаПеременных);
				КонецЕсли;
			КонецЕсли;
						
			Если Результат <> Неопределено Тогда
				
				РезультатВыгрузки.Добавить(Новый Структура("ИмяСправочника, ИмяТаблицыПредставление, Результат", СправочникИмя, ИмяТаблицыПредставление, Результат));
				
				Если ЗапускВФоне Тогда
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Полный.Информация", Результат.Сообщение, , АдресаПеременных);
					СообщениеРезультата = Результат.Сообщение;
					Если Лев(СообщениеРезультата,31) = "Не выгружено (пустой справочник" Тогда
					ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(СправочникИмя, НСтр("ru = 'Не выгружено (пустой справочник)';
																						|en = 'Not uploaded (empty directory)'; be = 'Не выгружана (пусты даведнік)'; es = 'No descargado (directorio vacío)'; ka = 'არ არის ატვირთული (ცარიელი დირექტორია)'; kk = 'Жүктелмеген (бос анықтамалық)'; ro = 'Nu este încărcat (director gol)'; tr = 'Yüklenmemiş (boş referans)'; uk = 'Не вивантажено (порожній довідник)'; uz = 'Yuklanmagan (bo''sh katalog)'"));
					Иначе
					ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(СправочникИмя, ?(Результат.Статус = Истина, 
						НСтр("ru = 'Выгружено';
								|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'"), 
						НСтр("ru = 'Ошибка';
								|en = 'Mistake'; be = 'Памылка'; es = 'Error'; ka = 'შეცდომა'; kk = 'Қате'; ro = 'Greșeală'; tr = 'Hata'; uk = 'Помилка'; uz = 'Xato'")
					));  
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
				
		НомерВыгрузки = НомерВыгрузки + 1;
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Если ЗапускВФоне Тогда
		ПоместитьВоВременноеХранилище(РезультатВыгрузки, АдресРезультата);
	Иначе
		Возврат РезультатВыгрузки;
	КонецЕсли;
		
КонецФункции

// Последовательно вызывает функции получения данных таблицы и выгрузки полученных данных на сервер Клеверенс
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//  НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ТипБазы - Строка - "Частная", "Временная", "Основная" 
//  ОчищатьСправочникПередВыгрузкой - Булево - флаг, определяющий нужно ли перезаписывать номенклатуру при выгрузке или добавлять к существующей номенклатуре
//  РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
Функция ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика = Ложь, ПараметрыКомпоновщика = Ложь, ТипБазы, ОчищатьСправочникПередВыгрузкой = Ложь, РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = Неопределено, АдресаПеременных) Экспорт
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,ТипБазы,ОчищатьСправочникПередВыгрузкой,РаботаБезАлкоголя,ПараметрыВыгрузки",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ТипБазы, ОчищатьСправочникПередВыгрузкой, РаботаБезАлкоголя, ПараметрыВыгрузки);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	РезультатВыгрузки = Неопределено;
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных); // ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Начало, Выгрузка таблицы на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Getting started, Uploading the table to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Пачатак, Выгрузка табліцы на сервер Cleverence. Імя табліцы: %1, тып інтэрфейсу: %2'; es = 'Inicio, Carga la tabla en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'დაწყება, ცხრილის ატვირთვა Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Бастау, кестені Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'Noțiuni de bază, încărcarea tabelului pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Başlangıç, Tablonun Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Початок, вивантаження таблиці на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Boshlash, jadvalni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	Сообщение = НСтр("ru = 'Начало выгрузки';
						|en = 'The beginning of unloading'; be = 'Пачатак выгрузкі'; es = 'Inicio de la descarga'; ka = 'გადმოტვირთვის დასაწყისი'; kk = 'Жүктеуді бастау'; ro = 'Începutul descărcării'; tr = 'Boşaltmanın başlangıcı'; uk = 'Початок вивантаження'; uz = 'Tushirishni boshlash'");
	ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение);
	// *****************************************************************************************************************************
	
	// +++ 15.06.20
	пСообщение = НСтр("ru = 'Начало.ИмяТаблицы :%1 НастройкиКомпоновщика: %2 ПараметрыКомпоновщика: %3';
						|en = 'Beginning.Table Name :%1 Component Settings: %2 Component parameters3';
						|be = 'Пачатак.ИмяТаблицы: %1 НастройкиКомпоновщика: %2 ПараметрыКомпоновщика: %3'; es = 'Comienzo.Nombretabla: %1 Configuracióncomponente :% 2 Especificacionescomponente: %3'; ka = 'დასაწყისი.ცხრილის სახელი: %1 კომპონენტის პარამეტრები: %2 კომპონენტის პარამეტრები3'; kk = 'Басталуы.Аты-Жөні Кестелер: %1 Параметрлерқұраушының: %2 Опцияларқұраушының: %3'; ro = 'Început.Nume tabel: % 1componder Settings: %2componder Settings: %3'; tr = 'Başlangıç.Tablo Adları :%1 Bileşen Ayarları: %2 Bileşen Ayarları: %3'; uk = 'Почавши.Імятабліци: %1 Настройкікомпоновщіка: %2 Параметрикомпоновщіка: %3'; uz = 'Boshlanish.Jadval nomi: %1komponder sozlamalari: %2komponder sozlamalari: %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы, ?(НастройкиКомпоновщика=Ложь,"Ложь","Заполнено"), ?(ПараметрыКомпоновщика=Ложь,"Ложь","Заполнено"));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	Если НастройкиКомпоновщика = Ложь Тогда
		НастройкаКомпоновщикаСтрокой = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "НастройкаКомпоновщикаСтрокой",, АдресаПеременных);
		Если ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
			НастройкиКомпоновщика = ГлЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
			пСообщение = НСтр("ru = 'Настройки компоновщика найдены. ИмяТаблицы:%1';
								|en = 'The linker settings are found. Table Name: %1'; be = 'Налады кампаноўніка знойдзеныя. ИмяТаблицы:%1'; es = 'Configuración del enlazador encontrado. Nombretabla:%1'; ka = 'Linker პარამეტრები გვხვდება. მაგიდის სახელი: %1'; kk = 'Сілтеме параметрлері табылды. Атауы:%1'; ro = 'Setările linkerului sunt găsite. Numele Tabelului: %1'; tr = 'Bağlayıcı ayarları bulundu. Tablo adı:%1'; uk = 'Налаштування компонувальника знайдені. Імятабліци:%1'; uz = 'Bog''lovchi sozlamalari topildi. Jadval nomlari:%1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, ,АдресаПеременных);
		Иначе
			НастройкиКомпоновщика = "";
			пСообщение = НСтр("ru = 'Настройки компоновщика не найдены. ИмяТаблицы:%1';
								|en = 'The linker settings were not found. Table Name: %1'; be = 'Налады кампаноўніка не знойдзены. ИмяТаблицы:%1'; es = 'No se encontraron configuraciones de enlazador. Nombretabla:%1'; ka = 'ლინკერის პარამეტრები ვერ მოიძებნა. მაგიდის სახელი: %1'; kk = 'Сілтеме параметрлері табылмады. Атауы:%1'; ro = 'Setările linkerului nu au fost găsite. Numele Tabelului: %1'; tr = 'Bağlayıcı ayarları bulunamadı. Tablo adı:%1'; uk = 'Налаштування компонувальника не знайдено. Імятабліци:%1'; uz = 'Bog''lovchi sozlamalari topilmadi. Jadval nomlari:%1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, ,АдресаПеременных);
		КонецЕслИ;
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ОчищатьПередВыгрузкой") Тогда
		ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;		
	Иначе
		ОчищатьСправочникПередВыгрузкой = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "ОчищатьПередВыгрузкой",, АдресаПеременных);
	КонецЕсли;
	
	Если ПараметрыКомпоновщика = Ложь Тогда
		ПараметрыКомпоновщика = ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных);
	КонецЕсли;
			
	ПереписыватьНоменклатуруПриВыгрузке 	= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке",,АдресаПеременных);		
	РаботаБезАлкоголя 						= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя",,АдресаПеременных);
	
	Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
		ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
		ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
	ИначеЕсли ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
		НастройкиОбменаСправочников_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников_ПоУмолчанию",, АдресаПеременных);
			
		НастройкиПоУмолчанию = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(
			НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", ИмяТаблицы);
		Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
			НастройкиПоУмолчанию.Свойство("ОчищатьПередВыгрузкой", ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;	
		
		Если ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
			ОчищатьСправочникПередВыгрузкой = ?(ПереписыватьНоменклатуруПриВыгрузке = Неопределено, Ложь, ПереписыватьНоменклатуруПриВыгрузке);
		КонецЕсли;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'После получения настроек.ИмяТаблицы :%1 НастройкиКомпоновщика: %2 ПараметрыКомпоновщика: %3';
						|en = 'After receiving the settings.Table Name :%1 Component Settings: %2 Component parameters3';
						|be = 'Пасля атрымання налад.ИмяТаблицы :%1 НастройкиКомпоновщика: %2 ПараметрыКомпоновщика: %3'; es = 'Después de recibir la configuración.Nombretabla: %1 Configuracióncomponente :% 2 Especificacionescomponente: %3'; ka = 'პარამეტრების მიღების შემდეგ.ცხრილის სახელი: %1 კომპონენტის პარამეტრები: %2 კომპონენტის პარამეტრები3'; kk = 'Параметрлерді алғаннан кейін.Аты-Жөні Кестелер: %1 Параметрлерқұраушының: %2 Опцияларқұраушының: %3'; ro = 'După primirea setărilor.Nume tabel: % 1componder Settings: %2componder Settings: %3'; tr = 'Ayarları aldıktan sonra.Tablo Adları :%1 Bileşen Ayarları: %2 Bileşen Ayarları: %3'; uk = 'Після отримання налаштувань.Імятабліци: %1 Настройкікомпоновщіка: %2 Параметрикомпоновщіка: %3'; uz = 'Sozlamalarni olgandan keyin.Jadval Nomlari: %1 Komponent Sozlamalari: %2 Komponent Parametrlari: %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы, ?(НастройкиКомпоновщика=Ложь,"Ложь","Заполнено"), ?(ПараметрыКомпоновщика=Ложь,"Ложь","Заполнено"));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	Сообщение = НСтр("ru = 'Получение данных';
						|en = 'Getting data'; be = 'Атрыманне дадзеных'; es = 'Obtención de datos'; ka = 'მონაცემების მიღება'; kk = 'Деректерді алу'; ro = 'Obținerea datelor'; tr = 'Veri alma'; uk = 'Отримання даних'; uz = 'Ma''lumotlarni olish'");
	ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение);
	// --- 15.06.20
	
	НачалоПолученияДанныхИз1С 		= ТекущаяДата();
	ДанныеДляВыгрузки 				= ГлЯдро_ПолучитьМассивыТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, РаботаБезАлкоголя, ПараметрыВыгрузки, ТипБазы, АдресаПеременных);
	
	Если (ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив") и ДанныеДляВыгрузки.Количество() = 0) ИЛИ (ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура") и ДанныеДляВыгрузки.МассивыСтрок.Количество() = 0) Тогда
	Сообщение = НСтр("ru = 'Не выгружено (пустой справочник[%1])';
						|en = 'Not uploaded (empty directory[%1])'; be = 'Ня выгружана (пусты даведнік [%1])'; es = 'No descargado (referencia vacía[%1])'; ka = 'არ არის ატვირთული (ცარიელი დირექტორია[%1])'; kk = 'Жүктелмеген (бос анықтамалық[%1])'; ro = 'Nu este încărcat (director gol[%1])'; tr = 'Yüklenmemiş (boş dizin[%1])'; uk = 'Не вивантажено (порожній довідник[%1])'; uz = 'Yuklanmagan (bo''sh katalog[%1])'");	
	Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
    Возврат Новый Структура("Статус,Сообщение", Ложь, Сообщение);
	КонецЕсли;
	Если ДанныеДляВыгрузки = Неопределено Тогда
		Сообщение = НСтр("ru = 'Не удалось получить данные для выгрузки таблицы [%1]. Подробности смотрите в журнале регистрации';
							|en = 'Couldn''t get the data to upload the table [%1]. See the registration log for details';
							|be = 'Не атрымалася атрымаць дадзеныя для выгрузкі табліцы [%1]. Падрабязнасці глядзіце ў часопісе рэгістрацыі'; es = 'No se pudieron recuperar los datos para la descarga de la tabla [%1]. Consulte el registro para más detalles'; ka = 'ვერ მოხერხდა მონაცემების ატვირთვა ცხრილში [%1]. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალი'; kk = 'Кестені жүктеу үшін деректерді алу мүмкін болмады [%1]. Мәліметтерді тіркеу журналынан қараңыз'; ro = 'Nu s-au putut obține datele pentru a încărca tabelul [%1]. Consultați jurnalul de înregistrare pentru detalii'; tr = '[%1] tablosunu boşaltmak için veri alınamadı. Ayrıntılar için kayıt defterine bakın'; uk = 'Не вдалося отримати дані для вивантаження таблиці [%1]. Подробиці дивіться в журналі реєстрації'; uz = 'Jadvalni yuklash uchun ma''lumotlar olinmadi [%1]. Tafsilotlar uchun jurnalga qarang'");
		Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		Возврат Новый Структура("Статус,Сообщение", Ложь, Сообщение);
	КонецЕсли;
	
	ОкончаниеПолученияДанныхИз1С 	= ТекущаяДата();
	ВремяПолученияДанныхИз1С 		= ОкончаниеПолученияДанныхИз1С - НачалоПолученияДанныхИз1С;
		
	// *****************************************************************************************************************************	
	
	Сообщение = НСтр("ru = 'Выгрузка данных';
						|en = 'Uploading data'; be = 'Выгрузка дадзеных'; es = 'Carga de datos'; ka = 'მონაცემების ატვირთვა'; kk = 'Деректерді түсіру'; ro = 'Încărcarea datelor'; tr = 'Veri yükleme'; uk = 'Вивантаження даних'; uz = 'Ma''lumotlarni yuklash'");
	ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение);
	
	НачалоВыгрузкиДанныхНаСерверSMARTS 		= ТекущаяДата();	
	
	Если ТипИнтерфейса = "REST_API" Тогда
		РезультатВыгрузки						= REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);		
	Иначе
		РезультатВыгрузки						= КомЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);		
	КонецЕсли;
	ОкончаниеВыгрузкиДанныхНаСерверSMARTS 	= ТекущаяДата();
	ВремяВыгрузкиДанныхНаСерверSMARTS		= ОкончаниеВыгрузкиДанныхНаСерверSMARTS - НачалоВыгрузкиДанныхНаСерверSMARTS;
	
	ОбщееВремяВыгрузки						= ВремяПолученияДанныхИз1С + ВремяВыгрузкиДанныхНаСерверSMARTS; 
		
	// *****************************************************************************************************************************	
	
	// Если выгрузка прошла успешно, добавляем в сообщение дополнительную информацию о выгрузке
	Если РезультатВыгрузки.Статус Тогда		
		
		ПредставлениеВремени1С 		= ГлЯдро_ПредставлениеВремени(ВремяПолученияДанныхИз1С);
		ПредставлениеВремениMS 		= ГлЯдро_ПредставлениеВремени(ВремяВыгрузкиДанныхНаСерверSMARTS);
		ПредставлениеВремениОбщее 	= ГлЯдро_ПредставлениеВремени(ОбщееВремяВыгрузки);
		
		РезультатВыгрузки.Сообщение = ГлЯдро_СформироватьПодробноеСообщениеОВыгрузкеТаблицы(РезультатВыгрузки.Сообщение, ПредставлениеВремениОбщее, ПредставлениеВремени1С, ПредставлениеВремениMS);		
				
	Иначе
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"РезультатВыгрузки",
			РезультатВыгрузки);
		ЛогОшибка(логСобытие, РезультатВыгрузки.Сообщение,, логКонтекст,,, АдресаПеременных);
		// </Лог>
				
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выгрузка таблицы на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Finally, Uploading the table to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Канец, выгрузка табліцы на сервер Cleverence. Імя табліцы: %1, Тып інтэрфейсу: %2'; es = 'Fin, Carga la tabla en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'დაბოლოს, ცხრილის ატვირთვა Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Соңы, кестені Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'În cele din urmă, încărcarea tabelului pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Son, Tablonun Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Кінець, вивантаження таблиці на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Tugatish, jadvalni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

// Выгружает на сервер Клеверенс данные таблицы порциями. Работает только для справочника "Номенклатура"
// Некорректен с точки зрения инкапсуляции - в одном методе смешался функционал получения данных из базы 1С и функционал выгрузки данных в Клеверенс
// Это вынужденная реализация, потому что методы "TerminalConnector.НачатьВыгрузкуТоваров()" и "TerminalConnector.ЗавершитьВыгрузкуТоваров()"
// можно вызывать только по 1 разу во время всего процесса выгрузки справочника номенклатуры
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	ОчищатьСправочникПередВыгрузкой - Булево - флаг, определяющий нужно ли перезаписывать номенклатуру при выгрузке или добавлять к существующей номенклатуре
//  РазмерПорцииНоменклатуры - Число - определяет количество выгружаемых в одной партии строк
//  РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
Функция ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями(ИмяТаблицы, НастройкиКомпоновщика = Ложь, ПараметрыКомпоновщика = Ложь, ТипБазы = Неопределено, ОчищатьСправочникПередВыгрузкой = Ложь, РазмерПорции = 1000, РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,ТипБазы,ОчищатьСправочникПередВыгрузкой,РазмерПорции,РаботаБезАлкоголя,ПараметрыВыгрузки",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ТипБазы, ОчищатьСправочникПередВыгрузкой, РазмерПорции, РаботаБезАлкоголя, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПараметрыПорционнойВыгрузки = Неопределено;
	ПараметрыВыгрузки.Свойство("ПараметрыПорционнойВыгрузки", ПараметрыПорционнойВыгрузки);
	
	Если ПараметрыПорционнойВыгрузки = Неопределено Тогда
		
		ПараметрыСпособаВыгрузки = Новый Структура;
		ПараметрыСпособаВыгрузки.Вставить("СправочникИмя", ИмяТаблицы);
		ПараметрыСпособаВыгрузки.Вставить("ПараметрыВыгрузки", ПараметрыВыгрузки);
		ПараметрыСпособаВыгрузки.Вставить("СоответствиеПараметровПорционнойВыгрузки");
		ПараметрыСпособаВыгрузки.Вставить("МетаданныеНСИ");
		СтруктураСпособаВыгрузки = ГлЯдро_ОпределитьСпособВыгрузкиСправочника(ПараметрыСпособаВыгрузки, АдресаПеременных);
		ПараметрыПорционнойВыгрузки = СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки;
		
		Если ПараметрыПорционнойВыгрузки = Неопределено Тогда
			РезультатВыгрузки = ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика,, ТипБазы,,, ПараметрыВыгрузки, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат РезультатВыгрузки;
		Иначе
			РазмерПорции = ПараметрыПорционнойВыгрузки.РазмерПорции;
		КонецЕсли;	
		
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Начало, Выгрузка таблицы на сервер SMARTS порциями. Имя таблицы: %1';
						|en = 'Getting started, Uploading the table to the Cleverence server in chunks. Table Name: %1';
						|be = 'Пачатак, Выгрузка табліцы на сервер Cleverence порцыямі. Імя табліцы: %1'; es = 'Inicio, La carga de la tabla en el servidor Cleverence en porciones. Nombre de la tabla: %1'; ka = 'დაწყება, ცხრილის ატვირთვა Cleverence სერვერზე მოცულობით. მაგიდის სახელი: %1'; kk = 'Бастау, кестені cleverence серверіне бөліктерге жүктеу. Кесте атауы: %1'; ro = 'Noțiuni de bază, încărcarea tabelului pe serverul Cleverence în bucăți. Numele Tabelului: %1'; tr = 'Başlangıç, Tablonun Cleverence sunucusuna bölümler halinde yüklenmesi. Tablo adı: %1'; uk = 'Початок, вивантаження таблиці на сервер Cleverence порціями. Назва таблиці: %1'; uz = 'Boshlash, jadvalni cleverence serveriga qismlarga bo''lib tushirish. Jadval nomi: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	Сообщение = НСтр("ru = 'Начало выгрузки';
						|en = 'The beginning of unloading'; be = 'Пачатак выгрузкі'; es = 'Inicio de la descarga'; ka = 'გადმოტვირთვის დასაწყისი'; kk = 'Жүктеуді бастау'; ro = 'Începutul descărcării'; tr = 'Boşaltmanın başlangıcı'; uk = 'Початок вивантаження'; uz = 'Tushirishni boshlash'");
	ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение);
			
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза",АдресаПеременных);
	
	Если ТипБазы = Неопределено Тогда
		ТипБазы = ?(ЕстьЧастнаяБаза = Истина, "Частная", "Основная");
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("COMЧастнойБазыMS",АдресаПеременных);
	ИначеЕсли ТипБазы = "Временная" Тогда
		СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("COMВременнойБазыMS",АдресаПеременных);
	Иначе
		СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);
	КонецЕсли;		
	
	РезультатВыгрузки = Новый Структура;
	Сообщение = НСтр("ru = 'Начало выгрузки таблицы [%1] порциями';
						|en = 'The beginning of unloading the table [%1] in portions'; be = 'Пачатак выгрузкі табліцы [%1] порцыямі'; es = 'Inicio de la descarga de la tabla [%1] en porciones'; ka = 'ცხრილის გადმოტვირთვის დასაწყისი [%1] ნაწილებად'; kk = 'Кестені жүктеуді бастау [%1] бөліктерде'; ro = 'Începutul descărcării tabelului [%1] în porțiuni'; tr = 'Tabloyu [%1] porsiyonlar halinde boşaltmaya başlama'; uk = 'Початок вивантаження таблиці [%1] порціями'; uz = 'Jadvalni [%1] qismlarga tushirishni boshlash'");
	Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
	РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
	РезультатВыгрузки.Вставить("Статус"		, Истина);	
	Сообщить(Сообщение); 
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	ЭтоREST_API = ТипИнтерфейса = "REST_API";
	
	Если Не ЭтоREST_API Тогда
		Если НЕ КомЯдро_ПодключитьсяКСерверуSMARTS(Ложь,ТипБазы, АдресаПеременных) Тогда		
			
			// <Лог>
			ЯзСтрока = "ru = 'База Клеверенс недоступна!';
								|en = 'The Cleverence database is unavailable!'; be = 'База Cleverence недаступная!'; es = 'Base Cleverence no disponible!'; ka = 'Cleverence მონაცემთა ბაზა მიუწვდომელია!'; kk = 'Cleverence базасы қол жетімді емес!'; ro = 'Baza de date Cleverence nu este disponibilă!'; tr = 'Cleverence üssü kullanılamıyor!'; uk = 'База Cleverence недоступна!'; uz = 'Cleverence bazasi mavjud emas!'";
			Сообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, Сообщение, ЯзСтрока,,,, АдресаПеременных);
			// </Лог>
			
			РезультатВыгрузки.Вставить("Статус", Ложь);
			РезультатВыгрузки.Вставить("Сообщение", Сообщение);
			Сообщить(Сообщение);
			
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "Конец, Выгрузка таблицы на сервер SMARTS порциями. Имя таблицы: " + Строка(ИмяТаблицы), НачалоСобытия, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат РезультатВыгрузки;		
			
		КонецЕсли;
	КонецЕсли;
	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "Начало.ИмяТаблицы:"+ИмяТаблицы+" НастройкиКомпоновщика:"+?(НастройкиКомпоновщика=Ложь,"Ложь","Заполнено")+" ПараметрыКомпоновщика:"+?(ПараметрыКомпоновщика=Ложь,"Ложь","Заполнено"), ,АдресаПеременных);
	
	Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	Если НастройкиКомпоновщика = Ложь Тогда
		НастройкаКомпоновщикаСтрокой = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "НастройкаКомпоновщикаСтрокой",, АдресаПеременных);
		Если ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
			НастройкиКомпоновщика = ГлЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
			пСообщение = НСтр("ru = 'Настройки компоновщика найдены. ИмяТаблицы:%1';
								|en = 'The linker settings are found. Table Name: %1'; be = 'Налады кампаноўніка знойдзеныя. ИмяТаблицы:%1'; es = 'Configuración del enlazador encontrado. Nombretabla:%1'; ka = 'Linker პარამეტრები გვხვდება. მაგიდის სახელი: %1'; kk = 'Сілтеме параметрлері табылды. Атауы:%1'; ro = 'Setările linkerului sunt găsite. Numele Tabelului: %1'; tr = 'Bağlayıcı ayarları bulundu. Tablo adı:%1'; uk = 'Налаштування компонувальника знайдені. Імятабліци:%1'; uz = 'Bog''lovchi sozlamalari topildi. Jadval nomlari:%1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, ,АдресаПеременных);
		Иначе
			НастройкиКомпоновщика = "";
			пСообщение = НСтр("ru = 'Настройки компоновщика не найдены. ИмяТаблицы:%1';
								|en = 'The linker settings were not found. Table Name: %1'; be = 'Налады кампаноўніка не знойдзены. ИмяТаблицы:%1'; es = 'No se encontraron configuraciones de enlazador. Nombretabla:%1'; ka = 'ლინკერის პარამეტრები ვერ მოიძებნა. მაგიდის სახელი: %1'; kk = 'Сілтеме параметрлері табылмады. Атауы:%1'; ro = 'Setările linkerului nu au fost găsite. Numele Tabelului: %1'; tr = 'Bağlayıcı ayarları bulunamadı. Tablo adı:%1'; uk = 'Налаштування компонувальника не знайдено. Імятабліци:%1'; uz = 'Bog''lovchi sozlamalari topilmadi. Jadval nomlari:%1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, ,АдресаПеременных);
		КонецЕслИ;
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ОчищатьПередВыгрузкой") Тогда
		ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;		
	Иначе
		ОчищатьСправочникПередВыгрузкой = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "ОчищатьПередВыгрузкой",, АдресаПеременных);
	КонецЕсли;
	
	Если ПараметрыКомпоновщика = Ложь Тогда
		ПараметрыКомпоновщика = ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных);
	КонецЕсли;
	
	ПереписыватьНоменклатуруПриВыгрузке = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке",,АдресаПеременных);		
	РаботаБезАлкоголя 					= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя",,АдресаПеременных);
	
	Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
		ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
		ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
	ИначеЕсли ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
		НастройкиОбменаСправочников_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников_ПоУмолчанию",, АдресаПеременных);
			
		НастройкиПоУмолчанию = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(
			НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", ИмяТаблицы);
		Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
			НастройкиПоУмолчанию.Свойство("ОчищатьПередВыгрузкой", ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;
		
		Если ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
			ОчищатьСправочникПередВыгрузкой = ?(ПереписыватьНоменклатуруПриВыгрузке = Неопределено, Ложь, ПереписыватьНоменклатуруПриВыгрузке);
		КонецЕсли;
	КонецЕсли;
	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "После получения настроек.ИмяТаблицы:"+ИмяТаблицы+" НастройкиКомпоновщика:"+?(НастройкиКомпоновщика=Ложь Или НастройкиКомпоновщика="","Ложь","Заполнено")+" ПараметрыКомпоновщика:"+?(ПараметрыКомпоновщика=Ложь,"Ложь","Заполнено"), ,АдресаПеременных);
	
	// Для порционной выгрузки не исключаются группы из выборки, т.к. исключение групп происходит в макете СКД, если требуется.
	МассивСсылокОтбора = ГлЯдро_ПолучитьМассивСсылокСправочников(ПараметрыПорционнойВыгрузки.ИменаСправочников, Ложь, АдресаПеременных);
	
	КоличествоСтрок 					= МассивСсылокОтбора.Количество();
	КоличествоПорций 					= (КоличествоСтрок - КоличествоСтрок % РазмерПорции) / РазмерПорции + ?(КоличествоСтрок % РазмерПорции <> 0, 1, 0);			
	// Временное решение. При обновлении локального кэша не обновляется глобальный кэш, поэтому переменную получаем из входных параметров
	
	ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, "0/" + Строка(КоличествоСтрок));
	
	ВсегоСтрок 							= 0;
	ОтборПоМассивуСсылок 				= Новый Массив;
	НачатаВыгрузкаТаблицы 				= Ложь;
	ВремяПолученияДанныхИз1С			= 0;
	ВремяВыгрузкиДанныхНаСерверSMARTS 	= 0;
	СоответствиеРазличныхТоваров		= Новый Соответствие;
	ИндексИдТовара						= -1;
	СообщениеПорции 					= "";
		
	Для НомерПорции = 1 По КоличествоПорций Цикл				
		
		НачалоВыгрузкиПорции 		= ТекущаяДата();		
		НачалоПолученияДанныхИз1С 	= ТекущаяДата();
		
		ОтборПоМассивуСсылок.Очистить();
		
		Для Сч = 1 По РазмерПорции Цикл
			
			ИндексСтроки = (НомерПорции - 1) * РазмерПорции + Сч - 1;
			
			Если ИндексСтроки > КоличествоСтрок - 1 Тогда
				Прервать;
			КонецЕсли;	
			
			ОтборПоМассивуСсылок.Добавить(МассивСсылокОтбора[ИндексСтроки]);
			
		КонецЦикла;					
		
		ДанныеДляВыгрузки = ГлЯдро_ПолучитьТаблицуДляВыгрузкиСправочников(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, , , ОтборПоМассивуСсылок, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
		КоличествоСтрокВПорции = ДанныеДляВыгрузки.Количество();		
		
		Если ИмяТаблицы = "Номенклатура" Тогда
			МассивНоменклатурыПорции =  ДанныеДляВыгрузки.ВыгрузитьКолонку(ПараметрыВыгрузки.ПараметрыПорционнойВыгрузки.ПолеНаложенияОтбора);
		КонецЕсли;
		
		// Если данных в порции нет, то и выгружать нечего
		Если КоличествоСтрокВПорции = 0 Тогда
			Продолжить;
		КонецЕсли;			
		
		ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицы(ДанныеДляВыгрузки, ИмяТаблицы, ПараметрыВыгрузки, АдресаПеременных);	
		
		ДанныеДляВыгрузки = ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, АдресаПеременных);
		
		Если ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив") Тогда
			сткДанныеДляВыгрузки = Новый Структура;
			сткДанныеДляВыгрузки.Вставить("МассивыСтрок", ДанныеДляВыгрузки);
			сткДанныеДляВыгрузки.Вставить("ВыгрузкаБлоками", Истина);
			ДанныеДляВыгрузки = сткДанныеДляВыгрузки;
		КонецЕсли;
		
		ДанныеДляВыгрузки.Вставить("ВыгрузкаБлоками", Истина);
		
		// Для того чтобы искать индекс только один раз, а не на каждой итерации
		Если ИмяТаблицы = "Номенклатура" И ИндексИдТовара = -1 Тогда
			ИндексИдТовара = ГлЯдро_НайтиИндексИдТовараВМассивеИмен(ДанныеДляВыгрузки.МассивИмен);
		КонецЕсли;
		
		ОкончаниеПолученияДанныхИз1С 	= ТекущаяДата();
		ВремяПолученияДанныхИз1С 		= ВремяПолученияДанныхИз1С + (ОкончаниеПолученияДанныхИз1С - НачалоПолученияДанныхИз1С);			
		
		НачалоВыгрузкиДанныхНаСерверSMARTS = ТекущаяДата();		
		
		// Если выгружается первая порция (до этого не было порций с данными), содержащая ненулевое количество строк, то используем флаг из настроек, иначе - дописываем номенклатуру
		ОчищатьСправочникПередВыгрузкой = ?(ВсегоСтрок = 0 И КоличествоСтрокВПорции > 0, ОчищатьСправочникПередВыгрузкой, Ложь);
		
		Если ЭтоREST_API Тогда
			РезультатВыгрузкиПорции = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ?(ТипБазы = "Частная", "Частная", "Основная"), ОчищатьСправочникПередВыгрузкой, АдресаПеременных);
			
			Если Не РезультатВыгрузкиПорции.Статус Тогда
				Сообщить(РезультатВыгрузкиПорции.Сообщение); 
				РезультатВыгрузки.Вставить("Сообщение", РезультатВыгрузкиПорции.Сообщение);
				РезультатВыгрузки.Вставить("Статус", Ложь);				
				Прервать;
			Иначе
				Если РезультатВыгрузки.Статус И ИмяТаблицы = "Номенклатура" Тогда
					Для Каждого Номенклатура из МассивНоменклатурыПорции Цикл
						СоответствиеРазличныхТоваров.Вставить(Номенклатура);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			// При получении из 1С первой непустой порции данных вызываем соответствующий метод для начала выгрузки таблицы
			Если НЕ НачатаВыгрузкаТаблицы Тогда
				
				Если ИмяТаблицы = "Номенклатура" Тогда
					СтруктураПодключенияMS.TerminalConnector.ПерезаписыватьНоменклатуру(ОчищатьСправочникПередВыгрузкой);
					РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.НачатьВыгрузкуТоваров(ДанныеДляВыгрузки.МассивИмен);
				Иначе
					РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.НачатьВыгрузкуТаблицы(ИмяТаблицы, ДанныеДляВыгрузки.МассивИмен, Истина);
				КонецЕсли;
				
				Если НЕ РезультатПопытки Тогда
					
					Сообщение = НСтр("ru = 'Конец, Выгрузка таблицы на сервер SMARTS порциями. Имя таблицы: %1';
										|en = 'Finally, Uploading the table to the Cleverence server in chunks. Table Name: %1';
										|be = 'Канец, Выгрузка табліцы на сервер Cleverence порцыямі. Імя табліцы: %1'; es = 'Fin, Descargar la tabla al servidor Cleverence en porciones. Nombre de la tabla: %1'; ka = 'დაბოლოს, ცხრილის ჩატვირთვა Cleverence სერვერზე მოცულობით. მაგიდის სახელი: %1'; kk = 'Соңы, кестені cleverence серверіне бөліктерге жүктеу. Кесте атауы: %1'; ro = 'În cele din urmă, încărcarea tabelului pe serverul Cleverence în bucăți. Numele Tabelului: %1'; tr = 'Son, Tablonun Cleverence sunucusuna bölümler halinde yüklenmesi. Tablo adı: %1'; uk = 'Кінець, вивантаження таблиці на сервер Cleverence порціями. Назва таблиці: %1'; uz = 'Oxir-oqibat, jadvalni cleverence serveriga qismlarga bo''lib tushirish. Jadval nomi: %1'");
					Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация",, НачалоСобытия, АдресаПеременных);
					
					ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы, АдресаПеременных);
					
					ЯзСтрока = "ru = 'Таблица [%1] не выгружается!';
										|en = 'Table [%1] is not being uploaded!'; be = 'Табліца [%1] не выгружаецца!'; es = '¡La tabla [%1] no se descarga!'; ka = 'ცხრილი [%1] არ იტვირთება!'; kk = 'Кесте [%1] түсірілмейді!'; ro = 'Tabelul [%1] nu este încărcat!'; tr = 'Tablo [%1] boşaltılmıyor!'; uk = 'Таблиця [%1] не вивантажується!'; uz = 'Jadval [%1] tushirilmaydi!'";
										
					Сообщение = НСтр(ЯзСтрока);
					Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
					РезультатВыгрузки.Вставить("Статус", Ложь);
					РезультатВыгрузки.Вставить("Сообщение", Сообщение);
					Сообщить(Сообщение);
					
					// <Лог>
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"ИмяТаблицы,ОписаниеОшибки",
						ИмяТаблицы, ОписаниеОшибки);
					ЛогОшибка(логСобытие, Сообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
					ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
					// </Лог>
					
					Возврат РезультатВыгрузки;
					
				Иначе
					НачатаВыгрузкаТаблицы = РезультатПопытки; 
				КонецЕсли;		
				
			КонецЕсли;
			
			Если РезультатВыгрузки.Статус Тогда

				Для Каждого МассивСтрокиВыгрузки из ДанныеДляВыгрузки.МассивыСтрок Цикл
					
					Если ИмяТаблицы = "Номенклатура" Тогда
						РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ДобавитьВВыгрузкуТоваров(МассивСтрокиВыгрузки);
						// Подсчет количества различных товаров в выгрузке
						Если ИндексИдТовара <> -1 Тогда
							СоответствиеРазличныхТоваров.Вставить(МассивСтрокиВыгрузки[ИндексИдТовара]);
						КонецЕсли;						
					Иначе
						РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ДобавитьВВыгрузкуТаблицы(МассивСтрокиВыгрузки);
					КонецЕсли;
					
					Если НЕ РезультатПопытки Тогда
						
						ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы,АдресаПеременных);		
						Сообщение = НСтр("ru = 'Ошибка выгрузки таблицы [%1].';
											|en = 'Error unloading the table [%1].'; be = 'Памылка выгрузкі табліцы [%1].'; es = 'Error al cargar la tabla [%1].'; ka = 'შეცდომა გადმოტვირთვის მაგიდა [%1].'; kk = 'Кестені жүктеу қатесі [%1].'; ro = 'Eroare la descărcarea tabelului [%1].'; tr = 'Tablo boşaltma hatası [%1].'; uk = 'Помилка вивантаження таблиці [%1].'; uz = 'Jadvalni yuklash xatosi [%1].'");
						Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
						РезультатВыгрузки.Вставить("Статус"		, Ложь);				
						РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
						Сообщить(Сообщение);
						СтруктураПодключенияMS.TerminalConnector.ПрерватьВыгрузкуТаблицы();			
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;		
			
		КонецЕсли;
		
		ВсегоСтрок = ВсегоСтрок + КоличествоСтрокВПорции;								

		ОкончаниеВыгрузкиДанныхНаСерверSMARTS 	= ТекущаяДата();
		ВремяВыгрузкиДанныхНаСерверSMARTS		= ВремяВыгрузкиДанныхНаСерверSMARTS + (ОкончаниеВыгрузкиДанныхНаСерверSMARTS - НачалоВыгрузкиДанныхНаСерверSMARTS);			
		
		ОкончаниеВыгрузкиПорции = ТекущаяДата();
		ВремяВыгрузкиПорции		= ОкончаниеВыгрузкиПорции - НачалоВыгрузкиПорции;			
		
		ПредставлениеВремениВыгрузки = ГлЯдро_ПредставлениеВремени(ВремяВыгрузкиПорции);		
		
		ШаблонСообщения = НСтр("ru = 'Выгрузка таблицы [%1] порциями. Выгружена порция №%2 из %3, содержащая %4 строк. Всего выгружено %5 строк. Затраченное время: %6';
								|en = 'Unloading the table [%1] in chunks. Uploaded portion #%2 from %3, containing %4 rows. In total, %5 lines were uploaded. Time spent: %6';
								|be = 'Выгрузка табліцы [%1] порцыямі. Выгружаная порцыя №%2 з % 3, якая змяшчае %4 радкоў. Усяго выгружана %5 радкоў. Затрачаны час: %6'; es = 'Descarga la tabla [%1] en porciones. Se descargó la porción no. %2 de %3 que contiene % 4 filas. Total %5 filas descargadas. Tiempo empleado: %6'; ka = 'გადმოტვირთვის მაგიდა [%1] მოცულობით. ატვირთული ნაწილი #%2% 3-დან, რომელიც შეიცავს %4 რიგს. მთლიანობაში, % 5 ხაზი აიტვირთა. დახარჯული დრო: %6'; kk = 'Кестені [%1] бөліктерге түсіру. %4 жолдан тұратын %3-тен №%2 бөлігі түсірілді. Барлығы %5 жол түсірілді. Жұмсалған уақыт: %6'; ro = 'Descărcarea tabelului [%1] în bucăți. Porțiunea încărcată # %2 din %3, conținând %4 rânduri. În total, au fost încărcate %5 linii. Timp petrecut: %6'; tr = 'Tablonun [%1] porsiyonlar halinde boşaltılması. %4 satır içeren%3''ün%2''sinin kısmı boşaltıldı. Toplam %5 satır yüklendi. Harcanan süre: % 6'; uk = 'Вивантаження таблиці [%1] порціями. Вивантажена порція № %2 з %3, що містить %4 рядків. Всього вивантажено %5 рядків. Витрачений час: %6'; uz = 'Jadvalni [%1] qismlarga tushirish. %4 qatorni o''z ichiga olgan %3 ning %2 qismi tushirildi. Hammasi bo''lib, %5 qator tushirildi. Sarflangan vaqt: %6'");
		СообщениеПорции = СообщениеПорции + 
			ГлЯдро_СтрШаблон(ШаблонСообщения, ИмяТаблицы, СокрЛП(НомерПорции), СокрЛП(КоличествоПорций), СокрЛП(КоличествоСтрокВПорции), СокрЛП(ВсегоСтрок), ПредставлениеВремениВыгрузки) +
			Символы.ПС;
			
		ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Строка(ИндексСтроки) + "/" + Строка(КоличествоСтрок));
		
	КонецЦикла;			
	
	Если ЗначениеЗаполнено(СообщениеПорции) Тогда
		Сообщить(СообщениеПорции);
	КонецЕсли;
	
	Если РезультатВыгрузки.Статус Тогда
		
		НачалоЗавершенияВыгрузкиНаСерверSMARTS = ТекущаяДата();		
		
		Если Не ЭтоREST_API Тогда
			Если ИмяТаблицы = "Номенклатура" Тогда
				РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ЗавершитьВыгрузкуТоваров();	
			Иначе
				РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ЗавершитьВыгрузкуТаблицы();	
			КонецЕсли;			
			
			Если НЕ РезультатПопытки Тогда
				ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы,АдресаПеременных);		
				Сообщение = НСтр("ru = 'Не удалось закончить выгрузку таблицы [%1].';
									|en = 'Couldn''t finish unloading the table [%1].'; be = 'Не ўдалося скончыць выгрузку табліцы [%1].'; es = 'No se pudo terminar de descargar la tabla [%1].'; ka = 'ვერ დაასრულა ცხრილის გადმოტვირთვა [%1].'; kk = '[%1] кестесін түсіруді аяқтау мүмкін болмады.'; ro = 'Nu s-a putut termina descărcarea tabelului [%1].'; tr = 'Tabloyu [%1] boşaltmayı bitiremedim.'; uk = 'Не вдалося закінчити вивантаження таблиці [%1].'; uz = 'Jadvalni tushirishni tugata olmadi [%1].'");
				Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
				РезультатВыгрузки.Вставить("Статус"		, Ложь);				
				РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
				Сообщить(Сообщение);
			КонецЕсли;
		Иначе
			РезультатПопытки = Истина;
		КонецЕсли;
		
		Если РезультатПопытки Тогда
			
			ОкончаниеЗавершенияВыгрузкиНаСерверSMARTS 	= ТекущаяДата();
			ВремяЗавершенияВыгрузкиНаСерверSMARTS		= ОкончаниеЗавершенияВыгрузкиНаСерверSMARTS - НачалоЗавершенияВыгрузкиНаСерверSMARTS;
			
			ВремяВыгрузкиДанныхНаСерверSMARTS 			= ВремяВыгрузкиДанныхНаСерверSMARTS + ВремяЗавершенияВыгрузкиНаСерверSMARTS;		

			ПредставлениеВремениЗавершенияВыгрузкиНаСерверSMARTS = ГлЯдро_ПредставлениеВремени(ВремяЗавершенияВыгрузкиНаСерверSMARTS);
			
			Сообщение = НСтр("ru = 'Завершение выгрузки таблицы [%1] порциями. Затраченное время: %2';
								|en = 'Completion of unloading the table [%1] in chunks. Time spent: %2';
								|be = 'Завяршэнне выгрузкі табліцы [%1] порцыямі. Затрачаны час: %2'; es = 'Finalización de la descarga de la tabla [%1] en porciones. Tiempo empleado: %2'; ka = 'დასრულების გადმოტვირთვის მაგიდა [%1] მოცულობით. დახარჯული დრო: %2'; kk = 'Кестені түсіруді аяқтау [%1] бөліктерде. Жұмсалған уақыт: %2'; ro = 'Finalizarea descărcării tabelului [%1] în bucăți. Timpul petrecut: %2'; tr = 'Tablonun [%1] toplu olarak boşaltılmasının tamamlanması. Harcanan süre: %2'; uk = 'Завершення вивантаження таблиці [%1] порціями. Витрачений час: %2'; uz = 'Jadvalni [%1] qismlarga bo''lib tushirishni yakunlash. Sarflangan vaqt: %2'");
			Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы, ПредставлениеВремениЗавершенияВыгрузкиНаСерверSMARTS);
			Сообщить(Сообщение);
			
			Если ИмяТаблицы = "Номенклатура" Тогда
				ПодробноеСообщение = НСтр("ru = 'Таблица [%1] успешно выгружена порциями по %2 позиций. Выгружено: %3 строк %4 товаров';
											|en = 'Table [%1] was successfully uploaded in portions of %2 items. Uploaded: %3 rows %4 items';
											|be = 'Табліца [%1] паспяхова выгружаная порцыямі па %2 пазіцый. Выгружана: %3 радкоў %4 тавараў'; es = 'La tabla [%1] se descargó correctamente en porciones de %2 posiciones. Descargado: % 3 líneas % 4 productos'; ka = 'ცხრილი [%1] წარმატებით აიტვირთა %2 ნივთების ნაწილში. ატვირთულია: %3 რიგები %4 ელემენტი'; kk = 'Кесте [%1] %2 позиция бойынша бөліктермен сәтті түсірілді. Түсірілді: %3 жол %4 тауар'; ro = 'Tabelul [%1] a fost încărcat cu succes în porțiuni de articole %2. Încărcat: %3 rânduri % 4 articole'; tr = 'Tablo [%1], %2 pozisyondaki porsiyonlar halinde başarıyla boşaltılmıştır. Yüklendi: %3 satır %4 ürün'; uk = 'Таблиця [%1] успішно вивантажена порціями по %2 позицій. Вивантажено: %3 рядків %4 товарів'; uz = 'Jadval [%1] %2 elementlarining qismlariga muvaffaqiyatli Yuklandi. Yukladi: %3 satr %4 mahsulot'");
				ПодробноеСообщение = Символы.ВК + ГлЯдро_СтрШаблон(ПодробноеСообщение, ИмяТаблицы, СокрЛП(РазмерПорции), 
							Символы.ВК + Символы.Таб + "- " + Формат(ВсегоСтрок, "ЧН=0; ЧГ=3,0"),
							Символы.ВК + Символы.Таб + "- " + Формат(СоответствиеРазличныхТоваров.Количество(), "ЧН=0; ЧГ=3,0"));
			Иначе
				ПодробноеСообщение = НСтр("ru = 'Таблица [%1] успешно выгружена порциями по %2 позиций. Выгружено: %3 строк';
											|en = 'Table [%1] was successfully uploaded in portions of %2 items. Unloaded: %3 rows';
											|be = 'Табліца [%1] паспяхова выгружаная порцыямі па %2 пазіцый. Выгружана: %3 радкоў'; es = 'La tabla [%1] se descargó correctamente en porciones de %2 posiciones. Descargado: % 3 filas'; ka = 'ცხრილი [%1] წარმატებით აიტვირთა %2 ნივთების ნაწილში. გადმოტვირთული: %3 რიგები'; kk = 'Кесте [%1] %2 позиция бойынша бөліктермен сәтті түсірілді. Түсірілді: %3 жол'; ro = 'Tabelul [%1] a fost încărcat cu succes în porțiuni de articole %2. Descărcate: % 3 rânduri'; tr = 'Tablo [%1], %2 pozisyondaki porsiyonlar halinde başarıyla boşaltılmıştır. Yüklendi: %3 satır'; uk = 'Таблиця [%1] успішно вивантажена порціями по %2 позицій. Вивантажено: %3 рядків'; uz = 'Jadval [%1] %2 elementlarining qismlariga muvaffaqiyatli Yuklandi. Yuklangan: %3 qator'");
				ПодробноеСообщение = Символы.ВК + ГлЯдро_СтрШаблон(ПодробноеСообщение, ИмяТаблицы, СокрЛП(РазмерПорции), 
							Символы.ВК + Символы.Таб + "- " + Формат(ВсегоСтрок, "ЧН=0; ЧГ=3,0"));
			КонецЕсли;																				
			
			ОбщееВремяВыгрузки 			= ВремяПолученияДанныхИз1С + ВремяВыгрузкиДанныхНаСерверSMARTS; 				
			
			ПредставлениеВремени1С 		= ГлЯдро_ПредставлениеВремени(ВремяПолученияДанныхИз1С);
			ПредставлениеВремениMS 		= ГлЯдро_ПредставлениеВремени(ВремяВыгрузкиДанныхНаСерверSMARTS);
			ПредставлениеВремениОбщее 	= ГлЯдро_ПредставлениеВремени(ОбщееВремяВыгрузки);			
			
			ПодробноеСообщение = ГлЯдро_СформироватьПодробноеСообщениеОВыгрузкеТаблицы(ПодробноеСообщение, ПредставлениеВремениОбщее, ПредставлениеВремени1С, ПредставлениеВремениMS);				
			Сообщить(ПодробноеСообщение);
			
			ИтоговоеСообщение = СообщениеПорции + Сообщение + Символы.ПС + ПодробноеСообщение;
			
			РезультатВыгрузки.Вставить("Статус"		, Истина);				
			РезультатВыгрузки.Вставить("Сообщение"	, ИтоговоеСообщение);			
			
		КонецЕсли;
		
	Иначе
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"РезультатВыгрузки",
			РезультатВыгрузки);
		ЛогОшибка(логСобытие, РезультатВыгрузки.Сообщение,, логКонтекст,,, АдресаПеременных);
		// </Лог>
		
	КонецЕсли;	
	
	Если Не ЭтоREST_API Тогда
		СтруктураПодключенияMS.TerminalConnector.ОсвободитьРесурсы();
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выгрузка таблицы на сервер SMARTS порциями. Имя таблицы: %1';
						|en = 'Finally, Uploading the table to the Cleverence server in chunks. Table Name: %1';
						|be = 'Канец, Выгрузка табліцы на сервер Cleverence порцыямі. Імя табліцы: %1'; es = 'Fin, Descargar la tabla al servidor Cleverence en porciones. Nombre de la tabla: %1'; ka = 'დაბოლოს, ცხრილის ჩატვირთვა Cleverence სერვერზე მოცულობით. მაგიდის სახელი: %1'; kk = 'Соңы, кестені cleverence серверіне бөліктерге жүктеу. Кесте атауы: %1'; ro = 'În cele din urmă, încărcarea tabelului pe serverul Cleverence în bucăți. Numele Tabelului: %1'; tr = 'Son, Tablonun Cleverence sunucusuna bölümler halinde yüklenmesi. Tablo adı: %1'; uk = 'Кінець, вивантаження таблиці на сервер Cleverence порціями. Назва таблиці: %1'; uz = 'Oxir-oqibat, jadvalni cleverence serveriga qismlarga bo''lib tushirish. Jadval nomi: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции // ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями()

// Вызывает функцию выгрузки на сервер Клеверенс подготовленной - т.е. преобразованной в массив значений либо соответствие в зависимости от типа интерфейса - таблицы
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы	
//	ДанныеДляВыгрузки - Структура - для COM - содержит:
//							* МассивИмен - Массив из Строка - содержит имена колонок выгружаемой таблицы
//							* МассивыСтрок - Массив из Массив - содержит строки выгружаемой таблицы в виде массивов значений
//      					* КоличествоТоваров - Число - содержит количество выгружаемых товаров для таблицы "Номенклатура"
//					  - Массив из Соответствие - для REST_API - содержит строки выгружаемой таблицы в виде соответствий, ключами которых 
//											  					являются названия колонок таблицы, переведенные в транслит, значениями - 
//											  					значения соответствующих колонок.                                               
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	ОчищатьСправочникПередВыгрузкой - Булево - флаг, определяющий нужно ли перезаписывать номенклатуру при выгрузке или добавлять к существующей номенклатуре
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
Функция ГлЯдро_ВыгрузитьПодготовленныйМассивНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузитьПодготовленныйМассивНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ДанныеДляВыгрузки,ТипБазы,ОчищатьСправочникПередВыгрузкой",
		ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Начало, Выгрузка подготовленного массива на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Getting started, Uploading the prepared array to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Пачатак, Выгрузка падрыхтаванага масіва на сервер Cleverence. Імя табліцы: %1, тып інтэрфейсу: %2'; es = 'Inicio, Descargando la matriz preparada en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'დაწყება, მომზადებული მასივის ატვირთვა Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Бастау, дайындалған массивті Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'Noțiuni de bază, încărcarea matricei pregătite pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Başlangıç, Hazırlanan dizinin Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Початок, вивантаження підготовленого масиву на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Boshlash, tayyorlangan qatorni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	Если ТипИнтерфейса = "REST_API" Тогда
		РезультатВыгрузки = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);		
	Иначе
		РезультатВыгрузки = КомЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой, АдресаПеременных);
	КонецЕсли;
	
	Если НЕ РезультатВыгрузки.Статус Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"РезультатВыгрузки",
			РезультатВыгрузки);
		ЛогОшибка(логСобытие, РезультатВыгрузки.Сообщение,, логКонтекст,,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выгрузка подготовленного массива на сервер SMARTS. Имя таблицы: %1, тип интерфейса: %2';
						|en = 'Finally, the prepared array is uploaded to the Cleverence server. Table name: %1, Interface type: %2';
						|be = 'Канец, Выгрузка падрыхтаванага масіва на сервер Cleverence. Імя табліцы: %1, Тып інтэрфейсу: %2'; es = 'Fin, Descargando la matriz preparada en el servidor Cleverence. Nombre de la tabla: %1, tipo de interfaz: %2'; ka = 'და ბოლოს, მომზადებული მასივი ატვირთულია Cleverence სერვერზე. მაგიდის სახელი: %1, ინტერფეისის ტიპი: %2'; kk = 'Соңы, дайындалған массивті Cleverence серверіне жүктеу. Кесте атауы: %1, интерфейс түрі: %2'; ro = 'În cele din urmă, matricea pregătită este încărcată pe serverul Cleverence. Nume tabel: %1, Tip interfață: %2'; tr = 'Son, Hazırlanan dizinin Cleverence sunucusuna yüklenmesi. Tablo adı: %1, arayüz tipi: %2'; uk = 'Кінець, вивантаження підготовленого масиву на сервер Cleverence. Назва таблиці: %1, Тип інтерфейсу: %2'; uz = 'Tugatish, tayyorlangan qatorni Cleverence serveriga yuklash. Jadval nomi: %1, interfeys turi: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяТаблицы), Строка(ТипИнтерфейса));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

// Получает порцию строк таблицы "Номенклатура", преобразованных в массив значений либо соответствие в зависимости от типа интерфейса, для выгрузки на сервер Клеверенс
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ID_БазыSMARTS - Строка - идентификатор базы Клеверенс, в которую производится выгрузка
//  ОтборПоНоменклатуре - Массив из СправочникСсылка.Номенклатура - массив ссылок для отбора при выгрузке таблицы "Номенклатура"
//  РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - для COM - содержит:
//		* МассивИмен - Массив из Строка - содержит имена колонок выгружаемой таблицы
//		* МассивыСтрок - Массив из Массив - содержит строки выгружаемой таблицы в виде массивов значений
//      * КоличествоТоваров - Число - содержит количество выгружаемых товаров для таблицы "Номенклатура"
//	- Массив из Соответствие - для REST_API - содержит строки выгружаемой таблицы в виде соответствий, ключами которых 
//											  являются названия колонок таблицы, переведенные в транслит, значениями - 
//											  значения соответствующих колонок.
Функция ГлЯдро_ПолучитьПорциюДанныхДляВыгрузки(ИмяТаблицы, НастройкиКомпоновщика = Ложь, ПараметрыКомпоновщика = Ложь, ТипБазы = "", ОтборПоНоменклатуре = Неопределено, РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = Неопределено, ID_БазыSMARTS = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьПорциюДанныхДляВыгрузки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,ТипБазы,ОтборПоНоменклатуре,РаботаБезАлкоголя,ПараметрыВыгрузки,ID_БазыSMARTS",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ТипБазы, ОтборПоНоменклатуре, РаботаБезАлкоголя, ПараметрыВыгрузки, ID_БазыSMARTS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ОтборПоНоменклатуре <> Неопределено Тогда
		Если ПараметрыВыгрузки = Неопределено Тогда	
			ПараметрыВыгрузки = Новый Структура;		
		КонецЕсли;
		Если НЕ ПараметрыВыгрузки.Свойство("ПараметрыПорционнойВыгрузки") Тогда
			
			ПараметрыСпособаВыгрузки = Новый Структура;
			ПараметрыСпособаВыгрузки.Вставить("СправочникИмя", ИмяТаблицы);
			ПараметрыСпособаВыгрузки.Вставить("ПараметрыВыгрузки", ПараметрыВыгрузки);
			ПараметрыСпособаВыгрузки.Вставить("СоответствиеПараметровПорционнойВыгрузки");
			ПараметрыСпособаВыгрузки.Вставить("МетаданныеНСИ");
			
			СтруктураСпособаВыгрузки = ГлЯдро_ОпределитьСпособВыгрузкиСправочника(ПараметрыСпособаВыгрузки, АдресаПеременных);
			ПараметрыВыгрузки.Вставить("ПараметрыПорционнойВыгрузки", СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДляВыгрузки = ГлЯдро_ПолучитьТаблицуДляВыгрузкиСПравочников(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, , , ОтборПоНоменклатуре, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
	
	ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицы(ДанныеДляВыгрузки, ИмяТаблицы, ПараметрыВыгрузки, АдресаПеременных);	
	
	МассивыДляВыгрузки 	= ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивыДляВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивыДляВыгрузки;		
	
КонецФункции

// Вызывает функцию получения запроса для выгрузки таблицы на сервер Клеверенс, выполняет его и обрабатывает полученную таблицу значений
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы	
//  НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ПараметрыОнлайн - Строка, Структура - содержит дополнительные параметры для формирования запроса выгрузки таблицы в онлайн-режиме
//  РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные таблицы для выгрузки на сервер Клеверенс	
Функция ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика = "", ПараметрыКомпоновщика = Ложь, ПараметрыОнлайн = "", РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = Неопределено, АдресаПеременных) Экспорт
	
	ДанныеДляВыгрузки = ГлЯдро_ПолучитьТаблицуДляВыгрузкиСПравочников(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика,, ПараметрыОнлайн, , РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
	
	ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицы(ДанныеДляВыгрузки, ИмяТаблицы, ПараметрыВыгрузки, АдресаПеременных);
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

// Получает из интеграционной обработки схему компоновки данных, используемую для выгрузки таблицы на сервер Клеверенс.
// Устанавливает параметры полученной схемы компоновки данных.
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//  ПараметрыКомпоновщика - Неопределено, Массив из Структура - содержит параметры компоновщика для установки в полученной схеме компоновки данных
//	РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С	
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- СхемаКомпоновкиДанных - схема компоновки данных для выгрузки таблицы на сервер Клеверенс
//  - Неопределено - если не удалось получить интеграционную обработку
Функция ГлЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников(ИмяТаблицы, ПараметрыКомпоновщика, ПараметрыПолученияМакета, ПараметрыВыгрузки = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ПараметрыКомпоновщика,ПараметрыПолученияМакета,ПараметрыВыгрузки",
		ИмяТаблицы, ПараметрыКомпоновщика, ПараметрыПолученияМакета, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();	
	
	ЭтоВнешнееСоединение = Ложь;
	ИспользоватьКэшированиеСКД = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	Если ЭтоВнешнееСоединение Или ЭтоWebСервис Тогда
		ИспользоватьКэшированиеСКД = Истина;
	КонецЕсли;		
	
	МакетПолучен = Ложь;
	Если ИспользоватьКэшированиеСКД Тогда 
		РежимЗапроса = "";
		Если ПараметрыПолученияМакета.Свойство("ПараметрыОнлайн")
			И ТипЗнч(ПараметрыПолученияМакета.ПараметрыОнлайн) = Тип("Структура")
			И ПараметрыПолученияМакета.ПараметрыОнлайн.Свойство("Режим") Тогда
			РежимЗапроса = ПараметрыПолученияМакета.ПараметрыОнлайн.Режим;
		КонецЕсли;
		СоответствияСКДИменамТаблиц = КомЯдро_ПолучитьЗначениеПеременной("МакетыСКД",АдресаПеременных);
		Если СоответствияСКДИменамТаблиц <> Неопределено Тогда
			СхемаСКД = СоответствияСКДИменамТаблиц.Получить(ИмяТаблицы+РежимЗапроса);
			Если СхемаСКД <> Неопределено Тогда
				МакетПолучен = Истина;
			Конецесли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не МакетПолучен Тогда
		СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
			
		Если (СтруктураИО = Неопределено
			ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
			ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
			ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)		
			И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
		ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
		
		СпособВыгрузки 					= Неопределено;
		ИмяМакетаИО 					= Неопределено;
		ТекстЗапросаВыгрузкиНаТСД		= Неопределено;
		ТекстКодаПолучениеПараметров 	= Неопределено;
		ТаблицаСопоставленияПолей 		= Неопределено;
		
		Если ТипЗнч(ПараметрыВыгрузки) = Тип("Структура") Тогда
			Если ПараметрыВыгрузки.Свойство("СпособВыгрузки") Тогда
				СпособВыгрузки = ПараметрыВыгрузки.СпособВыгрузки;
				
				Если СпособВыгрузки = "СвойМакетСКД" Тогда
					Если ПараметрыВыгрузки.Свойство("ИмяМакетаИО") Тогда
						ИмяМакетаИО = ПараметрыВыгрузки.ИмяМакетаИО;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпособВыгрузки) 
			И СпособВыгрузки <> "ПоУмолчанию" Тогда
			Если СпособВыгрузки = "СвойМакетСКД"
				И ЗначениеЗаполнено(ИмяМакетаИО) Тогда
				СтруктураСхемыСКД = ИнтеграционнаяОбработка.ПолучитьМакет(ИмяМакетаИО);
			ИначеЕсли СпособВыгрузки = "ПроизвольныйЗапрос" Тогда
				СтруктураСхемыСКД = ГлЯдро_ПолучитьСхемуСКДПоТекстуЗапроса(ПараметрыВыгрузки, АдресаПеременных);
			КонецЕсли;
		Иначе
			Попытка
				ИнформацияСовместимости = ИнтеграционнаяОбработка.ИнформацияСовместимости();
				ВерсияAPI = ИнформацияСовместимости.ВерсияAPI;
			Исключение
				ВерсияAPI = 3;
			КонецПопытки;
			
			Если ВерсияAPI >= 4 Тогда
				СтруктураСхемыСКД = ИнтеграционнаяОбработка.ПолучитьМакетСКД(ИмяТаблицы, ПараметрыПолученияМакета);
			Иначе
				СтруктураСхемыСКД = ИнтеграционнаяОбработка.ПолучитьМакетСКД(ИмяТаблицы, ПараметрыПолученияМакета.РаботаБезАлкоголя);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СтруктураСхемыСКД) = Тип("Структура") 
			И СтруктураСхемыСКД.Свойство("ОписаниеОшибки")  Тогда
			Если ЗначениеЗаполнено(СтруктураСхемыСКД.ОписаниеОшибки) Тогда
				// <Лог>
				пСообщение = СтруктураСхемыСКД.ОписаниеОшибки;
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ОписаниеОшибки",
					СтруктураСхемыСКД.ОписаниеОшибки);
				ЛогОшибка(логСобытие, пСообщение,, логКонтекст,,, АдресаПеременных);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат Неопределено;
			Иначе
				СхемаСКД = СтруктураСхемыСКД.Макет;
			КонецЕсли; 
		Иначе
			СхемаСКД = СтруктураСхемыСКД;
		КонецЕсли;
		
		Если ИспользоватьКэшированиеСКД Тогда
			Если СоответствияСКДИменамТаблиц = Неопределено Тогда
				СоответствияСКДИменамТаблиц = Новый Соответствие;
			КонецЕсли;
			СоответствияСКДИменамТаблиц.Вставить(ИмяТаблицы+РежимЗапроса,СхемаСКД);
			КомЯдро_СохранитьЗначениеПеременной("МакетыСКД",СоответствияСКДИменамТаблиц,АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	// Определяемые общие параметры
	Если ТипЗнч(ПараметрыКомпоновщика) = Тип("Массив") Тогда
		Для Каждого ПараметрКомпоновки Из ПараметрыКомпоновщика Цикл
			ПараметрыСКД = СхемаСКД.Параметры;
			НайденныйПараметрСКД = ПараметрыСКД.Найти(ПараметрКомпоновки.ID_Параметра);
			Если НайденныйПараметрСКД = Неопределено Тогда
		        ПараметрСхемыКомпоновкиДанных = ПараметрыСКД.Добавить();
		        ПараметрСхемыКомпоновкиДанных.Имя                      = ПараметрКомпоновки.ID_Параметра;
		        ПараметрСхемыКомпоновкиДанных.Заголовок                = СокрЛП(ПараметрКомпоновки.Наименование);
		        ПараметрСхемыКомпоновкиДанных.ВключатьВДоступныеПоля   = Истина;
				ПараметрСхемыКомпоновкиДанных.ОграничениеИспользования = Истина;
				ПараметрСхемыКомпоновкиДанных.Использование            = ИспользованиеПараметраКомпоновкиДанных.Авто;
				ПараметрСхемыКомпоновкиДанных.ТипЗначения.Типы().Добавить(ТипЗнч(ПараметрКомпоновки.Значение));
				ПараметрСхемыКомпоновкиДанных.Значение                 = ПараметрКомпоновки.Значение;
			Иначе
				НайденныйПараметрСКД.Значение = ПараметрКомпоновки.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец получения макета СКД.';
						|en = 'End of receiving the SKD layout.'; be = 'Канец атрымання макета СКД.'; es = 'Fin de obtener el diseño SKD.'; ka = 'SKD განლაგების მიღების დასასრული.'; kk = 'СКД макетін алудың соңы.'; ro = 'Sfârșitul primirii aspectului SKD.'; tr = 'SKD düzenini almanın sonu.'; uk = 'Кінець отримання макета СКД.'; uz = 'Scd tartibini olishning oxiri.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СхемаСКД);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СхемаСКД;
	
КонецФункции

// Последовательно вызывает функции получения данных таблицы для выгрузки на сервер Клеверенс и преобразования
// полученной таблицы значений в массивы значений либо соответствия в зависимости от типа интерфейса
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//  НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс 
//  РаботаБезАлкоголя - Булево - признак отсутствия (Истина) или наличия (Ложь) данных об алкогольной продукции в базе 1С
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - для COM - содержит:
//		* МассивИмен - Массив из Строка - содержит имена колонок выгружаемой таблицы
//		* МассивыСтрок - Массив из Массив - содержит строки выгружаемой таблицы в виде массивов значений
//      * КоличествоТоваров - Число - содержит количество выгружаемых товаров для таблицы "Номенклатура"
//	- Массив из Соответствие - для REST_API - содержит строки выгружаемой таблицы в виде соответствий, ключами которых 
//											  являются названия колонок таблицы, переведенные в транслит, значениями - 
//											  значения соответствующих колонок.	
Функция ГлЯдро_ПолучитьМассивыТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика = "", ПараметрыКомпоновщика = Ложь, РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = Неопределено, ТипБазы = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьМассивыТаблицыДляВыгрузкиНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,РаботаБезАлкоголя,ПараметрыВыгрузки,ТипБазы",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, РаботаБезАлкоголя, ПараметрыВыгрузки, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ДанныеДляВыгрузки = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, , РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
	
	Если ДанныеДляВыгрузки = Неопределено 
		Или (ТипЗнч(ДанныеДляВыгрузки) = Тип("ТаблицаЗначений") 
			 И ДанныеДляВыгрузки.Колонки.Количество() = 0) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
		
	ДанныеДляВыгрузки = ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеДляВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

// Преобразует данные выгружаемой таблицы в массивы значений либо соответствия в зависимости от типа интерфейса
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	ДанныеДляВыгрузки - ТаблицаЗначений, Массив из Структура, Структура - данные выгружаемой таблицы
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - для COM - содержит:
//		* МассивИмен - Массив из Строка - содержит имена колонок выгружаемой таблицы
//		* МассивыСтрок - Массив из Массив - содержит строки выгружаемой таблицы в виде массивов значений
//      * КоличествоТоваров - Число - содержит количество выгружаемых товаров для таблицы "Номенклатура"
//	- Массив из Соответствие - для REST_API - содержит строки выгружаемой таблицы в виде соответствий, ключами которых 
//											  являются названия колонок таблицы, переведенные в транслит, значениями - 
//											  значения соответствующих колонок.
Функция ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц(ИмяТаблицы, Знач ДанныеДляВыгрузки, ТипБазы = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СформироватьМассивыДляВыгрузкиТаблиц";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ДанныеДляВыгрузки,ТипБазы",
		ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	Если ЭтоАдресВременногоХранилища(ДанныеДляВыгрузки) Тогда
		ДанныеДляВыгрузки = ПолучитьИзВременногоХранилища(ДанныеДляВыгрузки);
	КонецЕсли;
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	Если ТипИнтерфейса = "REST_API"
		И ИмяТаблицы <> "Номенклатура" Тогда
		МассивСоответствий = Новый Массив;

		Если ИмяТаблицы = "Ячейки" Тогда			
			МассивСоответствий = Новый Массив;
			СоответствиеКолонок = Новый Соответствие;
			Для каждого Колонка из ДанныеДляВыгрузки.Колонки Цикл
				СоответствиеКолонок.Вставить(Колонка.Имя,ГлЯдро_СтрокуВТранслитENG(Колонка.Имя));	
			КонецЦикла;
			
			Для Каждого СтрокаТЗ из ДанныеДляВыгрузки Цикл
				нЯчейка = Новый Соответствие;
				Для каждого Колонка из СоответствиеКолонок Цикл
					ЗначениеКолонки = REST_API_ОбработатьЗначениеДляВыгрузки(СтрокаТЗ[Колонка.Ключ]);
					нЯчейка.Вставить(Колонка.Значение,ЗначениеКолонки);
				КонецЦикла;
				
				Если ВерсияAPI = 1 Тогда
                    нЯчейка.Вставить("warehouseId", "1");
				КонецЕсли;
				
				МассивСоответствий.Добавить(нЯчейка);
			КонецЦикла;
		Иначе
			Если ТипЗнч(ДанныеДляВыгрузки) = Тип("ТаблицаЗначений") Тогда
				СоответствиеКолонок = Новый Соответствие;
				Для каждого Колонка из ДанныеДляВыгрузки.Колонки Цикл
					СоответствиеКолонок.Вставить(Колонка.Имя,ГлЯдро_СтрокуВТранслитENG(Колонка.Имя));	
				КонецЦикла;
				Для Каждого СтрокаТЗ из ДанныеДляВыгрузки Цикл
					НовойеСоответствие = Новый Соответствие;
					Для каждого Колонка из СоответствиеКолонок Цикл
						ЗначениеКолонки = REST_API_ОбработатьЗначениеДляВыгрузки(СтрокаТЗ[Колонка.Ключ]);
						НовойеСоответствие.Вставить(Колонка.Значение,ЗначениеКолонки);
					КонецЦикла;
					МассивСоответствий.Добавить(НовойеСоответствие);	
				КонецЦикла;
			ИначеЕсли ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив")
				ИЛИ ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура") Тогда
				
				ЭтоСтруктура = ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура");
				СоответствиеКолонок = Новый Соответствие;
				
				Для Каждого СтрокаДляВыгрузки Из ДанныеДляВыгрузки Цикл
					ЭлементМ = ?(ЭтоСтруктура,СтрокаДляВыгрузки.Значение,СтрокаДляВыгрузки);	
					Если НЕ ТипЗнч(ЭлементМ) = Тип("Структура")	Тогда
						Прервать;
					КонецЕсли;
					
					Если ЭлементМ.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					Для Каждого Парам из ЭлементМ Цикл
						Если СоответствиеКолонок.Получить(Парам.Ключ) = Неопределено Тогда
							СоответствиеКолонок.Вставить(Парам.Ключ,ГлЯдро_СтрокуВТранслитENG(Парам.Ключ));
						КонецЕсли;
					КонецЦикла;
					Прервать;
				КонецЦикла;
				
				Если СоответствиеКолонок.Количество() > 0 Тогда
					пЗначение = Неопределено;
					Для Каждого ЭлементМ Из ДанныеДляВыгрузки Цикл
						НовойеСоответствие = Новый Соответствие;
						ЭлементМ = ?(ЭтоСтруктура,ЭлементМ.Значение,ЭлементМ);
						МассивТекущейСтроки = Новый Массив;
						Для Каждого пКлюч из СоответствиеКолонок Цикл
							ЭлементМ.Свойство(пКлюч.Ключ,пЗначение);
							пЗначение = REST_API_ОбработатьЗначениеДляВыгрузки(пЗначение);
							НовойеСоответствие.Вставить(пКлюч.Значение,пЗначение);		
						КонецЦикла;
						МассивСоответствий.Добавить(НовойеСоответствие);	
					КонецЦикла;
				КонецЕсли;	
			Иначе
				МассивСоответствий = ДанныеДляВыгрузки;
			КонецЕсли;
		КонецЕсли;
		СтруктураМассивов = МассивСоответствий;
	Иначе
		
	//COM
		СтруктураМассивов = Новый Структура("МассивИмен,МассивыСтрок"); 
	
		МассивИмен = Новый Массив;
		МассивИменДляПоиска = Новый Массив;
		
		Если ТипЗнч(ДанныеДляВыгрузки) = Тип("ТаблицаЗначений") Тогда
			Для Каждого Колонка Из ДанныеДляВыгрузки.Колонки Цикл
				ИмяДляМассива = Колонка.Имя;
				// Реальное имя в таблице запроса
				МассивИменДляПоиска.Добавить(ИмяДляМассива);
				// Имя для выгрузки онлайн
				ИмяДляМассива = СтрЗаменить(ИмяДляМассива, "Product_", ?(ВерсияAPI = 1, "Product.", "InventoryItem."));
				ИмяДляМассива = СтрЗаменить(ИмяДляМассива, "Packing_", ?(ВерсияAPI = 1, "Packing.", "UnitOfMeasure."));
				МассивИмен.Добавить(ИмяДляМассива);
			КонецЦИкла;
			
			МассивыСтрок = Новый Массив;
			Для Каждого СтрокаВыгрузки Из ДанныеДляВыгрузки Цикл
				МассивТекущейСтроки = Новый Массив;
				Для Каждого ИмяКолонки Из МассивИменДляПоиска Цикл
					Значение = СтрокаВыгрузки[ИмяКолонки];
					МассивТекущейСтроки.Добавить(?(Значение = null,"",Значение));
				КонецЦикла;
				МассивыСтрок.Добавить(МассивТекущейСтроки);
			КонецЦикла;
			
			СтруктураМассивов.Вставить("МассивИмен", МассивИмен);
			СтруктураМассивов.Вставить("МассивыСтрок", МассивыСтрок);
			
			Если ИмяТаблицы = "Номенклатура" 
				И ДанныеДляВыгрузки.Колонки.Найти("Product_Id") <> Неопределено Тогда

				тзКолонкаТовары = ДанныеДляВыгрузки.Скопировать(,"Product_Id");
				тзКолонкаТовары.Свернуть("Product_Id");
				КоличествоТоваров = тзКолонкаТовары.Количество();
				
				СтруктураМассивов.Вставить("КоличествоТоваров",КоличествоТоваров);				
				
			КонецЕсли; 
			
		ИначеЕсли ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив")
			ИЛИ ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура") Тогда
			
			ЭтоСтруктура = ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура");
			
			МассивыСтрок = Новый Массив;
			Для Каждого СтрокаДляВыгрузки Из ДанныеДляВыгрузки Цикл
				ЭлементМ = ?(ЭтоСтруктура,СтрокаДляВыгрузки.Значение,СтрокаДляВыгрузки);	
				Если НЕ ТипЗнч(ЭлементМ) = Тип("Структура")	Тогда
					Прервать;
				КонецЕсли;
				
				Если ЭлементМ.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				Для Каждого Парам из ЭлементМ Цикл
					Если МассивИмен.Найти(Парам.Ключ) = Неопределено Тогда
						МассивИмен.Добавить(Парам.Ключ);		
					КонецЕсли;
				КонецЦикла;
				Прервать;
			КонецЦикла;
			
			Если ИмяТаблицы = "Номенклатура" Тогда				
				СоответствиеРазличныхТоваров 	= Новый Соответствие;
				ИндексИдТовара 					= ГлЯдро_НайтиИндексИдТовараВМассивеИмен(МассивИмен);
			КонецЕсли; 
			
			Если МассивИмен.Количество() > 0 Тогда
				пЗначение = Неопределено;
				Для Каждого ЭлементМ Из ДанныеДляВыгрузки Цикл
					ЭлементМ = ?(ЭтоСтруктура,ЭлементМ.Значение,ЭлементМ);
					МассивТекущейСтроки = Новый Массив;
					Для Каждого пКлюч из МассивИмен Цикл
						ЭлементМ.Свойство(пКлюч,пЗначение);
						МассивТекущейСтроки.Добавить(пЗначение);		
					КонецЦикла;
					МассивыСтрок.Добавить(МассивТекущейСтроки);
					Если ИмяТаблицы = "Номенклатура" И ИндексИдТовара <> -1 Тогда
						СоответствиеРазличныхТоваров.Вставить(МассивТекущейСтроки[ИндексИдТовара]);
					КонецЕсли;	
				КонецЦикла;
				СтруктураМассивов.Вставить("МассивИмен", МассивИмен);
				СтруктураМассивов.Вставить("МассивыСтрок", МассивыСтрок);
			Иначе
				СтруктураМассивов.Вставить("МассивИмен", Новый Массив);
				СтруктураМассивов.Вставить("МассивыСтрок", Новый Массив);
			КонецЕсли;
			Если ИмяТаблицы = "Номенклатура" Тогда
				СтруктураМассивов.Вставить("КоличествоТоваров",СоответствиеРазличныхТоваров.Количество());	
			КонецЕсли;	
		Иначе
			СтруктураМассивов = ДанныеДляВыгрузки;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураМассивов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураМассивов;
	
КонецФункции

Процедура ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицы(ДанныеДляОбработки, ИмяТаблицы, ПараметрыВыгрузки, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеДляОбработки,ИмяТаблицы,ПараметрыВыгрузки",
		ДанныеДляОбработки, ИмяТаблицы, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ДанныеДляОбработки.Количество() = 0 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS",АдресаПеременных);
	
	ТаблицаЗаменыGUID = Новый ТаблицаЗначений;
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаСсылка");
	ТаблицаЗаменыGUID.Колонки.Добавить("КолонкаGUID");
	
	Для Каждого Колонка Из ДанныеДляОбработки.Колонки Цикл
		Если Найти(Колонка.Имя, "_GUID") Тогда
			НоваяСтрока = ТаблицаЗаменыGUID.Добавить();
			НоваяСтрока.КолонкаСсылка = Колонка.Имя;
			НоваяСтрока.КолонкаGUID = СтрЗаменить(Колонка.Имя, "_GUID", "");
			ДанныеДляОбработки.Колонки.Добавить(НоваяСтрока.КолонкаGUID);
		КонецЕсли;
	КонецЦикла;
	
	// Если в таблице существует иерархия на ИдРодителя, то ниже будем проверять его наличие в спике, на случай если установлены отборы по группам или наименованию
	флПроверятьРодителей = Ложь;
	Если (ИмяТаблицы = "Номенклатура" ИЛИ ИмяТаблицы = "Склады")
		И ДанныеДляОбработки.Колонки.Найти("ИдРодителя")  <> Неопределено 
		И ДанныеДляОбработки.Колонки.Найти("Ид_GUID") <> Неопределено Тогда
		Если ИмяТаблицы = "Номенклатура" Тогда
			флПроверятьРодителей = Истина;
		ИначеЕсли ТипЗнч(ПараметрыВыгрузки) = Тип("Структура")
			И ПараметрыВыгрузки.Свойство("флПроверятьРодителей") Тогда
			флПроверятьРодителей = Истина;
		КонецЕсли;
	КонецЕсли;			
	Если флПроверятьРодителей Тогда
		МассивИдентификаторов = ДанныеДляОбработки.ВыгрузитьКолонку("Ид_GUID");		
	КонецЕсли;
	
	ДлинаКодаВесовогоТовара = Число(ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ДлинаКодаВесовогоТовара",,АдресаПеременных));
	
	Если ИмяТаблицы = "Номенклатура" Тогда
		// В некоторых конфигурациях код номенклатуры задан числом, поэтому при преобразовании в строку может остаться только один символ
		// поэтому была добавлена отдельная колонка с кодом, значени из которой будут преобразованы и записаны в другую колонку
		ЕстьКолонкаКода = Ложь;
		КолонкаКод = ДанныеДляОбработки.Колонки.Найти("Код");
		Если КолонкаКод <> Неопределено Тогда
			ЕстьКолонкаКода = Истина;
		КонецЕсли;
		
		Если ДанныеДляОбработки.Колонки.Найти("Product_Весовой") <> Неопределено Тогда
			ИмяКолонкиВесовой = "Product_Весовой";
		ИначеЕсли ДанныеДляОбработки.Колонки.Найти("Весовой") <> Неопределено Тогда
			ИмяКолонкиВесовой = "Весовой";
		Иначе
			ИмяКолонкиВесовой = "";
		КонецЕсли;
		
	КонецЕсли;
	
	// Если для выгрузки используются нетиповые макеты, то запишем это в СпособВыгрузкиИзменен
	// Не выполняем обработку таблицы данных номенклатуры, если для выгрузки используются нетиповые макеты
	СпособВыгрузкиИзменен = Ложь;	
	Если ТипЗнч(ПараметрыВыгрузки) = Тип("Структура")
		И ПараметрыВыгрузки.Свойство("СпособВыгрузки")
		И ПараметрыВыгрузки.СпособВыгрузки <> "ПоУмолчанию"
		И ПараметрыВыгрузки.СпособВыгрузки <> "" Тогда
		СпособВыгрузкиИзменен = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы из ДанныеДляОбработки Цикл 
		
		// Если родителя нет в выгрузке, то не будем его прописывать
		Если флПроверятьРодителей 
			И ДанныеДляОбработки.Колонки.Найти("ИдРодителя_GUID") <> Неопределено Тогда
			Если МассивИдентификаторов.Найти(СтрокаТаблицы.ИдРодителя_GUID) = Неопределено Тогда
				СтрокаТаблицы.ИдРодителя_GUID = "";		
			КонецЕсли;
		КонецЕсли;
		
		// Заменяем ссылки на текстовые гуиды
		Для Каждого СтрокаЗамены Из ТаблицаЗаменыGUID Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]) Тогда
				ИдСсылки = XMLСтрока(СтрокаТаблицы[СтрокаЗамены.КолонкаСсылка]);
				Если ИмяТаблицы = "Контрагенты" И СтрокаЗамены.КолонкаGUID = "Ид" Тогда                           				
					// В Клеверенс не должно быть одинаковых ссылок в одной таблице, но, например, у контрагентов и партнеров такое вполне может быть, поэтому надо обработать это
					Если ДанныеДляОбработки.Найти(ИдСсылки, СтрокаЗамены.КолонкаGUID) = Неопределено Тогда
						СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = ИдСсылки; 
					Иначе
						СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = "";
					КонецЕсли;
				Иначе
					СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = ИдСсылки; 
				КонецЕсли;
			Иначе
				СтрокаТаблицы[СтрокаЗамены.КолонкаGUID] = ""; // В Клеверенс нельзя отправлять значения "Неопределено" и "NULL", можно только значения примитивных типов	
			КонецЕсли;
		КонецЦикла;
		
		// приводим необходимые поисковые поля в нужный регистр
		Если ДанныеДляОбработки.Колонки.Найти("НаименованиеДляПоиска") <> Неопределено Тогда
			СтрокаТаблицы.НаименованиеДляПоиска = НРег(СтрокаТаблицы.НаименованиеДляПоиска);
		КонецЕсли;
		
		Если ДанныеДляОбработки.Колонки.Найти("NameForSearch") <> Неопределено Тогда
			СтрокаТаблицы.NameForSearch = НРег(СтрокаТаблицы.NameForSearch);
		КонецЕсли;
				
		// Дополнительная обработка в зависимости от имени таблицы
		Если ИмяТаблицы = "Номенклатура"
			И Не СпособВыгрузкиИзменен Тогда
				
			// Переводим необходимые числа в строки, удаляем непереносимые пробелы, весовые коды добиваем нулями до значения параметра "ДлинаКодаВесовогоТовара"
			СтрокаТаблицы.Product_Barcode = ?(ЕстьКолонкаКода, Строка(СтрокаТаблицы.Код), СтрокаТаблицы.Product_Barcode);
			СтрокаТаблицы.Product_Barcode = СтрЗаменить(СокрЛП(СтрокаТаблицы.Product_Barcode), Символы.НПП, "");
			СтрокаТаблицы.Product_Marking = СтрЗаменить(СокрЛП(СтрокаТаблицы.Product_Marking), Символы.НПП, "");
			Если ТипЗнч(СтрокаТаблицы.Product_Marking) = Тип("Число") Тогда
				СтрокаТаблицы.Product_Marking = Строка(СтрокаТаблицы.Product_Marking);
			КонецЕсли;
			СтрокаТаблицы.Packing_Barcode 		= СтрЗаменить(СокрЛП(СтрокаТаблицы.Packing_Barcode), Символы.НПП, "");
			
			Если ИмяКолонкиВесовой <> "" Тогда
				Весовой = СтрокаТаблицы[ИмяКолонкиВесовой];
				Если Весовой Тогда
					Если ЗначениеЗаполнено(СтрокаТаблицы.Packing_Barcode) И СтрДлина(СтрокаТаблицы.Packing_Barcode) < ДлинаКодаВесовогоТовара Тогда
						Для Сч = СтрДлина(СтрокаТаблицы.Packing_Barcode) По ДлинаКодаВесовогоТовара - 1 Цикл
							СтрокаТаблицы.Packing_Barcode = "0" + СтрокаТаблицы.Packing_Barcode;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				// если Штрихкод указан в виде шаблона, выделяем код товара из шаблона
				Если Весовой и СтрДлина(СтрокаТаблицы.Packing_Barcode) > ДлинаКодаВесовогоТовара Тогда
					
					Штрихкод = СтрокаТаблицы.Packing_Barcode;
					СтруктураШтрихкода = ГлЯдро_ПолучитьСтруктуруШтрихкодаEAN13(Штрихкод, АдресаПеременных);
					
					Если СтруктураШтрихкода.Свойство("КодСтрока") И Не ПустаяСтрока(СтруктураШтрихкода.КодСтрока) Тогда
						СтрокаТаблицы.Packing_Barcode = СтруктураШтрихкода.КодСтрока;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяТаблицы = "Ячейки"
			И Не ЗначениеЗаполнено(СтрокаТаблицы.Barcode)
			И Не СпособВыгрузкиИзменен Тогда
			СтрокаТаблицы.Barcode 	= ГлЯдро_ЧисловойКодПоСсылке(СтрокаТаблицы.Id_GUID);			
		КонецЕсли; 		
		
		Если ИмяТаблицы = "СпрЯчейки"
			И Не ЗначениеЗаполнено(СтрокаТаблицы.ШтрихкодЯчейки)
			И Не СпособВыгрузкиИзменен Тогда
			СтрокаТаблицы.ШтрихкодЯчейки = ГлЯдро_ЧисловойКодПоСсылке(СтрокаТаблицы.ИдЯчейки_GUID);			
		КонецЕсли; 
		
		Если ИмяТаблицы = "Резерв"
			И Не СпособВыгрузкиИзменен Тогда
			СтрокаТаблицы.ИдДокумента = ?(СтрокаТаблицы.ИдДокумента.Пустая(), "", XMLСтрока(СтрокаТаблицы.ИдДокумента));								
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ИмяТаблицы = "Номенклатура"
		И ЕстьКолонкаКода Тогда
		// Удаляем колонку кода, чтобы она не выводилась
		ДанныеДляОбработки.Колонки.Удалить("Код");
	КонецЕсли;
	
	Если ИмяТаблицы = "ДопРеквизиты" 
		Или ИмяТаблицы = "AdditionalInfo" Тогда				
		
		ИмяКолонкиДвоичныеДанные 	= "ДвоичныеДанныеИзображения";
		ИмяКолонкиИзображение 		= "Изображение";		
		КолонкиТаблицы				= ДанныеДляОбработки.Колонки;
		КолонкаДвоичныеДанные		= КолонкиТаблицы.Найти(ИмяКолонкиДвоичныеДанные);								
		
		Если КолонкаДвоичныеДанные = Неопределено Тогда
			ИмяКолонкиДвоичныеДанные 	= "ImageBinaryData";
			ИмяКолонкиИзображение 		= "Image";			
			КолонкаДвоичныеДанные		= КолонкиТаблицы.Найти(ИмяКолонкиДвоичныеДанные);
		КонецЕсли;
		
		Если КолонкаДвоичныеДанные <> Неопределено Тогда			
			
			Если (ПараметрыПодключенияMS.ТипУстановленногоПродукта = "Прайсчекер" 
				И ПараметрыПодключенияMS.УровеньПриложенияСтрокой = "Полный")
				ИЛИ ПараметрыПодключенияMS.ТипУстановленногоПродукта = "КУИ" Тогда				
				
				КолонкиТаблицы.Добавить(ИмяКолонкиИзображение, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
				
				Для Каждого СтрокаТаблицы из ДанныеДляОбработки Цикл 
					Если ТипЗнч(СтрокаТаблицы[ИмяКолонкиДвоичныеДанные]) = Тип("ХранилищеЗначения") Тогда
						ДвоичныеДанные = СтрокаТаблицы[ИмяКолонкиДвоичныеДанные].Получить();
						Если ТипЗнч(ДвоичныеДанные) = Тип("Картинка") Тогда
							ДвоичныеДанные = ДвоичныеДанные.ПолучитьДвоичныеДанные();
						КонецЕсли;
						СтрокаТаблицы[ИмяКолонкиИзображение] = Base64Строка(ДвоичныеДанные);																	
					КонецЕсли; 							
				КонецЦикла;
				
			КонецЕсли;	
			
			КолонкиТаблицы.Удалить(КолонкаДвоичныеДанные);
			
		КонецЕсли;							
		
	КонецЕсли; 
	
	Если ИмяТаблицы = "ФормыА" Тогда
		// Переименовываем колонки для форм А
		ДанныеДляОбработки.Колонки.Найти("НачалоДействия").Имя = "Начало";
		ДанныеДляОбработки.Колонки.Найти("КонецДействия").Имя = "Конец";
	КонецЕсли;	
	
	// Формируем новую таблицу с переменной длиной имени ячеек (для исключения пробелов в SMARTS)
	Если ИмяТаблицы = "Ячейки" 
		И Не СпособВыгрузкиИзменен Тогда				
		ИменаКолонок = "";
		Для каждого Колонка ИЗ ДанныеДляОбработки.Колонки Цикл
			Если Колонка.Имя = "Name" ИЛИ Колонка.Имя = "Description" Тогда
				Продолжить;
			КонецЕсли;
			ИменаКолонок = ИменаКолонок + ?(ПустаяСтрока(ИменаКолонок), "", ", ") + Колонка.Имя;
		КонецЦикла;
		
		НоваяТаблицаЯчеек = ДанныеДляОбработки.СкопироватьКолонки(ИменаКолонок);
		НоваяТаблицаЯчеек.Колонки.Добавить("Name", 		  Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
		НоваяТаблицаЯчеек.Колонки.Добавить("Description", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
		
		Для Каждого СтрокаТаблицы из ДанныеДляОбработки Цикл
			НоваяСтрокаЯчеек = НоваяТаблицаЯчеек.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЯчеек, СтрокаТаблицы,, "Name");
			НоваяСтрокаЯчеек.Name = СокрЛП(СтрокаТаблицы.Name);
		КонецЦикла;	                            
		
		ДанныеДляОбработки = НоваяТаблицаЯчеек;
	КонецЕсли;
	
	ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицыДополнительно(ДанныеДляОбработки, ИмяТаблицы ,АдресаПеременных);
	
	// удаляем колонки с ссылками
	Для Каждого СтрокаЗамены Из ТаблицаЗаменыGUID Цикл
		ДанныеДляОбработки.Колонки.Удалить(СтрокаЗамены.КолонкаСсылка);
	КонецЦикла;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	СоответствиеПолейТаблицыMS = ГлЯдро_ПолучитьСоответствиеПолейТаблицыMS(ИмяТаблицы, ЯзыкПлатформыMS, АдресаПеременных);
	Если СоответствиеПолейТаблицыMS <> Неопределено Тогда
		Для каждого СоответствиеПоля Из СоответствиеПолейТаблицыMS Цикл
			Колонка = ДанныеДляОбработки.Колонки.Найти(СоответствиеПоля.Ключ);
			Если Колонка <> Неопределено Тогда
				Колонка.Имя = СоответствиеПоля.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяТаблицы = "Номенклатура" Тогда
		ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
		
		Если ВерсияAPI = 2 Тогда
			СоответствиеПолейТаблицыMS = ГлЯдро_ПолучитьСоответствиеПолейТаблицыПоВерсииAPI(ИмяТаблицы, ВерсияAPI);
			Для каждого СоответствиеПоля Из СоответствиеПолейТаблицыMS Цикл
				Колонка = ДанныеДляОбработки.Колонки.Найти(СоответствиеПоля.Ключ);
				Если Колонка <> Неопределено Тогда
					Колонка.Имя = СоответствиеПоля.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_ПроверитьПодключенныеРасширенияИПатчи(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПроверитьПодключенныеРасширенияИПатчи";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Расширения 	= Новый Массив;
	Патчи 		= Новый Массив;
	
	Попытка
		СписокПодключенныхРасширений = РасширенияКонфигурации.Получить();
	Исключение
		пСообщение = НСтр("ru = 'Конфигурация не поддерживаниет механизм расширений';
							|en = 'The configuration does not support the extension mechanism';
							|be = 'Канфігурацыя ня поддерживаниет механізм пашырэньні'; es = 'La configuración no Admite el mecanismo de extensiones'; ka = 'კონფიგურაცია არ უჭერს მხარს გაფართოების მექანიზმს'; kk = 'Конфигурация кеңейтім механизмін қолдамайды'; ro = 'Configurația nu acceptă mecanismul de extensie'; tr = 'Yapılandırma, uzantı mekanizmasını desteklemiyor'; uk = 'Конфігурація не підтримує механізм розширень'; uz = 'Konfiguratsiya kengaytma mexanizmini qo''llab-quvvatlamaydi'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецПопытки;
	
	Для Каждого Расширение Из СписокПодключенныхРасширений Цикл
		Если Не Расширение.Активно Тогда
			Продолжить;
		КонецЕсли;
		Если ГлЯдро_СтрНайти(Расширение.Имя, "EF_") > 0 Тогда
			Патчи.Добавить(Расширение);
		Иначе
			Расширения.Добавить(Расширение);			
		КонецЕсли;
	КонецЦикла;
	
	Если Расширения.Количество() Тогда 
		пСообщение = НСтр("ru = 'К конфигурации подключены следующие расширения:';
							|en = 'The following extensions are connected to the configuration:'; be = 'Да канфігурацыі падлучаныя наступныя пашырэння:'; es = 'Las siguientes extensiones están conectadas a la configuración:'; ka = 'შემდეგი გაფართოებები დაკავშირებულია კონფიგურაციასთან:'; kk = 'Конфигурацияға келесі кеңейтімдер қосылған:'; ro = 'Următoarele extensii sunt conectate la configurație:'; tr = 'Aşağıdaki uzantılar yapılandırmaya bağlıdır:'; uk = 'До конфігурації підключені наступні розширення:'; uz = 'Quyidagi kengaytmalar konfiguratsiyaga ulangan:'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		Для Каждого ТекРасширение Из Расширения Цикл
			ТекстКомментария = НСтр("ru = '%1(Версия %2, Безопасный режим = %3)';
										|en = '%1(Version %2, Safe Mode = %3)'; be = '%1 (Версія %2, Бяспечны рэжым = %3)'; es = '%1 (versión %2, modo Seguro = %3)'; ka = '%1 (ვერსია %2, უსაფრთხო რეჟიმი = %3)'; kk = '%1 (%2 нұсқасы, Қауіпсіз режим = %3)'; ro = '%1 (Versiunea %2, Modul Sigur = %3)'; tr = '%1(Sürüm %2, Güvenli Mod = %3)'; uk = '%1 (Версія %2, Безпечний режим = %3)'; uz = '%1 (versiya %2, xavfsiz rejim = %3)'");
			ТекстКомментария = ГлЯдро_СтрШаблон(ТекстКомментария, ТекРасширение.Синоним, ТекРасширение.Версия, ТекРасширение.БезопасныйРежим);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстКомментария,, АдресаПеременных);
		КонецЦикла;
	Иначе
		пСообщение = НСтр("ru = 'У конфигурации отсутствуют подключенные расширения';
							|en = 'The configuration does not have extensions enabled';
							|be = 'У канфігурацыі адсутнічаюць падлучаныя пашырэння'; es = 'La configuración no tiene extensiones conectadas'; ka = 'კონფიგურაციაში არ არის ჩართული გაფართოებები'; kk = 'Конфигурацияда қосылған кеңейтімдер жоқ'; ro = 'Configurația nu are extensii activate'; tr = 'Yapılandırmada bağlı uzantılar eksik'; uk = 'У конфігурації відсутні підключені розширення'; uz = 'Konfiguratsiya ulangan kengaytmalarga ega emas'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	КонецЕсли;
	
	Если Патчи.Количество() Тогда 
		пСообщение = НСтр("ru = 'К конфигурации подключены следующие патчи от фирмы 1С:';
							|en = 'The following patches from 1C are connected to the configuration:';
							|be = 'Да канфігурацыі падлучаныя наступныя патчы ад фірмы 1С:'; es = 'Los siguientes parches de la firma 1C están conectados a la configuración:'; ka = 'შემდეგი პატჩები 1c-დან დაკავშირებულია კონფიგურაციასთან:'; kk = '1С фирмасының келесі патчтары конфигурацияға қосылған:'; ro = 'Următoarele patch-uri de la 1C sunt conectate la configurație:'; tr = '1C firmasından aşağıdaki yamalar yapılandırmaya bağlıdır:'; uk = 'До конфігурації підключені наступні патчі від фірми 1С:'; uz = 'Konfiguratsiyaga 1C kompaniyasidan quyidagi yamalar ulangan:'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		Для Каждого ТекПатч Из Патчи Цикл			
			ИмяПатча = ТекПатч.Синоним;
			Если ПустаяСтрока(ИмяПатча) Тогда
				ИмяПатча = ТекПатч.Имя;
			КонецЕсли;
			
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ИмяПатча,, АдресаПеременных);
		КонецЦикла;
	Иначе
		пСообщение = НСтр("ru = 'У конфигурации отсутствуют подключенные патчи от фирмы 1С';
							|en = 'The configuration does not have any connected patches from 1C';
							|be = 'У канфігурацыі адсутнічаюць падлучаныя патчы ад фірмы 1С'; es = 'La configuración no tiene parches conectados de la empresa 1C'; ka = 'კონფიგურაციას არ აქვს დაკავშირებული პატჩები 1C-დან'; kk = 'Конфигурацияда 1С компаниясынан қосылған патчтар жоқ'; ro = 'Configurația nu are patch-uri conectate de la 1C'; tr = 'Konfigürasyonda 1C firmasından bağlı yamalar bulunmuyor'; uk = 'У конфігурації відсутні підключені патчі від фірми 1С'; uz = 'Konfiguratsiya 1C-dan ulangan yamoqlarga ega emas'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_ПроверитьДоступностьРаботыСДокументами1С(МассивИменТиповДокументов1С, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПроверитьДоступностьРаботыСДокументами1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивИменТиповДокументов1С",
		МассивИменТиповДокументов1С);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МассивМетаданныхДокументов1С 			= Новый Массив;
	МассивМетаданныхНедоступныхДокументов1С = Новый Массив;
	
	Для Каждого ИмяТипаДокумента1С Из МассивИменТиповДокументов1С Цикл
		
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяТипаДокумента1С);
		
		Если МетаданныеДокумента <> Неопределено Тогда
			МассивМетаданныхДокументов1С.Добавить(МетаданныеДокумента);
		Иначе
			пСообщение = НСтр("ru = 'В конфигурации отсутствует документ с типом %1';
								|en = 'There is no document with type %1 in the configuration'; be = 'У канфігурацыі адсутнічае дакумент з тыпам %1'; es = 'Falta un documento de tipo %1 en la configuración'; ka = 'კონფიგურაციაში არ არის დოკუმენტი ტიპი %1-ით'; kk = 'Конфигурацияда %1 типті құжат жоқ'; ro = 'Nu există niciun document cu tipul %1 în configurație'; tr = 'Yapılandırmada %1 türünde bir belge eksik'; uk = 'У конфігурації відсутній документ з типом %1'; uz = 'Konfiguratsiyada %1 tipidagi hujjat yo''q'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТипаДокумента1С);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка, включены ли функц опций документов
	Для Каждого МетаданныеДокумента1С Из МассивМетаданныхДокументов1С Цикл
		
		ДокументДоступен = Истина; // Пока не нашли выключенные функциональные опции у документа, будем считать, что он доступен
		Для Каждого МетаданныеФункциональнойОпции Из Метаданные.ФункциональныеОпции Цикл
			
			Если МетаданныеФункциональнойОпции.Состав.Найти(МетаданныеДокумента1С) <> Неопределено Тогда
				// Проверяем только те функц опции, значения которых хранятся в константах, т.к. другие значения параметризуемые, т.е. зависят от измерений регистра или какого-либо реквизита
				Если Метаданные.Константы.Найти(МетаданныеФункциональнойОпции.Хранение.Имя) <> Неопределено Тогда
					ДокументДоступен = ПолучитьФункциональнуюОпцию(МетаданныеФункциональнойОпции.Имя);
					Если ДокументДоступен Тогда
						Прервать; // Функциональная опция включена, документ доступен
					Иначе
						ВыключеннаяФункциональнаяОпция = МетаданныеФункциональнойОпции.Синоним;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
						
		КонецЦикла;
		
		Если ДокументДоступен Тогда
			ТекстИнформации = "Тип документа " + МетаданныеДокумента1С.Синоним + " доступен.";
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстИнформации,, АдресаПеременных);			
		Иначе
			ТекстОшибки = НСтр("ru = 'Тип документа %1 недоступен. Выключена функциональная опция %2';
								|en = 'Document type %1 is unavailable. The functional option %2 is disabled';
								|be = 'Тып дакумента %1 недаступны. Выключаная функцыянальная Опцыя %2'; es = 'El tipo de documento %1 no está disponible. Desactivada la opción funcional %2'; ka = 'დოკუმენტის ტიპი %1 მიუწვდომელია. ფუნქციური ვარიანტი %2 გამორთულია'; kk = '%1 құжат түрі қол жетімді емес. %2 функционалды опциясы өшірулі'; ro = 'Tipul de Document %1 nu este disponibil. Opțiunea funcțională %2 este dezactivată'; tr = 'Belge türü %1 mevcut değil. %2 işlev seçeneği kapalı'; uk = 'Тип документа %1 недоступний. Вимкнена функціональна опція %2'; uz = '%1 hujjat turi mavjud emas. Funktsiya opsiyasi o''chirilgan %2'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, МетаданныеДокумента1С.Синоним, ВыключеннаяФункциональнаяОпция);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстОшибки,, АдресаПеременных);
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьКоличествоСтрокТаблицыSMARTS(ИмяТаблицы, ТипБазы = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	Возврат REST_API_ПолучитьКоличествоСтрокТаблицыSMARTS(ИмяТаблицы, ТипБазы, ДополнительныеПараметры, АдресаПеременных);
	
КонецФункции 

Функция ГлЯдро_ДобавитьНоменклатуруВЯчейкуСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ДобавитьНоменклатуруВЯчейкуСправочно";
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Если ИнтеграционнаяОбработка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбновитьВыгруженныйСправочник <> Истина Тогда
		Возврат ИнтеграционнаяОбработка.ДобавитьНоменклатуруВЯчейкуСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, Ложь);
	КонецЕсли;
	
	Попытка
		ДанныеСпрЯчейки = ИнтеграционнаяОбработка.ПолучитьДанныеСпрЯчейкиSMARTS(ИмяЯчейки, ИдТовара, ИдСклада1С);
	Исключение
		ДанныеСпрЯчейки = Неопределено;
	КонецПопытки;
	
	Если ДанныеСпрЯчейки = Неопределено Тогда
		ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
		ОбновитьВыгруженныйСправочник = ВерсияAPI = 1;
		Возврат ИнтеграционнаяОбработка.ДобавитьНоменклатуруВЯчейкуСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник);
	КонецЕсли;
	
	Если ДанныеСпрЯчейки.ОднаСпрЯчейка Тогда
		Результат = ГлЯдро_УдалитьСпрЯчейкуSMARTS(ДанныеСпрЯчейки, АдресаПеременных);
		Если Результат <> Истина Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ИнтеграционнаяОбработка.ДобавитьНоменклатуруВЯчейкуСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, Ложь);
	Если Результат = Истина Тогда
		Результат = ГлЯдро_ВыгрузитьСпрЯчейкуВSMARTS(ДанныеСпрЯчейки, АдресаПеременных);
		Результат = Результат.Статус;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ВыгрузитьСпрЯчейкуВSMARTS(ДанныеСпрЯчейки, АдресаПеременных)
	
	ПараметрыВыгрузки = ГлЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника("СпрЯчейки", "Интерактивный", АдресаПеременных);
	
	Если ПараметрыВыгрузки = Неопределено Тогда
		пСообщение = НСтр("ru = 'Не найдены настройки выгрузки таблицы СпрЯчейки'");
		Возврат Новый Структура("Статус,Сообщение", Ложь, пСообщение);
	КонецЕсли;
	
	ПараметрыКомпоновщика = ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных);
	РаботаБезАлкоголя = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя",, АдресаПеременных);
	
	Если ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой = ""
		ИЛИ ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой = Ложь
		ИЛИ ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой = Неопределено Тогда
		
		ПараметрыПолученияМакета = Новый Структура;
		ПараметрыПолученияМакета.Вставить("РаботаБезАлкоголя", 		РаботаБезАлкоголя);
		ПараметрыПолученияМакета.Вставить("ПараметрыОнлайн", 		"");
		ПараметрыПолученияМакета.Вставить("ЯзыкПлатформыMS", 		ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных));
		ПараметрыПолученияМакета.Вставить("СтруктураМетаданных", 	КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных));
			
		СхемаСКД = ГлЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников("СпрЯчейки", ПараметрыКомпоновщика,
			ПараметрыПолученияМакета, ПараметрыВыгрузки, АдресаПеременных);
			
		Если СхемаСКД = Неопределено Тогда
			пСообщение = НСтр("ru = 'Не удалось получить макет СКД СпрЯчейки'");
			Возврат Новый Структура("Статус,Сообщение", Ложь, пСообщение);
		КонецЕсли;
		
		КомпоновщикСКД = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикСКД.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаСКД));
		КомпоновщикСКД.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
		НастройкиКомпоновщика = КомпоновщикСКД.ПолучитьНастройки();
	Иначе
		НастройкиКомпоновщика = ГлЯдро_ЗначениеИзСтрокиXML(ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой);
	КонецЕсли;
	
	ЭлементОтбора 					= НастройкиКомпоновщика.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ИдТовара_GUID");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение 	= ДанныеСпрЯчейки.ИдТовара_GUID;
	ЭлементОтбора.Использование 	= Истина;
	
	Если НЕ ДанныеСпрЯчейки.ОднаСпрЯчейка Тогда
		ЭлементОтбора 					= НастройкиКомпоновщика.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ИдСклада_GUID");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= ДанныеСпрЯчейки.ИдСклада_GUID;
		ЭлементОтбора.Использование 	= Истина;

		ЭлементОтбора 					= НастройкиКомпоновщика.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ИдЯчейки_GUID");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= ДанныеСпрЯчейки.ИдЯчейки_GUID;
		ЭлементОтбора.Использование 	= Истина;
	КонецЕсли;
	
	ПараметрыВыгрузки.ОчищатьПередВыгрузкой = Ложь;
	
	Результат = ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS("СпрЯчейки", НастройкиКомпоновщика, ПараметрыКомпоновщика, "Основная", Ложь, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_УдалитьНоменклатуруИзЯчейкиСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УдалитьНоменклатуруИзЯчейкиСправочно";
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Если ИнтеграционнаяОбработка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбновитьВыгруженныйСправочник <> Истина Тогда
		Возврат ИнтеграционнаяОбработка.УдалитьНоменклатуруИзЯчейкиСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, Ложь);
	КонецЕсли;
	
	Попытка
		ДанныеСпрЯчейки = ИнтеграционнаяОбработка.ПолучитьДанныеСпрЯчейкиSMARTS(ИмяЯчейки, ИдТовара, ИдСклада1С);
	Исключение
		ДанныеСпрЯчейки = Неопределено;
	КонецПопытки;
	
	Если ДанныеСпрЯчейки = Неопределено Тогда
		ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
		ОбновитьВыгруженныйСправочник = ВерсияAPI = 1;
		Возврат ИнтеграционнаяОбработка.УдалитьНоменклатуруИзЯчейкиСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, ОбновитьВыгруженныйСправочник);
	КонецЕсли;
	
	Результат = ИнтеграционнаяОбработка.УдалитьНоменклатуруИзЯчейкиСправочно(ИмяЯчейки, ИдТовара, ИдСклада1С, Ложь);
	
	Если Результат = Истина Тогда
		Результат = ГлЯдро_УдалитьСпрЯчейкуSMARTS(ДанныеСпрЯчейки, АдресаПеременных);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаляет строку справочного размещения из таблицы SMARTS.
//
// Параметры:
// 	ДанныеСпрЯчейки - Структура - данные ключевых полей строки и признак одной строки на товар.
// 	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
// 	Булево - Истина, если строка удалена или отсутствует.
Функция ГлЯдро_УдалитьСпрЯчейкуSMARTS(ДанныеСпрЯчейки, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УдалитьСпрЯчейкуSMARTS";
	ИдТовараSMARTS = СтрЗаменить(Строка(ДанныеСпрЯчейки.ИдТовара), "'", "''");
	Фильтр = "idTovara eq '" + ИдТовараSMARTS + "'";
	
	Если НЕ ДанныеСпрЯчейки.ОднаСпрЯчейка Тогда
		ИдСкладаSMARTS 	= СтрЗаменить(Строка(ДанныеСпрЯчейки.ИдСклада), "'", "''");
		ИдЯчейкиSMARTS 	= СтрЗаменить(Строка(ДанныеСпрЯчейки.ИдЯчейки), "'", "''");
		Фильтр 			= "idSklada eq '" + ИдСкладаSMARTS + "' and " + Фильтр + " and idYachejki eq '" + ИдЯчейкиSMARTS + "'";
	КонецЕсли;
	
	ИмяТаблицы = ГлЯдро_СтрокуВТранслитENG("СпрЯчейки");
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS", АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 			"GET");
	СтруктураЗапроса.Вставить("Метод", 				"Tables/" + ИмяТаблицы + "?$filter=" + Фильтр);
	СтруктураЗапроса.Вставить("ВернутьСтруктуру", 	Истина);
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		Возврат Ложь;
	КонецЕсли;
	
	СтрокиСпрЯчейки = ЗначениеСвойства(СтруктураОтвета.ОтветСервера, "value");
	Результат = ТипЗнч(СтрокиСпрЯчейки) = Тип("Массив");
	
	Если Результат И СтрокиСпрЯчейки.Количество() > 0 Тогда
		ИдСтроки = ЗначениеСвойства(СтрокиСпрЯчейки[0], "uid");
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", "DELETE");
		СтруктураЗапроса.Вставить("Метод", "Tables/" + ИмяТаблицы + "('" + ИдСтроки + "')");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		Результат = REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния);
		
		Если НЕ Результат Тогда
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ГлобальныйКонтекст_СправочникиИТаблицы_ДополнительноДляНоменклатуры

// Возвращает номенклатуру, не помеченную на удаление и не являющуюся группой
//
// Параметры:
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Массив из СправочникСсылка.Номенклатура
Функция ГлЯдро_ПолучитьМассивСсылокНоменклатуры(АдресаПеременных) Экспорт

	МетаданныеНСИ 				= Конф_ПолучитьМетаданныеНСИ(АдресаПеременных);	
	ИмяСправочникаНоменклатура 	= МетаданныеНСИ.Номенклатура.ИмяСправочника;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Номенклатура.Ссылка
	                      |ИЗ
	                      |	Справочник." + ИмяСправочникаНоменклатура + " КАК Номенклатура
	                      |ГДЕ
	                      |	НЕ Номенклатура.ПометкаУдаления
						  |	И НЕ Номенклатура.ЭтоГруппа     
						  |");
	
	МассивСсылокНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");			
	
	Возврат МассивСсылокНоменклатуры;

КонецФункции

// Возвращает индекс колонки "Product.Id" в массиве имен колонок таблицы, выгружаемой на сервер Клеверенс
//
// Параметры:
//	МассивИмен - Массив из Строка - содержит имена колонок таблицы
//
// Возвращаемое значение:
//	Число - индекс колонки "Product.Id" в массиве имен колонок таблицы
Функция ГлЯдро_НайтиИндексИдТовараВМассивеИмен(МассивИмен) Экспорт		
	
	ИндексКолонкиСТоваром = 0;	
	// воспользоваться методом "Найти()" не получится,
	// т.к. в этом методе строки чувствительны к регистру,
	// поэтому используем прямой перебор всех элементов массива
	Для каждого Элемент Из МассивИмен Цикл		
		Если ВРег(СокрЛП(Элемент)) = ВРег(СокрЛП("InventoryItem.Id"))
			ИЛИ ВРег(СокрЛП(Элемент)) = ВРег(СокрЛП("Product.Id")) Тогда
			Возврат ИндексКолонкиСТоваром;			
		КонецЕсли;			
		ИндексКолонкиСТоваром = ИндексКолонкиСТоваром + 1;
	КонецЦикла; 
		
	Возврат -1;				
	
КонецФункции

Процедура ГлЯдро_УстановитьПараметрыСКДДляНоменклатуры(КомпоновщикСКД, ПараметрыОнлайн, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УстановитьПараметрыСКДДляНоменклатуры";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"КомпоновщикСКД,ПараметрыОнлайн",
		КомпоновщикСКД, ПараметрыОнлайн);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
	ИмяСправочникаНоменклатуры = МетаданныеНСИ.Номенклатура.ИмяСправочника;
	ИмяСправочникаЕИ = МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника;
	
	Если МетаданныеНСИ.Номенклатура.Свойство("БазоваяЕдиницаИзмерения") Тогда
		МассивЕИ = Новый Массив;
		МассивЕИ.Добавить(ИмяСправочникаЕИ);
		МассивЕИ.Добавить(МетаданныеНСИ.Номенклатура.БазоваяЕдиницаИзмерения.ИмяСправочника);
		ИмяСправочникаЕИ = МассивЕИ;
	КонецЕсли;	
	
	ИспользоватьХарактеристикиНоменклатуры 	= Конф_ИспользоватьХарактеристикиНоменклатуры(АдресаПеременных);
	РежимЗапроса 							= "";
    ПараметрНоменклатуры 					= Новый Массив;
    ПараметрУпаковки 						= Новый Массив;
    СтрокаПоиска 							= "%%";
    ЧислоПоиска 							= -1;
    ЭтоВесовойТовар 						= Ложь;
	
	Если ЗначениеЗаполнено(ПараметрыОнлайн) Тогда
	    РежимЗапроса = ПараметрыОнлайн.Режим;
		Если ПараметрыОнлайн.Режим = "ПоискПоАртикулуКодуШК" Тогда
			ЭтоВесовойТовар 	= ПараметрыОнлайн.СтруктураШтрихкода.ЭтоВесовойТовар;
			ЧислоПоиска 		= ПараметрыОнлайн.СтруктураШтрихкода.КодЧисло;
			СтрокаПоиска 		= ПараметрыОнлайн.СтруктураШтрихкода.КодСтрока;
		ИначеЕсли ПараметрыОнлайн.Режим = "ПоискПоНоменклатуреУпаковке" Тогда
			МассивНоменклатур = Новый Массив;
			МассивУпаковок = Новый Массив;
			СсылкаНоменклатуры = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаНоменклатуры, ПараметрыОнлайн.ПараметрНоменклатуры);
			Если ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
				МассивНоменклатур.Добавить(СсылкаНоменклатуры);
				СтрокаУпаковки = ПараметрыОнлайн.ПараметрУпаковки;
				Если СтрокаУпаковки = "шт" Тогда
					МассивУпаковок.Добавить(ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(СсылкаНоменклатуры,АдресаПеременных));	
				Иначе
					СсылкаУпаковки = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаЕИ, СтрокаУпаковки);
					Если ЗначениеЗаполнено(СсылкаУпаковки) Тогда
						МассивУпаковок.Добавить(СсылкаУпаковки);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ПараметрНоменклатуры 	= МассивНоменклатур;
			ПараметрУпаковки 		= МассивУпаковок;
		ИначеЕсли ПараметрыОнлайн.Режим = "ПоискПоМассивамНоменклатурыУпаковки" Тогда
			МассивНоменклатур = Новый Массив;
			МассивУпаковок = Новый Массив;
			Если ТипЗнч(ПараметрыОнлайн.ПараметрНоменклатуры) = Тип("COMSafeArray") Тогда
				ПараметрНоменклатуры = ПараметрыОнлайн.ПараметрНоменклатуры.Выгрузить();
			ИначеЕсли ТипЗнч(ПараметрыОнлайн.ПараметрНоменклатуры) = Тип("Соответствие") Тогда 
				ПараметрНоменклатуры = ПараметрыОнлайн.ПараметрНоменклатуры.Получить("$values");
			Иначе
				ПараметрНоменклатуры = ПараметрыОнлайн.ПараметрНоменклатуры;
			КонецЕсли;
			Если ТипЗнч(ПараметрыОнлайн.ПараметрУпаковки) = Тип("COMSafeArray") Тогда
				ПараметрУпаковки = ПараметрыОнлайн.ПараметрУпаковки.Выгрузить();
			ИначеЕсли ТипЗнч(ПараметрыОнлайн.ПараметрУпаковки) = Тип("Соответствие") Тогда 
				ПараметрУпаковки = ПараметрыОнлайн.ПараметрУпаковки.Получить("$values");
			Иначе
				ПараметрУпаковки = ПараметрыОнлайн.ПараметрУпаковки;
			КонецЕсли;			
			Для Индекс = 0 По ПараметрНоменклатуры.ВГраница() Цикл
				СтрокаНоменклатуры = ПараметрНоменклатуры[Индекс];
				СсылкаНоменклатуры = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаНоменклатуры, СтрокаНоменклатуры);
				Если ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
					МассивНоменклатур.Добавить(СсылкаНоменклатуры);
					СтрокаУпаковки = ПараметрУпаковки[Индекс];
					Если СтрокаУпаковки = "шт" Тогда
						МассивУпаковок.Добавить(ГлЯдро_ПолучитьЕдиницуИзмеренияПоУмолчанию(СсылкаНоменклатуры,АдресаПеременных));	
					Иначе
						СсылкаУпаковки = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаЕИ, СтрокаУпаковки);
						Если ЗначениеЗаполнено(СсылкаУпаковки) Тогда
							МассивУпаковок.Добавить(СсылкаУпаковки);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ПараметрНоменклатуры 	= МассивНоменклатур;
			ПараметрУпаковки 		= МассивУпаковок;
		ИначеЕсли ПараметрыОнлайн.Режим = "ПоискПоЧастиНаименования" Тогда
			СтрокаПоиска = "%" + ПараметрыОнлайн.ПараметрНоменклатуры + "%";
			
			Попытка
				ЧислоПоиска = Число(ПараметрыОнлайн.ПараметрНоменклатуры);
			Исключение
				ЧислоПоиска = -1;
			КонецПопытки;
		Иначе
			МассивНоменклатур = Новый Массив;
			Если ПараметрыОнлайн.Свойство("СсылкаНоменклатуры") Тогда
				СсылкаНоменклатуры = ПараметрыОнлайн.СсылкаНоменклатуры;
			Иначе
				СсылкаНоменклатуры = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаНоменклатуры, ПараметрыОнлайн.ПараметрНоменклатуры);
			КонецЕсли;
			МассивНоменклатур.Добавить(СсылкаНоменклатуры);
			ПараметрНоменклатуры = МассивНоменклатур;
			Если ПараметрыОнлайн.Режим = "СписокНоменклатуры"
				Или ПараметрыОнлайн.Режим = "СписокНоменклатурыДляГрупп"
				Или ПараметрыОнлайн.Режим = "СписокУпаковокДляНоменклатуры" Тогда
				Если СсылкаНоменклатуры.ЭтоГруппа ИЛИ НЕ ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда // если заходим в корень справочника, то родитель будет пустой ссылкой
					РежимЗапроса = "СписокНоменклатурыДляГрупп";
					// Если в СКД настроен отбор по номенклатуре, то необходимо его добавить в "ПараметрНоменклатуры", 
					// т.к. иначе отборы пересекаются при компоновке макета и выводится всегда пустой список
					Если НЕ ЗначениеЗаполнено(СсылкаНоменклатуры) И ЗначениеЗаполнено(МетаданныеНСИ.Номенклатура) Тогда
						ПроверяемыйТип = "СправочникСсылка." + МетаданныеНСИ.Номенклатура.ИмяСправочника;                        						
						Для Каждого ЭлементОтбора Из КомпоновщикСКД.Настройки.Отбор.Элементы Цикл
							Если Не ЭлементОтбора.Использование Тогда
								Продолжить;
							КонецЕсли;      
							
							Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии 
								Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
								Для Каждого ЭлементПравогоЗначения Из ЭлементОтбора.ПравоеЗначение Цикл
									Если ТипЗнч(ЭлементПравогоЗначения.Значение) = Тип(ПроверяемыйТип) Тогда
										ПараметрНоменклатуры.Добавить(ЭлементПравогоЗначения.Значение);         				
									КонецЕсли;	
								КонецЦикла;
							ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии 
								Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда							
								Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип(ПроверяемыйТип) Тогда
									ПараметрНоменклатуры.Добавить(ЭлементОтбора.ПравоеЗначение);         				
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;					
				Иначе
				    РежимЗапроса = "СписокУпаковокДляНоменклатуры";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
	
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ИспользоватьХарактеристикиНоменклатуры", ИспользоватьХарактеристикиНоменклатуры, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "РежимЗапроса", РежимЗапроса, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ПараметрНоменклатуры", ПараметрНоменклатуры, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ПараметрУпаковки", ПараметрУпаковки, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "СтрокаПоиска", СтрокаПоиска, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ЧислоПоиска", ЧислоПоиска, АдресаПеременных);
	ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ЭтоВесовойТовар", ЭтоВесовойТовар, АдресаПеременных);	
	
	ГлЯдро_ОбработатьПараметрыСКД("Номенклатура", ПараметрыОнлайн, КомпоновщикСКД, АдресаПеременных);
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ГлобальныйКонтекст_СправочникиИТаблицы_ДополнительноДляОстальныхТаблиц

Процедура ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблиц(ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, МетаданныеНСИ,
	ПараметрыДанных = Неопределено, КомпоновщикСКД, СоответствиеПолей, ВерхнийУровень = Истина, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблиц";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ПараметрыОнлайн,ЭлементыОтбора,МетаданныеНСИ,ПараметрыДанных,КомпоновщикСКД,СоответствиеПолей,ВерхнийУровень",
		ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, МетаданныеНСИ, ПараметрыДанных, КомпоновщикСКД, СоответствиеПолей, ВерхнийУровень);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ПараметрыОнлайн.IsGroup Тогда
		ТипГруппы = ГлЯдро_ПолучитьТипГруппыОтбораПоСтроке(ПараметрыОнлайн.GroupTypeStr);
		
		// Элементы отбора верхнего уровня группировать в группу И не имеет смысла
		ГруппироватьЭлементыОтбора = НЕ (ВерхнийУровень И ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
			
		Если ГруппироватьЭлементыОтбора Тогда
			ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЭлементОтбора.ТипГруппы = ТипГруппы;
		КонецЕсли;
		
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		
		Для Индекс = 0 По ПараметрыОнлайн.Elements.Count() - 1 Цикл
			Если ТипИнтерфейса = "REST_API" Тогда
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Получить(Индекс);
			Иначе
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Item(Индекс);
			КонецЕсли;
				
			Если ГруппироватьЭлементыОтбора Тогда
				ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблиц(ИмяТаблицы, ПодчиненныеПараметрыОнлайн, ЭлементОтбора.Элементы, МетаданныеНСИ, ПараметрыДанных, КомпоновщикСКД, СоответствиеПолей, Ложь, АдресаПеременных);
			Иначе
				ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблиц(ИмяТаблицы, ПодчиненныеПараметрыОнлайн, ЭлементыОтбора, МетаданныеНСИ, ПараметрыДанных, КомпоновщикСКД, СоответствиеПолей, Ложь, АдресаПеременных);	
			КонецЕсли;
		КонецЦикла;		
	Иначе
		// Если заходим в корень справочника, то родитель будет пустой ссылкой, но если есть отбор из СКД, то параметр из онлайна не надо включать
		ОтборРодителяСКД = Ложь;
		Если ИмяТаблицы = "Склады" Тогда
			Для Каждого пОтбор Из ЭлементыОтбора Цикл  
				ПостфиксИмениПоля = "_GUID";
				
				ОтборПоИдРодителя = ПараметрыОнлайн.LeftValue = "ИдРодителя"
					ИЛИ ПараметрыОнлайн.LeftValue = "ParentId";
				Если (ОтборПоИдРодителя)
					И (Строка(пОтбор.ЛевоеЗначение) = ("ИдРодителя" + ПостфиксИмениПоля + "_ДляОтбора"))
					И (Не ЗначениеЗаполнено(ПараметрыОнлайн.RightValue)) Тогда				
					ЭлементОтбора = пОтбор;     
					ОтборРодителяСКД = Истина;  
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если Не ОтборРодителяСКД Тогда
			
			ИмяПоляMS = ПараметрыОнлайн.LeftValue;
			ИмяПоля = СоответствиеПолей.Получить(ИмяПоляMS);
			Если ИмяПоля = Неопределено Тогда
				ИмяПоля = ИмяПоляMS;
			КонецЕсли;
			
			ПостфиксИмениПоля = "";
			ДоступноеПоле = КомпоновщикСКД.Настройки.ДоступныеПоляОтбора.Элементы.Найти(ИмяПоля);
			Если ДоступноеПоле = Неопределено Тогда
				ПостфиксИмениПоля = "_GUID";
				ДоступноеПоле = КомпоновщикСКД.Настройки.ДоступныеПоляОтбора.Элементы.Найти(ИмяПоля + ПостфиксИмениПоля);
			КонецЕсли;
			
			Если ДоступноеПоле <> Неопределено Тогда 
				
				ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			    ЭлементОтбора.ВидСравнения = ГлЯдро_ПолучитьВидСравненияПоСтроке(ПараметрыОнлайн.ComparisonTypeStr);
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля + ПостфиксИмениПоля);
				
				ПараметрыОнлайнДляОтбора = Новый Структура("RightValue");
				Если ТипЗнч(ПараметрыОнлайн) = Тип("Структура")
					ИЛИ ТипЗнч(ПараметрыОнлайн) = Тип("COMОбъект") Тогда
					ЗаполнитьЗначенияСвойств(ПараметрыОнлайнДляОтбора, ПараметрыОнлайн);
				КонецЕсли;
				ПравоеУсловие = ?(ЗначениеЗаполнено(ПараметрыОнлайнДляОтбора["RightValue"]), ПараметрыОнлайнДляОтбора["RightValue"], "");
							
				ЭлементОтбора.ПравоеЗначение = ГлЯдро_ПолучитьЗначениеОбъектаИзПредставленияXML(ДоступноеПоле.ТипЗначения, ПравоеУсловие, ИмяТаблицы, МетаданныеНСИ);
				
				Если НЕ ПараметрыДанных = Неопределено Тогда
					Параметр = ПараметрыДанных.Найти(ИмяПоля);
					Если Параметр <> Неопределено Тогда
						ДоступныйПараметр = КомпоновщикСКД.Настройки.ПараметрыДанных.ДоступныеПараметры.Элементы.Найти(ИмяПоля);						
						Параметр.Значение =	ГлЯдро_ПолучитьЗначениеОбъектаИзПредставленияXML(ДоступныйПараметр.ТипЗначения, ПравоеУсловие, ИмяТаблицы, МетаданныеНСИ);
					КонецЕсли;
					
					ЗапросКТаблицеОстатки = ИмяТаблицы = "Остатки"
						ИЛИ ИмяТаблицы = "Stock";
					ЗапросКТаблицеТУ = ИмяТаблицы = "ТранспортныеУпаковки"
						ИЛИ ИмяТаблицы = "TransportUnits";
					
					// Установка параметра ДлинаМарки
					Если ЗапросКТаблицеОстатки
						И (ИмяПоля = "МаркаИСМП" ИЛИ ИмяПоля = "IdentificationCode" ИЛИ ИмяПоля = "МаркаПодстрока") Тогда
						Параметр = ПараметрыДанных.Найти("ДлинаМарки");
				        Если Параметр <> Неопределено Тогда			
							Параметр.Использование 	= Истина;
							Параметр.Значение 		= СтрДлина(ПараметрыОнлайн.RightValue);
						КонецЕсли;		
					КонецЕсли;
					
					ОтборПоРодителю = Ложь;
					
					// Установка параметра ОтборПоРодителю
					Если ЗапросКТаблицеОстатки И (ИмяПоля = "ИдТранспортнойУпаковки" 
							ИЛИ ИмяПоля = "ШтрихкодТранспортнойУпаковки"
							ИЛИ ИмяПоля = "ШтрихкодТУ"
							ИЛИ ИмяПоля = "TransportUnitId"
							ИЛИ ИмяПоля = "TransportUnitBarcode")
						ИЛИ ЗапросКТаблицеТУ И (ИмяПоля = "ИдРодителя"
							ИЛИ ИмяПоля = "ШтрихкодРодителяТУ"
							ИЛИ ИмяПоля = "ParentId") Тогда
						ОтборПоРодителю = Истина;	
							
						Параметр = ПараметрыДанных.Найти("ОтборПоРодителю");
					    Если Параметр <> Неопределено Тогда			
							Параметр.Использование 	= Истина;
							Параметр.Значение 		= Истина;
						КонецЕсли;
					КонецЕсли;
					
					ОтборПоКМ = Ложь;
					
					// Отключение параметров ВыгружатьОстаткиПоСкладам, ВыгружатьОстаткиВЯчейках и т.д.
					Если ЗапросКТаблицеОстатки Тогда
						ПоляКМ = Новый Массив;
						ПоляКМ.Добавить("Марка");
						ПоляКМ.Добавить("МаркаИСМП");
						ПоляКМ.Добавить("МаркаПодстрока");
						ПоляКМ.Добавить("ИдТранспортнойУпаковки");
						ПоляКМ.Добавить("ШтрихкодТУ");
						ПоляКМ.Добавить("MarkingCode");
						ПоляКМ.Добавить("IdentificationCode");
						ПоляКМ.Добавить("TransportUnitId");
						
						ЗапросКодаМаркировки = НЕ ПоляКМ.Найти(ИмяПоля) = Неопределено
							И ЗначениеЗаполнено(ПараметрыОнлайн.RightValue);
						Если ЗапросКодаМаркировки Тогда
							ОтборПоКМ = Истина;		
								
							КомпоновщикСКД.Настройки.ДополнительныеСвойства.Вставить("ЗапросКодаМаркировки", Истина);
						КонецЕсли;
					КонецЕсли;
					
					// Установка параметра ОтборПоРодителюИлиКМ
					Если ЗапросКТаблицеОстатки И (ОтборПоРодителю ИЛИ ОтборПоКМ) Тогда
						Параметр = ПараметрыДанных.Найти("ОтборПоРодителюИлиКМ");
					    Если Параметр <> Неопределено Тогда			
							Параметр.Использование 	= Истина;
							Параметр.Значение 		= Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли; //ДоступноеПоле <> Неопределено
		КонецЕсли;
		
		ГлЯдро_ОбработатьЭлементыОтбора(ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, ПостфиксИмениПоля, АдресаПеременных);		
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблицПроизвольнымЗапросом(ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, МетаданныеНСИ, ПараметрыДанных = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблицПроизвольнымЗапросом";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ПараметрыОнлайн,ЭлементыОтбора,МетаданныеНСИ,ПараметрыДанных",
		ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, МетаданныеНСИ, ПараметрыДанных);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ПараметрыОнлайн.IsGroup Тогда
		ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ЭлементОтбора.ТипГруппы = ГлЯдро_ПолучитьТипГруппыОтбораПоСтроке(ПараметрыОнлайн.GroupTypeStr);  
		
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		
		Для Индекс = 0 По ПараметрыОнлайн.Elements.Count() - 1 Цикл
			Если ТипИнтерфейса = "REST_API" Тогда
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Получить(Индекс);
			Иначе
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Item(Индекс);
			КонецЕсли;
			ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблицПроизвольнымЗапросом(ИмяТаблицы, ПодчиненныеПараметрыОнлайн, ЭлементОтбора.Элементы, МетаданныеНСИ, ПараметрыДанных, АдресаПеременных);
		КонецЦикла;		
	Иначе
		// Для произвольного запроса не делаем дополнительных преобразований для элементов отбора
		ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ВидСравнения 	= ГлЯдро_ПолучитьВидСравненияПоСтроке(ПараметрыОнлайн.ComparisonTypeStr);
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПараметрыОнлайн.LeftValue);
			
		ПараметрыОнлайнДляОтбора = Новый Структура("RightValue");
		Если ТипЗнч(ПараметрыОнлайн) = Тип("Структура")
			ИЛИ ТипЗнч(ПараметрыОнлайн) = Тип("COMОбъект") Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыОнлайнДляОтбора, ПараметрыОнлайн);
		КонецЕсли;
		ПравоеУсловие = ?(ЗначениеЗаполнено(ПараметрыОнлайнДляОтбора["RightValue"]), ПараметрыОнлайнДляОтбора["RightValue"], "");
					
		ЭлементОтбора.ПравоеЗначение = ПравоеУсловие;
			
		Если ПараметрыДанных <> Неопределено Тогда
			Параметр = ПараметрыДанных.Найти(ПараметрыОнлайн.LeftValue);
			Если Параметр <> Неопределено Тогда
				Параметр.Значение =	ПравоеУсловие;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_УстановитьФлагПроверкиРодителейИерархическогоСправочника(ИмяТаблицы, ПараметрыОнлайн, ПараметрыВыгрузки, АдресаПеременных)

	Если ПараметрыОнлайн = ""
		ИЛИ ПараметрыВыгрузки = Неопределено Тогда	
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОнлайн.IsGroup Тогда
		Для Индекс = 0 По ПараметрыОнлайн.Elements.Count() - 1 Цикл
			ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
			Если ТипИнтерфейса = "REST_API" Тогда
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Получить(Индекс);
			Иначе
				ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Item(Индекс);
			КонецЕсли;
			ГлЯдро_УстановитьФлагПроверкиРодителейИерархическогоСправочника(ИмяТаблицы, ПодчиненныеПараметрыОнлайн, ПараметрыВыгрузки, АдресаПеременных);
		КонецЦикла;		
	Иначе
		ЛевоеУсловие 	= "";
		ПравоеУсловие 	= "";
		Если ТипЗнч(ПараметрыОнлайн) = Тип("Структура") Тогда
			Если ПараметрыОнлайн.Свойство("LeftValue") Тогда
				ЛевоеУсловие = ПараметрыОнлайн.LeftValue;			
			КонецЕсли;			
			Если ПараметрыОнлайн.Свойство("RightValue") Тогда
				ПравоеУсловие = ПараметрыОнлайн.RightValue;
			КонецЕсли;
		КонецЕсли;
			
		Если (ЛевоеУсловие = "ИдРодителя" И ПравоеУсловие = "")
			ИЛИ (ЛевоеУсловие = "ParentId" И ПравоеУсловие = "") Тогда
			ПараметрыВыгрузки.Вставить("флПроверятьРодителей", Истина);			
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

Процедура ГлЯдро_ОбработатьЭлементыОтбора(ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, ПостфиксИмениПоля,АдресаПеременных)
	
	ИнтеграционнаяОбработка = ГлЯдро_ПолучитьИнтеграционнуюОбработку(АдресаПеременных);
		
	Попытка
		ИнтеграционнаяОбработка.ОбработатьЭлементыОтбора(ИмяТаблицы, ПараметрыОнлайн, ЭлементыОтбора, ПостфиксИмениПоля);	
	Исключение	
	КонецПопытки; 	
	
КонецПроцедуры	

Процедура ГлЯдро_ОбработатьРезультатыВыгрузкиТаблицыДополнительно(ДанныеДляОбработки, ИмяТаблицы ,АдресаПеременных)
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		Возврат;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	// в инт.обработке может не существовать данного метода
	Попытка
		ИнтеграционнаяОбработка.ОбработатьРезультатыВыгрузкиТаблицы(ДанныеДляОбработки, ИмяТаблицы, АдресаПеременных);	
	Исключение	
	КонецПопытки; 	
	
КонецПроцедуры

Функция ГлЯдро_ЧисловойКодПоСсылке(Ссылка)
	ШестнадчатиричноеЧисло = СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()),"-","");
	Возврат ГлЯдро_ПреобразоватьИзШестнадцатиричнойСистемыСчисленияВДесятичноеЧисло(ШестнадчатиричноеЧисло);
КонецФункции

Функция ГлЯдро_ПреобразоватьИзШестнадцатиричнойСистемыСчисленияВДесятичноеЧисло(Знач Значение)
	
	Значение = НРег(Значение);
	ДлинаСтроки = СтрДлина(Значение);
	
	Результат = 0;
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		Результат = Результат * 16 + Найти("0123456789abcdef", Сред(Значение, НомерСимвола, 1)) - 1;
	КонецЦикла;
	
	Возврат Формат(Результат, "ЧГ=0");
	
КонецФункции

Процедура ГлЯдро_ОбработатьПараметрыСКД(ИмяТаблицы, ПараметрыОнлайн, КомпоновщикСКД, АдресаПеременных)
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		Возврат;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	// в инт.обработке может не существовать данного метода
	Попытка
		ИнтеграционнаяОбработка.ОбработатьПараметрыСКД(ИмяТаблицы, ПараметрыОнлайн, КомпоновщикСКД);	
	Исключение	
	КонецПопытки; 	
	
КонецПроцедуры

// Вызывает функцию получения соответствия имён таблиц MS и параметров порционной выгрузки
//
// Параметры:
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Соответствие - содержит имена таблиц MS и параметры порционной выгрузки
Функция ГлЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СоответствиеПараметров = Новый Соответствие;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеПараметров);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СоответствиеПараметров;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Попытка
		СоответствиеПараметров = ИнтеграционнаяОбработка.Конф_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки();
	Исключение
		КомментарийЖР = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", КомментарийЖР,, АдресаПеременных);
	КонецПопытки;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеПараметров);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СоответствиеПараметров;
	
КонецФункции

// Находит параметры порционной выгрузки для таблицы.
// 
// Параметры:
//	СправочникИмя - Строка - Имя выгружаемой таблицы SMARTS
//	СоответствиеПараметровПорционнойВыгрузки - Соответствие - Соответствие параметров, в которой идёт поиск
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Соответствие - содержит имена таблиц MS и параметры порционной выгрузки
Функция ГлЯдро_НайтиПараметрыСправочникаДляПорционнойВыгрузки(СправочникИмя, СоответствиеПараметровПорционнойВыгрузки = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_НайтиПараметрыСправочникаДляПорционнойВыгрузки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СправочникИмя,СоответствиеПараметровПорционнойВыгрузки",
		СправочникИмя, СоответствиеПараметровПорционнойВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если СоответствиеПараметровПорционнойВыгрузки = Неопределено Тогда
		СоответствиеПараметровПорционнойВыгрузки = ГлЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки(АдресаПеременных);
	КонецЕсли;
	
	// Стандартные параметры для номенклатуры, если они не заданы в ИО
	МетаданныеНСИ 				= Конф_ПолучитьМетаданныеНСИ(АдресаПеременных);	
	ИмяСправочникаНоменклатура 	= МетаданныеНСИ.Номенклатура.ИмяСправочника;
	
	ИменаСправочников = Новый Массив();
	ИменаСправочников.Добавить(ИмяСправочникаНоменклатура);
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("ИменаСправочников", ИменаСправочников);
	ПараметрыНоменклатуры.Вставить("ПолеНаложенияОтбора", "Product_Id_GUID");
	// ---
	
	ПараметрыПорционнойВыгрузки = СоответствиеПараметровПорционнойВыгрузки.Получить(СправочникИмя);
	Если ПараметрыПорционнойВыгрузки = Неопределено И НЕ СправочникИмя = "Номенклатура" Тогда
		
		Если ТипЗнч(АдресаПеременных.СтруктураМетаданных) = Тип("Строка") Тогда
			МетаданныеТаблицSMARTS = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных)
		Иначе
			МетаданныеТаблицSMARTS = АдресаПеременных.СтруктураМетаданных.Tables;
		КонецЕсли;
		
		ПоляТаблицыSMARTS = Новый Массив;
		Для каждого Элемент Из МетаданныеТаблицSMARTS Цикл
			Если Элемент.Представление = СправочникИмя Тогда
				ПоляТаблицыSMARTS = Элемент.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// Если в таблице есть поле "ИдТовара", то отбор накладывается на поле "ИдТовара_GUID"
		// Например для: цены, остатки, дополнительные реквизиты
		Если ПоляТаблицыSMARTS.Количество() И ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПоляТаблицыSMARTS, "Значение", "ИдТовара") <> Неопределено Тогда
			ПараметрыНоменклатуры.ПолеНаложенияОтбора = "ИдТовара_GUID";
			ПараметрыПорционнойВыгрузки = ПараметрыНоменклатуры;
		Иначе	
			КомментарийЖР = НСтр("ru = 'Для таблицы SMARTS: %1, не заданы параметры порционной выгрузки. Справочник будет выгружен в обычном режиме. Заполнение параметров в интеграционной обработке ""%2"". '");
			КомментарийЖР = ГлЯдро_СтрШаблон(КомментарийЖР, Строка(СправочникИмя), "Конф_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки()");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", КомментарийЖР,, АдресаПеременных);
		КонецЕсли;
		
	ИначеЕсли ПараметрыПорционнойВыгрузки = Неопределено И СправочникИмя = "Номенклатура" Тогда
		ПараметрыПорционнойВыгрузки = ПараметрыНоменклатуры;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ПараметрыПорционнойВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ПараметрыПорционнойВыгрузки;
	
КонецФункции

// Получает все ссылки из массива справочников, для наложения отбора в порционной выгрузке
// 
// Параметры:
//	ИменаСправочников - Массив - Имена справочников
//	ИсключитьГруппы - Булево - Исключить группы из выборки или нет
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Массив - Массив ссылок из всех справочников
Функция ГлЯдро_ПолучитьМассивСсылокСправочников(ИменаСправочников, ИсключитьГруппы = Ложь, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьМассивСсылокСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИменаСправочников,ИсключитьГруппы",
		ИменаСправочников, ИсключитьГруппы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Событие = "ГлЯдро_ПолучитьМассивСсылокСправочников";
	
	Шаблон = 
		"ВЫБРАТЬ
		|	спТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК спТаблица
		|ГДЕ
		|	НЕ спТаблица.ПометкаУдаления
		|	%2";
	
	МассивОбъединения = Новый Массив();
	Для каждого ИмяСправочника Из ИменаСправочников Цикл
		
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не найден справочник: %1';
								|en = 'The reference book was not found: %1'; be = 'Не знойдзены даведнік: %1'; es = 'Referencia no encontrada: %1'; ka = 'საცნობარო წიგნი ვერ მოიძებნა: %1'; kk = 'Анықтама табылмады: %1'; ro = 'Cartea de referință nu a fost găsită: %1'; tr = 'Dizin bulunamadı: %1'; uk = 'Не знайдено довідника: %1'; uz = 'Ma''lumotnoma topilmadi: %1'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяСправочника);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ИмяСправочника",
				ИмяСправочника);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			// </Лог>
			Продолжить;
		КонецЕсли;
		
		ОтборГрупп = "";
		Если ИсключитьГруппы Тогда
			Попытка
				Если Метаданные.Справочники[ИмяСправочника].Иерархический
					И Строка(Метаданные.Справочники[ИмяСправочника].ВидИерархии) = "ИерархияГруппИЭлементов" Тогда
					ОтборГрупп = "И НЕ спТаблица.ЭтоГруппа";
				КонецЕсли;
			Исключение
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Ошибка получения метаданных справочника: %1';
									|en = 'Error getting directory metadata: %1'; be = 'Памылка атрымання метададзеных даведніка: %1'; es = 'Error al recuperar metadatos de referencia: %1'; ka = 'შეცდომა მიღების დირექტორია მეტამონაცემები: %1'; kk = 'Анықтамалық метадеректерді алу қатесі: %1'; ro = 'Eroare la obținerea metadatelor directorului: %1'; tr = 'Dizin meta verilerini alma hatası: %1'; uk = 'Помилка отримання метаданих довідника: %1'; uz = 'Katalog metama''lumotlarini olishda xato: %1'";
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяСправочника);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ИмяСправочника",
					ИмяСправочника);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		МассивОбъединения.Добавить(ГлЯдро_СтрШаблон(Шаблон, ИмяСправочника, ОтборГрупп));
		
	КонецЦикла;

	Если МассивОбъединения.Количество() = 0 Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый Массив);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ГлЯдро_СтрСоединить(МассивОбъединения, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	МассивСсылок = РезультатЗапроса.ВыгрузитьКолонку("Ссылка");
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивСсылок);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивСсылок;
	
КонецФункции

Функция ГлЯдро_ОпределитьСпособВыгрузкиСправочника(ПараметрыСпособаВыгрузки, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОпределитьСпособВыгрузкиСправочника";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыСпособаВыгрузки",
		ПараметрыСпособаВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СправочникИмя = ПараметрыСпособаВыгрузки.СправочникИмя;
	ПараметрыВыгрузки = ПараметрыСпособаВыгрузки.ПараметрыВыгрузки;
	СоответствиеПараметровПорционнойВыгрузки = ПараметрыСпособаВыгрузки.СоответствиеПараметровПорционнойВыгрузки;
	МетаданныеНСИ = ПараметрыСпособаВыгрузки.МетаданныеНСИ;
	
	РазмерПорции = Неопределено;
	Если ПараметрыВыгрузки.Свойство("РазмерПорции") Тогда
		РазмерПорции = ПараметрыВыгрузки.РазмерПорции;
	КонецЕсли;
	
	Если СправочникИмя = "Номенклатура" И РазмерПорции = Неопределено Тогда
		Если ПараметрыВыгрузки.Свойство("РазмерПорцииНоменклатуры") Тогда
			РазмерПорции = ПараметрыВыгрузки.РазмерПорцииНоменклатуры;
		Иначе
			РазмерПорции = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("РазмерПорцииНоменклатуры",, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	РазмерПорции = ?(РазмерПорции = Ложь, 0, РазмерПорции);
	ПараметрыПорционнойВыгрузки = Неопределено;
	Если РазмерПорции <> Неопределено И ЗначениеЗаполнено(РазмерПорции) Тогда
		ПараметрыПорционнойВыгрузки = ГлЯдро_НайтиПараметрыСправочникаДляПорционнойВыгрузки(СправочникИмя, СоответствиеПараметровПорционнойВыгрузки, АдресаПеременных);				
	КонецЕсли;
	
	ВыгрузитьСправочник = Истина;
	Если СправочникИмя = "Характеристики" или СправочникИмя = "Attributes" Тогда
		
		Если МетаданныеНСИ = Неопределено Тогда
			 МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
		КонецЕсли;
		
		ВыгрузитьСправочник = МетаданныеНСИ.Характеристики.Использование;	
	КонецЕсли;
	
	Если ПараметрыПорционнойВыгрузки <> Неопределено Тогда
		ПараметрыПорционнойВыгрузки.Вставить("РазмерПорции", РазмерПорции);
	КонецЕсли;
	
	Результат = Новый Структура("РазмерПорции, ПараметрыПорционнойВыгрузки, ВыгрузитьСправочник", РазмерПорции, ПараметрыПорционнойВыгрузки, ВыгрузитьСправочник);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Вызывает в интеграционной обработке функцию получения списка имен справочников, участвующих в интеграции с Клеверенс
//
// Параметры:
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	СписокЗначений - содержит имена справочников в базе 1С, участвующих в интеграции с Клеверенс
Функция ГлЯдро_ПолучитьСписокИспользуемыхСправочников(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьСписокИспользуемыхСправочников";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СписокИспользуемыхСправочников = Новый СписокЗначений;
	
	ИнтеграционнаяОбработка = ГлЯдро_ПолучитьИнтеграционнуюОбработку(АдресаПеременных);
	Если ИнтеграционнаяОбработка <> Неопределено Тогда
		Попытка
			СписокИспользуемыхСправочников = ИнтеграционнаяОбработка.Конф_ПолучитьСписокИспользуемыхСправочников();
		Исключение
			ТекстОшибки = НСтр("ru = 'Не удалось получить список используемых справочников: %1'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьСписокИспользуемыхСправочников", "Предупреждение", ТекстОшибки, , АдресаПеременных);
		КонецПопытки;
	КонецЕсли;
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокИспользуемыхСправочников);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СписокИспользуемыхСправочников;
	
КонецФункции

// Получает настройки отборов справочников по режимам обмена. Режимы обмена: Онлайн, Интерактивный, Автообмен
Функция ГлЯдро_ПолучитьНастройкиОтборовСправочников(ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьНастройкиОтборовСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Узла,ДополнительныеПараметры",
		ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СериализуемыеНастройки = Новый Массив;
	ЭтоЧастнаяБаза = Ложь;
	
	НастройкиПолучены = Ложь;
	Если НЕ ПустаяСтрока(ID_Узла) Тогда
		
		Отбор = Новый Структура("ID_Узла", ID_Узла);
		ИспользоватьЧастнуюБазу = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("Узлы", Отбор, "ИспользоватьЧастнуюБазу",, АдресаПеременных);
		ЭтоЧастнаяБаза = ИспользоватьЧастнуюБазу = Истина;
		
		// Если частная база, то получаем узловое значение
		// Если узел не частная база, то получаем значения главного узла для Интерактивный и Автообмен
		Если НЕ ЭтоЧастнаяБаза Тогда
			
			// В онлайне есть узловые настройки для всех ТО
			НастройкиОтборовСправочников_Онлайн = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовСправочников_Онлайн", ID_Узла,, АдресаПеременных);
			
			// В интерактивном и регламентном режиме узловые настройки доступны только для частных баз
			//	поэтому получаем общую настройку главного узла
			
			НастройкиКПолучению = Новый Структура;
			НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Интерактивный");
			НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Автообмен");
			
			ЗначенияНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,,,, АдресаПеременных);
			ЗначенияНастроек.Вставить("НастройкиОтборовСправочников_Онлайн", НастройкиОтборовСправочников_Онлайн);
			
			НастройкиПолучены = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Получаем узловые значения
	НастройкиКПолучению = Новый Структура;
	Если НЕ НастройкиПолучены Тогда
		
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Онлайн");
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Интерактивный");
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Автообмен");
		
		ЗначенияНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,, ID_Узла,, АдресаПеременных);
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ID_Узла) Тогда
		
		НастройкиКПолучению = Новый Структура;
		
		// Проверяем заполнение узловых настроек
		Если ЭтоЧастнаяБаза Тогда
			
			Для каждого КлючЗначение Из ЗначенияНастроек Цикл	
				Если КлючЗначение.Значение = Ложь
						ИЛИ НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					НастройкиКПолучению.Вставить(КлючЗначение.Ключ);
				КонецЕсли;	
			КонецЦикла;
			
		Иначе
			Если ЗначенияНастроек.НастройкиОтборовСправочников_Онлайн = Ложь
					ИЛИ НЕ ЗначениеЗаполнено(ЗначенияНастроек.НастройкиОтборовСправочников_Онлайн) Тогда
				НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Онлайн");
			КонецЕсли;
		КонецЕсли;
		
		// Если узловое значение не заполнено, то получаем значение главного узла
		Если НастройкиКПолучению.Количество() Тогда
			
			пЗначенияНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,,,, АдресаПеременных);
			
			Для каждого КлючЗначение Из пЗначенияНастроек Цикл	
				ЗначенияНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначенияНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ЗначенияНастроек;
	
КонецФункции

// Получает и заполняет структуру параметров выгрузки справочника
//
// Параметры:
//  ИмяТаблицы  - Строка - имя таблицы, для которой необходимо получить сохраненное имя макета ИО
//	РежимОбмена - Строка - Онлайн, Интерактивный, Автообмен
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//   Структура   - см. ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников()
//
Функция ГлЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника(ИмяТаблицы, РежимОбмена, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,РежимОбмена",
		ИмяТаблицы, РежимОбмена);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
	#КонецЕсли
	
	Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	СтрокаНастройкиОбмена 	= ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор,, Истина, АдресаПеременных);
	СтрокаНастройкиОтборов 	= ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, Отбор,, Истина, АдресаПеременных);
	
	ПараметрыВыгрузки = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
	
	Если СтрокаНастройкиОбмена <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, СтрокаНастройкиОбмена);
	КонецЕсли;
	Если СтрокаНастройкиОтборов <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, СтрокаНастройкиОтборов);
	КонецЕсли;
	
	ПараметрыВыгрузки.ИмяТаблицы = ИмяТаблицы;
			
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ПараметрыВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ПараметрыВыгрузки;

КонецФункции

// Объединяет основные настройки обмена спарвочников с настройками отборов по режимам
//
// Параметры:
//  РежимОбмена				 - 	Строка - Онлайн, Интерактивный, Автообмен
// 
// Возвращаемое значение:
//   - Массив
//
Функция ГлЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима(РежимОбмена, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ID_Узла,ДополнительныеПараметры",
		РежимОбмена, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
	#КонецЕсли
	
	НастройкиОбменаСправочников = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников",,АдресаПеременных);
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	
	Если ID_Узла = ДанныеТекущегоУзла.ID_Узла Тогда
		НастройкиОтборовСправочников = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовСправочников_" + РежимОбмена,,АдресаПеременных);
	Иначе
		НастройкиОтборовСправочников = ГлЯдро_ПолучитьНастройкиОтборовСправочников(ID_Узла,, АдресаПеременных);
		НастройкиОтборовСправочников = НастройкиОтборовСправочников["НастройкиОтборовСправочников_" + РежимОбмена];
	КонецЕсли;
	
	НастройкиОтборовСправочников = ?(ТипЗнч(НастройкиОтборовСправочников) = Тип("Массив"), НастройкиОтборовСправочников, Неопределено);
	
	СобранныеНастройки = Новый Массив;
	
	Если ТипЗнч(НастройкиОбменаСправочников) = Тип("Массив") Тогда
		
		СтруктураСтроки = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
		СобранныеНастройки.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтруктураСтроки));
		
		КлючУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек("НастройкиОбменаСправочников");
		
		Для каждого СтрокаНастройкиОбмена Из НастройкиОбменаСправочников Цикл
			Если СтрокаНастройкиОбмена.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройкиОбмена.ЭтоТаблицаЗначений Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройкиОбмена);
			
			Если НастройкиОтборовСправочников <> Неопределено Тогда
				
				Отбор = Новый Структура(КлючУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаНастройкиОбмена);
				СтрокаНастройкиОтборов = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборовСправочников, Отбор, Истина);
				Если СтрокаНастройкиОтборов <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройкиОтборов);
				КонецЕсли;
				
			КонецЕсли;
			
			СобранныеНастройки.Добавить(НоваяСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СобранныеНастройки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СобранныеНастройки;

КонецФункции

// Сохраняет настройки отборов справочников в зависимости от режима обмена и использования частой базы
Процедура ГлЯдро_СохранитьНастройкиОтборовСправочников(РежимОбмена, ЗначениеНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СохранитьНастройкиОтборовСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ЗначениеНастройки,ID_Узла,ДополнительныеПараметры",
		РежимОбмена, ЗначениеНастройки, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
	#КонецЕсли
	
	НастройкиКСохранению = Новый Структура;
	Если ПустаяСтрока(ID_Узла) ИЛИ РежимОбмена = "Онлайн" Тогда
		
		// В онлайне есть узловые настройки для всех ТО
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, ID_Узла, АдресаПеременных);
		
	Иначе
		
		// В интерактивном и регламентном режиме узловые настройки доступны только для частных баз
		// 	если узел является частной базой, то сохраняем в узловую настройку, иначе в главную
		Отбор = Новый Структура("ID_Узла", ID_Узла);
		ИспользоватьЧастнуюБазу = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("Узлы", Отбор, "ИспользоватьЧастнуюБазу",, АдресаПеременных);
		ЭтоЧастнаяБаза = ИспользоватьЧастнуюБазу = Истина;
		
		Если ЭтоЧастнаяБаза Тогда
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, ID_Узла, АдресаПеременных);
		Иначе
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, "", АдресаПеременных);
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Вызывает функцию очистки данных из таблицы на сервере Клеверенс
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы	
//  ID_БазыSMARTS - Строка - идентификатор текущей базы Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//  Структура - содержит:
//		* Статус - Булево - признак успешности очистки таблицы
//		* Сообщение - Строка - информационное сообщение о результате очистки таблицы
Функция ГлЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОчиститьТаблицуНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТипБазы",
		ИмяТаблицы, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		РезультатВыгрузки = REST_API_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы, АдресаПеременных);
	Иначе
		РезультатВыгрузки = КомЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы, АдресаПеременных);
	КонецЕсли;
	Сообщить(РезультатВыгрузки.Сообщение); 
	
	Если НЕ РезультатВыгрузки.Статус Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"РезультатВыгрузки",
			РезультатВыгрузки);
		ЛогОшибка(логСобытие, РезультатВыгрузки.Сообщение,, логКонтекст,,, АдресаПеременных);
		// </Лог>
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

// Вызывает функцию получения имен справочников в конфигурации Клеверенс
//
// Параметры:
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Массив из Строка - содержит имена справочников в конфигурации Клеверенс
Функция ГлЯдро_ПолучитьСписокСправочниковВКонфигурацииSMARTS(АдресаПеременных) Экспорт
	Возврат КомЯдро_ПолучитьСписокСправочниковВКонфигурацииSMARTS(АдресаПеременных);		
КонецФункции

Функция ГлЯдро_ПолучитьТаблицуДляВыгрузкиСправочников(ИмяТаблицы, НастройкиКомпоновщика = "", ПараметрыКомпоновщика = Ложь, СхемаСКД = Неопределено, ПараметрыОнлайн = "", ОтборПоМассивуСсылок = Неопределено, РаботаБезАлкоголя = Ложь, ПараметрыВыгрузки = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПолучитьТаблицуДляВыгрузкиСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,СхемаСКД,ПараметрыОнлайн,ОтборПоМассивуСсылок,РаботаБезАлкоголя,ПараметрыВыгрузки",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, СхемаСКД, ПараметрыОнлайн, ОтборПоМассивуСсылок, РаботаБезАлкоголя, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	Если СхемаСКД = Неопределено Тогда
		СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
		
		ПараметрыПолученияМакета = Новый Структура;
		ПараметрыПолученияМакета.Вставить("РаботаБезАлкоголя",	 РаботаБезАлкоголя);
		ПараметрыПолученияМакета.Вставить("ПараметрыОнлайн",	 ПараметрыОнлайн);
		ПараметрыПолученияМакета.Вставить("ЯзыкПлатформыMS",	 ЯзыкПлатформыMS);
		ПараметрыПолученияМакета.Вставить("СтруктураМетаданных", СтруктураМетаданных);
		
		СхемаСКД = ГлЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников(ИмяТаблицы, ПараметрыКомпоновщика, ПараметрыПолученияМакета, ПараметрыВыгрузки, АдресаПеременных);
		Если СхемаСКД = Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый ТаблицаЗначений);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
	КонецЕсли;
	
	КомпоновщикСКД = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	// Применяем настройки компоновки из параметров
	КомпоновщикСКД.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаСКД));
	
	Если НастройкиКомпоновщика <> "" И НастройкиКомпоновщика <> Неопределено Тогда
		КомпоновщикСКД.ЗагрузитьНастройки(НастройкиКомпоновщика);
	Иначе
		КомпоновщикСКД.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
	// Установка типа значений для вычисляемых полей СКД, в которых содержится GUID,
	// т.к. иногда значение обрезается (например, макет скд "Склады")
	Для Каждого ВычисляемоеПоле Из СхемаСКД.ВычисляемыеПоля Цикл
		Если Найти(ВРег(ВычисляемоеПоле.ПутьКДанным), "GUID") > 0
			И НЕ ЗначениеЗаполнено(ВычисляемоеПоле.ТипЗначения) Тогда
			ВычисляемоеПоле.ТипЗначения = Новый ОписаниеТипов("Строка");
		КонецЕсли;
	КонецЦикла;
	
	// По параметрам онлайн определяем, нужно ли очищать ИдРодителя на верхнем уровне иерархического справочника
	Если ИмяТаблицы <> "Номенклатура" Тогда
		ГлЯдро_УстановитьФлагПроверкиРодителейИерархическогоСправочника(ИмяТаблицы, ПараметрыОнлайн, ПараметрыВыгрузки, АдресаПеременных);
	КонецЕсли;
	
	// Дополняем онлайн-таблицу (не номенклатура) допусловиями
	Если ИмяТаблицы <> "Номенклатура" И ПараметрыОнлайн <> "" И НЕ ПараметрыОнлайн.IsValueItem Тогда
		МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
		
		СпособВыгрузки = "";
		Если ТипЗнч(ПараметрыВыгрузки) = Тип("Структура") Тогда
			Если ПараметрыВыгрузки.Свойство("СпособВыгрузки") Тогда
				СпособВыгрузки = ПараметрыВыгрузки.СпособВыгрузки;
			КонецЕсли;
		КонецЕсли;
		Если СпособВыгрузки = "ПроизвольныйЗапрос" Тогда
			ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблицПроизвольнымЗапросом(ИмяТаблицы, ПараметрыОнлайн, КомпоновщикСКД.Настройки.Отбор.Элементы, МетаданныеНСИ, КомпоновщикСКД.Настройки.ПараметрыДанных.Элементы, АдресаПеременных);
		Иначе
			СоответствиеПолей = ГлЯдро_ПолучитьСоответствиеПолейТаблицыMS(ИмяТаблицы, ЯзыкПлатформыMS, АдресаПеременных);
			СоответствиеПолейОбратное = Новый Соответствие;
			Для Каждого КЗ Из СоответствиеПолей Цикл
				СоответствиеПолейОбратное.Вставить(КЗ.Значение, КЗ.Ключ);
			КонецЦикла;
			
			ГлЯдро_УстановитьОтборКомпоновщикаДляВыгрузкиТаблиц(ИмяТаблицы, ПараметрыОнлайн, КомпоновщикСКД.Настройки.Отбор.Элементы, МетаданныеНСИ, КомпоновщикСКД.Настройки.ПараметрыДанных.Элементы, КомпоновщикСКД, СоответствиеПолейОбратное, , АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяТаблицы = "Номенклатура" Тогда
		ГлЯдро_УстановитьПараметрыСКДДляНоменклатуры(КомпоновщикСКД, ПараметрыОнлайн, АдресаПеременных);
	ИначеЕсли ИмяТаблицы = "Цены" Тогда
		ГлЯдро_ЗаполнитьЗначениеПараметраКомпоновщикаНастроекСКД(КомпоновщикСКД, "ОснованаяЦена", Конф_ПолучитьПустуюСсылкуСправочника("ОсновнаяЦена", АдресаПеременных), АдресаПеременных);
	КонецЕсли;
	
	// Вторым параметром передаем значения глобальных параметров (в отдельном методе для номенклатуры - передаем ПараметрыОнлайн)
	ГлЯдро_ОбработатьПараметрыСКД(ИмяТаблицы, ПараметрыКомпоновщика, КомпоновщикСКД, АдресаПеременных);
	
	РезультатНастройкиКомпоновки = КомпоновщикСКД.ПолучитьНастройки();
	
	// Добавляем все поля для макета компоновки
	ГруппировкаДокументов = РезультатНастройкиКомпоновки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для Каждого ПолеЗапроса Из СхемаСКД.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		ВыбранноеПоле				  = РезультатНастройкиКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Заголовок		  = ПолеЗапроса.Поле;
		ВыбранноеПоле.Использование	  = Истина;
		ВыбранноеПоле.Поле			  = Новый ПолеКомпоновкиДанных(ПолеЗапроса.Поле);
		ПолеГруппировки				  = ГруппировкаДокументов.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование = Истина;
		ПолеГруппировки.Поле		  = Новый ПолеКомпоновкиДанных(ПолеЗапроса.Поле);
	КонецЦикла;
	
	Если ОтборПоМассивуСсылок <> Неопределено
		И ПараметрыВыгрузки <> Неопределено
		И ПараметрыВыгрузки.Свойство("ПараметрыПорционнойВыгрузки") Тогда
		
		Если РезультатНастройкиКомпоновки.ДоступныеПоляОтбора.Элементы.Найти(ПараметрыВыгрузки.ПараметрыПорционнойВыгрузки.ПолеНаложенияОтбора) = Неопределено Тогда
			// <Лог>
			ЯзСтрока = "ru = 'В макете выгрузки таблицы: %1, не найдено поле ""%2"" для наложения отбора. Подробнее в ИО Конф_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки()';
									|en = 'In the layout for uploading the table: %1, the ""%2"" field for superimposing the selection was not found. For more information, see the Integration Processing of conf_to get the parameters of the references for the proportional upload()';
									|be = 'У макеце выгрузкі табліцы: %1, не знойдзена поле"" % 2 "" для накладання адбору. Больш падрабязна у інтэграцыйная апрацоўка Конф_получитьпараметрысправочниковдляпорционнойвыгрузкі()'; es = 'En el diseño de carga de la tabla: %1, no se encontró el campo ""%2 "" para la superposición de selección. Leer más en procesamiento de integración conf_obtenerparámetrosreferenciasparaporta carga ()'; ka = 'ცხრილის ატვირთვის განლაგებაში: %1,"" %2 "" ველი შერჩევის ზემოქმედებისთვის არ იქნა ნაპოვნი. დამატებითი ინფორმაციისთვის იხილეთ conf_ის ინტეგრაციის დამუშავება პროპორციული ატვირთვისთვის ცნობების პარამეტრების მისაღებად()'; kk = 'Кестені жүктеу макетінде: %1, таңдау үшін ""%2"" өрісі табылған жоқ. Толығырақ мына жерден оқыңыз интеграциялық өңдеу Конф_қызмет параметрлерін Алыңызбөлшектержүктеу ()'; ro = 'În aspectul pentru încărcarea tabelului: %1, câmpul ""%2 "" pentru suprapunerea selecției nu a fost găsit. Pentru mai multe informații, consultați procesarea de integrare a conf_pentru a obține parametrii referințelor pentru încărcarea proporțională()'; tr = 'Tablo boşaltma düzeninde: %1, seçimi üst üste bindirmek için ""%2"" alanı bulunamadı. Şurada daha fazla bilgi edinin: Entegrasyon işleme bağlantı_bilgisayar gönderileri için referansların parametrelerini almak()'; uk = 'У макеті вивантаження таблиці: %1, не знайдено поле ""%2"" для накладення відбору. Детальніше в інтеграційна обробка Конф_получітьпараметрисправочніковдляпорціоннойвигрузкі()'; uz = 'Jadvalni yuklash tartibida: %1, tanlovni qoplash uchun ""%2"" maydoni topilmadi. Batafsil ma''lumot integratsion ishlov berish Conf_parametrlarni Olingko''chirishko''kishko''kishko''kishko''kishko''kishko''kishko''kishko''kishko''kishko''kishko''kishko''kish ()'";
			ТекстСообщения = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяТаблицы, ПараметрыВыгрузки.ПараметрыПорционнойВыгрузки.ПолеНаложенияОтбора);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ИмяТаблицы,ПолеНаложенияОтбора",
				ИмяТаблицы, ПараметрыВыгрузки.ПараметрыПорционнойВыгрузки.ПолеНаложенияОтбора);
			ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый ТаблицаЗначений);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Новый ТаблицаЗначений;
		Иначе
			НовыйЭлементОтбора				  = РезультатНастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовыйЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ПараметрыВыгрузки.ПараметрыПорционнойВыгрузки.ПолеНаложенияОтбора);
			НовыйЭлементОтбора.Использование  = Истина;
			НовыйЭлементОтбора.ВидСравнения	  = ВидСравненияКомпоновкиДанных.ВСписке;
			НовыйЭлементОтбора.ПравоеЗначение = ОтборПоМассивуСсылок;
		КонецЕсли;
	КонецЕсли;
	
	ТекстОграниченияВыборки	= "";
	HardDemo				= Ложь;
	СтруктураМетаданных		= КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если СтруктураМетаданных.Свойство("HardDemo")
		И СтруктураМетаданных.HardDemo = Истина Тогда
		HardDemo = Истина;
		ТекстОграниченияВыборки = " ПЕРВЫЕ 100 ";
	КонецЕсли;
	
	// Если это онлайн запрос списка справочника, ограничим его 196 строкой, для этого в макете СКД должны быть вставки для применения ограничения
	Если ПараметрыОнлайн <> ""
		И ((ИмяТаблицы = "Номенклатура"
				И ((ПараметрыОнлайн.Режим = "СписокНоменклатуры")
					ИЛИ (ПараметрыОнлайн.Режим = "ПоискПоЧастиНаименования")
					ИЛИ (ПараметрыОнлайн.Режим = "СписокНоменклатурыДляГрупп")
				ИЛИ (ПараметрыОнлайн.Режим = "СписокУпаковокДляНоменклатуры"))
			ИЛИ ИмяТаблицы <> "Номенклатура")) Тогда
		ТекстОграниченияВыборки = " ПЕРВЫЕ 196 ";
	КонецЕсли;
	
	Если ТекстОграниченияВыборки <> "" Тогда
	
		ЗапросСКД = СхемаСКД.НаборыДанных[ИмяТаблицы].Запрос;
		ЗапросСКД = СтрЗаменить(ЗапросСКД, "//%ПЕРВЫЕ_N%", ТекстОграниченияВыборки);
		ЗапросСКД = СтрЗаменить(ЗапросСКД, "//%УПОРЯДОЧИТЬ", "УПОРЯДОЧИТЬ");
		
		СхемаСКД.НаборыДанных[ИмяТаблицы].Запрос = ЗапросСКД;
	
	КонецЕсли;
	
	Если HardDemo
		И ИмяТаблицы <> "Номенклатура" Тогда
		Для Каждого ГруппировкаМакета Из РезультатНастройкиКомпоновки.Структура Цикл
			ПараметрыВывода							= ГруппировкаМакета.ПараметрыВывода.Элементы;
			ПараметрКоличествоЗаписей				= ПараметрыВывода.Найти("КоличествоЗаписей");
			ПараметрКоличествоЗаписей.Использование	= Истина;
			ПараметрКоличествоЗаписей.Значение		= 100;
		КонецЦикла;
	КонецЕсли;
	
	// Выполняем компоновку макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаСКД, РезультатНастройкиКомпоновки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Ошибка при получении таблицы данных %1.';
								|en = 'Error when getting the data table %1.'; be = 'Памылка пры атрыманні табліцы дадзеных %1.'; es = 'Error al recuperar la tabla de datos %1.'; ka = 'შეცდომა მონაცემთა ცხრილის მიღებისას %1.'; kk = '%1 деректер кестесін алу кезінде қате.'; ro = 'Eroare la obținerea tabelului de date %1.'; tr = '%1 veri tablosu alınırken hata oluştu.'; uk = 'Помилка при отриманні таблиці даних %1.'; uz = 'Ma''lumotlar jadvalini olishda xato %1.'";
								
		ТекстСообщения = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяТаблицы);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ИмяТаблицы",
			ИмяТаблицы);
		ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый ТаблицаЗначений);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Сообщить(ТекстСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнфоОшибка));
		
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ТаблицаЗначений = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	КонецЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВремяВыполнения = Строка((КонецЗамера - НачалоЗамера)/1000) + " с.";
	
	ТекстСообщения = НСтр("ru = 'Время вывода таблицы значений через ПроцессорВывода.Вывести(): %1 Конец';
							|en = 'The time of output of the table of values through the output processor.Output(): %1 End';
							|be = 'Час вываду табліцы значэнняў праз ПроцессорВывода.Вывесці (): %1 Канец'; es = 'Tiempo de salida de la tabla de valores a través del proceso.Salida (): %1 Final'; ka = 'გამომავალი პროცესორის მეშვეობით ღირებულებების ცხრილის გამომავალი დრო.გამომავალი(): %1 დასასრული'; kk = 'Шығару процессоры арқылы мәндер кестесін шығару уақыты.Шығару (): %1 Соңы'; ro = 'Timpul de ieșire al tabelului de valori prin procesorul de ieșire.Ieșire (): % 1 Sfârșit'; tr = 'Çıktı işlemcisinden değerler tablosunun çıktısının zamanlaması.Çıktı(): %1 Sonu'; uk = 'Час виведення таблиці значень через Процесорвивода.Вивести (): %1 Кінець'; uz = 'Chiqish protsessori orqali qiymatlar jadvalini chiqarish vaqti.Chiqarish (): %1 Oxiri'");
	ТекстСообщения = ГлЯдро_СтрШаблон(ТекстСообщения, ВремяВыполнения);
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстСообщения, , АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТаблицаЗначений);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ТаблицаЗначений;
	
КонецФункции

Процедура ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФоне(Знач Параметры, Знач АдресРезультата) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФоне";
	
	// Вместо адресов переменных используем значения переменных, т.к. ФЗ выполняется в другом сеансе,
	// поэтому временное хранилище родительского сеанса не доступно в сеансе ФЗ
	АдресаПеременных = Параметры.ЗначенияПеременных;
	АдресаПеременных.Вставить("ЭтоФоновоеЗадание", Истина);
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Параметры",
		Параметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МассивАдресовПустыхЗначений 	= Параметры.МассивАдресовПустыхЗначений;
	ИмяТаблицы 						= Параметры.ИмяТаблицы;
	НастройкиКомпоновщика 			= Параметры.НастройкиКомпоновщика;
	ПараметрыКомпоновщика 			= Параметры.ПараметрыКомпоновщика;
	ТипБазы 						= Параметры.ТипБазы;
	ОчищатьСправочникПередВыгрузкой = Параметры.ОчищатьСправочникПередВыгрузкой;
	РаботаБезАлкоголя 				= Параметры.РаботаБезАлкоголя;
	ПараметрыВыгрузки 				= Параметры.ПараметрыВыгрузки;
	
	РезультатВыгрузки = ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика,
		ТипБазы, ОчищатьСправочникПередВыгрузкой, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
			
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	АдресаПеременных.Удалить("ЭтоФоновоеЗадание");
	ГлЯдро_ПересохранитьЗначенияПеременныхВФЗ(АдресаПеременных, МассивАдресовПустыхЗначений);
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("РезультатВыгрузки", РезультатВыгрузки);
	СтруктураРезультата.Вставить("АдресаПеременных", АдресаПеременных);
	
	ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
	
КонецПроцедуры

