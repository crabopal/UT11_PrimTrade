			ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
			ИнтеграционнаяОбработка 								= ВнешниеОбработки.Создать(ИмяИнтеграционнойОбработки, Ложь, ЗащитаОтОпасныхДействий);
			
			Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
				УдалитьФайлы(ИмяВременногоФайла);
			КонецЕсли;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось пересоздать интеграционную обработку';
								|en = 'Couldn''t recreate integration processing';
								|be = 'Не ўдалося перастварыць інтэграцыйную апрацоўку'; es = 'No se pudo volver a crear el procesamiento de integración'; ka = 'ვერ მოხერხდა ინტეგრაციის დამუშავების აღდგენა'; kk = 'Интеграциялық өңдеуді қайта құру мүмкін болмады'; ro = 'Nu s-a putut recrea procesarea integrării'; tr = 'Entegrasyon işlemi yeniden oluşturulamadı'; uk = 'Не вдалося відновити інтеграційну обробку'; uz = 'Integratsiyani qayta ishlash muvaffaqiyatsiz tugadi'";
			пСообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		КонецПопытки;
		
		Попытка
			Если НЕ ИнтеграционнаяОбработка = Неопределено Тогда
				Если ТипОбработки = "ФайлНаДиске" Тогда
					ПутьКФайлу = Строка(ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки)
						+ Строка(ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки);
				ИначеЕсли ТипОбработки = "СправочникСсылка" Тогда
					СсылкаНаЭлемент = ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки;
					
					Если ТипЗнч(СсылкаНаЭлемент) = Тип("Строка") Тогда
						СсылкаНаЭлемент = ГлЯдро_ЗначениеИзСтрокиXML(СсылкаНаЭлемент);
					КонецЕсли;
					
					Если ГлЯдро_СсылкаСуществует(СсылкаНаЭлемент) Тогда
						МетаданныеСправочника = СсылкаНаЭлемент.Метаданные();
						
						ПутьКФайлу = НСтр("ru = 'Справочник: ""%1"", Обработка: ""%2""';
											|en = 'Reference: ""%1"", Processing: ""%2""'; be = 'Даведнік: ""%1"", Апрацоўка:""%2""'; es = 'Referencia: ""%1"", Procesamiento: ""%2""'; ka = 'მითითება: ""%1"", დამუშავება: ""%2""'; kk = 'Анықтама: ""%1"", Өңдеу: ""%2""'; ro = 'Referință: ""%1"", Procesare:""%2""'; tr = 'Referans: ""%1"", İşleme: ""%2""'; uk = 'Довідник: ""%1"", Обробка:""%2""'; uz = 'Qo''llanma: ""%1"", Ishlov Berish: ""%2""'");
						ПутьКФайлу = ГлЯдро_СтрШаблон(ПутьКФайлу, МетаданныеСправочника.Синоним, Строка(СсылкаНаЭлемент));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось получить путь к обработке интеграции';
								|en = 'Couldn''t get the integration processing path';
								|be = 'Не атрымалася атрымаць шлях да апрацоўцы інтэграцыі'; es = 'No se pudo obtener la ruta de procesamiento de integración'; ka = 'ვერ მივიღე ინტეგრაციის დამუშავების გზა'; kk = 'Интеграцияны өңдеу жолын алу мүмкін болмады'; ro = 'Nu s-a putut obține calea de procesare a integrării'; tr = 'Entegrasyon işleme yolu alınamadı'; uk = 'Не вдалося отримати шлях до обробки інтеграції'; uz = 'Integratsiyani qayta ishlash yo''lini topa olmadi'";
			пСообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
		КонецПопытки;
		#КонецОбласти //НесовместимыйКодFresh
	КонецЕсли;
	
	Если НЕ ИнтеграционнаяОбработка = Неопределено Тогда
		Попытка
			Если НЕ ИнтеграционнаяОбработка.Конф_ПроверкаСоответствияИспользуемойКонфигурации() Тогда
				// Возврат Ложь;
			КонецЕсли;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось пересоздать интеграционную обработку';
								|en = 'Couldn''t recreate integration processing';
								|be = 'Не ўдалося перастварыць інтэграцыйную апрацоўку'; es = 'No se pudo volver a crear el procesamiento de integración'; ka = 'ვერ მოხერხდა ინტეგრაციის დამუშავების აღდგენა'; kk = 'Интеграциялық өңдеуді қайта құру мүмкін болмады'; ro = 'Nu s-a putut recrea procesarea integrării'; tr = 'Entegrasyon işlemi yeniden oluşturulamadı'; uk = 'Не вдалося відновити інтеграційну обробку'; uz = 'Integratsiyani qayta ishlash muvaffaqiyatsiz tugadi'";
			пСообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
		КонецПопытки;
		
		СтруктураОбработки = Новый Структура();
		СтруктураОбработки.Вставить("ИнтеграционнаяОбработка",				 ИнтеграционнаяОбработка);
		СтруктураОбработки.Вставить("Подключена",							 Истина);
		СтруктураОбработки.Вставить("ПутьКФайлу",							 ПутьКФайлу);
		СтруктураОбработки.Вставить("ИмяОбработки",							 ИнтеграционнаяОбработка.Метаданные().Имя);
		СтруктураОбработки.Вставить("ИнтеграционнаяОбработкаДвоичныеДанные", ИнтеграционнаяОбработкаДвоичныеДанные);
		
		КомЯдро_СохранитьЗначениеПеременной("ИнтеграционнаяОбработка", СтруктураОбработки, АдресаПеременных);
		ГлЯдро_ОбновитьФункциональныеПараметры1СВБазеMS(АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Истина;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Ложь;
	
КонецФункции

Функция ГлЯдро_ПроверитьСуществованиеИнтеграционнаяОбработкаДвоичныеДанные(АдресаПеременных) Экспорт
	
	Результат = Ложь;
	
	Если НЕ АдресаПеременных.Свойство("ИнтеграционнаяОбработка") Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	
	Если СтруктураИО = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтруктураИО.Свойство("ИнтеграционнаяОбработкаДвоичныеДанные")
		И СтруктураИО.ИнтеграционнаяОбработкаДвоичныеДанные <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ГлЯдро_ПересохранитьНастройкиПодключения(АдресаПеременных)
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS",АдресаПеременных);
	
	ИдБазы = ПараметрыПодключенияMS.Ид;
	
	СписокБазНаСервереSMARTS = КомЯдро_ПолучитьСписокБазНаСервереSMARTS(Истина,АдресаПеременных);
	СтрокаПараметров = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(СписокБазНаСервереSMARTS,"Ид",ИдБазы);
	
	Если СтрокаПараметров <> Неопределено Тогда
		ПараметрыПодключенияMS = Новый Структура;
		ПараметрыПодключенияMS.Вставить("Ид", 							СтрокаПараметров.Ид);
		ПараметрыПодключенияMS.Вставить("Имя", 							СтрокаПараметров.Имя);
		ПараметрыПодключенияMS.Вставить("ИдПриложения", 				СтрокаПараметров.ИдПриложения);
		ПараметрыПодключенияMS.Вставить("ИдОсновногоПриложения", 		СтрокаПараметров.ИдОсновногоПриложения);
		ПараметрыПодключенияMS.Вставить("ИмяПриложения", 				СтрокаПараметров.ИмяПриложения);
		ПараметрыПодключенияMS.Вставить("УровеньПриложения", 			СтрокаПараметров.УровеньПриложения);
		ПараметрыПодключенияMS.Вставить("СтрокаПодключения", 			СтрокаПараметров.СтрокаПодключения);
		ПараметрыПодключенияMS.Вставить("РабочийКаталог", 				СтрокаПараметров.РабочийКаталог);
		ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",	СтрокаПараметров.ИмяИнтеграционнойОбработки);
		ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки",	СтрокаПараметров.ПутьИнтеграционнойОбработки);
		ПараметрыПодключенияMS.Вставить("УровеньПриложенияСтрокой",		СтрокаПараметров.УровеньПриложенияСтрокой);
		ПараметрыПодключенияMS.Вставить("ТипУстановленногоПродукта",	СтрокаПараметров.ТипУстановленногоПродукта);
		
		ГлЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
	КонецЕсли;
	
КонецПроцедуры

Функция ГлЯдро_ПроверитьОбновлениеТиповыхБизнесПроцессов(пСтруктураНастроек, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПроверитьОбновлениеТиповыхБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураНастроек = Новый Структура("ВерсияНастроек,ВерсияНастроек_ПоУмолчанию", Неопределено, Неопределено);
	СтруктураНастроек_Пользовательские 	= Новый Структура;
	СтруктураНастроек_ПоУмолчанию 		= Новый Структура;
	
	ВерсияНастроек_ПоУмолчанию 				= Ложь;
	НастройкиБизнесПроцессов_ПоУмолчанию 	= Ложь;
	
	ЗначениеКлюча_НастройкиПоУмолчанию = пСтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию;
	Если ЗначениеЗаполнено(ЗначениеКлюча_НастройкиПоУмолчанию) И ЗначениеКлюча_НастройкиПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(ЗначениеКлюча_НастройкиПоУмолчанию) = Тип("Строка") Тогда
			ЗначениеКлюча_НастройкиПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(ЗначениеКлюча_НастройкиПоУмолчанию);		
		КонецЕсли;
	    Если ТипЗнч(ЗначениеКлюча_НастройкиПоУмолчанию) = Тип("Структура") Тогда
			Если ЗначениеКлюча_НастройкиПоУмолчанию.Свойство("ВерсияНастроек") Тогда
				ВерсияНастроек_ПоУмолчанию = ЗначениеКлюча_НастройкиПоУмолчанию.ВерсияНастроек;
			КонецЕсли;
			Если ЗначениеКлюча_НастройкиПоУмолчанию.Свойство("НастройкиБизнесПроцессов") Тогда
				НастройкиБизнесПроцессов_ПоУмолчанию = ЗначениеКлюча_НастройкиПоУмолчанию.НастройкиБизнесПроцессов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ВерсияНастроек_Пользовательские 			= Ложь;
	НастройкиБизнесПроцессов_Пользовательские 	= Ложь;
	
	ЗначениеКлюча_НастройкиПользовательские = пСтруктураНастроек.НастройкиБизнесПроцессов_Пользовательские;
	Если ЗначениеЗаполнено(ЗначениеКлюча_НастройкиПользовательские) И ЗначениеКлюча_НастройкиПользовательские <> Ложь Тогда
		Если ТипЗнч(ЗначениеКлюча_НастройкиПользовательские) = Тип("Строка") Тогда
			ЗначениеКлюча_НастройкиПользовательские = ГлЯдро_ЗначениеИзСтрокиXML(ЗначениеКлюча_НастройкиПользовательские);		
		КонецЕсли;
		Если ТипЗнч(ЗначениеКлюча_НастройкиПользовательские) = Тип("Структура") Тогда
			Если ЗначениеКлюча_НастройкиПользовательские.Свойство("ВерсияНастроек") Тогда
				ВерсияНастроек_Пользовательские = ЗначениеКлюча_НастройкиПользовательские.ВерсияНастроек;
			КонецЕсли;
			Если ЗначениеКлюча_НастройкиПользовательские.Свойство("НастройкиБизнесПроцессов") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ЗначениеКлюча_НастройкиПользовательские.НастройкиБизнесПроцессов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем версии пользовательских настроек из настроек БП (если настройки сохранены в новом формате), либо по старому ключу, все это реализовано в соответствующих методах
	СтруктураНастроек_ПоУмолчанию.Вставить("НастройкиБизнесПроцессов", 		НастройкиБизнесПроцессов_ПоУмолчанию);
	СтруктураНастроек_Пользовательские.Вставить("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов_Пользовательские);

	СтруктураНастроек.ВерсияНастроек			 = ВерсияНастроек_Пользовательские;
	СтруктураНастроек.ВерсияНастроек_ПоУмолчанию = ВерсияНастроек_ПоУмолчанию;		

	НужноОбновить = Ложь;
	Если Не ЗначениеЗаполнено(СтруктураНастроек.ВерсияНастроек) ИЛИ СтруктураНастроек.ВерсияНастроек = Ложь Тогда
		НужноОбновить = Истина;
	ИначеЕсли ТипЗнч(СтруктураНастроек.ВерсияНастроек) = Тип("Строка") И ТипЗнч(СтруктураНастроек.ВерсияНастроек_ПоУмолчанию) = Тип("Строка") Тогда		
		ВерсияНастроекСтр = СтруктураНастроек.ВерсияНастроек;
		ВерсияНастроек_ПоУмолчаниюСтр = СтруктураНастроек.ВерсияНастроек_ПоУмолчанию;
		Пока Истина Цикл
			Если СтрДлина(ВерсияНастроек_ПоУмолчаниюСтр) = 0 Тогда
				Прервать;
			КонецЕсли;
			Если СтрДлина(ВерсияНастроекСтр) = 0 Тогда
				НужноОбновить = Истина;
				Прервать;
			КонецЕсли;
			
			Инд = Найти(ВерсияНастроек_ПоУмолчаниюСтр,".");
			Если Инд = 0 Тогда				
				ВерсияПоУмолчанию = ВерсияНастроек_ПоУмолчаниюСтр;
				ВерсияНастроек_ПоУмолчаниюСтр = "";
			Иначе
				ВерсияПоУмолчанию = Лев(ВерсияНастроек_ПоУмолчаниюСтр,Инд-1);
				ВерсияНастроек_ПоУмолчаниюСтр = Прав(ВерсияНастроек_ПоУмолчаниюСтр,СтрДлина(ВерсияНастроек_ПоУмолчаниюСтр)-Инд);
			КонецЕсли;
			
			Попытка
				ВерсияПоУмолчанию = Число(ВерсияПоУмолчанию);	
			Исключение
				Прервать;
			КонецПопытки;
			
			Инд = Найти(ВерсияНастроекСтр,".");
			Если Инд = 0 Тогда				
				ТекВерсия = ВерсияНастроекСтр;
				ВерсияНастроекСтр = "";
			Иначе
				ТекВерсия = Лев(ВерсияНастроекСтр,Инд-1);
				ВерсияНастроекСтр = Прав(ВерсияНастроекСтр,СтрДлина(ВерсияНастроекСтр)-Инд);
			КонецЕсли;
			
			Попытка
				ТекВерсия = Число(ТекВерсия);	
			Исключение
				НужноОбновить = Истина;
				Прервать;
			КонецПопытки;
			
			Если ВерсияПоУмолчанию > ТекВерсия Тогда
				НужноОбновить = Истина;
				Прервать;	
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ НужноОбновить Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;	
	КонецЕсли;
		
	НастройкиБизнесПроцессовПоУмолчанию = СтруктураНастроек_ПоУмолчанию.НастройкиБизнесПроцессов;
	Если НастройкиБизнесПроцессовПоУмолчанию <> Неопределено И НастройкиБизнесПроцессовПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессовПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессовПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессовПоУмолчанию);
		КонецЕсли;
		Если ТипЗнч(НастройкиБизнесПроцессовПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессовПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессовПоУмолчанию);
		КонецЕсли;
		
		СтруктураНастроекБизнесПроцессов_ПоУмолчанию = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессовПоУмолчанию, 
				ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(),
				АдресаПеременных); 		                                                                		
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПоУмолчанию", СтруктураНастроекБизнесПроцессов_ПоУмолчанию, АдресаПеременных);
		
	КонецЕсли; 	
	
	Если СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов = Ложь Тогда	
		НастройкиБизнесПроцессовСтарые = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов",,,АдресаПеременных);	
		Если НастройкиБизнесПроцессовСтарые <> Неопределено и НастройкиБизнесПроцессовСтарые <> Ложь Тогда
			НастройкиБизнесПроцессов_Пользовательские = НастройкиБизнесПроцессовСтарые;
			СтруктураНастроек_Пользовательские = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_Пользовательские, 
				ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(),
				АдресаПеременных); 		
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	 СтруктураНастроек_Пользовательские,, АдресаПеременных);
			ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	 СтруктураНастроек_Пользовательские,  АдресаПеременных);	
			ГлЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("НастройкиБизнесПроцессов",Ложь), Неопределено,					   ,  АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	                      	
	НужноСохранить = Ложь;
	
	НастройкиБизнесПроцессов_Пользовательские = СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов;
	Если НастройкиБизнесПроцессов_Пользовательские <> Неопределено И НастройкиБизнесПроцессов_Пользовательские <> Ложь Тогда		
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);
		КонецЕсли;
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_Пользовательские);
		КонецЕсли;
		Икс = НастройкиБизнесПроцессов_Пользовательские.Количество();
		Пока Икс > 0 Цикл
			Икс = Икс - 1;
			НастройкаБП = НастройкиБизнесПроцессов_Пользовательские[Икс];
			Если НастройкаБП.Свойство("ID_БизнесПроцесса") Тогда
				ID = НастройкаБП.ID_БизнесПроцесса;
			ИначеЕсли НастройкаБП.Свойство("IDБизнесПроцесса") Тогда
				ID = НастройкаБП.IDБизнесПроцесса;
			Иначе
				ID = Неопределено;
			КонецЕсли;
			Если ID <> Неопределено Тогда
				Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессовПоУмолчанию,"ID_БизнесПроцесса",ID,Истина);
				Если Индекс <> Неопределено Тогда
					НастройкиБизнесПроцессов_Пользовательские.Удалить(Икс);
					НужноСохранить=Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ОбновитьСтруктуруНастроекБизнесПроцессов(НастройкиБизнесПроцессов_Пользовательские, НужноСохранить,,АдресаПеременных);
	КонецЕсли;
	
	Если НужноСохранить Тогда		
		СтруктураНастроекБизнесПроцессов_Пользовательские = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_Пользовательские, 
			ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(),
			АдресаПеременных); 		
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские,,	АдресаПеременных);
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские,	АдресаПеременных);	
	КонецЕсли;
		
	ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ПроизвольныеКоды_ПоУмолчанию",,АдресаПеременных);
	Если ПроизвольныеКоды_ПоУмолчанию <> Неопределено и ПроизвольныеКоды_ПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("Строка") Тогда
			ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_ПоУмолчанию);
		КонецЕсли;
		Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ПроизвольныеКоды_ПоУмолчанию);
		КонецЕсли;
		
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию", ПроизвольныеКоды_ПоУмолчанию,АдресаПеременных);
	КонецЕсли;
	
	ПроизвольныеКоды_Пользовательские = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские",,АдресаПеременных);	
	Если ПроизвольныеКоды_Пользовательские <> Неопределено и ПроизвольныеКоды_Пользовательские <> Ложь Тогда
		НужноСохранить=Ложь;
		Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("Строка") Тогда
			ПроизвольныеКоды_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_Пользовательские);
		КонецЕсли;
		Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			ПроизвольныеКоды_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ПроизвольныеКоды_Пользовательские);
		КонецЕсли;
		Икс = ПроизвольныеКоды_Пользовательские.Количество();
		Пока Икс > 0 Цикл
			Икс = Икс - 1;
			СтрокаПК = ПроизвольныеКоды_Пользовательские[Икс];
			Если СтрокаПК.Свойство("ID_ПроизвольногоКода") Тогда
				Индекс = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПроизвольныеКоды_ПоУмолчанию,"ID_ПроизвольногоКода",СтрокаПК.ID_ПроизвольногоКода,Истина);
				Если Индекс <> Неопределено Тогда
					ПроизвольныеКоды_Пользовательские.Удалить(Икс);
					НужноСохранить=Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;	
		
		НоваяНастройка = Новый Массив;
		НоваяНастройка.Добавить(Новый Структура("КолонкиТаблицыЗначений,ЭтоТаблицаЗначений","Наименование,Описание,ТекстПроизвольногоКода,ID_ПроизвольногоКода,Направление,ТипОбъекта",Истина));
		
		Для Каждого ПроизвольныйКод из ПроизвольныеКоды_Пользовательские Цикл
			Если ПроизвольныйКод.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ПроизвольныйКод.Свойство("ID_Кода") Тогда
				НовыйПроизвольныйКод = Новый Структура();
				НовыйПроизвольныйКод.Вставить("Наименование",			ПроизвольныйКод.Наименование);
				НовыйПроизвольныйКод.Вставить("Описание",				"");
				НовыйПроизвольныйКод.Вставить("ТекстПроизвольногоКода",	ПроизвольныйКод.ТекстКода);
				НовыйПроизвольныйКод.Вставить("ID_ПроизвольногоКода",	ПроизвольныйКод.ID_Кода);
				НовыйПроизвольныйКод.Вставить("Направление",			ПроизвольныйКод.Направление);
				НовыйПроизвольныйКод.Вставить("ТипОбъекта",				ПроизвольныйКод.ТипОбъекта);
				НоваяНастройка.Добавить(НовыйПроизвольныйКод);
				НужноСохранить = Истина;
			ИначеЕсли ПроизвольныйКод.Свойство("ID_ПроизвольногоКода") Тогда
				НоваяНастройка.Добавить(ПроизвольныйКод);
			КонецЕсли;
		КонецЦикла;	
				
		Если НужноСохранить Тогда
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", 	НоваяНастройка,,АдресаПеременных);
			ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", 	НоваяНастройка,АдресаПеременных);	
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

Процедура ГлЯдро_ОбновитьПереопределяемыеНастройкиБизнесПроцессов(ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновитьПереопределяемыеНастройкиБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	#КонецЕсли
	
	Изменено = Ложь;
	
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 		= ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
	НастройкиБизнесПроцессов_ПоУмолчанию 				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	
	Если ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = ГлЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS("", АдресаПеременных);
	Иначе
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ГлЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов(АдресаПеременных);
	КонецЕсли;
	
	НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	
	// Типовые настройки БП
	ТиповыеБизнесПроцессыПоID = Новый Соответствие;
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПоУмолчанию);
		КонецЕсли;
		
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если НЕ НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				ТиповыеБизнесПроцессыПоID.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Пользовательские настройки главного узла
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел);
		КонецЕсли;
		
		Изменено = Ложь;
		НовыеПользовательскиеНастройки = Новый Массив;
		
		Для Каждого ПользовательскаяНастройка Из НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел Цикл
			Если ПользовательскаяНастройка.Свойство("ЭтоТаблицаЗначений") Тогда
				НовыеПользовательскиеНастройки.Добавить(ПользовательскаяНастройка);
				Продолжить;
			КонецЕсли;
			
			НастройкаБП = ТиповыеБизнесПроцессыПоID.Получить(ПользовательскаяНастройка.ID_БизнесПроцесса);
			Если НастройкаБП <> Неопределено Тогда
				
				Если ПользовательскаяНастройка.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(ПользовательскаяНастройка.ПереопределяемыеНастройки) Тогда
					
					ПереопределяемыеНастройки = ГлЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(НастройкаБП, ПользовательскаяНастройка.ПереопределяемыеНастройки);
					
					Если НЕ ПереопределяемыеНастройки = Неопределено Тогда
						ПользовательскаяНастройка.ПереопределяемыеНастройки = ПереопределяемыеНастройки;
						Изменено = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
				НовыеПользовательскиеНастройки.Добавить(ПользовательскаяНастройка);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Изменено Тогда
			
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НовыеПользовательскиеНастройки,,АдресаПеременных);
			Если НЕ ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
				ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НовыеПользовательскиеНастройки, АдресаПеременных);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Обновляет переопределяемые настройки бизнес-процессов после обновления типовых настроек.
// - Отключает новое типовое поле, если уже есть пользовательсоке
// - Удаляет отключенные типовые поля, если они были удалены в типовых настройках
// - Удаляет переопределенную настройку, если в массиве больше нет изменений
Функция ГлЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(НастройкиТиповые, НастройкиПользовательские, ДополнительныеПараметры = Неопределено) Экспорт
	
	Изменено = Ложь;
	ОбновленнаяСтруктура = Новый Структура;
	
	Для каждого КлючЗначение Из НастройкиПользовательские Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеПользв = КлючЗначение.Значение;
		
		ЗначениеТиповой = Неопределено;
		НастройкиТиповые.Свойство(ИмяНастройки, ЗначениеТиповой);
		
		ТипЗнчПользв = ТипЗнч(ЗначениеПользв);
		ТипЗнчТиповой = ТипЗнч(ЗначениеТиповой);
		
		Если ТипЗнчПользв = Тип("Массив") Тогда
			ЗначениеПользв = ГлЯдро_СкопироватьМассив(ЗначениеПользв);
		ИначеЕсли ТипЗнчПользв = Тип("Структура") Тогда
			ЗначениеПользв = ГлЯдро_СкопироватьСтруктуру(ЗначениеПользв);
		КонецЕсли;
		
		Если ТипЗнчТиповой = Тип("Массив") Тогда
			ЗначениеТиповой = ГлЯдро_СкопироватьМассив(ЗначениеТиповой);
		ИначеЕсли ТипЗнчТиповой = Тип("Структура") Тогда
			ЗначениеТиповой = ГлЯдро_СкопироватьСтруктуру(ЗначениеТиповой);
		КонецЕсли;
		
		Если ЗначениеТиповой = Неопределено Тогда
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Продолжить;
		ИначеЕсли ТипЗнчПользв <> ТипЗнчТиповой Тогда
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчПользв = Тип("Массив") Тогда
			
			// Для возможности объединить массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			ИзмененныйМассив = Новый Массив;
			МассивИзменен = Ложь;
			
			// Проверяем наличие пользовательских элементов в типовых
			Для каждого ЭлементПользв Из ЗначениеПользв Цикл
				
				Если ЭлементПользв.Свойство("ЭтоТаблицаЗначений") Тогда
					ИзмененныйМассив.Добавить(ЭлементПользв);
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементПользв);
				
				ЭлементТиповой = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеТиповой, Отбор, Истина);
				Если ЭлементТиповой <> Неопределено Тогда
					
					Если ЭлементПользв.Свойство("Типовой") И ЭлементПользв.Типовой = Ложь Тогда
						
						// Пользовательский элемент, который есть в типовых.		
						Если (ЭлементПользв.Свойство("Выгружать") И ЭлементПользв.Выгружать = Истина)
							ИЛИ (ЭлементПользв.Свойство("Загружать") И ЭлементПользв.Загружать = Истина) Тогда
							
							// Это включённое пользовательское поле. Проверяем, что типовое поле отключено,
							// 	так как в типовых настройках могло появиться поле, которое уже настроено у пользователя.
							
							Отключено = Ложь;
							
							// Проверяем, что для пользовательского поля есть отключенное типовое поле
							ЭлементыПользв = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПользв, Отбор, Ложь);
							Если ЭлементыПользв <> Неопределено И ЭлементыПользв.Количество() > 0 Тогда
								Для каждого СтрокаПоля Из ЭлементыПользв Цикл
									
									Если НЕ СтрокаПоля.Свойство("Типовой") 
										ИЛИ НЕ СтрокаПоля.Типовой = Ложь Тогда
										Отключено = Истина;
										Прервать;
									КонецЕсли;
									
								КонецЦикла;
							КонецЕсли;
							
							Если НЕ Отключено Тогда
								// Не нашли отключённое поле - значит, оно новое,
								// 	и нужно отключить типовое поле, чтобы работала настройка пользователя.
								НовоеПоле = Новый Структура(КлючиУникальности);
								ЗаполнитьЗначенияСвойств(НовоеПоле, ЭлементПользв);
								Если ЭлементПользв.Свойство("Выгружать") Тогда
									НовоеПоле.Вставить("Выгружать", Ложь);
								Иначе
									НовоеПоле.Вставить("Загружать", Ложь);
								КонецЕсли;
								ЗначениеПользв.Добавить(НовоеПоле);
								МассивИзменен = Истина; // Изменено т.к добавили новое поле в пользв настройки
							КонецЕсли;
							
						КонецЕсли;
						
						ИзмененныйМассив.Добавить(ЭлементПользв);
						
					Иначе
						// Переопределенный типовой элемент
						
						пОбновленнаяСтруктура = ГлЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(ЭлементТиповой, ЭлементПользв);
						Если пОбновленнаяСтруктура = Неопределено Тогда	
							ИзмененныйМассив.Добавить(ЭлементПользв); // Изменений нет
								
						Иначе
							
							// Если вернулся результат, значит структура была изменена
							Если пОбновленнаяСтруктура.Количество() = ЭлементПользв.Количество() Тогда
								// Количество ключей совпадает, значит массив внутри не был удален, если он есть
								ИзмененныйМассив.Добавить(пОбновленнаяСтруктура);
								МассивИзменен = Истина; 
							Иначе
								
								// Массив внутри пОбновленнаяСтруктура был удален.
								// Проверяем, если внутри пОбновленнаяСтруктура содержатся другие ключи помимо КлючиУникальности, 
								//	то оставим этот элемент, иначе удалим, т.к он теперь пустой.
								СтруктураКлючей = Новый Структура(КлючиУникальности);
								Для каждого КлючЗначение Из пОбновленнаяСтруктура Цикл
									Если НЕ СтруктураКлючей.Свойство(КлючЗначение.Ключ) Тогда
										ИзмененныйМассив.Добавить(пОбновленнаяСтруктура);
										Прервать;
									КонецЕсли;
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					Если ЭлементПользв.Свойство("Типовой") И ЭлементПользв.Типовой = Ложь Тогда
						// Пользовательский элемент, которого нет в типовых
						ИзмененныйМассив.Добавить(ЭлементПользв);
					Иначе
						// Типовой элемент, который был удален из типовых настроек. 
						// Удалим его из пользовательских настроек.
						МассивИзменен = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ИзмененныйМассив.Количество() > 1
				ИЛИ (ИзмененныйМассив.Количество() = 1 
					И НЕ ИзмененныйМассив[0].Свойство("ЭтоТаблицаЗначений")) Тогда
				
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, ИзмененныйМассив);
				
				Если МассивИзменен Тогда
					Изменено = Истина;
				КонецЕсли;
				
			Иначе
				
				// Если массив оказался пустым, то удаляем ключ из настроек.
				// Возможно пользователь отключил поле, которое было удалено в типовых настройках.
				Изменено = Истина;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнчПользв = Тип("Структура") Тогда
			
			пОбъединеннаяСтруктура = ГлЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(ЗначениеТиповой, ЗначениеПользв);
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
			
			Если пОбновленнаяСтруктура = Неопределено Тогда	
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Иначе
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
				Изменено = Истина; // Если вернулся результат, значит структура была изменена
			КонецЕсли;
			
		Иначе
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Изменено Тогда
		Возврат ОбновленнаяСтруктура; // Структура изменена
	Иначе 
		Возврат Неопределено; // Структура не была изменена
	КонецЕсли;
	
КонецФункции

Процедура ГлЯдро_ОбъединитьПроизвольныеКоды(АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ОбъединитьПроизвольныеКоды";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию",,АдресаПеременных);
	ПроизвольныеКоды_Пользовательские = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские",,АдресаПеременных);
	
	Если (НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь И ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию))
		ИЛИ (НЕ ПроизвольныеКоды_Пользовательские = Ложь И ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские)) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура("ПроизвольныеКоды_Выгрузка_ШапкаДокумента,ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента,ПроизвольныеКоды_Загрузка_ШапкаДокумента,ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента",Неопределено,Неопределено);
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек,,,,АдресаПеременных);		
		
	ПроизвольныеКоды_Пользовательские = Новый Массив;
	ПроизвольныеКоды_Пользовательские.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Наименование,Описание,ТекстПроизвольногоКода,ID_ПроизвольногоКода,Направление,ТипОбъекта"));
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента = ГлЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента);
		КонецЕсли;
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента);
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Выгрузка");
				ПК.Вставить("ТипОбъекта","Шапка");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента = ГлЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента);		
		КонецЕсли;
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента);
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Выгрузка");
				ПК.Вставить("ТипОбъекта","ТабличнаяЧасть");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента = ГлЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента);		
		КонецЕсли;
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента);
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Загрузка");
				ПК.Вставить("ТипОбъекта","Шапка");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента = ГлЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента);		
		КонецЕсли;		
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента);
		КонецЕсли;

		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Загрузка");
				ПК.Вставить("ТипОбъекта","ТабличнаяЧасть");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПроизвольныеКоды_Пользовательские.Количество() > 0 Тогда
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские,,АдресаПеременных);
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские,АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(АдресаПеременных) Экспорт
	
	НастройкиБизнесПроцессов = ГлЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(, АдресаПеременных);
	
	ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов, АдресаПеременных);
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ID_Узла = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Узла",
		ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	Если ID_Узла = Неопределено Тогда
		ID_Узла = ID_ТекущегоУзла;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = ГлЯдро_ПолучитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", ID_Узла, АдресаПеременных);
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов) И НЕ НастройкиБизнесПроцессов = Ложь Тогда
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов, АдресаПеременных);	
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиБизнесПроцессов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат НастройкиБизнесПроцессов;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = Новый Массив();
	ИндексыНастройкиБизнесПроцессов = Новый Соответствие;
	
	Если ID_ТекущегоУзла = ID_Узла Тогда
		// В функцию передан Ид текущего узла, значения настроек БП содержатся в кэше
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ГлЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов(АдресаПеременных);
	Иначе
		// Настроек БП нет в кэше, получаем их для переданного Ид узла из базы Клеверенс                                                        		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ГлЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла, АдресаПеременных);
	КонецЕсли;
	
	// НастройкиБизнесПроцессов_ПоУмолчанию и СтруктураНастроекБизнесПроцессов_Пользовательские не отличаются для разных узлов
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 		= ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
	СтруктураНастроекБизнесПроцессов_Пользовательские 	= ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
	
	НастройкиБизнесПроцессов_ПоУмолчанию 				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_Пользовательские 			= СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	
	ИдТиповыхБП = Новый Массив();
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПоУмолчанию);
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Истина);
				НастройкиБизнесПроцессов.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаБП));
				ИндексыНастройкиБизнесПроцессов.Вставить(СтрокаБП.ID_БизнесПроцесса, НастройкиБизнесПроцессов.ВГраница());
				ИдТиповыхБП.Добавить(СтрокаБП.ID_БизнесПроцесса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_Пользовательские);
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
			Если ТипЗнч(СтрокаБП) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Ложь);
				Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
					НастройкиБизнесПроцессов.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаБП));
					ИндексыНастройкиБизнесПроцессов.Вставить(СтрокаБП.ID_БизнесПроцесса, НастройкиБизнесПроцессов.ВГраница());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоГлавныйУзел = НЕ ЗначениеЗаполнено(ID_Узла);
	
	// Переопределение пользовательских настроек главного узла
	Если НЕ ЭтоГлавныйУзел Тогда
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ГлЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS("", АдресаПеременных);
		НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел.НастройкиБизнесПроцессов;
	Иначе
		НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = НастройкиБизнесПроцессов_ПользовательскиеНастройки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел);
		КонецЕсли;
		
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Индекс = ИндексыНастройкиБизнесПроцессов.Получить(СтрокаБП.ID_БизнесПроцесса);
			Если Индекс <> Неопределено Тогда
				
				// Переключатель для отключения пользовательских настроек для ТП
				#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
					Если СтрокаБП.Свойство("ИспользоватьТиповыеНастройки") И СтрокаБП.ИспользоватьТиповыеНастройки = Истина Тогда
						НастройкиБизнесПроцессов[Индекс].Вставить("ИспользоватьТиповыеНастройки", Истина);
						
					ИначеЕсли СтрокаБП.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(СтрокаБП.ПереопределяемыеНастройки) Тогда
						НастройкиБизнесПроцессов[Индекс] = ГлЯдро_ОбъединитьСтруктуруНастроек(НастройкиБизнесПроцессов[Индекс], СтрокаБП.ПереопределяемыеНастройки);
					КонецЕсли;
				#Иначе
					НастройкиБизнесПроцессов[Индекс].Вставить("ИспользоватьТиповыеНастройки", Истина);
				#КонецЕсли
			
				Если НастройкиБизнесПроцессов[Индекс].Свойство("ПереопределяемыеНастройки") Тогда
					НастройкиБизнесПроцессов[Индекс].Удалить("ПереопределяемыеНастройки");
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НастройкиБизнесПроцессов[Индекс], СтрокаБП);
				
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Переопределение пользовательских настроек пользовательских узлов
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	ПользовательскиеНастройкиГлавногоУзла = КатегорииНастроекMS.ПользовательскиеНастройкиГлавногоУзла; 
	
	Если НЕ ЭтоГлавныйУзел И ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПользовательскиеНастройки);
		КонецЕсли;
		
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Индекс = ИндексыНастройкиБизнесПроцессов.Получить(СтрокаБП.ID_БизнесПроцесса);
			Если Индекс <> Неопределено Тогда
				
				Для Каждого КлючИЗначение Из СтрокаБП Цикл
					Если ПользовательскиеНастройкиГлавногоУзла.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НастройкиБизнесПроцессов[Индекс].Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЦикла;
				
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Обновляем значения кэшируемых настроек
	ГлЯдро_СохранитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов, ID_Узла, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиБизнесПроцессов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат НастройкиБизнесПроцессов;
	
КонецФункции

Процедура ГлЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПроизвольныеКоды = ГлЯдро_ПолучитьЗначениеКэшируемойНастройки("ПроизвольныеКоды", "", АдресаПеременных);
	Если ЗначениеЗаполнено(ПроизвольныеКоды) И НЕ ПроизвольныеКоды = Ложь Тогда
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды", ПроизвольныеКоды, АдресаПеременных);	
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПроизвольныеКоды = Новый Массив();
	ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию",,АдресаПеременных);
	ПроизвольныеКоды_Пользовательские = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские",,АдресаПеременных);
	
	Если ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию) И НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("Строка") Тогда
			ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_ПоУмолчанию);
		КонецЕсли;
		Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			ПроизвольныеКоды_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ПроизвольныеКоды_ПоУмолчанию);
		КонецЕсли;
		Для Каждого СтрокаПК Из ПроизвольныеКоды_ПоУмолчанию Цикл
			Если НЕ СтрокаПК.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаПК.Вставить("ЭтоТиповой",Истина);
				ПроизвольныеКоды.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПК));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские) И НЕ ПроизвольныеКоды_Пользовательские = Ложь Тогда
		Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("Строка") Тогда
			ПроизвольныеКоды_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_Пользовательские);
		КонецЕсли;
		Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			ПроизвольныеКоды_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ПроизвольныеКоды_Пользовательские);
		КонецЕсли;
		Для Каждого СтрокаПК Из ПроизвольныеКоды_Пользовательские Цикл
			Если НЕ СтрокаПК.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаПК.Вставить("ЭтоТиповой",Ложь);
				ПроизвольныеКоды.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаПК));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды", ПроизвольныеКоды,АдресаПеременных);

	// Обновляем значения кэшируемых настроек
	ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды", 					ПроизвольныеКоды, 					"", АдресаПеременных);
	ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды_ПоУмолчанию", 		ПроизвольныеКоды_ПоУмолчанию, 		"", АдресаПеременных);
	ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды_Пользовательские", 	ПроизвольныеКоды_Пользовательские, 	"", АдресаПеременных);

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров(АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ГлобальныеПараметры = ГлЯдро_ПолучитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", "", АдресаПеременных);
	Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры", ГлобальныеПараметры, АдресаПеременных);	
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ГлобальныеПараметры = Новый Массив();
	ГлобальныеПараметры_ПоУмолчанию 	 = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_ПоУмолчанию",, АдресаПеременных);
	ГлобальныеПараметры_Пользовательские = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_Пользовательские",, АдресаПеременных);
	
	Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) ИЛИ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		ГлобальныеПараметры_ПоУмолчанию = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры",,, АдресаПеременных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(ГлобальныеПараметры_ПоУмолчанию) = Тип("Строка") Тогда
			ГлобальныеПараметры_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(ГлобальныеПараметры_ПоУмолчанию);
		КонецЕсли;
		Если ТипЗнч(ГлобальныеПараметры_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			ГлобальныеПараметры_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ГлобальныеПараметры_ПоУмолчанию);
		КонецЕсли;
		Для каждого СтрокаГП ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
			Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаГП.Вставить("Типовой", Истина);
				ГлобальныеПараметры.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаГП));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь Тогда
		Если ТипЗнч(ГлобальныеПараметры_Пользовательские) = Тип("Строка") Тогда
			ГлобальныеПараметры_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(ГлобальныеПараметры_Пользовательские);
		КонецЕсли;
		Если ТипЗнч(ГлобальныеПараметры_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			ГлобальныеПараметры_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ГлобальныеПараметры_Пользовательские);
		КонецЕсли;
		Для каждого СтрокаГП ИЗ ГлобальныеПараметры_Пользовательские Цикл
			Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
				НайденныйПараметр = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаГП.ID_Параметра);
				Если НайденныйПараметр <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаГП.Вставить("Типовой", Ложь);
				ГлобальныеПараметры.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаГП));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры", ГлобальныеПараметры, АдресаПеременных);
	
	// Обновляем значения кэшируемых настроек
	ГлЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", ГлобальныеПараметры, "", АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Дополняет настройки торговых объектов настройками главного узла
Процедура ГлЯдро_СобратьОбщуюСтруктуруОтборов(РежимОбмена, ID_Узла = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_СобратьОбщуюСтруктуруОтборов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ID_Узла",
		РежимОбмена, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ID_Узла = Неопределено Тогда
		ID_Узла = "";
		ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
		Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") Тогда
			ID_Узла = ДанныеТекущегоУзла.ID_Узла;		
		КонецЕсли;
	КонецЕсли;
	
	НастройкиОтборов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена,, АдресаПеременных);
	
	// Настройки главного узла - при их отсутствии - получаем из настроек по умолчанию (с сохранением в базу и кеш)
	Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда
		Если НЕ ЗначениеЗаполнено(НастройкиОтборов)	ИЛИ НастройкиОтборов = Ложь Тогда
			// На всякий случай дополнительно проверим наличие настроек в базе, а не только в кэше, чтобы ничего не потерять
			НастройкиОтборов = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_Узла,, АдресаПеременных);
			
			Если НЕ ЗначениеЗаполнено(НастройкиОтборов) ИЛИ НастройкиОтборов = Ложь Тогда
				НастройкиОтборов_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_ПоУмолчанию_" + РежимОбмена,, АдресаПеременных);
				Если ЗначениеЗаполнено(НастройкиОтборов_ПоУмолчанию) И НЕ НастройкиОтборов_ПоУмолчанию = Ложь Тогда
					ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов_ПоУмолчанию, ID_Узла, АдресаПеременных);
					ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов_ПоУмолчанию, АдресаПеременных);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	// Настройки торгового объекта - при их отсутствии - получаем из настроек главного узла (с сохранением в кеш)
	Иначе
		НастройкиОтборов_ГлавныйУзел = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, "",, АдресаПеременных);
		Если НЕ ЗначениеЗаполнено(НастройкиОтборов_ГлавныйУзел) ИЛИ НастройкиОтборов_ГлавныйУзел = Ложь Тогда
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НастройкиОтборов) И НЕ НастройкиОтборов = Ложь Тогда
			Для каждого СтрокаНастройки ИЗ НастройкиОтборов_ГлавныйУзел Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
								
				СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				МассивСтрок = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборов, СтруктураОтбора);
				Если МассивСтрок = Неопределено Тогда
					НастройкиОтборов.Добавить(СтрокаНастройки);
				КонецЕсли;
			КонецЦикла;
		Иначе
			НастройкиОтборов = НастройкиОтборов_ГлавныйУзел;
		КонецЕсли;
		
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_СобратьНастройкиОбменаСправочников(ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_СобратьНастройкиОбменаСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НастройкаИзменена = Ложь;
	
	НастройкиКПолучению = Новый Структура("НастройкиОбменаСправочников, НастройкиОбменаСправочников_ПоУмолчанию");
	ЗначенияНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,,,, АдресаПеременных);
	
	НастройкиОбменаСправочников_Пользовательские = ЗначенияНастроек.НастройкиОбменаСправочников;
	НастройкиОбменаСправочников_ПоУмолчанию = ЗначенияНастроек.НастройкиОбменаСправочников_ПоУмолчанию;
	
	НастройкиОбменаСправочников = Новый Массив;
	КолонкиТаблицы = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
	НастройкиОбменаСправочников.Добавить(ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	
	СписокИспользуемыхСправочников = ГлЯдро_ПолучитьСписокИспользуемыхСправочников(АдресаПеременных);
	
	СписокСохраненныхИмен = Новый СписокЗначений;
	СписокСтрокКУдалению = Новый СписокЗначений;
	Если НЕ НастройкиОбменаСправочников_Пользовательские = Ложь И ЗначениеЗаполнено(НастройкиОбменаСправочников_Пользовательские) Тогда
		Для Каждого СтрокаНастройки Из НастройкиОбменаСправочников_Пользовательские Цикл
			Если СтрокаНастройки.Свойство("КолонкиТаблицыЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			
			// Определение признака Типовой для совместимости со старыми настройками
			Если НЕ СтрокаНастройки.Свойство("Типовой") Тогда
				НоваяСтрока.Типовой = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы) <> Неопределено;
				НастройкаИзменена = Истина;
			КонецЕсли;
			
			// Временное решение для совместимости с сохраненными настройками от старых версий
			// в настройки сохранялся СписокЗначений, в новой версии разделил на ИмяТаблицы и ИмяТаблицыПредставление для возможности сохранения в файл
			Если ТипЗнч(СтрокаНастройки.ИмяТаблицы) = Тип("ЭлементСпискаЗначений") Тогда
				НоваяСтрока.ИмяТаблицы = СтрокаНастройки.ИмяТаблицы.Значение;
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы.Значение);
			Иначе
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы);
			КонецЕсли;
			// конец
			
			// в интеграционной обработке прописывается использование справочника в зависимости от значения констант в 1С
			// проверяем, если что-то отключили, то удалим такие типовые строки
			ЭлементСписка = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы);
			Если ЭлементСписка <> Неопределено Тогда
				НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			ИначеЕсли НЕ НоваяСтрока.Типовой Тогда
				НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			Иначе
				НастройкаИзменена = Истина;
			КонецЕсли;
				
		КонецЦикла;
	КонецЕсли;
	
	НастройкиКПолучению = Новый Структура;
	// Устарело. Получаем ключи Выгружать_Сразу для совместимости
	// Выгрузку новых справочников добавлять в НастройкиБизнесПроцессов_ПоУмолчанию
	СоответствиеКлючейВыгружатьСразу = ГлЯдро_СоответствиеСправочниковКлючамВыгружатьСразу();
	Для каждого КлючЗначение Из СоответствиеКлючейВыгружатьСразу Цикл
		НастройкиКПолучению.Вставить(КлючЗначение.Значение);
	КонецЦикла;
	// --- 
	
	СправочникиВыгружатьПоУмолчанию = Неопределено;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	ИменаТаблицSMARTS = Новый Массив; // Проверяем наличие таблицы в MS
	Для каждого СтрокаТаблицы Из СтруктураМетаданных.Tables Цикл
		ИменаТаблицSMARTS.Добавить(СтрокаТаблицы.Представление);
	КонецЦикла;
	ИменаТаблицSMARTS.Добавить("Номенклатура");
	ИменаТаблицSMARTS.Добавить("Ячейки");
	
	Для Каждого ИмяСправочника ИЗ СписокИспользуемыхСправочников Цикл
		Если СписокСохраненныхИмен.НайтиПоЗначению(ИмяСправочника.Значение) = Неопределено 
			И ИменаТаблицSMARTS.Найти(ИмяСправочника.Значение) <> Неопределено Тогда
			
			СправочникИмя = ИмяСправочника.Значение;
			
			НоваяСтрока = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			
			НастройкиПоУмолчанию = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", СправочникИмя);
			Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НастройкиПоУмолчанию);
			КонецЕсли;
			
			Если НастройкиПоУмолчанию = Неопределено ИЛИ НЕ НастройкиПоУмолчанию.Свойство("Выгружать") Тогда
				// +++ Устарело
				// настройки для каждого справочника лежат в отдельных ключах, поэтому проверяем так
				// Выгрузку новых справочников добавлять в НастройкиБизнесПроцессов_ПоУмолчанию
				Если СправочникиВыгружатьПоУмолчанию = Неопределено Тогда
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("НеПроверятьАктуальность", Истина);
					СправочникиВыгружатьПоУмолчанию = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,,, ДополнительныеПараметры, АдресаПеременных);
				КонецЕсли;
				
				ИмяКлючаВыгружатьСразу = СоответствиеКлючейВыгружатьСразу.Получить(ИмяСправочника.Значение);
				Если ИмяКлючаВыгружатьСразу <> Неопределено Тогда
					НоваяСтрока.Выгружать = СправочникиВыгружатьПоУмолчанию[ИмяКлючаВыгружатьСразу] = Истина;
				КонецЕсли;
				// --- 
			КонецЕсли;
			
			НоваяСтрока.ИмяТаблицы 				= СправочникИмя;
			НоваяСтрока.ИмяТаблицыПредставление = ИмяСправочника.Представление;
			НоваяСтрока.Типовой 				= Истина;
			
			НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			НастройкаИзменена = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкаИзменена Тогда
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОбменаСправочников", НастройкиОбменаСправочников,, АдресаПеременных);
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОбменаСправочников", НастройкиОбменаСправочников,АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

