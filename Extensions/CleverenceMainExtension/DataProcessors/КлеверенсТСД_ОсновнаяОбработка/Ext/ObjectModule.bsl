Функция ГлЯдро_ПроверитьНаличиеИсключительнойСитуацииONLEX(АдресаПеременных)
	
	ОписаниеОшибки = КомЯдро_ПолучитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", АдресаПеременных);
	
	Если НЕ ТипЗнч(ОписаниеОшибки) = Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КодОшибкиONLEX = Неопределено;
	Если ОписаниеОшибки.Свойство("КодОшибкиONLEX") И ЗначениеЗаполнено(ОписаниеОшибки.КодОшибкиONLEX) Тогда
		КодОшибкиONLEX = ОписаниеОшибки.КодОшибкиONLEX;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодОшибкиONLEX) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПараметровONLEX = Неопределено;
	Если ОписаниеОшибки.Свойство("СтруктураПараметровONLEX") И ЗначениеЗаполнено(ОписаниеОшибки.СтруктураПараметровONLEX) Тогда
		СтруктураПараметровONLEX = ОписаниеОшибки.СтруктураПараметровONLEX;	
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", Неопределено, АдресаПеременных);
	
	ТекстОшибкиONLEX = ГлЯдро_ПолучитьТекстОшибкиONLEX(КодОшибкиONLEX, СтруктураПараметровONLEX);
	Возврат ТекстОшибкиONLEX;
	
КонецФункции

Функция ГлЯдро_ПолучитьТекстОшибкиONLEX(КодОшибки, СтруктураПараметров)

	ОписаниеОшибки = "Неизвестная ошибка";
	
	Если НЕ ЗначениеЗаполнено(КодОшибки) Тогда
		Возврат ОписаниеОшибки;
	КонецЕсли;
	
	СтрокаПодключения  	= "[не удалось определить строку подключения к базе Клеверенс]";
	ИмяПользователяВ1С 	= "[не удалось определить имя пользователя]";
	ОшибкаПодключенияИО = "";
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		Если СтруктураПараметров.Свойство("СтрокаПодключения") И ЗначениеЗаполнено(СтруктураПараметров.СтрокаПодключения) Тогда
			СтрокаПодключения = СтруктураПараметров.СтрокаПодключения;
		КонецЕсли;	
		Если СтруктураПараметров.Свойство("ИмяПользователяВ1С") И ЗначениеЗаполнено(СтруктураПараметров.ИмяПользователяВ1С) Тогда
			ИмяПользователяВ1С = СтруктураПараметров.ИмяПользователяВ1С;
		КонецЕсли;
		Если СтруктураПараметров.Свойство("ОшибкаПодключенияИО") И ЗначениеЗаполнено(СтруктураПараметров.ОшибкаПодключенияИО) Тогда
			ОшибкаПодключенияИО = СтруктураПараметров.ОшибкаПодключенияИО;
			ЗавершающийСимвол = Прав(ОшибкаПодключенияИО, 1);
			Если НЕ (ЗавершающийСимвол = "." ИЛИ ЗавершающийСимвол = "!") Тогда
				ОшибкаПодключенияИО = ОшибкаПодключенияИО + ".";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ТекстОшибкиONLEX003 = ГлЯдро_СтрШаблон("Код ошибки: #ONLEX003. Не настроена работа под пользователем ""%2"" в 1С. Не удалось подключиться к базе Клеверенс: %1 по настройкам подключения в основной обработке Клеверенс! Скопируйте настройки подключения пользователю ""%2"" в настройках обработки или запустите её в 1С под этим пользователем. Подробнее смотрите на сайте по коду ошибки!",
		СтрокаПодключения, ИмяПользователяВ1С);
	
	КодыОшибок = Новый Структура;
	КодыОшибок.Вставить("ONLEX001", "Код ошибки: #ONLEX001. Загрузка данного документа в учетную систему - не произведена по причине отсутствия бизнес-процесса для него. Проверьте настройки бизнес-процессов в обработке для 1С общие или для выбранного торгового объекта - если используется. Подробнее смотрите на сайте по коду ошибки!");
	КодыОшибок.Вставить("ONLEX002", "Код ошибки: #ONLEX002. " + ?(ЗначениеЗаполнено(ОшибкаПодключенияИО), ОшибкаПодключенияИО, "Не подключена интеграционная обработка.") + " Подробнее смотрите на сайте по коду ошибки!");
	КодыОшибок.Вставить("ONLEX003", ТекстОшибкиONLEX003);
	КодыОшибок.Вставить("ONLEX004", "Код ошибки: #ONLEX004. Не удалось распознать JSON во входящем параметре mXmlDoc. Возможно, в настройках базы Клеверенс установлен режим XML. Проверьте настройки подключения в основной обработке и перезапустите сервер Клеверенс. Подробнее смотрите на сайте по коду ошибки!");
	КодыОшибок.Вставить("ONLEX005", "Код ошибки: #ONLEX005. Серверу 1С не удается создать COM-компоненту Клеверенс (StorageConnector) в расширении CleverenceWebExtension. Подробнее смотрите на сайте по коду ошибки!");
	КодыОшибок.Вставить("ONLEX006", "Код ошибки: #ONLEX006. Включите объект сессии в настройках событий сервера в панели управления Клеверенс. Подробнее смотрите на сайте по коду ошибки!");
	КодыОшибок.Вставить("ONLEX007", "Код ошибки: #ONLEX007. Отсутствуют сохраненные данные проверки и подбора маркированной продукции! Подробности см. в журнале регистрации 1С.");
	
	Если КодыОшибок.Свойство(КодОшибки) Тогда
		ОписаниеОшибки = КодыОшибок[КодОшибки];
		
		// Экранирование символов
		ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "\", "\\");
	КонецЕсли;
	
	Возврат ОписаниеОшибки;
	
КонецФункции

Функция ГлЯдро_ПолучитьТекстовоеПредставлениеПараметров(СтруктураПараметров)
	
	ПредставлениеПараметров	= "";
	
	ПараметрНоменклатуры 	= Неопределено;
	ПараметрУпаковки 		= Неопределено;
	
	Если СтруктураПараметров.Свойство("ПараметрНоменклатуры", ПараметрНоменклатуры) И ЗначениеЗаполнено(ПараметрНоменклатуры) Тогда
		ТекстПараметрНоменклатуры = "";
		Если ТипЗнч(ПараметрНоменклатуры) = Тип("Строка") Тогда
			ТекстПараметрНоменклатуры = ПараметрНоменклатуры;
		ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("Массив") И ПараметрНоменклатуры.Количество() Тогда
			КоличествоЭлементов = ПараметрНоменклатуры.Количество();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Для Индекс = 0 ПО КоличествоВыводить Цикл
				Номенклатура = ПараметрНоменклатуры.Получить(Индекс);
				ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры + ?(Индекс = 0, "", " ,") + СокрЛП(Номенклатура);
			КонецЦикла;
			ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры 
				+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
				+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
		ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("COMSafeArray") И ПараметрНоменклатуры.GetLength() Тогда
			КоличествоЭлементов = ПараметрНоменклатуры.GetLength();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Для Индекс = 0 ПО КоличествоВыводить Цикл
				Номенклатура = ПараметрНоменклатуры.GetValue(Индекс);
				ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры + ?(Индекс = 0, "", " ,") + СокрЛП(Номенклатура);
			КонецЦикла;
			ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры 
				+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
				+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
		ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("Соответствие") Тогда 
			МассивНоменклатуры = ПараметрНоменклатуры.Получить("$values");
			
			КоличествоЭлементов = МассивНоменклатуры.Количество();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Если КоличествоЭлементов Тогда
				Для Индекс = 0 ПО КоличествоВыводить Цикл
					Номенклатура = МассивНоменклатуры.Получить(Индекс);
					ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры + ?(Индекс = 0, "", " ,") + СокрЛП(Номенклатура);
				КонецЦикла;
				ТекстПараметрНоменклатуры = ТекстПараметрНоменклатуры 
					+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
					+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстПараметрНоменклатуры) Тогда
			ПредставлениеПараметров = ПредставлениеПараметров + ", ПараметрНоменклатуры: " + ТекстПараметрНоменклатуры;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ПараметрУпаковки", ПараметрУпаковки) И ЗначениеЗаполнено(ПараметрУпаковки) Тогда
		ТекстПараметрУпаковки = "";
		Если ТипЗнч(ПараметрУпаковки) = Тип("Строка") Тогда
			ТекстПараметрУпаковки = ПараметрУпаковки;
		ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("Массив") И ПараметрУпаковки.Количество() Тогда
			КоличествоЭлементов = ПараметрУпаковки.Количество();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Для Индекс = 0 ПО КоличествоВыводить Цикл
				Упаковка = ПараметрУпаковки.Получить(Индекс);
				ТекстПараметрУпаковки = ТекстПараметрУпаковки + ?(Индекс = 0, "", " ,") + СокрЛП(Упаковка);
			КонецЦикла;
			ТекстПараметрУпаковки = ТекстПараметрУпаковки
				+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
				+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
		ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("COMSafeArray") И ПараметрУпаковки.GetLength() Тогда
			КоличествоЭлементов = ПараметрУпаковки.GetLength();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Для Индекс = 0 ПО КоличествоВыводить Цикл
				Упаковка = ПараметрУпаковки.GetValue(Индекс);
				ТекстПараметрУпаковки = ТекстПараметрУпаковки + ?(Индекс = 0, "", " ,") + СокрЛП(Упаковка);
			КонецЦикла;
			ТекстПараметрУпаковки = ТекстПараметрУпаковки
				+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
				+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
		ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("Соответствие") Тогда 
			МассивУпаковок = ПараметрУпаковки.Получить("$values");
			
			КоличествоЭлементов = МассивУпаковок.Количество();
			КоличествоВыводить = Мин(КоличествоЭлементов - 1, 1);
			
			Если КоличествоЭлементов Тогда
				Для Индекс = 0 ПО КоличествоВыводить Цикл
					Упаковка = МассивУпаковок.Получить(Индекс);
					ТекстПараметрУпаковки = ТекстПараметрУпаковки + ?(Индекс = 0, "", " ,") + СокрЛП(Упаковка);
				КонецЦикла;
				ТекстПараметрУпаковки = ТекстПараметрУпаковки
					+ ?(КоличествоЭлементов > КоличествоВыводить + 1, "...", "") 
					+ " (" + Формат(КоличествоЭлементов, "ЧГ=0") + " шт.)";
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстПараметрУпаковки) Тогда
			ПредставлениеПараметров = ПредставлениеПараметров + ", ПараметрУпаковки: " + ТекстПараметрУпаковки;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ПредставлениеПараметров;
	
КонецФункции

Функция ГлЯдро_ПолучитьТекстовоеПредставление_УсловиеОтбора(ПараметрыОнлайн, ТипИнтерфейса)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыОнлайн) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ПараметрыОнлайн.IsGroup Тогда
		Возврат ГлЯдро_ПолучитьТекстовоеПредставление_ГруппаОтбора(ПараметрыОнлайн, ТипИнтерфейса);
	Иначе
		Возврат ГлЯдро_ПолучитьТекстовоеПредставление_СравнениеОтбора(ПараметрыОнлайн);
	КонецЕсли;

КонецФункции

Функция ГлЯдро_ПолучитьТекстовоеПредставление_ГруппаОтбора(ПараметрыОнлайн, ТипИнтерфейса)
	
	КоличествоЭлементов = ПараметрыОнлайн.Elements.Count();
	Если КоличествоЭлементов = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТипГруппы = НРег(ПараметрыОнлайн.GroupTypeStr);
	
	ТекстГруппы = "";
	
	КоличествоВыводить = Мин(КоличествоЭлементов - 1, 2);
	
	Для Индекс = 0 По КоличествоВыводить Цикл
		Если ТипИнтерфейса = "REST_API" Тогда
			ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Получить(Индекс);
		Иначе
			ПодчиненныеПараметрыОнлайн = ПараметрыОнлайн.Elements.Item(Индекс);
		КонецЕсли;
		
		ТекстУсловия = ГлЯдро_ПолучитьТекстовоеПредставление_УсловиеОтбора(ПодчиненныеПараметрыОнлайн, ТипИнтерфейса);
		
		Если НЕ ПустаяСтрока(ТекстУсловия) Тогда
			ТекстГруппы = ТекстГруппы + ?(ПустаяСтрока(ТекстГруппы), "", ГлЯдро_СтрШаблон(" %1 ", ТипГруппы))
				+ ТекстУсловия;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоЭлементов > КоличествоВыводить + 1 Тогда
		ТекстГруппы = ТекстГруппы + ГлЯдро_СтрШаблон(" ... (%1 усл.)", Формат(КоличествоЭлементов, "ЧГ=0"));
	КонецЕсли;
	
	Возврат ТекстГруппы; // Сложные условия не приходят, скобки необязательны
	
КонецФункции

Функция ГлЯдро_ПолучитьТекстовоеПредставление_СравнениеОтбора(ПараметрыОнлайн)
	
	ПараметрыОнлайнДляОтбора = Новый Структура("RightValue");
	Если ТипЗнч(ПараметрыОнлайн) = Тип("Структура")
		ИЛИ ТипЗнч(ПараметрыОнлайн) = Тип("COMОбъект") Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыОнлайнДляОтбора, ПараметрыОнлайн);
	КонецЕсли;
		
	Если ПустаяСтрока(ПараметрыОнлайнДляОтбора["RightValue"]) Тогда
		ПараметрыОнлайнДляОтбора["RightValue"] = """""";
	КонецЕсли;
	
	Возврат ГлЯдро_СтрШаблон("%1 %2 %3",
		ПараметрыОнлайн.LeftValue,
		ПараметрыОнлайн.ComparisonTypeStr,
		ПараметрыОнлайнДляОтбора["RightValue"]);
	
КонецФункции

// Представление имени типа документа Клеверенс с пробелами в виде, доступном для использования в 1С
// Пример: "Документ с некорректным именем" преобразуется в "ДокументСНекорректнымИменем"
//
Функция ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ИмяДокумента)
	
	МассивЭлементовИмени = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ИмяДокумента, " ");
	Если МассивЭлементовИмени.Количество() = 1 Тогда
		Возврат ИмяДокумента;
	КонецЕсли;
	
	НовоеНаименование = "";
	
	Для Каждого Слово Из МассивЭлементовИмени Цикл
		ПерваяБуква = Лев(Слово, 1);
		ОстальнаяЧастьСлова = Прав(Слово, СтрДлина(Слово) - 1);
		НовоеНаименование = НовоеНаименование + ВРег(ПерваяБуква) + ОстальнаяЧастьСлова;
	КонецЦикла;
	
	Возврат НовоеНаименование;
	
КонецФункции

// Возвращаемое значение:
//	- Истина - если хотя бы одна упаковка была преобразована
//	- Ложь 	 - если ни одна упаковка не была преобразована
Функция ГлЯдро_УдалитьПостфиксыУпаковок(ПараметрУпаковки)

	ПерезаполнитьПараметрУпаковки = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ПараметрУпаковки) Тогда
		Возврат ПерезаполнитьПараметрУпаковки;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрУпаковки) = Тип("Строка") Тогда
		ПозицияПодчеркивания = ГлЯдро_СтрНайти(ПараметрУпаковки, "_");
		Если ПозицияПодчеркивания > 0 Тогда
			ПараметрУпаковки = Лев(ПараметрУпаковки, ПозицияПодчеркивания - 1);
			ПерезаполнитьПараметрУпаковки = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("Массив") Тогда
		Для каждого Упаковка ИЗ ПараметрУпаковки Цикл
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(Упаковка, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				Упаковка = Лев(Упаковка, ПозицияПодчеркивания - 1);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;					
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("COMSafeArray") Тогда
		КоличествоЭлементов = ПараметрУпаковки.GetLength();
		Для Индекс = 0 ПО КоличествоЭлементов - 1 Цикл
			Упаковка = ПараметрУпаковки.GetValue(Индекс);
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(Упаковка, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				Упаковка = Лев(Упаковка, ПозицияПодчеркивания - 1);
				ПараметрУпаковки.SetValue(Индекс, Упаковка);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;					
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрУпаковки) = Тип("Соответствие") Тогда 
		МассивУпаковок = ПараметрУпаковки.Получить("$values");
		Для каждого Упаковка ИЗ МассивУпаковок Цикл
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(Упаковка, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				Упаковка = Лев(Упаковка, ПозицияПодчеркивания - 1);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;					
		КонецЦикла;
		ПараметрУпаковки.Вставить("$values", МассивУпаковок);
	КонецЕсли;
	
	Возврат ПерезаполнитьПараметрУпаковки;

КонецФункции

// Возвращаемое значение:
//	Структура:
//		- ТаблицаИсходныхПараметров - содержит исходные значения параметров ПараметрНоменклатуры и ПараметрУпаковки
//		- ПерезаполнитьПараметрУпаковки - Булево:
//			- Истина - если хотя бы одна упаковка была преобразована
//			- Ложь 	 - если ни одна упаковка не была преобразована
Функция ГлЯдро_УдалитьПостфиксыУпаковокИСкопироватьПараметры(ПараметрНоменклатуры, ПараметрУпаковки)

	ПерезаполнитьПараметрУпаковки = Ложь;
	
	ТаблицаИсходныхПараметров = Новый ТаблицаЗначений;
	ТаблицаИсходныхПараметров.Колонки.Добавить("ИдТовара");
	ТаблицаИсходныхПараметров.Колонки.Добавить("ИдУпаковкиБезПостфикса");
	ТаблицаИсходныхПараметров.Колонки.Добавить("ИдУпаковки");
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ТаблицаИсходныхПараметров",	  ТаблицаИсходныхПараметров);
	СтруктураРезультата.Вставить("ПерезаполнитьПараметрУпаковки", ПерезаполнитьПараметрУпаковки);
	
	// Исходим из того, что ПараметрНоменклатуры и ПараметрУпаковки имеют одинаковый тип и одинаковое количество элементов, если это коллекция
	Если ТипЗнч(ПараметрНоменклатуры) <> ТипЗнч(ПараметрУпаковки) Тогда
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрНоменклатуры) = Тип("Строка") Тогда
		НоваяСтрока	= ТаблицаИсходныхПараметров.Добавить();
		НоваяСтрока.ИдТовара 	= ПараметрНоменклатуры;
		НоваяСтрока.ИдУпаковки	= ПараметрУпаковки;
		
		ПозицияПодчеркивания = ГлЯдро_СтрНайти(ПараметрУпаковки, "_");
		Если ПозицияПодчеркивания > 0 Тогда
			ПараметрУпаковки = Лев(ПараметрУпаковки, ПозицияПодчеркивания - 1);
			ПерезаполнитьПараметрУпаковки = Истина;
		КонецЕсли;
		
		НоваяСтрока.ИдУпаковкиБезПостфикса = ПараметрУпаковки;
	ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("Массив") Тогда
		Если ПараметрНоменклатуры.Количество() <> ПараметрУпаковки.Количество() Тогда
			Возврат СтруктураРезультата;	
		КонецЕсли;
		
		Для Индекс = 0 ПО ПараметрНоменклатуры.Количество() - 1 Цикл
			ИдТовара   = ПараметрНоменклатуры.Получить(Индекс);
			ИдУпаковки = ПараметрУпаковки.Получить(Индекс);
			
			НоваяСтрока	= ТаблицаИсходныхПараметров.Добавить();
			НоваяСтрока.ИдТовара 	= ИдТовара;
			НоваяСтрока.ИдУпаковки	= ИдУпаковки;
			
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(ИдУпаковки, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				ИдУпаковки = Лев(ИдУпаковки, ПозицияПодчеркивания - 1);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;
			
			НоваяСтрока.ИдУпаковкиБезПостфикса = ИдУпаковки;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("COMSafeArray") Тогда
		Если ПараметрНоменклатуры.GetLength() <> ПараметрУпаковки.GetLength() Тогда
			Возврат СтруктураРезультата;	
		КонецЕсли;
		
		Для Индекс = 0 ПО ПараметрНоменклатуры.GetLength() - 1 Цикл
			ИдТовара   = ПараметрНоменклатуры.GetValue(Индекс);
			ИдУпаковки = ПараметрУпаковки.GetValue(Индекс);
			
			НоваяСтрока	= ТаблицаИсходныхПараметров.Добавить();
			НоваяСтрока.ИдТовара 	= ИдТовара;
			НоваяСтрока.ИдУпаковки	= ИдУпаковки;
			
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(ИдУпаковки, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				ИдУпаковки = Лев(ИдУпаковки, ПозицияПодчеркивания - 1);
				ПараметрУпаковки.SetValue(Индекс, ИдУпаковки);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;
			
			НоваяСтрока.ИдУпаковкиБезПостфикса = ИдУпаковки;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрНоменклатуры) = Тип("Соответствие") Тогда 
		МассивТоваров  = ПараметрНоменклатуры.Получить("$values");
		МассивУпаковок = ПараметрУпаковки.Получить("$values");
		
		Если МассивТоваров.Количество() <> МассивУпаковок.Количество() Тогда
			Возврат СтруктураРезультата;	
		КонецЕсли;
		
		Для Индекс = 0 ПО МассивТоваров.Количество() - 1 Цикл
			ИдТовара   = МассивТоваров.Получить(Индекс);
			ИдУпаковки = МассивУпаковок.Получить(Индекс);
			
			НоваяСтрока	= ТаблицаИсходныхПараметров.Добавить();
			НоваяСтрока.ИдТовара 	= ИдТовара;
			НоваяСтрока.ИдУпаковки	= ИдУпаковки;
			
			ПозицияПодчеркивания = ГлЯдро_СтрНайти(ИдУпаковки, "_");
			Если ПозицияПодчеркивания > 0 Тогда
				ИдУпаковки = Лев(ИдУпаковки, ПозицияПодчеркивания - 1);
				ПерезаполнитьПараметрУпаковки = Истина;
			КонецЕсли;
			
			НоваяСтрока.ИдУпаковкиБезПостфикса = ИдУпаковки;
		КонецЦикла;
		
		Если ПерезаполнитьПараметрУпаковки Тогда
			ПараметрУпаковки.Вставить("$values", МассивУпаковок);	
		КонецЕсли
	КонецЕсли;
	
	Если ПерезаполнитьПараметрУпаковки Тогда
		СтруктураРезультата.Вставить("ТаблицаИсходныхПараметров",	  ТаблицаИсходныхПараметров);
		СтруктураРезультата.Вставить("ПерезаполнитьПараметрУпаковки", ПерезаполнитьПараметрУпаковки);
	КонецЕсли;
	
	Возврат СтруктураРезультата;

КонецФункции

Процедура ГлЯдро_ВосстановитьПостфиксыУпаковок(ТаблицаТоваров, ТаблицаИсходныхПараметров)
	
	ТаблицаИсходныхПараметров.Свернуть("ИдТовара, ИдУпаковкиБезПостфикса, ИдУпаковки");
					
	Для Индекс = 0 ПО ТаблицаТоваров.Количество() - 1 Цикл
		СтрокаТовара = ТаблицаТоваров[Индекс];
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИдТовара",				СтрокаТовара.Product_Id);
		СтруктураПоиска.Вставить("ИдУпаковкиБезПостфикса", 	СтрокаТовара.Packing_Id);
		
		ПерваяСтрока = Истина;
		
		НайденныеСтроки = ТаблицаИсходныхПараметров.НайтиСтроки(СтруктураПоиска);
		Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
			Если ПерваяСтрока Тогда
				СтрокаТовара.Packing_Id = НайденнаяСтрока.ИдУпаковки;
				
				ПерваяСтрока = Ложь;
			Иначе	
				// Если в исходных параметрах было несколько упаковок с разными постфиксами для одного товара, 
				//	строки результирующей таблицы дублируем по количеству таких упаковок
				НоваяСтрока = ТаблицаТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
				СтрокаТовара.Packing_Id = НайденнаяСтрока.ИдУпаковки;
			КонецЕсли;
	    КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьДанныеТаблицыПоАртикулуКодуШК(ПараметрНоменклатуры, НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПолучитьДанныеТаблицыПоАртикулуКодуШК";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрНоменклатуры,НастройкиКомпоновщика,ПараметрыУзлов,ПараметрыОнлайн,РаботаБезАлкоголя,ПараметрыВыгрузки",
		ПараметрНоменклатуры, НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если СтрДлина(ПараметрНоменклатуры) <> 14 Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый ТаблицаЗначений);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
			
	Если Лев(ПараметрНоменклатуры, 1) <> "0" Тогда
		ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS("Номенклатура", НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
		Если ТаблицаТоваров.Количество() Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТаблицаТоваров);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат ТаблицаТоваров;
		Иначе
			ПараметрНоменклатуры = ГлЯдро_ПреобразоватьGTIN_В_EAN(ПараметрНоменклатуры);
			СтруктураШтрихкода 	 = ГлЯдро_ПолучитьСтруктуруШтрихкодаEAN13(ПараметрНоменклатуры, АдресаПеременных);
			
			ПараметрыОнлайн.Вставить("ПараметрНоменклатуры", ПараметрНоменклатуры);
			ПараметрыОнлайн.Вставить("СтруктураШтрихкода",   СтруктураШтрихкода);
		КонецЕсли;				
	КонецЕсли;			
			
	// При сканировании кода маркировки может прийти 14-значный GTIN с 0 впереди, а в 1С храниться только 8-значный EAN8 или 13-значный EAN13		
	Количество0 = 0;
	Если Лев(ПараметрНоменклатуры, 6) = "000000" Тогда
		Количество0 = 6;
	ИначеЕсли Лев(ПараметрНоменклатуры, 1) = "0" Тогда
		Количество0 = 1;
	КонецЕсли;

	КодСтрока = ПараметрыОнлайн.СтруктураШтрихкода.КодСтрока;
	
	Если Количество0 Тогда
		ПараметрНоменклатурыБез0 = Прав(ПараметрНоменклатуры, 14 - Количество0);
		ПараметрыОнлайн.Вставить("ПараметрНоменклатуры", ПараметрНоменклатурыБез0);
		ПараметрыОнлайн.СтруктураШтрихкода.Вставить("КодСтрока", ПараметрНоменклатурыБез0);
					
		ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS("Номенклатура", НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
		
		Если НЕ ТаблицаТоваров.Количество() Тогда
			ПараметрыОнлайн.Вставить("ПараметрНоменклатуры", ПараметрНоменклатуры);
			ПараметрыОнлайн.СтруктураШтрихкода.Вставить("КодСтрока", КодСтрока);
						
			ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS("Номенклатура", НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);	
		КонецЕсли;
	Иначе				
		ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS("Номенклатура", НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТаблицаТоваров);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ТаблицаТоваров;	

КонецФункции

#Область СерверКачества

Процедура ГлЯдро_СерверКачества_НачатьПроверкуОшибок(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	ИмяСобытия = "ГлЯдро_СерверКачества_НачатьПроверкуОшибок";
	
	АдресаПеременных = ПараметрыВыполнения.ЗначенияПеременных;
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибки", Ложь);
	Результат.Вставить("ОшибкиСтрокой");
	Результат.Вставить("ГлубинаОтбора", ПараметрыВыполнения.ГлубинаОтбора);
	Результат.Вставить("СрокДоСледующейПроверки", ПараметрыВыполнения.СрокДоСледующейПроверки);
	Результат.Вставить("ДатаТекущейПроверки", ПараметрыВыполнения.ДатаТекущейПроверки);
	
	ДанныеЖурнала = ГлЯдро_СерверКачества_ОтобратьОшибкиЖурналаРегистрации(ПараметрыВыполнения.ДатаТекущейПроверки, ПараметрыВыполнения.ГлубинаОтбора);
	
	Если НЕ ДанныеЖурнала.Количество() Тогда
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("SD_ОтложитьПроверкуНаДату", ПараметрыВыполнения.ДатаТекущейПроверки + 86400 * ПараметрыВыполнения.ГлубинаОтбора,, АдресаПеременных);
		ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Результат.ЕстьОшибки = Истина;
	Результат.ОшибкиСтрокой = ГлЯдро_СерверКачества_СформироватьТекстЛогаИзТаблицы(ДанныеЖурнала, АдресаПеременных);
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_СерверКачества_ПроверитьДоступностьСервера(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СерверКачества_ПроверитьДоступностьСервера";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", "GET");
	СтруктураЗапроса.Вставить("СжиматьJSON", Ложь);
	СтруктураЗапроса.Вставить("ВернутьСтроку", Истина);
	СтруктураЗапроса.Вставить("Метод", "health-check");
	СтруктураЗапроса.Вставить("ЗапросКВнешнемуРесурсу", Истина);
	
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(ГлЯдро_СерверКачества_URLСервера());
	Ответ = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, "", АдресаПеременных);
	
	СерверДоступен = REST_API_КодСостоянияУспешно(Ответ.КодСостояния);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СерверДоступен);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СерверДоступен;
	
КонецФункции 

Функция ГлЯдро_СерверКачества_ОтобратьОшибкиЖурналаРегистрации(ДатаПроверки, ГлубинаОтбора, РучноеФормирование = Ложь)
	
	ДатаНачала = НачалоДня(ДатаПроверки) - 86400 * ГлубинаОтбора;
	
	СтруктураФильтра = Новый Структура;
	СтруктураФильтра.Вставить("ДатаНачала", ДатаНачала);
	СтруктураФильтра.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	СтруктураФильтра.Вставить("Данные", "MobileSMARTSLog");
	
	КолонкиЖурнала = "Дата,Событие,Комментарий,Сеанс,ИмяПользователя, ПредставлениеПриложения";
	
	ДанныеЖурнала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ДанныеЖурнала,СтруктураФильтра,КолонкиЖурнала);
	
	Если ДанныеЖурнала.Колонки.Найти("Дата") = Неопределено Тогда
		пДанныеЖурнала = Новый ТаблицаЗначений;
		пДанныеЖурнала.Колонки.Добавить("Дата");
		пДанныеЖурнала.Колонки.Добавить("Событие");
		пДанныеЖурнала.Колонки.Добавить("Комментарий");
		пДанныеЖурнала.Колонки.Добавить("Сеанс");
		пДанныеЖурнала.Колонки.Добавить("ИмяПользователя");
		пДанныеЖурнала.Колонки.Добавить("ПредставлениеПриложения");
		
		Для каждого СобытиеЖурнала Из ДанныеЖурнала Цикл
			НоваяСтрока = пДанныеЖурнала.Добавить();
			НоваяСтрока.Дата 								= СобытиеЖурнала.Date;
			НоваяСтрока.Событие 						= СобытиеЖурнала.Event;
			НоваяСтрока.Комментарий 					= СобытиеЖурнала.Comment;
			НоваяСтрока.Сеанс 							= СобытиеЖурнала.Session;
			НоваяСтрока.ИмяПользователя 				= СобытиеЖурнала.UserName;
			НоваяСтрока.ПредставлениеПриложения 	= СобытиеЖурнала.ApplicationPresentation;
		КонецЦикла;
		
		ДанныеЖурнала = пДанныеЖурнала;
	КонецЕсли;
	
	ДанныеЖурнала.Сортировать("Дата");
	
	МассивОтобранныхСобытий = Новый Массив();
	ПроверяемаяДата = ДатаНачала;
	Для каждого СобытиеЖурнала Из ДанныеЖурнала Цикл
		Если ГлЯдро_СтрНайти(СобытиеЖурнала.Событие, "КлеверенсТСД") Тогда
			
			МассивОтобранныхСобытий.Добавить(СобытиеЖурнала);
			
			Если НЕ РучноеФормирование Тогда
				ДатаОшибки = НачалоДня(СобытиеЖурнала.Дата);
				Если ДатаОшибки = ПроверяемаяДата Тогда
					Продолжить;
				ИначеЕсли ДатаОшибки = ПроверяемаяДата + 86400 И МассивОтобранныхСобытий.Количество() > 1 Тогда
					ПроверяемаяДата = ПроверяемаяДата + 86400;
				Иначе
					Возврат Новый ТаблицаЗначений;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеЖурнала.Скопировать(МассивОтобранныхСобытий);
	
КонецФункции

Функция ГлЯдро_СерверКачества_СформироватьТекстЛогаИзТаблицы(ДанныеЖурнала, АдресаПеременных)
	
	ДанныеЖурналаТекст = "";
	RU = ДанныеЖурнала.Колонки.Найти("Дата") <> Неопределено;
	Для Каждого Строка Из ДанныеЖурнала Цикл
		Если RU Тогда
			СтрокаЛога = Строка(Строка.Дата)+Символы.Таб+Строка(Строка.Сеанс)+Символы.Таб+Строка.ПредставлениеПриложения+Символы.Таб+Строка.ИмяПользователя+Символы.Таб+СтрЗаменить(Строка.Событие,"КлеверенсАвтотесты.","")+Символы.Таб+Строка.Комментарий;
			КолонкаУровня = "Уровень";
		Иначе
			СтрокаЛога = Строка(Строка.Date)+Символы.Таб+Строка(Строка.Session)+Символы.Таб+Строка.ApplicationPresentation+Символы.Таб+Строка.UserName+Символы.Таб+СтрЗаменить(Строка.Event,"КлеверенсАвтотесты.","")+Символы.Таб+Строка.Comment;
			КолонкаУровня = "Level";
		КонецЕсли;
		ДанныеЖурналаТекст = ДанныеЖурналаТекст+СтрокаЛога+Символы.ПС;		
	КонецЦикла;
	
	Возврат ДанныеЖурналаТекст;
	
КонецФункции

Функция ГлЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер(ДанныеОбращения, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеОбращения",
		ДанныеОбращения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Новый Структура;
	Результат.Вставить("ОтчетОтправлен", Ложь);
	Результат.Вставить("НомерОбращения");
	
	РезультатЗаписиФайлов = ГлЯдро_СерверКачества_ОтправитьФайлыНаСервер(ДанныеОбращения, АдресаПеременных);
	
	Если НЕ РезультатЗаписиФайлов.ФайлыЗаписаны Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	ДанныеОбращения.Вставить("ИдентификаторыФайлов", РезультатЗаписиФайлов.ИдентификаторыФайлов);
	РезультатФормированияОтчета = ГлЯдро_СерверКачества_СформироватьОтчетВJira(ДанныеОбращения, АдресаПеременных);
	
	Если НЕ РезультатФормированияОтчета.ОтчетОтправлен Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	Результат = РезультатФормированияОтчета;
	
	пСообщение = НСтр("ru = 'Обращение в Jira успешно создано. Номер обращения: %1';
						|en = 'A request to Jira has been successfully created. Request number: %1';
						|be = 'Зварот у Jira паспяхова створана. Нумар звароту: %1'; es = 'La apelación a Jira se ha creado con éxito. Número de referencia: %1'; ka = 'ჯირას თხოვნა წარმატებით შეიქმნა. მოთხოვნის ნომერი: %1'; kk = 'Jira-ға үндеу сәтті жасалды. Өтініш нөмірі: %1'; ro = 'O cerere către Jira a fost creată cu succes. Număr cerere: %1'; tr = 'Jira''ya itiraz başarıyla oluşturuldu. Dolaşım numarası: %1'; uk = 'Звернення в Jira успішно створено. Номер звернення: %1'; uz = 'Jira-ga murojaat muvaffaqiyatli yaratildi. Murojaat raqami: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Результат.НомерОбращения);
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_СерверКачества_ОтправитьФайлыНаСервер(ДанныеОбращения, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_СерверКачества_ОтправитьФайлыНаСервер";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеОбращения",
		ДанныеОбращения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТелоСтрокой = ДанныеОбращения.ШапкаЛога + Символы.ПС + ДанныеОбращения.ОшибкиСтрокой;
	СжатыеДанные = ГлЯдро_ЗашифроватьZIP(ТелоСтрокой, "txt", Истина);
	
	МассивСтруктурКПреобразовнаию = Новый Массив;
	ПараметрыЗначения = Новый Структура;
	ПараметрыЗначения.Вставить("КлючЗначения", "files");
	ПараметрыЗначения.Вставить("ИмяФайла", "Logs_sd_" + Формат(ДанныеОбращения.ДатаТекущейПроверки, "ДФ=dd_MM_yyyy" + ".zip"));
	ПараметрыЗначения.Вставить("ТипЗначения", "application/x-zip-compressed");
	ПараметрыЗначения.Вставить("ЗначениеДанных", СжатыеДанные.ДвоичныеДанные);
	МассивСтруктурКПреобразовнаию.Добавить(ПараметрыЗначения);
	
	ТелоВMultipart = REST_API_ПреобразоватьТелоВMultipart(МассивСтруктурКПреобразовнаию);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + ТелоВMultipart.Разделитель);
	Заголовки.Вставить("Content-Length", ТелоВMultipart.Размер);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", "POST");
	СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
	СтруктураЗапроса.Вставить("Заголовки", Заголовки);
	СтруктураЗапроса.Вставить("СжиматьJSON", Ложь);
	СтруктураЗапроса.Вставить("Метод", "attachments");
	СтруктураЗапроса.Вставить("ЗапросКВнешнемуРесурсу", Истина);
	
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(ГлЯдро_СерверКачества_URLСервера());
	СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ТелоВMultipart.ДвоичныеДанные, АдресаПеременных);
	
	РезультатЗаписиФайлов = Новый Структура;
	РезультатЗаписиФайлов.Вставить("ФайлыЗаписаны", Ложь);
	РезультатЗаписиФайлов.Вставить("ИдентификаторыФайлов");
	
	Если REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния)
		И СтруктураОтвета.Свойство("ОтветСервера") Тогда
		
		Если ТипЗнч(СтруктураОтвета.ОтветСервера) = Тип("Структура") Тогда
			РезультатЗаписиФайлов.ИдентификаторыФайлов = СтруктураОтвета.ОтветСервера.items;
			РезультатЗаписиФайлов.ФайлыЗаписаны = Истина;
		Иначе
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка отправки файлов на сервер качества: %1';
								|en = 'Error sending files to the quality server: %1'; be = 'Памылка адпраўкі файлаў на сервер якасці: %1'; es = 'Error al enviar archivos al servidor de calidad: %1'; ka = 'შეცდომა გაგზავნის ფაილი ხარისხის სერვერზე: %1'; kk = 'Файлдарды сапа серверіне жіберу қатесі: %1'; ro = 'Eroare la trimiterea fișierelor către serverul de calitate: %1'; tr = 'Kalite sunucusuna dosya gönderme hatası: %1'; uk = 'Помилка надсилання файлів на сервер якості: %1'; uz = 'Fayllarni sifat serveriga yuborishda xato: %1'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), СтруктураОтвета.ОтветСервера);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ОтветСервера",
				СтруктураОтвета.ОтветСервера);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			// </Лог>
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗаписиФайлов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатЗаписиФайлов;
	
КонецФункции 

Функция ГлЯдро_СерверКачества_СформироватьОтчетВJira(ДанныеОбращения, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СерверКачества_СформироватьОтчетВJira";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеОбращения",
		ДанныеОбращения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", "POST");
	СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
	СтруктураЗапроса.Вставить("Заголовки", Заголовки);
	СтруктураЗапроса.Вставить("СжиматьJSON", Ложь);
	СтруктураЗапроса.Вставить("Метод", "tickets/jira");
	СтруктураЗапроса.Вставить("ЗапросКВнешнемуРесурсу", Истина);
	
	ДанныеПользователя = ДанныеОбращения.ДанныеПользователя;
	
	МассивИдентификаторовФайлов = Новый Массив;
	МассивСсылкиФайлов = Новый Массив;
	
	Если ДанныеОбращения.Свойство("ИдентификаторыФайлов") Тогда
		Для каждого СтруктураФайла Из ДанныеОбращения.ИдентификаторыФайлов Цикл
			МассивИдентификаторовФайлов.Добавить(СтруктураФайла.id);
			МассивСсылкиФайлов.Добавить(СтруктураФайла.url);
		КонецЦикла;
	КонецЕсли;
	
	
	Тело = Новый Структура;
	Тело.Вставить("fCs", 				ДанныеПользователя.ФИО);
	Тело.Вставить("email", 			ДанныеПользователя.Почта);
	Тело.Вставить("phone", 			ДанныеПользователя.НомерТелефона);
	Тело.Вставить("description", 		ДанныеПользователя.Описание);
	Тело.Вставить("applicationMS", 	"MDP");
	Тело.Вставить("initiator", 			"user");
	Тело.Вставить("attachments", 		МассивИдентификаторовФайлов);
	
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(ГлЯдро_СерверКачества_URLСервера());
	СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, Тело, АдресаПеременных);
	
	РезультатФормированияОтчета = Новый Структура;
	РезультатФормированияОтчета.Вставить("ОтчетОтправлен", Ложь);
	РезультатФормированияОтчета.Вставить("НомерОбращения");
	РезультатФормированияОтчета.Вставить("СсылкиФайлов");
	
	Если REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния)
		И СтруктураОтвета.Свойство("ОтветСервера") Тогда
		
		Если ТипЗнч(СтруктураОтвета.ОтветСервера) = Тип("Структура") Тогда
			РезультатФормированияОтчета.ОтчетОтправлен = Истина;
			РезультатФормированияОтчета.НомерОбращения = СтруктураОтвета.ОтветСервера.number;
			РезультатФормированияОтчета.СсылкиФайлов = МассивСсылкиФайлов;
		Иначе
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка формирования отчета в Jira: %1';
								|en = 'Error generating the report in Jira: %1'; be = 'Памылка фарміравання справаздачы ў Jira: %1'; es = 'Error al generar el informe en Jira: %1'; ka = 'ანგარიშის გენერირების შეცდომა ჯირაში: %1'; kk = 'Jira-да есеп беру қатесі: %1'; ro = 'Eroare la generarea raportului în Jira: %1'; tr = 'Jira''da rapor oluşturma hatası: %1'; uk = 'Помилка формування звіту в Jira: %1'; uz = 'Jira-da hisobotni tuzishda xato: %1'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), СтруктураОтвета.ОтветСервера);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ОтветСервера",
				СтруктураОтвета.ОтветСервера);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			// </Лог>
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатФормированияОтчета);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатФормированияОтчета;
	
КонецФункции 

