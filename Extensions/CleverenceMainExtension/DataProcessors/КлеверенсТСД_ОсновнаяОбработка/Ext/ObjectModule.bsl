Функция ГлЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла = "", АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовНаСервереSMARTS("ВерсияНастроек", "НастройкиБизнесПроцессов_ПользовательскиеНастройки", ID_Узла, АдресаПеременных);	
	
КонецФункции

Функция ГлЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовПоУмолчаниюНаСервереSMARTS(ID_Узла = "", АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовНаСервереSMARTS("ВерсияНастроек_ПоУмолчанию", "НастройкиБизнесПроцессов_ПоУмолчанию", ID_Узла, АдресаПеременных);	
	
КонецФункции

Функция ГлЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовНаСервереSMARTS(ВерсияНастроекИмя = "", НастройкиБизнесПроцессовИмя = "", ID_Узла, АдресаПеременных) Экспорт
	
	СтруктураВозврат = Новый Структура("ВерсияНастроек,НастройкиБизнесПроцессов", Неопределено, Неопределено);	
	
	пСтруктураНастроек = Новый Структура;
	пСтруктураНастроек.Вставить(НастройкиБизнесПроцессовИмя, Ложь);
	пСтруктураНастроек.Вставить(ВерсияНастроекИмя, Ложь); 
	
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(пСтруктураНастроек,, ID_Узла,, АдресаПеременных);		
	СтруктураНастроекБизнесПроцессов = СтруктураНастроек[НастройкиБизнесПроцессовИмя];
		
	Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврат, СтруктураНастроекБизнесПроцессов);		
	Иначе		
		СтруктураВозврат.ВерсияНастроек 			= СтруктураНастроек[ВерсияНастроекИмя];
		СтруктураВозврат.НастройкиБизнесПроцессов 	= СтруктураНастроекБизнесПроцессов;
	КонецЕсли;                 	
	
	Возврат СтруктураВозврат;
	
КонецФункции

// Возвращает версию структуры настроек из структуры СведенияОВнешнейОбработке
//
Функция ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки() Экспорт
	
	Возврат СведенияОВнешнейОбработке().ВерсияСтруктурыНастроек;
	
КонецФункции

// Возвращает признак использования новых настроек в базе
//
Функция ГлЯдро_ПроверитьИспользованиеНовойСтруктурыНастроекБизнесПроцессов(АдресаПеременных) Экспорт
	
	НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
	
	НетТиповыхНастроек = (НастройкиБизнесПроцессов_ПоУмолчанию = Неопределено Или НастройкиБизнесПроцессов_ПоУмолчанию = Ложь);
	
	ИспользоватьСтруктуру = НетТиповыхНастроек Или ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Структура");
	
	Возврат ИспользоватьСтруктуру;
	
КонецФункции

Функция ГлЯдро_ДеревоПользователейВоВременноеХранилище(СписокПользователейMS) Экспорт
	Если ТипЗнч(СписокПользователейMS)  <> Тип("СписокЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли; 

	ПользователиMS = Новый ДеревоЗначений;
	ПользователиMS.Колонки.Добавить("Выгружать", 			Новый ОписаниеТипов("Булево"), "Выгружать");
	ПользователиMS.Колонки.Добавить("ГруппаПользователь", 	Новый ОписаниеТипов("Строка"), "Группа/пользователь");
	ПользователиMS.Колонки.Добавить("ИдГруппыПользователя", Новый ОписаниеТипов("Строка"), "Ид группы/пользователя");	
	
	Для Каждого Пользователь из СписокПользователейMS Цикл
		
		ИдИИмяПользователя 	= ГлЯдро_РазложитьСтрокуВМассивПодстрок(Пользователь.Значение, 		";");
		ИдИИмяГруппы 		= ГлЯдро_РазложитьСтрокуВМассивПодстрок(Пользователь.Представление, ";");
		
		Если ИдИИмяГруппы.Количество() >= 2 Тогда
			ИдГруппы  	= ИдИИмяГруппы[0];
			ИмяГруппы 	= ИдИИмяГруппы[1];			
		Иначе
			ИдГруппы 	= Неопределено;
			ИмяГруппы 	= Неопределено;			
		КонецЕсли;	
		
		ИдПользователя  = ИдИИмяПользователя[0];
		ИмяПользователя = ИдИИмяПользователя[1];		
		
		// Если у элемента нет группы, значит, элемент сам является группой, добавляем его в корень дерева пользователей Клеверенс
		Если ИдГруппы = Неопределено Тогда
			
			СтрокаДерева 						= ПользователиMS.Строки.Добавить();
			СтрокаДерева.ИдГруппыПользователя 	= ИдПользователя;
			СтрокаДерева.ГруппаПользователь 	= ИмяПользователя;					
			
		Иначе	
			
			// иначе - ищем группу в корне дерева
			СтрокаПоискаГруппы = ПользователиMS.Строки.Найти(ИдГруппы, "ИдГруппыПользователя");			
			
			// если не нашли, добавляем группу в корень дерева, а в группу - пользователя
			Если СтрокаПоискаГруппы = Неопределено Тогда
				
				СтрокаГруппы 						= ПользователиMS.Строки.Добавить();
				СтрокаГруппы.ИдГруппыПользователя 	= ИдГруппы;
				СтрокаГруппы.ГруппаПользователь 	= ИмяГруппы;
				
				СтрокаПользователя 						= СтрокаГруппы.Строки.Добавить();
				СтрокаПользователя.ИдГруппыПользователя = ИдПользователя;
				СтрокаПользователя.ГруппаПользователь 	= ИмяПользователя;			
				
			Иначе
				
				// иначе - добавляем в найденную группу пользователя
				СтрокаДерева 						= СтрокаПоискаГруппы.Строки.Добавить();
				СтрокаДерева.ИдГруппыПользователя 	= ИдПользователя;
				СтрокаДерева.ГруппаПользователь 	= ИмяПользователя;			
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ПоместитьВоВременноеХранилище(ПользователиMS,Новый УникальныйИдентификатор());
	
КонецФункции

Функция ГлЯдро_ДеревоУстройствВоВременноеХранилище(СписокУстройствMS, флЛегкоеОблако = Ложь)
	
	Если ТипЗнч(СписокУстройствMS) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли; 

	УстройстваMS = Новый ДеревоЗначений;
	УстройстваMS.Колонки.Добавить("Выгружать", 			  Новый ОписаниеТипов("Булево"), "Выгружать");
	Если флЛегкоеОблако Тогда
		УстройстваMS.Колонки.Добавить("ПинКод",   		  Новый ОписаниеТипов("Строка"), "Пин-код");
	КонецЕсли;
	УстройстваMS.Колонки.Добавить("ГруппаПользователь",   Новый ОписаниеТипов("Строка"), "Группа/пользователь");
	УстройстваMS.Колонки.Добавить("ИдГруппыПользователя", Новый ОписаниеТипов("Строка"), "Ид группы/пользователя");	
	
	Если флЛегкоеОблако = Ложь Тогда
		СтрокаДерева 						= УстройстваMS.Строки.Добавить();
		СтрокаДерева.ИдГруппыПользователя 	= "Выгружать всем";
		СтрокаДерева.ГруппаПользователь 	= "Выгружать всем";
		
		СтрокаДерева 						= УстройстваMS.Строки.Добавить();
		СтрокаДерева.ИдГруппыПользователя 	= "Спрашивать при выгрузке";
		СтрокаДерева.ГруппаПользователь 	= "Спрашивать при выгрузке";
	КонецЕсли;
	
	Для Каждого Устройство из СписокУстройствMS Цикл
		СтрокаДерева 						= УстройстваMS.Строки.Добавить();
		СтрокаДерева.ИдГруппыПользователя 	= Устройство.deviceId;
		СтрокаДерева.ГруппаПользователь 	= Устройство.deviceName;
		Если флЛегкоеОблако Тогда
			СтрокаДерева.ПинКод				= Устройство.pincode;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат ПоместитьВоВременноеХранилище(УстройстваMS, Новый УникальныйИдентификатор());
	
КонецФункции

Процедура ГлЯдро_ПересохранитьЗначенияПеременныхВФЗ(АдресаПеременных, МассивАдресовПустыхЗначений)

	ИмяСобытия = "ГлЯдро_ПересохранитьЗначенияПеременныхВФЗ";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивАдресовПустыхЗначений",
		МассивАдресовПустыхЗначений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Индекс = 0;
	
	КоличествоАдресовПустыхЗначений = МассивАдресовПустыхЗначений.Количество();
	
	// Пересохраняем значения, записанные в кэш в фоновом задании, т.к.
	// значение должно быть сохранено по адресу врем хранилища, переданному из родительского сеанса.
	// Делаем пересохранение в конце ФЗ, т.к. если это сделать в методе КомЯдро_СохранитьЗначениеПеременной, 
	// то значения не будут доступны в самом ФЗ	
	Для Каждого ЭлементАдресовПеременных Из АдресаПеременных Цикл
		
		Если ЭлементАдресовПеременных.Ключ = "ИдентификаторФормы"
			ИЛИ ЭлементАдресовПеременных.Ключ = "MSToken"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЭтоФоновоеЗадание"
			// Ключи логирования принадлежат родительскому сеансу. Перегон пустых значений из ФЗ
			// (после ЛогЗакрытьПоток) затирает клиентский поток через ЛокЯдро_ДополнитьСтруктуру
			// с Заменять=Истина — flow_finished не пишется, буфер не флашится.
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогПоток"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогПотокФЗ"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогСтекСобытий"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогБуферЗаписейСервер"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогБылиОшибки"
			ИЛИ ЭлементАдресовПеременных.Ключ = "ЛогРежимОтладкиES" Тогда
			// Не обрабатываем
			Продолжить;
		КонецЕсли;
		
		Если Не ЭтоАдресВременногоХранилища(ЭлементАдресовПеременных.Значение) И
			ЭлементАдресовПеременных.Значение <> Неопределено Тогда
			
			Если ТипЗнч(ЭлементАдресовПеременных.Значение) = Тип("Структура") Тогда
				СтруктураЭлементаАдресовПеременных = ЭлементАдресовПеременных.Значение;
				Для каждого ЭлементСтруктуры ИЗ СтруктураЭлементаАдресовПеременных Цикл
				    Если ЭтоАдресВременногоХранилища(ЭлементСтруктуры.Значение) Тогда
						Если Индекс >= КоличествоАдресовПустыхЗначений Тогда
							// <Лог>
							ЯзСтрока = "ru = 'Переполнение пула адресов пустых значений!';
												|en = 'Overflow of the address pool of empty values!'; be = 'Перапаўненне пула адрасоў пустых значэнняў!'; es = 'Desbordamiento del grupo de direcciones de valores vacíos!'; ka = 'Overflow მისამართი აუზი ცარიელი ღირებულებები!'; kk = 'Бос мәндердің мекен-жайларын толтыру!'; ro = 'Depășirea bazinului de adrese de valori goale!'; tr = 'Boş değerlerin adres havuzunun taşması!'; uk = 'Переповнення пулу адрес порожніх значень!'; uz = 'Bo''sh qiymat manzillari havzasini to''ldirish!'";
							пСообщение = НСтр(ЯзСтрока);
							
							ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
							// </Лог>
							Прервать;
						КонецЕсли;
						
						ЗначениеИзВременногоХранилища = ПолучитьИзВременногоХранилища(ЭлементСтруктуры.Значение);
						СтруктураЭлементаАдресовПеременных.Вставить(ЭлементСтруктуры.Ключ, ПоместитьВоВременноеХранилище(ЗначениеИзВременногоХранилища, МассивАдресовПустыхЗначений[Индекс]));
						Индекс = Индекс + 1;	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если Индекс >= КоличествоАдресовПустыхЗначений Тогда
				// <Лог>
				ЯзСтрока = "ru = 'Переполнение пула адресов пустых значений!';
									|en = 'Overflow of the address pool of empty values!'; be = 'Перапаўненне пула адрасоў пустых значэнняў!'; es = 'Desbordamiento del grupo de direcciones de valores vacíos!'; ka = 'Overflow მისამართი აუზი ცარიელი ღირებულებები!'; kk = 'Бос мәндердің мекен-жайларын толтыру!'; ro = 'Depășirea bazinului de adrese de valori goale!'; tr = 'Boş değerlerin adres havuzunun taşması!'; uk = 'Переповнення пулу адрес порожніх значень!'; uz = 'Bo''sh qiymat manzillari havzasini to''ldirish!'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
				// </Лог>
				Прервать;
			КонецЕсли;
			
			// Необходимо сохранить во врем хранилище по адресу, полученному из родительского сеанса
			АдресаПеременных.Вставить(ЭлементАдресовПеременных.Ключ, ПоместитьВоВременноеХранилище(ЭлементАдресовПеременных.Значение, МассивАдресовПустыхЗначений[Индекс]));
			
			Индекс = Индекс + 1;
		КонецЕсли;
	
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_СтрРазделитьЧерезЗапятую(Строка)	
	Возврат ГлЯдро_СтрРазделить(Строка, ",", Ложь);	
КонецФункции

Функция ГлЯдро_СимволЯвляетсяЧастьюИдентификатора(СтрокаПроверки, ПозицияСимвола)
	
	Если ПозицияСимвола < 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПозицияСимвола > СтрДлина(СтрокаПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПроверяемыйСимвол = Сред(СтрокаПроверки, ПозицияСимвола, 1);
	КодСимволаСтроки = КодСимвола(СтрокаПроверки, ПозицияСимвола);
	
	Возврат ПроверяемыйСимвол = "_"                                                   
		ИЛИ КодСимволаСтроки >= 48 И КодСимволаСтроки <= 57
		ИЛИ КодСимволаСтроки >= 65 И КодСимволаСтроки <= 90
		ИЛИ КодСимволаСтроки >= 97 И КодСимволаСтроки <= 122
		ИЛИ КодСимволаСтроки = 1025
		ИЛИ КодСимволаСтроки = 1105
		ИЛИ КодСимволаСтроки >= 1040 И КодСимволаСтроки <= 1071
		ИЛИ КодСимволаСтроки >= 1072 И КодСимволаСтроки <= 1103;
	
КонецФункции

// Заменяет подстроку только тогда, когда она является отдельным идентификатором.
Функция ГлЯдро_ЗаменитьОтдельноеСлово(ИсходнаяСтрока, ИскомаяПодстрока, СтрокаЗамены)
	
	Если СтрДлина(ИскомаяПодстрока) = 0 Тогда
		Возврат ИсходнаяСтрока;
	КонецЕсли;
	
	РезультирующаяСтрока = "";
	НачальнаяПозиция = 1;
	ДлинаИскомойПодстроки = СтрДлина(ИскомаяПодстрока);
	
	Пока НачальнаяПозиция <= СтрДлина(ИсходнаяСтрока) Цикл
		
		ПозицияПодстроки = ГлЯдро_СтрНайти(ИсходнаяСтрока, ИскомаяПодстрока, "СНачала", НачальнаяПозиция);
		Если ПозицияПодстроки = 0 Тогда
			РезультирующаяСтрока = РезультирующаяСтрока + Сред(ИсходнаяСтрока, НачальнаяПозиция);
			Прервать;
		КонецЕсли;
		
		РезультирующаяСтрока = РезультирующаяСтрока
			+ Сред(ИсходнаяСтрока, НачальнаяПозиция, ПозицияПодстроки - НачальнаяПозиция);
		
		ЭтоОтдельноеСлово = НЕ ГлЯдро_СимволЯвляетсяЧастьюИдентификатора(ИсходнаяСтрока, ПозицияПодстроки - 1)
			И НЕ ГлЯдро_СимволЯвляетсяЧастьюИдентификатора(ИсходнаяСтрока, ПозицияПодстроки + ДлинаИскомойПодстроки);
		Если ЭтоОтдельноеСлово Тогда
			РезультирующаяСтрока = РезультирующаяСтрока + СтрокаЗамены;
		Иначе
			РезультирующаяСтрока = РезультирующаяСтрока + ИскомаяПодстрока;
		КонецЕсли;
		
		НачальнаяПозиция = ПозицияПодстроки + ДлинаИскомойПодстроки;
		
	КонецЦикла;
	
	Возврат РезультирующаяСтрока;
	
КонецФункции

#КонецОбласти

#Область ГлобальныйКонтекст_Настройки_ПрочиеМетоды

// Получает подходящую настройку (настройки) бизнес-процесса
//
// Параметры:
//	ID_БизнесПроцесса - Строка - идентификатор бизнес-процесса, настройку которого необходимо получить	
//  ТипДокументаMS - Строка - тип документа Клеверенс, для которого выполняется получение настройки
//	НастройкиДляОбмена - Неопределено, ТаблицаЗначений, Массив из Структура - таблица настроек бизнес-процессов
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Неопределено - если получить подходящую настройку бизнес-процесса не удалось
//	- Структура - содержит:
//		* Статус - Булево - признак того, что получена единственная настройки
//      * Данные - Структура - содержит настройку бизнес-процесса, если она единственная
//				 - Массив из СтрокаТаблицыЗначений - если настройки бизнес-процессов хранятся в виде таблицы значений
//				 - Массив из Структура - если настройки бизнес-процессов хранятся в виде массива структур
Функция ГлЯдро_ПолучитьНастройкуБизнесПроцесса(ID_БизнесПроцесса, ТипДокументаMS, НастройкиДляОбмена = Неопределено, ВключаяОтключенные = Ложь, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьНастройкуБизнесПроцесса";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_БизнесПроцесса,ТипДокументаMS,НастройкиДляОбмена,ВключаяОтключенные",
		ID_БизнесПроцесса, ТипДокументаMS, НастройкиДляОбмена, ВключаяОтключенные);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Неопределено;
	
	Если НастройкиДляОбмена = Неопределено Тогда
		НастройкиДляОбмена = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",,АдресаПеременных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ID_БизнесПроцесса) Тогда
		Если ВключаяОтключенные = Истина Тогда
			Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		Иначе
			Отбор = Новый Структура("ID_БизнесПроцесса,Используется", ID_БизнесПроцесса, Истина);	
		КонецЕсли;
		Если ТипЗнч(НастройкиДляОбмена) = Тип("ТаблицаЗначений") Тогда
			ПодходящиеНастройки = НастройкиДляОбмена.НайтиСтроки(Отбор);
		Иначе
			ПодходящиеНастройки = ГлЯдро_СкопироватьМассив(НастройкиДляОбмена,Отбор);
		КонецЕсли;
	Иначе
		Если ВключаяОтключенные = Истина Тогда
			Отбор = Новый Структура("ТипДокументаMS,ТипИсходногоДокумента1С", ТипДокументаMS, "");
		Иначе
			Отбор = Новый Структура("ТипДокументаMS,ТипИсходногоДокумента1С,Используется", ТипДокументаMS, "", Истина);	
		КонецЕсли;
		Если ТипЗнч(НастройкиДляОбмена) = Тип("ТаблицаЗначений") Тогда
			ПодходящиеНастройки = НастройкиДляОбмена.НайтиСтроки(Отбор);
		Иначе
			ПодходящиеНастройки = ГлЯдро_СкопироватьМассив(НастройкиДляОбмена,Отбор);
		КонецЕсли;
	КонецЕсли;
	
	Если ПодходящиеНастройки = Неопределено Тогда
		Результат = Новый Структура("Статус, Данные", Ложь, ПодходящиеНастройки);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	Если ПодходящиеНастройки.Количество() = 1 Тогда
		СтрокаНастройки = ПодходящиеНастройки[0];
		Если ТипЗнч(НастройкиДляОбмена) = Тип("ТаблицаЗначений") Тогда 
			НастройкаБП = Новый Структура;
			Для Каждого Колонка Из НастройкиДляОбмена.Колонки Цикл
				НастройкаБП.Вставить(Колонка.Имя, СтрокаНастройки[Колонка.Имя]);
			КонецЦикла;
		Иначе
			НастройкаБП = СтрокаНастройки;
		КонецЕсли;
		Результат = Новый Структура("Статус,Данные", Истина, НастройкаБП);
	Иначе
		Результат = Новый Структура("Статус,Данные", Ложь, ПодходящиеНастройки);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции
 
// Получает сведения о внешней обработке по заданному ключу
//
// Параметры:
//	КлючИнформации - Строка - ключ сведений о внешней обработке, которые необходимо получить	
//
// Возвращаемое значение:
//  - Произвольный - значение, полученное из сведений о внешней обработке - см. СведенияОВнешнейОбработке
//	- Неопределено - если в сведениях о внешней обработке нет ключа, переданного в параметре КлючИнформации
Функция ГлЯдро_ПолучитьИнформациюОВнешнейОбработке(КлючИнформации) Экспорт
	
	ДанныеОбработки = Неопределено;
	
	ИнформацияОбработки = СведенияОВнешнейОбработке();
	Если ИнформацияОбработки.Свойство(КлючИнформации) Тогда
		ДанныеОбработки = ИнформацияОбработки[КлючИнформации];
	КонецЕсли;
	
	Возврат ДанныеОбработки;
	
КонецФункции

Функция ГлЯдро_НастройкиИзменились(АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_НастройкиИзменились";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Истина;
	
	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		И ПараметрыПодключенияMS.Свойство("Ид") Тогда
		ПостфиксБазы = СтрЗаменить(ПараметрыПодключенияMS.Ид,"-","_");
	Иначе
		
		Результат = Ложь;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат; //Вернем ложь т.к. все равно не можем ничего поделать :(
		
	КонецЕсли;
	
	ДатаАктуальностиНастроекв1С = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ДатаАктуальностиНастроек_"+ПостфиксБазы);
	
	ЭтоВнешнееСоединение = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	
	Если ЭтоWebСервис ИЛИ ЭтоВнешнееСоединение Тогда
		ДатаАктуальностиТекущихНастроек = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ДатаАктуальностиКэша");
	Иначе
		ДатаАктуальностиТекущихНастроек = КомЯдро_ПолучитьЗначениеПеременной("ДатаАктуальностиНастроек",АдресаПеременных);
	КонецЕсли;
		
	Если ДатаАктуальностиТекущихНастроек = Неопределено 
		ИЛИ ТипЗнч(ДатаАктуальностиТекущихНастроек) <> Тип("Дата") Тогда
		ДатаАктуальностиТекущихНастроек = ТекущаяДата();
		КомЯдро_СохранитьЗначениеПеременной("ДатаАктуальностиНастроек",ДатаАктуальностиТекущихНастроек,АдресаПеременных);
		Результат = Истина;
		
	ИначеЕсли ДатаАктуальностиНастроекв1С = Неопределено 
		ИЛИ ТипЗнч(ДатаАктуальностиНастроекв1С) <> Тип("Дата")
		ИЛИ ДатаАктуальностиНастроекв1С < ДатаАктуальностиТекущихНастроек Тогда
		Результат = Ложь;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Возвращает информацию об основной обработке
//
// Возвращаемое значение:
//   Структура - составные части URI согласно формату:
//		ПутьОсновнойОбработки 	- Строка, СправочникСсылка - путь основной обработки
//		ТипОсновнойОбработки 	- Строка - тип основной обработки. Например, "ФайлНаДиске", "СправочникСсылка", "Встроенная"
//		ИмяОсновнойОбработки 	- Строка - имя основной обработки
Функция ГлЯдро_ПолучитьИнформациюОсновнойОбработки() Экспорт
	
	ДанныеОсновнойОбработки = Новый Структура;
	
	#Область НесовместимыйКодFresh
	ПутьОсновнойОбработки 	= ЭтотОбъект.ИспользуемоеИмяФайла;
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//ПутьОсновнойОбработки = "";
	#КонецОбласти //СовместимыйКодFresh
	ТипОсновнойОбработки 	= "ФайлНаДиске";
	
	ИмяМетаданных = ЭтотОбъект.Метаданные().Имя;
	
	ДанныеОсновнойОбработки.Вставить("ПутьОсновнойОбработки", 	ПутьОсновнойОбработки);
	ДанныеОсновнойОбработки.Вставить("ТипОсновнойОбработки", 	ТипОсновнойОбработки);
	ДанныеОсновнойОбработки.Вставить("ИмяОсновнойОбработки", 	ИмяМетаданных);
	
	Возврат ДанныеОсновнойОбработки;
	
КонецФункции

// Получает признак использования в конфигурации дополнительных отчетов и обработок
//
// Возвращаемое значение:
//   Булево 	- использование в конфигурации дополнительных отчетов и обработок
//
Функция ГлЯдро_ПолучитьИспользованиеДополнительныхОтчетовИОбработок(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьИспользованиеДополнительныхОтчетовИОбработок";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Метаданные.Справочники.Найти("ВнешниеОбработки") <> Неопределено
			Или Метаданные.Справочники.Найти("ВнешниеПечатныеФормы") <> Неопределено Тогда
			Результат = Истина;
		КонецЕсли;
	#Иначе
		ФункцОпцияНеНайдена 			= Ложь;
		ИспользоватьДопОтчетыИОбработки = Ложь;
		
		Если Метаданные.ФункциональныеОпции.Найти("ИспользоватьДополнительныеОтчетыИОбработки") <> Неопределено Тогда
			ИмяКонстанты = Метаданные.ФункциональныеОпции.ИспользоватьДополнительныеОтчетыИОбработки.Хранение.Имя;
			ИспользоватьДопОтчетыИОбработки = Константы[ИмяКонстанты].Получить();
			//Включение использования доп отчетов и обработок
			Если Не ИспользоватьДопОтчетыИОбработки Тогда
				Попытка
					Константы[ИмяКонстанты].Установить(Истина);
					ИспользоватьДопОтчетыИОбработки = Истина;
				Исключение
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЯзСтрока = "ru = 'Ошибка установки значения константы %1';
										|en = 'Error setting the value of the constant %1'; be = 'Памылка ўстаноўкі значэння канстанты %1'; es = 'Error al establecer el valor de la constante %1'; ka = 'შეცდომა შექმნის ღირებულება მუდმივი %1'; kk = 'Тұрақты мәнді орнату қатесі %1'; ro = 'Eroare la setarea valorii constantei %1'; tr = '%1 sabitinin değerini ayarlama hatası'; uk = 'Помилка встановлення значення константи %1'; uz = 'Doimiy qiymatni o''rnatishda xato %1'";
					пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяКонстанты);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"ИмяКонстанты",
						ИмяКонстанты);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
					// </Лог>
				КонецПопытки;
			КонецЕсли;			
		Иначе
			ФункцОпцияНеНайдена = Истина;
		КонецЕсли;
		
		Если (ИспользоватьДопОтчетыИОбработки Или ФункцОпцияНеНайдена)
			И Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
			Результат = Истина;
		КонецЕсли;
		
	#КонецЕсли

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с именами расширений, где Ключ - некоторое внутреннее обозначение расширения, Значение - имя файла расширения
// В данной функции необходимо задавать имена файлов расширений, а в коде искать расширение по ключу
//
// Возвращаемое значение:
//   Структура   - структура имен расширений, где Ключ - некоторое внутреннее обозначение расширения, Значение - имя файла расширения
//
Функция ГлЯдро_ПолучитьСтруктуруИменРасширений() Экспорт

	СтруктураИменРасширений = Новый Структура;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		СтруктураИменРасширений.Вставить("РасширениеSSL", 				"CleverenceSSLExtension");
		СтруктураИменРасширений.Вставить("ОсновноеРасширение", 			"CleverenceMainExtension");
		СтруктураИменРасширений.Вставить("ИнтеграционноеРасширение", 	"CleverenceIntegrationExtension");	
		СтруктураИменРасширений.Вставить("РасширениеСКнопкамиОбмена", 	"CleverenceButtonsExtension");
		СтруктураИменРасширений.Вставить("РасширениеДляВебСервиса", 	"CleverenceWebExtension");
	#Иначе
		Если ГлЯдро_ОпределитьСовместимостьСРасширениями() Тогда
			
			СтруктураИменРасширений.Вставить("ОсновноеРасширение", 			"CleverenceMainExtension");
			СтруктураИменРасширений.Вставить("ИнтеграционноеРасширение", 	"CleverenceIntegrationExtension");		
			СтруктураИменРасширений.Вставить("РасширениеСКнопкамиОбмена", 	"CleverenceButtonsExtension");
			СтруктураИменРасширений.Вставить("РасширениеДляВебСервиса", 	"CleverenceWebExtension");
			
		КонецЕсли;	
	#КонецЕсли
	
	Возврат СтруктураИменРасширений;

КонецФункции

Функция ГлЯдро_ОпределитьСовместимостьСРасширениями()
	
	Попытка
		ВерсияСовместимости = ГлЯдро_ОпределитьВерсиюСовместимостиКонфигурации();
	Исключение
		ВерсияСовместимости = Неопределено;
	КонецПопытки;
	
	ТребуемаяВерсия= 8003009;
	Если НЕ ВерсияСовместимости = Неопределено И ВерсияСовместимости >= ТребуемаяВерсия Тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли;
	
КонецФункции 

Функция ГлЯдро_ОпределитьВерсиюСовместимостиКонфигурации()
	
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
		СисИнфо = Новый СистемнаяИнформация;
		
		ВерсияСовместимости = СисИнфо.ВерсияПриложения;
		
		ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимости, ".");
	Иначе
		ВерсияСовместимости = СтрЗаменить(СтрЗаменить(Строка(Метаданные.РежимСовместимости), "Версия", ""), "Version", "");
		
		ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимости, "_");
	КонецЕсли;
	
	ВерсияСовместимости = Число(ВерсияВМассив[0])*1000000
		+ Число(ВерсияВМассив[1])*1000
		+ Число(ВерсияВМассив[2]);
	
	Возврат ВерсияСовместимости;
	
КонецФункции

Функция ГлЯдро_ПолучитьПостфиксРасширенияMain(АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьПостфиксРасширенияMain";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПостфиксРасширенияMain = "";
	ПереходныеВерсииСовместимости = ГлЯдро_ПолучитьПереходныеВерсииСовместимости();
	Попытка	
		ВерсияСовместимости = ГлЯдро_ОпределитьВерсиюСовместимостиКонфигурации();
	
		Индекс = ПереходныеВерсииСовместимости.ВГраница();
		Пока Индекс >= 0 Цикл
			
			ПереходнаяВерсия = ПереходныеВерсииСовместимости[Индекс];
			
			Если ВерсияСовместимости >= ПереходнаяВерсия.ВерсияЧислом Тогда
				
				Если Индекс = ПереходныеВерсииСовместимости.ВГраница() Тогда
					// Это последняя стабильная версия совместимости (8_3_14).
					// Сначала попытаемся загрузить файл без постфикса, в котором не используется режим совместимости.
					// Если не удастся, загрузим файл с текущим стабильным постфиксом.
					
					Если Метаданные.ОсновнойРежимЗапуска = РежимЗапускаКлиентскогоПриложения.ОбычноеПриложение Тогда
						// Если конфигурация использует ОбычноеПриложение, то файл "без постфикса" гарантированно НЕ подойдёт.
						// В этом случае сразу берем стабильный постфикс.
						ПостфиксРасширенияMain = ГлЯдро_ПолучитьСтабильныйПостфиксРасширения("ОсновноеРасширение");
					КонецЕсли;
					
				Иначе
					// Применяем постфикс только для старых версий своместимости.
					ПостфиксРасширенияMain = "_" + ПереходнаяВерсия.ВерсияСтрокой;
				КонецЕсли;
				Прервать;
				
			КонецЕсли;
			
			Индекс =  Индекс - 1;
			
		КонецЦикла;
		
	Исключение
		пСообщение = НСтр("ru = 'Не удалось определить версию совместимости для загрузки расширения CleverenceMainExtension. Причина: %1';
							|en = 'The compatibility version for downloading the CleverenceMainExtension extension could not be determined. Reason: %1';
							|be = 'Не ўдалося вызначыць версію сумяшчальнасці для загрузкі пашырэння CleverenceMainExtension. Прычына: %1'; es = 'No se pudo determinar la versión de compatibilidad para descargar la extensión CleverenceMainExtension. Causa: %1'; ka = 'CleverenceMainExtension გაფართოების ჩამოტვირთვის თავსებადობის ვერსია ვერ განისაზღვრა. მიზეზი: %1'; kk = 'CleverenceMainExtension кеңейтімін жүктеу үшін үйлесімділік нұсқасын анықтау мүмкін болмады. Себебі: %1'; ro = 'Versiunea de compatibilitate pentru descărcarea extensiei CleverenceMainExtension nu a putut fi determinată. Motiv: %1'; tr = 'CleverenceMainExtension uzantısını indirmek için uyumluluk sürümü belirlenemedi. Sebep: % 1'; uk = 'Не вдалося визначити версію сумісності для завантаження розширення CleverenceMainExtension. Причина: %1'; uz = 'CleverenceMainExtension kengaytmasini yuklab olish uchun moslik versiyasini aniqlab bo''lmadi. Sababi: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
	КонецПопытки;
			
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ПостфиксРасширенияMain);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ПостфиксРасширенияMain;
	
КонецФункции

Функция ГлЯдро_ПолучитьПереходныеВерсииСовместимости()
	
	ВерсииСовместимости = Новый Массив;
	
	НоваяСтрока = Новый Структура("ВерсияСтрокой, ВерсияЧислом", "8_3_9", 0); // Начальная версия
	ВерсииСовместимости.Добавить(НоваяСтрока);
	
	НоваяСтрока = Новый Структура("ВерсияСтрокой, ВерсияЧислом", "8_3_11", 8003011);
	ВерсииСовместимости.Добавить(НоваяСтрока);
	
	// Последняя стабильная версия совместимости.
	// Загружается, если не удалось загрузить файл без указанного постфикса.
	НоваяСтрока = Новый Структура("ВерсияСтрокой, ВерсияЧислом", "8_3_14", 8003014);
	ВерсииСовместимости.Добавить(НоваяСтрока);
	
	Возврат ВерсииСовместимости;
	
КонецФункции 

// Получает постфикс последнего стабильного файла
Функция ГлЯдро_ПолучитьСтабильныйПостфиксРасширения(ТипРасширения) Экспорт
	
	СтабильныйПостфикс = "";
	
	Если ТипРасширения = "ОсновноеРасширение" Тогда
		
		ВерсииСовместимости = ГлЯдро_ПолучитьПереходныеВерсииСовместимости();
		ПоследняяВерсия = ВерсииСовместимости[ВерсииСовместимости.ВГраница()];
		СтабильныйПостфикс = "_" + ПоследняяВерсия.ВерсияСтрокой;
		
	КонецЕсли;
	
	Возврат СтабильныйПостфикс;
	
КонецФункции

Функция ГлЯдро_ПолучитьПостфиксРасширенияSSL(АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьПостфиксРасширенияSSL";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПостфиксРасширенияSSL = "";
	
    Если НЕ Метаданные.РегистрыСведений.Найти("ВерсииПодсистем") = Неопределено Тогда
		ИмяРегистра   = "ВерсииПодсистем";
		ИмяПодсистемы = "СтандартныеПодсистемы";
		ИмяИзмерения  = "ИмяПодсистемы";
		ИмяРесурса	  = "Версия";
		
		ПостфиксРасширенияSSL = "_RU";
	ИначеЕсли НЕ Метаданные.РегистрыСведений.Найти("SubsystemsVersions") = Неопределено Тогда
		ИмяРегистра   = "SubsystemsVersions";
		ИмяПодсистемы = "StandardSubsystems";
		ИмяИзмерения  = "SubsystemName";
		ИмяРесурса	  = "Version";
		
		ПостфиксРасширенияSSL = "_EN";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПостфиксРасширенияSSL) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВерсииПодсистем." + ИмяРесурса + " КАК Версия
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + " КАК ВерсииПодсистем
		|ГДЕ
		|	ВерсииПодсистем." + ИмяИзмерения + " = &ИмяПодсистемы";
		Запрос.УстановитьПараметр("ИмяПодсистемы", ИмяПодсистемы);
		
		УстановитьПривилегированныйРежим(Истина);
		
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
			// </Лог>
			
			Возврат "";	
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
			
		Если Выборка.Следующий() Тогда
			ВерсияПодсистемы = Выборка.Версия;
			ВерсияВМассив 	 = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияПодсистемы, ".");
			ВерсияПодсистемы = Число(ВерсияВМассив[0])*1000000000
				+ Число(ВерсияВМассив[1])*1000000
				+ Число(ВерсияВМассив[2])*1000
				+ Число(ВерсияВМассив[3]);
					
			Если ВерсияПодсистемы < 2004000000 Тогда
				ВерсияСтрокой = "_2_3_0";
			ИначеЕсли ВерсияПодсистемы < 3001008000 Тогда
				ВерсияСтрокой = "_3_1_0";
			Иначе
				ВерсияСтрокой = "_3_1_8";
			КонецЕсли;
				
			// Проверяем, не задано ли особое имя расширения в настройках базы Клеверенс
			ДополнительныйПостфикс = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПостфиксРасширенияSSL" + ВерсияСтрокой,, АдресаПеременных);
			Если ДополнительныйПостфикс = Неопределено ИЛИ ДополнительныйПостфикс = Ложь Тогда
				ДополнительныйПостфикс = "";
			КонецЕсли;
			
			ПостфиксРасширенияSSL = ПостфиксРасширенияSSL + ВерсияСтрокой + ДополнительныйПостфикс;
		Иначе
			ПостфиксРасширенияSSL = "";
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ПостфиксРасширенияSSL);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ПостфиксРасширенияSSL;
	
КонецФункции

Процедура ГлЯдро_ПодключитьИнтеграционнуюОбработкуРасширения(АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ПодключитьИнтеграционнуюОбработкуРасширения";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПодключитьИОРасширения = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ПодключитьИОРасширения",,, АдресаПеременных);
	Если НЕ ПодключитьИОРасширения = Истина Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	КонецЕсли;
	
    ТипОбработки = "Встроенная";
	
	Если ПараметрыПодключенияMS.Свойство("ТипОбработки") И ПараметрыПодключенияMS.ТипОбработки = ТипОбработки Тогда
		// Если уже используется встроенная обработка, переключаться на нее не нужно
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь,, АдресаПеременных);
	Иначе
		пСообщение = НСтр("ru = 'Начало, подключение интеграционной обработки расширения';
							|en = 'Getting started, enabling integration processing of the extension';
							|be = 'Пачатак, Падключэнне інтэграцыйнай апрацоўкі пашырэння'; es = 'Inicio, conectar el procesamiento de integración de la extensión'; ka = 'დაწყება, გაფართოების ინტეგრაციის დამუშავების შესაძლებლობა'; kk = 'Кеңейту интеграциялық өңдеуді бастау, қосу'; ro = 'Noțiuni de bază, permițând procesarea integrării extensiei'; tr = 'Başlangıç, uzantının entegrasyon işlemesinin bağlanması'; uk = 'Початок, підключення інтеграційної обробки розширення'; uz = 'Boshlash, kengaytmani integratsion qayta ishlashga imkon berish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		СтруктураИменРасширений = ГлЯдро_ПолучитьСтруктуруИменРасширений();
				
		ИнформацияОбИнтеграционномРасширении = ГлЯдро_ПроверитьНаличиеРасширения(СтруктураИменРасширений.ИнтеграционноеРасширение);
		Если ИнформацияОбИнтеграционномРасширении.Активно Тогда
			ИмяИнтеграционнойОбработки = ГлЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",, АдресаПеременных);
			Если Найти(ИмяИнтеграционнойОбработки, ".epf") > 0 Тогда
				ИмяИнтеграционнойОбработки = СтрЗаменить(ИмяИнтеграционнойОбработки, ".epf", "");
			КонецЕсли;
					
			Если ГлЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + ИмяИнтеграционнойОбработки, АдресаПеременных) Тогда
				
				ПараметрыИнтеграционнойОбработки = Новый Структура;
				ПараметрыИнтеграционнойОбработки.Вставить("ТипОбработки", 			   ТипОбработки);
				ПараметрыИнтеграционнойОбработки.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
				ПараметрыИнтеграционнойОбработки.Вставить("ПутьИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
				
				РезультатПодключения = ГлЯдро_ПереключитьИнтеграционнуюОбработку(ПараметрыИнтеграционнойОбработки,, АдресаПеременных);
			КонецЕсли;
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Конец, подключение интеграционной обработки расширения';
							|en = 'End, connect the integration processing of the extension';
							|be = 'Канец, падключэнне інтэграцыйнай апрацоўкі пашырэння'; es = 'Extremo, conectar el procesamiento de integración de expansión'; ka = 'ბოლოს, დაკავშირება ინტეგრაციის დამუშავება გაფართოება'; kk = 'Соңы, кеңейту интеграциялық өңдеуді қосу'; ro = 'End, conectați procesarea de integrare a extensiei'; tr = 'Son, entegrasyon işleme uzantısının bağlantısı'; uk = 'Кінець, підключення інтеграційної обробки розширення'; uz = 'Tugatish, kengaytirish integratsiyasini qayta ishlashni ulash'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПереключитьИнтеграционнуюОбработку(ПараметрыИнтеграционнойОбработки, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПереключитьИнтеграционнуюОбработку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыИнтеграционнойОбработки,ДополнительныеПараметры",
		ПараметрыИнтеграционнойОбработки, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипОбработки 					= ПараметрыИнтеграционнойОбработки.ТипОбработки;
	ИмяИнтеграционнойОбработки 		= ПараметрыИнтеграционнойОбработки.ИмяИнтеграционнойОбработки;
	ПутьИнтеграционнойОбработки 	= ПараметрыИнтеграционнойОбработки.ПутьИнтеграционнойОбработки;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	КонецЕсли;
	
    ТестовыеПараметрыПодключенияMS = ГлЯдро_СкопироватьСтруктуру(ПараметрыПодключенияMS);
	ТестовыеПараметрыПодключенияMS.Вставить("ТипОбработки", 			   ТипОбработки);
	ТестовыеПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
	ТестовыеПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
	
	РезультатПодключенияИнтеграционнойОбработки = ГлЯдро_ПодключитьИнтеграционнуюОбработку(,, ТестовыеПараметрыПодключенияMS,, АдресаПеременных);
	Если ЭтоАдресВременногоХранилища(РезультатПодключенияИнтеграционнойОбработки) Тогда
		
		// Сразу пытаемся поменять тип обработки и проверяем, удалось ли это сделать
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки,, АдресаПеременных);
		Если ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ТипОбработки",,, АдресаПеременных) = ТипОбработки Тогда
			
			Если ПараметрыПодключенияMS.ТипОбработки = "ФайлНаДиске" Тогда
				// Очищаем двоичные данные ИО, которые возможно остались.
				ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS, Неопределено);
			КонецЕсли;
			
			// Сохранение настроек
			ПараметрыПодключенияMS.Вставить("ТипОбработки",				   ТестовыеПараметрыПодключенияMS.ТипОбработки);
			ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ТестовыеПараметрыПодключенияMS.ИмяИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ТестовыеПараметрыПодключенияMS.ПутьИнтеграционнойОбработки);
			
			// Замена настроек в хранилище 1с
			ГлЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS, АдресаПеременных);
			
			// Замена настроек в базе Клеверенс
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С", ТестовыеПараметрыПодключенияMS.ИмяИнтеграционнойОбработки,, АдресаПеременных);
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ТестовыеПараметрыПодключенияMS.ПутьИнтеграционнойОбработки,, АдресаПеременных);
			
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
			
			// Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
			НастройкиУдаления = Новый Структура("ВерсияОбработки_ИнтеграционнаяОбработка");
			ГлЯдро_УдалитьНастройкиВБазеSMARTS(НастройкиУдаления, КатегорииНастроекMS.УзловыеНастройки,, АдресаПеременных);
			
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь,, АдресаПеременных);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПодключенияИнтеграционнойОбработки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатПодключенияИнтеграционнойОбработки;
	
КонецФункции

// Подключает файл в справочник дополнительных отчетов и обработок
//
// Параметры:
//	АдресФайла 									- Строка - адрес файла во временном хранилище
//	ИмяФайла 									- Строка - имя файла
//	ОтключатьКонфликтующие 						- Булево - признак отключения обработок/отчетов с аналогичным именем
//	ДобавитьВБыстрыйДоступТекПользователя		- Булево - необходимость добавления в быстрый доступ текущего пользователя
//	ПеренестиБыстрыйДоступИзПредыдущейВерсии 	- Булево - необходимость заполнения быстрого доступа значениями из предыдущей версии обработки/отчета
//	ДобавитьВоВсеРазделы 						- Булево - необходимость добавления обработки/отчета во все разделы
//	ПеренестиРазделыИзПредыдущейВерсии 			- Булево - необходимость заполнения разделов значениями из предыдущей версии обработки/отчета
//
// Возвращаемое значение:
//   Структура   - структура результата подключения в следующем формате:
//		* Подключено - Булево - признак успешности подлючения файла в справочник
//		* ПодключеноРанее 	- Булево - признак, что файл с таким именем уже подключен в справочник
//		* ТекстОшибки 		- Строка - информация об ошибке при подключении
//		* ТипОбработки 		- Строка - тип обработки
//		* ИмяФайла 			- Строка - имя подключаемого файла
//		* ОбработкаСсылка 	- СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка на подключенную обработку/отчет
//		* Версия 			- Строка - версия подключенной обработки/отчета
//
Функция ГлЯдро_ПодключитьФайлВСправочникДополнительныхОтчетовИОбработок(АдресФайла, ИмяФайла, ОтключатьКонфликтующие = Ложь, ДобавитьВБыстрыйДоступТекПользователя = Ложь, 
	ПеренестиБыстрыйДоступИзПредыдущейВерсии = Ложь, ДобавитьВоВсеРазделы = Ложь, ПеренестиРазделыИзПредыдущейВерсии = Ложь, ИмяОсновнойОбработки = Ложь, 
	ИмяИнтеграционнойОбработки = Ложь, ВерсияПриложенияАктуальная = Ложь, НеОбновлятьВерсиюПриложения = Ложь, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПодключитьФайлВСправочникДополнительныхОтчетовИОбработок";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"АдресФайла,ИмяФайла,ОтключатьКонфликтующие,ДобавитьВБыстрыйДоступТекПользователя,ПеренестиБыстрыйДоступИзПредыдущейВерсии,ДобавитьВоВсеРазделы,ПеренестиРазделыИзПредыдущейВерсии,ИмяОсновнойОбработки,ИмяИнтеграционнойОбработки,ВерсияПриложенияАктуальная,НеОбновлятьВерсиюПриложения",
		АдресФайла, ИмяФайла, ОтключатьКонфликтующие, ДобавитьВБыстрыйДоступТекПользователя, ПеренестиБыстрыйДоступИзПредыдущейВерсии, ДобавитьВоВсеРазделы, ПеренестиРазделыИзПредыдущейВерсии, ИмяОсновнойОбработки, ИмяИнтеграционнойОбработки, ВерсияПриложенияАктуальная, НеОбновлятьВерсиюПриложения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатПодключения = Новый Структура;
	
	Подключено 				= Ложь;
	ПодключеноРанее			= Ложь;
	ТекстОшибки 			= "";
	ТипОбработки 			= "ФайлНаДиске";
	ОбработкаСсылка 		= Неопределено;
	Версия 					= "0.0.0.0";
	СинонимСправочника 		= ""; // Для вывода сообщения о необходимости перезапуска обработки из справочника
	
	Если ГлЯдро_ПолучитьИспользованиеДополнительныхОтчетовИОбработок(АдресаПеременных) Тогда
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Метаданные_Справочник = Метаданные.Справочники.Найти("ВнешниеОбработки");
			Если Метаданные_Справочник = Неопределено Тогда
				Метаданные_Справочник = Метаданные.Справочники.Найти("ВнешниеПечатныеФормы");
			КонецЕсли;
			
			ИмяСправочника 		= Метаданные_Справочник.Имя;
			СинонимСправочника 	= Метаданные_Справочник.Синоним;
			
			Попытка
				
				ОбъектСправочника = Справочники[ИмяСправочника].СоздатьЭлемент();
				
				Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
					ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
					ИмяОбработки = ПолучитьИмяВременногоФайла();
					ДвоичныеДанные.Записать(ИмяОбработки);
					
					ЗащитаОтОпасныхДействий  = Новый ОписаниеЗащитыОтОпасныхДействий;
					ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
					ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяОбработки, Ложь, ЗащитаОтОпасныхДействий);
					
					ОбъектСправочника.Наименование 	= ВнешняяОбработка.Метаданные().Имя;
					
					МетаданныеСправочника 	= ОбъектСправочника.Метаданные();
					РеквизитыСправочника 	= МетаданныеСправочника.Реквизиты;
					Для каждого Реквизит Из РеквизитыСправочника Цикл
						Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
							ОбъектСправочника[Реквизит.Имя] = Новый ХранилищеЗначения(ДвоичныеДанные);
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					//Заполнение реквизита "ВидОбработки"
					Если РеквизитыСправочника.Найти("ВидОбработки") <> Неопределено Тогда
						ОписаниеТипаРеквизита = РеквизитыСправочника["ВидОбработки"].Тип;
						//Берем первый тип из описания типов
						ТипРеквизита = ОписаниеТипаРеквизита.Типы()[0];
						МетаданныеПеречисления = Метаданные.НайтиПоТипу(ТипРеквизита);
						Если МетаданныеПеречисления <> Неопределено Тогда
							
							//Поиск по значениям перечисления
							ЗначенияПеречисления = МетаданныеПеречисления.ЗначенияПеречисления;
							Для каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
							    //Если в имени значения есть "Обработка", то выбираем это значение
								Если ГлЯдро_СтрНайти(ЗначениеПеречисления.Имя, "Обработка") > 0 Тогда
									ОбъектСправочника["ВидОбработки"] = Перечисления[МетаданныеПеречисления.Имя][ЗначениеПеречисления.Имя];
									Прервать;
								КонецЕсли;							
							КонецЦикла;
						КонецЕсли;
					КонецЕсли;
										
					РегистрационныеДанные = ВнешняяОбработка.СведенияОВнешнейОбработке();
					Версия = РегистрационныеДанные.Версия;
					
					Если ИмяСправочника = "ВнешниеПечатныеФормы" Тогда
						ОбъектСправочника.Родитель 		= Справочники[ИмяСправочника].НайтиПоНаименованию("Внешние обработки");
						ОбъектСправочника.ВерсияФормы 	= ТекущаяДатаСеанса();
					КонецЕсли;
					
					ОбъектСправочника.Записать();
					
					Подключено = Истина;
					ТипОбработки = "СправочникСсылка";
					ОбработкаСсылка = ОбъектСправочника.Ссылка;
					
				КонецЕсли;
			Исключение
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());				
			КонецПопытки;
		#Иначе
			Метаданные_МодульДопОтчетыИОбработки = Метаданные.ОбщиеМодули.Найти("ДополнительныеОтчетыИОбработки");
			
			Если Метаданные_МодульДопОтчетыИОбработки <> Неопределено Тогда
				
				МодульДопОтчетыИОбработки = Вычислить(Метаданные_МодульДопОтчетыИОбработки.Имя);
				
				Метаданные_Справочник = Метаданные.Справочники.ДополнительныеОтчетыИОбработки;
				СинонимСправочника = Метаданные_Справочник.Синоним;
				
				ОбъектСправочника = Справочники[Метаданные_Справочник.Имя].СоздатьЭлемент();
				ОбъектСправочника.Заполнить(Новый Структура); //Для заполнения реквизитов значениями из свойства "ЗначениеЗаполнения"
				
				ПараметрыРегистрации = Новый Структура;
				ПараметрыРегистрации.Вставить("АдресДанныхОбработки", 	АдресФайла);
				ПараметрыРегистрации.Вставить("ЭтоОтчет", 				Ложь);
				ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", ОтключатьКонфликтующие);
				ПараметрыРегистрации.Вставить("Конфликтующие", 			Новый СписокЗначений);
				ПараметрыРегистрации.Вставить("ИмяФайла", 				ИмяФайла);
				ПараметрыРегистрации.Вставить("ОтключатьПубликацию", 	Ложь);
				ПараметрыРегистрации.Вставить("Успех", 					Ложь);
				
				РезультатРегистрации = Неопределено;
				Попытка //Т.к. в разных версиях БСП процедура может отличаться, то используем попытку
					РезультатРегистрации = МодульДопОтчетыИОбработки.ЗарегистрироватьОбработку(ОбъектСправочника, ПараметрыРегистрации);
				Исключение
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					Если Найти(ТекстОшибки, "Метод объекта не обнаружен") Тогда
						ТекстОшибки = "";
						Попытка
							РезультатРегистрации = ГлЯдро_ЗарегистрироватьОбработку(ОбъектСправочника, ПараметрыРегистрации, АдресФайла);
						Исключение
							ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						КонецПопытки;
					КонецЕсли;
				КонецПопытки;
				
				ПредыдущаяПодключеннаяОбработка = Неопределено;
				
				Если ТипЗнч(РезультатРегистрации) = Тип("Структура") Тогда					 
					Если РезультатРегистрации.Свойство("Конфликтующие")
						И ТипЗнч(РезультатРегистрации.Конфликтующие) = Тип("СписокЗначений")
						И РезультатРегистрации.Конфликтующие.Количество() > 0 Тогда
						
						ПредыдущаяПодключеннаяОбработка = РезультатРегистрации.Конфликтующие[РезультатРегистрации.Конфликтующие.Количество() - 1].Значение;
						
						Если ОтключатьКонфликтующие Тогда
							//Запускаем регистрацию обработки еще раз, но уже с заполненным списком конфликтующих
							ПараметрыРегистрации.Конфликтующие = РезультатРегистрации.Конфликтующие;
							РезультатРегистрации = Неопределено;
							Попытка //Т.к. в разных версиях БСП процедура может отличаться, то используем попытку
								РезультатРегистрации = МодульДопОтчетыИОбработки.ЗарегистрироватьОбработку(ОбъектСправочника, ПараметрыРегистрации);
							Исключение
								ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
								Если Найти(ТекстОшибки, "Метод объекта не обнаружен") Тогда
									ТекстОшибки = "";
									Попытка
										РезультатРегистрации = ГлЯдро_ЗарегистрироватьОбработку(ОбъектСправочника, ПараметрыРегистрации, АдресФайла);
									Исключение
										ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
									КонецПопытки;
								КонецЕсли;
							КонецПопытки;
							// Пометим на удаление конфликтующие обработки, т.к. при отключении они были переведены в режим "Отладка"
							//Для Каждого Конфликтующая Из ПараметрыРегистрации.Конфликтующие Цикл
							//	КонфликтующаяСсылка = Конфликтующая.Значение;
							//	КонфликтующийОбъект = КонфликтующаяСсылка.ПолучитьОбъект();
							//	КонфликтующийОбъект.УстановитьПометкуУдаления(Истина);
							//КонецЦикла;
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗнч(РезультатРегистрации) = Тип("Структура") Тогда
					Если (РезультатРегистрации.Свойство("Успех") И РезультатРегистрации.Успех)
						Или (РезультатРегистрации.Свойство("Успешно") И РезультатРегистрации.Успешно) Тогда
						Попытка
							ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
							ОбъектСправочника.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(9));;
							
							// Добавление в разделы
							СтруктураПолученияРазелов = ГлЯдро_ПолучитьДоступныеРазделыДляРазмещенияОбработки("Обработка", МодульДопОтчетыИОбработки, ДобавитьВоВсеРазделы, ПеренестиРазделыИзПредыдущейВерсии, ПредыдущаяПодключеннаяОбработка);
							
							Если ЗначениеЗаполнено(СтруктураПолученияРазелов.ТекстОшибки) Тогда
								// <Лог>
								ЯзСтрока = "ru = 'Ошибка получения разделов для размещения в них обработки/отчета из файла %1: %2';
															|en = 'Error in getting partitions to accommodate processing/report from the %1: %2 file';
															|be = 'Памылка атрымання раздзелаў для размяшчэння ў іх апрацоўкі / справаздачы з файла %1: %2'; es = 'Error al recuperar las particiones para incluir el procesamiento/informe del archivo %1: %2'; ka = 'შეცდომა მიღების დანაყოფები განსახლება დამუშავება / ანგარიში %1: %2 ფაილი'; kk = '%1: %2 файлынан өңдеуді/есепті орналастыру үшін бөлімдерді алу қатесі'; ro = 'Eroare la primirea partițiilor pentru a plasa procesarea/raportul în ele din fișierul %1: %2'; tr = '%1: %2 dosyasından bunlara işlenecek/raporlanacak bölümleri alma hatası'; uk = 'Помилка отримання розділів для розміщення в них обробки / звіту з файлу %1: %2'; uz = '%1: %2 faylidan ishlov berish / hisobotni joylashtirish uchun bo''limlarni olishda xato'";
								пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяФайла, СтруктураПолученияРазелов.ТекстОшибки);
								
								логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
									"ИмяФайла,ТекстОшибки",
									ИмяФайла, СтруктураПолученияРазелов.ТекстОшибки);
								ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
								// </Лог>
							Иначе
								ТекстОшибкиДобавленияВРазделы = ГлЯдро_РазместитьОбработкуВРазделах(ОбъектСправочника, СтруктураПолученияРазелов.МассивРазделов);
								Если ЗначениеЗаполнено(ТекстОшибкиДобавленияВРазделы) Тогда
									// <Лог>
									ЯзСтрока = "ru = 'Ошибка размещения обработки/отчета из файла %1 в разделах: %2';
														|en = 'Error in placing the processing/report from the %1 file in sections: %2';
														|be = 'Памылка размяшчэння апрацоўкі / справаздачы з файла %1 у раздзелах: %2'; es = 'Error al colocar el procesamiento / informe del archivo %1 en las secciones: %2'; ka = 'შეცდომა დამუშავების / ანგარიშის განთავსებაში % 1 ფაილიდან სექციებში: %2'; kk = '%1 файлынан өңдеу/есепті орналастыру қатесі бөлімдерде: %2'; ro = 'Eroare la plasarea procesării / raportului din fișierul %1 în secțiunile: %2'; tr = 'Bölümlerde %1 dosyasından işleme/rapor yerleştirme hatası: %2'; uk = 'Помилка розміщення обробки / звіту з файлу %1 у розділах: %2'; uz = '%1 faylidan ishlov berish/hisobotni joylashtirish xatosi: %2'";
									пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяФайла, ТекстОшибкиДобавленияВРазделы);
									
									логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
										"ИмяФайла,ТекстОшибкиДобавленияВРазделы",
										ИмяФайла, ТекстОшибкиДобавленияВРазделы);
									ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
									// </Лог>
								КонецЕсли;
