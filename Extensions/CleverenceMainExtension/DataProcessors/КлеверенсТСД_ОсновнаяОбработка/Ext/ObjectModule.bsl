	ЧтениеДанных.Закрыть();
	
	УдалитьФайлы(ИмяТекстовогоФайла);
	УдалитьФайлы(ИмяЗипФайла);
	
	пСообщение = НСтр("ru = 'Конец. Сжатие GZIP. Размер перед сжатием: %1. Размер после сжатия: %2. Контрольная сумма: %3';
						|en = 'End. GZIP compression. Size before compression: %1. Size after compression: %2. Checksum: %3';
						|be = 'Канец. Сціск GZIP. Памер перад сціскам: %1. Памер пасля сціску: %2. Кантрольная сума: %3'; es = 'Final. Compresión GZIP. Tamaño antes de la compresión: %1. Tamaño después de la compresión: %2. Suma de comprobación: %3'; ka = 'დასასრული. GZIP შეკუმშვა. ზომა შეკუმშვამდე: %1. ზომა შეკუმშვის შემდეგ: %2. ჯამი: %3'; kk = 'Соңы. GZIP қысу. Сығымдау алдындағы өлшем: %1. Қысудан кейінгі Өлшем: %2. Бақылау сомасы: %3'; ro = 'Sfârșit. Compresie GZIP. Dimensiune înainte de comprimare: %1. Dimensiune după comprimare: %2. Suma de control: %3'; tr = 'Son. GZİP sıkıştırma. Sıkıştırmadan önce boyut:% 1. Sıkıştırmadan sonra boyut:% 2. Sağlama toplamı: %3'; uk = 'Кінець. Стиснення GZIP. Розмір перед стисненням: %1. Розмір після стиснення: %2. Контрольна сума: %3'; uz = 'Oxiri. Gzip siqish. Siqishdan oldin hajmi: %1. Siqishdan keyingi o''lcham: %2. Tekshirish summasi: %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(РаспакованныйРазмер), Строка(РазмерСжатогоФайла), Строка(КонтрольнаяСумма));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	Возврат СжатыеДанные;
	
КонецФункции

Функция ГлЯдро_ЗашифроватьZIP(ИсходнаяСтрока, ТипТекстовогоФайла, УдалитьФайлы = Ложь) Экспорт
	
	ИмяТекстовогоФайла = ПолучитьИмяВременногоФайла(ТипТекстовогоФайла);
	ЗаписьТекста = Новый ЗаписьТекста(ИмяТекстовогоФайла,"UTF-8",,,Символы.ПС);
	ЗаписьТекста.Записать(ИсходнаяСтрока);
	ЗаписьТекста.Закрыть();
	
	ИмяЗипФайла = ПолучитьИмяВременногоФайла("zip");
	Сжатие = Новый ЗаписьZipФайла(ИмяЗипФайла,,, МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Максимальный);
	Сжатие.Добавить(ИмяТекстовогоФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
	Сжатие.Записать();
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяТекстовогоФайла", ИмяТекстовогоФайла);
	Результат.Вставить("ИмяЗипФайла", ИмяЗипФайла);
	Результат.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ИмяЗипФайла));
	
	Если УдалитьФайлы Тогда
		УдалитьФайлы(ИмяТекстовогоФайла);
		УдалитьФайлы(ИмяЗипФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

