Функция REST_API_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя, ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ЗагрузитьПользователейВSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПользователя,ТипБазы",
		ПараметрыПользователя, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипЗапроса = "POST";   
	Метод = "Users";
	Если ПараметрыПользователя.Получить("ТолькоРедактирование") <> Неопределено Тогда 
		Если ПараметрыПользователя["ТолькоРедактирование"] Тогда
			ТипЗапроса = "PATCH";
			Метод = "Users('" + ПараметрыПользователя["id"] + "')";
		КонецЕсли;
		ПараметрыПользователя.Удалить("ТолькоРедактирование");
	КонецЕсли;
	
	РезультатЗагрузки = REST_API_ЗагрузкаПользователей_ВыполнитьЗапрос(ПараметрыПользователя, ТипБазы, АдресаПеременных, ТипЗапроса, Метод, "ВыгрузкаШапкиДокумента", ИмяСобытия);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗагрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
