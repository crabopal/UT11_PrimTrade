// Выполняет очистку таблицы на сервере Клеверенс при работе с типом интерфейса REST_API
//
// Параметры:
//	ИмяТаблицы - Строка - имя таблицы Клеверенс, которую необходимо очистить
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Сообщение - Строка - информационное сообщение о результате очистки таблицы
//		* Статус - Булево - флаг успешности очистки таблицы
Функция REST_API_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "REST_API_ОчиститьТаблицуНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТипБазы",
		ИмяТаблицы, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	ИмяТаблицыENG = ГлЯдро_ПолучитьСоответствиеТаблицеMS(ИмяТаблицы, ЯзыкПлатформыMS, АдресаПеременных); 
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	РезультатПопытки = Истина;
	// Во всех случаях ТипЗапроса устанавливается = "НачалоВыгрузкиТаблицы", т.к. не выгружаем данные и завершение апдейта не должно долго выполняться
	Если ИмяТаблицы = "Номенклатура" Тогда
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
		СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Products/BeginOverwrite", "Inventory/BeginOverwrite"));
		СтруктураЗапроса.Вставить("ТипЗапроса", "НачалоВыгрузкиТаблицы");
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
		
		РезультатПопытки = РезультатПопытки И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
		СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Products/EndOverwrite", "Inventory/EndOverwrite"));
		СтруктураЗапроса.Вставить("ТипЗапроса", "НачалоВыгрузкиТаблицы");
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
		
		РезультатПопытки = РезультатПопытки И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
		
	ИначеЕсли ИмяТаблицы = "Ячейки" Тогда
		
		ОтправляемыеДанные = Новый Соответствие;
		Если ВерсияAPI = 1 Тогда
			ОтправляемыеДанные.Вставить("warehouseId", "1");
		КонецЕсли;
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
		СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Cells/BeginOverwrite", "Locations/BeginOverwrite"));
		СтруктураЗапроса.Вставить("ТипЗапроса", "НачалоВыгрузкиТаблицы");
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
		РезультатПопытки = РезультатПопытки И НЕ ЗначениеЗаполнено(РезультатОтвет.ТекстОшибки);
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
		СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Cells/EndOverwrite", "Locations/EndOverwrite"));
		СтруктураЗапроса.Вставить("ТипЗапроса", "НачалоВыгрузкиТаблицы");
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
		РезультатПопытки = РезультатПопытки И НЕ ЗначениеЗаполнено(РезультатОтвет.ТекстОшибки);
		
	Иначе
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","POST","Tables/"+ИмяТаблицыENG+"/BeginOverwrite","НачалоВыгрузкиТаблицы"),,АдресаПеременных);
		РезультатПопытки = РезультатПопытки И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
		РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","POST","Tables/"+ИмяТаблицыENG+"/EndOverwrite","НачалоВыгрузкиТаблицы"),,АдресаПеременных);
		РезультатПопытки = РезультатПопытки И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
	КонецЕсли;
	
	Если РезультатПопытки = Истина Тогда
		Сообщение = НСтр("ru = 'Таблица [%1] успешно очищена';
							|en = 'Table [%1] cleared successfully'; be = 'Табліца [%1] паспяхова ачышчана'; es = 'La tabla [%1] se ha limpiado correctamente'; ka = 'ცხრილი [%1] წარმატებით გაწმენდილია'; kk = 'Кесте [%1] сәтті тазартылды'; ro = 'Tabelul [%1] a fost eliminat cu succes'; tr = 'Tablo [%1] başarıyla temizlendi'; uk = 'Таблиця [%1] успішно очищена'; uz = 'Jadval [%1] muvaffaqiyatli tozalandi'");
		Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		РезультатВыгрузки = Новый Структура("Сообщение,Статус", Сообщение, Истина);
	Иначе
		Сообщение = НСтр("ru = 'Ошибка при очистке таблицы [%1]';
							|en = 'Error clearing the table [%1]'; be = 'Памылка пры ачыстцы табліцы [%1]'; es = 'Error al limpiar la tabla [%1]'; ka = 'შეცდომა გაწმენდის მაგიდა [%1]'; kk = 'Кестені тазалау кезінде қате [%1]'; ro = 'Eroare la ștergerea tabelului [%1]'; tr = 'Tabloyu temizlerken hata oluştu [%1]'; uk = 'Помилка очищення таблиці [%1]'; uz = 'Jadvalni tozalashda xato [%1]'");
		Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		РезультатВыгрузки = Новый Структура("Сообщение,Статус", Сообщение, Ложь);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

Функция REST_API_ПолучитьКоличествоСтрокТаблицыSMARTS(ИмяТаблицы, ТипБазы = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьКоличествоСтрокТаблицыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТипБазы,ДополнительныеПараметры",
		ИмяТаблицы, ТипБазы, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(, , АдресаПеременных);
	
	Если ИмяТаблицы = "Ячейки" Тогда
	
		ИмяТаблицыENG = ?(ВерсияAPI = 1, "Cells", "Locations");
		пМетод = ИмяТаблицыENG + "?%24top=1&%24count=true";
	
	Иначе
	
		ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
		ИмяТаблицыENG 	= ГлЯдро_ПолучитьСоответствиеТаблицеMS(ИмяТаблицы, ЯзыкПлатформыMS, АдресаПеременных);
		пМетод 			= "Tables/" + ИмяТаблицыENG + "?%24top=1&%24count=true";
	
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		пМетод);
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПроверкаТаблицы");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса, , АдресаПеременных);
	
	Если ТипЗнч(СтруктураОтвета) = Тип("Структура")
		И СтруктураОтвета.Свойство("КодСостояния")
		И СтруктураОтвета.КодСостояния = 200
		И СтруктураОтвета.Свойство("ОтветСервера") Тогда
		
		КоличествоЗаписей = СтруктураОтвета.ОтветСервера.Получить("@odata.count");
		Если КоличествоЗаписей <> Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", КоличествоЗаписей);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат КоличествоЗаписей;
		КонецЕсли;
	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Неопределено;
	
КонецФункции

Функция REST_API_ПолучитьСписокДокументовНаСервереSMARTS(ТаблицаДокументов, ТипБазы, РазмерВыборки = 0, ОтборПоПериоду = Неопределено, ОтборПоУзлу = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьСписокДокументовНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТаблицаДокументов,ТипБазы,РазмерВыборки,ОтборПоПериоду,ОтборПоУзлу",
		ТаблицаДокументов, ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	
	СтрокаФильтра 	= "";
	ФильтрПоПериоду = "";
	ФильтрПоУзлу	= "";
	
	Если ОтборПоПериоду <> Неопределено Тогда
		ДатаНачала 		= ОтборПоПериоду.ДатаНачала;                                      	
		Если ЗначениеЗаполнено(ДатаНачала) Тогда                                          
			ГодНачалаПериода 	= Формат(Год(ДатаНачала), "ЧГ=");
			МесяцНачалаПериода 	= Месяц(ДатаНачала);
			ФильтрПоПериоду = ФильтрПоПериоду + "((year(createDate) eq " + ГодНачалаПериода + " and month(createDate) gt " + МесяцНачалаПериода + ") " +
				"or (year(createDate) eq " + ГодНачалаПериода + " and month(createDate) eq " + МесяцНачалаПериода + " and day(createDate) ge " + День(ДатаНачала) + ") " + 
					"or (year(createDate) gt " + ГодНачалаПериода + "))";
		КонецЕсли;            		
		ДатаОкончания 	= ОтборПоПериоду.ДатаОкончания;
		Если ЗначениеЗаполнено(ДатаОкончания) Тогда     
			ГодКонцаПериода 	= Формат(Год(ДатаОкончания), "ЧГ=");
			МесяцКонцаПериода 	= Месяц(ДатаОкончания);
			ФильтрПоПериоду = ФильтрПоПериоду + ?(ЗначениеЗаполнено(ДатаНачала), " and ", "") + "((year(createDate) eq " + ГодКонцаПериода + " and month(createDate) lt " + МесяцКонцаПериода + ") " +
				"or (year(createDate) eq " + ГодКонцаПериода + " and month(createDate) eq " + МесяцКонцаПериода + " and day(createDate) le " + День(ДатаОкончания) + ") " + 
					"or (year(createDate) lt " + ГодКонцаПериода + "))";
		КонецЕсли;		                                                                                          
	КонецЕсли;
	
	Если ОтборПоУзлу <> Неопределено Тогда
		ФильтрПоУзлу = ?(НЕ ПустаяСтрока(ФильтрПоПериоду), " and ", "") + "(idUzla eq '" + ОтборПоУзлу.ID_Узла + "' or idUzla eq NULL)";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ФильтрПоПериоду)
		ИЛИ НЕ ПустаяСтрока(ФильтрПоУзлу) Тогда
		СтрокаФильтра = "&$filter=" + ФильтрПоПериоду + ФильтрПоУзлу;
	КонецЕсли;
	
	ДопОтбор = ?(ЗначениеЗаполнено(РазмерВыборки), "&$top=" + РазмерВыборки, "");
	
	// заполняем таблицу
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Docs?$expand=declaredItems($count=true;$top=0),currentItems($count=true;$top=0),extendedFields&$orderby=createDate%20desc" + СтрокаФильтра + ДопОтбор);
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСпискаДокументов");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СписокДокументовSMARTS = СтруктураОтвета.ОтветСервера.Получить("value");
	
	Для Каждого ДокументSMARTS Из СписокДокументовSMARTS Цикл
		
		РеквизитыШапки = REST_API_ПолучитьДанныеШапкиДокументаMS(ДокументSMARTS,, АдресаПеременных);
		
		// Новые типы документов, добавленные, например, вручную, и еще не инициализированные в текущих настройках ядра, просто пропускаем
		Если РеквизитыШапки = Неопределено ИЛИ НЕ СтруктураМетаданных.ДокументыMS.Свойство(РеквизитыШапки.ИмяТипаДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДокументов.Добавить(РеквизитыШапки);
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТаблицаДокументов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция REST_API_ПолучитьИдВыгруженныхДокументовSMARTS(МассивИдДокументов, ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьИдВыгруженныхДокументовSMARTS";
	
	СоответствиеВыгруженныхИд = Новый Соответствие;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивИдДокументов,ТипБазы",
		МассивИдДокументов, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если МассивИдДокументов.Количество() > 0 Тогда
		
		Если ТипБазы = "Частная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
		ИначеЕсли ТипБазы = "Временная" Тогда
			КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
		Иначе
			КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
		КонецЕсли;
		
		СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
		
		Если СтруктураПодключенияMS <> Неопределено Тогда
			
			ФильтрДокументов = "";
			
			Для каждого ИдДокумента из МассивИдДокументов Цикл
				Если ЗначениеЗаполнено(ФильтрДокументов) Тогда
					ФильтрДокументов = ФильтрДокументов + " or ";
				КонецЕсли;
				
				ФильтрДокументов = ФильтрДокументов + "id eq '" + ИдДокумента + "'";
			КонецЦикла;
			
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 			"GET");
			СтруктураЗапроса.Вставить("Метод", 				"Docs?$select=id&$filter=" + ФильтрДокументов + "&$top=" + Строка(МассивИдДокументов.Количество()));
			СтруктураЗапроса.Вставить("ВернутьСтруктуру", 	Истина);
			СтруктураЗапроса.Вставить("ТипЗапроса", 		"ПолучениеСпискаДокументов");
			
			СписокДокументовSMARTS 	= Неопределено;
			СтруктураОтвета 		= REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
			КодСостоянияУспешно 	= REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния);
			
			Если КодСостоянияУспешно И СтруктураОтвета.Свойство("ОтветСервера") Тогда
				ОтветСервера = СтруктураОтвета.ОтветСервера;
				ОтветСервера.Свойство("value", СписокДокументовSMARTS);
				
				Если ТипЗнч(СписокДокументовSMARTS) = Тип("Массив") Тогда
					Для Каждого ДокументSMARTS Из СписокДокументовSMARTS Цикл
						ИдДокументаSMARTS = "";
						ДокументSMARTS.Свойство("id", ИдДокументаSMARTS);
						
						Если ЗначениеЗаполнено(ИдДокументаSMARTS) Тогда
							СоответствиеВыгруженныхИд.Вставить(ИдДокументаSMARTS, Истина);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеВыгруженныхИд);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СоответствиеВыгруженныхИд;
	
КонецФункции

Функция REST_API_СформироватьНовыйДокументSMARTS(ДанныеДокумента,НазначенныйПользователь = "", АдресаПеременных, ИспользоватьUni=Истина, ДобавлятьТип=Ложь, СпособНазначения = "")
	
	ИмяСобытия = "REST_API_СформироватьНовыйДокументSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеДокумента,НазначенныйПользователь,ИспользоватьUni,ДобавлятьТип,СпособНазначения",
		ДанныеДокумента, НазначенныйПользователь, ИспользоватьUni, ДобавлятьТип, СпособНазначения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных",АдресаПеременных);
	
	МетаданныеДокументаMS = ДанныеДокумента.МетаданныеДокументаMS;
	СоответствиеРеквизитов = ГлЯдро_ПолучитьСоответствиеРеквизитовUniДокументаMS(МетаданныеДокументаMS);
	UniИмяТипаДокумента = СоответствиеРеквизитов.ИмяТипаДокумента;
	ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ДанныеДокумента.ШапкаДокумента[UniИмяТипаДокумента]);
	
	ДокументSMARTS = Новый Структура;
	
	Для Каждого РеквизитДокумента Из ДанныеДокумента.ШапкаДокумента Цикл
		РеквизитMS = Неопределено;
		Для Каждого СтрокаРеквизита Из МетаданныеДокументаMS.Реквизиты Цикл
			Если НРег(СтрокаРеквизита.Значение) = НРег(РеквизитДокумента.Ключ) Тогда
				РеквизитMS = СтрокаРеквизита;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если РеквизитMS = Неопределено Тогда
			РеквизитMS = Новый Структура("Ключ,Значение,Uni",РеквизитДокумента.Ключ,РеквизитДокумента.Ключ,РеквизитДокумента.Ключ);
		КонецЕсли;
		ЗначениеРеквизита = РеквизитДокумента.Значение;
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
			Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				ЗначениеРеквизита = REST_API_ФорматДаты(ЗначениеРеквизита);	
			Иначе				
				ЗначениеРеквизита = Неопределено;
			КонецЕсли;
		КонецЕсли;
		ДокументSMARTS.Вставить(?(ИспользоватьUni,ГлЯдро_СтрокуВТранслитENG(РеквизитMS.Uni),РеквизитMS.Ключ),ЗначениеРеквизита);
	КонецЦикла;
	
	Если ДанныеДокумента.Свойство("Name") Тогда
		ДокументSMARTS.Вставить("name",ДанныеДокумента.Name); // обязательно с маленькой буквы
	КонецЕсли;
	
	ДокументSMARTS.Вставить("documentTypeName",ИмяТипаДокумента);
	Если ТипЗнч(НазначенныйПользователь) = Тип("Структура") Тогда
		НазначенныйПользователь = ?(НазначенныйПользователь.Свойство("Ид"), НазначенныйПользователь.Ид, "");
	КонецЕсли;
	Если НазначенныйПользователь <> "" Тогда 
		Если СпособНазначения = "Устройству" Тогда
			ДокументSMARTS.Вставить("appointment", НазначенныйПользователь);
		Иначе
			ПозицияРазделителя =
				ГлЯдро_СтрНайти(НазначенныйПользователь, "|");
			ПостфиксИд = ?(ПозицияРазделителя, Лев(НазначенныйПользователь, ПозицияРазделителя - 1), НазначенныйПользователь);
			
			ДокументSMARTS.Вставить("appointment", НазначенныйПользователь);
			ДокументSMARTS.Вставить("id", ДокументSMARTS.Id + "#" + ПостфиксИд);
		КонецЕсли;		
	КонецЕсли;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	UniОсновняхТабличныхЧастей = Новый Соответствие;
	UniОсновняхТабличныхЧастей.Вставить("СтрокиПлан","declaredItems");
	UniОсновняхТабличныхЧастей.Вставить("СтрокиФакт","currentItems");
	UniОсновняхТабличныхЧастей.Вставить("СовмещенныеСтроки","combinedItems");
	UniОсновняхТабличныхЧастей.Вставить("СерииПлан","");
	UniОсновняхТабличныхЧастей.Вставить("СерииФакт","");
	UniОсновняхТабличныхЧастей.Вставить("СерийныеНомераПлан","");
	UniОсновняхТабличныхЧастей.Вставить("СерийныеНомераФакт","");
	МассивДопТаблиц = Новый Массив;	
	
	РеквизитыТЧ = МетаданныеДокументаMS.РеквизитыТЧ;
	
	Если ДанныеДокумента.Свойство("ТабличныеЧасти") И ДанныеДокумента.ТабличныеЧасти.Количество() > 0 Тогда
		Для Каждого ТабличнаяЧасть Из ДанныеДокумента.ТабличныеЧасти Цикл
			МассивСтрокТЧ = Новый Массив;
			UniТЧ = ?(ИспользоватьUni,UniОсновняхТабличныхЧастей.Получить(ТабличнаяЧасть.Ключ),Неопределено);
			Если UniТЧ <> Неопределено Тогда
				Если ТабличнаяЧасть.Ключ = "СовмещенныеСтроки" Тогда
					Продолжить;
				КонецЕсли;
				СписокРеквизитов = Новый Соответствие;
				Если ТабличнаяЧасть.Значение.Количество() > 0 Тогда
					Для каждого КлючЗначение из ТабличнаяЧасть.Значение[0] Цикл
						REST_API_ДополнитьСписокРеквизитов(СписокРеквизитов, КлючЗначение.Ключ, РеквизитыТЧ, ЯзыкПлатформыMS);
					КонецЦикла;
				КонецЕсли;
				
				Для каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
					СтрокаДокументаSMARTS = Новый Структура;
					Для Каждого РеквизитСтроки Из СтрокаТЧ Цикл
						ЗначениеРеквизита = РеквизитСтроки.Значение;
						Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
							Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
								ЗначениеРеквизита = REST_API_ФорматДаты(ЗначениеРеквизита);	
							Иначе
								ЗначениеРеквизита = Неопределено;
							КонецЕсли;
						КонецЕсли;
						Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
							КлючРеквизита = СписокРеквизитов.Получить(РеквизитСтроки.Ключ);
							Если КлючРеквизита = Неопределено Тогда
								// Список реквизитов определен по первой строке таблицы ТабличнаяЧасть.
								// В случае, когда выгрузка производится из нескольких документов в один, в последующих строках
								// может быть больше колонок, чем в первой (например, если в первом документе нет маркированной
								// продукции, а во втором - есть).
								// Нужно предусмотреть дополнение списка реквизитов при необходимости.
								REST_API_ДополнитьСписокРеквизитов(СписокРеквизитов, РеквизитСтроки.Ключ, РеквизитыТЧ, ЯзыкПлатформыMS);
								
								КлючРеквизита = СписокРеквизитов.Получить(РеквизитСтроки.Ключ);
							КонецЕсли;
							
							СтрокаДокументаSMARTS.Вставить(КлючРеквизита, ЗначениеРеквизита);
						КонецЕсли;
					КонецЦикла;
					
					МассивСтрокТЧ.Добавить(СтрокаДокументаSMARTS);					
				КонецЦикла;
				ДокументSMARTS.Вставить(UniТЧ,МассивСтрокТЧ);
			Иначе
				ДопТаблицаSMARTS = Новый Соответствие;		
				ДопТаблицаSMARTS.Вставить("name",ТабличнаяЧасть.Ключ);
				СписокРеквизитов = Новый Соответствие;
								
				Если ТабличнаяЧасть.Значение.Количество() > 0 Тогда
					Для каждого КлючЗначение из ТабличнаяЧасть.Значение[0] Цикл
						РеквизитMS = Неопределено;
						Для Каждого СтрокаРеквизита Из МетаданныеДокументаMS.РеквизитыТЧ Цикл
							Если НРег(СтрокаРеквизита.Значение) = НРег(КлючЗначение.Ключ) Тогда
								РеквизитMS = СтрокаРеквизита;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если РеквизитMS = Неопределено Тогда
							РеквизитMS = Новый Структура("Ключ,Значение,Uni",КлючЗначение.Ключ,КлючЗначение.Ключ,КлючЗначение.Ключ);
						КонецЕсли;
						СписокРеквизитов.Вставить(РеквизитMS.Значение,РеквизитMS.Uni);
						// Для табличной части МаркиДокумента не нужно заменять IdTovara на ProductId
						// Если выяснится, что для всех табличных частей имена реквизитов заменять не нужно,
						// убрать это условие и отменить выше поиск в МетаданныеДокументаMS
						Если НРег(ТабличнаяЧасть.Ключ) = "маркидокумента" И НРег(КлючЗначение.Ключ) = "идтовара" Тогда
							СписокРеквизитов.Вставить(РеквизитMS.Значение,КлючЗначение.Ключ);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Для каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
					Row = Новый Соответствие;
					Для Каждого РеквизитСтроки Из СтрокаТЧ Цикл
						ЗначениеРеквизита = РеквизитСтроки.Значение;
						Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
							Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
								ЗначениеРеквизита = REST_API_ФорматДаты(ЗначениеРеквизита);	
							Иначе
								ЗначениеРеквизита = Неопределено;
							КонецЕсли;
						КонецЕсли;
						Row.Вставить(СписокРеквизитов.Получить(РеквизитСтроки.Ключ), ЗначениеРеквизита);
					КонецЦикла;
					МассивСтрокТЧ.Добавить(Row);
				КонецЦикла;
				
				ДопТаблицаSMARTS.Вставить("rows",МассивСтрокТЧ);
				МассивДопТаблиц.Добавить(ДопТаблицаSMARTS);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если МассивДопТаблиц.Количество() > 0 Тогда
		ДокументSMARTS.Вставить("tables",МассивДопТаблиц);	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДокументSMARTS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ДокументSMARTS;
	
КонецФункции

Функция REST_API_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных)
	
	ИмяСобытия = "REST_API_ЗаписатьДокументВБазуSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДокументSMARTS,ТипБазы",
		ДокументSMARTS, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных",АдресаПеременных);
	
	ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ДокументSMARTS.documentTypeName);
	МассивСтрокТЧ = Новый Массив;
	Если ДокументSMARTS.Свойство("declaredItems") Тогда
		МассивСтрокТЧ = ДокументSMARTS.declaredItems;
		ДокументSMARTS.Удалить("declaredItems");
	КонецЕсли;
	МетаданныеДокументаMS = СтруктураМетаданных.ДокументыMS[ИмяТипаДокумента];
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	Результат = Истина;
	UniДокумента = МетаданныеДокументаMS.uni;
	idДокумента = ДокументSMARTS.Id;
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ВернутьСтруктуру,ТипЗапроса","POST","Docs",Истина,"ВыгрузкаШапкиДокумента"),ДокументSMARTS,АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		Результат =  Ложь;
	КонецЕсли;
	
	Если МассивСтрокТЧ.Количество() > 0 Тогда
		Если Результат = Истина Тогда
			ПакетСтрок = Новый Массив;	
			Икс = 0; ЭтоПерваяСтрока=Истина;
			Для каждого СтрокаТЧ Из МассивСтрокТЧ Цикл
				Если Икс%1000 = 0 И Не ЭтоПерваяСтрока Тогда
					ПакетДляОтправки = Новый Соответствие;
					ПакетДляОтправки.Вставить("value",ПакетСтрок);
					СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ВернутьСтруктуру,ТипЗапроса","POST","Docs('"+idДокумента+"')/declaredItems",Истина,"ВыгрузкаСтрокДокумента"),ПакетДляОтправки,АдресаПеременных);
					Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
						СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","DELETE","Docs('"+idДокумента+"')","ВыгрузкаШапкиДокумента"),,АдресаПеременных);
						Результат = Ложь;
						Прервать;
					КонецЕсли;
					ПакетСтрок = Новый Массив;	
				КонецЕсли;
				НовоеСоответствие = Новый Соответствие;
				Для каждого КлючЗначение Из СтрокаТЧ Цикл
					НовоеСоответствие.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);	
				КонецЦикла;			
				
				ПакетСтрок.Добавить(НовоеСоответствие);
				ЭтоПерваяСтрока = Ложь;
				Икс = Икс+1;
			КонецЦикла;
			
			Если ПакетСтрок.Количество() > 0 Тогда
				ПакетДляОтправки = Новый Соответствие;
				ПакетДляОтправки.Вставить("value",ПакетСтрок);
				СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ВернутьСтруктуру,ТипЗапроса","POST","Docs('"+idДокумента+"')/declaredItems",Истина,"ВыгрузкаСтрокДокумента"),ПакетДляОтправки,АдресаПеременных);
				Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
					СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","DELETE","Docs('"+idДокумента+"')","ВыгрузкаШапкиДокумента"),,АдресаПеременных);
					Результат = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат = Истина Тогда
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","POST","Docs('"+idДокумента+"')/EndUpdate","ВыгрузкаСтрокДокумента"),,АдресаПеременных);
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			Результат =  Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция REST_API_УдалитьДокументНаСервереSMARTS(ID_Документа, ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_УдалитьДокументНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,ТипБазы",
		ID_Документа, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","DELETE","Docs('"+ID_Документа+"')","ВыгрузкаШапкиДокумента"),,АдресаПеременных);
	РезультатПопытки = REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПопытки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатПопытки;
	
КонецФункции

Функция REST_API_ФорматДаты(пДата)
	
	Смещение = СмещениеСтандартногоВремени();
	Если Смещение < 0 Тогда
		Смещение = Смещение *-1;
		Знак="-";
	Иначе		
		Знак="+";
	КонецЕсли;
	GTM = Прав("0"+Строка(Цел(Смещение/3600)),2)+":"+Прав("0"+Строка(Цел(Смещение%3600/60)),2);
	Возврат Формат(пДата,"ДФ=yyyy-MM-ddTHH:mm:ss")+".0000000"+Знак+GTM;
	
КонецФункции

Функция REST_API_ТаблицаЗначенийВМассивСтруктур(ТаблицаЗначений)
	Результат = Новый Массив;
	
	Для каждого Строка Из ТаблицаЗначений Цикл	
		СтрокаРезультата = Новый Структура;
		
		Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			
			ЗначениеРеквизита = Строка[Колонка.Имя];
			Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
				Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					ЗначениеРеквизита = REST_API_ФорматДаты(ЗначениеРеквизита);	
				Иначе
					ЗначениеРеквизита = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаРезультата.Вставить(Колонка.Имя, ?(ЗначениеЗаполнено(ЗначениеРеквизита), ЗначениеРеквизита, "")); 
		КонецЦикла;
		
		Результат.Добавить(СтрокаРезультата);
	 КонецЦикла;
	Возврат Результат;
КонецФункции

Функция REST_API_УстановитьСтатусДокументаНаСервереSMARTS(ID_Документа, ТипБазы, Статус, АдресаПеременных)
	
	ИмяСобытия = "REST_API_УстановитьСтатусДокументаНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,ТипБазы,Статус",
		ID_Документа, ТипБазы, Статус);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	ОтправляемыеДанные = Новый Соответствие;
	ОтправляемыеДанные.Вставить("Status", Статус);
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения,Новый Структура("HTTPМетод,Метод,ТипЗапроса","PATCH","Docs('"+ID_Документа+"')","ВыгрузкаШапкиДокумента"),ОтправляемыеДанные,АдресаПеременных);
	
	СтатусУспешно = REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтатусУспешно);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтатусУспешно;

КонецФункции

// Обновляет поля шапки SMARTS-документа через REST API.
//
// Параметры:
//  ИдДокумента - Строка - идентификатор документа SMARTS.
//  ТипБазы - Строка - тип базы SMARTS.
//  ПоляШапки - Соответствие - обновляемые поля шапки документа.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//  Булево - Истина, если сервер SMARTS вернул успешный HTTP-код.
//
Функция REST_API_ОбновитьШапкуДокументаSMARTS(ИдДокумента, ТипБазы, ПоляШапки, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ОбновитьШапкуДокументаSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИдДокумента,ТипБазы,ПоляШапки",
		ИдДокумента, ТипБазы, ПоляШапки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"PATCH");
	СтруктураЗапроса.Вставить("Метод", 		"Docs('" + ИдДокумента + "')");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ВыгрузкаШапкиДокумента");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ПоляШапки, АдресаПеременных);
	ШапкаОбновлена = REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ШапкаОбновлена);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ШапкаОбновлена;
	
КонецФункции

Функция REST_API_ОбработатьЗначениеДляВыгрузки(ЗначениеДляВыгрузки)

	Если НЕ ЗначениеЗаполнено(ЗначениеДляВыгрузки) Тогда
		Если ТипЗнч(ЗначениеДляВыгрузки) = Тип("Число") Тогда
			Возврат 0;
		Иначе	
			Возврат "";
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ЗначениеДляВыгрузки;
	
КонецФункции

// Функция преобразования особых типов источника (приведенной к строке даты) в тип 1С
//
// Параметры:
//  Источник - Реквизит объекта-источника (Клеверенс)
//  Приемник - Реквизит объекта-приемника (1С)
// 
// Возвращаемое значение:
//   ЗначениеПриемника - Преобразованное значение для записи в реквизит приемника
//
Функция REST_API_ПреобразованиеЗначенияРеквизитаИсточникаВТип1С(Источник, Приемник)
	
	// Если имеется реквизит Клеверенс типа "DateTime" в виде строкового представления, необходимо перед проверкой конвертировать его в тип 1С "Дата"
	СравниваемоеЗначениеТипаДата = ТипЗнч(Приемник) = Тип("Дата") И ТипЗнч(Источник) = Тип("Строка");
	Если СравниваемоеЗначениеТипаДата Тогда
		ЗначениеПриемника = REST_API_ПреобразоватьКДате(Источник)
	Иначе
		ЗначениеПриемника = Источник;
	КонецЕсли;
	
	Возврат ЗначениеПриемника;
	
КонецФункции

// Функция обратного преобразования даты из форматированного представления определенного формата в тип Дата
//
// Параметры:
// 		ДатаСтрокой	 - Строка - Представление даты в формате "ДФ=yyyy-MM-ddTHH:mm:ss.0000000+HH:mm"
// 
// Возвращаемое значение:
// 		ДатаВФормате - Дата, Строка - Преобразованное значение даты, либо если что-то пошло не так, исходное значение
//
// Пример:
// 		ДатаСтрокой  = "2021-03-09T08:09:24.0000000+03:00";
//		ДатаВФормате = <09.03.2021  8:09:24>
//
Функция REST_API_ПреобразоватьКДате(ДатаСтрокой)
	
	// Возьмем данный разделить даты/времени за признак корректного формата
	Если ГлЯдро_СтрНайти(ДатаСтрокой, "T") = 0 Тогда
		Возврат ДатаСтрокой;
	КонецЕсли;
	
	МассивРазделеннойДаты = ГлЯдро_СтрРазделить(ДатаСтрокой, "T", Ложь);
	
	Если МассивРазделеннойДаты.Количество() <> 2 Тогда
		Возврат ДатаСтрокой;
	КонецЕсли;
	
	СтрДата		= REST_API_УбратьНечисловыеСимволы(МассивРазделеннойДаты[0]);
	СтрВремя 	= Лев(REST_API_УбратьНечисловыеСимволы(МассивРазделеннойДаты[1]), 6);
	
	Попытка
		ДатаВФормате = Дата(СтрДата + СтрВремя);						
	Исключение		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'КлеверенсТСД.REST_API_ПреобразоватьКДате';
					|en = 'CleverensTSD.REST_API_Convert to Date'; be = 'Клеверэнстсд.REST_API_ПреобразоватьКДате'; es = 'CléverenstsdRest_api_convertircdate'; ka = 'CleverensTSD.REST_API_Convert დღემდე'; kk = 'КлеверенсТСД.Rest_api_ түрлендірукдат'; ro = 'Cleverstsd.rest_api_conversion Data'; tr = 'CloverensTSD.rest_api_dönüştürmek Tarih'; uk = 'КлеверенсТСД.Rest_api_перетворюватикдате'; uz = 'Kleverenstsd.Rest_api_o''zgartirish'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДатаВФормате = ДатаСтрокой;
	КонецПопытки;
	
	Возврат ДатаВФормате;	
	
КонецФункции

// Функция очистки строковой переменной от нечисловых символов для дальнейшей обработки
//
// Параметры:
// 		Стр 	  - Строка - Строка, в которой необходимо оставить только числовые символы
// 
// Возвращаемое значение:
// 		Результат - Строка - Преобразованная строка
//
// Пример:
//		Стр 	  = "2021-03-09T08:09:24";
//      Результат = "20210309080924"
//
Функция REST_API_УбратьНечисловыеСимволы(Стр)
	
	Результат = "";
	
	Если ТипЗнч(Стр) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтрДлина(Стр) = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаПроверки = СокрЛП(Стр);
	
	Для Инд = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		Символ = Сред(СтрокаПроверки, Инд, 1);
		
		Если Найти("0123456789", Символ) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + Символ;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура REST_API_ДополнитьСписокРеквизитов(СписокРеквизитов, Ключ, РеквизитыТЧ, ЯзыкПлатформыMS = "RU")

	Перем РеквизитMS, ИмяРеквизита;
	
	Для Каждого СтрокаРеквизита Из РеквизитыТЧ Цикл
		Если НРег(СтрокаРеквизита.Значение) = НРег(Ключ) Тогда
			РеквизитMS = СтрокаРеквизита;
			ИмяРеквизита = СтрокаРеквизита.Значение;
			Прервать;
		КонецЕсли;
		
		Если ЯзыкПлатформыMS = "EN" Тогда
			Если НРег(СтрокаРеквизита.Имя) = НРег(Ключ) Тогда
				РеквизитMS = СтрокаРеквизита;
				ИмяРеквизита = СтрокаРеквизита.Имя;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитMS = Неопределено Тогда
		РеквизитMS = Новый Структура("Ключ, Значение, Uni", Ключ, Ключ, Ключ);
	КонецЕсли;
	Если ИмяРеквизита = Неопределено Тогда
		ИмяРеквизита = Ключ;
	КонецЕсли;
	
	СписокРеквизитов.Вставить(ИмяРеквизита, РеквизитMS.Uni);
	
КонецПроцедуры

Функция REST_API_ТекстСообщенияНекорректныйHTTPОтвет(СтруктураЗапроса, СтруктураОтвета)

	ТекстСообщения = НСтр("ru = 'Запрос: %1, %2. Получен некорректный ответ от сервера, Код состояния: %3. Содержание ошибки: %4';
							|en = 'Request: %1, %2. Received an incorrect response from the server, Status code: %3. Error content: %4';
							|be = 'Запыт: %1, % 2. Атрыманы некарэктны адказ ад сервера, Код стану: %3. Змест памылкі: %4'; es = 'Consulta: %1, %2. Se recibió una respuesta incorrecta del servidor, Código de estado: %3. Contenido del error: %4'; ka = 'მოთხოვნა: %1, % 2. მიიღო არასწორი პასუხი სერვერიდან, სტატუსის კოდი: %3. შეცდომის შინაარსი: %4'; kk = 'Сұрау: %1, %2. Серверден қате жауап алынды, күй коды: %3. Қате мазмұны: %4'; ro = 'Cerere: %1, %2. Un răspuns incorect a fost primit de la server, cod de stare: %3. Conținut eroare: %4'; tr = 'Talep: % 1, % 2. Sunucudan yanlış bir yanıt alındı, Durum kodu: %3. Hata içeriği: %4'; uk = 'Запит: %1, %2. Отримано некоректну відповідь від сервера, Код стану: % 3. Зміст помилки: %4'; uz = 'So''rov: %1, %2. Serverdan noto''g''ri javob olindi, holat kodi: %3. Xato tarkibi: %4'");
	ТекстСообщения = ГлЯдро_СтрШаблон(ТекстСообщения,
		СтруктураЗапроса.HTTPМетод, СтруктураЗапроса.Метод, СтруктураОтвета.КодСостояния, СтруктураОтвета.ТекстОшибки);
	
	Возврат ТекстСообщения;
	
КонецФункции

// Запись сведений о выполнении http-запроса в журнал регистрации
// @logskip
Процедура REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ДополнительныеПараметры = Неопределено, АдресаПеременных)

	Перем ТекстСообщения, УровеньЖурнала;
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры.Свойство("ТекстСообщения", ТекстСообщения);
		ДополнительныеПараметры.Свойство("УровеньЖурнала", УровеньЖурнала);
	КонецЕсли;
	
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = REST_API_ТекстСообщенияНекорректныйHTTPОтвет(
			СтруктураЗапроса, СтруктураОтвета);
	КонецЕсли;
	
	Если УровеньЖурнала = Неопределено Тогда
		УровеньЖурнала = "Ошибка";
	КонецЕсли;
	
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньЖурнала, ТекстСообщения,, АдресаПеременных);

КонецПроцедуры

#Область REST_API_Транспорт

Функция REST_API_ВыполнитьМетод(СтруктураПодключения,СтруктураЗапроса,ОтправляемыеДанные,АдресаПеременных)
	
	Перем ОтветHTTP, ТекстОшибки, TempUid;
		
	ИмяСобытия = "REST_API_ВыполнитьМетод";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,СтруктураЗапроса,ОтправляемыеДанные",
		СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураОтвета = Новый Структура;	
	
	Если ТипЗнч(СтруктураПодключения) = Тип("Строка") Тогда
		СтрокаПодключения = СтруктураПодключения;
	Иначе
		Если НЕ ТипЗнч(СтруктураПодключения) = Тип("Структура")
			ИЛИ НЕ СтруктураПодключения.Свойство("СтрокаПодключенияСМАРТС")
			ИЛИ НЕ ЗначениеЗаполнено(СтруктураПодключения.СтрокаПодключенияСМАРТС) Тогда
			
			СтруктураОтвета.Вставить("ТекстОшибки","Не заполнено значение ""Строка подключения""");
			СтруктураОтвета.Вставить("КодСостояния",Неопределено);

			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураОтвета);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат СтруктураОтвета;
		КонецЕсли;
		СтрокаПодключения = СтруктураПодключения.СтрокаПодключенияСМАРТС;
	КонецЕсли;
	
	// Запоминаем строку подключения до редиректа для возможности получить данные авторизации.
	СтрокаПодключенияОригинал = СтрокаПодключения;
	
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
	
	// Если в кэше уже сохранена строка подключения для редиректа, в запросах используем ее
	КлючПеременной = "Location_" + REST_API_ПолучитьКлючURL(СтруктураURI);
	Location = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	Если ЗначениеЗаполнено(Location) И НЕ Location = Ложь Тогда
		СтрокаПодключения = Location;
		СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
	КонецЕсли;
	
	REST_API_СформироватьЗаголовокGZIP(СтруктураЗапроса);		
													
	РезультатыАвторизации = REST_API_СформироватьЗаголовокАвторизацииHTTPЗапроса(СтрокаПодключенияОригинал, СтруктураПодключения, СтруктураURI, СтруктураЗапроса, АдресаПеременных);
	
	Если РезультатыАвторизации.КодСостояния = 401 Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыАвторизации);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат РезультатыАвторизации;
	КонецЕсли;
	
	ТипЗапроса = "ПоУмолчанию";
	Если СтруктураЗапроса.Свойство("ТипЗапроса") Тогда
		ТипЗапроса = СтруктураЗапроса.ТипЗапроса;
	КонецЕсли;
	
	МассивВерсииAPI = Новый Массив;
	ИндексВерсииAPI = 0;
	
	Если ТипЗапроса = "ПроверкаСоединения" Тогда
		ID_ТекущейБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
		
		ID_ПодключаемойБазыMS = REST_API_ПолучитьИдБазыИзСтруктурыURI(СтруктураURI);
		Если НЕ ID_ПодключаемойБазыMS = ID_ТекущейБазыMS Тогда
			МассивВерсииAPI.Добавить(2);
			МассивВерсииAPI.Добавить(1);
			
			КомЯдро_СохранитьЗначениеПеременной("Версия_REST_API", МассивВерсииAPI[ИндексВерсииAPI], АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	КоличествоПопыток = 1;
	КоличествоПопытокРедирект		  = 1;
	КоличествоПопытокОтключенияСжатия = 1;
	КоличествоПопытокПриТаймауте	  = 1;
	КоличествоПопытокОбновленияТокена = ?(СтруктураЗапроса.Свойство("ОбновлениеТокена")
		ИЛИ СтруктураЗапроса.Свойство("НеПроверятьТокеныВХранилище1С"), 0, 2); // При обновлении токена не нужно пытаться обновить токен
	
	Пока КоличествоПопыток > 0 Цикл
		
		НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
				
		СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI,СтруктураЗапроса,ОтправляемыеДанные,АдресаПеременных);
		
		// Запись в ЖР
		ТекстЗаписиЖР = ГлЯдро_СтрШаблон("HTTPМетод: %1, Метод: %2, Тип запроса: %3",
			СтруктураЗапроса.HTTPМетод, СтруктураЗапроса.Метод, ТипЗапроса);
			
		СтрокаЗапроса 	 = ?(СтруктураОтвета.Свойство("СтрокаЗапроса"), СтруктураОтвета.СтрокаЗапроса, "");
		ЗаголовкиОтвета  = ?(СтруктураОтвета.Свойство("ЗаголовкиОтвета"), СтруктураОтвета.ЗаголовкиОтвета, "Заголовки ответа: ");
		ЗаголовкиЗапроса = "Заголовки запроса: ";
		Для каждого ТекущийЗаголовок ИЗ СтруктураЗапроса.Заголовки Цикл
			ЗаголовкиЗапроса = ЗаголовкиЗапроса + Символы.ПС + Символы.Таб + ТекущийЗаголовок.Ключ + ": " + Строка(ТекущийЗаголовок.Значение);
		КонецЦикла;
		
		ТекстЗаписиЖР = ТекстЗаписиЖР + Символы.ПС + "Строка запроса: " + СтрокаЗапроса + Символы.ПС +
			ЗаголовкиЗапроса + Символы.ПС + ЗаголовкиОтвета + Символы.ПС + "Время выполнения: ";
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("REST_API_ВыполнитьHTTPЗапрос", "Информация", ТекстЗаписиЖР, НачалоСобытия, АдресаПеременных);
		//
		
		Если СтруктураОтвета.Свойство("ТекстОшибки") И ЗначениеЗаполнено(СтруктураОтвета.ТекстОшибки) Тогда
			УровеньЖурналаПриОшибке = Неопределено;
			Если НЕ СтруктураЗапроса.Свойство("УровеньЖурналаПриОшибке", УровеньЖурналаПриОшибке) Тогда
				УровеньЖурнала = Неопределено;
				
				УровеньЖурналаКодыОшибок = Неопределено;
				Если СтруктураЗапроса.Свойство("УровеньЖурналаКодыОшибок", УровеньЖурналаКодыОшибок) Тогда
					УровеньЖурнала = УровеньЖурналаКодыОшибок.Получить(СтруктураОтвета.КодСостояния);
				КонецЕсли;
				
				Если УровеньЖурнала = Неопределено Тогда
					УровеньЖурналаПриОшибке = "Ошибка";
				КонецЕсли;
			КонецЕсли;
				
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("REST_API_ВыполнитьHTTPЗапрос", УровеньЖурналаПриОшибке, СтруктураОтвета.ТекстОшибки,, АдресаПеременных);
		КонецЕсли;
		
		// Если требуется отключить сжатие данных, пробуем отключить и делаем еще одну попытку
		Если СтруктураОтвета.Свойство("ОтключитьСжатиеДанных") 
			И СтруктураОтвета.ОтключитьСжатиеДанных
			И КоличествоПопытокОтключенияСжатия Тогда
			Попытка
				ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьСжатиеДанных",	Истина, АдресаПеременных);
				пСообщение = НСтр("ru = 'Сжатие данных было отключено из-за ошибки выполнения запроса (см. ошибку ранее)';
									|en = 'Data compression was disabled due to a query execution error (see error earlier)';
									|be = 'Сціск дадзеных было адключана з-за памылкі выканання запыту (гл. памылку раней)'; es = 'La compresión de datos se deshabilitó debido a un error en la ejecución de la consulta (consulte el error anterior)'; ka = 'მონაცემთა შეკუმშვა გამორთულია შეკითხვის შესრულების შეცდომის გამო (იხ'; kk = 'Деректерді қысу сұрауды орындау қатесіне байланысты өшірілді (бұрын қатені қараңыз)'; ro = 'Compresia datelor a fost dezactivată din cauza unei erori de execuție a interogării (consultați eroarea anterioară)'; tr = 'Sorgu yürütme hatası nedeniyle veri sıkıştırma devre dışı bırakıldı (önceki hataya bakın)'; uk = 'Стиснення даних було вимкнено через помилку виконання запиту (див. помилку раніше)'; uz = 'So''rovni bajarish xatosi tufayli ma''lumotlarni siqish o''chirildi (avval xatoni ko''ring)'");
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("REST_API_ВыполнитьHTTPЗапрос", "Предупреждение", пСообщение,, АдресаПеременных);
			Исключение
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Ошибка отключения сжатия';
									|en = 'Error disabling compression'; be = 'Памылка адключэння сціску'; es = 'Error al desactivar la compresión'; ka = 'შეცდომა გამორთვა შეკუმშვის'; kk = 'Қысуды өшіру қатесі'; ro = 'Eroare la dezactivarea compresiei'; tr = 'Sıkıştırma devre dışı bırakma hatası'; uk = 'Помилка відключення стиснення'; uz = 'Siqishni o''chirish xatosi'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;
			КоличествоПопытокОтключенияСжатия = КоличествоПопытокОтключенияСжатия - 1;
		ИначеЕсли СтруктураОтвета.КодСостояния = 401
			И КоличествоПопытокОбновленияТокена Тогда
			// На 1-ой итерации проверим токены в хранилище настроек, на случай если токены были переполучены в другом сеансе
			// На 2-ой итерации переполучим токены по рефреш-токену из хранилища настроек
			Если КоличествоПопытокОбновленияТокена = 2 Тогда
				СохраненныеТокены = REST_API_ПолучитьТокеныИзХранилища1С(СтрокаПодключенияОригинал, АдресаПеременных);
				
				Access_token  = "";
				Refresh_token = "";
				СохраненныеТокены.Свойство("Access_token",  Access_token);
				СохраненныеТокены.Свойство("Refresh_token", Refresh_token);
				
				Если ЗначениеЗаполнено(Access_token) Тогда
	            	СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + Access_token);
				КонецЕсли;
			ИначеЕсли КоличествоПопытокОбновленияТокена = 1 Тогда	
				НовыеТокены = REST_API_ОбновитьТокенSMARTS(СтрокаПодключенияОригинал, Refresh_token,,, АдресаПеременных);
				
				Если ТипЗнч(НовыеТокены) = Тип("Структура")
					И ЗначениеЗаполнено(НовыеТокены.Access_token) Тогда
					СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + НовыеТокены.Access_token);
				КонецЕсли;
			КонецЕсли;
			
			КоличествоПопытокОбновленияТокена = КоличествоПопытокОбновленияТокена - 1;
		ИначеЕсли СтруктураОтвета.Свойство("Редирект")
			И КоличествоПопытокРедирект Тогда
			Location = СтруктураОтвета.Редирект;
			Если Location <> СтрокаПодключения Тогда
				КлючПеременной = "Location_" + REST_API_ПолучитьКлючURL(СтруктураURI);
				КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, Location, АдресаПеременных);
			КонецЕсли;
			
			СтрокаПодключения = Location;
			
			Если СтруктураURI.Свойство("TempUid", TempUid) Тогда
				// Если в изначальной строке был передан TempUid, его нельзя потерять
			КонецЕсли;
			
			СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
			Если ЗначениеЗаполнено(TempUid) Тогда
				СтруктураURI.Вставить("TempUid", TempUid);
			КонецЕсли;
			
			КоличествоПопытокРедирект = КоличествоПопытокРедирект - 1;
			
		ИначеЕсли СтруктураОтвета.Свойство("ПревышенТаймаут") И КоличествоПопытокПриТаймауте Тогда
			
			КоличествоПопытокПриТаймауте = КоличествоПопытокПриТаймауте - 1;
			
			ПаузаПередПовторнойПопыткой = Неопределено;
			СтруктураЗапроса.Свойство("ПаузаПередПовторнойПопыткой", ПаузаПередПовторнойПопыткой);
			
			Если ПаузаПередПовторнойПопыткой <> Неопределено Тогда
				ГлЯдро_Пауза(ПаузаПередПовторнойПопыткой);
			КонецЕсли;
			
		ИначеЕсли НЕ СтруктураОтвета.Статус	И ИндексВерсииAPI < МассивВерсииAPI.Количество() - 1 Тогда
			ИндексВерсииAPI = ИндексВерсииAPI + 1;
			
			КомЯдро_СохранитьЗначениеПеременной("Версия_REST_API", МассивВерсииAPI[ИндексВерсииAPI], АдресаПеременных);
		Иначе
			КоличествоПопыток = ?(СтруктураОтвета.КодСостояния = Неопределено, КоличествоПопыток - 1, 0);	
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтруктураОтвета.КодСостояния = 401 Тогда
		//В плане сделать переавторизацию
		//Если REST_API_session <> Неопределено Тогда
		//	refresh_token = REST_API_session.Получить("refresh_token");
		//КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураОтвета);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураОтвета;
	
КонецФункции

Функция REST_API_СформироватьЗаголовокАвторизацииHTTPЗапроса(СтрокаПодключения, СтруктураПодключения, СтруктураURI, СтруктураЗапроса, АдресаПеременных)
	
	ИмяСобытия = "REST_API_СформироватьЗаголовокАвторизацииHTTPЗапроса";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключения,СтруктураПодключения,СтруктураURI,СтруктураЗапроса",
		СтрокаПодключения, СтруктураПодключения, СтруктураURI, СтруктураЗапроса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	РезультатыАвторизации = Новый Структура;
	РезультатыАвторизации.Вставить("КодСостояния", 200);
	РезультатыАвторизации.Вставить("ТекстОшибки",  "");
	РезультатыАвторизации.Вставить("Статус", 	   Истина);
	
	АвторизацияВключена = ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("АвторизацияВключена")
		И СтруктураПодключения.АвторизацияВключена;
	ТребуетсяПолучитьТокен = Ложь;
	АвторизацияЛогин 	   = "";
	АвторизацияПароль 	   = "";
	TempUid 			   = "";
	
	Если АвторизацияВключена Тогда
		REST_API_session = КомЯдро_ПолучитьЗначениеПеременной("API_session_" + REST_API_ПолучитьКлючURL(СтруктураURI), АдресаПеременных);	
		
		Если REST_API_session <> Неопределено Тогда
			Access_token = REST_API_session.Получить("Access_token");
			Если Access_token = Неопределено Тогда
				Access_token = REST_API_session.Получить("access_token");	
			КонецЕсли;
			
			СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + Access_token);
		ИначеЕсли СтруктураПодключения.Свойство("АвторизацияТокен") И ЗначениеЗаполнено(СтруктураПодключения.АвторизацияТокен) Тогда
			СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + СтруктураПодключения.АвторизацияТокен);
		Иначе
			// Получение токена по TempUid
			Если ЗначениеЗаполнено(СтруктураURI.TempUid) Тогда
				TempUid = СтруктураURI.TempUid;
			ИначеЕсли СтруктураПодключения.Свойство("TempUid", TempUid)
				И ЗначениеЗаполнено(TempUid) Тогда
				// TempUid получен из структуры подключения
			КонецЕсли;
			
			Если ЗначениеЗаполнено(TempUid) Тогда
				ТребуетсяПолучитьТокен 	= Истина;
				АвторизацияЛогин  		= "__tempuid__";
				АвторизацияПароль 		= TempUid;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяПолучитьТокен Тогда
		ДанныеТокена = ГлЯдро_ПолучитьТокенSMARTS(СтрокаПодключения, АвторизацияЛогин, АвторизацияПароль,, "REST_API",, АдресаПеременных);
		Если НЕ ЗначениеЗаполнено(ДанныеТокена) ИЛИ ДанныеТокена = Ложь Тогда
			РезультатыАвторизации.Вставить("КодСостояния", 401);
			РезультатыАвторизации.Вставить("ТекстОшибки",  "Не удалось авторизоваться");
			РезультатыАвторизации.Вставить("Статус", 	   Ложь);
		ИначеЕсли ТипЗнч(ДанныеТокена) = Тип("Структура") Тогда
			Если ТипЗнч(СтруктураПодключения) = Тип("Структура") Тогда
				СтруктураПодключения.Вставить("АвторизацияТокен", 		ДанныеТокена.Access_token);
				СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	ДанныеТокена.Refresh_token);
			КонецЕсли;
			
			СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + ДанныеТокена.Access_token);
		ИначеЕсли ТипЗнч(ДанныеТокена) = Тип("Строка") Тогда
			Если ТипЗнч(СтруктураПодключения) = Тип("Структура") Тогда
				СтруктураПодключения.Вставить("АвторизацияТокен", 		ДанныеТокена);
				СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	"");
			КонецЕсли;
			
			СтруктураЗапроса.Заголовки.Вставить("Authorization", "Bearer " + ДанныеТокена);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыАвторизации);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатыАвторизации;
	
КонецФункции

Функция REST_API_ПолучитьВерсиюAPI(СтруктураURI = Неопределено, СтруктураЗапроса = Неопределено, АдресаПеременных)

	ВерсияAPI = КомЯдро_ПолучитьЗначениеПеременной("Версия_REST_API", АдресаПеременных);
	
	Если НЕ ВерсияAPI = Неопределено Тогда
		Возврат ВерсияAPI;
	КонецЕсли;
	
	СохранитьВКэше = Истина;
	Если НЕ СтруктураURI = Неопределено Тогда
		ID_ТекущейБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
		
		ID_ПодключаемойБазыMS = REST_API_ПолучитьИдБазыИзСтруктурыURI(СтруктураURI);
		Если НЕ ID_ПодключаемойБазыMS = ID_ТекущейБазыMS Тогда
			СохранитьВКэше = Ложь;
		КонецЕсли;
	КонецЕсли;
		
	Если СохранитьВКэше Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
	Иначе
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(ID_ПодключаемойБазыMS,, АдресаПеременных);
	КонецЕсли;
	
	ВерсияПоУмолчанию = 1; 
	
	ВерсияПлатформыSMARTS = Неопределено;
	Если НЕ ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		ИЛИ НЕ ПараметрыПодключенияMS.Свойство("ВерсияПлатформыSMARTS", ВерсияПлатформыSMARTS) Тогда
		Возврат ВерсияПоУмолчанию;
	КонецЕсли;
	
	ВерсияAPI = ГлЯдро_ВерсияAPIПоДаннымБазыSMARTS(ВерсияПлатформыSMARTS, АдресаПеременных);
	Если ВерсияAPI = Неопределено Тогда
		Возврат ВерсияПоУмолчанию;
	КонецЕсли;
	
	Если СохранитьВКэше Тогда
		КомЯдро_СохранитьЗначениеПеременной("Версия_REST_API", ВерсияAPI, АдресаПеременных);
	КонецЕсли;
	
	Возврат ВерсияAPI;
	
КонецФункции

// Разбирает строку URI на составные части и возвращает в виде структуры.
// На основе RFC 3986.
//
// Параметры:
//     СтрокаURI - Строка - ссылка на ресурс в формате:
//                          <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//     Структура - составные части URI согласно формату:
//         * Схема         - Строка.
//         * Логин         - Строка.
//         * Пароль        - Строка.
//         * ИмяСервера    - Строка - часть <хост>:<порт> входного параметра.
//         * Хост          - Строка.
//         * Порт          - Строка.
//         * ПутьНаСервере - Строка - часть <путь>?<параметры>#<якорь> входного параметра.
Функция REST_API_ПолучитьСтруктуруURIИзСтроки(Знач СтрокаURI) 
   
    СтрокаURI = СокрЛП(СтрокаURI);
   
    // Схема
    Схема = "";
    Позиция = ГлЯдро_СтрНайти(СтрокаURI, "://");
	Если НЕ Позиция > 0 Тогда
        Позиция = ГлЯдро_СтрНайти(СтрокаURI, ":\\");	
	КонецЕсли;
    Если Позиция > 0 Тогда
        Схема = НРег(Лев(СтрокаURI, Позиция - 1));
        СтрокаURI = Сред(СтрокаURI, Позиция + 3);
    КонецЕсли;

	// Строка соединения и путь на сервере.
	СтрокаСоединения = СтрокаURI;
    ПутьНаСервере = "";
    ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(СтрокаСоединения, "/");
	Если НЕ ПозицияСтрокиПоиска > 0 Тогда
		ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(СтрокаСоединения, "\");
	КонецЕсли;
	Если ПозицияСтрокиПоиска > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, ПозицияСтрокиПоиска + 1);
		Если Прав(ПутьНаСервере, 1) = "/" Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, СтрДлина(ПутьНаСервере) - 1);
		КонецЕсли;
		СтрокаСоединения = Лев(СтрокаСоединения, ПозицияСтрокиПоиска - 1);
		
		ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(ПутьНаСервере, "?");
		Если ПозицияСтрокиПоиска > 0 Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, ПозицияСтрокиПоиска - 1);
		КонецЕсли;
	КонецЕсли;
       
    // Информация пользователя и имя сервера
    СтрокаАвторизации = "";
    ИмяСервера = СтрокаСоединения;
    Позиция = ГлЯдро_СтрНайти(СтрокаСоединения, "@");
    Если Позиция > 0 Тогда
        СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
        ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
    КонецЕсли;
   
    // Логин и пароль
    Логин = СтрокаАвторизации;
    Пароль = "";
    Позиция = ГлЯдро_СтрНайти(СтрокаАвторизации, ":");
    Если Позиция > 0 Тогда
        Логин = Лев(СтрокаАвторизации, Позиция - 1);
        Пароль = Сред(СтрокаАвторизации, Позиция + 1);
    КонецЕсли;
   
    // Хост и порт
    Хост = ИмяСервера;
    Порт = "";
    Позиция = ГлЯдро_СтрНайти(ИмяСервера, ":");
    Если Позиция > 0 Тогда
        Хост = Лев(ИмяСервера, Позиция - 1);
        Порт = Сред(ИмяСервера, Позиция + 1);
        Если Не ГлЯдро_ТолькоЦифрыВСтроке(Порт) Тогда
            Порт = "";
        КонецЕсли;
	КонецЕсли;
	
	// Данные упрощенной авторизации
	TempUid = "";
	ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(СтрокаURI, "tempuid=");
	Если ПозицияСтрокиПоиска > 0 Тогда
		TempUid	= Сред(СтрокаURI, ПозицияСтрокиПоиска + 8);
	КонецЕсли;
   
    Результат = Новый Структура;
    Результат.Вставить("Схема",			Схема);
    Результат.Вставить("Логин",			Логин);
    Результат.Вставить("Пароль",		Пароль);
    Результат.Вставить("ИмяСервера",	ИмяСервера);
    Результат.Вставить("Хост",			Хост);
    Результат.Вставить("Порт", 			?(ПустаяСтрока(Порт), Неопределено, Число(Порт)));
    Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
    Результат.Вставить("Протокол", 		?(ПустаяСтрока(Схема), "http", Схема));
	Результат.Вставить("TempUid",		TempUid);
	
    Возврат Результат;

КонецФункции

Функция REST_API_ПолучитьИдБазыИзСтруктурыURI(СтруктураURI)
	
	ИдБазыSMARTS = СтруктураURI.ПутьНаСервере;
	
	ПозицияВопрос = Найти(ИдБазыSMARTS, "?");
	Если ПозицияВопрос Тогда
		ИдБазыSMARTS = Лев(ИдБазыSMARTS, ПозицияВопрос - 1);
	КонецЕсли;
	
	Возврат ИдБазыSMARTS;

КонецФункции

Функция REST_API_ВыполнитьHTTPЗапрос(СтруктураURI,СтруктураЗапроса,ОтправляемыеДанные = Неопределено,АдресаПеременных) 
	
	Перем ОтветHTTP,ТекстОшибки;
	
	ИмяСобытия = "REST_API_ВыполнитьHTTPЗапрос";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураURI,СтруктураЗапроса,ОтправляемыеДанные",
		СтруктураURI, СтруктураЗапроса, ОтправляемыеДанные);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Таймаут = ГлЯдро_ПолучитьТаймаутПоТипуМетода(СтруктураЗапроса,АдресаПеременных);
	
	ВернутьСтруктуру 	  	= ?(СтруктураЗапроса.Свойство("ВернутьСтруктуру"), 		 СтруктураЗапроса.ВернутьСтруктуру, 	  Ложь);
	ВернутьДвоичныеДанные 	= ?(СтруктураЗапроса.Свойство("ВернутьДвоичныеДанные"),  СтруктураЗапроса.ВернутьДвоичныеДанные,  Ложь);
	ВернутьСтроку 	  		= ?(СтруктураЗапроса.Свойство("ВернутьСтроку"), 		 СтруктураЗапроса.ВернутьСтроку, 		  Ложь);
	ЗапросКВнешнемуРесурсу 	= ?(СтруктураЗапроса.Свойство("ЗапросКВнешнемуРесурсу"), СтруктураЗапроса.ЗапросКВнешнемуРесурсу, Ложь);
	AcceptLanguage			= ?(СтруктураЗапроса.Свойство("AcceptLanguage"),		 СтруктураЗапроса.AcceptLanguage,		  Ложь);
	
	Если НЕ ЗапросКВнешнемуРесурсу Тогда
		ВерсияAPI = Неопределено;
		Если НЕ СтруктураЗапроса.Свойство("ВерсияAPI", ВерсияAPI) Тогда
			ВерсияAPI = ГлЯдро_СтрШаблон("/api/v%1", REST_API_ПолучитьВерсиюAPI(СтруктураURI, СтруктураЗапроса, АдресаПеременных));
		КонецЕсли;
		
		MSToken = ?(АдресаПеременных.Свойство("MSToken"), АдресаПеременных.MSToken, ГлЯдро_ПолучитьВременныйMSToken1C());
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(
	          СтруктураURI.Хост // сервер (хост)
	        , СтруктураURI.Порт // порт, по умолчанию
	        , // СтруктураURI.Логин, // пользователь для доступа к серверу (если он есть)
	        , // СтруктураURI.Пароль, // пароль для доступа к серверу (если он есть)
	        , // здесь указывается прокси, если он есть
	        , Таймаут // таймаут в секундах, 0 или пусто - не устанавливать
	        , ?(СтруктураURI.Протокол = "https", Новый ЗащищенноеСоединениеOpenSSL(), Неопределено) // защищенное соединение, если используется https
	    );
	Исключение
		
		// <Лог>
		ИнфоОшибка 	= ИнформацияОбОшибке();
		ЯзСтрока 	= "ru = 'Не удалось создать HTTP-соединение (%1://%2:%3)'";
		прПротокол 	= СтруктураURI.Протокол;
		прХост 		= СтруктураURI.Хост;
		прПорт 		= Формат(СтруктураURI.Порт, "ЧГ=0");
		ТекстОшибки = "Не удалось создать HTTP-соединение по причине: " + ИнфоОшибка.Описание + " (" + прПротокол + "://" + прХост + ":" + прПорт + ")";
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"Протокол,Хост,Порт",
			прПротокол, прХост, прПорт);
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
		
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("КодСостояния", 	Неопределено);
		СтруктураОтвета.Вставить("ТекстОшибки", 	ТекстОшибки);
		СтруктураОтвета.Вставить("Статус", 			Ложь);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураОтвета);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураОтвета;
	КонецПопытки;
	
	URIМетод = ?(СтруктураЗапроса.Свойство("Метод") И ЗначениеЗаполнено(СтруктураЗапроса.Метод), "/" + СтруктураЗапроса.Метод, "");
	СтрокаЗапроса = ?(ЗначениеЗаполнено(СтруктураURI.ПутьНаСервере),"/"+СтруктураURI.ПутьНаСервере,"");
	
	Если ЗапросКВнешнемуРесурсу Тогда
		СтрокаЗапроса = СтрокаЗапроса + URIМетод;
	Иначе
		СтрокаЗапроса = СтрокаЗапроса + ВерсияAPI + СтрЗаменить(URIМетод,"#","%23");	 // временное решение, замена # на %23
		СтруктураЗапроса.Заголовки.Вставить("connectiontoken",MSToken);
	КонецЕсли;
	
	Если НЕ AcceptLanguage = Ложь Тогда
		СтруктураЗапроса.Заголовки.Вставить("accept-language", AcceptLanguage);	
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Если СтруктураЗапроса.Свойство("Заголовки") Тогда
		Заголовки = СтруктураЗапроса.Заголовки;
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки);
	
	Если СтруктураЗапроса.HTTPМетод = "POST"  
		ИЛИ СтруктураЗапроса.HTTPМетод = "PATCH" 
		ИЛИ СтруктураЗапроса.HTTPМетод = "PUT" Тогда
		Если ТипЗнч(ОтправляемыеДанные) = Тип("Строка") Тогда
			Запрос.УстановитьТелоИзСтроки(ОтправляемыеДанные);
		ИначеЕсли ТипЗнч(ОтправляемыеДанные) = Тип("ДвоичныеДанные") Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(ОтправляемыеДанные);
		Иначе
			ЗаписьJSON = Новый ЗаписьJSON; 
			ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто,"",Истина,,Ложь,Ложь,Ложь,Истина,Ложь);
			ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
			ЗаписатьJSON(ЗаписьJSON, ОтправляемыеДанные); // ОтправляемыеДанные обязательны в этом случае
			СтрокаДляТела = ЗаписьJSON.Закрыть();
			
			СжиматьJSON = ?(СтруктураЗапроса.Свойство("СжиматьJSON"), СтруктураЗапроса.СжиматьJSON, Истина);
			ОтключитьСжатиеДанных = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьСжатиеДанных",, АдресаПеременных);
			
			Если ?(ЗапросКВнешнемуРесурсу, НЕ СжиматьJSON, ОтключитьСжатиеДанных) = Истина Тогда
				Если Запрос.Заголовки.Получить("Content-Encoding") = "gzip" Тогда
					Запрос.Заголовки.Удалить("Content-Encoding");
				КонецЕсли;
				
				Запрос.УстановитьТелоИзСтроки(СтрокаДляТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Иначе
				СжатыеДанные = Неопределено;
				КоличествоПопытокСжатия = 2;
				Пока КоличествоПопытокСжатия Цикл
					Попытка
						СжатыеДанные = ГлЯдро_ЗашифроватьGZIP(СтрокаДляТела, АдресаПеременных);
						КоличествоПопытокСжатия = 0;
					Исключение	
						// <Лог>
						ИнфоОшибка = ИнформацияОбОшибке();
						ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
						// </Лог>
						КоличествоПопытокСжатия = КоличествоПопытокСжатия - 1;						
					КонецПопытки;
				КонецЦикла;
				Если СжатыеДанные <> Неопределено Тогда
					Запрос.Заголовки.Вставить("Content-Encoding", "gzip");
					Запрос.УстановитьТелоИзДвоичныхДанных(СжатыеДанные);
				Иначе
					Запрос.УстановитьТелоИзСтроки(СтрокаДляТела, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("КодСостояния", Неопределено);
	СтруктураОтвета.Вставить("ТекстОшибки", "");
	СтруктураОтвета.Вставить("Статус", Ложь);
	Попытка
		ОтветHTTP = Соединение.ВызватьHTTPМетод(СтруктураЗапроса.HTTPМетод, Запрос);
		
		ЗаголовкиОтвета = "Заголовки ответа: ";
		Для каждого ТекущийЗаголовок ИЗ ОтветHTTP.Заголовки Цикл
			ЗаголовкиОтвета = ЗаголовкиОтвета + Символы.ПС + Символы.Таб + ТекущийЗаголовок.Ключ + ": " + Строка(ТекущийЗаголовок.Значение);
		КонецЦикла;
		СтруктураОтвета.Вставить("ЗаголовкиОтвета", ЗаголовкиОтвета);
		
		Если ОтветHTTP.КодСостояния > 300 И ОтветHTTP.КодСостояния < 400 Тогда
			Location = ОтветHTTP.Заголовки.Получить("Location");
			Если ЗначениеЗаполнено(Location) Тогда
				ПозицияAPI = ГлЯдро_СтрНайти(Location, "/api");
				Если ПозицияAPI Тогда
					Location = Лев(Location, ПозицияAPI - 1);
				КонецЕсли;
				
				// Location для редиректа может вернуться при попытке получения или обновления токена
				ПозицияConnectToken = ГлЯдро_СтрНайти(Location, "/connect/token");
				Если ПозицияConnectToken Тогда
					Location = Лев(Location, ПозицияConnectToken - 1);
				КонецЕсли;
				
				// Если в запросе вернулся Location для редиректа, повторяем запрос по новому пути
				СтруктураОтвета.Вставить("Редирект", Location);
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураОтвета);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат СтруктураОтвета;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураОтвета.КодСостояния = ОтветHTTP.КодСостояния;
		
		ОтветСервера = "";
		ОшибкаРаспаковкиОтвета = Ложь;
		Если ОтветHTTP.Заголовки.Получить("Content-Encoding") = "gzip" Тогда
			КоличествоПопытокРаспаковки = 2;
			Пока КоличествоПопытокРаспаковки Цикл
				Попытка	
					ОтветСервера = ГлЯдро_РасшифроватьGZIP(ОтветHTTP.ПолучитьТелоКакДвоичныеДанные(), АдресаПеременных);
					КоличествоПопытокРаспаковки = 0;
				Исключение				
					КоличествоПопытокРаспаковки = КоличествоПопытокРаспаковки - 1;
					Если НЕ КоличествоПопытокРаспаковки Тогда
						// <Лог>
						ИнфоОшибка = ИнформацияОбОшибке();
						ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
						// </Лог>
						ОшибкаРаспаковкиОтвета = Истина;
					КонецЕсли;
				КонецПопытки;
			КонецЦикла;
		ИначеЕсли ВернутьДвоичныеДанные Тогда
			ОтветСервера = ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
		Иначе
			ОтветСервера = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
		КонецЕсли;
		
		СтруктураОтвета.Статус = REST_API_КодСостоянияУспешно(ОтветHTTP.КодСостояния);
		
		Если НЕ СтруктураОтвета.Статус Тогда
			ТекстОшибки = ГлЯдро_СтрШаблон(" Ошибка %1%2%3", ОтветHTTP.КодСостояния, Символы.ПС, ОтветСервера);
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		Если ЗначениеЗаполнено(ОтветСервера) И НЕ ОшибкаРаспаковкиОтвета Тогда
			Если ВернутьДвоичныеДанные Тогда
				СтруктураОтвета.Вставить("ОтветСервера", ПоместитьВоВременноеХранилище(ОтветСервера, Новый УникальныйИдентификатор()));
			ИначеЕсли ВернутьСтроку Тогда
				СтруктураОтвета.Вставить("ОтветСервера", ОтветСервера);	
			Иначе
				Если ВернутьСтруктуру Тогда
					НачСреза = ГлЯдро_СтрНайти(ОтветСервера,"""@odata.context""");
					Если НачСреза > 0 Тогда
						КонецСреза = ГлЯдро_СтрНайти(ОтветСервера,""",",,НачСреза);
						ОтветСервера = Лев(ОтветСервера,НачСреза) + Прав(ОтветСервера,СтрДлина(ОтветСервера)-КонецСреза-2);
					КонецЕсли;
					ОтветСервера = СтрЗаменить(ОтветСервера, "@odata.", "");
				КонецЕсли;
				ЧтениеJSON.УстановитьСтроку(ОтветСервера);
				Соответствие = ПрочитатьJSON(ЧтениеJSON,НЕ ВернутьСтруктуру);
				СтруктураОтвета.Вставить("ОтветСервера", Соответствие);
				СтруктураОтвета.Вставить("ОтветСервераНеРасшифрованный", ОтветСервера);
			КонецЕсли;
		КонецЕсли;
				
	Исключение
		Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Не удалось выполнить HTTP запрос по причине " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВыполняемыйЗапрос = СтрокаЗапроса;
		Если СтруктураЗапроса.Свойство("СтрокаЗапроса") Тогда
			ВыполняемыйЗапрос = СтруктураЗапроса.СтрокаЗапроса;		
		КонецЕсли;		
		ТекстОшибки = ГлЯдро_ПреобразоватьИзUnicode(ТекстОшибки);
		ТекстОшибки = ТекстОшибки + ", Строка запроса: " + СтруктураURI.Протокол + "://" + СтруктураURI.ИмяСервера + ВыполняемыйЗапрос + ", Таймаут: " + Таймаут + "с.";
		
		Если НЕ СтруктураОтвета.КодСостояния = 404 Тогда // Если вернулась 404 ошибка, проблема точно не в сжатии и отключать его не нужно (при необходимости можно дополнить другими кодами ошибок)
			Попытка
				ContentEncoding = ОтветHTTP.Заголовки.Получить("Content-Encoding"); // Смотрим на заголовок Content-Encoding, т.к. Mobile SMARTS не отправляет Accept-Encoding
			Исключение
				ContentEncoding = Неопределено;
			КонецПопытки;
			СжатиеПоддерживаетсяСерверомMS = НЕ ContentEncoding = Неопределено И ГлЯдро_СтрНайти(ContentEncoding, "gzip");
		Иначе
			СжатиеПоддерживаетсяСерверомMS = Истина;	
		КонецЕсли;
			
		ОшибкаРаспаковкиОтвета = СтруктураОтвета.КодСостояния = 400                         
			И (ГлЯдро_СтрНайти(ВРег(ТекстОшибки), ВРег("Не удается преобразовать байты"))
				ИЛИ ГлЯдро_СтрНайти(ВРег(ТекстОшибки), ВРег("Unable to translate bytes")));
				
		ОшибкаТаймаут = ГлЯдро_СтрНайти(ВРег(ТекстОшибки), ВРег("Превышен таймаут"))
							ИЛИ ГлЯдро_СтрНайти(ВРег(ТекстОшибки), ВРег("Timed out"));
				
		Если ОшибкаТаймаут Тогда
			СтруктураОтвета.Вставить("ПревышенТаймаут", Истина);	
		ИначеЕсли НЕ СжатиеПоддерживаетсяСерверомMS ИЛИ ОшибкаРаспаковкиОтвета Тогда
            СтруктураОтвета.Вставить("ОтключитьСжатиеДанных", Истина);
		ИначеЕсли СтруктураОтвета.КодСостояния = 500 И НайтиНедопустимыеСимволыXML(ТекстОшибки) Тогда
			#Если ВебКлиент Тогда
				ТекстОшибки = "Ошибка 500" + Символы.ПС + ", Строка запроса: " + СтруктураURI.Протокол + "://" + СтруктураURI.ИмяСервера + ВыполняемыйЗапрос + ", Таймаут: " + Таймаут + "с.";
			#Иначе
				Если НайтиНедопустимыеСимволыXML(ТекстОшибки) Тогда
					ТекстОшибки = ГлЯдро_ОчиститьНедопустимыеСимволыXML(ТекстОшибки);					
				КонецЕсли;
			#КонецЕсли
			СтруктураОтвета.Вставить("ОтключитьСжатиеДанных", Истина);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета.Вставить("ТекстОшибки",ТекстОшибки);
	СтруктураОтвета.Вставить("СтрокаЗапроса", СтрокаЗапроса);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураОтвета);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура REST_API_СформироватьЗаголовокGZIP(СтруктураЗапроса) Экспорт
	
	Если ЗначениеЗаполнено(СтруктураЗапроса) Тогда
		
		Если НЕ СтруктураЗапроса.Свойство("Заголовки")
			ИЛИ СтруктураЗапроса.Заголовки = Неопределено Тогда
			СтруктураЗапроса.Вставить("Заголовки", Новый Соответствие());
			СтруктураЗапроса.Заголовки.Вставить("Content-Type", "application/json");
			
			ВернутьДвоичныеДанные = СтруктураЗапроса.Свойство("ВернутьДвоичныеДанные")
				И СтруктураЗапроса.ВернутьДвоичныеДанные = Истина;
			Если НЕ ВернутьДвоичныеДанные Тогда
				СтруктураЗапроса.Заголовки.Вставить("Accept-Encoding", "gzip");
			КонецЕсли;
		КонецЕсли;
		
		// Передаем в заголовки тип работы с 1С для корректной распаковки данных из GZIP
		Если ТипЗнч(СтруктураЗапроса) = Тип("Структура") 
			И СтруктураЗапроса.Свойство("Заголовки") Тогда
			СтруктураЗапроса.Заголовки.Вставить("exchtype","onec");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует ключ уникальности для URL строки из структуры URI.
// Для хранения переменных в разрезе строк подключений Location и API_session
Функция REST_API_ПолучитьКлючURL(СтруктураURI) Экспорт
	
	СыройКлюч = СтруктураURI.ПутьНаСервере;
	//СыройКлюч = СтруктураURI.Хост + "_" 
	//			+ Формат(СтруктураURI.Порт, "ЧГ=") + "_" 
	//			+ СтрЗаменить(СтруктураURI.ПутьНаСервере, "-", "");
	
	Возврат ГлЯдро_СтрЗаменитьНедопустимыеСимволы(СыройКлюч, "_");
	
КонецФункции

#КонецОбласти

Функция REST_API_ПолучитьМобильныеУстройстваSMARTS(ТипБазы,АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьМобильныеУстройстваSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Devices");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Devices = Неопределено;
	Иначе
		Devices = СтруктураОтвета.ОтветСервера.Получить("value");	
	КонецЕсли;	
		
	СписокУстройствMS = Новый Массив;
	
	Если Devices <> Неопределено Тогда
		Для Каждого ТекущееУстройство ИЗ Devices Цикл                  
			
			DeviceId   	 = СокрЛП(ТекущееУстройство.Получить("deviceId"));
			DeviceName 	 = СокрЛП(ТекущееУстройство.Получить("deviceName"));
			Pincode 	 = СокрЛП(ТекущееУстройство.Получить("pincode"));
			lastInfoTime = REST_API_ПреобразоватьКДате(СокрЛП(ТекущееУстройство.Получить("lastInfoTime")));
						
			СписокУстройствMS.Добавить(ГлЯдро_СтруктураОписанияУстройстваSMARTS(DeviceId,DeviceName,lastInfoTime,,Pincode));
		КонецЦикла;
	КонецЕсли;
	
	УстройстваMS = Новый ДеревоЗначений;
	УстройстваMS.Колонки.Добавить("Выгружать", 			  Новый ОписаниеТипов("Булево"), "Выгружать");
	УстройстваMS.Колонки.Добавить("ПинКод",   		  	  Новый ОписаниеТипов("Строка"), "Пин-код");
	УстройстваMS.Колонки.Добавить("ГруппаПользователь",   Новый ОписаниеТипов("Строка"), "Группа/пользователь");
	УстройстваMS.Колонки.Добавить("ИдГруппыПользователя", Новый ОписаниеТипов("Строка"), "Ид группы/пользователя");	
	
	Для Каждого Устройство из СписокУстройствMS Цикл
		
		СтрокаДерева 						= УстройстваMS.Строки.Добавить();
		СтрокаДерева.ИдГруппыПользователя 	= Устройство.deviceId;
		СтрокаДерева.ГруппаПользователь 	= Устройство.deviceName;		            
		СтрокаДерева.ПинКод 				= Устройство.pincode;					
				
	КонецЦикла;
	
	АдресУстройствВХранилище = ПоместитьВоВременноеХранилище(УстройстваMS, Новый УникальныйИдентификатор());
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресУстройствВХранилище);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АдресУстройствВХранилище;
	
КонецФункции

Процедура REST_API_ОбновитьШаблоныВесовогоТовараMS(ТаблицаШаблонов, ТипБазы, АдресаПеременных)

	ИмяСобытия = "REST_API_ОбновитьШаблоныВесовогоТовараMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТаблицаШаблонов,ТипБазы",
		ТаблицаШаблонов, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);                              
	
	КоллекцияШаблонов = Новый Массив;
	// Добавление новых шаблонов
	Для Каждого Шаблон из ТаблицаШаблонов Цикл
		ЦелаяЧасть = Шаблон.ЦелаяЧасть - СтрДлина(Шаблон.Префикс);
		Если Шаблон.ПрефиксВключенВКод Тогда			
			КоллекцияШаблонов.Добавить("{Barcode:@" + Шаблон.Префикс + "[0-9]{" + Шаблон.ДлинаКодаВесовогоТовара + "}}{Quantity:" + ЦелаяЧасть + "." + Шаблон.ДробнаяЧасть + "}{OneC:1}");
		Иначе
			КоллекцияШаблонов.Добавить(Шаблон.Префикс + "{Barcode:" + Шаблон.ДлинаКодаВесовогоТовара + "}{Quantity:" + ЦелаяЧасть + "." + Шаблон.ДробнаяЧасть + "}{OneC:1}");
		КонецЕсли;
	КонецЦикла;	
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	ОтправляемыеДанные = Новый Соответствие;
	ОтправляемыеДанные.Вставить("commonTemplates", КоллекцияШаблонов);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"PATCH");
	СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "ProductSchema('1')", "InventorySchema"));
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
	КонецЕсли;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция REST_API_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ЗагрузитьФайлИзБазыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS,ПараметрыФайла",
		ПараметрыПодключенияMS, ПараметрыФайла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	АдресДвоичныхДанных = Неопределено;
	
	ПутьКФайлу	  = ПараметрыФайла.ПутьКФайлу;
	ИмяФайла	  = ПараметрыФайла.ИмяФайла;
	СтрокаЗапроса = ПутьКФайлу + ИмяФайла;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод",	"GET");
	СтруктураЗапроса.Вставить("Метод",		СтрокаЗапроса);
	СтруктураЗапроса.Вставить("ТипЗапроса",	"ПоУмолчанию");
	СтруктураЗапроса.Вставить("ВерсияAPI",	"");
	СтруктураЗапроса.Вставить("ВернутьДвоичныеДанные",	 Истина);
	СтруктураЗапроса.Вставить("УровеньЖурналаПриОшибке", "Информация");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(ПараметрыПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
	
	Если REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		АдресДвоичныхДанных = СтруктураОтвета.ОтветСервера;
	Иначе
		ПараметрыЗаписи = Новый Структура("УровеньЖурнала", "Информация");
		
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресДвоичныхДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АдресДвоичныхДанных;
	
КонецФункции

Функция REST_API_ПолучитьДанныеШапкиДокументаMS(ДокументSMARTS, МетаданныеДокументаMS = Неопределено, АдресаПеременных)
	
	Перем ЗначениеРеквизита;
	
	ИмяСобытия = "REST_API_ПолучитьДанныеШапкиДокументаMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДокументSMARTS,МетаданныеДокументаMS",
		ДокументSMARTS, МетаданныеДокументаMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	РеквизитыШапки = Новый Структура;
	
	Если МетаданныеДокументаMS = Неопределено Тогда
		МетаданныеДокументаMS = ГлЯдро_МетаданныеДокументаПоСтруктуреДокументаMS(ДокументSMARTS, АдресаПеременных);
		Если МетаданныеДокументаMS = Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СоответствиеРеквизитов = ГлЯдро_ПолучитьСоответствиеРеквизитовUniДокументаMS(МетаданныеДокументаMS);
	
	СоответствиеРеквизитов.Вставить("ВремяНачалаОбработки",			"inProcessDate");
	СоответствиеРеквизитов.Вставить("ВремяИзменения", 				"modifiedDate");
	СоответствиеРеквизитов.Вставить("ВремяЗавершения", 				"finishedDate");
	СоответствиеРеквизитов.Вставить("ЕстьНедобор", 				  	"underloaded");
	СоответствиеРеквизитов.Вставить("ЕстьПереполнение", 		  	"overloaded");
	СоответствиеРеквизитов.Вставить("ЕстьПереполнениеИлиНедобор", 	"underloadedOrOverloaded");
	
	// Реквизиты, названия которых отличаются в возвращаемой структуре РеквизитыШапки и метаданных документа MS
	ИменаРеквизитовШапки = Новый Соответствие;
	ИменаРеквизитовШапки.Вставить("КонтрольКолва", "КонтрольКоличества");
	
	КешТранслитерацииПолей = Новый Соответствие;
		
	Для Каждого РеквизитДокумента Из МетаданныеДокументаMS.Реквизиты Цикл
		Попытка
			ИмяПоля = РеквизитДокумента.Uni;
			ЗначениеРеквизита = Неопределено;
			
			Если ЗначениеЗаполнено(ИмяПоля) Тогда
				
				Если Не СвойствоОбъекта(ДокументSMARTS, ИмяПоля, ЗначениеРеквизита) Тогда
						
					ИмяТранслит = КешТранслитерацииПолей.Получить(РеквизитДокумента.Значение);
					Если ИмяТранслит = Неопределено Тогда
						ИмяПоля = ГлЯдро_СтрокуВТранслитENG(РеквизитДокумента.Значение);	
						КешТранслитерацииПолей.Вставить(РеквизитДокумента.Значение, ИмяПоля);
					Иначе
						ИмяПоля = ИмяТранслит;
					КонецЕсли;
					
					Если Не СвойствоОбъекта(ДокументSMARTS, ИмяПоля, ЗначениеРеквизита) Тогда
						ЗначениеРеквизита = Неопределено;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ИмяРеквизитаШапки = ИменаРеквизитовШапки.Получить(РеквизитДокумента.Значение);
			Если ИмяРеквизитаШапки = Неопределено Тогда
				ИмяРеквизитаШапки = РеквизитДокумента.Значение;
			КонецЕсли;
			
			РеквизитыШапки.Вставить(ИмяРеквизитаШапки, ЗначениеРеквизита);
		Исключение
			Сообщение = НСтр("ru = 'Реквизит с именем [%1] отсутствует в шапке документа';
								|en = 'The details with the name [%1] are missing in the document header';
								|be = 'Рэквізіт з імем [%1] адсутнічае ў шапцы дакумента'; es = 'Los accesorios con el nombre [%1] no aparecen en el encabezado del documento'; ka = 'დეტალები სახელით [%1] აკლია დოკუმენტის სათაურში'; kk = '[%1] деп аталатын деректеме құжат қақпағында жоқ'; ro = 'Detaliile cu numele [%1] lipsesc în antetul documentului'; tr = 'Belgenin başlığında [%1] adlı aksesuarlar eksik'; uk = 'Реквізит з ім''ям [%1] відсутній в шапці документа'; uz = 'Hujjat sarlavhasida [%1] nomli rekvizit yo''q'");
			Сообщение = ГлЯдро_СтрШаблон(Сообщение, РеквизитДокумента.Значение);
			Сообщить(Сообщение); 
		КонецПопытки; 		
	КонецЦикла;
	
	Состояния = Неопределено;
	Если СвойствоОбъекта(ДокументSMARTS, "states", Состояния)
		И ТипЗнч(Состояния) = Тип("Массив")
		И Состояния.Количество() > 0 Тогда
		
		СтатусДокументаMS = Состояния[0];
		
		Для каждого Поле Из ГлЯдро_СтрРазделитьЧерезЗапятую("ВремяНачалаОбработки, ВремяИзменения, ВремяЗавершения") Цикл
			Если СвойствоОбъекта(СтатусДокументаMS, СоответствиеРеквизитов[Поле], ЗначениеРеквизита) Тогда
				РеквизитыШапки.Вставить(Поле, ЗначениеРеквизита);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ExtendedFields = Неопределено;
	Если СвойствоОбъекта(ДокументSMARTS, "extendedFields", ExtendedFields) Тогда
		
		Для каждого Поле Из ГлЯдро_СтрРазделитьЧерезЗапятую("ЕстьНедобор, ЕстьПереполнение, ЕстьПереполнениеИлиНедобор") Цикл
			Если СвойствоОбъекта(ExtendedFields, СоответствиеРеквизитов[Поле], ЗначениеРеквизита, Ложь) Тогда
				РеквизитыШапки.Вставить(Поле, ЗначениеРеквизита);	
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		РеквизитыШапки.Вставить("ЕстьНедобор",			 		Ложь);	
		РеквизитыШапки.Вставить("ЕстьПереполнение",				Ложь);
		РеквизитыШапки.Вставить("ЕстьПереполнениеИлиНедобор",	Ложь);
	КонецЕсли;
	
	КоличествоПлан = 0;
	Если Не СвойствоОбъекта(ДокументSMARTS, "declaredItems@odata.count", КоличествоПлан, 0) Тогда
		declaredItems = Неопределено;
		Если СвойствоОбъекта(ДокументSMARTS, "declaredItems", declaredItems) Тогда
			КоличествоПлан = declaredItems.Количество();
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыШапки.Вставить("СтрокиПланКоличество", КоличествоПлан);	
	
	КоличествоФакт = 0;
	Если Не СвойствоОбъекта(ДокументSMARTS, "currentItems@odata.count", КоличествоФакт, 0) Тогда
		currentItems = Неопределено;
		Если СвойствоОбъекта(ДокументSMARTS, "currentItems", currentItems) Тогда
			КоличествоПлан = currentItems.Количество();
		КонецЕсли;
	КонецЕсли;
	РеквизитыШапки.Вставить("СтрокиФактКоличество", КоличествоФакт);
	
	// дополнительные преобразования
	РеквизитыШапки.ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(РеквизитыШапки.ИмяТипаДокумента);
	
	Если Не РеквизитыШапки.Свойство("ДатаЗавершения") или РеквизитыШапки.ДатаЗавершения = '18991230' Тогда
		РеквизитыШапки.Вставить("ДатаЗавершения", Дата(1,1,1));
	КонецЕсли;
	
	Если Не РеквизитыШапки.Свойство("ИдИсходныхДокументов") Тогда
		РеквизитыШапки.Вставить("ИдИсходныхДокументов", "");
	КонецЕсли;
	
	Если Не РеквизитыШапки.Свойство("КонтрольКоличества") Тогда
		РеквизитыШапки.Вставить("КонтрольКоличества", Ложь);
	КонецЕсли;
		
	ГлЯдро_ПрочитатьДатуISOВСтруктуре(РеквизитыШапки, "ДатаСоздания, ДатаЗавершения, ВремяНачалаОбработки, ВремяИзменения, ВремяЗавершения");
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РеквизитыШапки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РеквизитыШапки;
	
КонецФункции

Функция СвойствоОбъекта(Объект, Свойство, Значение = Неопределено, ЗначениеПоУмолчанию = Неопределено)
	
	Перем ЕстьСвойство;
	
	Попытка		
		Значение = Объект[Свойство];
		ЕстьСвойство = Истина;
	Исключение
		Значение = ЗначениеПоУмолчанию;
		ЕстьСвойство = Ложь;
	КонецПопытки;
	
	Возврат ЕстьСвойство;
	
КонецФункции

Функция ЗначениеСвойства(Объект, Свойство, ЗначениеПоУмолчанию = Неопределено, ИмяТипа = Неопределено)
	
	Попытка		
		Если Объект = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;	
		ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
			Значение = Объект.Получить(Свойство);
		Иначе
			Значение = Объект[Свойство];
		КонецЕсли;
		
		Если ИмяТипа <> Неопределено
			И ТипЗнч(Значение) <> Тип(ИмяТипа) Тогда	
			Значение = ЗначениеПоУмолчанию;	
		КонецЕсли;
		
	Исключение
		Значение = ЗначениеПоУмолчанию;
	КонецПопытки;
	
	Возврат Значение;
	
КонецФункции 

Функция ГлЯдро_МетаданныеДокументаПоСтруктуреДокументаMS(ДокументSMARTS, АдресаПеременных)
	
	Перем МетаданныеДокументаMS;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Для каждого КЗ Из СтруктураМетаданных.ДокументыMS Цикл
		РеквизитИмяТипа = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(КЗ.Значение.Реквизиты, Новый Структура("Значение", "ИмяТипаДокумента"), Истина);
		UniИмяТипа = РеквизитИмяТипа.Uni;
		ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ДокументSMARTS[UniИмяТипа]);
		
		// Документ MS может не существовать в структуре метаданных
		Если НЕ СтруктураМетаданных.ДокументыMS.Свойство(ИмяТипаДокумента) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		МетаданныеДокументаMS = СтруктураМетаданных.ДокументыMS[ИмяТипаДокумента];
		Прервать;
	КонецЦикла;
	
	Возврат МетаданныеДокументаMS;
	
КонецФункции

Функция ГлЯдро_МетаданныеДокументаПоТипуДокумента(Знач ИмяТипаДокумента, АдресаПеременных)
	
	Перем МетаданныеДокументаMS;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ИмяТипаДокумента);
	МетаданныеДокументаMS = СтруктураМетаданных.ДокументыMS[ИмяТипаДокумента];
	
	Возврат МетаданныеДокументаMS;
	
КонецФункции

Функция ГлЯдро_ПолучитьСоответствиеРеквизитовUniДокументаMS(МетаданныеДокументаMS, РасположениеРеквизита = "ШапкаДокумента")
	
	Возврат ГлЯдро_ПолучитьСоответствиеРеквизитовMS(МетаданныеДокументаMS, РасположениеРеквизита, "Значение", "uni");
	
КонецФункции

Функция ГлЯдро_ПолучитьСоответствиеРеквизитовMS(МетаданныеДокументаMS, РасположениеРеквизита = "ШапкаДокумента", ЧтоСопоставлять = "Значение", ЧемуСопоствить = "")
	
	Если РасположениеРеквизита = "ШапкаДокумента" Тогда
		
		МассивРеквизитов = МетаданныеДокументаMS.Реквизиты;
		
	// дописать поиск реквизитов ТЧ
	КонецЕсли;

	СоответствиеРеквизитов = ГлЯдро_ПолучитьСоответствиеРеквизитовПоМассивуРеквизитовMS(МассивРеквизитов, ЧтоСопоставлять, ЧемуСопоствить);
	
	Возврат СоответствиеРеквизитов;
	
КонецФункции

Функция ГлЯдро_ПолучитьСоответствиеРеквизитовПоМассивуРеквизитовMS(МассивРеквизитов, ЧтоСопоставлять = "Значение", ЧемуСопоствить = "")
	
	СоответствиеРеквизитов = Новый Структура;
	
	Если ЧемуСопоствить = "" Тогда
		Для каждого СтруктураРеквизита Из МассивРеквизитов Цикл		 
			СоответствиеРеквизитов.Вставить(СтруктураРеквизита[ЧтоСопоставлять], СтруктураРеквизита);
		КонецЦикла;
	Иначе
		Для каждого СтруктураРеквизита Из МассивРеквизитов Цикл		 
			СоответствиеРеквизитов.Вставить(СтруктураРеквизита[ЧтоСопоставлять], СтруктураРеквизита[ЧемуСопоствить]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СоответствиеРеквизитов;
	
КонецФункции

Функция ГлЯдро_НайтиРеквизитВМетаданныхДокументаMS(МетаданныеДокументаMS, ВнутреннееИмяРеквизита, РасположениеРеквизита = "ШапкаДокумента")
	
	Перем МассивРеквизитов;
	
	Если РасположениеРеквизита = "ШапкаДокумента" Тогда
		
		МассивРеквизитов = МетаданныеДокументаMS.Реквизиты;
		
	// дописать поиск реквизитов ТЧ
	КонецЕсли;

	Реквизит = ГлЯдро_НайтиРеквизитВМассивеРеквизитовMS(МассивРеквизитов, ВнутреннееИмяРеквизита);
	
	Возврат Реквизит;
	
КонецФункции

Функция ГлЯдро_НайтиРеквизитВМассивеРеквизитовMS(МассивРеквизитов, ВнутреннееИмяРеквизита)
	
	Реквизит = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(МассивРеквизитов, Новый Структура("Значение", ВнутреннееИмяРеквизита), Истина);
	
	Возврат Реквизит;
	
КонецФункции

Процедура ГлЯдро_ПрочитатьДатуISOВСтруктуре(Структура, ПоляСтрокой)
	
	Поля = ГлЯдро_СтрРазделить(ПоляСтрокой, ",", Ложь);
	Для каждого Поле Из Поля Цикл
		Если Структура.Свойство(Поле) и ТипЗнч(Структура[Поле]) = Тип("Строка") Тогда
			Структура[Поле] = ГлЯдро_ПрочитатьДатуISO(Структура[Поле]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ГлЯдро_ПрочитатьДатуISO(ДатаISO)
	
	Попытка
		ДатаДата = ПрочитатьДатуJSON(ДатаISO, ФорматДатыJSON.ISO);
	Исключение
		ДатаДата = Неопределено;
	КонецПопытки;
	
	Возврат ДатаДата;
	
КонецФункции

Функция REST_API_ПолучитьДанныеДокументаНаСервереSMARTS(ID_Документа, СтруктураДокументаMS, ТипБазы, ФильтрТЧПоИдДокумента = Неопределено, ЗапрашиватьCombinedItems = Истина, АдресаПеременных)
		
	ИмяСобытия = "REST_API_ПолучитьДанныеДокументаНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,СтруктураДокументаMS,ТипБазы,ФильтрТЧПоИдДокумента,ЗапрашиватьCombinedItems",
		ID_Документа, СтруктураДокументаMS, ТипБазы, ФильтрТЧПоИдДокумента, ЗапрашиватьCombinedItems);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);

	Если ЗапрашиватьCombinedItems Тогда
		СтрокаExpand = "expand=declaredItems,currentItems,combinedItems,extendedFields,tables($expand=rows)";
	Иначе
		СтрокаExpand = "expand=declaredItems,currentItems,extendedFields,tables($expand=rows)";
	КонецЕсли;
	
	UniДокумента = СтруктураДокументаMS.uni;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод",		  "GET");
	СтруктураЗапроса.Вставить("Метод",			  "Docs/" + UniДокумента + "('" + ID_Документа + "')?$" + СтрокаExpand);
	СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
	СтруктураЗапроса.Вставить("ТипЗапроса", 	  "ПолучениеПолногоДокумента");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния)
		ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера") Тогда
		
		// <Лог>
		пСообщение = REST_API_ТекстСообщенияНекорректныйHTTPОтвет(СтруктураЗапроса, СтруктураОтвета);
		ЯзСтрока = "ru = 'Некорректный HTTP-ответ при получении документа Клеверенс, ID = %1'";
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ID_Документа,HTTPМетод,URL,КодСостояния,ТекстОшибки",
			ID_Документа, СтруктураЗапроса.HTTPМетод, СтруктураЗапроса.Метод,
			СтруктураОтвета.КодСостояния, СтруктураОтвета.ТекстОшибки);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументSMARTS = СтруктураОтвета.ОтветСервера;
	
	ДанныеДокументаMS = Новый Структура;
	
	КешТранслитерацииПолей = Новый Соответствие;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	// Шапка
	РеквизитыШапки = REST_API_ПолучитьДанныеШапкиДокументаMS(ДокументSMARTS, СтруктураДокументаMS, АдресаПеременных);
	ДанныеДокументаMS.Вставить("ШапкаДокумента", РеквизитыШапки);
	
	// Подготовка табличных частей
	ТабличнаяЧастьФакт = Новый ТаблицаЗначений;МассивКолонокФакт = Новый Массив;
	ТабличнаяЧастьПлан = Новый ТаблицаЗначений;МассивКолонокПлан = Новый Массив;
	ТабличнаяЧастьСовмещенные = Новый ТаблицаЗначений;МассивКолонокСовмещенные = Новый Массив;
	Для Каждого РеквизитТЧ Из СтруктураДокументаMS.РеквизитыТЧ Цикл
		Если НЕ ТабличнаяЧастьФакт.Колонки.Найти(РеквизитТЧ.Значение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличнаяЧастьФакт.Колонки.Добавить(РеквизитТЧ.Значение);
		ТабличнаяЧастьПлан.Колонки.Добавить(РеквизитТЧ.Значение);
		ТабличнаяЧастьСовмещенные.Колонки.Добавить(РеквизитТЧ.Значение);
		
		МассивКолонокФакт.Добавить(РеквизитТЧ);
		МассивКолонокПлан.Добавить(РеквизитТЧ);
		МассивКолонокСовмещенные.Добавить(РеквизитТЧ);
	КонецЦикла;
	
	Для Каждого РеквизитСерии Из СтруктураДокументаMS.РеквизитыСерии Цикл
		// данное поле будет добавлено при заполнении вычислимых полей
		Если Найти(ВРег(СокрЛП("Характеристика")), ВРег(СокрЛП(РеквизитСерии.Значение)))
			ИЛИ Найти(ВРег(СокрЛП("Attribute")), ВРег(СокрЛП(РеквизитСерии.Значение))) Тогда
			Продолжить;
		КонецЕсли;	
		Если ТабличнаяЧастьФакт.Колонки.Найти(РеквизитСерии.Значение) = Неопределено Тогда
			ТабличнаяЧастьФакт.Колонки.Добавить(РеквизитСерии.Значение);
			МассивКолонокФакт.Добавить(РеквизитСерии);
		КонецЕсли;	
		Если ТабличнаяЧастьПлан.Колонки.Найти(РеквизитСерии.Значение) = Неопределено Тогда
			ТабличнаяЧастьПлан.Колонки.Добавить(РеквизитСерии.Значение);
			МассивКолонокПлан.Добавить(РеквизитСерии);
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого РеквизитСерийныеНомера Из СтруктураДокументаMS.РеквизитыСерийныеНомера Цикл
		// данное поле будет добавлено при заполнении вычислимых полей
		Если Найти(ВРег(СокрЛП("Характеристика")), ВРег(СокрЛП(РеквизитСерийныеНомера.Значение)))
			ИЛИ Найти(ВРег(СокрЛП("Attribute")), ВРег(СокрЛП(РеквизитСерийныеНомера.Значение))) Тогда
			Продолжить;
		КонецЕсли;	
		Если ТабличнаяЧастьФакт.Колонки.Найти(РеквизитСерийныеНомера.Значение) = Неопределено Тогда
			ТабличнаяЧастьФакт.Колонки.Добавить(РеквизитСерийныеНомера.Значение);
			МассивКолонокФакт.Добавить(РеквизитСерийныеНомера);
		КонецЕсли;
		Если ТабличнаяЧастьПлан.Колонки.Найти(РеквизитСерийныеНомера.Значение) = Неопределено Тогда
			ТабличнаяЧастьПлан.Колонки.Добавить(РеквизитСерийныеНомера.Значение);
			МассивКолонокПлан.Добавить(РеквизитСерийныеНомера);
		КонецЕсли;	
	КонецЦикла;
	
	// Временное решение
    Если ЯзыкПлатформыMS = "EN" Тогда
		РеквизитыНаДвухЯзыках = Новый Массив;
		РеквизитыНаДвухЯзыках.Добавить(Новый Структура("Значение, Ключ, Uni", "AttributeId", "AttributeId", "attributeId"));
	
		Для Каждого РеквизитДополнительно Из РеквизитыНаДвухЯзыках Цикл
			Если ТабличнаяЧастьФакт.Колонки.Найти(РеквизитДополнительно.Значение) = Неопределено Тогда
				ТабличнаяЧастьФакт.Колонки.Добавить(РеквизитДополнительно.Значение);
				МассивКолонокФакт.Добавить(РеквизитДополнительно);
			КонецЕсли;	
			Если ТабличнаяЧастьПлан.Колонки.Найти(РеквизитДополнительно.Значение) = Неопределено Тогда
				ТабличнаяЧастьПлан.Колонки.Добавить(РеквизитДополнительно.Значение);
				МассивКолонокПлан.Добавить(РеквизитДополнительно);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") И СтруктураМетаданных.Свойство("UniПолейНоменклатуры") Тогда 
		UniПолейНоменклатуры = СтруктураМетаданных.UniПолейНоменклатуры;
	Иначе
		UniПолейНоменклатуры = Новый Соответствие();
	КонецЕсли;
	
	СоответствиеИменПолейDeclaredItems = Новый Соответствие;
	СоответствиеИменПолейCurrentItems  = Новый Соответствие;
	СоответствиеИменПолейCombinedItems = Новый Соответствие;
	
	СтруктураПлан = Новый Структура;
	СтруктураПлан.Вставить("ИмяТабличнойЧастиMS", 	"declaredItems");
	СтруктураПлан.Вставить("ИмяТабличнойЧасти1С", 	"СтрокиПлан");
	СтруктураПлан.Вставить("ЗаполняемаяТаблица", 	ТабличнаяЧастьПлан);
	СтруктураПлан.Вставить("МассивКолонок", 		МассивКолонокПлан);
	СтруктураПлан.Вставить("СоответствиеИменПолей", СоответствиеИменПолейDeclaredItems);
	
	СтруктураФакт = Новый Структура;
	СтруктураФакт.Вставить("ИмяТабличнойЧастиMS", 	"currentItems");
	СтруктураФакт.Вставить("ИмяТабличнойЧасти1С", 	"СтрокиФакт");
	СтруктураФакт.Вставить("ЗаполняемаяТаблица", 	ТабличнаяЧастьФакт);
	СтруктураФакт.Вставить("МассивКолонок", 		МассивКолонокФакт);
	СтруктураФакт.Вставить("СоответствиеИменПолей", СоответствиеИменПолейCurrentItems);
	
	СтруктураСовмещенные = Новый Структура;
	СтруктураСовмещенные.Вставить("ИмяТабличнойЧастиMS", 	"combinedItems");
	СтруктураСовмещенные.Вставить("ИмяТабличнойЧасти1С", 	"СовмещенныеСтроки");
	СтруктураСовмещенные.Вставить("ЗаполняемаяТаблица", 	ТабличнаяЧастьСовмещенные);
	СтруктураСовмещенные.Вставить("МассивКолонок", 			МассивКолонокСовмещенные);
	СтруктураСовмещенные.Вставить("СоответствиеИменПолей",	СоответствиеИменПолейCombinedItems);
	
	МассивТабличныхЧастей = Новый Массив;
	МассивТабличныхЧастей.Добавить(СтруктураПлан);
	МассивТабличныхЧастей.Добавить(СтруктураФакт);
	МассивТабличныхЧастей.Добавить(СтруктураСовмещенные);
	
	Для каждого ТабличнаяЧасть ИЗ МассивТабличныхЧастей Цикл
		ИмяТабличнойЧастиMS   = ТабличнаяЧасть.ИмяТабличнойЧастиMS;
		ИмяТабличнойЧасти1С   = ТабличнаяЧасть.ИмяТабличнойЧасти1С;
		ЗаполняемаяТаблица	  = ТабличнаяЧасть.ЗаполняемаяТаблица;
		МассивКолонок		  = ТабличнаяЧасть.МассивКолонок;
		СоответствиеИменПолей = ТабличнаяЧасть.СоответствиеИменПолей;
		
		Если ДокументSMARTS.Свойство(ИмяТабличнойЧастиMS) И ТипЗнч(ДокументSMARTS[ИмяТабличнойЧастиMS]) = Тип("Массив") Тогда
			ДобавленныеКолонки = Новый Соответствие;
			
			Для Каждого СтрокаТЧ ИЗ ДокументSMARTS[ИмяТабличнойЧастиMS] Цикл
				
				// Фильтр ТЧ, если она была объединена из нескольких документов
				Если ЗначениеЗаполнено(ФильтрТЧПоИдДокумента) Тогда
					Если ИмяТабличнойЧастиMS = "declaredItems" ИЛИ ИмяТабличнойЧастиMS = "combinedItems" Тогда
						Если СтрокаТЧ.Свойство("idDokumenta") Тогда                           
							ИдДокументаВладелецСтроки = СтрокаТЧ["idDokumenta"];
							Если ИдДокументаВладелецСтроки <> ФильтрТЧПоИдДокумента Тогда
								Продолжить;
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ИмяТабличнойЧастиMS = "currentItems" Тогда
						Если СтрокаТЧ.Свойство("bindedLineUid") И ЗначениеЗаполнено(СтрокаТЧ.bindedLineUid) Тогда
							СвязаннаяСтрока = ГлЯдро_НайтиПоЗначениюВМассивеСтруктур(ДокументSMARTS["declaredItems"], "uid", СтрокаТЧ.bindedLineUid);
							Если СвязаннаяСтрока <> Неопределено И СвязаннаяСтрока.Свойство("idDokumenta") Тогда 
								СтрокаТЧ.Вставить("idDokumenta", СвязаннаяСтрока.IdDokumenta);
							КонецЕсли;
						КонецЕсли;
						ИдДокументаВладелецСтроки = "";
						Если СтрокаТЧ.Свойство("idDokumenta") Тогда                           
							ИдДокументаВладелецСтроки = СтрокаТЧ["idDokumenta"];
						КонецЕсли;
						Если ИдДокументаВладелецСтроки <> ФильтрТЧПоИдДокумента
							И НЕ (ID_Документа = ФильтрТЧПоИдДокумента И ИдДокументаВладелецСтроки = "") // Это условие нужно для загрузки всех строк, которых не было по плану, в первый документ
							Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ОбработанныеПоляMS = Новый Структура;
				
				НоваяСтрока = ЗаполняемаяТаблица.Добавить();
				Для Каждого РеквизитТЧ ИЗ МассивКолонок Цикл
					Попытка
						ИмяПоля = СоответствиеИменПолей.Получить(РеквизитТЧ.Uni);
						Если ИмяПоля = Неопределено Тогда
							ИмяПоля = РеквизитТЧ.Uni;
							Если ЗначениеЗаполнено(ИмяПоля) И СтрокаТЧ.Свойство(ИмяПоля) Тогда
								ЗначениеРеквизита = СтрокаТЧ[ИмяПоля];
								Если ИмяПоля = "bindedLineUid" И ИмяТабличнойЧастиMS = "currentItems" Тогда
									СвязаннаяСтрока = ГлЯдро_НайтиПоЗначениюВМассивеСтруктур(ДокументSMARTS["declaredItems"], "uid", СтрокаТЧ[ИмяПоля]);
									Если СвязаннаяСтрока <> Неопределено Тогда
								 		// +++ Преобразуем имена полей связанной строки
										Если СвязаннаяСтрока.Количество() > 0 Тогда
											Для Каждого РеквизитТЧПлан ИЗ МассивКолонокПлан Цикл
												Попытка
													ИмяПоляСС = СоответствиеИменПолейDeclaredItems.Получить(РеквизитТЧПлан.Uni);
													Если ИмяПоляСС = Неопределено Тогда
														ИмяПоляСС = РеквизитТЧПлан.Uni;
														Если ЗначениеЗаполнено(ИмяПоляСС) И СвязаннаяСтрока.Свойство(ИмяПоляСС) Тогда
															ЗначениеРеквизитаСвязаннойСтроки = СвязаннаяСтрока[ИмяПоляСС];
															СоответствиеИменПолейDeclaredItems.Вставить(РеквизитТЧПлан.Uni, ИмяПоляСС);	
														Иначе	
															ИмяТранслит = КешТранслитерацииПолей.Получить(РеквизитТЧПлан.Значение);
															Если ИмяТранслит = Неопределено Тогда
																ИмяПоляСС = ГлЯдро_СтрокуВТранслитENG(РеквизитТЧПлан.Значение);
																КешТранслитерацииПолей.Вставить(РеквизитТЧПлан.Значение,ИмяПоляСС);
															Иначе
																ИмяПоляСС = ИмяТранслит;
															КонецЕсли;
															Если ЗначениеЗаполнено(ИмяПоляСС) И СвязаннаяСтрока.Свойство(ИмяПоляСС) Тогда
																ЗначениеРеквизитаСвязаннойСтроки = СвязаннаяСтрока[ИмяПоляСС];
																СоответствиеИменПолейDeclaredItems.Вставить(РеквизитТЧПлан.Uni, ИмяПоляСС);	
															Иначе
																ИмяПоляСС = UniПолейНоменклатуры.Получить(РеквизитТЧПлан.Значение);
																Если ЗначениеЗаполнено(ИмяПоляСС) И СвязаннаяСтрока.Свойство(ИмяПоляСС) Тогда
																	ЗначениеРеквизитаСвязаннойСтроки = СвязаннаяСтрока[ИмяПоляСС];
																	СоответствиеИменПолейDeclaredItems.Вставить(РеквизитТЧПлан.Uni, ИмяПоляСС);	
																Иначе
																	ЗначениеРеквизитаСвязаннойСтроки = Неопределено;
																КонецЕсли;
															КонецЕсли;
														КонецЕсли;
													ИначеЕсли СвязаннаяСтрока.Свойство(ИмяПоляСС) Тогда
														ЗначениеРеквизитаСвязаннойСтроки = СвязаннаяСтрока[ИмяПоляСС];
													Иначе
														ЗначениеРеквизитаСвязаннойСтроки = Неопределено;	
													КонецЕсли;
													СвязаннаяСтрока.Вставить(РеквизитТЧПлан.Значение, ЗначениеРеквизитаСвязаннойСтроки);
												Исключение
													
												КонецПопытки;	
											КонецЦикла;											
										КонецЕсли;
										ЗначениеРеквизита = СвязаннаяСтрока;
										// ---
									КонецЕсли;
								Иначе
									СоответствиеИменПолей.Вставить(РеквизитТЧ.Uni, ИмяПоля);
								КонецЕсли;
							Иначе
								ИмяТранслит = КешТранслитерацииПолей.Получить(РеквизитТЧ.Значение);
								Если ИмяТранслит = Неопределено Тогда
									ИмяПоля = ГлЯдро_СтрокуВТранслитENG(РеквизитТЧ.Значение);	
									КешТранслитерацииПолей.Вставить(РеквизитТЧ.Значение, ИмяПоля);
								Иначе
									ИмяПоля = ИмяТранслит;
								КонецЕсли;
								Если ЗначениеЗаполнено(ИмяПоля) И СтрокаТЧ.Свойство(ИмяПоля) Тогда
									ЗначениеРеквизита = СтрокаТЧ[ИмяПоля];
									СоответствиеИменПолей.Вставить(РеквизитТЧ.Uni, ИмяПоля);
								Иначе
									ИмяПоля = UniПолейНоменклатуры.Получить(РеквизитТЧ.Значение);
									Если ЗначениеЗаполнено(ИмяПоля) И СтрокаТЧ.Свойство(ИмяПоля) Тогда
										ЗначениеРеквизита = СтрокаТЧ[ИмяПоля];
										СоответствиеИменПолей.Вставить(РеквизитТЧ.Uni, ИмяПоля);
									Иначе
										ЗначениеРеквизита = Неопределено;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						ИначеЕсли СтрокаТЧ.Свойство(ИмяПоля) Тогда
							ЗначениеРеквизита = СтрокаТЧ[ИмяПоля];
						Иначе
							ЗначениеРеквизита = Неопределено;
						КонецЕсли;
						
						Если НЕ ИмяПоля = Неопределено Тогда
							ОбработанныеПоляMS.Вставить(ИмяПоля, Истина);
						КонецЕсли;
						
						НоваяСтрока[РеквизитТЧ.Значение] = ЗначениеРеквизита;
					Исключение
						Сообщение = НСтр("ru = 'Реквизит с именем [%1] отсутствует в табличной части [%2]';
											|en = 'The details with the name [%1] are missing from the table part [%2]';
											|be = 'Рэквізіт з імем [%1] адсутнічае ў таблічнай часткі [%2]'; es = 'Los accesorios con el nombre [%1] no están presentes en la parte de tabla [%2]'; ka = 'დეტალები სახელით [%1] აკლია ცხრილის ნაწილში [%2]'; kk = '[%1] деп аталатын реквизиттер [%2]кестелік бөлігінде жоқ'; ro = 'Detaliile cu numele [%1] lipsesc din partea tabelului [%2]'; tr = 'Tablo kısmında [%1] adlı aksesuarlar eksik [%2]'; uk = 'Реквізит з іменем [%1] відсутній у табличній частині [%2]'; uz = '[%1] nomli rekvizitlar jadval qismida mavjud emas [%2]'");
						Сообщение = ГлЯдро_СтрШаблон(Сообщение, РеквизитТЧ.Значение, ИмяТабличнойЧасти1С);
						Сообщить(Сообщение); 
					КонецПопытки; 			
				КонецЦикла;
				
				// Проверка полей, не входящих в структуру метаданных документа MS
				Для каждого ПолеДокумента ИЗ СтрокаТЧ Цикл
					Если НЕ ОбработанныеПоляMS.Свойство(ПолеДокумента.Ключ)
						И ЗначениеЗаполнено(ПолеДокумента.Значение) Тогда
						Если ДобавленныеКолонки.Получить(ПолеДокумента.Ключ) = Неопределено
							И ЗаполняемаяТаблица.Колонки.Найти(ПолеДокумента.Ключ) = Неопределено Тогда
							ЗаполняемаяТаблица.Колонки.Добавить(ПолеДокумента.Ключ);
							ДобавленныеКолонки.Вставить(ПолеДокумента.Ключ, Истина);
						КонецЕсли;
						
						НоваяСтрока[ПолеДокумента.Ключ] = ПолеДокумента.Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		ДанныеДокументаMS.Вставить(ИмяТабличнойЧасти1С, ЗаполняемаяТаблица);
	КонецЦикла;
	
	СписокИменаДополнительныхТабличныхЧастей = Новый СписокЗначений;
	
	// Получение данных из доп.таблиц документа типа "ОплатыВозвраты", "Деньги" и т.д.
	Для каждого ДопТаблица Из СтруктураДокументаMS.ДополнительныеТаблицы Цикл		
		
		ИмяДопТаблицы			= ДопТаблица.Представление;
		СписокКолонокДопТаблицы = ДопТаблица.Значение;		
		ДопТабличнаяЧасть		= Новый Массив;
		СписокПолей 			= "";
		
		СписокИменаДополнительныхТабличныхЧастей.Добавить(ИмяДопТаблицы);
		
		Для Каждого Колонка из СписокКолонокДопТаблицы Цикл
			СписокПолей = СписокПолей + Колонка.Значение + ",";
		КонецЦикла;
		
		Попытка
			СтрокиДокументаMS = ДокументSMARTS.ПолучитьПоле(ИмяДопТаблицы).Rows;
		Исключение
			СтрокиДокументаMS = Новый Массив;
		
			ДопТаблицы = ДокументSMARTS["tables"];
			Для каждого ДополнительнаяТаблица ИЗ ДопТаблицы Цикл
				Если ДополнительнаяТаблица["name"] = ИмяДопТаблицы Тогда
					СтрокиДокументаMS = ДополнительнаяТаблица["rows"];
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецПопытки;
		
		Для Индекс = 0 по СтрокиДокументаMS.Количество() - 1 Цикл
			
			Попытка
				ТекущаяСтрокаMS	= СтрокиДокументаMS.Элемент(Индекс);
			Исключение
				ТекущаяСтрокаMS = СтрокиДокументаMS[Индекс];
			КонецПопытки;
			НоваяСтрока 	= Новый Структура;
			
			Для Каждого Колонка из СписокКолонокДопТаблицы Цикл
								
				Попытка
					
					ИмяПоля = Колонка.Uni;
					
					Если ЗначениеЗаполнено(ИмяПоля) И ТекущаяСтрокаMS.Свойство(ИмяПоля) Тогда
						ЗначениеРеквизита = ТекущаяСтрокаMS[ИмяПоля];
					Иначе
						ИмяТранслит = КешТранслитерацииПолей.Получить(Колонка.Значение);
						Если ИмяТранслит = Неопределено Тогда
							ИмяПоля = ГлЯдро_СтрокуВТранслитENG(Колонка.Значение);	
							КешТранслитерацииПолей.Вставить(Колонка.Значение,ИмяПоля);
						Иначе
							ИмяПоля = ИмяТранслит;
						КонецЕсли;
						Если ЗначениеЗаполнено(ИмяПоля) И ТекущаяСтрокаMS.Свойство(ИмяПоля) Тогда
							ЗначениеРеквизита = ТекущаяСтрокаMS[ИмяПоля];
						Иначе
							ИмяПоля = UniПолейНоменклатуры.Получить(Колонка.Значение);
							ЗначениеРеквизита = ?(ЗначениеЗаполнено(ИмяПоля) И ТекущаяСтрокаMS.Свойство(ИмяПоля), ТекущаяСтрокаMS[ИмяПоля], Неопределено);
						КонецЕсли;
					КонецЕсли;
					
					НоваяСтрока.Вставить(Колонка.Значение, ЗначениеРеквизита);
										
				Исключение	
						
				КонецПопытки;
				
			КонецЦикла;
						
			ДопТабличнаяЧасть.Добавить(НоваяСтрока);
			
		КонецЦикла;
		
		СписокПолей = Лев(СписокПолей, СтрДлина(СписокПолей) - 1);
		
		ДопТабличнаяЧасть.Вставить(0, Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, СписокПолей));
		
		ДанныеДокументаMS.Вставить(ИмяДопТаблицы, ДопТабличнаяЧасть);	
		
	КонецЦикла;	
	
	// Получение данных доп.таблиц, которые не определены в метаданных документа, но существуют у самого экземпляра документа
	Если ДокументSMARTS.Свойство("tables") И ТипЗнч(ДокументSMARTS["tables"]) = Тип("Массив") Тогда
		Для Каждого ДопТаблицаMS из ДокументSMARTS["tables"] Цикл
			
			Если СписокИменаДополнительныхТабличныхЧастей.НайтиПоЗначению(ДопТаблицаMS["name"]) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ДопТаблицаMS.Свойство("rows") Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокиДопТаблицыMS = ДопТаблицаMS["rows"];
			
			Если СтрокиДопТаблицыMS.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДопТабличнаяЧасть 	= Новый Массив;		
			СписокПолей 		= "";								        

			РеквизитыДопТаблицыMS = Неопределено;
			
			Если ДопТаблицаMS.name = "Series" Тогда
				ИмяТаблицы = "Серии";
			Иначе
				ИмяТаблицы = ДопТаблицаMS.name;
			КонецЕсли;
			
			//Если есть структура реквизита доп таблицы, то используем ее
			Если СтруктураДокументаMS.Свойство("Реквизиты" + ИмяТаблицы, РеквизитыДопТаблицыMS) Тогда
				
				Для Каждого Колонка из РеквизитыДопТаблицыMS Цикл
					СписокПолей = СписокПолей + Колонка.Значение + ",";
				КонецЦикла; 
				
				Для Индекс = 0 по СтрокиДопТаблицыMS.Количество() - 1 Цикл
					
					Попытка
						ТекущаяСтрокаMS	= СтрокиДопТаблицыMS.Элемент(Индекс);
					Исключение
						ТекущаяСтрокаMS = СтрокиДопТаблицыMS[Индекс];
					КонецПопытки;
					
					НоваяСтрока = Новый Структура;						
					
					Для Каждого Колонка из РеквизитыДопТаблицыMS Цикл
						
						Попытка
							
							ИмяПоля = Колонка.Uni;
							
							Если ЗначениеЗаполнено(ИмяПоля) И ТекущаяСтрокаMS.Свойство(ИмяПоля) Тогда
								ЗначениеРеквизита = ТекущаяСтрокаMS[ИмяПоля];
							Иначе
								ИмяПоля = ГлЯдро_СтрокуВТранслитENG(РеквизитТЧ.Значение);
								Если ЗначениеЗаполнено(ИмяПоля) И СтрокаТЧ.Свойство(ИмяПоля) Тогда
									ЗначениеРеквизита = СтрокаТЧ[ИмяПоля];
								Иначе
									ИмяПоля = UniПолейНоменклатуры.Получить(РеквизитТЧ.Значение);
									ЗначениеРеквизита = ?(ЗначениеЗаполнено(ИмяПоля) И СтрокаТЧ.Свойство(ИмяПоля), СтрокаТЧ[ИмяПоля], Неопределено);
								КонецЕсли;
							КонецЕсли;
							
							НоваяСтрока.Вставить(Колонка.Значение, ЗначениеРеквизита);
							
						Исключение	
							
						КонецПопытки;
						
					КонецЦикла;
					
					ДопТабличнаяЧасть.Добавить(НоваяСтрока);
					
				КонецЦикла;
				
			Иначе //Если нет структуры доп таблицы, то записываем данные как есть
				
				Для Каждого ТекущаяСтрокаMS Из СтрокиДопТаблицыMS Цикл
					
					НоваяСтрока = Новый Структура;
					
					Для Каждого КлючЗначение из ТекущаяСтрокаMS Цикл
						
						НоваяСтрока.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
						
					КонецЦикла;
					
					ДопТабличнаяЧасть.Добавить(НоваяСтрока);
					
				КонецЦикла; 

			КонецЕсли; 
  
			СписокПолей = Лев(СписокПолей, СтрДлина(СписокПолей) - 1);
			
			ДопТабличнаяЧасть.Вставить(0, Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, СписокПолей));		
			
			ДанныеДокументаMS.Вставить(ИмяТаблицы, ДопТабличнаяЧасть);
			
		КонецЦикла;		
	КонецЕсли;
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеДокументаMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ДанныеДокументаMS;
	
КонецФункции

Функция REST_API_ПреобразоватьТелоВMultipart(МассивСтруктурКПреобразовнаию)
	
	Разделитель = "---" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	
	Тело = Новый ПотокВПамяти();
	ЗаписьДанных = Новый ЗаписьДанных(Тело,,, Символы.ВК + Символы.ПС, "");
	
	ШаблонШапкиФайла = "Content-Disposition: form-data; name=""%1""; filename=""%2""";
	
	Для каждого ПараметрыЗначения Из МассивСтруктурКПреобразовнаию Цикл
		
		ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
		
		Заголовок = "Content-Disposition: form-data; name=""" + ПараметрыЗначения.КлючЗначения;
		Если ТипЗнч(ПараметрыЗначения.ЗначениеДанных) = Тип("ДвоичныеДанные") Тогда	
			Заголовок = Заголовок + """; filename=""" + ПараметрыЗначения.ИмяФайла + """";
			ЗаписьДанных.ЗаписатьСтроку(Заголовок); 
			ЗаписьДанных.ЗаписатьСтроку("Content-Type: " + ПараметрыЗначения.ТипЗначения);
		Иначе	
			ЗаписьДанных.ЗаписатьСтроку(Заголовок); 
		КонецЕсли;
		
		ЗаписьДанных.ЗаписатьСтроку("");
		ЗаписьДанных.Записать(ПараметрыЗначения.ЗначениеДанных);
		
	КонецЦикла;
	
	ЗаписьДанных.ЗаписатьСтроку(""); 
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--"); 
	ЗаписьДанных.ЗаписатьСтроку(""); 
	ЗаписьДанных.Закрыть(); 
	
	ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
	Результат = Новый Структура("Разделитель, ДвоичныеДанные, Размер", Разделитель, ДанныеТела, XMLСтрока(ДанныеТела.Размер()));
	
	Возврат Результат;
	
КонецФункции

Функция REST_API_КодСостоянияУспешно(КодСостояния)

	КодСостоянияУспешно = НЕ КодСостояния = Неопределено
		И КодСостояния >= 200
		И КодСостояния < 300;

	Возврат КодСостоянияУспешно;
	
КонецФункции

Функция REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса = Неопределено)
	
	Результат = Неопределено;
	
	ЭтоXML 		 = ТипЗнч(mXmlDoc) = Тип("Строка") И Лев(mXmlDoc, 5) = "<?xml";
	ЭтоНеRESTAPI = ТипИнтерфейса <> Неопределено И ТипИнтерфейса <> "REST_API";
	ЕстьДанные 	 = mXmlDoc <> Неопределено И mXmlDoc <> "AutoSerialization";
	
	Если НЕ ЭтоXML И НЕ ЭтоНеRESTAPI И ЕстьДанные Тогда
	
		Попытка
			Результат = ГлЯдро_ЗагрузитьИзJSON(mXmlDoc);
		Исключение
		КонецПопытки;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Логирование

// Открывает поток логирования. Поток является корневым элементом иерархии логов.
// Вложенные потоки запрещены, кроме фоновых заданий, для которых создаётся
// дочерний поток с привязкой к родительскому.
//
// Параметры:
//  ИмяПотока        - Строка - идентификатор потока, отображаемый в логах.
//  Модуль           - Произвольный - источник вызова. Если не указан, используется ЭтотОбъект.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура - открытый поток (Ид, ИдРодителя, Имя, ВремяНачала, Модуль).
//  Неопределено - логирование отключено или поток уже открыт.
//
Функция ЛогОткрытьПоток(ИмяПотока, Модуль = Неопределено, АдресаПеременных) Экспорт
	
	Если НЕ Логирование_ИспользоватьЛогирование(АдресаПеременных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Логирование_ПотокОткрыт(АдресаПеременных) Тогда
		// Запрещаем открытие второго/вложенного потока
		// Вложенность потоков доступна только для ФЗ
		Возврат Неопределено;
	КонецЕсли;
	
	Если Модуль = Неопределено Тогда
		ИмяМодуля = Строка(ЭтотОбъект);
	Иначе
		ИмяМодуля = Строка(Модуль);
	КонецЕсли;
	
	Попытка
		
		ЭтоФоновоеЗадание = АдресаПеременных.Свойство("ЭтоФоновоеЗадание") И АдресаПеременных.ЭтоФоновоеЗадание = Истина;
		
		ИдПотока 			= Строка(Новый УникальныйИдентификатор);
		ПотокИдРодителя 	= Неопределено;
		СобытиеИдРодителя 	= Неопределено;
		КонтекстСеанса 		= Логирование_ПолучитьКонтекстСеанса();
		
		// В ФЗ получаем поток родителя, если есть.
		// ФЗ запускаются в отдельном сеансе и мы не сможем использовать родительский поток,
		// 	т.к он может закрыться раньше, поэтому создаем отдельный поток с привязкой к родительской.
		Если ЭтоФоновоеЗадание Тогда
			
			ЛогПотокРодитель = Логирование_ПолучитьПоток(АдресаПеременных, Истина);
			
			Если ЛогПотокРодитель <> Неопределено Тогда
				ПотокИдРодителя = ЛогПотокРодитель.Ид;
			КонецЕсли;
			
			ИдПотока = КонтекстСеанса.ФоновоеЗадание.УникальныйИдентификатор;
			
		КонецЕсли;
		
		Поток = Новый Структура;
		Поток.Вставить("Ид", 					ИдПотока);
		Поток.Вставить("ИдРодителя", 			ПотокИдРодителя);
		Поток.Вставить("Имя", 					ИмяПотока);
		Поток.Вставить("ВремяНачала", 			ТекущаяУниверсальнаяДатаВМиллисекундах());
		Поток.Вставить("Модуль", 				ИмяМодуля);
		Поток.Вставить("КонтекстСеансаСервер", 	КонтекстСеанса);
		Поток.Вставить("КонтекстСеансаКлиент");
		
		Если ЭтоФоновоеЗадание Тогда
			Логирование_СохранитьПеременную("ЛогПотокФЗ", Поток, АдресаПеременных);
			
			// Привяжем первое событие ФЗ к событию запуска ФЗ из клиента
			СобытиеИдРодителя = Логирование_ПолучитьПоследнееСобытиеСтека(АдресаПеременных);
			
			ЛогСтекСобытий = Новый Массив;
			Если СобытиеИдРодителя <> Неопределено Тогда
				ЛогСтекСобытий.Добавить(СобытиеИдРодителя);
			КонецЕсли;
			
			Логирование_СохранитьПеременную("ЛогСтекСобытий", ЛогСтекСобытий, АдресаПеременных);
		Иначе
			Логирование_СохранитьПеременную("ЛогПоток", Поток, АдресаПеременных);
			Логирование_СохранитьПеременную("ЛогСтекСобытий", Новый Массив, АдресаПеременных);
		КонецЕсли;
		
		КэшЛогРежимОтладкиES = Неопределено;
		КэшЛогОжидаетПервоеСобытие = Истина;
		
		Логирование_СохранитьПеременную("ЛогБуферЗаписейСервер", Новый Массив, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогБылиОшибки", Ложь, АдресаПеременных);
		
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "flow_started";
		ЗаписьЛога.ИдРодителя 	= СобытиеИдРодителя;
		ЗаписьЛога.ИдСобытия 	= ИдПотока;
		ЗаписьЛога.Модуль 		= Поток.Модуль;
		ЗаписьЛога.Длительность = Неопределено;
		ЗаписьЛога.Уровень 		= "Информация";
		ЗаписьЛога.Сообщение 	= ИмяПотока;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных);
		
		КэшЛогПотокОткрыт = Истина;
		
		Возврат Поток;
		
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогОткрытьПоток", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Закрывает поток логирования и выполняет flush буфера записей в хранилище.
// Сбрасывает состояние потока и очищает буфер и стек событий.
//
// Параметры:
//  логПоток         - Структура - поток, полученный из ЛогОткрытьПоток.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогЗакрытьПоток(логПоток, АдресаПеременных) Экспорт
	
	// Защита от закрытия чужого потока
	Если логПоток = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поток = Логирование_ПолучитьПоток(АдресаПеременных);
	Если Поток = Неопределено
		ИЛИ логПоток.Ид <> Поток.Ид Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
				
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "flow_finished";
		ЗаписьЛога.ИдРодителя 	= Поток.ИдРодителя;
		ЗаписьЛога.ИдСобытия 	= Поток.Ид;
		ЗаписьЛога.Модуль 		= Поток.Модуль;
		ЗаписьЛога.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() -Поток.ВремяНачала;
		ЗаписьЛога.Уровень 		= "Информация";
		ЗаписьЛога.Сообщение 	= Поток.Имя;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных);
		
		КэшЛогПотокОткрыт = Ложь;
		КэшЛогОжидаетПервоеСобытие = Ложь;
		
		Логирование_СохранитьПеременную("ЛогПоток", Неопределено, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогПотокФЗ", Неопределено, АдресаПеременных);
		
		ГлЯдро_Логирование_ЗаписатьБуферЗаписей(логПоток,, АдресаПеременных);
			
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗакрытьПоток", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
	КонецПопытки;
	
	КэшЛогПотокОткрыт = Ложь;
	
	Попытка
		Логирование_СохранитьПеременную("ЛогПоток", Неопределено, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогПотокФЗ", Неопределено, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогБылиОшибки", Неопределено, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогБуферЗаписейСервер", Новый Массив, АдресаПеременных);
		Логирование_СохранитьПеременную("ЛогСтекСобытий", Новый Массив, АдресаПеременных);

		// Удаление временного хранилища фонового задания — конец жизненного цикла буфера лога.
		// При аварийном завершении этот код не достигается (сеанс задания прерывается раньше);
		// очистка временного хранилища выполняется обработчиком завершения на клиенте.
		Если ТипЗнч(АдресаПеременных) = Тип("Структура")
			И АдресаПеременных.Свойство("АдресЛогБуфераФЗ")
			И ЭтоАдресВременногоХранилища(АдресаПеременных.АдресЛогБуфераФЗ) Тогда
			УдалитьИзВременногоХранилища(АдресаПеременных.АдресЛогБуфераФЗ);
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Начинает событие внутри открытого потока логирования. В режиме ТолькоОшибки первое событие потока
// материализуется и добавляется в стек сразу, остальные события - только при записи ошибки.
//
// Параметры:
//  ИмяСобытия       - Строка - наименование события.
//  Контекст         - Произвольный - контекстные данные события.
//  Модуль           - Произвольный - источник вызова. Если не указан, используется ЭтотОбъект.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура - событие (Ид, Имя, ИдРодителя, ВремяНачала, Модуль, Материализовано).
//  Неопределено - поток не открыт.
//
Функция ЛогНачатьСобытие(ИмяСобытия, Контекст = Неопределено, Модуль = Неопределено, АдресаПеременных)
	
	Попытка
		
		Если Модуль = Неопределено Тогда
			ИмяМодуля = Строка(ЭтотОбъект);
		Иначе
			ИмяМодуля = Строка(Модуль);
		КонецЕсли;
		
		Событие = Новый Структура;
		Событие.Вставить("Имя", 		ИмяСобытия);
		Событие.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
		Событие.Вставить("ПотокОткрыт", Ложь);
		Событие.Вставить("Модуль", 		ИмяМодуля);
		
		Если НЕ Логирование_ПотокОткрыт(АдресаПеременных) Тогда
			// Возвращаем пустышку для возможности логировать в ЖР
			Возврат Событие;
		КонецЕсли;
		
		Событие.Вставить("Ид", Строка(Новый УникальныйИдентификатор));
		
		ИдРодителя = Логирование_ПолучитьПоследнееСобытиеСтека(АдресаПеременных);
		Событие.Вставить("ИдРодителя", ИдРодителя);
		Событие.Вставить("ПотокОткрыт", Истина);
		Событие.Вставить("Контекст", Контекст);
		Событие.Вставить("Материализовано", Ложь);
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
		Если РежимОтладки = "ТолькоОшибки" Тогда
			
			Если КэшЛогОжидаетПервоеСобытие = Истина Тогда
				// Материализуем первое событие потока для контекста входных параметров
				Логирование_ЗаписатьНачалоСобытия(Событие, АдресаПеременных);
				КэшЛогОжидаетПервоеСобытие = Ложь;
			КонецЕсли;
			
			Возврат Событие;
		КонецЕсли;
		
		Логирование_ЗаписатьНачалоСобытия(Событие, АдресаПеременных);
		
		Возврат Событие;
	
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогНачатьСобытие", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Завершает ранее начатое событие. Записывает длительность выполнения
// и удаляет событие из стека вместе со всеми незакрытыми дочерними.
//
// Параметры:
//  Событие          - Структура - событие, полученное из ЛогНачатьСобытие.
//  Контекст         - Произвольный - контекстные данные завершения.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогЗавершитьСобытие(Событие, Контекст = Неопределено, АдресаПеременных)
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если НЕ Событие.ПотокОткрыт Тогда
			// Выход из пустого события без открытого потока
			Возврат;
		КонецЕсли;
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
		Если РежимОтладки = "ТолькоОшибки" И НЕ Событие.Материализовано Тогда
			Возврат;
		КонецЕсли;
		
		// Пишем длительность выполнения в лог начала события
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "event_finished";
		ЗаписьЛога.ИдРодителя 	= Событие.ИдРодителя;
		ЗаписьЛога.ИдСобытия 	= Событие.Ид;
		ЗаписьЛога.Модуль 		= Событие.Модуль;
		ЗаписьЛога.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() -Событие.ВремяНачала;
		ЗаписьЛога.Уровень 		= "Информация";
		ЗаписьЛога.Сообщение 	= Событие.Имя;
		
		Если Контекст <> Неопределено Тогда
			ЗаписьЛога.Вставить("Контекст", Контекст);
		КонецЕсли;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных);
		
		// Удаление из стека
		ЛогСтекСобытий = Логирование_ПолучитьПеременную("ЛогСтекСобытий", АдресаПеременных);
		
		Инд = ЛогСтекСобытий.ВГраница();
		Пока Инд >= 0 Цикл
		
			Если ЛогСтекСобытий[Инд] = Событие.Ид Тогда
				ЛогСтекСобытий.Удалить(Инд);
				Прервать;
			Иначе
				ЛогСтекСобытий.Удалить(Инд);
			КонецЕсли;
			
			Инд = Инд - 1;
		
		КонецЦикла;
		
		Логирование_СохранитьПеременную("ЛогСтекСобытий", ЛогСтекСобытий, АдресаПеременных);
	
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗавершитьСобытие", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
	КонецПопытки;
	
КонецПроцедуры

// Записывает информационное сообщение в лог текущего события.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  АдресаПеременных       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогИнфо(Событие, Сообщение, СообщениеШаблон, Контекст = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ЛогЗаписать("Информация", Событие, Сообщение, СообщениеШаблон, Контекст,, ДополнительныеПараметры, АдресаПеременных);
	
КонецПроцедуры

// Записывает предупреждение в лог текущего события.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  АдресаПеременных       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогПредупреждение(Событие, Сообщение, СообщениеШаблон, Контекст = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ЛогЗаписать("Предупреждение", Событие, Сообщение, СообщениеШаблон, Контекст,, ДополнительныеПараметры, АдресаПеременных);
	
КонецПроцедуры

// Записывает ошибку в лог текущего события. При наличии информации об ошибке
// формирует структуру с описанием, модулем, строкой, причиной и стеком вызовов.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ИнформацияОбОшибке     - ИнформацияОбОшибке, Строка - детали ошибки.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  АдресаПеременных       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогОшибка(Событие, Сообщение = "", СообщениеШаблон = "", Контекст = Неопределено, ИнформацияОбОшибке = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ЛогЗаписать("Ошибка", Событие, Сообщение, СообщениеШаблон, Контекст, ИнформацияОбОшибке, ДополнительныеПараметры, АдресаПеременных);
	
КонецПроцедуры

// Записывает сообщение указанного уровня в лог текущего события. Извлекает русскоязычный
// текст из многоязычной строки, формирует структуру ошибки для уровня "Ошибка".
//
// Параметры:
//  Уровень                - Строка - уровень записи: "Информация", "Предупреждение", "Ошибка".
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ИнформацияОбОшибке     - ИнформацияОбОшибке, Строка - детали ошибки для уровня "Ошибка".
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  АдресаПеременных       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогЗаписать(Уровень, Событие, Сообщение, Знач СообщениеШаблон, Контекст = Неопределено, ИнформацияОбОшибке = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ИнфоДиагностика = Новый Соответствие;
		Если Событие.ПотокОткрыт Тогда
			ИнфоДиагностика.Вставить("Ид события", Событие.Ид);
		КонецЕсли;
		ИнфоДиагностика.Вставить("Событие", Событие.Имя);
		ИнфоДиагностика.Вставить("Модуль", Событие.Модуль);
		
		ДопПараметрыЖР = Новый Структура;
		ДопПараметрыЖР.Вставить("ИнфоДиагностика", ИнфоДиагностика);
		
		// Запись в ЖР
		Если Уровень = "Ошибка" И ИнформацияОбОшибке <> Неопределено Тогда
			
			Если ТипЗнч(ИнформацияОбОшибке) = Тип("Строка") Тогда
				ТекстОшибкиЖР = ИнформацияОбОшибке;
			Иначе
				ТекстОшибкиЖР = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			КонецЕсли;
			
			СообщениеЖР = НСтр("ru = 'Ошибка:'");
			СообщениеЖР = СокрЛП(Сообщение + Символы.ПС + СообщениеЖР + Символы.ПС + ТекстОшибкиЖР);
			
		Иначе
			СообщениеЖР = Сообщение;
		КонецЕсли;
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(Событие.Имя, Уровень, СообщениеЖР, Событие.ВремяНачала, АдресаПеременных, ДопПараметрыЖР);
		
		Если НЕ Событие.ПотокОткрыт Тогда
			// Выход из пустого события без открытого потока
			Возврат;
		КонецЕсли;
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
		Если РежимОтладки = "ТолькоОшибки" Тогда
			Если Уровень <> "Ошибка" Тогда
				Возврат;
			КонецЕсли;
			Логирование_ЗаписатьНачалоСобытия(Событие, АдресаПеременных);
		КонецЕсли;
		
		// Проверяем, что текст с локализацией и логируем только на RU
		пСообщениеШаблон = ВРег(СтрЗаменить(СообщениеШаблон, " ", ""));
		Если Найти(пСообщениеШаблон, "RU=") > 0 Тогда
			СообщениеШаблон = НСтр(СообщениеШаблон, "ru");
		КонецЕсли;
		
		ЗаписьЛога 					= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 		= "step";
		ЗаписьЛога.ИдРодителя 		= Событие.ИдРодителя;
		ЗаписьЛога.ИдСобытия 		= Событие.Ид;
		ЗаписьЛога.Модуль 			= Событие.Модуль;
		ЗаписьЛога.Длительность 	= Неопределено;
		ЗаписьЛога.Уровень 			= Уровень;
		ЗаписьЛога.Сообщение 		= Сообщение;
		ЗаписьЛога.СообщениеШаблон 	= СообщениеШаблон;
		ЗаписьЛога.Контекст 		= Контекст;
		
		Если Уровень = "Ошибка" Тогда
			
			Логирование_СохранитьПеременную("ЛогБылиОшибки", Истина, АдресаПеременных);
			
			Если ИнформацияОбОшибке <> Неопределено Тогда
				
				СтруктураОшибки = Новый Структура("message, module, line, source_line, cause, stack_trace");
				
				Если ТипЗнч(ИнформацияОбОшибке) = Тип("Строка") Тогда
					СтруктураОшибки.message = ИнформацияОбОшибке;
				Иначе
					СтруктураОшибки.message 	= ИнформацияОбОшибке.Описание;
					СтруктураОшибки.module 		= ИнформацияОбОшибке.ИмяМодуля;
					СтруктураОшибки.line 		= ИнформацияОбОшибке.НомерСтроки;
					СтруктураОшибки.source_line = ИнформацияОбОшибке.ИсходнаяСтрока;
					СтруктураОшибки.stack_trace = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
					
					Если ИнформацияОбОшибке.Причина <> Неопределено Тогда
						СтруктураОшибки.Вставить("cause", ИнформацияОбОшибке.Причина.Описание);
					КонецЕсли;
					
				КонецЕсли;
				
				ЗаписьЛога.Ошибка = СтруктураОшибки;
				
				Если ПустаяСтрока(ЗаписьЛога.Сообщение)
					И ЗначениеЗаполнено(СтруктураОшибки.message) Тогда
					ЗаписьЛога.Сообщение = СокрЛП(СтруктураОшибки.message);
				КонецЕсли;
				
				Если ПустаяСтрока(ЗаписьЛога.СообщениеШаблон)
					И ЗначениеЗаполнено(ЗаписьЛога.Сообщение) Тогда
					ЗаписьЛога.СообщениеШаблон = ЗаписьЛога.Сообщение;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЛогАктуализироватьСтекСобытий(Событие, АдресаПеременных);
		Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных);
		
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗаписать", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
	КонецПопытки;
	
КонецПроцедуры

// Формирует аргументы контекста метода для записи в лог.
//
// Параметры:
//  ИмяСобытия             - Строка - имя события для особой обработки контекста.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  ИменаПараметров        - Строка - имена параметров через запятую для сопоставления с Парам1..Парам9.
//  Парам1                 - Произвольный - значение параметра контекста.
//  Парам2..Парам9         - Произвольный - дополнительные значения параметров контекста.
//
// Возвращаемое значение:
//  Структура, Неопределено - аргументы ЛогОписатьКонтекст для отложенного формирования контекста.
//
Функция ЛогОписатьКонтекст(ИмяСобытия, ДополнительныеПараметры = Неопределено,
	ИменаПараметров = "",
	Парам1,
	Парам2 = Неопределено,
	Парам3 = Неопределено,
	Парам4 = Неопределено,
	Парам5 = Неопределено,
	Парам6 = Неопределено,
	Парам7 = Неопределено,
	Парам8 = Неопределено,
	Парам9 = Неопределено,
	Парам10 = Неопределено,
	Парам11 = Неопределено,
	Парам12 = Неопределено,
	Парам13 = Неопределено,
	Парам14 = Неопределено,
	Парам15 = Неопределено,
	Парам16 = Неопределено,
	Парам17 = Неопределено,
	Парам18 = Неопределено,
	Парам19 = Неопределено,
	Парам20 = Неопределено)
	
	Если КэшЛогПотокОткрыт = Ложь Тогда
		// TODO: Временное решение, т.к КэшЛогПотокОткрыт может быть не инициализирована.
		Возврат Неопределено;		
	КонецЕсли;
	
	Попытка
	
		ПараметрыКонтекста = Новый Массив;
		ПараметрыКонтекста.Добавить(Парам1);
		ПараметрыКонтекста.Добавить(Парам2);
		ПараметрыКонтекста.Добавить(Парам3);
		ПараметрыКонтекста.Добавить(Парам4);
		ПараметрыКонтекста.Добавить(Парам5);
		ПараметрыКонтекста.Добавить(Парам6);
		ПараметрыКонтекста.Добавить(Парам7);
		ПараметрыКонтекста.Добавить(Парам8);
		ПараметрыКонтекста.Добавить(Парам9);
		ПараметрыКонтекста.Добавить(Парам10);
		ПараметрыКонтекста.Добавить(Парам11);
		ПараметрыКонтекста.Добавить(Парам12);
		ПараметрыКонтекста.Добавить(Парам13);
		ПараметрыКонтекста.Добавить(Парам14);
		ПараметрыКонтекста.Добавить(Парам15);
		ПараметрыКонтекста.Добавить(Парам16);
		ПараметрыКонтекста.Добавить(Парам17);
		ПараметрыКонтекста.Добавить(Парам18);
		ПараметрыКонтекста.Добавить(Парам19);
		ПараметрыКонтекста.Добавить(Парам20);
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяСобытия", 				ИмяСобытия);
		Результат.Вставить("ДополнительныеПараметры", 	ДополнительныеПараметры);
		Результат.Вставить("ИменаПараметров", 			ИменаПараметров);
		Результат.Вставить("ПараметрыКонтекста", 		ПараметрыКонтекста);
		
		Возврат Результат;
	
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Актуализирует стек событий, удаляя незакрытые дочерние события.
// Если текущее событие не на вершине стека, все записи до него удаляются.
//
// Параметры:
//  Событие          - Структура - текущее событие.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ЛогАктуализироватьСтекСобытий(Событие, АдресаПеременных)
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Событие.ПотокОткрыт Тогда
		// Выход из пустого события без открытого потока
		Возврат;
	КонецЕсли;
	
	ЛогСтекСобытий = Логирование_ПолучитьПеременную("ЛогСтекСобытий", АдресаПеременных);
	
	Если ЛогСтекСобытий.Количество() Тогда
		ПоследнийСтек = ЛогСтекСобытий[ЛогСтекСобытий.ВГраница()];
	КонецЕсли;
	
	Если ПоследнийСтек <> Событие.Ид Тогда
		
		Инд = ЛогСтекСобытий.ВГраница();
		Пока Инд >= 0 Цикл
			
			Если ЛогСтекСобытий[Инд] = Событие.Ид Тогда
				Прервать;
			Иначе
				ЛогСтекСобытий.Удалить(Инд);
			КонецЕсли;
			
			Инд = Инд - 1;
			
		КонецЦикла;
		
		Если ЛогСтекСобытий.Количество() = 0 Тогда
			ЛогСтекСобытий.Добавить(Событие.Ид);
		КонецЕсли;
		
		Логирование_СохранитьПеременную("ЛогСтекСобытий", ЛогСтекСобытий, АдресаПеременных);
		
	КонецЕсли;
	
КонецПроцедуры 

#Область Логирование_СлужебныйПрограммныйИнтерфейс

// Выгружает буфер лог-записей в Elasticsearch: собирает ES-документы для потока
// и отправляет их через выбранный режим транспорта.
//
// Параметры:
//  Поток                 - Структура - см. ЛогОткрытьПоток.
//  ЛогБуферЗаписейКлиент - Массив - клиентский буфер лог-записей, будет присоединён
//                                   к серверному буферу перед формированием ES-документов.
//                        - Неопределено - сливается только серверный буфер.
//  АдресаПеременных      - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ГлЯдро_Логирование_ЗаписатьБуферЗаписей(Поток, ЛогБуферЗаписейКлиент = Неопределено, АдресаПеременных) Экспорт
	
	РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
	
	Если РежимОтладки = "ТолькоОшибки" Тогда
		
		БылиОшибки = Логирование_ПолучитьПеременную("ЛогБылиОшибки", АдресаПеременных);
		Если БылиОшибки <> Истина Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументыES = ГлЯдро_Логирование_ПодготовитьДокументыES(Поток, ЛогБуферЗаписейКлиент, АдресаПеременных);
	
	Логирование_ОтправитьДокументы(ДокументыES, АдресаПеременных);
		
КонецПроцедуры

// Объединяет серверный (из АдресаПеременных) и клиентский (параметр) буферы
// лог-записей в массив ES-документов. Дозаполняет данные сеанса для клиентских
// событий и собирает окружение.
//
// Параметры:
//  Поток              - Структура - см. ЛогОткрытьПоток. Если поле КонтекстСеансаСервер
//                                   не заполнено — дозаполняется текущим серверным контекстом.
//  БуферЗаписейКлиент - Массив - клиентский буфер лог-записей для слияния с серверным.
//                     - Неопределено - используется только серверный буфер.
//  АдресаПеременных   - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Массив - массив Соответствий, каждое из которых представляет ES-документ.
//
Функция ГлЯдро_Логирование_ПодготовитьДокументыES(Поток, БуферЗаписейКлиент = Неопределено, АдресаПеременных) Экспорт
	
	БуферЗаписейСервер 	= Логирование_ПолучитьПеременную("ЛогБуферЗаписейСервер", АдресаПеременных);
	Окружение 			= Логирование_СобратьОкружение(АдресаПеременных);
	РежимОтладки 		= Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
	
	Если Поток.КонтекстСеансаСервер = Неопределено Тогда
		Поток.Вставить("КонтекстСеансаСервер", Логирование_ПолучитьКонтекстСеанса());
	КонецЕсли;
	
	ДанныеЛогирования = Новый Структура;
	ДанныеЛогирования.Вставить("Поток", 				Поток);
	ДанныеЛогирования.Вставить("БуферЗаписейСервер", 	БуферЗаписейСервер);
	ДанныеЛогирования.Вставить("БуферЗаписейКлиент", 	БуферЗаписейКлиент);
	ДанныеЛогирования.Вставить("Окружение", 			Окружение);
	ДанныеЛогирования.Вставить("РежимОтладки", 			РежимОтладки);
	
	ДокументыES = Логирование_СобратьДокументыES(ДанныеЛогирования);
	
	Возврат ДокументыES;
	
КонецФункции

// Восстанавливает буфер записей лога упавшего фонового задания: дописывает Error-запись
// с текстом ошибки в накопленный буфер и отправляет документы в Elasticsearch.
//
// Параметры:
//  РезультатФЗ      - Строка - подробное представление ошибки выполнения фонового задания.
//                     Если пустая строка — Error-запись не дописывается.
//  СтруктураЛогаФЗ  - Структура - состояние логирования из временного хранилища, свойства:
//   * ЛогПотокФЗ            - Структура - см. ЛогОткрытьПоток.
//   * ЛогБуферЗаписейСервер - Массив - накопленные записи лога фонового задания.
//   * ЛогСтекСобытий        - Массив - идентификаторы открытых событий на момент краха.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина, если буфер передан на отправку.
//           Ложь, если поток отсутствует, буфер пуст или возникло исключение.
//
Функция ГлЯдро_Логирование_ВосстановитьБуферЗаписейФЗ(РезультатФЗ, СтруктураЛогаФЗ, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_Логирование_ВосстановитьБуферЗаписейФЗ";
	
	Попытка
		
		Поток = СтруктураЛогаФЗ.ЛогПотокФЗ;
		БуферЗаписейСервер = СтруктураЛогаФЗ.ЛогБуферЗаписейСервер;
		
		Если Поток = Неопределено
			ИЛИ БуферЗаписейСервер.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Синтез завершающих записей упавшего ФЗ. 
		
		Если ЗначениеЗаполнено(РезультатФЗ) Тогда
			
			СтруктураОшибки 			= Новый Структура("message, module, line, source_line, cause, stack_trace");
			СтруктураОшибки.message 	= РезультатФЗ;
			СтруктураОшибки.stack_trace = РезультатФЗ;
			
			ЗаписьОшибки 			= Логирование_НоваяЗапись();
			ЗаписьОшибки.ТипСобытия = "step";
			ЗаписьОшибки.ИдРодителя = Поток.Ид;
			ЗаписьОшибки.ИдСобытия 	= Поток.Ид;
			ЗаписьОшибки.Модуль 	= Поток.Модуль;
			ЗаписьОшибки.Уровень 	= "Ошибка";
			ЗаписьОшибки.Сообщение 	= РезультатФЗ;
			ЗаписьОшибки.Ошибка 	= СтруктураОшибки;
			
			БуферЗаписейСервер.Добавить(ЗаписьОшибки);
			
		КонецЕсли;
		
		ЗаписьЗакрытия 				= Логирование_НоваяЗапись();
		ЗаписьЗакрытия.ТипСобытия 	= "flow_finished";
		ЗаписьЗакрытия.ИдРодителя 	= Поток.ИдРодителя;
		ЗаписьЗакрытия.ИдСобытия 	= Поток.Ид;
		ЗаписьЗакрытия.Модуль 		= Поток.Модуль;
		ЗаписьЗакрытия.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() -Поток.ВремяНачала;
		
		ЗаписьЗакрытия.Уровень = "Ошибка";
		ЗаписьЗакрытия.Сообщение = Поток.Имя + " [ПринудительноеЗакрытие]";
		
		БуферЗаписейСервер.Добавить(ЗаписьЗакрытия);
		
		Окружение = Логирование_СобратьОкружение(АдресаПеременных);
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
		
		ДанныеЛогирования = Новый Структура;
		ДанныеЛогирования.Вставить("Поток", 				Поток);
		ДанныеЛогирования.Вставить("БуферЗаписейСервер", 	БуферЗаписейСервер);
		ДанныеЛогирования.Вставить("БуферЗаписейКлиент", 	Неопределено);
		ДанныеЛогирования.Вставить("Окружение", 			Окружение);
		ДанныеЛогирования.Вставить("РежимОтладки", 			РежимОтладки);
		
		ДокументыES = Логирование_СобратьДокументыES(ДанныеЛогирования);
		Логирование_ОтправитьДокументы(ДокументыES, АдресаПеременных);
		
		Возврат Истина;
		
	Исключение
		// Домен логирования собственные записи не пишет — резервно используется журнал регистрации.
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование." + ИмяСобытия, "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Пересылает накопленные лог-сообщения из таблицы ОтправляемыеСообщения SMARTS
// в Elasticsearch. Поддерживает прямой и фоновый вызов.
//
// Параметры:
//  Параметры       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных (прямой вызов).
//                  - Структура - параметры фонового задания со свойством ЗначенияПеременных
//                    (фоновый вызов, когда задан АдресРезультата).
//  АдресРезультата - Строка, Неопределено - адрес временного хранилища для результата
//                    фонового задания. Если указан — Параметры трактуются как параметры ФЗ.
//
Процедура ГлЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearch(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ИмяСобытия = "ГлЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearch";
	
	Если АдресРезультата <> Неопределено Тогда
		АдресаПеременных = Параметры.ЗначенияПеременных;
		АдресаПеременных.Вставить("ЭтоФоновоеЗадание", Истина);
		ЭтоФоновоеЗадание = Истина;
	Иначе
		АдресаПеременных = Параметры;
		ЭтоФоновоеЗадание = Ложь;
	КонецЕсли;
	
	ID_ТекущейБазы = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
	
	КлючTimestamp = "Cleverence_Логирование_ПоследнееПересланноеСообщение_" + ID_ТекущейБазы;
	ПоследнийTimestamp = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючTimestamp,, Истина);
	
	ИмяПоляДатаВремя = ГлЯдро_СтрокуВТранслитENG("ДатаВремя");
	ИмяПоляJSON = ГлЯдро_СтрокуВТранслитENG("ОтправляемыйJSON");
	
	РазмерБатча = 100;
	ВсегоОтправлено = 0;
	
	ЕстьЕщеДанные = Истина;
	
	Пока ЕстьЕщеДанные Цикл
		
		ЗаписиБуфера = Логирование_ПолучитьОтправляемыеСообщенияSMARTS(ПоследнийTimestamp, ИмяПоляДатаВремя, РазмерБатча, АдресаПеременных);
		
		КоличествоЗаписей = 0;
		
		Если ЗаписиБуфера <> Неопределено Тогда
			КоличествоЗаписей = ЗаписиБуфера.Количество();
		КонецЕсли;
		
		Если КоличествоЗаписей = 0 Тогда
			Прервать;
		КонецЕсли;
		
		РезультатОбработки 	= Логирование_ОбработатьОтправляемыеСообщенияSMARTS(ЗаписиБуфера, ИмяПоляJSON, ИмяПоляДатаВремя, ПоследнийTimestamp);
		ДокументыES 		= РезультатОбработки.ДокументыES;
		НовыйTimestamp 		= РезультатОбработки.НовыйTimestamp;
		
		Если ДокументыES.Количество() > 0 Тогда
			
			УспешнаяОтправка = Логирование_ОтправитьВElasticsearch(ДокументыES, АдресаПеременных);
			
			Если УспешнаяОтправка Тогда
				
				Логирование_УдалитьОтправленныеСообщенияSMARTS(ЗаписиБуфера, АдресаПеременных);
				
				Если НЕ ЭтоФоновоеЗадание Тогда
					ГлЯдро_СохранитьДанныеВХранилище1С(КлючTimestamp, НовыйTimestamp, Истина);
				КонецЕсли;
				
				ПоследнийTimestamp = НовыйTimestamp;
				ВсегоОтправлено = ВсегоОтправлено + ДокументыES.Количество();
				
			Иначе
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЕстьЕщеДанные = КоличествоЗаписей >= РазмерБатча;
		
	КонецЦикла;
	
	Если ВсегоОтправлено Тогда
		
		пСообщение = ГлЯдро_СтрШаблон("Отправлено документов в Elasticsearch: %1", ВсегоОтправлено);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		
	КонецЕсли;
	
КонецПроцедуры

// Определяет и сохраняет в настройке ЛогРежимОтправкиES режим отправки лог-сообщений
// в Elasticsearch: "Прямой", "НакапливатьSMARTS_Регламент" или "НакапливатьSMARTS_ПриОткрытии".
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура ГлЯдро_Логирование_ОпределитьРежимОтправкиES(АдресаПеременных)
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	КонецЕсли;
	
	РасположениеКомпоненты = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
	
	Если РасположениеКомпоненты = "НаКлиенте" Тогда
		НовыйРежим = "Прямой";
	Иначе
		
		СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
		
		ТаблицаНайдена = Ложь;
		Если ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("Tables")
			И ТипЗнч(СтруктураМетаданных.Tables) = Тип("СписокЗначений") Тогда
			
			ИмяТаблицыПоиска = "ОтправляемыеСообщения";
			
			Для Каждого ЭлементТаблицы Из СтруктураМетаданных.Tables Цикл
				Если ЭлементТаблицы.Представление = ИмяТаблицыПоиска Тогда
					ТаблицаНайдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ ТаблицаНайдена Тогда
			НовыйРежим = "Прямой";
		Иначе
			
			// В веб-вызове онлайн-обмен гарантированно активен - сам факт вызова подтверждает его доступность.
			Если ЭтоWebСервис Тогда
				ОнлайнОбменАктивен = Истина;
			Иначе
				ОнлайнОбменАктивен = Неопределено;
				ПараметрыПодключенияMS.Свойство("ОнлайнОбменАктивен", ОнлайнОбменАктивен);
			КонецЕсли;
			
			Если ОнлайнОбменАктивен = Истина Тогда
				НовыйРежим = "НакапливатьSMARTS_Регламент";
			Иначе
				НовыйРежим = "НакапливатьSMARTS_ПриОткрытии";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НовыйРежим = "НакапливатьSMARTS_ПриОткрытии" Тогда
		
		ДоступноВыполнениеВФоне = КомЯдро_ПолучитьЗначениеПеременной("ДоступноВыполнениеВФоне", АдресаПеременных);
		Если ДоступноВыполнениеВФоне <> Истина Тогда
			НовыйРежим = "Прямой";
		КонецЕсли;
		
	КонецЕсли;
	
	КлючРежима = "Cleverence_ЛогРежимОтправкиES_" + ПараметрыПодключенияMS.Ид;
	
	Режим = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючРежима);
	Если Режим <> НовыйРежим Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючРежима, НовыйРежим);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Логирование_СлужебныеПроцедурыИФункции

// Определяет, включено ли логирование для текущего сеанса.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина, если логирование включено.
//
Функция Логирование_ИспользоватьЛогирование(АдресаПеременных)
	
	РежимОтладки = Логирование_ПолучитьРежимОтладкиES(АдресаПеременных);
	Возврат РежимОтладки <> "Выключено";
	
КонецФункции

// Возвращает текущий режим отладки ES-логирования.
// Значения:
// 		- Выключено
// 		- ВсяИнформация
// 		- ТолькоОшибки
// При отсутствии настройки — "ТолькоОшибки".
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Строка - "ВсяИнформация", "ТолькоОшибки" или "Выключено".
//
Функция Логирование_ПолучитьРежимОтладкиES(АдресаПеременных)
	
	Режим = КэшЛогРежимОтладкиES;
	
	Если Режим = Неопределено Тогда
		
		Режим = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ЛогРежимОтладкиES",, АдресаПеременных);
		
		Если Режим = Неопределено ИЛИ Режим = Ложь Тогда
			Режим = "ТолькоОшибки";
		КонецЕсли;
		
		КэшЛогРежимОтладкиES = Режим;
		
	КонецЕсли;
	
	Возврат Режим;
	
КонецФункции

// Возвращает текущий режим отправки ES-логов.
// Значения:
// 		- "НакапливатьSMARTS_Регламент" - Сообщения копятся в таблице SMARTS.
// 			Пересылка SMARTS -> ES выполняется в регламентном задании MS, вызывается метод ОО.
// 			Необходим настроенный онлайн обмен.
//
// 		- "НакапливатьSMARTS_ПриОткрытии" - Сообщения копятся в таблице SMARTS.
// 			Пересылка SMARTS -> ES выполняется в ФЗ при открытии ОО.
// 			Необходима доступность фоновых заданий.
//
// 		- "Прямой" - Прямая отправка в ES сразу после закрытия потока.
// 			Выполняется без ФЗ в текущем сеансе.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Строка - "Прямой" или "НакапливатьSMARTS".
//
Функция Логирование_ПолучитьРежимОтправкиES(АдресаПеременных)
	
	ID_ТекущейБазы = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
	КлючРежима = "Cleverence_ЛогРежимОтправкиES_" + ID_ТекущейБазы;
	
	Режим = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючРежима);
	
	Если Режим = Неопределено ИЛИ Режим = Ложь Тогда
		Возврат "Прямой";
	КонецЕсли;
	
	Возврат Режим;
	
КонецФункции

// Возвращает текущий активный поток логирования. Для фоновых заданий
// возвращает дочерний поток (ЛогПотокФЗ), для остальных — основной (ЛогПоток).
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//  ПолучитьРодителя - Булево - получить родительский поток вместо дочернего (для ФЗ).
//
// Возвращаемое значение:
//  Структура - текущий поток (Ид, ИдРодителя, Имя, ВремяНачала, Модуль).
//  Неопределено - поток не открыт.
//
Функция Логирование_ПолучитьПоток(АдресаПеременных, ПолучитьРодителя = Ложь)
	
	Если НЕ ПолучитьРодителя
		И АдресаПеременных.Свойство("ЭтоФоновоеЗадание")
		И АдресаПеременных.ЭтоФоновоеЗадание = Истина Тогда
		
		ЛогПоток = Логирование_ПолучитьПеременную("ЛогПотокФЗ", АдресаПеременных);
		
	Иначе
		ЛогПоток = Логирование_ПолучитьПеременную("ЛогПоток", АдресаПеременных);
	КонецЕсли;
	
	Возврат ЛогПоток;
	
КонецФункции

// Проверяет, открыт ли поток логирования.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина, если поток открыт и логирование включено.
//
Функция Логирование_ПотокОткрыт(АдресаПеременных)
	
	Если КэшЛогПотокОткрыт = Неопределено Тогда
		ЛогПоток = Логирование_ПолучитьПоток(АдресаПеременных);
		КэшЛогПотокОткрыт = ЛогПоток <> Неопределено;
	КонецЕсли;
	
	Возврат КэшЛогПотокОткрыт = Истина;
	
КонецФункции

// Создаёт пустую структуру лог-записи с заполненными timestamp и uid.
// Включает поля для события, сообщения, контекста сеанса и ошибки.
//
// Возвращаемое значение:
//  Структура - заготовка лог-записи с ключами: timestamp, uid, ТипСобытия,
//              ИдРодителя, ИдСобытия, Модуль, Длительность, Уровень, Сообщение,
//              СообщениеШаблон, Контекст, Ошибка, Директива, ИмяПриложения,
//              НачалоСеанса, НомерСеанса, НомерСоединения, Пользователь,
//              ФоновоеЗадание, ДоступныеПрава.
//
Функция Логирование_НоваяЗапись()
	
	Поля = "timestamp,
		|uid,
		|ТипСобытия,
		|ИдРодителя,
		|ИдСобытия,
		|Модуль,
		|Длительность,
		|Уровень,
		|Сообщение,
		|СообщениеШаблон,
		|Контекст,
		|Ошибка,
		|Директива,
		|ИмяПриложения,
		|ИмяКомпьютера,
		|НачалоСеанса,
		|НомерСеанса,
		|НомерСоединения,
		|Пользователь,
		|ФоновоеЗадание,
		|ДоступныеПрава";
	
	НоваяЗапись = Новый Структура(Поля);
	НоваяЗапись.timestamp 	= ГлЯдро_ПолучитьTimestamp();
	НоваяЗапись.uid 		= Строка(Новый УникальныйИдентификатор);
	НоваяЗапись.Директива 	= "НаСервере";
	
	Возврат НоваяЗапись;
	
КонецФункции

// Собирает информацию о текущем сеансе.
//
// Возвращаемое значение:
//  Структура - контекст сеанса с ключами: ИмяПриложения, НачалоСеанса,
//              НомерСеанса, НомерСоединения, Пользователь, ДоступныеПрава,
//              ФоновоеЗадание.
//
Функция Логирование_ПолучитьКонтекстСеанса()
	
	КонтекстСеанса = Новый Структура;
	
	ТекСеанс = ПолучитьТекущийСеансИнформационнойБазы();
	
	ПредставлениеПриложения = ТекСеанс.ИмяПриложения;
	Если ТекСеанс.ИмяПриложения = "1CV8" Тогда
		
		ПредставлениеПриложения = "ТолстыйКлиент";
		#Если ТолстыйКлиентУправляемоеПриложение Тогда
			ПредставлениеПриложения = "ТолстыйКлиентУправляемоеПриложение";
		#КонецЕсли
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ПредставлениеПриложения = "ТолстыйКлиентОбычноеПриложение";
		#КонецЕсли
		
	ИначеЕсли ТекСеанс.ИмяПриложения = "1CV8C" Тогда
		
		ПредставлениеПриложения = "ТонкийКлиент";
		
	КонецЕсли;
	
	КонтекстСеанса.Вставить("ИмяПриложения", 	ПредставлениеПриложения);
	КонтекстСеанса.Вставить("НачалоСеанса", 	ТекСеанс.НачалоСеанса);
	КонтекстСеанса.Вставить("НомерСеанса", 		ТекСеанс.НомерСеанса);
	КонтекстСеанса.Вставить("НомерСоединения", 	ТекСеанс.НомерСоединения);
	КонтекстСеанса.Вставить("ИмяКомпьютера", 	ИмяКомпьютера());
	
	Если ТекСеанс.Пользователь <> Неопределено Тогда
		КонтекстСеанса.Вставить("Пользователь", ТекСеанс.Пользователь.Имя);
	Иначе
		КонтекстСеанса.Вставить("Пользователь", "");
	КонецЕсли;
	
	ДоступныеПрава = Логирование_ДоступныеПраваДоступа();
	Если ДоступныеПрава.Количество() Тогда
		КонтекстСеанса.Вставить("ДоступныеПрава", ГлЯдро_СтрСоединить(ДоступныеПрава, ","));
	Иначе
		КонтекстСеанса.Вставить("ДоступныеПрава");
	КонецЕсли;
	
	ИнфоФоновоеЗадание = Неопределено;
	
	Если ТекСеанс.ИмяПриложения = "BackgroundJob" Тогда
		
		ФоновоеЗадание = ТекСеанс.ПолучитьФоновоеЗадание();
		Если ФоновоеЗадание <> Неопределено Тогда
			
			ИнфоФоновоеЗадание = Новый Структура;
			ИнфоФоновоеЗадание.Вставить("Наименование", ФоновоеЗадание.Наименование);
			ИнфоФоновоеЗадание.Вставить("УникальныйИдентификатор", Строка(ФоновоеЗадание.УникальныйИдентификатор));
			
		КонецЕсли;
		
	КонецЕсли;
	
	КонтекстСеанса.Вставить("ФоновоеЗадание", ИнфоФоновоеЗадание);
	
	Возврат КонтекстСеанса;
	
КонецФункции

// Возвращает список доступных прав текущего пользователя
// из предопределённого перечня.
//
// Возвращаемое значение:
//  Массив - имена доступных прав (например "АдминистрированиеДанных").
//
Функция Логирование_ДоступныеПраваДоступа()
	
	ПроверяемыеПрава = Новый Массив;
	ПроверяемыеПрава.Добавить("АдминистрированиеДанных");
	
	ДоступныеПрава = Новый Массив;
	Для каждого Право Из ПроверяемыеПрава Цикл
		Если ПравоДоступа(Право, Метаданные) Тогда
			ДоступныеПрава.Добавить(Право);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДоступныеПрава;
	
КонецФункции 

// Возвращает значение переменной из состояния логирования.
// В режиме фонового задания для ключей сохраняемого буфера ("ЛогПотокФЗ"
// и "ЛогБуферЗаписейСервер") читает из временного хранилища; иначе обращается
// к КомЯдро_ПолучитьЗначениеПеременной.
//
// Параметры:
//  КлючПеременной   - Строка - имя ключа состояния.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Произвольный - значение ключа.
//  Неопределено - ключ не найден или временное хранилище уже не содержит структуру.
//
Функция Логирование_ПолучитьПеременную(КлючПеременной, АдресаПеременных)
	
	Если (КлючПеременной = "ЛогПотокФЗ" ИЛИ КлючПеременной = "ЛогБуферЗаписейСервер")
		И АдресаПеременных <> Неопределено
		И АдресаПеременных.Свойство("ЭтоФоновоеЗадание")
		И АдресаПеременных.ЭтоФоновоеЗадание = Истина
		И АдресаПеременных.Свойство("АдресЛогБуфераФЗ")
		И ЗначениеЗаполнено(АдресаПеременных.АдресЛогБуфераФЗ) Тогда
		
		Если КэшЛогБуфераФЗ = Неопределено Тогда
			
			КэшЛогБуфераФЗ = Новый Структура;
			КэшЛогБуфераФЗ.Вставить("ЛогПотокФЗ", Неопределено);
			КэшЛогБуфераФЗ.Вставить("ЛогБуферЗаписейСервер", Новый Массив);
			
		КонецЕсли;
		
		Возврат КэшЛогБуфераФЗ[КлючПеременной];
		
	КонецЕсли;
	
	Если КэшЛогирования <> Неопределено
		И КэшЛогирования.Свойство(КлючПеременной) Тогда
		
		Возврат КэшЛогирования[КлючПеременной];
		
	КонецЕсли;
	
	Возврат КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
КонецФункции

// Сохраняет значение переменной в состояние логирования.
// В режиме фонового задания для ключей сохраняемого буфера ("ЛогПотокФЗ"
// и "ЛогБуферЗаписейСервер") выполняет чтение, изменение и запись всей структуры
// во временное хранилище; для существующего адреса временного хранилища обновляет
// значение по тому же адресу; иначе обращается к КомЯдро_СохранитьЗначениеПеременной.
//
// Параметры:
//  КлючПеременной      - Строка - имя ключа состояния.
//  СохраняемоеЗначение - Произвольный - новое значение ключа.
//  АдресаПеременных    - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина, если значение сохранено.
//           Ложь, если адрес временного хранилища задан, но структура уже отсутствует.
//
Функция Логирование_СохранитьПеременную(КлючПеременной, СохраняемоеЗначение, АдресаПеременных = Неопределено)
	
	Если (КлючПеременной = "ЛогПотокФЗ" ИЛИ КлючПеременной = "ЛогБуферЗаписейСервер")
		И АдресаПеременных <> Неопределено
		И АдресаПеременных.Свойство("ЭтоФоновоеЗадание")
		И АдресаПеременных.ЭтоФоновоеЗадание = Истина
		И АдресаПеременных.Свойство("АдресЛогБуфераФЗ")
		И ЗначениеЗаполнено(АдресаПеременных.АдресЛогБуфераФЗ) Тогда
		
		Если КэшЛогБуфераФЗ = Неопределено Тогда
			
			КэшЛогБуфераФЗ = Новый Структура;
			КэшЛогБуфераФЗ.Вставить("ЛогПотокФЗ", Неопределено);
			КэшЛогБуфераФЗ.Вставить("ЛогБуферЗаписейСервер", Новый Массив);
			
		КонецЕсли;
				
		КэшЛогБуфераФЗ.Вставить(КлючПеременной, СохраняемоеЗначение);
		
		ПоместитьВоВременноеХранилище(КэшЛогБуфераФЗ, АдресаПеременных.АдресЛогБуфераФЗ);
		Возврат Истина;
		
	КонецЕсли;
	
	Если КэшЛогирования = Неопределено Тогда
		КэшЛогирования = Новый Структура;
	КонецЕсли;
	
	КэшЛогирования.Вставить(КлючПеременной, СохраняемоеЗначение);
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		// Сохраняем в один адрес, иначе между Клиент <-> Сервер происходит постоянная синхронизация и тормоза.
		Если АдресаПеременных <> Неопределено
			И АдресаПеременных.Свойство(КлючПеременной) Тогда
			
			АдресПеременной = АдресаПеременных[КлючПеременной];
			Если ЭтоАдресВременногоХранилища(АдресПеременной) Тогда
				
				ПоместитьВоВременноеХранилище(СохраняемоеЗначение, АдресПеременной);
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
	#КонецЕсли
	
	Возврат КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, СохраняемоеЗначение, АдресаПеременных);
	
КонецФункции

// Записывает начало события в буфер логов.
//
// Параметры:
//  Событие          - Структура - текущее событие из ЛогНачатьСобытие.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура Логирование_ЗаписатьНачалоСобытия(Событие, АдресаПеременных)
	
	Если Событие = Неопределено
		ИЛИ НЕ Событие.ПотокОткрыт
		ИЛИ Событие.Материализовано Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЛога 				= Логирование_НоваяЗапись();
	ЗаписьЛога.ТипСобытия 	= "event_started";
	ЗаписьЛога.ИдРодителя 	= Событие.ИдРодителя;
	ЗаписьЛога.ИдСобытия 	= Событие.Ид;
	ЗаписьЛога.Модуль 		= Событие.Модуль;
	ЗаписьЛога.Длительность = Неопределено;
	ЗаписьЛога.Уровень 		= "Информация";
	ЗаписьЛога.Сообщение 	= Событие.Имя;
	
	Если Событие.Контекст <> Неопределено Тогда
		ЗаписьЛога.Вставить("Контекст", Событие.Контекст);
	КонецЕсли;
	
	Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных);
	
	ЛогСтекСобытий = Логирование_ПолучитьПеременную("ЛогСтекСобытий", АдресаПеременных);
	ЛогСтекСобытий.Добавить(Событие.Ид);
	Логирование_СохранитьПеременную("ЛогСтекСобытий", ЛогСтекСобытий, АдресаПеременных);
	
	Событие.Материализовано = Истина;
	
КонецПроцедуры

// Формирует описание контекста из аргументов ЛогОписатьКонтекст.
//
// Параметры:
//  Контекст - Структура - аргументы ЛогОписатьКонтекст.
//
// Возвращаемое значение:
//  Соответствие - описание параметров в формате Ключ - Значение.
//
Функция Логирование_ПолучитьОписаниеКонтекста(Контекст)
	
	ПараметрыКонтекста = Контекст.ПараметрыКонтекста;
	
	Если Контекст.ИменаПараметров = "" Тогда
		Имена = Новый Массив;
		Имена.Добавить("result");
	Иначе
		Имена = ГлЯдро_СтрРазделить(Контекст.ИменаПараметров, ",");
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Для Инд = 0 По Имена.ВГраница() Цикл
		Значение = ПараметрыКонтекста[Инд];
		СтруктураПараметров.Вставить(СокрЛП(Имена[Инд]), Значение);
	КонецЦикла;
	
	Возврат Логирование_ПолучитьОписаниеПараметров(СтруктураПараметров);
	
КонецФункции

// Добавляет лог-запись в серверный буфер (ЛогБуферЗаписейСервер).
// Перед добавлением сокращает контекст записи для безопасного хранения.
//
// Параметры:
//  ЗаписьЛога       - Структура - лог-запись, см. Логирование_НоваяЗапись.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура Логирование_ЗаписатьЛог(ЗаписьЛога, АдресаПеременных)
	
	Буфер = Логирование_ПолучитьПеременную("ЛогБуферЗаписейСервер", АдресаПеременных);
	
	Если Буфер = Неопределено Тогда
		Буфер = Новый Массив;
	КонецЕсли;
	
	Если ЗаписьЛога.СообщениеШаблон = Неопределено Тогда
		ЗаписьЛога.СообщениеШаблон = ЗаписьЛога.Сообщение;
	КонецЕсли;
	
	Если ЗаписьЛога.Контекст <> Неопределено Тогда
		ЗаписьЛога.Контекст = Логирование_ПолучитьОписаниеКонтекста(ЗаписьЛога.Контекст);
	КонецЕсли;
	
	Буфер.Добавить(ЗаписьЛога);
	Логирование_СохранитьПеременную("ЛогБуферЗаписейСервер", Буфер, АдресаПеременных);
	
КонецПроцедуры

// Возвращает идентификатор последнего события из стека.
// Используется для определения родительского события.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Строка - идентификатор события с вершины стека.
//  Неопределено - стек пуст.
//
Функция Логирование_ПолучитьПоследнееСобытиеСтека(АдресаПеременных)
	
	ЛогСтекСобытий = Логирование_ПолучитьПеременную("ЛогСтекСобытий", АдресаПеременных);
	
	Если ЛогСтекСобытий.Количество() Тогда
		Возврат ЛогСтекСобытий[ЛогСтекСобытий.ВГраница()];
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции 

// Рекурсивно преобразует структуру параметров в описание для лога.
// Маскирует секретные ключи, ограничивает глубину рекурсии и длину строк.
//
// Параметры:
//  СтруктураПараметров    - Структура, Соответствие - исходные параметры.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
// Возвращаемое значение:
//  Соответствие - описание параметров в формате Ключ - Значение.
//
Функция Логирование_ПолучитьОписаниеПараметров(СтруктураПараметров, ДополнительныеПараметры = Неопределено)
	
	МаксЧислоСтрок = 10; // Ограничение количества строк в значение с типом Строка. 0 = без ограничений
	
	ОграничитьРекурсию = ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("ОграничитьРекурсию");
	
	СекретныеКлючи = Логирование_ПолучитьСекретныеКлючи();
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из СтруктураПараметров Цикл
	
		Ключ = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		ТипЗначения = ТипЗнч(Значение);
		
		Если СекретныеКлючи.Получить(НРег(Ключ)) <> Неопределено Тогда
		
			// Секретные ключи не пишем в логи, только проверяем заполненность
			Попытка
				Заполнено = ЗначениеЗаполнено(Значение);
			Исключение
				Заполнено = Истина;
			КонецПопытки;
			
			Если Заполнено Тогда
				Результат.Вставить(Ключ, "secret_filled");
			Иначе
				Результат.Вставить(Ключ, "secret_null");
			КонецЕсли;
			
		ИначеЕсли Значение = Неопределено Тогда
		
			Результат.Вставить(Ключ, Неопределено);
			
		ИначеЕсли ТипЗначения = Тип("Булево")
			ИЛИ ТипЗначения = Тип("Число") Тогда
			
			Результат.Вставить(Ключ, Значение);
			
		ИначеЕсли ТипЗначения = Тип("Дата") Тогда
			
			Результат.Вставить(Ключ, Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss; ДП=0001-01-01T00:00:00"));
			
		ИначеЕсли ТипЗначения = Тип("Структура")
			ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
			ИЛИ ТипЗначения = Тип("Соответствие")
			ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
			
			Если ОграничитьРекурсию
				ИЛИ Значение.Количество() = 0 Тогда
				
				Результат.Вставить(Ключ, Строка(Значение) + "(" + Значение.Количество() + ")");
			
			Иначе
			
				пДополнительныеПараметры = Новый Структура;
				
				// Получаем максимум второй уровень для ограничения размера
				// Пропускаем первое ограничение, если пришел result
				Если Ключ <> "function_result" Тогда
					пДополнительныеПараметры.Вставить("ОграничитьРекурсию", Истина);
				КонецЕсли;
				
				Результат.Вставить(Ключ, Логирование_ПолучитьОписаниеПараметров(Значение, пДополнительныеПараметры));
			
			КонецЕсли;
		
		ИначеЕсли ТипЗначения = Тип("Массив")
			ИЛИ ТипЗначения = Тип("ФиксированныйМассив")
			ИЛИ ТипЗначения = Тип("ТаблицаЗначений") 
			ИЛИ ТипЗначения = Тип("СписокЗначений") Тогда
			
			Результат.Вставить(Ключ, Строка(Значение) + "(" + Значение.Количество() + ")");
			
		ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		
			Значение = СокрЛП(Значение);
			ЧислоСтрок = СтрЧислоСтрок(Значение);
			
			Если МаксЧислоСтрок > 0
				И ЧислоСтрок > МаксЧислоСтрок Тогда
				
				НовоеЗначение = СтрПолучитьСтроку(Значение, 1);
				Для Х = 2 По МаксЧислоСтрок Цикл
					НовоеЗначение = НовоеЗначение + Символы.ПС + СтрПолучитьСтроку(Значение, Х);
				КонецЦикла;
				
				Если ЧислоСтрок > МаксЧислоСтрок + 1 Тогда
					Пропущено 	  = ЧислоСтрок - МаксЧислоСтрок - 1;
					НовоеЗначение = НовоеЗначение + Символы.ПС + ГлЯдро_СтрШаблон("... Пропущено %1 строк ...", Пропущено);
					НовоеЗначение = НовоеЗначение + Символы.ПС + СтрПолучитьСтроку(Значение, ЧислоСтрок);
				КонецЕсли;
				
				Значение = НовоеЗначение;
			
			КонецЕсли;
			
			Результат.Вставить(Ключ, Значение);
		
		Иначе
		
			Результат.Вставить(Ключ, Строка(Значение));
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие секретных ключей, значения которых
// маскируются при записи в лог.
//
// Возвращаемое значение:
//  Соответствие - ключи в нижнем регистре, значения Истина.
//
Функция Логирование_ПолучитьСекретныеКлючи()
	
	СекретныеКлючи = Новый Соответствие;
	
	// Вставить имена секретных ключей в формате НРег()
	// !! Значение Истина заполнять обязательно !!
	
	СекретныеКлючи.Вставить("auth_access_token",  Истина);
	СекретныеКлючи.Вставить("auth_refresh_token", Истина);
	СекретныеКлючи.Вставить("access_token", 	  Истина);
	СекретныеКлючи.Вставить("refresh_token", 	  Истина);
	
	Возврат СекретныеКлючи;
	
КонецФункции

// Собирает информацию об окружении для ES-документа: версии SMARTS, 1С,
// ОО, интеграционной обработки, параметры подключения. Секретные ключи маскируются.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура - окружение с полями в формате snake_case для Elasticsearch.
//
Функция Логирование_СобратьОкружение(АдресаПеременных)
	
	ПараметрыОкружения = ГлЯдро_СобратьПараметрыОкружения(АдресаПеременных);
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	
	// Проверка на тип значения
	тС = "Строка";
	тЧ = "Число";
	тБ = "Булево";
	тД = "Дата";
	
	// Строка базы 1С
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	ИнфоБазы1С = Новый Структура;
	ИнфоБазы1С.Вставить("ServerName1C", 		НСтр(СтрокаСоединения, "Srvr"));
	ИнфоБазы1С.Вставить("DatabaseName1C", 		НСтр(СтрокаСоединения, "Ref"));
	ИнфоБазы1С.Вставить("DatabasePath1C", 		НСтр(СтрокаСоединения, "File"));
	ИнфоБазы1С.Вставить("WebDatabasePath1C", 	НСтр(СтрокаСоединения, "ws"));
	
	onec_base_path = ЗначениеСвойства(ИнфоБазы1С, "DatabasePath1C",, тС);
	Если onec_base_path = Неопределено Тогда
		onec_base_path = ЗначениеСвойства(ИнфоБазы1С, "WebDatabasePath1C",, тС);
	КонецЕсли;
	
	// Версия ИО
	ИнформацияСовместимостиИО 	= ГлЯдро_ПолучитьИнформациюСовместимости(АдресаПеременных);
	ИнтеграцияНомерВерсии 		= ЗначениеСвойства(ИнформацияСовместимостиИО, "НомерВерсии",, тС);
	ИнтеграцияДатаВерсии 		= ЗначениеСвойства(ИнформацияСовместимостиИО, "ДатаВерсии",, тД);
	
	Если ИнтеграцияНомерВерсии = Неопределено Тогда
		
		ВерсияИнтеграции = ЗначениеСвойства(ИнформацияСовместимостиИО, "ВерсияИнтеграции",, тС);
		Если ВерсияИнтеграции <> Неопределено Тогда
			
			// Формат: "2.0.0.684 Int, 17.03.2026" → ["2.0.0.684", "Int,", "17.03.2026"]
			ЭлементыВерсии = ГлЯдро_СтрРазделить(ВерсияИнтеграции, " ", Ложь);
			КоличествоЭлементов = ЭлементыВерсии.Количество();
			
			Если КоличествоЭлементов > 0 Тогда
				ИнтеграцияНомерВерсии = ЭлементыВерсии[0];
			КонецЕсли;
			
			Если КоличествоЭлементов > 2 Тогда
				ИнтеграцияДатаВерсии = ЭлементыВерсии[2];
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИнтеграцияНомерВерсии = Неопределено ИЛИ ИнтеграцияДатаВерсии = Неопределено Тогда
			ИнтеграцияНомерВерсии = ВерсияИнтеграции;
			ИнтеграцияДатаВерсии = Неопределено;
		КонецЕсли;
	Иначе
		ИнтеграцияДатаВерсии = Формат(ИнтеграцияДатаВерсии, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	// Версия ОО
	ОсновнаяОбработкаДатаВерсии = ЗначениеСвойства(ПараметрыОкружения, "ОсновнаяОбработкаДатаВерсии", тД);
	Если ОсновнаяОбработкаДатаВерсии <> Неопределено Тогда
		ОсновнаяОбработкаДатаВерсии = Формат(ОсновнаяОбработкаДатаВерсии, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ТипУстановленногоПродукта = ЗначениеСвойства(ПараметрыПодключенияMS, "ТипУстановленногоПродукта",, тС);
	ПредставлениеПродукта = ГлЯдро_ПолучитьПредставлениеПродукта(ТипУстановленногоПродукта);
	
	Окружение = Новый Структура;
	Окружение.Вставить("os_version", ЗначениеСвойства(ПараметрыОкружения, "ВерсияОС",, тС));
	
	// Окружение SMARTS
	Окружение.Вставить("server_version", 				ЗначениеСвойства(ПараметрыОкружения, "ВерсияПлатформыSMARTS",, тС));
	Окружение.Вставить("server_id", 					ЗначениеСвойства(ПараметрыОкружения, "ИдСервераSMARTS",, тС));
	Окружение.Вставить("app_version", 					ЗначениеСвойства(ПараметрыОкружения, "ВерсияПриложения",, тС));
	Окружение.Вставить("app_id", 						ЗначениеСвойства(ПараметрыПодключенияMS, "ИдПриложения",, тС));
	Окружение.Вставить("app_name", 						ЗначениеСвойства(ПараметрыОкружения, "ИмяПриложения",, тС));
	Окружение.Вставить("app_level", 					ЗначениеСвойства(ПараметрыОкружения, "УровеньПриложения",, тС));
	Окружение.Вставить("app_type", 						ПредставлениеПродукта);
	Окружение.Вставить("base_id", 						ЗначениеСвойства(ПараметрыОкружения, "ИдБазыМС",, тС));
	Окружение.Вставить("base_name", 					ЗначениеСвойства(ПараметрыОкружения, "ИмяБазыМС",, тС));
	Окружение.Вставить("base_configuration_version", 	ЗначениеСвойства(ПараметрыОкружения, "ВерсияКонфигурацииSMARTS",, тС));
	Окружение.Вставить("base_connection_string", 		ЗначениеСвойства(ПараметрыОкружения, "СтрокаПодключенияБазыМС",, тС));
	Окружение.Вставить("auth_mode", 					ЗначениеСвойства(ПараметрыПодключенияMS, "АвторизацияТип",, тС));
	Окружение.Вставить("auth_enabled", 					ЗначениеСвойства(ПараметрыПодключенияMS, "АвторизацияВключена",, тБ));
	Окружение.Вставить("auth_access_token", 			ЗначениеСвойства(ПараметрыПодключенияMS, "АвторизацияТокен",, тС));
	Окружение.Вставить("auth_refresh_token", 			ЗначениеСвойства(ПараметрыПодключенияMS, "АвторизацияРефрешТокен",, тС));
	
	// Окружение 1С
	Окружение.Вставить("onec_server_name", 					ЗначениеСвойства(ИнфоБазы1С, "ServerName1C",, тС));
	Окружение.Вставить("onec_base_name", 					ЗначениеСвойства(ИнфоБазы1С, "DatabaseName1C",, тС));
	Окружение.Вставить("onec_base_path", 					onec_base_path);
	Окружение.Вставить("onec_configuration_name", 			ЗначениеСвойства(ПараметрыОкружения, "ИмяКонфигурации1С",, тС));
	Окружение.Вставить("onec_configuration_version", 		ЗначениеСвойства(ПараметрыОкружения, "ВерсияКонфигурации1С",, тС));
	Окружение.Вставить("onec_platform_version", 			ЗначениеСвойства(ПараметрыОкружения, "Платформа1С",, тС));
	Окружение.Вставить("onec_platform_type", 				ЗначениеСвойства(ПараметрыОкружения, "ТипПлатформы1С",, тС));
	Окружение.Вставить("core_version", 						ЗначениеСвойства(ПараметрыОкружения, "ОсновнаяОбработкаНомерВерсии",, тС));
	Окружение.Вставить("core_version_date", 				ОсновнаяОбработкаДатаВерсии);
	Окружение.Вставить("core_rest_api_version", 			ЗначениеСвойства(ПараметрыПодключенияMS, "REST_API_Версия",, тЧ));
	Окружение.Вставить("core_component_location", 			ЗначениеСвойства(ПараметрыОкружения, "РасположениеКомпоненты",, тС));
	Окружение.Вставить("core_interface_type", 				ЗначениеСвойства(ПараметрыОкружения, "ТипИнтерфейса",, тС));
	Окружение.Вставить("core_settings_structure_version", 	ЗначениеСвойства(ПараметрыОкружения, "ВерсияСтруктурыНастроекОбработки",, тС));
	Окружение.Вставить("integration_name", 					ЗначениеСвойства(ПараметрыПодключенияMS, "ИмяИнтеграционнойОбработки",, тС));
	Окружение.Вставить("integration_path", 					ЗначениеСвойства(ПараметрыПодключенияMS, "ПутьИнтеграционноОбработки",, тС));
	Окружение.Вставить("integration_type", 					ЗначениеСвойства(ПараметрыПодключенияMS, "ТипОбработки",, тС));
	Окружение.Вставить("integration_version", 				ИнтеграцияНомерВерсии);
	Окружение.Вставить("integration_version_date", 			ИнтеграцияДатаВерсии);
	
	// Проверка секретных ключей
	СекретныеКлючи = Логирование_ПолучитьСекретныеКлючи();
	Для Каждого КлючЗначение Из Окружение Цикл
		
		Ключ = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		
		Если СекретныеКлючи.Получить(НРег(Ключ)) <> Неопределено Тогда
			
			// Секретные ключи не пишем в логи, только проверяем заполненность
			Попытка
				Заполнено = ЗначениеЗаполнено(Значение);
			Исключение
				Заполнено = Истина;
			КонецПопытки;
			
			Если Заполнено Тогда
				Окружение[Ключ] = "secret_filled";
			Иначе
				Окружение[Ключ] = "secret_null";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Окружение;
	
КонецФункции

// Объединяет серверный и клиентский буферы лог-записей в массив ES-документов.
// Дозаполняет поля сеанса для записей, у которых они не заполнены (клиентские события).
//
// Параметры:
//  ДанныеЛогирования - Структура - данные для сборки документов, свойства:
//   * Поток              - Структура - см. ЛогОткрытьПоток.
//   * БуферЗаписейСервер - Массив - серверный буфер лог-записей.
//   * БуферЗаписейКлиент - Массив - клиентский буфер для слияния.
//                        - Неопределено - используется только серверный буфер.
//   * Окружение          - Структура - см. Логирование_СобратьОкружение.
//   * РежимОтладки       - Строка - режим логирования для поля logging_mode.
//
// Возвращаемое значение:
//  Массив - массив Соответствий, каждое из которых представляет ES-документ.
//
Функция Логирование_СобратьДокументыES(ДанныеЛогирования)
	
	Поток 				= ДанныеЛогирования.Поток;
	БуферЗаписейСервер 	= ДанныеЛогирования.БуферЗаписейСервер;
	БуферЗаписейКлиент 	= ДанныеЛогирования.БуферЗаписейКлиент;
	Окружение 			= ДанныеЛогирования.Окружение;
	РежимОтладки 		= ДанныеЛогирования.РежимОтладки;
	
	КонтекстСеансаСервер 	= Поток.КонтекстСеансаСервер;
	КонтекстСеансаКлиент 	= Поток.КонтекстСеансаКлиент;
	
	БуферЗаписей = БуферЗаписейСервер;
	
	// Объединияем серверные записи с клиентскими
	Если БуферЗаписейКлиент <> Неопределено Тогда
		Для Каждого ЗаписьБуфера Из БуферЗаписейКлиент Цикл
			БуферЗаписей.Добавить(ЗаписьБуфера);
		КонецЦикла;
	КонецЕсли;
	
	ДокументыES = Новый Массив;
	
	Для Каждого ЗаписьБуфера Из БуферЗаписей Цикл
		
		Если ЗаписьБуфера.НомерСеанса = Неопределено Тогда
			// Дозаполняем данные сеанса, если они не заполнены (клиентские события)
			ЗаполнитьЗначенияСвойств(ЗаписьБуфера, КонтекстСеансаСервер);
			Если КонтекстСеансаКлиент <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ЗаписьБуфера, КонтекстСеансаКлиент);
			КонецЕсли;
		КонецЕсли;
		
		ДокументES = Логирование_СобратьДокументES(ЗаписьБуфера, Окружение, Поток, РежимОтладки);
		ДокументыES.Добавить(ДокументES);
		
	КонецЦикла;
	
	Возврат ДокументыES;
	
КонецФункции

// Формирует один ES-документ из лог-записи, окружения и потока.
// Маппит русскоязычные поля записи в snake_case поля Elasticsearch.
//
// Параметры:
//  ЗаписьБуфера - Структура - лог-запись из буфера, см. Логирование_НоваяЗапись.
//  Окружение    - Структура - окружение, см. Логирование_СобратьОкружение.
//  Поток        - Структура - текущий поток, см. ЛогОткрытьПоток.
//  РежимОтладки - Строка - режим логирования для поля logging_mode.
//
// Возвращаемое значение:
//  Соответствие - ES-документ с полями @timestamp, uid, level, event_type и др.
//
Функция Логирование_СобратьДокументES(ЗаписьБуфера, Окружение, Поток, РежимОтладки)
	
	Если ЗаписьБуфера.Уровень = "Ошибка" Тогда
		Уровень = "Error";
	ИначеЕсли ЗаписьБуфера.Уровень = "Предупреждение" Тогда
		Уровень = "Warn";
	Иначе
		Уровень = "Info";
	КонецЕсли;
	
	Контекст = Неопределено;
	Если ЗаписьБуфера.Контекст <> Неопределено Тогда
		Попытка
			Контекст = ГлЯдро_ПолучитьJSON(ЗаписьБуфера.Контекст);
		Исключение
			КонецПопытки;
	КонецЕсли;
	
	// Проверка на тип значения
	тС = "Строка";
	тЧ = "Число";
	тБ = "Булево";
	тД = "Дата";
	
	ДокументES = Новый Соответствие;
	ДокументES.Вставить("@timestamp", 	ЗначениеСвойства(ЗаписьБуфера, "timestamp",, тС));
	ДокументES.Вставить("uid", 			ЗначениеСвойства(ЗаписьБуфера, "uid",, тС));
	ДокументES.Вставить("level", 		Уровень);
	
	// Поля окружения (Соответствие, ключи уже English snake_case)
	Для Каждого КлючЗначение Из Окружение Цикл
		ДокументES.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	// Служебные поля
	ДокументES.Вставить("flow_id", 			ЗначениеСвойства(Поток, "Ид",, тС));
	ДокументES.Вставить("flow_name", 		ЗначениеСвойства(Поток, "Имя",, тС));
	ДокументES.Вставить("parent_flow_id", 	ЗначениеСвойства(Поток, "ИдРодителя",, тС));
	ДокументES.Вставить("event_type", 		ЗначениеСвойства(ЗаписьБуфера, "ТипСобытия",, тС));
	ДокументES.Вставить("parent_id", 		ЗначениеСвойства(ЗаписьБуфера, "ИдРодителя",, тС));
	ДокументES.Вставить("event_id", 		ЗначениеСвойства(ЗаписьБуфера, "ИдСобытия",, тС));
	ДокументES.Вставить("duration_ms", 		ЗначениеСвойства(ЗаписьБуфера, "Длительность",, тЧ));
	ДокументES.Вставить("logging_mode", 	РежимОтладки);
	
	// Контекст события
	ДокументES.Вставить("module", 			ЗначениеСвойства(ЗаписьБуфера, "Модуль",, тС));
	ДокументES.Вставить("message", 			ЗначениеСвойства(ЗаписьБуфера, "Сообщение",, тС));
	ДокументES.Вставить("message_template", ЗначениеСвойства(ЗаписьБуфера, "СообщениеШаблон",, тС));
	ДокументES.Вставить("context", 			Контекст);
	
	// Контекст сеанса
	ДокументES.Вставить("username", 			ЗначениеСвойства(ЗаписьБуфера, "Пользователь",, тС));
	ДокументES.Вставить("directive", 			ЗначениеСвойства(ЗаписьБуфера, "Директива",, тС));
	ДокументES.Вставить("onec_client_type", 	ЗначениеСвойства(ЗаписьБуфера, "ИмяПриложения",, тС));
	ДокументES.Вставить("onec_session_start", 	ЗначениеСвойства(ЗаписьБуфера, "НачалоСеанса",, тД));
	ДокументES.Вставить("onec_session_number", 	ЗначениеСвойства(ЗаписьБуфера, "НомерСеанса",, тЧ));
	ДокументES.Вставить("onec_access_rights", 	ЗначениеСвойства(ЗаписьБуфера, "ДоступныеПрава",, тС));
	ДокументES.Вставить("onec_computer_name", 	ЗначениеСвойства(ЗаписьБуфера, "ИмяКомпьютера",, тС));
	
	// Ошибки
	пОшибка = ЗначениеСвойства(ЗаписьБуфера, "Ошибка");
	ДокументES.Вставить("error_message", 		ЗначениеСвойства(пОшибка, "message",, тС));
	ДокументES.Вставить("error_module", 		ЗначениеСвойства(пОшибка, "module",, тС));
	ДокументES.Вставить("error_line", 			ЗначениеСвойства(пОшибка, "line",, тЧ));
	ДокументES.Вставить("error_source_line", 	ЗначениеСвойства(пОшибка, "source_line",, тС));
	ДокументES.Вставить("error_cause", 			ЗначениеСвойства(пОшибка, "cause",, тС));
	ДокументES.Вставить("error_stack_trace", 	ЗначениеСвойства(пОшибка, "stack_trace",, тС));
	
	// Фоновое задание
	пФЗ = ЗначениеСвойства(ЗаписьБуфера, "ФоновоеЗадание");
	ДокументES.Вставить("background_job_id", ЗначениеСвойства(пФЗ, "УникальныйИдентификатор",, тС));
	ДокументES.Вставить("background_job_name", ЗначениеСвойства(пФЗ, "Наименование",, тС));
	ДокументES.Вставить("background_job_method");
	Если пФЗ <> Неопределено Тогда
		// ФЗ запускается в отдельном потоке, поэтому из имени потока можно получить имя метода ФЗ
		ДокументES.Вставить("background_job_method", ЗначениеСвойства(Поток, "Имя",, тС));
	КонецЕсли;
	
	Возврат ДокументES;
	
КонецФункции

// Отправляет ES-документы в Elasticsearch напрямую или через накопительный буфер SMARTS.
// Выбор транспорта определяется настройкой ЛогРежимОтправкиES.
//
// Параметры:
//  ДокументыES      - Массив - массив Соответствий, см. Логирование_СобратьДокументыES.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина при успешном вызове транспорта.
//
Функция Логирование_ОтправитьДокументы(ДокументыES, АдресаПеременных)
	
	РежимОтправки = Логирование_ПолучитьРежимОтправкиES(АдресаПеременных);
	
	Если РежимОтправки = "Прямой" Тогда
		Логирование_ОтправитьВElasticsearch(ДокументыES, АдресаПеременных);
	Иначе
		Логирование_ОтправитьВSMARTS(ДокументыES, АдресаПеременных);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Отправляет массив ES-документов напрямую в Elasticsearch через Bulk API.
// Формирует NDJSON-тело и выполняет POST на endpoint Cleverence.
//
// Параметры:
//  ДокументыES      - Массив - массив Соответствий с ES-документами.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Булево - Истина, если отправка прошла успешно.
//
Функция Логирование_ОтправитьВElasticsearch(ДокументыES, АдресаПеременных)
	
	Результат = Истина;
	
	Если ДокументыES.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяСобытия 				= "Логирование_ОтправитьВElasticsearch";
	ВсегоДокументов 		= ДокументыES.Количество();
	ОтправленоДокументов 	= 0;
	ПоследняяСтруктураОтвета 	= Неопределено;
	НомерПакета 				= 0;
	НомерПакетаОтказа 			= 0;
	
	Попытка
		
		СтрокаДействия = "{""create"":{}}";
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/x-ndjson");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 				"POST");
		СтруктураЗапроса.Вставить("ВернутьСтруктуру", 		Истина);
		СтруктураЗапроса.Вставить("Заголовки", 				Заголовки);
		СтруктураЗапроса.Вставить("СжиматьJSON", 			Ложь);
		СтруктураЗапроса.Вставить("Метод", 					"maindataprocessors/_bulk");
		СтруктураЗапроса.Вставить("ЗапросКВнешнемуРесурсу", Истина);
		СтруктураЗапроса.Вставить("ТипЗапроса", 			"ОтправитьЛогиВElasticsearch");
		
		СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки("https://elstc.cleverence.ru/send_webpanel_logs");
		
		РазмерПакета = 5000;
		ЭлементовПакета = 0;
		
		ЗаписьNDJSON = Новый ЗаписьJSON;
		ЗаписьNDJSON.УстановитьСтроку();
		
		Для Каждого ДокументES Из ДокументыES Цикл
			
			ЗаписьJSON = Новый ЗаписьJSON;
			ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
			ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
			ЗаписатьJSON(ЗаписьJSON, ДокументES);
			СтрокаДокумента = ЗаписьJSON.Закрыть();
			
			ЗаписьNDJSON.ЗаписатьБезОбработки(СтрокаДействия + Символы.ПС);
			ЗаписьNDJSON.ЗаписатьБезОбработки(СтрокаДокумента + Символы.ПС);
			
			ЭлементовПакета = ЭлементовПакета + 1;
			
			Если ЭлементовПакета >= РазмерПакета Тогда
				
				ТелоNDJSON = ЗаписьNDJSON.Закрыть();
				
				НомерПакета = НомерПакета + 1;
				СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ТелоNDJSON, АдресаПеременных);
				ПоследняяСтруктураОтвета = СтруктураОтвета;
				
				Если НЕ СтруктураОтвета.Статус Тогда
					Результат = Ложь;
					НомерПакетаОтказа = НомерПакета;
					Прервать;
				КонецЕсли;
				
				ОтправленоДокументов = ОтправленоДокументов + РазмерПакета;
				ЭлементовПакета = 0;
				
				ЗаписьNDJSON = Новый ЗаписьJSON;
				ЗаписьNDJSON.УстановитьСтроку();
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Остаток - только если предыдущие пакеты успешны
		Если Результат И ЭлементовПакета > 0 Тогда
			
			ТелоNDJSON = ЗаписьNDJSON.Закрыть();
			
			НомерПакета = НомерПакета + 1;
			СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ТелоNDJSON, АдресаПеременных);
			ПоследняяСтруктураОтвета = СтруктураОтвета;
			
			Если СтруктураОтвета.Статус Тогда
				ОтправленоДокументов = ОтправленоДокументов + ЭлементовПакета;
			Иначе
				Результат = Ложь;
				НомерПакетаОтказа = НомерПакета;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		пОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = ГлЯдро_СтрШаблон("Ошибка отправки логов в Elasticsearch: %1", пОписаниеОшибки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", пСообщение,, АдресаПеременных);
		Результат = Ложь;
		
	КонецПопытки;
	
	Если НЕ Результат Тогда
		ПотеряноДокументов = ВсегоДокументов - ОтправленоДокументов;
		КодСостояния 	= "";
		ТекстОшибки 	= "";
		ПревышенТаймаут = Ложь;
		
		Если ПоследняяСтруктураОтвета <> Неопределено Тогда
			ПоследняяСтруктураОтвета.Свойство("КодСостояния", КодСостояния);
			ПоследняяСтруктураОтвета.Свойство("ТекстОшибки", ТекстОшибки);
			ПоследняяСтруктураОтвета.Свойство("ПревышенТаймаут", ПревышенТаймаут);
		КонецЕсли;
		
		МаксимальнаяДлинаТекстаОшибки = 1000;
		Если СтрДлина(ТекстОшибки) > МаксимальнаяДлинаТекстаОшибки Тогда
			ТекстОшибки = Лев(ТекстОшибки, МаксимальнаяДлинаТекстаОшибки);
		КонецЕсли;
		
		ПотеряноДокументовСтрокой 	= Строка(ПотеряноДокументов);
		ВсегоДокументовСтрокой 		= Строка(ВсегоДокументов);
		РазмерПакетаСтрокой 		= Строка(РазмерПакета);
		НомерПакетаОтказаСтрокой 	= Строка(НомерПакетаОтказа);
		КодСостоянияСтрокой 		= Строка(КодСостояния);
		ПревышенТаймаутСтрокой 		= Строка(ПревышенТаймаут);
		
		пСообщение = "Не удалось отправить логи в Elasticsearch. Потеряно документов: "
			+ ПотеряноДокументовСтрокой + " из " + ВсегоДокументовСтрокой
			+ ". Пакет отказа: " + НомерПакетаОтказаСтрокой
			+ ". Размер пакета: " + РазмерПакетаСтрокой
			+ ". Код состояния: " + КодСостоянияСтрокой
			+ ". Превышен таймаут: " + ПревышенТаймаутСтрокой
			+ ". Ошибка: " + ТекстОшибки;
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование." + ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Отправляет ES-документы в таблицу ОтправляемыеСообщения на сервере SMARTS.
// При неудаче отправки выполняет fallback на прямую отправку в Elasticsearch.
//
// Параметры:
//  ДокументыES      - Массив - массив Соответствий с ES-документами.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Процедура Логирование_ОтправитьВSMARTS(ДокументыES, АдресаПеременных)
	
	ИмяСобытия = "Логирование_ОтправитьВSMARTS";
	
	ДатаВремя = ГлЯдро_ПолучитьTimestamp(); // Пишем все документы с одной датой
	
	ТаблицаДляВыгрузки = Новый Массив;
	Для Каждого ДокументES Из ДокументыES Цикл
		
		СтрокаТаблицы = Новый Структура;
		СтрокаТаблицы.Вставить("ДатаВремя", ДатаВремя);
		СтрокаТаблицы.Вставить("ОтправляемыйJSON", ГлЯдро_ПолучитьJSON(ДокументES));
		
		ТаблицаДляВыгрузки.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	УдалосьОтправить = Истина;
	
	Попытка
		РезультатВыгрузки = ГлЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS("ОтправляемыеСообщения", ТаблицаДляВыгрузки, "Основная", АдресаПеременных);
		Если НЕ РезультатВыгрузки.Статус Тогда
			УдалосьОтправить = Ложь;
		КонецЕсли;
	Исключение
		
		пОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = ГлЯдро_СтрШаблон("Ошибка отправки логов в SMARTS: %1", пОписаниеОшибки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", пСообщение,, АдресаПеременных);
		
		УдалосьОтправить = Ложь;
		
	КонецПопытки;
	
	Если УдалосьОтправить Тогда
		// Сохраняем дату последнего сообщения для управления режимом отправки в ES
		ID_ТекущейБазы = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
		КлючTimestamp = "Cleverence_Логирование_ПоследнееОтправляемоеСообщение_" + ID_ТекущейБазы;
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючTimestamp, ДатаВремя, Истина);
	Иначе
		Логирование_ОтправитьВElasticsearch(ДокументыES, АдресаПеременных);
	КонецЕсли;
	
КонецПроцедуры

// Получает записи из таблицы ОтправляемыеСообщения на сервере SMARTS через REST API.
// Фильтрует по timestamp и сортирует по возрастанию, ограничивая выборку размером батча.
//
// Параметры:
//  ПоследнийTimestamp - Строка - timestamp последней обработанной записи для фильтрации.
//  ИмяПоляДатаВремя  - Строка - транслитерированное имя поля даты в таблице SMARTS.
//  РазмерБатча       - Число - максимальное количество записей в выборке.
//  АдресаПеременных  - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Массив - массив записей из таблицы SMARTS.
//  Неопределено - ошибка подключения или чтения данных.
//
Функция Логирование_ПолучитьОтправляемыеСообщенияSMARTS(ПоследнийTimestamp, ИмяПоляДатаВремя, РазмерБатча, АдресаПеременных)
	
	Результат = Неопределено;
	
	ИмяСобытия = "Логирование_ПолучитьОтправляемыеСообщенияSMARTS";
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS", АдресаПеременных);
	
	ЕстьПодключение = СтруктураПодключенияMS <> Неопределено И СтруктураПодключенияMS <> Ложь;
	
	Если НЕ ЕстьПодключение Тогда
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка",
			"Не удалось получить параметры подключения к серверу SMARTS",, АдресаПеременных);
		Возврат Результат;
		
	КонецЕсли;
	
	ИмяТаблицы = ГлЯдро_СтрокуВТранслитENG("ОтправляемыеСообщения");
	
	ПутьМетода = ГлЯдро_СтрШаблон("Tables/%1", ИмяТаблицы);
	
	ПараметрыOData = ГлЯдро_СтрШаблон("$orderby=%1 asc&$top=%2", ИмяПоляДатаВремя, Формат(РазмерБатча, "ЧГ="));
	
	ПоследнийTimestamp = Неопределено; // Фильтр по дате не нужен, т.к пакет сообщений сразу удаляется
	ЕстьФильтр = ПоследнийTimestamp <> Неопределено И ЗначениеЗаполнено(ПоследнийTimestamp);
	
	Если ЕстьФильтр Тогда
		ПараметрыOData = ГлЯдро_СтрШаблон("$filter=%1 gt '%2'&%3", ИмяПоляДатаВремя, СтрЗаменить(ПоследнийTimestamp, "+", "%2B"), ПараметрыOData);
	КонецЕсли;
	
	ПолныйПуть = ГлЯдро_СтрШаблон("%1?%2", ПутьМетода, ПараметрыOData);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 			"GET");
	СтруктураЗапроса.Вставить("Метод", 				ПолныйПуть);
	СтруктураЗапроса.Вставить("ВернутьСтруктуру", 	Истина);
	
	РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
	
	КодУспешен = РезультатОтвет.Свойство("КодСостояния") И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
	
	Если НЕ КодУспешен Тогда
		
		пТекстОшибки = "";
		РезультатОтвет.Свойство("ТекстОшибки", пТекстОшибки);
		пСообщение = ГлЯдро_СтрШаблон("Ошибка чтения таблицы %1: %2", ИмяТаблицы, пТекстОшибки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", пСообщение,, АдресаПеременных);
		Возврат Результат;
		
	КонецЕсли;
	
	ОтветСервера = Неопределено;
	РезультатОтвет.Свойство("ОтветСервера", ОтветСервера);
	
	Если ТипЗнч(ОтветСервера) = Тип("Структура")
		И ОтветСервера.Свойство("value")
		И ТипЗнч(ОтветСервера.value) = Тип("Массив") Тогда
		
		Результат = ОтветСервера.value;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует записи из таблицы SMARTS в массив ES-документов.
// Извлекает JSON из каждой записи и определяет новый timestamp.
//
// Параметры:
//  ЗаписиБуфера      - Массив - записи из таблицы ОтправляемыеСообщения SMARTS.
//  ИмяПоляJSON       - Строка - транслитерированное имя поля с JSON в таблице SMARTS.
//  ИмяПоляДатаВремя  - Строка - транслитерированное имя поля даты в таблице SMARTS.
//  ПоследнийTimestamp - Строка - предыдущий timestamp для обновления.
//
// Возвращаемое значение:
//  Структура - результат обработки:
//   * ДокументыES    - Массив - массив десериализованных ES-документов.
//   * НовыйTimestamp - Строка - timestamp последней обработанной записи.
//
Функция Логирование_ОбработатьОтправляемыеСообщенияSMARTS(ЗаписиБуфера, ИмяПоляJSON, ИмяПоляДатаВремя, ПоследнийTimestamp)
	
	ДокументыES = Новый Массив;
	НовыйTimestamp = ПоследнийTimestamp;
	
	Для Каждого ЗаписьБуфера Из ЗаписиБуфера Цикл
		
		СтрокаJSON = ЗначениеСвойства(ЗаписьБуфера, ИмяПоляJSON);
		
		Если НЕ ЗначениеЗаполнено(СтрокаJSON) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументES = ГлЯдро_ЗагрузитьИзJSON(СтрокаJSON);
		
		Если ДокументES = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументыES.Добавить(ДокументES);
		
		ТекущийTimestamp = ЗначениеСвойства(ЗаписьБуфера, ИмяПоляДатаВремя);
		
		Если ЗначениеЗаполнено(ТекущийTimestamp) Тогда
			НовыйTimestamp = ТекущийTimestamp;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументыES", ДокументыES);
	Результат.Вставить("НовыйTimestamp", НовыйTimestamp);
	
	Возврат Результат;
	
КонецФункции

// Удаляет записи из таблицы ОтправляемыеСообщения на сервере SMARTS после успешной
// отправки в Elasticsearch. Удаление поштучное через REST API DELETE по uid каждой записи.
// При ошибке удаления отдельной записи продолжает удаление остальных.
//
// Параметры:
//  ЗаписиБуфера     - Массив - записи из таблицы SMARTS, содержащие поле uid.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Число - количество успешно удалённых записей.
//
Функция Логирование_УдалитьОтправленныеСообщенияSMARTS(ЗаписиБуфера, АдресаПеременных)
	
	Результат = 0;
	
	ИмяСобытия = "Логирование_УдалитьОтправленныеСообщенияSMARTS";
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS", АдресаПеременных);
	
	ЕстьПодключение = СтруктураПодключенияMS <> Неопределено И СтруктураПодключенияMS <> Ложь;
	
	Если ЕстьПодключение Тогда
		
		ИмяТаблицы = ГлЯдро_СтрокуВТранслитENG("ОтправляемыеСообщения");
		КоличествоОшибок = 0;
		
		Для Каждого ЗаписьБуфера Из ЗаписиБуфера Цикл
			
			ИдЗаписи = ЗначениеСвойства(ЗаписьБуфера, "uid");
			
			Если НЕ ЗначениеЗаполнено(ИдЗаписи) Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьМетода = ГлЯдро_СтрШаблон("Tables/%1('%2')", ИмяТаблицы, ИдЗаписи);
			
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", "DELETE");
			СтруктураЗапроса.Вставить("Метод", ПутьМетода);
			
			РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
			
			КодУспешен = РезультатОтвет.Свойство("КодСостояния") И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
			
			Если КодУспешен Тогда
				Результат = Результат + 1;
			Иначе
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоОшибок > 0 Тогда
			
			пСообщение = ГлЯдро_СтрШаблон("Не удалось удалить %1 из %2 записей из таблицы %3",
				КоличествоОшибок, ЗаписиБуфера.Количество(), ИмяТаблицы);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

Функция ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных)
	
	Перем ЯзыкПлатформыMS;
	
	ЯзыкПлатформыMS = КомЯдро_ПолучитьЗначениеПеременной("ЯзыкПлатформыMS", АдресаПеременных);
	
	Если ЗначениеЗаполнено(ЯзыкПлатформыMS) Тогда
		Возврат ЯзыкПлатформыMS;
	КонецЕсли;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") Тогда
		СтруктураМетаданных.Свойство("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЯзыкПлатформыMS) Тогда
		КомЯдро_СохранитьЗначениеПеременной("ЯзыкПлатформыMS", ЯзыкПлатформыMS, АдресаПеременных);
		
		Возврат ЯзыкПлатформыMS;
	КонецЕсли;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMSПоСтруктуреБазы(, АдресаПеременных);
	
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") Тогда
		СтруктураМетаданных.Вставить("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
		
		КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных", СтруктураМетаданных, АдресаПеременных);
	КонецЕсли;
	
	Возврат ЯзыкПлатформыMS;
	
КонецФункции

Функция ГлЯдро_ЯзыкПлатформыMSПоСтруктуреБазы(ТипБазы = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ЯзыкПлатформыMSПоСтруктуреБазы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = Неопределено Тогда
		ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза", АдресаПеременных);
		
		ТипБазы = ?(ЕстьЧастнаяБаза = Истина, "Частная", "Основная");
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат "RU";
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"DocTypes?$select=uni&$filter=uni eq 'Settings'");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		DocumentTypes = Неопределено;
	Иначе
		DocumentTypes = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	Если DocumentTypes <> Неопределено И DocumentTypes.Количество() = 1 Тогда
		ЯзыкПлатформыMS = "EN";
	Иначе
		ЯзыкПлатформыMS = "RU";
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ЯзыкПлатформыMS", ЯзыкПлатформыMS, АдресаПеременных);
				
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЯзыкПлатформыMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ЯзыкПлатформыMS;
	
КонецФункции

Функция ГлЯдро_ЭтоENGКонфигурация() Экспорт
	Возврат ГлЯдро_ОбщийМодульСуществует("StandardSubsystemsServer");
КонецФункции

// Возвращает значения предопределенных параметров
//
// Параметры:
//   Ключ - Строка, Массив, Структура - имена ключей, через запятую или массивом.
//
// Возвращаемое значение:
//   Структура - Ключом является имя предопределенного значения, при запросе списком
//   Произвольное значение - При запросе одного параметра
//
// Пример:
// СписокОбязательныхПолейДокументаMS = ГлЯдро_ПредопределенноеЗначение("СписокОбязательныхПолейДокументаMS");
//
Функция ГлЯдро_ПредопределенныеЗначения(Группа = "Общее", Знач Ключи = Неопределено, АдресаПеременных) Экспорт
	
	Если Ключи = Неопределено Тогда
		Если Группа = "ВычисляемыеПоляШапкиДокументаMS" Тогда
			Ключи = "СтрокиПланКоличество,СтрокиФактКоличество,Состояние";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Ключи) = Тип("Строка") Тогда
		МассивКлючей = ГлЯдро_СтрРазделить(Ключи, ",", Ложь);
	ИначеЕсли ТипЗнч(Ключи) = Тип("Массив") Тогда
		МассивКлючей = Ключи;
	КонецЕсли;
	
	Значения = Новый Структура;

	Для каждого Ключ Из МассивКлючей Цикл
		Значения.Вставить(Ключ, ГлЯдро_ПредопределенноеЗначение(Группа, Ключ, АдресаПеременных));
	КонецЦикла;
	
	Если ТипЗнч(Ключи) = Тип("Строка") и МассивКлючей.Количество() = 1 Тогда
		Возврат Значения[Ключи];
	Иначе
		Возврат Значения;
	КонецЕсли;
	
КонецФункции

