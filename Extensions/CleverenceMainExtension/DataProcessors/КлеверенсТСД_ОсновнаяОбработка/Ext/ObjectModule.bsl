				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
				// </Лог>
					
				ТекстОшибки = НСтр("ru = 'Критическая ошибка при выполнении обработчика <%1>. Причина: %2';
									|en = 'Critical error when executing the handler <%1>. Reason: %2';
									|be = 'Крытычная памылка пры выкананні апрацоўшчыка < %1>. Прычына: %2'; es = 'Error crítico al ejecutar el controlador <%1>. Causa: %2'; ka = 'კრიტიკული შეცდომა დამმუშავებლის <%1>შესრულებისას. მიზეზი: %2'; kk = 'Өңдегішті орындау кезінде маңызды қате <%1>. Себебі: %2'; ro = 'Eroare critică la executarea manipulatorului <%1>. Motiv: %2'; tr = 'işleyicinin yürütülmesinde kritik hata <%1>. Sebep: %2'; uk = 'Критична помилка при виконанні обробника <%1>. Причина: %2'; uz = 'Ishlov beruvchini bajarishda muhim xato <%1>. Sababi: %2'");
				ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ОбработчикВыгрузки, КритическаяОшибкаОписание);
				
				Если ДанныеДокумента.Свойство("СообщениеОбОшибках") И ДанныеДокумента.СообщениеОбОшибках <> "" Тогда
