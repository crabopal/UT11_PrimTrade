	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);

	// см. ГлЯдро_ВыгрузитьНоменклатуруИзДокумента(	
	НоменклатураДляВыгрузки = ГлЯдро_ПолучитьДанныеНоменклатурыИзДокументаДляВыгрузки(Документ1С, НастройкаБП,, АдресаПеременных);
	
	Если НоменклатураДляВыгрузки <> Неопределено Тогда
		
		ИмяПоляProduct 	= ?(ВерсияAPI = 1, "Product", "InventoryItem");
		ИмяПоляPacking	= ?(ВерсияAPI = 1, "Packing", "UnitOfMeasure");
		
		IndexProductId 	 = НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляProduct + ".Id");
		IndexPackingId 	 = НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляPacking + ".Id");
		IndexAttributeId = НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляPacking + ".ИдХарактеристики");
		IndexSeriesId 	 = НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляPacking + ".ИдСерии");
		
		Если IndexProductId = Неопределено ИЛИ IndexPackingId = Неопределено Тогда
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
			// </Лог>
			
			Возврат; // Невозможно сопоставить номенклатуру в плановых строках документа и номенклатуру для выгрузки
		КонецЕсли;
			
