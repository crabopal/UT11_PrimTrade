Процедура ГлЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(ПараметрыПодключенияMS = Неопределено, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS",
		ПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	Если ВерсияAPI < 2 Тогда
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		Возврат;
	КонецЕсли;
	
	АдресДвоичныхДанных = ГлЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию(ПараметрыПодключенияMS, АдресаПеременных);
		
	Если АдресДвоичныхДанных = Неопределено Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось загрузить файл 1CConfigs.xml для определения настроек по умолчанию'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	НастройкиПоУмолчаниюСтруктура = ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчанию(АдресДвоичныхДанных, АдресаПеременных);
	Если НастройкиПоУмолчаниюСтруктура = Неопределено Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось определить настройки по умолчанию из файла 1CConfigs.xml'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод",	"POST");
	СтруктураЗапроса.Вставить("Метод",		"api/internal/CustomSettings/ApplyDefaultFile");
	СтруктураЗапроса.Вставить("ТипЗапроса",	"ПоУмолчанию");
	СтруктураЗапроса.Вставить("ВерсияAPI",	"");
	
	ОтправляемыеДанные = Новый Соответствие;
	ОтправляемыеДанные.Вставить("relativePath", НастройкиПоУмолчаниюСтруктура.НастройкиПуть + "\" + НастройкиПоУмолчаниюСтруктура.НастройкиИмя);
	ОтправляемыеДанные.Вставить("destinationFileName", "CustomSettings.dflt.xml");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(ПараметрыПодключенияMS, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ГлЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS(ПараметрыПодключенияMS, АдресаПеременных);
	
КонецПроцедуры

Функция ГлЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию(пПараметрыПодключенияMS, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыПодключенияMS",
		пПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("ПутьКФайлу", "DataProcessors/");
	ПараметрыФайла.Вставить("ИмяФайла",	  "1CConfigs.xml");
	
	АдресДвоичныхДанных = ГлЯдро_ЗагрузитьФайлИзБазыSMARTS(пПараметрыПодключенияMS, ПараметрыФайла, "REST_API", АдресаПеременных);
	
	Если НЕ ЭтоАдресВременногоХранилища(АдресДвоичныхДанных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресДвоичныхДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АдресДвоичныхДанных;
	
КонецФункции

Функция ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчанию(АдресДвоичныхДанных, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"АдресДвоичныхДанных",
		АдресДвоичныхДанных);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыКонфигурации = ГлЯдро_ИнициализацияНастроек_ПараметрыКонфигурации(АдресаПеременных);
	
	НастройкиПоУмолчаниюСтруктура = ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчаниюИзФайла(АдресДвоичныхДанных,
		ПараметрыКонфигурации, АдресаПеременных);
	
	Если НЕ НастройкиПоУмолчаниюСтруктура = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиПоУмолчаниюСтруктура);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат НастройкиПоУмолчаниюСтруктура;
	КонецЕсли;		
			
	// <Лог>
	ЯзСтрока = "ru = 'Не удалось подобрать настройки по умолчанию для текущей конфигурации'";
	пСообщение = НСтр(ЯзСтрока);
	
	ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
	// </Лог>
	
	КонфигурацияПоМетаданным = ГлЯдро_ИнициализацияНастроек_ОпределитьКонфигурациюПоМетаданным(АдресаПеременных);
	Если КонфигурацияПоМетаданным = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыКонфигурации = Новый Структура;
	ПараметрыКонфигурации.Вставить("КонфигурацияИмя", 	 КонфигурацияПоМетаданным.OneCConfigName);
	ПараметрыКонфигурации.Вставить("КонфигурацияВерсия", КонфигурацияПоМетаданным.OneCConfigVersion);
	
	НастройкиПоУмолчаниюСтруктура = ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчаниюИзФайла(АдресДвоичныхДанных,
		ПараметрыКонфигурации, АдресаПеременных);
	
	Если НЕ НастройкиПоУмолчаниюСтруктура = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиПоУмолчаниюСтруктура);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат НастройкиПоУмолчаниюСтруктура;
	КонецЕсли;		
		
	// <Лог>
	ЯзСтрока = "ru = 'Не удалось подобрать настройки по умолчанию для конфигурации, определенной по метаданным'";
	пСообщение = НСтр(ЯзСтрока);
	
	ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Неопределено;
	
КонецФункции

Функция ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчаниюИзФайла(АдресДвоичныхДанных, ПараметрыКонфигурации, АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ОпределитьНастройкиПоУмолчаниюИзФайла";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"АдресДвоичныхДанных,ПараметрыКонфигурации",
		АдресДвоичныхДанных, ПараметрыКонфигурации);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
	
	ТекущаяКонфигурацияИмя 	  = ПараметрыКонфигурации.КонфигурацияИмя;
	ТекущаяКонфигурацияВерсия = ПараметрыКонфигурации.КонфигурацияВерсия;
	ТекущаяКонфигурацииЧислом = ГлЯдро_ПолучитьВерсиюКонфигурацииЧислом(ТекущаяКонфигурацияВерсия);
	
	пСообщение = НСтр("ru = 'Имя конфигурации: %1, Версия конфигурации: %2, Версия конфигурации (числом): %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение,
		Строка(ТекущаяКонфигурацияИмя), Строка(ТекущаяКонфигурацияВерсия), Строка(ТекущаяКонфигурацииЧислом));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, НачалоСобытия, АдресаПеременных);
	
	///////////////////////////////////////////////////
	
	ДД = ПолучитьИзВременногоХранилища(АдресДвоичныхДанных);
	
	Поток = ДД.ОткрытьПотокДляЧтения();
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПодобранноеИмя 	= "";
	ПодобранныйПуть = "";
	ПодобраннаяВерсияЧислом = 0;
	
	ПроверенныеКонфигурации = Новый Массив;
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если НЕ ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ВРЕГ(ЧтениеXML.Имя) = ВРЕГ("CONFIG") Тогда
			Продолжить;
		КонецЕсли;
			
		КонфигурацияВерсия	= "";
		НастройкиИмя 		= "";
		НастройкиПуть 		= "";		
		НастройкаПодходит 	= Истина;
		
		Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
			Если ВРЕГ(ЧтениеXML.Имя) = ВРЕГ("ONECCONFIGNAME") Тогда
				КонфигурацияИмя = ЧтениеXML.Значение;
				Если НЕ Нрег(КонфигурацияИмя) = ТекущаяКонфигурацияИмя Тогда
					НастройкаПодходит = Ложь;
					Прервать;					
				КонецЕсли;
			ИначеЕсли ВРЕГ(ЧтениеXML.Имя) = ВРЕГ("SETTINGSFILEONECCONFIGVERSION") Тогда
				КонфигурацияВерсия = ЧтениеXML.Значение;
				
				ВерсияКонфигурацииЧислом = ГлЯдро_ПолучитьВерсиюКонфигурацииЧислом(КонфигурацияВерсия);
				Если ТекущаяКонфигурацииЧислом < ВерсияКонфигурацииЧислом Тогда
					НастройкаПодходит = Ложь;
					Прервать;
				КонецЕсли;
				
				// Версия 1.6.25 приоритетнее версии 1.6
				Если ПодобраннаяВерсияЧислом >= ВерсияКонфигурацииЧислом Тогда
					НастройкаПодходит = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ВРЕГ(ЧтениеXML.Имя) = ВРЕГ("SETTINGSFILE") Тогда
				НастройкиИмя = ЧтениеXML.Значение;
			ИначеЕсли ВРЕГ(ЧтениеXML.Имя) = ВРЕГ("SETTINGSFILEFOLDER") Тогда
				НастройкиПуть = ЧтениеXML.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Успех = НастройкаПодходит И НЕ ПустаяСтрока(КонфигурацияИмя);
		
		СтрокаКонфигурация = "";
		Если НЕ ПустаяСтрока(КонфигурацияИмя) Тогда
			СтрокаКонфигурация = ГлЯдро_СтрШаблон("OneCConfigName: %1", КонфигурацияИмя);
		КонецЕсли;
		Если НЕ ПустаяСтрока(КонфигурацияВерсия) Тогда
			СтрокаКонфигурация = СтрокаКонфигурация + ?(ПустаяСтрока(СтрокаКонфигурация), "", " ")
				+ ГлЯдро_СтрШаблон("SettingsFileOneCConfigVersion: %1", КонфигурацияВерсия);
		КонецЕсли;
		Если Успех Тогда
			СтрокаКонфигурация = СтрокаКонфигурация + " (success)"
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаКонфигурация) Тогда
			ПроверенныеКонфигурации.Добавить(СтрокаКонфигурация);
		КонецЕсли;
		
		Если Успех Тогда
			ПодобранноеИмя  = НастройкиИмя;
			ПодобранныйПуть = НастройкиПуть;
			ПодобраннаяВерсияЧислом = ВерсияКонфигурацииЧислом; 
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();	
	
	///////////////////////////////////////////////////
	
	пСообщение = НСтр("ru = 'Проверенные конфигурации: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ГлЯдро_СтрСоединить(ПроверенныеКонфигурации, "; "));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, НачалоСобытия, АдресаПеременных);
	
	Если НЕ ПустаяСтрока(ПодобранноеИмя)
		И ПустаяСтрока(ПодобранныйПуть) Тогда
		// На случай, если запустили 1.6.3 на 4 платформе. В 1.6.3 отсутствует атрибут SETTINGSFILEFOLDER.
		ПодобранныйПуть = "DataProcessors\Настройки по-умолчанию";
	КонецЕсли;
	
	Если ПустаяСтрока(ПодобранноеИмя)
		ИЛИ ПустаяСтрока(ПодобранныйПуть) Тогда
		пСообщение = НСтр("ru = 'Настройка не определена'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НастройкиИмя",  ПодобранноеИмя);
	Результат.Вставить("НастройкиПуть", ПодобранныйПуть);
	
	пСообщение = НСтр("ru = 'Настройка определена (SettingsFile: %1, SettingsFileFolder: %2)'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ПодобранноеИмя, ПодобранныйПуть);
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, НачалоСобытия, АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ИнициализацияНастроек_ПараметрыКонфигурации(АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ПараметрыКонфигурации";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	КонфигурацияИмя = НРег(Метаданные.Имя);
	КонфигурацияВерсия = Метаданные.Версия;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("КонфигурацияИмя", 	КонфигурацияИмя);
	СтруктураРезультата.Вставить("КонфигурацияВерсия", 	КонфигурацияВерсия);
	
	ЧастиВерсии = ГлЯдро_СтрРазделить(КонфигурацияВерсия, ".");
	
	Попытка
		ДополнительныеКонфигурации = ГлЯдро_ИнициализацияНастроек_ДополнительныеКонфигурации();
		
		// При необходимости можно предусмотреть разные условия поиска
		ДанныеКонфигурации = ДополнительныеКонфигурации.Получить(КонфигурацияИмя + "|" + ЧастиВерсии[0] + "." + ЧастиВерсии[1]);
		Если НЕ ДанныеКонфигурации = Неопределено Тогда
			СтруктураРезультата.Вставить("КонфигурацияИмя", 	ДанныеКонфигурации.КонфигурацияИмя);
			СтруктураРезультата.Вставить("КонфигурацияВерсия", 	ДанныеКонфигурации.КонфигурацияВерсия + "." + ЧастиВерсии[2] + "." + ЧастиВерсии[3]);
		КонецЕсли;
	Исключение
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
	КонецПопытки;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураРезультата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция ГлЯдро_ИнициализацияНастроек_ДополнительныеКонфигурации()
	
	ДополнительныеКонфигурации = Новый Соответствие;
	ДополнительныеКонфигурации.Вставить("управлениемясоперерабатывающимпредприятием|2.4",	Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениепредприятием", "2.4"));
	ДополнительныеКонфигурации.Вставить("управлениемясоперерабатывающимпредприятием|2.5",	Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениепредприятием", "2.5"));
	ДополнительныеКонфигурации.Вставить("агропромышленныйкомплекс|2.5",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениепредприятием", "2.5"));
	ДополнительныеКонфигурации.Вставить("управлениехолдингомerp|3.2",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениепредприятием", "2.5"));
	ДополнительныеКонфигурации.Вставить("управлениеторговлей_crm|3.1",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениеторговлей", "11.5"));
	ДополнительныеКонфигурации.Вставить("kt2000_alcohol_trade|11.4",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениеторговлей", "11.4"));
	ДополнительныеКонфигурации.Вставить("kt2000_alcohol_trade|11.5",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениеторговлей", "11.5"));
	ДополнительныеКонфигурации.Вставить("управлениенашейфирмой|1.6",						Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "управлениенебольшойфирмой", "1.6"));
	ДополнительныеКонфигурации.Вставить("штрихмторговоепредприятие7|7.0",					Новый Структура("КонфигурацияИмя, КонфигурацияВерсия", "торговоепредприятие7", "7.0"));
	
	Возврат ДополнительныеКонфигурации;
	
КонецФункции

// Определяет подходящую конфигурацию по наличию характерных объектов метаданных.
//
// Возвращаемое значение:
//  Структура:
//   - OneCConfigName - Строка - имя конфигурации для сопоставления с 1CConfigs.xml
//   - OneCConfigVersion - Строка - версия конфигурации для сопоставления с 1CConfigs.xml
//  Неопределено - если конфигурация не определена.
//
// Параметры:
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
Функция ГлЯдро_ИнициализацияНастроек_ОпределитьКонфигурациюПоМетаданным(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ОпределитьКонфигурациюПоМетаданным";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, определение конфигурации по метаданным'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	НаборыКонфигураций = Новый Массив;
	ПроверенныеКонфигурации = Новый Массив;
	
	Объекты = Новый Массив;
	Объекты.Добавить("Обработка.ПанельАдминистрированияУТ");
	Объекты.Добавить("ОбщийМодуль.ОбщегоНазначенияУТ");
	Объекты.Добавить("ОбщийМодуль.ОбновлениеИнформационнойБазыУТ");
	Объекты.Добавить("Документ.ПриобретениеТоваровУслуг");
	Объекты.Добавить("Документ.РеализацияТоваровУслуг");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"УправлениеТорговлей", "11.5", Объекты));
	
	Объекты = Новый Массив;
	Объекты.Добавить("ОбщийМодуль.ДокументыУНФ");
	Объекты.Добавить("ОбщийМодуль.ОбщегоНазначенияУНФ");
	Объекты.Добавить("ОбщийМодуль.ОбновлениеИнформационнойБазыУНФ");
	Объекты.Добавить("Документ.ПриходнаяНакладная");
	Объекты.Добавить("Документ.РасходнаяНакладная");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"УправлениеНебольшойФирмой", "3.0", Объекты));
	
	Объекты = Новый Массив;
	Объекты.Добавить("ПланСчетов.Хозрасчетный");
	Объекты.Добавить("ОбщийМодуль.ОбщегоНазначенияБП");
	Объекты.Добавить("ОбщийМодуль.ОбновлениеИнформационнойБазыБП");
	Объекты.Добавить("Документ.ПоступлениеТоваровУслуг");
	Объекты.Добавить("Документ.РеализацияТоваровУслуг");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"БухгалтерияПредприятия", "3.0", Объекты));
	
	Объекты = Новый Массив;
	Объекты.Добавить("ОбщийМодуль.МенеджерОборудованияУТ");
	Объекты.Добавить("ОбщийМодуль.ПроцедурыОбменаУТУПП");
	Объекты.Добавить("Документ.ПоступлениеТоваровУслуг");
	Объекты.Добавить("Документ.РеализацияТоваровУслуг");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"УправлениеТорговлей", "10.3", Объекты));
	
	Объекты = Новый Массив;
	Объекты.Добавить("Справочник.ККМ");
	Объекты.Добавить("Константа.ВедениеТовароучетаНаККМ");
	Объекты.Добавить("Документ.ДокументККМ");
	Объекты.Добавить("Документ.ПриходнаяНакладная");
	Объекты.Добавить("Документ.РасходнаяНакладная");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"ТорговоеПредприятие7", "7.0", Объекты));
	
	Объекты = Новый Массив;
	Объекты.Добавить("Справочник.Автомобили");
	Объекты.Добавить("Документ.ПоступлениеАвтомобилей");
	Объекты.Добавить("Документ.РеализацияАвтомобилей");
	Объекты.Добавить("Документ.ПоступлениеТоваров");
	Объекты.Добавить("Документ.РеализацияТоваров");
	НаборыКонфигураций.Добавить(Новый Структура("OneCConfigName,OneCConfigVersion,Объекты",
		"Автосалон6", "6.1", Объекты));
	
	Для Каждого Набор Из НаборыКонфигураций Цикл
		
		ПровереннаяКонфигурация = ГлЯдро_СтрШаблон("%1 (%2)", Набор.OneCConfigName, Набор.OneCConfigVersion);
		ПроверенныеКонфигурации.Добавить(ПровереннаяКонфигурация);
		
		пСообщение = НСтр("ru = 'Проверяем конфигурацию: OneCConfigName=%1, OneCConfigVersion=%2'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Набор.OneCConfigName, Набор.OneCConfigVersion);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		Подходит = Истина;
		
		Для каждого ПолноеИмя Из Набор.Объекты Цикл
			
			ОбъектСуществует = ГлЯдро_ПроверитьОбъектМетаданныхСуществует(ПолноеИмя, АдресаПеременных);
			
			пСообщение = НСтр("ru = 'Проверяем объект метаданных: %1 (%2)'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ПолноеИмя, ?(ОбъектСуществует, "есть", "нет"));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			Если НЕ ОбъектСуществует Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Подходит Тогда
			Результат = Новый Структура;
			Результат.Вставить("OneCConfigName", 	НРег(Набор.OneCConfigName));
			Результат.Вставить("OneCConfigVersion", Набор.OneCConfigVersion);
			
			пСообщение = НСтр("ru = 'Конец, конфигурация определена: OneCConfigName=%1, OneCConfigVersion=%2'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Набор.OneCConfigName, Набор.OneCConfigVersion);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	ЯзСтрока 					= "ru = 'Не удалось определить конфигурацию по метаданным. Проверены: %1'";
	прПроверенныеКонфигурации 	= ГлЯдро_СтрСоединить(ПроверенныеКонфигурации, "; ");
	пСообщение 					= ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прПроверенныеКонфигурации);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПроверенныеКонфигурации",
		прПроверенныеКонфигурации);
	ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Неопределено;
	
КонецФункции

Функция ГлЯдро_ИнициализацияНастроек_ИзмениласьВерсияКонфигурацииSMARTS(ПараметрыПодключенияMS = Неопределено, АдресаПеременных)

	Перем ИдентификаторБазыMS, ВерсияКонфигурацииMS;
	
	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_ИзмениласьВерсияКонфигурацииSMARTS";
	
	ЗначениеПоУмолчанию = Ложь;
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ПараметрыПодключенияMS.Свойство("Ид", ИдентификаторБазыMS);
	ПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииMS);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS)
		ИЛИ НЕ ЗначениеЗаполнено(ВерсияКонфигурацииMS) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ИмяПеременнойВерсия = "Cleverence_ИнициализацияНастроек_ВерсияКонфигурацииMS_" + ИдентификаторБазыMS;
	
	СохраненнаяВерсияКонфигурацииMS = ГлЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойВерсия);
	Если НЕ ЗначениеЗаполнено(СохраненнаяВерсияКонфигурацииMS)
		ИЛИ НЕ СокрЛП(СохраненнаяВерсияКонфигурацииMS) = СокрЛП(ВерсияКонфигурацииMS) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Процедура ГлЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS(ПараметрыПодключенияMS, АдресаПеременных)

	Перем ИдентификаторБазыMS, ВерсияКонфигурацииMS;
	
	ИмяСобытия = "ГлЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS",
		ПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось сохранить версию конфигурации SMARTS: переданные параметры подключения MS не являются структурой'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключенияMS.Свойство("Ид", ИдентификаторБазыMS);
	ПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииMS);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS)
		ИЛИ НЕ ЗначениеЗаполнено(ВерсияКонфигурацииMS) Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось сохранить версию конфигурации SMARTS: не заполнены идентификатор базы MS или версия конфигурации MS'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ГлЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS,, АдресаПеременных);
	
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнициализацияНастроек_ВерсияКонфигурацииMS_" + ИдентификаторБазыMS, ВерсияКонфигурацииMS);
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиНастроек_" + ИдентификаторБазыMS, ТекущаяДата());
	
	пСообщение = НСтр("ru = 'Сброшена дата актуальности настроек, постфикс базы: %1';
						|en = 'The date of the current settings has been reset, the database postfix is %1';
						|be = 'Скінутая дата актуальнасці налад, постфикс базы: %1'; es = 'Se ha restablecido la fecha de actualización de la configuración, postfix base: %1'; ka = 'მიმდინარე პარამეტრების თარიღი გადატვირთულია, მონაცემთა ბაზის postfix არის %1'; kk = 'Параметрлердің жаңартылған күні, базаның постфиксі қалпына келтірілді: %1'; ro = 'Data setărilor curente a fost resetată, baza de date postfix este %1'; tr = 'Ayarların güncel olduğu tarih sıfırlandı, taban sonrası düzeltme: % 1'; uk = 'Скинута дата актуальності налаштувань, постфікс бази: %1'; uz = 'Sozlamalar yangilangan sana, postfiks bazasi: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ?(ИдентификаторБазыMS = "", "<нет>", ИдентификаторБазыMS));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьВерсиюКонфигурацииЧислом(Знач ВерсияКонфигурации)
	
	ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияКонфигурации, ".");
	
	Версия = "";
	Для Индекс = 0 По ВерсияВМассив.ВГраница() Цикл
		Версия = Версия + ГлЯдро_ДополнитьСтрокуЛидирующимиНулями(ГлЯдро_ОставитьЦифрыВСтроке(ВерсияВМассив[Индекс]), 3);
	КонецЦикла;
	
	Для Индекс = 1 ПО 12 - СтрДлина(Версия) Цикл
		Версия = Версия + "0";
	КонецЦикла;

	Возврат Число(Версия);
	
КонецФункции

#КонецОбласти

#Область ОбновлениеКомпонент

Функция ГлЯдро_ОбновлениеКомпонент_ПолучитьПараметрыПодключенияКомпонент(ПараметрыВыполнения, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновлениеКомпонент_ПолучитьПараметрыПодключенияКомпонент";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ПараметрыПодключенияMS = ПараметрыВыполнения.ПараметрыПодключенияMS;
	
	// Структура результат
	ПараметрыПодключенияКомпонент = Новый Структура;
	ПараметрыПодключенияКомпонент.Вставить("ПодключаемыеКомпоненты");
	ПараметрыПодключенияКомпонент.Вставить("ПодключаемыеРасширенияСтабильные");
	ПараметрыПодключенияКомпонент.Вставить("СтруктураИменКомпонент");
	ПараметрыПодключенияКомпонент.Вставить("ПостфиксыРасширений");
	ПараметрыПодключенияКомпонент.Вставить("ХешСуммыРасширений");
	ПараметрыПодключенияКомпонент.Вставить("РасширенияИспользуются");
	ПараметрыПодключенияКомпонент.Вставить("ДопОбработкиИспользуются");
	
	// Заполнение переменных для результата
	ПодключаемыеКомпоненты = Новый Соответствие;
	
	РасширенияИспользуются = ГлЯдро_ОпределитьСовместимостьСРасширениями();
	ИмяКонфигурации = ГлЯдро_ПолучитьИмяКонфигурации();
	ЭтоБазоваяВерсия = ГлЯдро_СтрНайти(ВРег(ИмяКонфигурации), "БАЗОВАЯ") <> 0;
	Если ЭтоБазоваяВерсия Тогда
		РасширенияИспользуются = Ложь;
	КонецЕсли;
	
	ДопОбработкиИспользуются = ГлЯдро_ПолучитьИспользованиеДополнительныхОтчетовИОбработок(АдресаПеременных);
	ХешСуммыРасширений = ГлЯдро_ПолучитьИнформациюОПодключенныхРасширениях().ХешСуммыРасширений;
	
	ПостфиксыРасширений	= Новый Структура;
	ПостфиксыРасширений.Вставить("РасширениеSSL",  			 ГлЯдро_ПолучитьПостфиксРасширенияSSL(АдресаПеременных));
	ПостфиксыРасширений.Вставить("ОсновноеРасширение", 		 ГлЯдро_ПолучитьПостфиксРасширенияMain(АдресаПеременных));
	ПостфиксыРасширений.Вставить("ИнтеграционноеРасширение", СтрЗаменить(СтрЗаменить(ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки, "ИнтеграционнаяОбработка", ""), ".epf", ""));
	
	СтруктураИменКомпонент = Новый Структура;
	Если РасширенияИспользуются Тогда	
		СтруктураИменКомпонент = ГлЯдро_ПолучитьСтруктуруИменРасширений();
	ИначеЕсли ДопОбработкиИспользуются Тогда
		// Расширения не используются, но список формируем по именам расширений для единообразия.
		СтруктураИменКомпонент = Новый Структура;
		СтруктураИменКомпонент.Вставить("ОсновноеРасширение", 			"CleverenceMainExtension");
		СтруктураИменКомпонент.Вставить("ИнтеграционноеРасширение", 	"CleverenceIntegrationExtension");
	КонецЕсли;
	
	// Параметры проверки
	ПроверятьАктуальностьВерсии 	= ПараметрыВыполнения.ПроверятьАктуальностьВерсии = Истина;
	ПроверятьАктуальностьПостфикса 	= ПараметрыВыполнения.ПроверятьАктуальностьПостфикса = Истина;
	
	ВерсияПриложенияАктуальная		= ПараметрыВыполнения.ВерсияПриложенияАктуальная;
	ВерсияПриложенияИзНастроек		= ПараметрыВыполнения.ВерсияПриложенияИзНастроек;
	
	ОтключитьОбновление_ОсновнаяОбработка 		= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ОсновнаяОбработка",, АдресаПеременных);
	ОтключитьОбновление_ИнтеграционнаяОбработка = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка",, АдресаПеременных);
	
	ИмяРасширенияSSL = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИмяРасширенияSSL",, АдресаПеременных);
	ИмяРасширенияMain = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИмяРасширенияMain",, АдресаПеременных);
	
	// Формируем список компонент, которые будут подключены: расширения и доп. обработки.
	// Если не удастся подключить расширение или расширения не используются, то будет подключена обработка в доп.обработки.
	Для каждого ЭлементСтруктуры Из СтруктураИменКомпонент Цикл
		
		ТипРасширения	= ЭлементСтруктуры.Ключ;
		ИмяРасширения 	= ЭлементСтруктуры.Значение;
		
		ЭтоРасширениеSSL 			= ТипРасширения = "РасширениеSSL";
		ЭтоОсновноеРасширение 		= ТипРасширения = "ОсновноеРасширение";
		ЭтоИнтеграционноеРасширение = ТипРасширения = "ИнтеграционноеРасширение";
		
		// Проверяем, не отключено ли обновление компонентов в настройках
		Если (ЭтоОсновноеРасширение ИЛИ ЭтоРасширениеSSL) И ОтключитьОбновление_ОсновнаяОбработка = Истина Тогда
			Продолжить;
		ИначеЕсли ЭтоИнтеграционноеРасширение И ОтключитьОбновление_ИнтеграционнаяОбработка = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Если не удалось определить постфикс расширения SSL, подключать его не нужно
		Если ЭтоРасширениеSSL И ПустаяСтрока(ПостфиксыРасширений[ТипРасширения]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяФайлаРасширения = ЭлементСтруктуры.Значение;
		Если ПостфиксыРасширений.Свойство(ТипРасширения) Тогда
			ИмяФайлаРасширения = ИмяФайлаРасширения + ПостфиксыРасширений[ТипРасширения];
		КонецЕсли;
		
		СтруктураКомпоненты = Новый Структура;
		СтруктураКомпоненты.Вставить("ТипРасширения", 			ТипРасширения);
		СтруктураКомпоненты.Вставить("ИмяРасширения", 			ИмяРасширения);
		СтруктураКомпоненты.Вставить("ИмяФайлаРасширения", 		ИмяФайлаРасширения);
		СтруктураКомпоненты.Вставить("РасширениеПодключено", 	Ложь);
		СтруктураКомпоненты.Вставить("СвойстваУстановленногоРасширения");
		
		СтруктураКомпоненты.Вставить("ТипОбработки");
		СтруктураКомпоненты.Вставить("ИмяФайлаОбработки");
		
		Если ДопОбработкиИспользуются Тогда
			
			// Заполняем имена файлов обработок для подключения в доп.обработки
			Если ЭтоОсновноеРасширение Тогда
				
				СтруктураКомпоненты.ТипОбработки = "ОсновнаяОбработка";
				СтруктураКомпоненты.ИмяФайлаОбработки = "КлеверенсТСД_ОсновнаяОбработка.epf";
				
			ИначеЕсли ЭтоИнтеграционноеРасширение Тогда
				
				СтруктураКомпоненты.ТипОбработки = "ИнтеграционнаяОбработка";
				
				ИмяИнтеграционнойОбработки 	= ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
				ИмяИнтеграционнойОбработки 	= ?(Найти(ИмяИнтеграционнойОбработки, ".epf") = 0, ИмяИнтеграционнойОбработки + ".epf", ИмяИнтеграционнойОбработки);
				СтруктураКомпоненты.ИмяФайлаОбработки = ИмяИнтеграционнойОбработки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СвойстваУстановленногоРасширения = ХешСуммыРасширений.Получить(ИмяРасширения);
		Если СвойстваУстановленногоРасширения <> Неопределено Тогда
			СтруктураКомпоненты.Вставить("РасширениеПодключено", Истина);
			СтруктураКомпоненты.Вставить("СвойстваУстановленногоРасширения", СвойстваУстановленногоРасширения);
		КонецЕсли;
		
		// Расширения добавляются/обновляются:
		//	- при первом запуске
		//	- при подключении из окна настроек подключения с изменением версии
		//	- при открытии основной обработки с изменением версии
		//
		// Проверяется актуальность расширений SSL и Main:
		//	- при подключении из окна настроек подключения без изменения версии
		//	- при открытии основной обработки без изменения версии
		
		ПодключитьКомпоненту = Истина;
		Если ПроверятьАктуальностьВерсии Тогда
			
			ПодключитьКомпоненту = Ложь;
			Если РасширенияИспользуются Тогда
				
				// Проверка версии
				ПодключитьКомпоненту = ВерсияПриложенияАктуальная <> ВерсияПриложенияИзНастроек;
				
				// Проверка актуальности постфикса расширений SSL и Main:
				Если НЕ ПодключитьКомпоненту
					//И ПроверятьАктуальностьПостфикса
					И (ЭтоОсновноеРасширение ИЛИ ЭтоРасширениеSSL) Тогда
					
					// Теперь проверяем только наличие настройки версии из настроек. Это значит, что расширение уже было подключено ранее
					// Если настройка есть, то добавляем в массив подключаемых файлов
					ИмяНастройки = "ВерсияРасширения_" + ЭлементСтруктуры.Значение;
					ЗначениеНастройки = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(ИмяНастройки,, АдресаПеременных);
					Если ЗначениеНастройки <> Ложь
						И ЗначениеНастройки <> "0.0.0.0" Тогда
						// Проверяем, под каким именем было подключено расширение, и сравниваем его с актуальным именем
						ТекущееИмяРасширения = ?(ЭтоРасширениеSSL, ИмяРасширенияSSL, ИмяРасширенияMain);
						Если НЕ ТекущееИмяРасширения = ИмяФайлаРасширения Тогда
							ПодключитьКомпоненту = Истина;
							СтруктураКомпоненты.ИмяФайлаОбработки = Неопределено;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ДопОбработкиИспользуются Тогда
				
				// Если расширения не используются, то проверяем версии доп.обработок
				Если ЗначениеЗаполнено(СтруктураКомпоненты.ИмяФайлаОбработки) Тогда
					
					ИмяНастройки = "ВерсияПриложения_" + СтруктураКомпоненты.ТипОбработки;
					ЗначениеНастройки = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(ИмяНастройки,, АдресаПеременных);
					ПодключитьКомпоненту = ЗначениеНастройки <> ВерсияПриложенияАктуальная;
					
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЕсли;
		
		Если ПодключитьКомпоненту Тогда
			ПодключаемыеКомпоненты.Вставить(ЭлементСтруктуры.Ключ, СтруктураКомпоненты);
		КонецЕсли;
				
	КонецЦикла;
	
	ГлЯдро_ОбновлениеКомпонент_ОтменитьЗагрузкуКонфликтующихРасширений(ПодключаемыеКомпоненты, СтруктураИменКомпонент, АдресаПеременных);
	
	// Имена стабильных файлов расширений
	ПодключаемыеРасширенияСтабильные = Новый Массив;
	
	// ОсновноеРасширение:
	// 	Файл без постфикса содержит самую свежую версию с режимом совместимости "НеИспользовать".
	// 	Она может не подойти для старых конфигураций.
	// 	Поэтому мы заранее готовим файл со стабильным постфиксом (например, _8_3_14),
	// 		чтобы использовать его, если файл без постфикса вызовет ошибку при подключении.
	ИндексОсновноеРасширение = ПодключаемыеКомпоненты.Получить("ОсновноеРасширение");
	Если НЕ ИндексОсновноеРасширение = Неопределено Тогда
		// Последняя стабильная версия совместимости
		СтабильныйПостфиксРасширенияMain = ГлЯдро_ПолучитьСтабильныйПостфиксРасширения("ОсновноеРасширение");
		ПодключаемыеРасширенияСтабильные.Добавить(СтруктураИменКомпонент.ОсновноеРасширение + СтабильныйПостфиксРасширенияMain);
	КонецЕсли;
	
	ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты 			= ПодключаемыеКомпоненты;
	ПараметрыПодключенияКомпонент.ПодключаемыеРасширенияСтабильные 	= ПодключаемыеРасширенияСтабильные;
	ПараметрыПодключенияКомпонент.РасширенияИспользуются 			= РасширенияИспользуются;
	ПараметрыПодключенияКомпонент.ДопОбработкиИспользуются 			= ДопОбработкиИспользуются;
	ПараметрыПодключенияКомпонент.ХешСуммыРасширений 				= ХешСуммыРасширений;
	ПараметрыПодключенияКомпонент.ПостфиксыРасширений 				= ПостфиксыРасширений;
	ПараметрыПодключенияКомпонент.СтруктураИменКомпонент 			= СтруктураИменКомпонент;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ПараметрыПодключенияКомпонент);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ПараметрыПодключенияКомпонент;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции 

// Получает свойства файлов расширений для сравнения с установленными расширениями.
//
// Параметры:
//  МассивФайловРасширений - Массив из Структура - файлы расширений, возможные свойства:
//   * Имя                - Строка - имя файла расширения.
//   * Хранение           - Строка - адрес двоичных данных файла во временном хранилище.
//   * ИмяФайлаРасширения - Строка - имя файла без расширения .cfe.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Соответствие - свойства файлов расширений по имени файла без расширения .cfe.
//
Функция ГлЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов(МассивФайловРасширений, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов";
	
	#Область НесовместимыйКодFresh
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "МассивФайловРасширений", МассивФайловРасширений);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Новый Соответствие;
	
	Для Каждого ФайлРасширения Из МассивФайловРасширений Цикл
		Попытка
			
			НовыеДвоичныеДанные = ПолучитьИзВременногоХранилища(ФайлРасширения.Хранение);
			
			Попытка
				МетаданныеРасширения = Вычислить("Новый ОбъектМетаданныхКонфигурация(НовыеДвоичныеДанные)");
			Исключение
				// <Лог>
				ЯзСтрока = "ru = 'Не удалось получить свойства файла расширения %1.'";
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ФайлРасширения.Имя);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "ФайлРасширения", ФайлРасширения);
				ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
				// </Лог>
				Продолжить;
			КонецПопытки;
			
			Если ФайлРасширения.Свойство("ИмяФайлаРасширения") Тогда
				ИмяФайлаРасширения = ФайлРасширения.ИмяФайлаРасширения;
			Иначе
				ИмяФайлаРасширения = ФайлРасширения.Имя;
				Если НРег(Прав(ИмяФайлаРасширения, 4)) = ".cfe" Тогда
					ИмяФайлаРасширения = Лев(ИмяФайлаРасширения, СтрДлина(ИмяФайлаРасширения) - 4);
				КонецЕсли;
			КонецЕсли;
			
			СвойстваФайлаРасширения = Новый Структура;
			СвойстваФайлаРасширения.Вставить("ИмяФайлаРасширения", ИмяФайлаРасширения);
			СвойстваФайлаРасширения.Вставить("ИмяРасширения", МетаданныеРасширения.Имя);
			СвойстваФайлаРасширения.Вставить("Синоним", МетаданныеРасширения.Имя);
			СвойстваФайлаРасширения.Вставить("Версия", МетаданныеРасширения.Версия);
			СвойстваФайлаРасширения.Вставить("ХешСумма");
			
			Результат.Вставить(ИмяФайлаРасширения, СвойстваФайлаРасширения);
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось получить свойства файла расширения %1.'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ФайлРасширения.Имя);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "ФайлРасширения", ФайлРасширения);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
			
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

Процедура ГлЯдро_ОбновлениеКомпонент_ОтменитьЗагрузкуКонфликтующихРасширений(ПодключаемыеКомпоненты, СтруктураИменКомпонент, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ОбновлениеКомпонент_ОтменитьЗагрузкуКонфликтующихРасширений";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПодключаемыеКомпоненты,СтруктураИменКомпонент",
		ПодключаемыеКомпоненты, СтруктураИменКомпонент);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	МассивКонфликтующихРасширений = Новый Массив;
	МассивКонфликтующихРасширений.Добавить("РасширениеДляВебСервиса");
	МассивКонфликтующихРасширений.Добавить("РасширениеСКнопкамиОбмена");
	
	Для каждого ТипКонфликтующегоРасширения ИЗ МассивКонфликтующихРасширений Цикл
		СтруктураКомпоненты = ПодключаемыеКомпоненты.Получить(ТипКонфликтующегоРасширения);
		Если НЕ СтруктураКомпоненты = Неопределено Тогда
			ПодключаемыеКомпоненты.Удалить(ТипКонфликтующегоРасширения);
			
			ТекстСообщения = НСтр("ru = 'Вместо расширения %1 будет загружено расширение %2.';
									|en = 'Instead of the %1 extension, the %2 extension will be loaded.';
									|be = 'Замест пашырэння %1 будзе загружана пашырэнне %2.'; es = 'En lugar de la extensión %1, se cargará la extensión %2.'; ka = '%1 გაფართოების ნაცვლად, %2 გაფართოება დატვირთული იქნება.'; kk = '%1 кеңейтімінің орнына % 2 кеңейтімі жүктеледі.'; ro = 'În loc de extensia %1, extensia %2 va fi încărcată.'; tr = '%1 uzantısı yerine %2 uzantısı yüklenecektir.'; uk = 'Замість розширення %1 буде завантажено розширення %2.'; uz = '%1 kengaytmasi o''rniga % 2 kengaytmasi yuklanadi.'");
			ТекстСообщения = ГлЯдро_СтрШаблон(ТекстСообщения, СтруктураКомпоненты.ИмяРасширения, СтруктураИменКомпонент.ОсновноеРасширение);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстСообщения,, АдресаПеременных);
		КонецЕсли;
	КонецЦикла;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры 

Функция ГлЯдро_ОбновлениеКомпонент_ПолучитьАрхивПодключенныхРасширений(ИменаРасширений) Экспорт
	
	#Область НесовместимыйКодFresh
	ФайлыРасширений = ГлЯдро_ОбновлениеКомпонент_ПолучитьФайлыПодключенныхРасширений(ИменаРасширений);
	
	Если НЕ ФайлыРасширений.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлыКУдалению = Новый Массив;
	
	ИмяЗипФайла = ПолучитьИмяВременногоФайла("zip");
	ФайлыКУдалению.Добавить(ИмяЗипФайла);
	
	Сжатие = Новый ЗаписьZipФайла(ИмяЗипФайла,,,, УровеньСжатияZIP.Максимальный);
	Для каждого ОписаниеФайла Из ФайлыРасширений Цикл
		
		ПутьКФайлу = КаталогВременныхФайлов() + "\" + ОписаниеФайла.Имя;
		ФайлыКУдалению.Добавить(ПутьКФайлу);
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(ОписаниеФайла.Хранение);
		ДанныеФайла.Записать(ПутьКФайлу);
		
		Сжатие.Добавить(ПутьКФайлу, РежимСохраненияПутейZIP.НеСохранятьПути);
		
	КонецЦикла;
	Сжатие.Записать();
	ДДАрхива = Новый ДвоичныеДанные(ИмяЗипФайла);
	
	Для каждого ПутьКФайлу Из ФайлыКУдалению Цикл
		УдалитьФайлы(ПутьКФайлу);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ДДАрхива, Новый УникальныйИдентификатор);
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

Функция ГлЯдро_ОбновлениеКомпонент_ПолучитьФайлыПодключенныхРасширений(ИменаРасширений) Экспорт
	
	#Область НесовместимыйКодFresh
	ФайлыРасширений = Новый Массив;
	Для каждого ИмяРасширения Из ИменаРасширений Цикл
		
		Отбор = Новый Структура("Имя", ИмяРасширения);
		Попытка	
			Расширения = РасширенияКонфигурации.Получить(Отбор);
			Если Расширения.Количество() = 1 Тогда
				Расширение = Расширения[0];
				Имя = Расширение.Имя + "_" + Расширение.Версия + ".cfe";
				Хранение = ПоместитьВоВременноеХранилище(Расширение.ПолучитьДанные(), Новый УникальныйИдентификатор);
				ОписаниеПередаваемогоФайла = Новый ОписаниеПередаваемогоФайла(Имя, Хранение);
				ФайлыРасширений.Добавить(ОписаниеПередаваемогоФайла);
			КонецЕсли;
			
		Исключение
			пСообщение = НСтр("ru = 'Не удалось сохранить расширение:'");
			Сообщить(пСообщение + " " + ИмяРасширения);
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ФайлыРасширений;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции 


// Выполняет автоматическое подключение расширений
//
// Параметры:
//  МассивФайловРасширений  - Массив - массив, содержащий элементы ОписаниеПереданногоФайла либо структуры, 
//										в которых обязательно должны быть ключи: Хранение - адрес файла в хранилище, Имя - имя файла
//
// Возвращаемое значение:
//   Массив   - см. описание ГлЯдро_ПодключитьРасширения 
//
Функция ГлЯдро_ПодключитьРасширенияАвтоматическиЗавершение(МассивФайловРасширений = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	#Область НесовместимыйКодFresh
	Если МассивФайловРасширений = Неопределено Тогда
		//Здесь можно получить файлы, доступные на сервере
	КонецЕсли;
	
	РезультатыПодключений = ГлЯдро_ПодключитьРасширения(МассивФайловРасширений,, ДополнительныеПараметры, АдресаПеременных);
	
	Возврат РезультатыПодключений;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

// Выполняет подключение расширений
//
// Параметры:
//  МассивФайловРасширений  - Массив - массив, содержащий элементы ОписаниеПереданногоФайла либо структуры, 
//										в которых обязательно должны быть ключи: Хранение - адрес файла в хранилище, Имя - имя файла
//  РасширениеФайла  - Строка - строка расширения файла, по умолчанию "cfe" 
//
// Возвращаемое значение:
//   Массив   - массив структур следующего формата: 
//		ИмяРасширения 			- Строка - имя расширения
//		Версия 					- Строка - версия успешно подключенного расширения
//		Подключено 				- Булево - признак успешности подключения расширения
//		ТекстОшибки 			- Строка - Текст ошибки
//		ОшибкиПроверки			- Булево - признак наличия ошибок при проверке возможности применения
//
Функция ГлЯдро_ПодключитьРасширения(МассивФайловРасширений, РасширениеФайла = "cfe", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПодключитьРасширения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивФайловРасширений,РасширениеФайла,ДополнительныеПараметры",
		МассивФайловРасширений, РасширениеФайла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	РезультатыПодключений = Новый Массив;

	СтруктураИменРасширений = ГлЯдро_ПолучитьСтруктуруИменРасширений();
	
	// Формируем соответствие стабильных файлов
	СтабильныеФайлыРасширений = Новый Соответствие;
	Если ДополнительныеПараметры <> Неопределено 
		И ДополнительныеПараметры.Свойство("МассивФайловРасширенийСтабильные") Тогда
		
		Для каждого ФайлРасширения Из ДополнительныеПараметры.МассивФайловРасширенийСтабильные Цикл
			
			ИмяБезРасширения = "";
			ИмяБезРасширения = СтрЗаменить(ФайлРасширения.Имя, "." + РасширениеФайла, "");
			
			Для каждого СтруктураИмениРасширения ИЗ СтруктураИменРасширений Цикл
				ТекущееИмяРасширения = СтруктураИмениРасширения.Значение;
				
				Если Лев(ИмяБезРасширения, СтрДлина(ТекущееИмяРасширения)) = ТекущееИмяРасширения Тогда
					ИмяБезРасширения = ТекущееИмяРасширения;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			СтабильныеФайлыРасширений.Вставить(ИмяБезРасширения, ФайлРасширения);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Определяем режим совместимости основной конфигурации
	Попытка
		
		Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
			СисИнфо = Новый СистемнаяИнформация;
			
			ВерсияСовместимости = СисИнфо.ВерсияПриложения;
			
			ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимости, ".");
		Иначе
			ВерсияСовместимости = СтрЗаменить(СтрЗаменить(Строка(Метаданные.РежимСовместимости), "Версия", ""), "Version", "");
			
			ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимости, "_");
		КонецЕсли;
		
		ВерсияСовместимости = Число(ВерсияВМассив[0])*1000000
			+ Число(ВерсияВМассив[1])*1000
			+ Число(ВерсияВМассив[2]);
		
	Исключение
		ВерсияСовместимости = 0;
	КонецПопытки;
	ДополнительныеПараметры.Вставить("ВерсияСовместимости", ВерсияСовместимости);
		
	Для Каждого ФайлРасширения Из МассивФайловРасширений Цикл
		
		пСообщение = НСтр("ru = 'Подключение расширения: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, ФайлРасширения.Имя);
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		
		РезультатПодключения = ГлЯдро_ПодключитьРасширение(ФайлРасширения, РасширениеФайла, СтруктураИменРасширений, ДополнительныеПараметры, АдресаПеременных);
		
		Если НЕ РезультатПодключения.Подключено Тогда
			
			// Пытаемся подключить стабильный файл расширения если есть
			СтабильныйФайл = СтабильныеФайлыРасширений.Получить(РезультатПодключения.ИмяРасширения);
			Если СтабильныйФайл <> Неопределено 
				И ФайлРасширения.Хранение <> СтабильныйФайл.Хранение Тогда
				
				пСообщение = НСтр("ru = 'Подключение стабильного расширения: %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, СтабильныйФайл.Имя);
				
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
				
				РезультатПодключения = ГлЯдро_ПодключитьРасширение(СтабильныйФайл, РасширениеФайла, СтруктураИменРасширений, ДополнительныеПараметры, АдресаПеременных);
			КонецЕсли;
			
			// Если удалось подключить стабильный файл, то никакие ошибки не будут написаны
			Если НЕ РезультатПодключения.Подключено И ЗначениеЗаполнено(РезультатПодключения.ТекстОшибки) Тогда
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"РезультатПодключения",
					РезультатПодключения);
				ЛогОшибка(логСобытие, РезультатПодключения.ТекстОшибки,, логКонтекст,,, АдресаПеременных);
				// </Лог>
			КонецЕсли;
			
		КонецЕсли;
		
		РезультатыПодключений.Добавить(РезультатПодключения);
		
	КонецЦикла;
	
	пСообщение = НСтр("ru = 'Конец.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыПодключений);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатыПодключений;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

Функция ГлЯдро_ПодключитьРасширение(ФайлРасширения, РасширениеФайла = "cfe", СтруктураИменРасширений, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПодключитьРасширение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ФайлРасширения,РасширениеФайла,СтруктураИменРасширений,ДополнительныеПараметры",
		ФайлРасширения, РасширениеФайла, СтруктураИменРасширений, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ИмяБезРасширения 		= СтрЗаменить(ФайлРасширения.Имя, "." + РасширениеФайла, "");
	Подключено 				= Ложь;
	ТекстОшибки 			= "";
	Версия 					= "0.0.0.0";
	ОшибкиПроверки			= Ложь;
	
	ВерсияСовместимостиОсновная = ДополнительныеПараметры.ВерсияСовместимости;
	ВерсияСовместимостиРасширения = 0;
	
	ЭтоАвтотест = КомЯдро_ПолучитьЗначениеПеременной("Автотест", АдресаПеременных) = Истина;
	
	// Имена расширений не содержат постфикс, который могут содержать имена файлов расширений
	Для каждого СтруктураИмениРасширения ИЗ СтруктураИменРасширений Цикл
		ТекущееИмяРасширения = СтруктураИмениРасширения.Значение;
		
		Если Лев(ИмяБезРасширения, СтрДлина(ТекущееИмяРасширения)) = ТекущееИмяРасширения Тогда
			ИмяБезРасширения = ТекущееИмяРасширения;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ИмяВременногоФайла = Неопределено;
	
	Попытка
		
		НовыеДвоичныеДанные = ПолучитьИзВременногоХранилища(ФайлРасширения.Хранение);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
		НовыеДвоичныеДанные.Записать(ИмяВременногоФайла);
		
		ПоставщикРасширения = "Клеверенс";
		
		Попытка
			МетаданныеРасширения = Вычислить("Новый ОбъектМетаданныхКонфигурация(НовыеДвоичныеДанные)");
		Исключение
			МетаданныеРасширения = Неопределено;
		КонецПопытки;
		
		Если МетаданныеРасширения <> Неопределено Тогда
			
			Попытка
				ПоставщикРасширения = МетаданныеРасширения.Поставщик;
			Исключение
			КонецПопытки;
			
			Если НЕ ГлЯдро_СтрНайти(ВРег(ПоставщикРасширения), "КЛЕВЕРЕНС") Тогда
				ВызватьИсключение "Расширение выпущено не компанией ""Клеверенс""";	
			КонецЕсли;
			
			// Проверяем версию совместимости
			Попытка
				Если МетаданныеРасширения.РежимСовместимостиРасширенияКонфигурации = МетаданныеРасширения.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
					
					// Режим совместимости не используется - это самая актуальная версия.
					// Получаем версию совместимости из версии платформы, т.к именно её будет использовать расширение.
					СисИнфо = Новый СистемнаяИнформация;
					ВерсияСовместимостиРасширения = СисИнфо.ВерсияПриложения;
					ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимостиРасширения, ".");
					
				Иначе
					ВерсияСовместимостиРасширения = СтрЗаменить(СтрЗаменить(Строка(МетаданныеРасширения.РежимСовместимостиРасширенияКонфигурации), "Версия", ""), "Version", "");
					ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСовместимостиРасширения, "_");
				КонецЕсли;
				
				ВерсияСовместимостиРасширения = Число(ВерсияВМассив[0])*1000000
					+ Число(ВерсияВМассив[1])*1000
					+ Число(ВерсияВМассив[2]);
				
			Исключение
				ВерсияСовместимостиРасширения = 0;
			КонецПопытки;
			
			Если ВерсияСовместимостиОсновная > 0
				И ВерсияСовместимостиОсновная < ВерсияСовместимостиРасширения Тогда
				ВызватьИсключение "Версия совместимости расширения не соответствует основной конфигурации.";	
			КонецЕсли;
			
		КонецЕсли;
		
		МассивРасширений = РасширенияКонфигурации.Получить(Новый Структура("Имя", ИмяБезРасширения));
		
		Если МассивРасширений.Количество() = 0 Тогда
			РасширениеОбъект = РасширенияКонфигурации.Создать();
		Иначе
			РасширениеОбъект = МассивРасширений[0];				
		КонецЕсли;
		
		РасширениеОбъект.БезопасныйРежим = Ложь;
		
		РасширениеОбъект.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		Ошибки = РасширениеОбъект.ПроверитьВозможностьПрименения(НовыеДвоичныеДанные, Ложь);
		Для Каждого Ошибка Из Ошибки Цикл
			Если Ошибка.Важность <> Вычислить("ВажностьПроблемыПримененияРасширенияКонфигурации.Критичная") Тогда
				Продолжить;
			КонецЕсли;
			ТекстОшибки = ТекстОшибки + Символы.ПС + Ошибка.Описание;
			
			ОшибкиПроверки = Истина;
		КонецЦикла;
		
		Если ЭтоАвтотест Тогда
			
			пСообщение = "Выполняется автотест. Запись расширения в базу пропущена";
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
			
		Иначе
			РасширениеОбъект.Записать(НовыеДвоичныеДанные);
		КонецЕсли;
		
		// После записи расширения версия не обновляется, поэтому получим новую версию через РасширенияКонфигурации
		МассивРасширений = РасширенияКонфигурации.Получить(Новый Структура("Имя", ИмяБезРасширения));
		Если МассивРасширений.Количество() <> 0 Тогда
			Версия = МассивРасширений[0].Версия;
		КонецЕсли;
		
		Подключено = Истина;
		
	Исключение
		Подключено = Ложь;
		ТекстОшибки = НСтр("ru = 'Ошибка подключения расширения: %1. %2';
							|en = 'Extension connection error: %1. %2'; be = 'Памылка падлучэння пашырэння: %1. %2'; es = 'Error al conectar la extensión: %1. %2'; ka = 'გაფართოების კავშირის შეცდომა: %1. %2'; kk = 'Кеңейтімді қосу қатесі: %1. %2'; ro = 'Eroare la conectarea extensiei: %1. %2'; tr = 'Uzantı bağlantı hatası: %1. %2'; uk = 'Помилка підключення розширення: %1. %2'; uz = 'Kengaytmani ulashda xato: %1. %2'");
		ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ИмяБезРасширения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		Попытка
			Файл = Новый Файл(ИмяВременногоФайла);
			Если Файл.Существует() Тогда
				УдалитьФайлы(ИмяВременногоФайла);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	РезультатПодключения = Новый Структура;
	РезультатПодключения.Вставить("ИмяРасширения", 		ИмяБезРасширения);
	РезультатПодключения.Вставить("Подключено", 		Подключено);
	РезультатПодключения.Вставить("ТекстОшибки", 		ТекстОшибки);
	РезультатПодключения.Вставить("Версия", 			Версия);
	РезультатПодключения.Вставить("ОшибкиПроверки", 	ОшибкиПроверки);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПодключения);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатПодключения;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

// Выполняет отключение расширений
//
// Параметры:
//  МассивФайловРасширений 	- Массив - массив, содержащий имена отключаемых расширений
//  РасширениеФайла  		- Строка - строка расширения файла, по умолчанию "cfe"
//
// Возвращаемое значение:
//   Массив - массив структур следующего формата: 
//		ИмяРасширения 			- Строка - имя расширения
//		Отключено 				- Булево - признак успешности отключения расширения
//		ТекстОшибки 			- Строка - Текст ошибки
//
Функция ГлЯдро_ОтключитьРасширения(МассивФайловРасширений, РасширениеФайла = "cfe", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОтключитьРасширения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивФайловРасширений,РасширениеФайла",
		МассивФайловРасширений, РасширениеФайла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	РезультатыОтключения = Новый Массив;

	Для Каждого ИмяФайлаРасширения Из МассивФайловРасширений Цикл
		ИмяБезРасширения = СтрЗаменить(ИмяФайлаРасширения, "." + РасширениеФайла, "");
		Отключено 		 = Истина;
		ТекстОшибки 	 = "";
		
		Попытка
			МассивРасширений = РасширенияКонфигурации.Получить(Новый Структура("Имя", ИмяБезРасширения));
			Если МассивРасширений.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			РасширениеОбъект = МассивРасширений[0];
			Если РасширениеОбъект.Активно Тогда
				РасширениеОбъект.Активно = Ложь;
				РасширениеОбъект.Записать();
			КонецЕсли;
		Исключение
			Отключено = Ложь;
			ТекстОшибки = НСтр("ru = 'Ошибка подключения расширения: %1. %2';
								|en = 'Extension connection error: %1. %2'; be = 'Памылка падлучэння пашырэння: %1. %2'; es = 'Error al conectar la extensión: %1. %2'; ka = 'გაფართოების კავშირის შეცდომა: %1. %2'; kk = 'Кеңейтімді қосу қатесі: %1. %2'; ro = 'Eroare la conectarea extensiei: %1. %2'; tr = 'Uzantı bağlantı hatası: %1. %2'; uk = 'Помилка підключення розширення: %1. %2'; uz = 'Kengaytmani ulashda xato: %1. %2'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ИмяБезРасширения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстОшибки,, АдресаПеременных);	
			
		КонецПопытки;
		
		РезультатОтключения = Новый Структура;
		РезультатОтключения.Вставить("ИмяРасширения",	ИмяБезРасширения);
		РезультатОтключения.Вставить("Отключено",	 	Отключено);
		РезультатОтключения.Вставить("ТекстОшибки", 	ТекстОшибки);
		
		РезультатыОтключения.Добавить(РезультатОтключения);
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыОтключения);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатыОтключения;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

Функция ГлЯдро_ОтключитьБезопасныйРежимРасширений(МассивИменРасширений = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОтключитьБезопасныйРежимРасширений";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивИменРасширений,ДополнительныеПараметры",
		МассивИменРасширений, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	РезультатыОтключения = Новый Массив;
	ЕстьИзменения = Ложь;
	
	Если МассивИменРасширений = Неопределено Тогда
		
		МассивИменРасширений = Новый Массив;
		ИнформацияРасширений = ГлЯдро_ПолучитьИнформациюОПодключенныхРасширениях();
		Для каждого ДанныеРасширения Из ИнформацияРасширений.ХешСуммыРасширений Цикл
			МассивИменРасширений.Добавить(ДанныеРасширения.Ключ);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ИмяРасширения Из МассивИменРасширений Цикл
		
		Отключен 		= Истина;
		ТекстОшибки 	= "";
		Изменен 		= Ложь;
		СинонимРасширения = ИмяРасширения;
		Попытка
			МассивРасширений = РасширенияКонфигурации.Получить(Новый Структура("Имя", ИмяРасширения));
			Если МассивРасширений.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Записать = Ложь;
			РасширениеОбъект = МассивРасширений[0];
			СинонимРасширения = РасширениеОбъект.Синоним;
			
			Если РасширениеОбъект.Активно Тогда
				
				Если РасширениеОбъект.БезопасныйРежим Тогда
					РасширениеОбъект.БезопасныйРежим = Ложь;
					Записать = Истина;
				КонецЕсли;
				
				Если РасширениеОбъект.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях Тогда
					РасширениеОбъект.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
					Записать = Истина;
				КонецЕсли;
				
				Если Записать Тогда
					РасширениеОбъект.Записать();
					Изменен = Истина;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
			КонецЕсли;
		Исключение
			Отключен = Ложь;
			ТекстОшибки = НСтр("ru = 'Ошибка отключения безопасного режима расширения: %1. %2';
								|en = 'Error disabling safe expansion mode: %1. %2';
								|be = 'Памылка адключэння бяспечнага рэжыму пашырэння: %1. %2'; es = 'Error al deshabilitar el modo seguro de extensión: %1. %2'; ka = 'შეცდომა გამორთვა უსაფრთხო გაფართოების რეჟიმი: %1. %2'; kk = 'Қауіпсіз кеңейту режимін өшіру қатесі: %1. %2'; ro = 'Eroare la dezactivarea modului de expansiune sigură: %1. %2'; tr = 'Güvenli uzantı modunu devre dışı bırakma hatası: %1. %2'; uk = 'Помилка вимкнення безпечного режиму розширення: %1. %2'; uz = 'Xavfsiz kengaytma rejimini o''chirib qo''yish xatosi: %1. %2'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ИмяРасширения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстОшибки,, АдресаПеременных);	
			
		КонецПопытки;
		
		РезультатОтключения = Новый Структура;
		РезультатОтключения.Вставить("ИмяРасширения",	ИмяРасширения);
		РезультатОтключения.Вставить("СинонимРасширения",	СинонимРасширения);
		РезультатОтключения.Вставить("Отключен",	 		Отключен);
		РезультатОтключения.Вставить("ТекстОшибки", 		ТекстОшибки);
		РезультатОтключения.Вставить("Изменен", 			Изменен);
		
		РезультатыОтключения.Добавить(РезультатОтключения);
	КонецЦикла;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ЕстьИзменения", ЕстьИзменения);
	СтруктураРезультата.Вставить("РезультатыОтключения", РезультатыОтключения);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураРезультата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураРезультата;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции
	
#КонецОбласти

#Область ГлобальныйКонтекст_Настройки_ЧтениеНастроек

// Вызывает процедуру сохранения данных для инициализации во временном хранилище
//
// Параметры:
//	ДанныеДляИнициализации - Структура - см. ГлЯдро_ПолучитьДанныеДляИнициализации	
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_ОтправитьДанныеДляИнициализацииВГлКонтекст(ДанныеДляИнициализации,АдресаПеременных) Экспорт
	КомЯдро_СохранитьЗначениеПеременной("ТекущиеНастройкиMS",ДанныеДляИнициализации.ТекущиеНастройкиMS,АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных",ДанныеДляИнициализации.СтруктураМетаданных,АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("ДанныеТекущегоУзла",ДанныеДляИнициализации.ДанныеТекущегоУзла,АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("НастройкиИнициализированы",Истина,АдресаПеременных);		
КонецПроцедуры

// В COM-соединении вызывает функцию получения настроек всех баз из списка на сервере Клеверенс
//
// Параметры:
//	Полное - Булево - признак того, возвращается для каждой базы из списка полное (Истина) либо краткое (Ложь) описание
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Массив из Структура - см. КомЯдро_ПолучитьСписокБазНаСервереSMARTS
Функция ГлЯдро_ПолучитьСписокБазНаСервереSMARTS(Полное,АдресаПеременных) Экспорт
	Возврат КомЯдро_ПолучитьСписокБазНаСервереSMARTS(Полное,АдресаПеременных);
КонецФункции

// Вызывает функцию получения настроек на сервере Клеверенс и конвертации сериализуемых настроек
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо получить
//  УзловыеНастройки - Неопределено, Структура - ключами являются имена узловых настроек Клеверенс - см. ГлЯдро_ПолучитьКатегорииНастроекMS
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - ключами являются имена настроек Клеверенс, переданные в параметре СтруктураНастроек, 
//				значениями - соответствующие значения полученных настроек
Функция ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроекMS = Неопределено, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьНастройкиНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,КатегорииНастроекMS,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, КатегорииНастроекMS, ID_Узла, ДополнительныеПараметры);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ДополнительныеПараметры 	= ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеКэшировать 				= ДополнительныеПараметры.Свойство("НеКэшировать") И ДополнительныеПараметры.НеКэшировать;
	НеПроверятьАктуальность 	= ДополнительныеПараметры.Свойство("НеПроверятьАктуальность") И ДополнительныеПараметры.НеПроверятьАктуальность;
	НеИспользоватьАтрибуты		= ДополнительныеПараметры.Свойство("НеИспользоватьАтрибуты") И ДополнительныеПараметры.НеИспользоватьАтрибуты;
	
	СериализуемыеНастройки 	= Неопределено;
	ДополнительныеПараметры.Свойство("СериализуемыеНастройки", СериализуемыеНастройки);
	
	пСообщение = НСтр("ru = 'Начало, Получение настроек на сервере SMARTS';
						|en = 'Getting started, Getting settings on the Cleverence server'; be = 'Пачатак, атрыманне налад на сэрвэры Cleverence'; es = 'Inicio, Obtener la configuración en el servidor Cleverence'; ka = 'მიღება დაიწყო, მიღების პარამეტრების Cleverence სერვერზე'; kk = 'Бастау, Cleverence серверінде параметрлерді алу'; ro = 'Noțiuni de bază, obținerea setărilor pe serverul Cleverence'; tr = 'Başlangıç, Cleverence sunucusunda ayarları alma'; uk = 'Початок, отримання налаштувань на сервері Cleverence'; uz = 'Ishni boshlash, Cleverence serverida sozlamalarni olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	ТекстСообщения = "";
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Для каждого Настройка ИЗ СтруктураНастроек Цикл
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", ", ") + Строка(Настройка.Ключ);
		КонецЦикла;
	КонецЕсли;
	пСообщение = НСтр("ru = 'Получаемые настройки: %1';
						|en = 'Received settings: %1'; be = 'Атрыманыя налады: %1'; es = 'Ajustes recibidos: %1'; ka = 'მიღებული პარამეტრები: %1'; kk = 'Алынған параметрлер: %1'; ro = 'Setări primite: %1'; tr = 'Alınan ayarlar: %1'; uk = 'Отримані налаштування: %1'; uz = 'Qabul qilingan Sozlamalar: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ТекстСообщения);
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
		Если КатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
		КонецЕсли;
	КонецЕсли;
	
	// Получаем значения кэшируемых настроек, которые не нужно запрашивать и конвертировать
	Если НеПроверятьАктуальность Тогда
		АктуальныеНастройки = Новый Структура;
	Иначе
		АктуальныеНастройки = ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных);
	КонецЕсли;
	
	Для каждого АктуальнаяНастройка ИЗ АктуальныеНастройки Цикл	
		СтруктураНастроек.Удалить(АктуальнаяНастройка.Ключ);
	КонецЦикла;
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		ПараметрыЗаполненияНастроек = Новый Структура;
		ПараметрыЗаполненияНастроек.Вставить("НеИспользоватьАтрибуты",	НеИспользоватьАтрибуты);
		
		Если ДополнительныеПараметры.Свойство("АтрибутыНастроекMS") Тогда
			ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS", ДополнительныеПараметры.АтрибутыНастроекMS);
		КонецЕсли;
		
		СтруктураНастроек = REST_API_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS, ID_Узла, ПараметрыЗаполненияНастроек, АдресаПеременных);
	Иначе
		СтруктураНастроек = КомЯдро_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS, ID_Узла,, АдресаПеременных);
	КонецЕсли;
	СтруктураНастроек = ГлЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, "ИзСтроки", СериализуемыеНастройки,Истина);
	
	// Кэшируем полученные из базы настройки
	Если НЕ НеКэшировать Тогда
		ГлЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных);
	КонецЕсли;

	// Дополняем возвращаемую структуру актуальными кэшируемыми настройками
	Для каждого АктуальнаяНастройка ИЗ АктуальныеНастройки Цикл	
		СтруктураНастроек.Вставить(АктуальнаяНастройка.Ключ, АктуальнаяНастройка.Значение);
	КонецЦикла;
	
	пСообщение = НСтр("ru = 'Конец, Получение настроек на сервере SMARTS';
						|en = 'Finally, Getting the settings on the Cleverence server'; be = 'Канец, атрыманне налад на сэрвэры Cleverence'; es = 'Fin, Obtener la configuración en el servidor Cleverence'; ka = 'და ბოლოს, მიღების პარამეტრების Cleverence სერვერზე'; kk = 'Аяқтау, Cleverence серверінде параметрлерді алу'; ro = 'În cele din urmă, obținerea setărilor pe serverul Cleverence'; tr = 'Son, Cleverence sunucusunda ayarları alma'; uk = 'Кінець, отримання налаштувань на сервері Cleverence'; uz = 'Tugatish, cleverence serverida sozlamalarni olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек",
		СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции

// Вызывает функцию получения настройки из базы Клеверенс по ключу
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
//	ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Произвольный - значение настройки Клеверенс, переданной в параметре КлючНастройки 
Функция ГлЯдро_ПолучитьНастройкуНаСервереSMARTS(КлючНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено,АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, Ложь);
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек,, ID_Узла, ДополнительныеПараметры, АдресаПеременных);
	
	Возврат СтруктураНастроек[КлючНастройки];
	
КонецФункции

// Получает значение настройки Клеверенс из кэша
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
//  ВернутьМассивСтруктур - Булево - определяет, будет возвращено значение табличной настройки в виде массива структур (Истина) или таблицы значений (Ложь)
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Произвольный - значение настройки Клеверенс, переданной в параметре КлючНастройки
Функция ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(КлючНастройки,ВернутьМассивСтруктур = Ложь,АдресаПеременных) Экспорт
	
	ЗначениеНастройки = Ложь;
	
	ТекущиеНастройкиMS = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS",АдресаПеременных);
	
	Если ТипЗнч(ТекущиеНастройкиMS) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденноеЗначение = Неопределено;
	Если ТекущиеНастройкиMS.Свойство(КлючНастройки, НайденноеЗначение) Тогда
		ЗначениеНастройки = НайденноеЗначение;
	КонецЕсли;
	
	Если ВернутьМассивСтруктур = Истина Тогда
	   
		ЗначениеНастройки = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ЗначениеНастройки);
	
	КонецЕсли;
	
	Возврат ЗначениеНастройки;
	
КонецФункции

// Получает из кэша значение табличной настройки Клеверенс или значение ее отдельной колонки с возможностью выполнения отбора
//
// Параметры:
//	КлючТаблицы	- Строка - имя табличной настройки Клеверенс, из которой необходимо получить данные
//  Отбор - Структура - в качестве ключей содержит имена колонок табличной настройки Клеверенс, в качестве
//						значений - значения соответствующих колонок, по которым необходимо выполнить отбор
//  ИмяКолонки - Строка - имя колонки табличной настройки Клеверенс, значение которой необходимо вернуть
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- ТаблицаЗначений - если значение полученной настройки хранится в кэше в виде таблицы значений
//	- Массив из Структура - если значение полученной настройки хранится в кэше в виде массива структур
//	- Произвольный - если запрошено значение одной колонки
//  - Неопределено - если значение настройки получить не удалось
Функция ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS(КлючТаблицы, Отбор, ИмяКолонки = "", ВернутьПервоеЗначение = Ложь, АдресаПеременных) Экспорт
	
	Результат = Неопределено;
	
	ТаблицаНастроек = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(КлючТаблицы,,АдресаПеременных);
	РезультатОтбора = Новый Массив;
	СтруктураТЗ = Неопределено;	
	Если ТипЗнч(ТаблицаНастроек) = Тип("ТаблицаЗначений") Тогда
		РезультатОтбора = ТаблицаНастроек.Скопировать(Отбор);
		Если РезультатОтбора.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(ИмяКолонки) Тогда
				Результат = ?(РезультатОтбора.Количество() = 1, РезультатОтбора[0][ИмяКолонки], "");
			Иначе
				Если ВернутьПервоеЗначение Тогда
					Возврат РезультатОтбора[0];
				КонецЕсли;
				Результат = РезультатОтбора;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТаблицаНастроек) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из ТаблицаНастроек Цикл
			Если ЭлементМассива.Свойство("КолонкиТаблицыЗначений") Тогда
				СтруктураТЗ = ЭлементМассива;
				Продолжить;
			КонецЕсли;
			Подходит = Истина;
			Для Каждого ЭлементОтбора из Отбор Цикл
				Если НЕ (ЭлементМассива.Свойство(ЭлементОтбора.Ключ) 
					И ЭлементМассива[ЭлементОтбора.Ключ] = ЭлементОтбора.Значение) Тогда
					Подходит = Ложь;
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			Если Подходит Тогда
				Если ВернутьПервоеЗначение Тогда
					Возврат ЭлементМассива;
				КонецЕсли;
				РезультатОтбора.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
		Если РезультатОтбора.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(ИмяКолонки) Тогда
				Результат = ?(РезультатОтбора.Количество() = 1, РезультатОтбора[0][ИмяКолонки], "");
			Иначе
				Если СтруктураТЗ <> Неопределено Тогда
					РезультатОтбора.Вставить(0,СтруктураТЗ);
				КонецЕсли;
				Результат = РезультатОтбора;
			КонецЕсли;
		КонецЕсли	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Получает настройку из хранилища общих настроек
//
// Параметры:
// 	КлючДляПолучения - Строка - имя настройки, которую необходимо получить
// 	ПолучитьПользовательскуюИОбщуюНастройку - определяет, нужно ли получить пользовательскую и общую настройку (Истина) или одну из них (Ложь)
//
// Возвращаемое значение:
// 	- Структура - содержит:
// 		* ПользовательскаяНастройка - Произвольный - значение пользовательской настройки
//      * ОбщаяНастройка - Произвольный - значение общей настройки
// 	- Произвольный - значение пользовательской или - при отсутствии пользовательской - общей настройки
Функция ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючДляПолучения, ПолучитьПользовательскуюИОбщуюНастройку = Ложь, ПолучитьОбщуюНастройку = Ложь) Экспорт
	
	ДанныеИзХранилища = Ложь;
	
	// Работаем только с пользовательскими настройками
	Если Ложь И ПравоДоступа("АдминистрированиеДанных", Метаданные) Тогда
		
		ПользовательскаяНастройка = ХранилищеОбщихНастроек.Загрузить(КлючДляПолучения);
		
		Если ПользовательскаяНастройка = Неопределено Тогда
			
			ПользовательскаяНастройка = ХранилищеОбщихНастроек.Загрузить(КлючДляПолучения,,, ГлЯдро_ПолучитьНаименованиеТекущегоПользователя());
			Если ПользовательскаяНастройка <> Неопределено Тогда
				ГлЯдро_СохранитьДанныеВХранилище1С(КлючДляПолучения, ПользовательскаяНастройка);
			КонецЕсли;
		КонецЕсли;
		
		// Блокируем получение общих настроек и работаем только с пользовательскими
		ДанныеИзХранилища = ПользовательскаяНастройка;
		
	ИначеЕсли ПолучитьОбщуюНастройку Тогда
		
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			ДанныеИзХранилища = ХранилищеОбщихНастроек.Загрузить(КлючДляПолучения,,, "");
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			ДанныеИзХранилища = ХранилищеОбщихНастроек.Загрузить(КлючДляПолучения);
		КонецПопытки;
		
	Иначе
		ДанныеИзХранилища = ХранилищеОбщихНастроек.Загрузить(КлючДляПолучения);
	КонецЕсли;
	
	Возврат ДанныеИзХранилища;
	
КонецФункции

// Удаляет текущее значение настройки Клеверенс для возможности получения значения по умолчанию
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Произвольный - значение настройки Клеверенс, переданной в параметре КлючНастройки
Функция ГлЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS(КлючНастройки, ID_Узла = "", АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, Ложь);
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек, ID_Узла, АдресаПеременных);
	
	Возврат СтруктураНастроек[КлючНастройки];
	
КонецФункции

// Удаляет значения текущих настроек в базе Клеверенс для возможности получения значений по умолчанию
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо получить	
//  УзловыеНастройки - Неопределено, Структура - ключами являются имена узловых настроек Клеверенс - см. ГлЯдро_ПолучитьКатегорииНастроекMS
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - структура настроек с заполненными значениями по умолчанию
Функция ГлЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек, ID_Узла = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла",
		СтруктураНастроек, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Получение настроек по умолчанию на сервере SMARTS';
						|en = 'Getting started, Getting the default settings on the Cleverence server';
						|be = 'Пачатак, атрыманне налад па змаўчанні на сэрвэры Cleverence'; es = 'Inicio, Obtener la configuración predeterminada en el servidor Cleverence'; ka = 'დაწყება, მიღების default პარამეტრების Cleverence სერვერზე'; kk = 'Бастау, Cleverence серверінде әдепкі параметрлерді алу'; ro = 'Noțiuni de bază, obținerea setărilor implicite pe serverul Cleverence'; tr = 'Başlangıç, Cleverence sunucusunda varsayılan ayarları alma'; uk = 'Початок, отримання налаштувань за замовчуванням на сервері Cleverence'; uz = 'Ishni boshlash, Cleverence serverida standart sozlamalarni olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;

	ГлЯдро_УдалитьНастройкиВБазеSMARTS(СтруктураНастроек, УзловыеНастройки, ID_Узла,АдресаПеременных);	
	СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроекMS,,, АдресаПеременных);
	
	ВерсияОбработки = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки",,АдресаПеременных);
	ВерсияОбработкиКлеверенсТСД = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиКлеверенсТСД",,АдресаПеременных);
	
	Если ТипЗнч(ВерсияОбработки) = Тип("Строка") Тогда
		ВерсияОбработки = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработки);
	ИначеЕсли ТипЗнч(ВерсияОбработки) <> Тип("Число") Тогда
		ВерсияОбработки = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ВерсияОбработкиКлеверенсТСД) = Тип("Строка") Тогда
		ВерсияОбработкиКлеверенсТСД = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработкиКлеверенсТСД);
	ИначеЕсли ТипЗнч(ВерсияОбработкиКлеверенсТСД) <> Тип("Число") Тогда
		ВерсияОбработкиКлеверенсТСД = Неопределено;
	КонецЕсли;
	
	// Метод может быть вызван до инициализации для получения простых настроек, реструктуризация которых не требуется
	ПроверятьВерсиюОбработки = ВерсияОбработки <> Неопределено
		И ВерсияОбработкиКлеверенсТСД <> Неопределено;
	
	Если ПроверятьВерсиюОбработки И ВерсияОбработки > ВерсияОбработкиКлеверенсТСД Тогда
		СтруктураНастроек = ГлЯдро_ВыполнитьОбновлениеНастроек(ВерсияОбработкиКлеверенсТСД,СтруктураНастроек,АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Получение настроек по умолчанию на сервере SMARTS';
						|en = 'Finally, Getting the default settings on the Cleverence server';
						|be = 'Канец, атрыманне налад па змаўчанні на сэрвэры Cleverence'; es = 'Fin, Obtener la configuración predeterminada en el servidor Cleverence'; ka = 'დაბოლოს, ნაგულისხმევი პარამეტრების მიღება Cleverence სერვერზე'; kk = 'Соңы, Cleverence серверінде әдепкі параметрлерді алу'; ro = 'În cele din urmă, obținerea setărilor implicite pe serverul Cleverence'; tr = 'Son, Cleverence sunucusunda varsayılan ayarları alma'; uk = 'Кінець, отримання налаштувань за замовчуванням на сервері Cleverence'; uz = 'Tugatish, Cleverence serverida standart sozlamalarni olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции	

// Возвращает структуру описания базы на сервере Клеверенс
//
// Параметры:
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	ТипИнтерфейса - Строка - "REST_API", "COM"
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Неопределено, Структура - см. КомЯдро_СоздатьСтруктуруОписанияБазыSMARTS или REST_API_ПолучитьОписаниеБазы (в зависимости от типа интерфейса)	
Функция ГлЯдро_НайтиБазуНаСервереСМАРТС(ТипБазы,ТипИнтерфейса,АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_НайтиБазуНаСервереСМАРТС";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы,ТипИнтерфейса",
		ТипБазы, ТипИнтерфейса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураДанныеБазы = Неопределено;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "СтруктураПодключенияЧастнойБазыMS";	
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "СтруктураПодключенияБазыMS";
	КонецЕсли;
	Если ТипИнтерфейса = "REST_API" Тогда
		КлючПеременной = "REST_API_" + КлючПеременной;
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
		
		Если ТипЗнч(СтруктураПодключенияБазыMS) = Тип("Структура")
			И СтруктураПодключенияБазыMS.Свойство("ОписаниеБазы") Тогда
			СтруктураДанныеБазы = СтруктураПодключенияБазыMS.ОписаниеБазы;
			Если НЕ (ТипЗнч(СтруктураДанныеБазы) = Тип("Структура") 
					И СтруктураДанныеБазы.Свойство("АвторизацияВключена")
					И СтруктураДанныеБазы.АвторизацияВключена) Тогда
				СтруктураДанныеБазы = REST_API_ПолучитьОписаниеБазы(ТипБазы,АдресаПеременных);	
			КонецЕсли;
		Иначе
			СтруктураДанныеБазы = REST_API_ПолучитьОписаниеБазы(ТипБазы,АдресаПеременных);
		КонецЕсли;
	Иначе
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
		
		Если ТипЗнч(СтруктураПодключенияБазыMS) = Тип("Структура")
			И СтруктураПодключенияБазыMS.Свойство("ОписаниеБазы") Тогда
			СтруктураДанныеБазы = СтруктураПодключенияБазыMS.ОписаниеБазы;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанныеБазы);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураДанныеБазы;
	
КонецФункции

// Получает базу на сервере Клеверенс по идентификатору и возвращает ее описание
//
// Параметры:
//	ИДБазы - Строка - идентификатор базы на сервере Клеверенс		
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
//Возвращаемое значение:
//	Неопределено, Структура - см. КомЯдро_СоздатьСтруктуруОписанияБазыSMARTS
Функция ГлЯдро_ПолучитьБазуНаСервереSMARTS(ИДБазы,ТипБазы = "Временная", АдресаПеременных) Экспорт
	
	Если НЕ КомЯдро_ПодключитьсяКСерверуSMARTS(,ТипБазы, АдресаПеременных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеБазы = КомЯдро_ПолучитьБазуНаСервереSMARTS(ИДБазы,ТипБазы, АдресаПеременных);
	Если ОписаниеБазы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтруктураДанныеБазы = КомЯдро_СоздатьСтруктуруОписанияБазыSMARTS(ОписаниеБазы);
	
	Возврат СтруктураДанныеБазы;
	
КонецФункции

// Вызывает процедуру авторизации в базе Клеверенс и возвращает токен авторизации
//
// Параметры:
//	СтруктураПодключения:
//		- Строка - строка подключения к базе Клеверенс
//		- Структура - структура подключения к базе Клеверенс
//	Логин 	- Строка - логин авторизации
//	Пароль 	- Строка - пароль авторизации
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	ТипИнтерфейса - Строка - "REST_API", "COM"
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных	
//
// Возвращаемое значение:
//	Структура:
//		* АвторизацияТокен 		 - access-token авторизации, если тип интерфейса REST_API
//		* АвторизацияРефрешТокен - refresh-token авторизации, если тип интерфейса REST_API
//	Строка						 - access-token авторизации, если тип интерфейса COM
//	Ложь						 - авторизоваться не удалось
Функция ГлЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы = Неопределено, ТипИнтерфейса, ОбновитьНастройкиВКэше = Истина, АдресаПеременных) Экспорт
	
	Если ТипИнтерфейса = "REST_API" Тогда
		ТокенSMARTS = REST_API_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы, ОбновитьНастройкиВКэше, АдресаПеременных);
		Возврат ТокенSMARTS;
	Иначе
		ТокенSMARTS = КомЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы, АдресаПеременных);
		Возврат ТокенSMARTS;
	КонецЕсли;
	
КонецФункции

Процедура ГлЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, ТокеныАвторизации, ТипБазы = Неопределено, ТипИнтерфейса = Неопределено,
	ОбновитьНастройкиВХранилище = Истина, REST_API_session = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновитьТокеныВПараметрахПодключения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключения,ТокеныАвторизации,ТипБазы,ТипИнтерфейса,ОбновитьНастройкиВХранилище,REST_API_session",
		СтрокаПодключения, ТокеныАвторизации, ТипБазы, ТипИнтерфейса, ОбновитьНастройкиВХранилище, REST_API_session);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Access_token  = ТокеныАвторизации.Access_token;
	Refresh_token = ТокеныАвторизации.Refresh_token;

	// 1. Хранилище настроек пользователя Cleverence_ПараметрыПодключенияMS 
	// 2. Локальный кэш ПараметрыПодключенияMS
	
	Если ОбновитьНастройкиВХранилище Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
	
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") И ПараметрыПодключенияMS.Свойство("СтрокаПодключения")
			И ГлЯдро_СтрокиПодключенияСовпадают(ПараметрыПодключенияMS.СтрокаПодключения, СтрокаПодключения) Тогда
				
			ПараметрыПодключенияMS.Вставить("АвторизацияТокен", 	  Access_token);
			ПараметрыПодключенияMS.Вставить("АвторизацияРефрешТокен", Refresh_token);
			
			ГлЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	// 3. Локальный кэш СтруктураПодключенияБазыMS
	
	Если ТипИнтерфейса = Неопределено Тогда
		ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	КонецЕсли;
		
	Если ТипИнтерфейса = Неопределено Тогда
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	КонецЕсли;
	
	Если ТипБазы = Неопределено Тогда
		ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза", АдресаПеременных);
		
		ТипБазы = ?(ЕстьЧастнаяБаза = Истина, "Частная", "Основная");	
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда
		КлючПеременной = "REST_API_" + КлючПеременной;
	КонецЕсли;
		
	СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
		
	Если ТипЗнч(СтруктураПодключенияБазыMS) = Тип("Структура") И СтруктураПодключенияБазыMS.Свойство("СтрокаПодключения")
		И ГлЯдро_СтрокиПодключенияСовпадают(СтруктураПодключенияБазыMS.СтрокаПодключения, СтрокаПодключения) Тогда
		СтруктураПодключенияБазыMS.Вставить("АвторизацияТокен", 	  Access_token);
		СтруктураПодключенияБазыMS.Вставить("АвторизацияРефрешТокен", Refresh_token);
		
		КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, СтруктураПодключенияБазыMS, АдресаПеременных);
	КонецЕсли;
	
	// 3. Локальный кэш API_session_[База Клеверенс]
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
		
	КлючПеременной = "API_session_" + REST_API_ПолучитьКлючURL(СтруктураURI);
	
	Если REST_API_session = Неопределено Тогда
		REST_API_session = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	КонецЕсли;
		
	Если ТипЗнч(REST_API_session) = Тип("Соответствие") Тогда
		REST_API_session.Вставить("access_token",  Access_token);
		REST_API_session.Вставить("refresh_token", Refresh_token);
			
		КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, REST_API_session, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЯзСтрока = "ru = 'Токены авторизации обновлены в параметрах подключения.
					|Строка подключения: %1
					|Тип базы: %2
					|Access_token: %3
					|Refresh_token: %4'";
	пСообщение = НСтр(ЯзСтрока);
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, СтрокаПодключения, ТипБазы, Access_token, Refresh_token);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключения,ТокеныАвторизации,ТипБазы,ТипИнтерфейса,REST_API_session",
		СтрокаПодключения, ТокеныАвторизации, ТипБазы, ТипИнтерфейса, REST_API_session);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст,, АдресаПеременных);
	// </Лог>

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Вызывает функцию подключения к базе Клеверенс
//
// Параметры:
//	СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//  Переподключиться - Булево - определяет необходимость явного переподключения к базе Клеверенс
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//  Интерактивно - Булево - флаг работы в интерактивном режиме
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - если необходима авторизация в интерактивном режиме - содержит:
//  	* Статус - Строка	
//      * СтрокаПодключения - Строка
//      * ИмяБазы - Строка
//      * Логин - Строка
//      * ТипБазы - Строка
//      * ДопПараметры - Структура - содержит:
//			** СтрокаПодключения - Строка
//          ** ТипБазы - Строка
//          ** СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//          ** СохранятьАвторизацию - Булево
//          ** ИмяБазы - Строка
//			** Логин - Строка
//	- Булево - результат проверки соединения с подключенной базой Клеверенс
Функция ГлЯдро_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Переподключиться, ТипБазы, Интерактивно, НеПроверятьАвторизацию = Ложь, АдресаПеременных) Экспорт
	
	Возврат REST_API_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Интерактивно, НеПроверятьАвторизацию, АдресаПеременных);
	
КонецФункции

Функция ГлЯдро_ПроверитьСовместимостьПлатформы(СтруктураПодключения, АдресаПеременных) Экспорт

	Результат = REST_API_ПроверитьСовместимостьПлатформы(СтруктураПодключения, АдресаПеременных);
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ПолучитьТаймаутПоТипуМетода(СтруктураЗапроса, АдресаПеременных)
	
	ЗначениеТаймаутаПоУмолчанию = 7;
	
	НастройкиТаймаутов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов",, АдресаПеременных);
	Если НастройкиТаймаутов = Неопределено Тогда// Если возвращается Неопределено, значит переменные кэша еще не созданы, возьмем напрямую настройки по умолчанию		
		НастройкиТаймаутов = ГлЯдро_ТаймаутыПоУмолчанию(АдресаПеременных);	
		
	ИначеЕсли НастройкиТаймаутов = Ложь Тогда  // если в кэше нет настроек, то вызовем обновление таймаутов, внутри обновления есть запись в кэш,
		ГлЯдро_ОбновитьНастройкиТаймаутов(АдресаПеременных); // поэтому после обновления просто переполучим из него.		
		НастройкиТаймаутов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов",,АдресаПеременных);
		
	КонецЕсли;
	
	ТипЗапроса = "ПоУмолчанию";
	Если СтруктураЗапроса.Свойство("ТипЗапроса") // Если в структуре запроса не задан тип запроса, то берем таймаут по умолчанию
		И ЗначениеЗаполнено(СтруктураЗапроса.ТипЗапроса) Тогда
		ТипЗапроса = СтруктураЗапроса.ТипЗапроса;
	КонецЕсли;
	
	СтрокаНастройки = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиТаймаутов,Новый Структура("ТипЗапроса", ТипЗапроса));
	
	Если СтрокаНастройки = Неопределено 
		И ТипЗапроса <> "ПоУмолчанию" Тогда // Названия методов могут меняться со временем, если забыли переименовать и настройка не нашлась, то будем брать значение по умолчанию
		СтрокаНастройки = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиТаймаутов,Новый Структура("ТипЗапроса", "ПоУмолчанию"));
	КонецЕсли;
	
	Если СтрокаНастройки = Неопределено Тогда // Если по какой-то причине строки настройки всё равно нет, то назначим значение таймаута 7
		ЗначениеТаймаута = ЗначениеТаймаутаПоУмолчанию;
	Иначе
		ЗначениеТаймаута = СтрокаНастройки[0].Значение;
	КонецЕсли;
	
	Возврат ЗначениеТаймаута;
КонецФункции

Функция ГлЯдро_ОбновитьМетаданныеТаблицMS(ТипБазы = "Основная", АдресаПеременных) Экспорт

	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса", АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		Таблицы = REST_API_ОбновитьМетаданныеТаблицMS(ТипБазы, АдресаПеременных);
	Иначе
		Таблицы = КомЯдро_ОбновитьМетаданныеТаблицMS(ТипБазы, АдресаПеременных);
	КонецЕсли;
	
	Возврат Таблицы;
	
КонецФункции

Функция ГлЯдро_ПолучитьСтруктуруКэшируемыхНастроек()

	КэшируемыеНастройки = Новый Структура;
	
	КэшируемыеНастройки.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию",				"НастройкиБизнесПроцессов");
	КэшируемыеНастройки.Вставить("НастройкиБизнесПроцессов_Пользовательские",			"НастройкиБизнесПроцессов");
	КэшируемыеНастройки.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки",	"НастройкиБизнесПроцессов");
	КэшируемыеНастройки.Вставить("ПроизвольныеКоды_ПоУмолчанию",						"ПроизвольныеКоды");
	КэшируемыеНастройки.Вставить("ПроизвольныеКоды_Пользовательские",					"ПроизвольныеКоды");
	КэшируемыеНастройки.Вставить("НастройкиОтборовУзлов_Интерактивный", 				"НастройкиОтборовУзлов_Интерактивный");
	КэшируемыеНастройки.Вставить("НастройкиОтборовУзлов_Онлайн", 						"НастройкиОтборовУзлов_Онлайн");
	КэшируемыеНастройки.Вставить("ГлобальныеПараметры_ПоУмолчанию",						"ГлобальныеПараметры");
	КэшируемыеНастройки.Вставить("ГлобальныеПараметры_Пользовательские",				"ГлобальныеПараметры");
	КэшируемыеНастройки.Вставить("НастройкиОтборовСправочников_Онлайн",					"НастройкиОтборовСправочников_Онлайн");
	КэшируемыеНастройки.Вставить("НастройкиОтборовСправочников_Интерактивный", 			"НастройкиОтборовСправочников_Интерактивный");
	КэшируемыеНастройки.Вставить("НастройкиОтборовСправочников_Автообмен",				"НастройкиОтборовСправочников_Автообмен");
	
	// Сборные настройки
	КэшируемыеНастройки.Вставить("НастройкиБизнесПроцессов",							"НастройкиБизнесПроцессов");
	КэшируемыеНастройки.Вставить("ПроизвольныеКоды",									"ПроизвольныеКоды");
	КэшируемыеНастройки.Вставить("ГлобальныеПараметры",									"ГлобальныеПараметры");
	
    Возврат КэшируемыеНастройки;
	
КонецФункции

Функция ГлЯдро_ПолучитьЗначениеКэшируемойНастройки(КлючНастройки, ID_Узла, АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки);
	СтруктураНастроек = ГлЯдро_ПолучитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных);
	
	ЗначениеНастройки = Неопределено;
	СтруктураНастроек.Свойство(КлючНастройки, ЗначениеНастройки);
	Возврат ЗначениеНастройки;
	
КонецФункции

Функция ГлЯдро_ПолучитьЗначенияКэшируемойНастройкиПоУзлам(КлючНастройки, НастройкиПоУзлам, СписокКолонок = Неопределено, АдресаПеременных) Экспорт

	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);

    ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		И ПараметрыПодключенияMS.Свойство("Ид") Тогда
		ИдентификаторБазыMS = СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		Возврат НастройкиПоУзлам;		
	КонецЕсли;
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();		
	КонецЕсли;
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	УзловыеНастройки.Добавить("НастройкиБизнесПроцессов");
	
	Для каждого Настройка ИЗ НастройкиПоУзлам Цикл
		ID_Узла = Настройка.Ключ;
		
		ПостфиксУзла = "";
		Если ID_Узла <> "ГлавныйУзел" И УзловыеНастройки.Найти(КлючНастройки) <> Неопределено Тогда
			ПостфиксУзла = "_" + ID_Узла;
		КонецЕсли;
		
		КлючПеременной = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + КлючНастройки + ПостфиксУзла;
		
		НастройкаПоУзлу = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючПеременной);
		
		Если СписокКолонок <> Неопределено И ТипЗнч(НастройкаПоУзлу) = Тип("Массив") Тогда
			НастройкаПоУзлуСОтбором = Новый Массив;
			Для каждого СтрокаНастройки ИЗ НастройкаПоУзлу Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				НастройкаПоУзлуСОтбором.Добавить(ГлЯдро_СкопироватьСтруктуру(СтрокаНастройки, СписокКолонок));
			КонецЦикла;
			
			НастройкиПоУзлам.Вставить(ID_Узла, НастройкаПоУзлуСОтбором);
		Иначе
			НастройкиПоУзлам.Вставить(ID_Узла, НастройкаПоУзлу);
		КонецЕсли;			
			
	КонецЦикла;	
	
	Возврат НастройкиПоУзлам;
	
КонецФункции

// Получает значения кэшируемых настроек из хранилища 1С по набору ключей.
// Аналог ГлЯдро_СохранитьЗначенияКэшируемыхНастроек, но только на чтение
//
// Параметры:
//	КлючиНастроек - Структура - ключи структуры определяют имена запрашиваемых настроек, значения игнорируются
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура - ключи совпадают с переданными КлючиНастроек, значения - данные из хранилища
//				  (Неопределено, если настройка не найдена)
//
Функция ГлЯдро_ПолучитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных) Экспорт
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	КонецЕсли;
	
	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		И ПараметрыПодключенияMS.Свойство("Ид") Тогда
		ИдентификаторБазыMS = СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_");
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		Возврат СтруктураНастроек;
	КонецЕсли;
	
	КэшируемыеНастройки = ГлЯдро_ПолучитьСтруктуруКэшируемыхНастроек();
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	УзловыеНастройки.Добавить("НастройкиБизнесПроцессов");
	
	ОбщаяСтруктураЗапрошена   = Ложь;
	УзловаяСтруктураЗапрошена = Ложь;
	
	Для каждого ЗапрашиваемаяНастройка ИЗ СтруктураНастроек Цикл
		ИмяНастройкиКлюч = ЗапрашиваемаяНастройка.Ключ;
		
		ЭтоКэшируемаяНастройка = КэшируемыеНастройки.Свойство(ИмяНастройкиКлюч);
		ЭтоУзловаяНастройка    = УзловыеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено;
		
		Если ЭтоКэшируемаяНастройка Тогда
			
			КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиКлюч + ?(ЗначениеЗаполнено(ID_Узла) И ЭтоУзловаяНастройка, "_" + ID_Узла, "");
			Результат.Вставить(ИмяНастройкиКлюч, ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючНастройки));
			
		Иначе
			
			Если ЭтоУзловаяНастройка И ЗначениеЗаполнено(ID_Узла) Тогда
				
				Если НЕ УзловаяСтруктураЗапрошена Тогда
					СтруктураУзловыхНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS_" + ID_Узла);
					Если НЕ ТипЗнч(СтруктураУзловыхНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураУзловыхНастроекSMARTS = Новый Структура;
					КонецЕсли;
					УзловаяСтруктураЗапрошена = Истина;
				КонецЕсли;
				
				ЗначениеНастройки = Неопределено;
				Если СтруктураУзловыхНастроекSMARTS.Свойство(ИмяНастройкиКлюч, ЗначениеНастройки) Тогда
					Результат.Вставить(ИмяНастройкиКлюч, ЗначениеНастройки);
				Иначе
					Результат.Вставить(ИмяНастройкиКлюч, Неопределено);
				КонецЕсли;
				
			Иначе
				
				Если НЕ ОбщаяСтруктураЗапрошена Тогда
					СтруктураНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS");
					Если НЕ ТипЗнч(СтруктураНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураНастроекSMARTS = Новый Структура;
					КонецЕсли;
					ОбщаяСтруктураЗапрошена = Истина;
				КонецЕсли;
				
				ЗначениеНастройки = Неопределено;
				Если СтруктураНастроекSMARTS.Свойство(ИмяНастройкиКлюч, ЗначениеНастройки) Тогда
					Результат.Вставить(ИмяНастройкиКлюч, ЗначениеНастройки);
				Иначе
					Результат.Вставить(ИмяНастройкиКлюч, Неопределено);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ГлЯдро_СохранитьЗначениеКэшируемойНастройки(КлючНастройки, ЗначениеНастройки, ID_Узла, АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, ЗначениеНастройки);
	ГлЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных);
	
КонецПроцедуры

Процедура ГлЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_СохранитьЗначенияКэшируемыхНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла",
		СтруктураНастроек, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
    // Получаем переменные для формирования ключей настроек
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;

    ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		И ПараметрыПодключенияMS.Свойство("Ид") Тогда
		ИдентификаторБазыMS = СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	// Сохраняем переданные значения в настройки пользователя
	КэшируемыеНастройки  = ГлЯдро_ПолучитьСтруктуруКэшируемыхНастроек();
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();		
	КонецЕсли;
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	УзловыеНастройки.Добавить("НастройкиБизнесПроцессов");
	
	КлючиНастроекБизнесПроцессов = Новый Массив;
	КлючиНастроекБизнесПроцессов.Добавить("НастройкиБизнесПроцессов_ПоУмолчанию");
	КлючиНастроекБизнесПроцессов.Добавить("НастройкиБизнесПроцессов_Пользовательские");
	
	ОбщаяСтруктураЗапрошена   = Ложь;
	УзловаяСтруктураЗапрошена = Ложь;

    Для каждого СохраняемаяНастройка ИЗ СтруктураНастроек Цикл	
		ИмяНастройкиКлюч = СохраняемаяНастройка.Ключ;
		
		ЭтоКэшируемаяНастройка = КэшируемыеНастройки.Свойство(ИмяНастройкиКлюч);
		ЭтоУзловаяНастройка	   = УзловыеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено;
		
		Если ЭтоКэшируемаяНастройка Тогда // Значения настроек хранятся в отдельных ключах
			ЗначениеНастройки = СохраняемаяНастройка.Значение;
			Если КлючиНастроекБизнесПроцессов.Найти(ИмяНастройкиКлюч) <> Неопределено
				И ТипЗнч(ЗначениеНастройки) = Тип("Массив") Тогда
				ЗначениеНастройки = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(ЗначениеНастройки, ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(), АдресаПеременных);
			КонецЕсли;
			
			КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиКлюч + ?(ЗначениеЗаполнено(ID_Узла) И ЭтоУзловаяНастройка, "_" + ID_Узла, "");
			ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, ЗначениеНастройки);
		Иначе // Значения настроек хранятся в общем ключе
			Если ЭтоУзловаяНастройка И ЗначениеЗаполнено(ID_Узла) Тогда
				Если НЕ УзловаяСтруктураЗапрошена Тогда
					СтруктураУзловыхНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS_" + ID_Узла);
					Если НЕ ТипЗнч(СтруктураУзловыхНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураУзловыхНастроекSMARTS = Новый Структура;
					КонецЕсли;
					УзловаяСтруктураЗапрошена = Истина;
				КонецЕсли;	
				СтруктураУзловыхНастроекSMARTS.Вставить(ИмяНастройкиКлюч, СохраняемаяНастройка.Значение);
			Иначе
				Если НЕ ОбщаяСтруктураЗапрошена Тогда
					СтруктураНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS");
					Если НЕ ТипЗнч(СтруктураНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураНастроекSMARTS = Новый Структура;
					КонецЕсли;
					ОбщаяСтруктураЗапрошена = Истина;
				КонецЕсли;	
				СтруктураНастроекSMARTS.Вставить(ИмяНастройкиКлюч, СохраняемаяНастройка.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщаяСтруктураЗапрошена Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS", СтруктураНастроекSMARTS);
	КонецЕсли;
	Если УзловаяСтруктураЗапрошена Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS_" + ID_Узла, СтруктураУзловыхНастроекSMARTS);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Проверяет актуальность кэшируемых настроек по дате актуальности и очищает их, если они неактуальны
//
// Параметры:
//  ДатаАктуальностиВБазеSMARTS - Дата, Строка, Неопределено - значение ключа ДатаАктуальностиКэшируемыхНастроек в настройках базы Клеверенс
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Булево - Ложь, если кэшируемые настройки оказались неактуальными и были очищены
Функция ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроекПриИнициализации(ДатаАктуальностиВБазеSMARTS = Неопределено, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроекПриИнициализации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДатаАктуальностиВБазеSMARTS",
		ДатаАктуальностиВБазеSMARTS);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ДатаАктуальностиВБазеSMARTS = Неопределено Тогда
		ДатаАктуальностиВБазеSMARTS = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ДатаАктуальностиКэшируемыхНастроек",,, АдресаПеременных);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаАктуальностиВБазеSMARTS) ИЛИ ДатаАктуальностиВБазеSMARTS = Ложь Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		Возврат Истина;		
	ИначеЕсли ТипЗнч(ДатаАктуальностиВБазеSMARTS) = Тип("Строка") Тогда
		ДатаАктуальностиВБазеSMARTS = REST_API_ПреобразоватьКДате(ДатаАктуальностиВБазеSMARTS);
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;

	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_"), "");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		Возврат Истина;
	КонецЕсли;
	
	СохраненнаяДатаАктуальности = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ДатаАктуальностиКэшируемыхНастроек_" + ИдентификаторБазыMS);
	
	Если НЕ ЗначениеЗаполнено(СохраненнаяДатаАктуальности)
		ИЛИ СохраненнаяДатаАктуальности < ДатаАктуальностиВБазеSMARTS Тогда
		ГлЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS,, АдресаПеременных);
	    ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиКэшируемыхНастроек_" + ИдентификаторБазыMS, ДатаАктуальностиВБазеSMARTS);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		Возврат Ложь;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	Возврат Истина;
	
КонецФункции

Процедура ГлЯдро_ОбновитьПараметрыПодключения1С(ПервыйЗапуск = Ложь, АдресаПеременных) Экспорт

	ЗаполнитьКлюч = Истина;
	
	Если НЕ ПервыйЗапуск Тогда
		База1СПодключенаДата = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("База1СПодключенаДата",,, АдресаПеременных);
	   	ЗаполнитьКлюч = НЕ ЗначениеЗаполнено(База1СПодключенаДата) ИЛИ База1СПодключенаДата = Ложь;
	КонецЕсли;
		
	Если ЗаполнитьКлюч Тогда
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("База1СПодключенаДата", ТекущаяДата(),, АдресаПеременных);
	КонецЕсли;
	
КонецПроцедуры

Функция ГлЯдро_ПроверитьСохраненнуюСтрокуПодключения1С(АдресаПеременных)
	
	База1ССтрокаСоединенияКлиент = ГлЯдро_ПолучитьНастройкуНаСервереSMARTS("ServiceHTTPAddress",,, АдресаПеременных);
	Результат = ЗначениеЗаполнено(База1ССтрокаСоединенияКлиент) И База1ССтрокаСоединенияКлиент <> Ложь;
		
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроек(СтруктураНастроек, ID_Узла, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла",
		СтруктураНастроек, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	АктуальныеНастройки = Новый Структура;
	
	// Получаем переменные для формирования ключей настроек
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;
	
	ИдентификаторБазыMS = "";
	ВерсияПриложенияMS 	= "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_"), "");
		ВерсияПриложенияMS	= ?(ПараметрыПодключенияMS.Свойство("ВерсияПриложения"), ПараметрыПодключенияMS.ВерсияПриложения, "");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АктуальныеНастройки);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат АктуальныеНастройки;
	КонецЕсли;
	
	// Если версия продукта изменилась, очищаем все настройки в кэше
	
	СохраненнаяВерсияПриложенияMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ВерсияПриложенияMS_" + ИдентификаторБазыMS);
	Если НЕ ЗначениеЗаполнено(ВерсияПриложенияMS)
		ИЛИ НЕ ЗначениеЗаполнено(СохраненнаяВерсияПриложенияMS)
		ИЛИ ВерсияПриложенияMS <> СохраненнаяВерсияПриложенияMS Тогда
		
		ГлЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS,, АдресаПеременных);
		ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ВерсияПриложенияMS_" + ИдентификаторБазыMS, ВерсияПриложенияMS);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АктуальныеНастройки);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат АктуальныеНастройки;
		
	КонецЕсли;
	
	// Проверяем актуальность запрашиваемых настроек
	КэшируемыеНастройки = ГлЯдро_ПолучитьСтруктуруКэшируемыхНастроек();
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();		
	КонецЕсли;
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	УзловыеНастройки.Добавить("НастройкиБизнесПроцессов");
	
	ОбщаяСтруктураЗапрошена   = Ложь;
	УзловаяСтруктураЗапрошена = Ложь;
	ПроверенныеНастройки 	  = Новый Массив;	

	НекэшируемыеНастройки = Новый Массив;
	НекэшируемыеНастройки.Добавить("ДатаАктуальностиКэшируемыхНастроек");
	НекэшируемыеНастройки.Добавить("ВерсияПриложения");
	НекэшируемыеНастройки.Добавить("ВерсияПриложения_ОсновнаяОбработка");
	НекэшируемыеНастройки.Добавить("ВерсияОбработки_ОсновнаяОбработка");
	НекэшируемыеНастройки.Добавить("ПутьОсновнойОбработки");
	НекэшируемыеНастройки.Добавить("ТипОсновнойОбработки");
	НекэшируемыеНастройки.Добавить("База1СПодключенаДата");
	
	// Проверяем все настройки, а не только кэшируемые
	Для каждого ЗапрашиваемаяНастройка ИЗ СтруктураНастроек Цикл
		ИмяНастройкиКлюч = ЗапрашиваемаяНастройка.Ключ;
		Если ПроверенныеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено
			ИЛИ НекэшируемыеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяНастройкиЗначение   = Неопределено;
		ЭтоКэшируемаяНастройка = КэшируемыеНастройки.Свойство(ИмяНастройкиКлюч, ИмяНастройкиЗначение);
		ЭтоУзловаяНастройка	   = УзловыеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено;	
		
		Если ЭтоКэшируемаяНастройка Тогда
			КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиКлюч + ?(ЗначениеЗаполнено(ID_Узла) И ЭтоУзловаяНастройка, "_" + ID_Узла, "");
			ЗначениеНастройки = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючНастройки);
			
			Если ЗначениеЗаполнено(ЗначениеНастройки) Тогда
				АктуальныеНастройки.Вставить(ИмяНастройкиКлюч, ЗначениеНастройки);
			ИначеЕсли ПроверенныеНастройки.Найти(ИмяНастройкиЗначение) = Неопределено Тогда
				// Если настройка сборная, очищаем собранную структуру
				КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиЗначение + ?(ЗначениеЗаполнено(ID_Узла) И ЭтоУзловаяНастройка, "_" + ID_Узла, "");
				ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, Неопределено);
				
				ПроверенныеНастройки.Добавить(ИмяНастройкиЗначение);
			КонецЕсли;
		Иначе
			ЗначениеНастройки = Неопределено;
			Если ЭтоУзловаяНастройка И ЗначениеЗаполнено(ID_Узла) Тогда
				Если НЕ УзловаяСтруктураЗапрошена Тогда
					СтруктураУзловыхНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS_" + ID_Узла);
					Если НЕ ТипЗнч(СтруктураУзловыхНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураУзловыхНастроекSMARTS = Новый Структура;
					КонецЕсли;
					УзловаяСтруктураЗапрошена = Истина;
				КонецЕсли;	
				
				Если СтруктураУзловыхНастроекSMARTS.Свойство(ИмяНастройкиКлюч, ЗначениеНастройки) Тогда
					АктуальныеНастройки.Вставить(ИмяНастройкиКлюч, ЗначениеНастройки);	
				КонецЕсли;
			Иначе
				Если НЕ ОбщаяСтруктураЗапрошена Тогда
					СтруктураНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS");
					Если НЕ ТипЗнч(СтруктураНастроекSMARTS) = Тип("Структура") Тогда
						СтруктураНастроекSMARTS = Новый Структура;
					КонецЕсли;
					ОбщаяСтруктураЗапрошена = Истина;
				КонецЕсли;	
				
				Если СтруктураНастроекSMARTS.Свойство(ИмяНастройкиКлюч, ЗначениеНастройки) Тогда
					АктуальныеНастройки.Вставить(ИмяНастройкиКлюч, ЗначениеНастройки);	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АктуальныеНастройки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АктуальныеНастройки;
	
КонецФункции

Процедура ГлЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS = "", СтруктураНастроек = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОчиститьКэшируемыеНастройки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИдентификаторБазыMS,СтруктураНастроек",
		ИдентификаторБазыMS, СтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
        ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
			И ПараметрыПодключенияMS.Свойство("Ид") Тогда
			ИдентификаторБазыMS = СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_");
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда	
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПолнаяОчистка = СтруктураНастроек = Неопределено ИЛИ ТипЗнч(СтруктураНастроек) <> Тип("Структура");
	ВсеУзлы 	  = Новый Массив;
	
	КлючОбщейНастройки 		= "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_СтруктураНастроекSMARTS";
	СтруктураНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючОбщейНастройки);
	Если ТипЗнч(СтруктураНастроекSMARTS) = Тип("Структура") Тогда
		Если СтруктураНастроекSMARTS.Свойство("Узлы")
			И ТипЗнч(СтруктураНастроекSMARTS.Узлы) = Тип("Массив") Тогда
			ВсеУзлы = СтруктураНастроекSMARTS.Узлы;
		КонецЕсли;
		
		Если НЕ ПолнаяОчистка Тогда
			Для каждого Настройка ИЗ СтруктураНастроек Цикл
		    	СтруктураНастроекSMARTS.Удалить(Настройка.Ключ);
			КонецЦикла;
		Иначе
			СтруктураНастроекSMARTS = Неопределено;
		КонецЕсли;
	Иначе
		СтруктураНастроекSMARTS = Неопределено;
	КонецЕсли;
	
	// Очищаем настройки, хранящиеся в общем ключе
	ГлЯдро_СохранитьДанныеВХранилище1С(КлючОбщейНастройки, СтруктураНастроекSMARTS);
		
	Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл			
		Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		КлючУзловойНастройки = КлючОбщейНастройки + "_" + СтрокаУзла.ID_Узла;
		Если НЕ ПолнаяОчистка Тогда
			СтруктураНастроекSMARTS = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючУзловойНастройки);
			Если ТипЗнч(СтруктураНастроекSMARTS) = Тип("Структура") Тогда
				Для каждого Настройка ИЗ СтруктураНастроек Цикл
					СтруктураНастроекSMARTS.Удалить(Настройка.Ключ);
				КонецЦикла;
			Иначе
				СтруктураНастроекSMARTS = Неопределено;
			КонецЕсли;
		Иначе
			СтруктураНастроекSMARTS = Неопределено;
		КонецЕсли;
		
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючУзловойНастройки, СтруктураНастроекSMARTS);
	КонецЦикла;
	
	// Очищаем настройки, хранящиеся в отдельных ключах
	КэшируемыеНастройки = ГлЯдро_ПолучитьСтруктуруКэшируемыхНастроек();
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();		
	КонецЕсли;
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	УзловыеНастройки.Добавить("НастройкиБизнесПроцессов");	
	
    ОчищенныеНастройки = Новый Массив;
	Для каждого КэшируемаяНастройка ИЗ КэшируемыеНастройки Цикл
		Если ОчищенныеНастройки.Найти(КэшируемаяНастройка.Ключ)	<> Неопределено Тогда
			Продолжить;			
		КонецЕсли;
		Если НЕ ПолнаяОчистка
			И НЕ СтруктураНастроек.Свойство(КэшируемаяНастройка.Ключ) Тогда
			Продолжить;
		КонецЕсли;		
		
		ИмяНастройкиКлюч 	 = КэшируемаяНастройка.Ключ;
		ИмяНастройкиЗначение = КэшируемаяНастройка.Значение;
		
		КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиКлюч;
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, Неопределено);

        Если УзловыеНастройки.Найти(ИмяНастройкиКлюч) <> Неопределено Тогда
			Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл			
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиКлюч + "_" + СтрокаУзла.ID_Узла;
				ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, Неопределено);
			КонецЦикла;
		КонецЕсли;
				
		ОчищенныеНастройки.Добавить(ИмяНастройкиКлюч);
		
		Если ОчищенныеНастройки.Найти(ИмяНастройкиЗначение) = Неопределено Тогда
			КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиЗначение;
			ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, Неопределено);
			
			Если УзловыеНастройки.Найти(ИмяНастройкиЗначение) <> Неопределено Тогда
				Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл			
					Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					КлючНастройки = "Cleverence_КэшируемыеНастройки_" + ИдентификаторБазыMS + "_" + ИмяНастройкиЗначение + "_" + СтрокаУзла.ID_Узла;
					ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, Неопределено);
				КонецЦикла;
			КонецЕсли;
			
			ОчищенныеНастройки.Добавить(ИмяНастройкиЗначение);
		КонецЕсли;
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура ГлЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов(КлючНастройки, АдресаПеременных)

	ГлЯдро_СохранитьЗначениеКэшируемойНастройки(КлючНастройки, Неопределено, "", АдресаПеременных);
	
	ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			Конецесли;
			ГлЯдро_СохранитьЗначениеКэшируемойНастройки(КлючНастройки, Неопределено, СтрокаУзла.ID_Узла, АдресаПеременных);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ГлЯдро_ОчиститьХранилищеОбщихНастроек1С() Экспорт
	
	МассивКлючей = Новый Массив;
	МассивКлючей.Добавить("Cleverence_ПараметрыПодключенияMS");		
	МассивКлючей.Добавить("Cleverence_РасположениеКомпоненты");
	МассивКлючей.Добавить("Cleverence_ДатаАктуальностиКэша");
	МассивКлючей.Добавить("Cleverence_СтруктураМетаданныхДокументы1С");
	МассивКлючей.Добавить("Cleverence_СтруктураНастроек");
	МассивКлючей.Добавить("Cleverence_СтруктураМетаданныхДокументыMS");
	МассивКлючей.Добавить("Cleverence_ПользователиMS");
	МассивКлючей.Добавить("Cleverence_ТаблицыMS");
	МассивКлючей.Добавить("Cleverence_ИмяИнтеграционнойОбработки");
	МассивКлючей.Добавить("Cleverence_РежимВыбораБазы");
	МассивКлючей.Добавить("Cleverence_ТипИнтерфейса");
	МассивКлючей.Добавить("Cleverence_ИмяИнтеграционнойОбработки");
	
	Попытка
		КлючиНастроек = ХранилищеОбщихНастроек.Загрузить("Cleverence_КлючиНастроек",,,ПараметрыСеанса.ТекущийПользователь.Наименование);
		Если ТипЗнч(КлючиНастроек) = Тип("Массив") Тогда
			Для каждого КлючНастройки ИЗ КлючиНастроек Цикл		
				Если МассивКлючей.Найти(КлючНастройки) = Неопределено Тогда
					МассивКлючей.Добавить(КлючНастройки);				
                КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	Попытка
		КлючиНастроек = ХранилищеОбщихНастроек.Загрузить("Cleverence_КлючиНастроек",,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
		Если ТипЗнч(КлючиНастроек) = Тип("Массив") Тогда
			Для каждого КлючНастройки ИЗ КлючиНастроек Цикл		
				Если МассивКлючей.Найти(КлючНастройки) = Неопределено Тогда
					МассивКлючей.Добавить(КлючНастройки);				
                КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	Попытка
		КлючиНастроек = ХранилищеОбщихНастроек.Загрузить("Cleverence_КлючиНастроек");
		Если ТипЗнч(КлючиНастроек) = Тип("Массив") Тогда
			Для каждого КлючНастройки ИЗ КлючиНастроек Цикл		
				Если МассивКлючей.Найти(КлючНастройки) = Неопределено Тогда
					МассивКлючей.Добавить(КлючНастройки);				
                КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	Для Каждого КлючОчистки Из МассивКлючей Цикл
		Попытка
			ХранилищеОбщихНастроек.Удалить(КлючОчистки,"","");
		Исключение
		КонецПопытки;
		Попытка				
			ХранилищеОбщихНастроек.Удалить(КлючОчистки,"",ПараметрыСеанса.ТекущийПользователь.Наименование);
		Исключение
		КонецПопытки;
		Попытка				
			ХранилищеОбщихНастроек.Удалить(КлючОчистки,"",ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
 
Функция ГлЯдро_ПолучитьВременныйMSToken1C(АдресаПеременных = Неопределено) Экспорт
	
	MSToken = "3758b00f0e7b5d5c54860c5e59c1c7";
	
	Возврат MSToken;	
КонецФункции

Функция ГлЯдро_ПолучитьВерсиюКонфигурацииSMARTS(АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ПолучитьВерсиюКонфигурацииSMARTS";
	
	ВерсияКонфигурацииSMARTS = 0;
		
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииSMARTS);
	КонецЕсли;
	
	Попытка
		ВерсияКонфигурацииSMARTS = Число(ВерсияКонфигурацииSMARTS);
	Исключение
		ВерсияКонфигурацииSMARTS = 0;
	КонецПопытки;	
	
	Возврат ВерсияКонфигурацииSMARTS;	
	
КонецФункции

Функция ГлЯдро_ВерсияAPIПоДаннымБазыSMARTS(ВерсияПлатформыSMARTS = Неопределено, АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ВерсияAPIПоДаннымБазыSMARTS";
	
	Если ВерсияПлатформыSMARTS = Неопределено Тогда
		
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
			ПараметрыПодключенияMS.Свойство("ВерсияПлатформыSMARTS", ВерсияПлатформыSMARTS);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВерсияПлатформыSMARTS = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Версия_REST_API = 1;
	
	ЧастиВерсии = ГлЯдро_СтрРазделить(ВерсияПлатформыSMARTS, ".");
	
	Попытка
		Если Число(ЧастиВерсии[0]) >= 4 Тогда
			Версия_REST_API = 2;
		КонецЕсли;
	Исключение
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),, АдресаПеременных);
	КонецПопытки;
	
	Возврат Версия_REST_API;
	
КонецФункции

// Возвращаемое значение:
//   Структура:
//		- Ключ - ключ настройки
//		- Значение - значение по умолчанию
//
Функция ГлЯдро_СтруктураКонтролируемыхНастроек()

	КонтролируемыеНастройки = Новый Структура;
	КонтролируемыеНастройки.Вставить("РаботаБезАлкоголя", Ложь);
	
	Возврат КонтролируемыеНастройки;
	
КонецФункции

Процедура ГлЯдро_ПроверитьЗначенияТекущихНастроек(ИзмененияВНастройках, АдресаПеременных)
	
	Если ИзмененияВНастройках = Неопределено Тогда
		ИзмененияВНастройках = Новый Структура;
	КонецЕсли;
	
	КонтролируемыеНастройки = ГлЯдро_СтруктураКонтролируемыхНастроек();
	Для каждого Настройка ИЗ КонтролируемыеНастройки Цикл
		ЗначениеНастройки = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(Настройка.Ключ,, АдресаПеременных);
		
		Если ЗначениеНастройки = Неопределено Тогда // При необходимости можно предусмотреть проверку на разные значения, а не только Неопределено
			ИзмененияВНастройках.Вставить(Настройка.Ключ, Настройка.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьИдентификаторыНастроекMS(АдресаПеременных)
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ИдентификаторыНастроекMS = КомЯдро_ПолучитьЗначениеПеременной(КлючНастройки, АдресаПеременных);
	Если ИдентификаторыНастроекMS = Неопределено Тогда
		ИдентификаторыНастроекMS = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючНастройки);
		
		Если НЕ ИдентификаторыНастроекMS = Неопределено Тогда
			КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, ИдентификаторыНастроекMS, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИдентификаторыНастроекMS;
	
КонецФункции

Функция ГлЯдро_ПолучитьИдентификаторНастройкиНаСервереSMARTS(КлючНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	СтруктураИдентификаторов = Новый Структура(КлючНастройки, Неопределено);
	СтруктураИдентификаторов = ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураИдентификаторов, ID_Узла, ДополнительныеПараметры, АдресаПеременных);
	
	Возврат СтруктураИдентификаторов[КлючНастройки];
	
КонецФункции

Функция ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроек, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Получение uid настроек на сервере SMARTS';
						|en = 'Getting started, Getting the uid settings on the Cleverence server'; be = 'Пачатак, атрыманне UID налад на сэрвэры Cleverence'; es = 'Inicio, Obtener la configuración uid en el servidor Cleverence'; ka = 'მიღება დაიწყო, მიღების uid პარამეტრების Cleverence სერვერზე'; kk = 'Бастау, Cleverence серверінде uid параметрлерін алу'; ro = 'Noțiuni de bază, obținerea setărilor uid pe serverul Cleverence'; tr = 'Başlangıç, Cleverence sunucusundaki ayarların uıd''sini alma'; uk = 'Початок, отримання UID налаштувань на сервері Cleverence'; uz = 'Boshlash, Cleverence serverida uid sozlamalarini olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	СтруктураИдентификаторов = Новый Структура;
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеПроверятьАктуальность = ДополнительныеПараметры.Свойство("НеПроверятьАктуальность") И ДополнительныеПараметры.НеПроверятьАктуальность;
	НеИспользоватьАтрибуты	= ДополнительныеПараметры.Свойство("НеИспользоватьАтрибуты") И ДополнительныеПараметры.НеИспользоватьАтрибуты;
	
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	
	// Проверяем сохраненные идентификаторы настроек MS
	ИдентификаторыНастроекMS = ГлЯдро_ПолучитьИдентификаторыНастроекMS(АдресаПеременных);
	
	Если ИдентификаторыНастроекMS = Неопределено ИЛИ НеПроверятьАктуальность Тогда
		НастройкиКПолучению = ГлЯдро_СкопироватьСтруктуру(СтруктураНастроек);
	Иначе
		НастройкиКПолучению = Новый Структура;
		Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
			ИтоговыйКлючНастройки = СтрокаНастройки.Ключ;
			Если НЕ УзловыеНастройки.Найти(СтрокаНастройки.Ключ) = Неопределено Тогда
				ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
			КонецЕсли;
			
			ИдентификаторНастройки = Неопределено;
			Если НЕ ИдентификаторыНастроекMS.Свойство(ИтоговыйКлючНастройки, ИдентификаторНастройки)
				ИЛИ ИдентификаторНастройки = Неопределено Тогда
				НастройкиКПолучению.Вставить(СтрокаНастройки.Ключ);
			КонецЕсли;
			
			СтруктураИдентификаторов.Вставить(ИтоговыйКлючНастройки, ИдентификаторНастройки);
		КонецЦикла;
	КонецЕсли;
	
	// Получаем настройки MS для сохранения недостающих идентификаторов
	Если НастройкиКПолучению.Количество() Тогда
		ПараметрыПолученияНастроек = Новый Структура;
		ПараметрыПолученияНастроек.Вставить("НеКэшировать", 			Истина);
		ПараметрыПолученияНастроек.Вставить("НеПроверятьАктуальность", 	Истина);
		ПараметрыПолученияНастроек.Вставить("НеИспользоватьАтрибуты", 	НеИспользоватьАтрибуты);
		
		Если ДополнительныеПараметры.Свойство("АтрибутыНастроекMS") Тогда
			ПараметрыПолученияНастроек.Вставить("АтрибутыНастроекMS", ДополнительныеПараметры.АтрибутыНастроекMS);
		КонецЕсли;
		
		ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению, КатегорииНастроекMS, ID_Узла, ПараметрыПолученияНастроек, АдресаПеременных);
		ИдентификаторыНастроекMS = ГлЯдро_ПолучитьИдентификаторыНастроекMS(АдресаПеременных);
		
		Если ИдентификаторыНастроекMS = Неопределено Тогда
			ИдентификаторыНастроекMS = Новый Структура;
		КонецЕсли;
		
		Для каждого СтрокаНастройки ИЗ НастройкиКПолучению Цикл
			ИтоговыйКлючНастройки = СтрокаНастройки.Ключ;
			Если НЕ УзловыеНастройки.Найти(СтрокаНастройки.Ключ) = Неопределено Тогда
				ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
			КонецЕсли;
			
			ИдентификаторНастройки = Неопределено;
			СтруктураИдентификаторов.Вставить(ИтоговыйКлючНастройки, ?(ИдентификаторыНастроекMS.Свойство(ИтоговыйКлючНастройки, ИдентификаторНастройки),
				ИдентификаторНастройки, Неопределено));
		КонецЦикла;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Получение uid настроек на сервере SMARTS';
						|en = 'Finally, Getting the uid settings on the Cleverence server'; be = 'Канец, атрыманне UID налад на сэрвэры Cleverence'; es = 'Fin, Obtener la configuración uid en el servidor Cleverence'; ka = 'და ბოლოს, მიღების uid პარამეტრების Cleverence სერვერზე'; kk = 'Соңы, Cleverence серверінде uid параметрлерін алу'; ro = 'În cele din urmă, obținerea setărilor uid pe serverul Cleverence'; tr = 'Son, Cleverence sunucusundaki ayarların uıd''sini alma'; uk = 'Кінець, отримання UID налаштувань на сервері Cleverence'; uz = 'Tugatish, Cleverence serverida uid sozlamalarini olish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураИдентификаторов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураИдентификаторов;
	
КонецФункции

#КонецОбласти

#Область ГлобальныйКонтекст_Настройки_УстановкаНастроек

// Вызывает процедуру сохранения настроек в базе Клеверенс
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо сохранить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_СохранитьНастройкиВБазеSMARTS(Знач СтруктураНастроек, ID_Узла = "", ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СохранитьНастройкиВБазеSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Запись настроек в базу SMARTS';
						|en = 'Getting started, Writing settings to the Cleverence database'; be = 'Пачатак, Запіс налад у базу Cleverence'; es = 'Inicio, Escribir la configuración en la base de Cleverence'; ka = 'ნაცნობობა, წერა პარამეტრების Cleverence მონაცემთა ბაზაში'; kk = 'Бастау, Cleverence базасына параметрлерді жазу'; ro = 'Noțiuni de bază, scrierea setărilor în baza de date Cleverence'; tr = 'Başlangıç, Ayarları Cleverence veritabanına kaydetme'; uk = 'Початок, запис налаштувань в базу Cleverence'; uz = 'Boshlash, sozlamalarni Cleverence bazasiga yozish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	ДополнительныеПараметры 	= ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеКэшировать 				= ДополнительныеПараметры.Свойство("НеКэшировать") И ДополнительныеПараметры.НеКэшировать;
	СериализуемыеНастройки 	= Неопределено;
	ДополнительныеПараметры.Свойство("СериализуемыеНастройки", СериализуемыеНастройки);
	
	КатегорииНастроекMS = Неопределено;
	ДополнительныеПараметры.Свойство("КатегорииНастроекMS", КатегорииНастроекMS);
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS", АдресаПеременных);
		Если КатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
		КонецЕсли;
	КонецЕсли;
	
	СтруктураНастроекДляКэширования = ГлЯдро_СкопироватьСтруктуру(СтруктураНастроек);
	
	СтруктураНастроекДляЗаписи = ГлЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, "ВСтроку", СериализуемыеНастройки);
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		REST_API_ЗаписатьНастройкиSMARTS(СтруктураНастроекДляЗаписи, КатегорииНастроекMS, ID_Узла, СтруктураНастроекДляКэширования, ДополнительныеПараметры, АдресаПеременных);
	Иначе	
		КомЯдро_ЗаписатьНастройкиSMARTS(СтруктураНастроекДляЗаписи, КатегорииНастроекMS, ID_Узла, СтруктураНастроекДляКэширования, ДополнительныеПараметры, АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Запись настроек в базу SMARTS';
						|en = 'End, Write settings to the Cleverence database'; be = 'Канец, запіс налад у базу Cleverence'; es = 'Fin, Escribir la configuración en la base de Cleverence'; ka = 'ბოლოს, დაწერეთ პარამეტრები Cleverence მონაცემთა ბაზაში'; kk = 'Соңы, Cleverence базасына параметрлерді жазу'; ro = 'Sfârșit, scrieți setări în baza de date Cleverence'; tr = 'Son, Ayarları Cleverence veritabanına kaydetme'; uk = 'Кінець, запис налаштувань в базу Cleverence'; uz = 'Tugatish, sozlamalarni Cleverence bazasiga yozish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Вызывает процедуру сохранения настройки в базе Клеверенс по ключу
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, значение которой необходимо сохранить
//	ЗначениеНастройки - Произвольный - значение настройки
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_СохранитьНастройкуВБазеSMARTS(КлючНастройки, ЗначениеНастройки, ID_Узла = "", АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, ЗначениеНастройки);
	ГлЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_Узла,, АдресаПеременных);
	
КонецПроцедуры

// Обновляет значения текущих настроек Клеверенс во временном хранилище переданными значениями настроек
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо сохранить
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек, АдресаПеременных) Экспорт
	
	ТекущиеНастройкиMS = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS", АдресаПеременных);
	Если ТипЗнч(ТекущиеНастройкиMS) <> Тип("Структура") Тогда
		ТекущиеНастройкиMS = Новый Структура;
	КонецЕсли;
	
	Для Каждого Настройка Из СтруктураНастроек Цикл
		ТекущиеНастройкиMS.Вставить(Настройка.Ключ, Настройка.Значение);
	КонецЦикла;
	КомЯдро_СохранитьЗначениеПеременной("ТекущиеНастройкиMS", ТекущиеНастройкиMS, АдресаПеременных);
	
КонецПроцедуры

// Обновляет значение текущей настройки Клеверенс во временном хранилище переданным значением
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, значение которой необходимо сохранить
//  ЗначениеНастройки - Произвольный - значение настройки
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_ЗаписатьВКэшНастройкуSMARTS(КлючНастройки, ЗначениеНастройки,АдресаПеременных) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, ЗначениеНастройки);
	ГлЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек,АдресаПеременных);
	
КонецПроцедуры

// Получает данные текущего узла из массива со списком узлов и сохраняет их в кэш
//
// Параметры:
//	mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//  ФорматXml - Булево - определяет, передана строка mXmlDoc в формате XML (Истина) или JSON (Ложь)
//  Интерактивно - Булево - флаг работы в интерактивном режиме
//  ТипИнтерфейса - Строка - "REST_API", "COM"
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Булево - признак наличия частной базы
Функция ГлЯдро_УстановитьДанныеТекущегоУзла(mXmlDoc,ФорматXml = Истина,Интерактивно=Ложь, ТипИнтерфейса="", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_УстановитьДанныеТекущегоУзла";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"mXmlDoc,ФорматXml,Интерактивно,ТипИнтерфейса",
		mXmlDoc, ФорматXml, Интерактивно, ТипИнтерфейса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Сравнить, и при необходимости изменить текущий узел
	Если ФорматXml Тогда
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);
		ИспJSON_mXmlDoc = КомЯдро_ПолучитьЗначениеПеременной("ИспJSON_mXmlDoc",АдресаПеременных);
		
		Если ИспJSON_mXmlDoc = Истина
			ИЛИ (ИспJSON_mXmlDoc = Неопределено И ТипИнтерфейса = "REST_API") Тогда
			SessionSMARTS = ГлЯдро_ЗагрузитьИзJSON(mXmlDoc);
			
			camelCase = Ложь;
			Попытка				
				Если SessionSMARTS.Получить("deviceInfo") <> Неопределено Тогда
					camelCase = Истина;
				КонецЕсли;
			Исключение
				ОписаниеОшибкиONLEX = Новый Структура;
				ОписаниеОшибкиONLEX.Вставить("КодОшибкиONLEX", "ONLEX006");
				
				КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", ОписаниеОшибкиONLEX, АдресаПеременных);
			КонецПопытки;
			
			Попытка
				ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
				Если ЯзыкПлатформыMS = "EN" Тогда
					ИмяПоляИдУзла = "NodeId";
				Иначе
					ИмяПоляИдУзла = "ИдУзла";
				КонецЕсли;
				
				ID_Узла = SessionSMARTS[
					?(camelCase, "deviceInfo", "DeviceInfo")][ИмяПоляИдУзла];
				Если ID_Узла = Неопределено Тогда ID_Узла = ""; КонецЕсли;
			Исключение
				ID_Узла = "";			
			КонецПопытки;
		Иначе
			пСообщение = НСтр("ru = 'Получаем SessionSMARTS из XML, через ЗагрузитьОбъектИз_XML, mXmlDoc: %1';
								|en = 'Getting SessionSMARTS from XML, via Upload object_xml, mXmlDoc: %1';
								|be = 'Атрымліваем SessionSMARTS з XML, праз ЗагрузитьОбъектИз_XML, mXmlDoc: %1'; es = 'Obtenemos SessionSMARTS de XML, a través de Cargarobjetodes_xml, mXmlDoc: %1'; ka = 'ჩვენ მივიღებთ SessionSMARTS საწყისი XML, მეშვეობით ატვირთეთ object_xml, mXmlDoc: %1'; kk = 'Біз XML-ден SessionSMARTS аламыз, арқылы Жүктеу_xml нысаны, mXmlDoc: %1'; ro = 'Primim SessionSMARTS din XML, prin upload object_xml, mxmldoc: %1'; tr = 'Sessionsmarts''ı xml''den yükleyerek alıyoruz nesneler_xml, mXmlDoc: %1'; uk = 'Отримуємо SessionSMARTS з XML, через Завантажитиоб''єктиз_xml, mXmlDoc: %1'; uz = 'Biz SESSIONSMARTS-ni XML-dan olamiz, orqali Yuklash_xml ob''ekti, mxmldoc: %1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(mXmlDoc));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
			SessionSMARTS = СтруктураПодключенияБазыMS.StorageConnector.ЗагрузитьОбъектИз_XML(mXmlDoc);
			
			пСообщение = НСтр("ru = 'Получили SessionSMARTS %1';
								|en = 'Received SessionSMARTS %1'; be = 'Атрымалі SessionSMARTS %1'; es = 'Tiene SessionSMARTS %1'; ka = 'მიღებული SessionSMARTS %1'; kk = 'Sessionsmarts %1 Алды'; ro = 'Sessionsmarts Primite %1'; tr = 'Alınan SessionSMARTS %1'; uk = 'Отримали SessionSMARTS %1'; uz = 'SessionSMARTS %1 Ni Oldi'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(SessionSMARTS));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
			Если ТипЗнч(SessionSMARTS) = Тип("COMОбъект") Тогда							
				Попытка				
					ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
					Если ЯзыкПлатформыMS = "EN" Тогда
						ИмяПоляИдУзла = "NodeId";
					Иначе
						ИмяПоляИдУзла = "ИдУзла";
					КонецЕсли;
					
					Если  SessionSMARTS.DeviceInfo <> Неопределено 
						И  SessionSMARTS.DeviceInfo <> "Null" Тогда 
						ID_Узла = SessionSMARTS.DeviceInfo.ПолучитьПоле(ИмяПоляИдУзла);
						Если ID_Узла = Неопределено Тогда ID_Узла = ""; КонецЕсли;
					Иначе
						ID_Узла = "";	
					КонецЕсли;
				Исключение
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
					// </Лог>
					ID_Узла = "";
				КонецПопытки;
			Иначе
				ID_Узла = "";
			КонецЕсли;
		КонецЕсли;
	Иначе
		ID_Узла = mXmlDoc;
	КонецЕсли;
		
	ЭтоВнешнееСоединение = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	ИспользоватьКэш = ЭтоWebСервис или ЭтоВнешнееСоединение;
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла",АдресаПеременных);
	
	Если НЕ ФорматXml 
		ИЛИ(ДанныеТекущегоУзла <> Неопределено И ID_Узла <> ДанныеТекущегоУзла.ID_Узла) Тогда
		// изменяем данные текущего узла
		ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",,АдресаПеременных);
		Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			ДанныеУзла = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы,"ID_Узла",ID_Узла);
		КонецЕсли;
		Если ТипЗнч(ДанныеУзла) = Тип("Структура") Тогда
			ДанныеТекущегоУзла.Вставить("ID_Узла",      ДанныеУзла.ID_Узла);
			ДанныеТекущегоУзла.Вставить("Наименование", ДанныеУзла.Наименование);
			ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS",    ДанныеУзла.ЧастнаяБазаMS);
			ЕстьЧастнаяБаза = ДанныеУзла.ИспользоватьЧастнуюБазу;
			Если ТипЗнч(ДанныеУзла.ЧастнаяБазаMS) = Тип("Структура")
				И ЕстьЧастнаяБаза
				И НЕ Интерактивно Тогда
				ГлЯдро_ПроверитьСоединениеССерверомSMARTS(ДанныеУзла.ЧастнаяБазаMS,Истина,"Частная",Ложь,Ложь,,АдресаПеременных);
				пСообщение = НСтр("ru = 'Проверить соединение с ЧБ, %1';
									|en = 'Check connection to Private Database, %1'; be = 'Праверыць злучэнне з прыватная база, %1'; es = 'Comprobar la conexión con base Privada, %1'; ka = 'შეამოწმეთ კავშირი კერძო მონაცემთა ბაზასთან, %1'; kk = 'Байланысты тексеріңіз жеке база, %1'; ro = 'Verificați conexiunea la baza de date privată, %1'; tr = 'İle bağlantıyı kontrol edin Özel Taban, %1'; uk = 'Перевірити з''єднання з приватна база, %1'; uz = 'Maxfiy ma''lumotlar bazasiga ulanishni tekshiring, %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ДанныеУзла.ЧастнаяБазаMS));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
            КонецЕсли;
		Иначе
			ДанныеТекущегоУзла.Вставить("ID_Узла",      "");
			ДанныеТекущегоУзла.Вставить("Наименование", "");
			ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS",    "");
			ЕстьЧастнаяБаза = Ложь;
		КонецЕсли;
		
		КомЯдро_СохранитьЗначениеПеременной("ЕстьЧастнаяБаза", ЕстьЧастнаяБаза, АдресаПеременных);
		КомЯдро_СохранитьЗначениеПеременной("ДанныеТекущегоУзла", ДанныеТекущегоУзла, АдресаПеременных);
		
		КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS",АдресаПеременных);
		// закачиваем в кэш узловые настройки
		Если ИспользоватьКэш Тогда
			СтруктураНастроек = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS_" + ?(ЗначениеЗаполнено(ID_Узла), ID_Узла, "ГлавныйУзел"), АдресаПеременных);
			Если СтруктураНастроек = Неопределено Тогда
				СтруктураНастроек = ГлЯдро_СобратьСтруктуруНастроекИзКэша(ID_Узла, АдресаПеременных);
				КомЯдро_СохранитьЗначениеПеременной("ТекущиеНастройкиMS_" + ?(ЗначениеЗаполнено(ID_Узла), ID_Узла, "ГлавныйУзел"), СтруктураНастроек, АдресаПеременных);
				пСообщение = НСтр("ru = 'Получение структуры настроек из настроек пользователя, ИдУзла = %1';
									|en = 'Getting the structure of the settings from the user''s settings, Node = %1';
									|be = 'Атрыманне структуры налад з налад карыстальніка, ИдУзла = %1'; es = 'Obtener la estructura de configuración de la configuración del usuario, Idnode = %1'; ka = 'მომხმარებლის პარამეტრებიდან პარამეტრების სტრუქტურის მიღება, ID Node = %1'; kk = 'Пайдаланушы параметрлерінен параметрлер құрылымын алу = %1'; ro = 'Obținerea structurii setărilor din setările utilizatorului, nod = %1'; tr = 'Ayarların yapısını kullanıcı ayarlarından alma, IdUzla = %1'; uk = 'Отримання структури налаштувань з налаштувань Користувача, Ідузла = %1'; uz = 'Foydalanuvchi sozlamalaridan Sozlamalar tuzilishini olish, Iduzla = %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Узла));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			КонецЕсли;
		Иначе
			// Вызывается из ГлЯдро_ПолучитьДанныеДляИнициализации, где настройки уже получены с сервера
			СтруктураНастроек = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS", АдресаПеременных);
		КонецЕсли;
		
		ГлЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек, АдресаПеременных);
		
		Если ИспользоватьКэш Тогда
			Если НЕ СтруктураНастроек.Свойство("НастройкиБизнесПроцессов") ИЛИ СтруктураНастроек.НастройкиБизнесПроцессов = Ложь Тогда
				ГлЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(АдресаПеременных);
				СтруктураНастроек.Вставить("НастройкиБизнесПроцессов", ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",, АдресаПеременных));
			КонецЕсли;
			Если НЕ СтруктураНастроек.Свойство("ПроизвольныеКоды") ИЛИ СтруктураНастроек.ПроизвольныеКоды = Ложь Тогда
				ГлЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(АдресаПеременных);
				СтруктураНастроек.Вставить("ПроизвольныеКоды", ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды",, АдресаПеременных));
			КонецЕсли;
			Если НЕ СтруктураНастроек.Свойство("ГлобальныеПараметры") ИЛИ СтруктураНастроек.ГлобальныеПараметры = Ложь Тогда
				ГлЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров(АдресаПеременных);
				СтруктураНастроек.Вставить("ГлобальныеПараметры", ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры",, АдресаПеременных));
			КонецЕсли;
			Если ЗначениеЗаполнено(ID_Узла) Тогда
				Если НЕ СтруктураНастроек.Свойство("НастройкиОтборовСобраны") ИЛИ НЕ СтруктураНастроек["НастройкиОтборовСобраны"] = Истина Тогда
					ГлЯдро_СобратьОбщуюСтруктуруОтборов("Онлайн", ID_Узла, АдресаПеременных);
					СтруктураНастроек.Вставить("НастройкиОтборовУзлов_Онлайн", ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Онлайн",, АдресаПеременных));
					СтруктураНастроек.Вставить("НастройкиОтборовСобраны", Истина);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ГлЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(АдресаПеременных);
			ГлЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(АдресаПеременных);
			ГлЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров(АдресаПеременных);
			ГлЯдро_СобратьОбщуюСтруктуруОтборов("Интерактивный", ID_Узла, АдресаПеременных);
			ГлЯдро_СобратьОбщуюСтруктуруОтборов("Онлайн", ID_Узла, АдресаПеременных);
        КонецЕсли;

		пСообщение = НСтр("ru = 'ЕстьЧастнаяБаза %1';
							|en = 'There is a partial base %1'; be = 'Ёсцьчастнаябаза %1'; es = 'Hay una parteabase %1'; ka = 'არსებობს ნაწილობრივი ბაზა %1'; kk = 'Баржеке база %1'; ro = 'Există o bază parțială %1'; tr = 'vardırözelbaz %1'; uk = 'Єчастна база %1'; uz = 'U yerdabaza %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ЕстьЧастнаяБаза));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЕстьЧастнаяБаза);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ЕстьЧастнаяБаза;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Ложь;
	
КонецФункции

Процедура ГлЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПодключенныеБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПодключенныеБазыMS");
	Если ПодключенныеБазыMS = Неопределено Тогда
		ПодключенныеБазыMS = Новый Соответствие;
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("ЗаменитьИдБазы")
		И ЗначениеЗаполнено(ДополнительныеПараметры.ЗаменитьИдБазы) Тогда
		
		Если ПодключенныеБазыMS.Получить(ДополнительныеПараметры.ЗаменитьИдБазы) <> Неопределено Тогда
			ПодключенныеБазыMS.Удалить(ДополнительныеПараметры.ЗаменитьИдБазы);
		КонецЕсли;
		
	КонецЕсли;
	
	ПодключенныеБазыMS.Вставить(ПараметрыПодключенияMS.Ид, ПараметрыПодключенияMS.Имя);
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПодключенныеБазыMS", ПодключенныеБазыMS);
	
	КлючПодключения = "Cleverence_ПараметрыПодключенияMS_" + ПараметрыПодключенияMS.Ид;
	ГлЯдро_СохранитьДанныеВХранилище1С(КлючПодключения, ПараметрыПодключенияMS);
	
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ID_ТекущейБазы", ПараметрыПодключенияMS.Ид);
	
КонецПроцедуры 

Процедура ГлЯдро_УдалитьБазуИзСпискаПодключенныхБазMS(ИдентификаторБазыMS, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_УдалитьБазуИзСпискаПодключенныхБазMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИдентификаторБазыMS,ДополнительныеПараметры",
		ИдентификаторБазыMS, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПодключенныеБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПодключенныеБазыMS");
	Если ПодключенныеБазыMS = Неопределено Тогда
		ПодключенныеБазыMS = Новый Соответствие;
	КонецЕсли;
	ПодключенныеБазыMS.Удалить(ИдентификаторБазыMS);
	ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПодключенныеБазыMS", ПодключенныеБазыMS);
	
	КомЯдро_СохранитьЗначениеПеременной("ПодключенныеБазыMS", ПодключенныеБазыMS, АдресаПеременных);
	
	// Удаляем настройки из хранилища 1С для удаленной базы
	ГлЯдро_ОчиститьНастройкиХранилища1С(ИдентификаторБазыMS);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Получает ПараметрыПодключенияMS для переданного ИД базы или текущей базы
//
// Параметры:
//  ИдентификаторБазыMS - Строка - Необязательный. Ид базы для которой необходимо получить параметры. Если Неопределено, то получает для текущей из Cleverence_ID_ТекущейБазы
//  ДополнительныеПараметры - Произвольный
// 
Функция ГлЯдро_ПолучитьПараметрыПодключенияMS(ИдентификаторБазыMS = Неопределено, ДополнительныеПараметры = Неопределено, АдресаПеременных = Неопределено) Экспорт
	
	Перем НеКэшировать;
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры.Свойство("НеКэшировать", НеКэшировать);
	КонецЕсли;
	
	СохранитьВКэше = Ложь;
	Если ИдентификаторБазыMS = Неопределено	И АдресаПеременных <> Неопределено Тогда
		ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
		
		Если НЕ НеКэшировать = Истина Тогда
			СохранитьВКэше = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		ПараметрыПодключенияMS = Неопределено;
	Иначе
		КлючПодключения = "Cleverence_ПараметрыПодключенияMS_" + ИдентификаторБазыMS;
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьДанныеИзХранилища1С(КлючПодключения);
	КонецЕсли;
	
	// Для совместимости получаем параметры по старому ключу
	Если НЕ ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПараметрыПодключенияMS");
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
			И (ИдентификаторБазыMS = Неопределено
				ИЛИ ИдентификаторБазыMS = ПараметрыПодключенияMS.Ид) Тогда
				
				ГлЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
				ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ID_ТекущейБазы", ПараметрыПодключенияMS.Ид);
				
		Иначе
			ПараметрыПодключенияMS = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если СохранитьВКэше И ПараметрыПодключенияMS <> Неопределено Тогда
		КомЯдро_СохранитьЗначениеПеременной("ID_ТекущейБазы", ПараметрыПодключенияMS.Ид, АдресаПеременных);
	КонецЕсли;
	
	Возврат ПараметрыПодключенияMS;
	
КонецФункции

Функция ГлЯдро_ПолучитьПараметрыПодключенныхБазMS(ДополнительныеПараметры = Неопределено) Экспорт
	
	ПодключенныеБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПодключенныеБазыMS");
	Если ПодключенныеБазыMS = Неопределено Тогда
		ПодключенныеБазыMS = Новый Соответствие;
	КонецЕсли;
	
	Для каждого КлючЗначение Из ПодключенныеБазыMS Цикл
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(КлючЗначение.Ключ, ДополнительныеПараметры);
		ПодключенныеБазыMS.Вставить(КлючЗначение.Ключ, ПараметрыПодключенияMS);
	КонецЦикла;
	
	Возврат ПодключенныеБазыMS;
	
КонецФункции 

// Сохраняет переданные настройки в хранилище общих настроек
//
// Параметры:
// 	 КлючДляСохранения - Строка - ключ настройки для сохранения
//   ДанныеДляСохранения - Произвольный - значение настройки для сохранения
Процедура ГлЯдро_СохранитьДанныеВХранилище1С(КлючДляСохранения, ДанныеДляСохранения, СохранитьОбщуюНастройку = Ложь) Экспорт
	
	// Работаем только с пользовательскими настройками
	Если Ложь И ПравоДоступа("АдминистрированиеДанных", Метаданные) Тогда
		ХранилищеОбщихНастроек.Сохранить(КлючДляСохранения, "", ДанныеДляСохранения,, "");
		
		ХранилищеОбщихНастроек.Сохранить(КлючДляСохранения, "", ДанныеДляСохранения);
		
		Если ДанныеДляСохранения = Неопределено Тогда
			ХранилищеОбщихНастроек.Сохранить(КлючДляСохранения, "", ДанныеДляСохранения,, ГлЯдро_ПолучитьНаименованиеТекущегоПользователя());
		КонецЕсли;
		
	ИначеЕсли СохранитьОбщуюНастройку Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ХранилищеОбщихНастроек.Сохранить(КлючДляСохранения, "", ДанныеДляСохранения,, "");
		УстановитьПривилегированныйРежим(Ложь);
		
	Иначе
		ХранилищеОбщихНастроек.Сохранить(КлючДляСохранения, "", ДанныеДляСохранения);
	КонецЕсли;
	
	КлючиНастроек = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_КлючиНастроек");
	Если ТипЗнч(КлючиНастроек) <> Тип("Массив") Тогда
		КлючиНастроек = Новый Массив;
	КонецЕсли;
	
	Если КлючиНастроек.Найти(КлючДляСохранения) = Неопределено Тогда
		КлючиНастроек.Добавить(КлючДляСохранения);
		ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_КлючиНастроек", КлючиНастроек);
	КонецЕсли;
	
КонецПроцедуры

// Вызывает процедуру обновления шаблонов весового товара в базе Клеверенс
//
// Параметры:
//	ТаблицаШаблонов - Массив из Структура - содержит:
//		* Префикс - Строка	
//      * ЦелаяЧасть - Строка
//      * ДробнаяЧасть - Строка
//      * ДлинаКодаВесовогоТовара - Строка
//      * ПрефиксВключенВКод - Булево
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_СохранитьШаблоныВесовогоТовараВБазеSMARTS(ТаблицаШаблонов, ТипБазы, АдресаПеременных) Экспорт
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда		
		REST_API_ОбновитьШаблоныВесовогоТовараMS(ТаблицаШаблонов, ТипБазы, АдресаПеременных);		
	Иначе
		КомЯдро_ОбновитьШаблоныВесовогоТовараMS(ТаблицаШаблонов, АдресаПеременных);
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает в базе Клеверенс флаг, определяющий, будет ли доступен поиск по наименованию для выгруженной номенклатуры
//
// Параметры:
//	УстановитьПоискПоНаименованиюИАртикулу - флаг, определяющий, будет ли доступен в Клеверенс поиск по наименованию для выгруженной номенклатуры
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_УстановитьПоискПоНаименованиюИАртикулу(УстановитьПоискПоНаименованиюИАртикулу, АдресаПеременных) Экспорт
	КомЯдро_УстановитьПоискПоНаименованиюИАртикулу(УстановитьПоискПоНаименованиюИАртикулу, АдресаПеременных);	
КонецПроцедуры

// Удаляет из базы Клеверенс настройку по ключу
// 
// Параметры:
// 	КлючНастройки - Строка - название настройки
// 	ID_Узла - Строка - идентификатор узла удаляемой настройки
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_УдалитьНастройкуВБазеSMARTS(КлючНастройки, ID_Узла = "", АдресаПеременных)
	
	СтруктураНастроек = Новый Структура(КлючНастройки);
	ГлЯдро_УдалитьНастройкиВБазеSMARTS(СтруктураНастроек,, ID_Узла, АдресаПеременных);
	
КонецПроцедуры

// Вызывает процедуру удаления настроек в базе Клеверенс
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, которые необходимо удалить
//  УзловыеНастройки - Неопределено, Структура - ключами являются имена узловых настроек Клеверенс - см. ГлЯдро_ПолучитьКатегорииНастроекMS
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Процедура ГлЯдро_УдалитьНастройкиВБазеSMARTS(СтруктураНастроек, УзловыеНастройки = Неопределено, ID_Узла = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_УдалитьНастройкиВБазеSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,УзловыеНастройки,ID_Узла",
		СтруктураНастроек, УзловыеНастройки, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Удаление настроек в базе SMARTS';
						|en = 'Getting started, Deleting settings in the Cleverence database'; be = 'Пачатак, выдаленне налад у базе Cleverence'; es = 'Inicio, Eliminar la configuración en la base de Cleverence'; ka = 'დაწყება, Cleverence მონაცემთა ბაზაში პარამეტრების წაშლა'; kk = 'Бастау, Cleverence базасындағы параметрлерді жою'; ro = 'Noțiuni de bază, ștergerea setărilor din Baza de date Cleverence'; tr = 'Başlangıç, Cleverence veritabanındaki ayarları silme'; uk = 'Початок, видалення налаштувань в базі Cleverence'; uz = 'Ishni boshlash, Cleverence ma''lumotlar bazasidagi sozlamalarni o''chirish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
		
	// При удалении настроек из базы также удаляем их из настроек пользователя
	ГлЯдро_ОчиститьКэшируемыеНастройки(, СтруктураНастроек, АдресаПеременных);
	
	Если УзловыеНастройки = Неопределено Тогда
		КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS",АдресаПеременных);
		УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	КонецЕслИ;
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса",АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		REST_API_УдалитьНастройкиSMARTS(СтруктураНастроек, УзловыеНастройки, ID_Узла,АдресаПеременных);
	Иначе
		КомЯдро_УдалитьНастройкиSMARTS(СтруктураНастроек, УзловыеНастройки, ID_Узла,АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Удаление настроек в базе SMARTS';
						|en = 'End, Deleting settings in the Cleverence database'; be = 'Канец, выдаленне налад у базе Cleverence'; es = 'Fin, Eliminar la configuración en la base de Cleverence'; ka = 'დასასრული, Cleverence მონაცემთა ბაზაში პარამეტრების წაშლა'; kk = 'Аяқтау, Cleverence базасындағы параметрлерді жою'; ro = 'Sfârșit, ștergerea setărilor din Baza de date Cleverence'; tr = 'Son, Cleverence veritabanındaki ayarları silme'; uk = 'Кінець, видалення налаштувань в базі Cleverence'; uz = 'Tugatish, cleverence bazasidagi sozlamalarni o''chirish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры	

Процедура ГлЯдро_СохранитьИдентификаторыНастроекMS(ИдентификаторыНастроек, АдресаПеременных)
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	СохраненныеИдентификаторыНастроекMS = ГлЯдро_ПолучитьИдентификаторыНастроекMS(АдресаПеременных);
	Если СохраненныеИдентификаторыНастроекMS = Неопределено Тогда
		СохраненныеИдентификаторыНастроекMS = Новый Структура;
	КонецЕсли;
	
	СохранитьНастройки = Истина; // Ложь;
	
	Для каждого СтрокаНастройки ИЗ ИдентификаторыНастроек Цикл
		СохраненныеИдентификаторыНастроекMS.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		
		//ТекущееЗначение = Неопределено;
		//Если НЕ СохраненныеИдентификаторыНастроекMS.Свойство(СтрокаНастройки.Ключ, ТекущееЗначение)	ИЛИ ТекущееЗначение = Неопределено Тогда
		//	СохраненныеИдентификаторыНастроекMS.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		//	
		//	Если НЕ СохранитьНастройки Тогда
		//		СохранитьНастройки = Истина;
		//	КонецЕсли;
		//КонецЕсли;
	КонецЦикла;
	
	Если СохранитьНастройки Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
		КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, СохраненныеИдентификаторыНастроекMS, АдресаПеременных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ГлЯдро_УдалитьИдентификаторыНастроекMS(МассивНастроек, ПоИдентификаторам = Ложь, АдресаПеременных)
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы", АдресаПеременных);
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	СохраненныеИдентификаторыНастроекMS = ГлЯдро_ПолучитьИдентификаторыНастроекMS(АдресаПеременных);
	Если СохраненныеИдентификаторыНастроекMS = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки = Ложь;
	
	Для каждого Настройка ИЗ МассивНастроек Цикл
		Если ПоИдентификаторам Тогда
			НайденныеНастройки = ГлЯдро_НайтиПоЗначениюВСтруктуре(СохраненныеИдентификаторыНастроекMS, Настройка);
			Для каждого СтрокаНастройки ИЗ НайденныеНастройки Цикл
				СохраненныеИдентификаторыНастроекMS.Удалить(СтрокаНастройки.Ключ);
				Если НЕ СохранитьНастройки Тогда
					СохранитьНастройки = Истина;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если СохраненныеИдентификаторыНастроекMS.Свойство(Настройка) Тогда
				СохраненныеИдентификаторыНастроекMS.Удалить(Настройка);
				Если НЕ СохранитьНастройки Тогда
					СохранитьНастройки = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СохранитьНастройки Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
		КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, СохраненныеИдентификаторыНастроекMS, АдресаПеременных);
	КонецЕсли;
	
КонецПроцедуры

// Очистка хранилища 1С для указанного идентификатора базы MS.
// Если ИдентификаторБазыMS не указан, то будут очищены все настройки.
Процедура ГлЯдро_ОчиститьНастройкиХранилища1С(ИдентификаторБазыMS = Неопределено) Экспорт
	
	МассивКлючей = Новый Массив;
	
	// Если ИдентификаторБазыMS не указан, 
	//	то очищаем все настройки как в обработке КлеверенсТСД_ОчисткаНастроекMobileSMARTS,
	Если ИдентификаторБазыMS = Неопределено Тогда
		МассивКлючей.Добавить("Cleverence_ПараметрыПодключенияMS");		
		МассивКлючей.Добавить("Cleverence_РасположениеКомпоненты");
		МассивКлючей.Добавить("Cleverence_ДатаАктуальностиКэша");
		МассивКлючей.Добавить("Cleverence_СтруктураМетаданныхДокументы1С");
		МассивКлючей.Добавить("Cleverence_СтруктураНастроек");
		МассивКлючей.Добавить("Cleverence_СтруктураМетаданныхДокументыMS");
		МассивКлючей.Добавить("Cleverence_ПользователиMS");
		МассивКлючей.Добавить("Cleverence_ТаблицыMS");
		МассивКлючей.Добавить("Cleverence_ИмяИнтеграционнойОбработки");
		МассивКлючей.Добавить("Cleverence_РежимВыбораБазы");
		МассивКлючей.Добавить("Cleverence_ТипИнтерфейса");
		МассивКлючей.Добавить("Cleverence_ИмяИнтеграционнойОбработки");
	КонецЕсли;
	
	Попытка
		КлючиНастроек = ХранилищеОбщихНастроек.Загрузить("Cleverence_КлючиНастроек");
		Если ТипЗнч(КлючиНастроек) = Тип("Массив") Тогда
			Для каждого КлючНастройки ИЗ КлючиНастроек Цикл		
				Если МассивКлючей.Найти(КлючНастройки) = Неопределено
					И (ИдентификаторБазыMS = Неопределено
						ИЛИ Найти(КлючНастройки, ИдентификаторБазыMS))Тогда
					МассивКлючей.Добавить(КлючНастройки);				
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	Исключение
	КонецПопытки;
	
	// Удаляем только для текущего пользователя
	Для Каждого КлючОчистки Из МассивКлючей Цикл
		Попытка
			ХранилищеОбщихНастроек.Удалить(КлючОчистки,"");
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ГлобальныйКонтекст_Настройки_ВспомогательныеМеханизмы

Функция ГлЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, Направление, СериализуемыеНастройки = Неопределено, КонвертироватьТаблицуЗначенийВМассивСтруктур=Ложь, АдресаПеременных = Неопределено) Экспорт
	
	Если СериализуемыеНастройки = Неопределено Тогда
		КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
		СериализуемыеНастройки = КатегорииНастроекMS.СериализуемыеНастройки;
	КонецЕсли;
	
	Для Каждого Настройка Из СтруктураНастроек Цикл
		Если НЕ Настройка.Значение = Ложь И СериализуемыеНастройки.Найти(Настройка.Ключ) <> Неопределено Тогда
			ЗначениеНастройки = Настройка.Значение;
			Если НЕ ЗначениеНастройки = Неопределено Тогда
				Если Направление = "ИзСтроки" И ТипЗнч(ЗначениеНастройки) = Тип("Строка") Тогда
					ЗначениеНастройки = ГлЯдро_ЗначениеИзСтрокиXML(ЗначениеНастройки);
				ИначеЕсли Направление = "ВСтроку" Тогда	
					ЗначениеНастройки = ГлЯдро_ЗначениеВСтрокуXML(ЗначениеНастройки);
				КонецЕсли;
			КонецЕсли;
			Если ТипЗнч(ЗначениеНастройки) = Тип ("ТаблицаЗначений") И КонвертироватьТаблицуЗначенийВМассивСтруктур Тогда
				ЗначениеНастройки = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ЗначениеНастройки);
			КонецЕсли;
			СтруктураНастроек.Вставить(Настройка.Ключ, ЗначениеНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураНастроек;
	
КонецФункции

Функция ГлЯдро_ПроверитьТекущиеНастройки(АдресаПеременных)	
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных",АдресаПеременных);
	
	НастройкиКорректны = ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("Документы1С")
			И ТипЗнч(СтруктураМетаданных.Документы1С) = Тип("Структура")
			И СтруктураМетаданных.Свойство("НастройкиMS")
			И ТипЗнч(СтруктураМетаданных.НастройкиMS) = Тип("Структура")
			И СтруктураМетаданных.Свойство("ДокументыMS")
			И ТипЗнч(СтруктураМетаданных.ДокументыMS) = Тип("Структура")
			И СтруктураМетаданных.Свойство("УстройстваMS")
			И ТипЗнч(СтруктураМетаданных.УстройстваMS) = Тип("Массив");

	Возврат НастройкиКорректны;
			                                
КонецФункции

// Находит первое вхождение искомой строки как подстроки в исходной строке.
// Сравнение выполняется с учетом регистра.
//
// Параметры:
//	Строка - Строка - исходная строка
//  ПодстрокаПоиска - Строка - искомая подстрока
//  НаправлениеПоиска - Неопределено, Строка - направление поиска подстроки в строке ("СНачала", "СКонца")
//  НачальнаяПозиция - Неопределено, Число - позиция в строке, с которой начинается поиск
//	НомерВхождения - Число - номер вхождения искомой подстроки в исходной строке
//
// Возвращаемое значение:
//	Число - номер вхождения искомой подстроки в исходной строке
Функция ГлЯдро_СтрНайти(Строка, ПодстрокаПоиска, НаправлениеПоиска = Неопределено, НачальнаяПозиция = Неопределено, НомерВхождения = 1) Экспорт
	
	Результат = 0;
	
	// НаправлениеПоиска: СКонца,СНачала. По умолчанию: СНачала
	Если Строка = "" и ПодстрокаПоиска = "" Тогда
		// чтобы отрабатывало как в платформе
		Если НаправлениеПоиска = "СКонца" Тогда
			Если НомерВхождения = 1 Тогда
				Возврат 1;
			Иначе
				Возврат 0;
			КонецЕсли;
		Иначе
			Возврат мин(НомерВхождения, ?(НачальнаяПозиция=Неопределено, 1, НачальнаяПозиция));
		КонецЕсли;
	КонецЕсли;
	
	Если НачальнаяПозиция = Неопределено Тогда
		Если НаправлениеПоиска = "СКонца" Тогда
			лНачальнаяПозиция = СтрДлина(Строка);
		Иначе
			лНачальнаяПозиция = 1;
		КонецЕсли;
	Иначе
		лНачальнаяПозиция = НачальнаяПозиция;
	КонецЕсли;
	
	Если НаправлениеПоиска = "СКонца" Тогда
		лСтрока = "";
		Для сч = 1 По СтрДлина(Строка) Цикл
			лСтрока = Сред(Строка, сч, 1) + лСтрока;
		КонецЦикла;
		лПодстрокаПоиска = "";
		Для сч = 1 По СтрДлина(ПодстрокаПоиска) Цикл
			лПодстрокаПоиска = Сред(ПодстрокаПоиска, сч, 1) + лПодстрокаПоиска;
		КонецЦикла;
		лНачальнаяПозиция = макс(1, СтрДлина(Строка)-лНачальнаяПозиция-СтрДлина(ПодстрокаПоиска)+2);
	Иначе
		лСтрока = Строка;
		лПодстрокаПоиска = ПодстрокаПоиска;
		лНачальнаяПозиция = лНачальнаяПозиция;
	КонецЕсли;
	
	лНомерВхождения = 0;
	Результат = Найти(Сред(лСтрока, лНачальнаяПозиция), лПодстрокаПоиска);
	Пока Результат Цикл
		лНачальнаяПозиция = Результат + лНачальнаяПозиция + СтрДлина(ПодстрокаПоиска)-1;
		лНомерВхождения = лНомерВхождения + 1;
		Если лНомерВхождения = НомерВхождения Тогда
			Прервать;
		КонецЕсли;
		Результат = Найти(Сред(лСтрока, лНачальнаяПозиция), лПодстрокаПоиска);
	КонецЦикла;
	
	Если лНомерВхождения = НомерВхождения Тогда
		Результат = лНачальнаяПозиция - СтрДлина(ПодстрокаПоиска);
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Если НаправлениеПоиска = "СКонца" И Результат<>0 Тогда
		Результат = СтрДлина(Строка) - Результат - СтрДлина(ПодстрокаПоиска) + 2;
	КонецЕсли;
	
	Возврат Результат;        
			
КонецФункции

// Разделяет строку на части по указанным символам-разделителям
//
// Параметры:
//  Строка			 - Строка	 -  Разделяемая строка
//  Разделитель		 - Строка	 -  Строка символов, каждый из которых является индивидуальным разделителем
//  ВключатьПустые	 - Булево	 -  Указывает необходимость включать в результат пустые строки, 
//									которые могут образоваться в результате разделения исходной строки
// Возвращаемое значение:
//  Результат - Массив	- Массив со строками, которые получились в результате разделения исходной строки.
//
Функция ГлЯдро_СтрРазделить(ЗНАЧ Строка, Разделитель = ",", ВключатьПустые = Истина) Экспорт
	
	Результат = Новый Массив;
	
	// Для обеспечения обратной совместимости.
	Если ПустаяСтрока(Строка) Тогда 
		Если Разделитель = " " Тогда
			Результат.Добавить("");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;	
	
	Позиция = ГлЯдро_СтрНайти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если ВключатьПустые Или Не ПустаяСтрока(Подстрока) Тогда
			Если ВключатьПустые Тогда
				Результат.Добавить(Подстрока);				
			Иначе
				Результат.Добавить(СокрЛП(Подстрока));
			КонецЕсли;
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = ГлЯдро_СтрНайти(Строка, Разделитель);
	КонецЦикла;
	
	Если ВключатьПустые Или Не ПустаяСтрока(Строка) Тогда
		Если ВключатьПустые Тогда
			Результат.Добавить(Строка);			
		Иначе
			Результат.Добавить(СокрЛП(Строка));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;       
			
КонецФункции

Функция ГлЯдро_СтрШаблон(Знач СтрокаПодстановки,
	Параметр1, Параметр2 = Неопределено, Параметр3 = Неопределено,
	Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено,
	Параметр7 = Неопределено, Параметр8 = Неопределено, Параметр9 = Неопределено) Экспорт
	
	ИспользоватьАльтернативныйАлгоритм = 
		Найти(Параметр1, "%")
		Или Найти(Параметр2, "%")
		Или Найти(Параметр3, "%")
		Или Найти(Параметр4, "%")
		Или Найти(Параметр5, "%")
		Или Найти(Параметр6, "%")
		Или Найти(Параметр7, "%")
		Или Найти(Параметр8, "%")
		Или Найти(Параметр9, "%");
		
	Если ИспользоватьАльтернативныйАлгоритм Тогда
		Результат = "";
		Позиция = Найти(СтрокаПодстановки, "%");
		Пока Позиция > 0 Цикл 
			Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
			СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, 1);
			ПодставляемыйПараметр = "";
			Если СимволПослеПроцента = "1" Тогда
				ПодставляемыйПараметр =  Параметр1;
			ИначеЕсли СимволПослеПроцента = "2" Тогда
				ПодставляемыйПараметр =  Параметр2;
			ИначеЕсли СимволПослеПроцента = "3" Тогда
				ПодставляемыйПараметр =  Параметр3;
			ИначеЕсли СимволПослеПроцента = "4" Тогда
				ПодставляемыйПараметр =  Параметр4;
			ИначеЕсли СимволПослеПроцента = "5" Тогда
				ПодставляемыйПараметр =  Параметр5;
			ИначеЕсли СимволПослеПроцента = "6" Тогда
				ПодставляемыйПараметр =  Параметр6;
			ИначеЕсли СимволПослеПроцента = "7" Тогда
				ПодставляемыйПараметр =  Параметр7
			ИначеЕсли СимволПослеПроцента = "8" Тогда
				ПодставляемыйПараметр =  Параметр8;
			ИначеЕсли СимволПослеПроцента = "9" Тогда
				ПодставляемыйПараметр =  Параметр9;
			КонецЕсли;
			Если ПодставляемыйПараметр = "" Тогда
				Результат = Результат + "%";
				СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 1);
			Иначе
				Результат = Результат + ПодставляемыйПараметр;
				СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 2);
			КонецЕсли;
			Позиция = Найти(СтрокаПодстановки, "%");
		КонецЦикла;
		Результат = Результат + СтрокаПодстановки;				
	Иначе
		Результат = СтрЗаменить(СтрокаПодстановки, "%1", Параметр1);
		Результат = СтрЗаменить(Результат, "%2", Параметр2);
		Результат = СтрЗаменить(Результат, "%3", Параметр3);
		Результат = СтрЗаменить(Результат, "%4", Параметр4);
		Результат = СтрЗаменить(Результат, "%5", Параметр5);
		Результат = СтрЗаменить(Результат, "%6", Параметр6);
		Результат = СтрЗаменить(Результат, "%7", Параметр7);
		Результат = СтрЗаменить(Результат, "%8", Параметр8);
		Результат = СтрЗаменить(Результат, "%9", Параметр9);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_СтрСоединить(МассивСтрок, Разделитель) Экспорт
	
	КоличествоСтрок = МассивСтрок.Количество();
	Результат = ?(КоличествоСтрок > 0, МассивСтрок[0], "");
	
	Для к = 1 По КоличествоСтрок - 1 Цикл
		Результат = Результат + Разделитель + МассивСтрок[к];
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ПолучитьМаксимальныйКодСимволаСтроки(СтрокаАнализа) Экспорт
	
	ДлинаСтрокиАнализа = СтрДлина(СтрокаАнализа);
	
	МаксимальныйКодСимвола = 0;
	
	Для Счетчик = 1 По ДлинаСтрокиАнализа Цикл
				
		КодТекущегоСимвола = КодСимвола(СтрокаАнализа, Счетчик);
		Если КодТекущегоСимвола > МаксимальныйКодСимвола Тогда
			МаксимальныйКодСимвола = КодТекущегоСимвола;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МаксимальныйКодСимвола;
	
КонецФункции

Функция ГлЯдро_ПолучитьКлючШифрования(Пароль, ДлинаКодируемойСтроки, АдресаПеременных) Экспорт
	
	Пароль_Длина 	= СтрДлина(Пароль);
	КлючШифрования	= "";
	
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ГлЯдро_ПолучитьМаксимальныйКодСимволаСтроки(Пароль_Длина);
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ЧислоДляИнциализацииГенератораСлучаныхЧисел + ДлинаКодируемойСтроки;
	
	ГенераторСлучаныхЧисел = Новый ГенераторСлучайныхЧисел(ЧислоДляИнциализацииГенератораСлучаныхЧисел);
		
	СчетчикПоПаролю = Неопределено;
	
	Для Счетчик = 1 По ДлинаКодируемойСтроки Цикл
		Если (СчетчикПоПаролю = Неопределено) ИЛИ (СчетчикПоПаролю > Пароль_Длина) Тогда
			СчетчикПоПаролю = 1;
		КонецЕсли;
		
		СлучайноеСмещение 	= ГенераторСлучаныхЧисел.СлучайноеЧисло(1, ЧислоДляИнциализацииГенератораСлучаныхЧисел);
		СимволПароля 		= Сред(Пароль, СчетчикПоПаролю, 1);
		КлючШифрования 		= КлючШифрования + Символ(КодСимвола(СимволПароля) + СлучайноеСмещение);
		
		СчетчикПоПаролю = СчетчикПоПаролю + 1;
		
	КонецЦикла;
	
	Возврат КлючШифрования;
	
КонецФункции

Функция ГлЯдро_ЗашифроватьСтроку(КодируемаяСтрока, КлючШифрования, АдресаПеременных) Экспорт
	
	ДлинаКодируемойСтроки = СтрДлина(КодируемаяСтрока);
	
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ГлЯдро_ПолучитьМаксимальныйКодСимволаСтроки(КлючШифрования);
	
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ЧислоДляИнциализацииГенератораСлучаныхЧисел + ДлинаКодируемойСтроки;
	
	ГенераторСлучаныхЧисел = Новый ГенераторСлучайныхЧисел(ЧислоДляИнциализацииГенератораСлучаныхЧисел);
	
	ЗакодированнаяСтрока = "";
	
	Для Счетчик = 1 ПО ДлинаКодируемойСтроки Цикл
		
		КодСимволаИсходнойСтроки 	= КодСимвола(КодируемаяСтрока, Счетчик);
		КодСимволаКлючаШифрования 	= КодСимвола(КлючШифрования, Счетчик);		
		СлучайнаяСоставляющая		= ГенераторСлучаныхЧисел.СлучайноеЧисло(1, ЧислоДляИнциализацииГенератораСлучаныхЧисел);
		
		КодЗакодированныгоСимвола = КодСимволаИсходнойСтроки + КодСимволаКлючаШифрования + СлучайнаяСоставляющая;
		
		ЗакодированнаяСтрока = ЗакодированнаяСтрока + Символ(КодЗакодированныгоСимвола);
		
	КонецЦикла;
	
	Возврат ЗакодированнаяСтрока;
	
КонецФункции

Функция ГлЯдро_РасшифроватьСтроку(КодируемаяСтрока, КлючШифрования, АдресаПеременных) Экспорт
	
	ДлинаКодируемойСтроки = СтрДлина(КодируемаяСтрока);
	
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ГлЯдро_ПолучитьМаксимальныйКодСимволаСтроки(КлючШифрования);
	
	ЧислоДляИнциализацииГенератораСлучаныхЧисел = ЧислоДляИнциализацииГенератораСлучаныхЧисел + ДлинаКодируемойСтроки;

	ГенераторСлучаныхЧисел = Новый ГенераторСлучайныхЧисел(ЧислоДляИнциализацииГенератораСлучаныхЧисел);
	
	ЗакодированнаяСтрока = "";
	
	Для Счетчик = 1 ПО ДлинаКодируемойСтроки Цикл
		
		КодСимволаКлючаШифрования 	= КодСимвола(КлючШифрования, Счетчик);			
		КодЗакодированныгоСимвола 	= КодСимвола(КодируемаяСтрока, Счетчик);
		СлучайнаяСоставляющая		= ГенераторСлучаныхЧисел.СлучайноеЧисло(1, ЧислоДляИнциализацииГенератораСлучаныхЧисел);
		
		КодСимволаИсходнойСтроки = КодЗакодированныгоСимвола - КодСимволаКлючаШифрования - СлучайнаяСоставляющая;
		
		ЗакодированнаяСтрока = ЗакодированнаяСтрока + Символ(КодСимволаИсходнойСтроки);
		
	КонецЦикла;
	
	Возврат ЗакодированнаяСтрока;
	
КонецФункции

// Получает актуальную структуру параметров подключения базы SMARTS
Функция ГлЯдро_ПолучитьСтруктуруПараметровПодключенияSMARTS()
	
	СтруктураПараметровПодключения = Новый Структура;
	СтруктураПараметровПодключения.Вставить("Ид", 								"");
	СтруктураПараметровПодключения.Вставить("Имя", 								"");
	СтруктураПараметровПодключения.Вставить("ИдПриложения", 					"");			
	СтруктураПараметровПодключения.Вставить("ИмяПриложения", 					"");
	СтруктураПараметровПодключения.Вставить("УровеньПриложения", 				0);
	СтруктураПараметровПодключения.Вставить("СтрокаПодключения", 				"");
	СтруктураПараметровПодключения.Вставить("ИдОсновногоПриложения", 			"");
	СтруктураПараметровПодключения.Вставить("РабочийКаталог", 					Ложь);
	СтруктураПараметровПодключения.Вставить("ИмяИнтеграционнойОбработки",		Неопределено);
	СтруктураПараметровПодключения.Вставить("ПутьИнтеграционнойОбработки",		Неопределено);
	СтруктураПараметровПодключения.Вставить("ТипОсновнойОбработки",				"");
	СтруктураПараметровПодключения.Вставить("ПутьОсновнойОбработки",			Неопределено);			
	СтруктураПараметровПодключения.Вставить("УровеньПриложенияСтрокой",			"");
	СтруктураПараметровПодключения.Вставить("ТипУстановленногоПродукта",		"");
	СтруктураПараметровПодключения.Вставить("ТипОбработки",						"");
	СтруктураПараметровПодключения.Вставить("АвторизацияВключена", 				Ложь);
	СтруктураПараметровПодключения.Вставить("АвторизацияТокен", 				"");
	СтруктураПараметровПодключения.Вставить("АвторизацияРефрешТокен",			"");
	СтруктураПараметровПодключения.Вставить("АвторизацияТип",					Неопределено);
	СтруктураПараметровПодключения.Вставить("СтрокаПодключенияСМАРТС",			"");
	СтруктураПараметровПодключения.Вставить("IdBaseSMARTS", 					"");
	СтруктураПараметровПодключения.Вставить("QR", 								"");
	СтруктураПараметровПодключения.Вставить("ВерсияПриложения", 				"");
	СтруктураПараметровПодключения.Вставить("Комментарий", 						Неопределено);
	СтруктураПараметровПодключения.Вставить("РаботаСКаталогом", 				Ложь);
	СтруктураПараметровПодключения.Вставить("РаботаСЛокальнымСервером", 		Неопределено);
	СтруктураПараметровПодключения.Вставить("РаботаССервером", 					Ложь);
	СтруктураПараметровПодключения.Вставить("РаботаСУдаленнымСервером", 		Неопределено);
	СтруктураПараметровПодключения.Вставить("РаботаСУстройствомНапрямую", 		Неопределено);
	СтруктураПараметровПодключения.Вставить("ПапкаОбмена", 						"");
	СтруктураПараметровПодключения.Вставить("ОтключитьРаботуСКнопкамиОбмена",	Истина);
	СтруктураПараметровПодключения.Вставить("ВерсияКонфигурацииSMARTS",			"");
	СтруктураПараметровПодключения.Вставить("ВерсияПлатформыSMARTS",			"");
	СтруктураПараметровПодключения.Вставить("REST_API_Версия",					Неопределено);

	Возврат СтруктураПараметровПодключения;
	
КонецФункции

// Проверка соответствия структуры сохраненных параметров подключения базы SMARTS актуальным
// и в случае необходимости дополнение свойств (для исключения ошибок после обновления)
Функция ГлЯдро_АктуализацияСтруктурыПараметровПодключенияSMARTS(Знач СохраненныеПараметрыПодключения) Экспорт
	
	Если СохраненныеПараметрыПодключения <> Неопределено Тогда
			
		АктуальныеНастройки = ГлЯдро_ПолучитьСтруктуруПараметровПодключенияSMARTS();
		
		Для Каждого АктуальнаяНастройка Из АктуальныеНастройки Цикл
			
			Если Не СохраненныеПараметрыПодключения.Свойство(АктуальнаяНастройка.Ключ) Тогда
				СохраненныеПараметрыПодключения.Вставить(АктуальнаяНастройка.Ключ, АктуальнаяНастройка.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СохраненныеПараметрыПодключения;
	
КонецФункции

// Получает структуру параметров настройки для сохранения на сервере SMARTS
Функция ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(НастройкиБизнесПроцессов, ВерсияНастроек, АдресаПеременных) Экспорт
	
	НовыйФорматНастроек = КомЯдро_ПолучитьЗначениеПеременной("НовыеНастройкиБизнесПроцессов", АдресаПеременных);
	
	Если НовыйФорматНастроек = Неопределено Тогда
		НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ПолучитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов_ПоУмолчанию",, АдресаПеременных);
		
		НовыйФорматНастроек = НастройкиБизнесПроцессов_ПоУмолчанию = Неопределено
			ИЛИ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь
			ИЛИ ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Структура");
		КомЯдро_СохранитьЗначениеПеременной("НовыеНастройкиБизнесПроцессов", НовыйФорматНастроек, АдресаПеременных);
	КонецЕсли;
	
	Если НовыйФорматНастроек Тогда	
		СтруктураНастроек = Новый Структура("ВерсияНастроек, НастройкиБизнесПроцессов", ВерсияНастроек, НастройкиБизнесПроцессов);
	Иначе
		// Для баз со старыми настройками оставляем сохранение настроек как есть, чтобы не сломать работу в случае случайного открытия новой обработки
		СтруктураНастроек = НастройкиБизнесПроцессов;
	КонецЕсли;
		
	Возврат СтруктураНастроек;	
	
КонецФункции

// Получение структуры настроек бизнес-процессов с учетом возможного наличия старых ключей и свойств настроек
//
Функция ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекБизнесПроцессов("ВерсияНастроек", "НастройкиБизнесПроцессов_Пользовательские", АдресаПеременных);	
	
КонецФункции

Функция ГлЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов(АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекБизнесПроцессов("ВерсияНастроек", "НастройкиБизнесПроцессов_ПользовательскиеНастройки", АдресаПеременных);	
	
КонецФункции

Функция ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекБизнесПроцессов("ВерсияНастроек_ПоУмолчанию", "НастройкиБизнесПроцессов_ПоУмолчанию", АдресаПеременных);	
	
КонецФункции

Функция ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекБизнесПроцессов(ВерсияНастроекИмя = "", НастройкиБизнесПроцессовИмя = "", АдресаПеременных) Экспорт
	
	СтруктураВозврат = Новый Структура("ВерсияНастроек,НастройкиБизнесПроцессов", Неопределено, Неопределено);	
	
	СтруктураНастроекБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(НастройкиБизнесПроцессовИмя,, АдресаПеременных);
	
	Если ТипЗнч(СтруктураНастроекБизнесПроцессов) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврат, СтруктураНастроекБизнесПроцессов);				
	Иначе	
		СтруктураВозврат.ВерсияНастроек 			= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS(ВерсияНастроекИмя,, АдресаПеременных);
		СтруктураВозврат.НастройкиБизнесПроцессов 	= СтруктураНастроекБизнесПроцессов;
	КонецЕсли;     	
	
	Возврат СтруктураВозврат;
	
КонецФункции

Функция ГлЯдро_ПолучитьСтруктуруПользовательскихНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла = "", АдресаПеременных) Экспорт
	
	Возврат ГлЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовНаСервереSMARTS("ВерсияНастроек", "НастройкиБизнесПроцессов_Пользовательские", ID_Узла, АдресаПеременных);	
	
