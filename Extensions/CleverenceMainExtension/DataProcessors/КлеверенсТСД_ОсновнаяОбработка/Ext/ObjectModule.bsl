Функция ГлЯдро_НастройкаSMARTS(Ключ, АдресаПеременных)

	Перем Значение;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	Если ЯзыкПлатформыMS = "RU" Тогда
		
		Значение = Ключ;			
		
	ИначеЕсли ЯзыкПлатформыMS = "EN" Тогда
		
		Если Ключ = "ИспользоватьШаблоныВесовогоТовара" 		Тогда Значение = "useWeightProductTemplates";
		ИначеЕсли Ключ = "ПрефиксКодаВесовогоТовара" 			Тогда Значение = "prefixWeightProductCode";
		ИначеЕсли Ключ = "ДлинаКодаВесовогоТовара" 				Тогда Значение = "weightProductCodeLength";
		ИначеЕсли Ключ = "ЧислоЗнаковПослеЗапятойВесТовара" 	Тогда Значение = "numberOfDecimalPlacesInWeightOfProduct";
		ИначеЕсли Ключ = "ПрефиксВключенВКодВесовогоТовара" 	Тогда Значение = "prefixIncludedInWeightedProductCode";
