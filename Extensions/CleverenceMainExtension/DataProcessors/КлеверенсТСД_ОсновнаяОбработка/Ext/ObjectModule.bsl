						|" + ТекстОшибки;
				КонецЕсли;
				
				ДанныеДокумента.Вставить("СообщениеОбОшибках",	ТекстОшибки);
				ДанныеДокумента.Вставить("КритическаяОшибка",	Истина);
				
			КонецЕсли;
						
		КонецЕсли;	
		
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выполнение обработчика загрузки документа 1С: %1';
						|en = 'Finally, the 1C document download handler is executed: %1';
						|be = 'Канец, выкананне апрацоўшчыка загрузкі дакумента 1С: %1'; es = 'Fin, Ejecución del controlador de carga de documentos 1C: %1'; ka = 'დაბოლოს, შესრულებულია 1c დოკუმენტის ჩამოტვირთვის დამმუშავებელი: %1'; kk = 'Соңы, құжатты жүктеу өңдегішінің орындалуы 1С: %1'; ro = 'În cele din urmă, se execută manipulatorul de descărcare a documentelor 1C: %1'; tr = 'Son, Belge yükleme işleyicisinin yürütülmesi 1C: %1'; uk = 'Кінець, виконання обробника завантаження документа 1С: %1'; uz = 'Tugatish, hujjatni yuklash ishlovchisini bajarish 1C: %1'");
