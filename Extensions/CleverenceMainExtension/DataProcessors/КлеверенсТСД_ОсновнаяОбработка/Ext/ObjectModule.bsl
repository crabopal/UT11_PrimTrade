Процедура ГлЯдро_ПроверитьЛицензииУстройств(СтруктураМетаданных, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПроверитьЛицензииУстройств";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураМетаданных",
		СтруктураМетаданных);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураМетаданных.Вставить("isDemo", 		Ложь); // По умолчанию отключим демо режим
	СтруктураМетаданных.Вставить("LightDemo", 	Ложь); 
	СтруктураМетаданных.Вставить("HardDemo", 	Ложь); 
	
	МассивУстройств = СтруктураМетаданных.УстройстваMS;
	Если Не ТипЗнч(МассивУстройств) = Тип("Массив") Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПлатформаПоддерживаетSupportUntilDate = СтруктураМетаданных.Свойство("ПлатформаПоддерживаетSupportUntilDate") И СтруктураМетаданных.ПлатформаПоддерживаетSupportUntilDate;
	СоответствиеУстройствДатам = Новый Соответствие;	
	МассивПроверяемыхУстройств = Новый Массив;
	
	ДатаТекущая = ТекущаяДата();
	Для Каждого Устройство Из МассивУстройств Цикл
		
		deviceId = Устройство.deviceId;
		Если deviceId = ""
			ИЛИ ВРЕГ(Лев(deviceId,4))= "WIN-" Тогда
			Продолжить;
		КонецЕсли;
		
		// Если не заполнено lastInfoTime, значит лицензия есть, но устройство еще не заходило
		Если НЕ ЗначениеЗаполнено(Устройство.lastInfoTime) Тогда
			Продолжить;
		КонецЕсли;
		
		// Не проверяем устройства, которые были в сети более 14 дней назад
		Попытка
			РазницаДатЧислом = ДатаТекущая - Устройство.lastInfoTime;			
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось вычислить последнее время подключения устройства с ID  %1. Ошибка';
								|en = 'Couldn''t calculate the last connection time of the device with ID %1. Error';
								|be = 'Не ўдалося вылічыць апошні час падлучэння прылады з ID % 1. Памылка'; es = 'No se pudo calcular la Última vez que se conectó el dispositivo con ID % 1. Error'; ka = 'ვერ გამოვთვალოთ მოწყობილობის ბოლო კავშირის დრო ID %1-ით. შეცდომა'; kk = 'Id %1 құрылғысының соңғы қосылу уақытын есептеу мүмкін болмады. Қате'; ro = 'Nu s-a putut calcula ultima dată de conectare a dispozitivului cu ID %1. Eroare'; tr = 'Cihazın kimliği %1 olan son bağlantı süresini hesaplayamadım. Hata'; uk = 'Не вдалося обчислити останнім часом підключення пристрою з ID %1. Помилка'; uz = 'Qurilmani id %1 bilan ulashning so''nggi vaqtini hisoblab bo''lmadi. Xato'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), deviceId);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"deviceId",
				deviceId);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
			Продолжить;
		КонецПопытки;
		
		Если РазницаДатЧислом > 3600*24*14 Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ПлатформаПоддерживаетSupportUntilDate Тогда 		
			СоответствиеУстройствДатам.Вставить(deviceId,Новый Структура("supportAppId, supportDate", Устройство.supportAppId, Устройство.supportDate));
		Иначе
			МассивПроверяемыхУстройств.Добавить(Устройство);
		КонецЕсли;
	КонецЦикла;
		
	Если Не ПлатформаПоддерживаетSupportUntilDate Тогда
		СтруктураДанных = ГлЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий(МассивПроверяемыхУстройств,,АдресаПеременных);
		СоответствиеУстройствДатам = СтруктураДанных.СоответствиеУстройствДатам;
	КонецЕсли;
	
	///////////////////////////		
	ДатаОбработки = ПолучитьДатуВерсии();
	
	isDemo = Ложь;
		
	ТекстДляЖР = "";
	КоличествоДействующихЛицензий  = 0;
	КоличествоИстекшихЛицензий     = 0;
	Для каждого Устройство Из МассивУстройств Цикл
		ТекущаяИнформация = СоответствиеУстройствДатам.Получить(Устройство.deviceId);
		Если ЗначениеЗаполнено(ТекущаяИнформация) Тогда
			ЗаполнитьЗначенияСвойств(Устройство,ТекущаяИнформация);
			Если ЗначениеЗаполнено(ТекущаяИнформация.supportDate) 
				И ТекущаяИнформация.supportDate < ДатаОбработки Тогда
				Устройство.isDemo = Истина;
				isDemo = Истина;
				КоличествоИстекшихЛицензий = КоличествоИстекшихЛицензий + 1;								
			Иначе
				КоличествоДействующихЛицензий  = КоличествоДействующихЛицензий + 1;
			КонецЕсли;			
		КонецЕсли;
		
		ТекстДляЖР = ТекстДляЖР+"deviceId:"+Устройство.deviceId
								+"; demo:"+?(Устройство.isDemo,"true","false")
								+"; lastInfoTime:"+Формат(Устройство.lastInfoTime, "ДЛФ=Д")
								+"; supportDate:"+Формат(Устройство.supportDate, "ДЛФ=Д")
								+"; supportAppId:"+Устройство.supportAppId+Символы.ПС;
	КонецЦикла;
		
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстДляЖР,, );							
	
	LightDemo = Ложь;
	HardDemo = Ложь;
	Если isDemo Тогда
		Если КоличествоДействующихЛицензий > 0 Тогда 
			LightDemo = Истина;
		ИначеЕсли КоличествоИстекшихЛицензий > 0 Тогда
			HardDemo = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураМетаданных.Вставить("isDemo",    isDemo);
	СтруктураМетаданных.Вставить("LightDemo", LightDemo);
	СтруктураМетаданных.Вставить("HardDemo",  HardDemo);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий(МассивУстройств, ВернутьТекстЗапроса = Ложь, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивУстройств,ВернутьТекстЗапроса",
		МассивУстройств, ВернутьТекстЗапроса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ИмяПеременнойНастройки 		= "Cleverence_ДанныеУстройствMS";
	ИмяПеременнойДатыПроверки 	= "Cleverence_ДатаЗапросаЛицензий";
	
	СоответствиеУстройствДатам = Новый Соответствие;
			
	ДатаОбработки = ПолучитьДатуВерсии();
	
	ТекстЗапроса = ПолучитьМакет("DeviceState").ПолучитьТекст();
	СтрокаИдентификаторов = "";		
	
	СохраненныеДанныеОЛицензиях = ГлЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойНастройки);
	Если СохраненныеДанныеОЛицензиях = Неопределено Тогда
		СохраненныеДанныеОЛицензиях = Новый Соответствие;
	КонецЕсли;
	
	ДатаПоследнейПроверки = ГлЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойДатыПроверки);
	Если ДатаПоследнейПроверки = Неопределено Тогда
		ДатаПоследнейПроверки = Дата(1,1,1);
	КонецЕсли;
		
	#Область НесовместимыйКодFresh
	ОбращатьсяКСерверуЛицензий = (ТекущаяДата() - ДатаПоследнейПроверки) > 3600*24;
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//ОбращатьсяКСерверуЛицензий = Ложь;
	#КонецОбласти //СовместимыйКодFresh

	Для Каждого Устройство Из МассивУстройств Цикл		
		deviceId = Устройство.deviceId;
		Если deviceId = ""
			ИЛИ ВРЕГ(Лев(deviceId,4))= "WIN-" Тогда
			Продолжить;
		КонецЕсли;				
		
		СохраненнаяИнформация = СохраненныеДанныеОЛицензиях.Получить(deviceId);
		
		Если ОбращатьсяКСерверуЛицензий Тогда 
			Если ЗначениеЗаполнено(СохраненнаяИнформация) 
				И СохраненнаяИнформация.supportDate > ДатаОбработки Тогда
				СоответствиеУстройствДатам.Вставить(deviceId,СохраненнаяИнформация);
			Иначе 			
				СтрокаИдентификаторов = СтрокаИдентификаторов + ?(СтрокаИдентификаторов = "","",Символы.ПС)+"<string>"+deviceId+"</string>";			
				СоответствиеУстройствДатам.Вставить(deviceId,Новый Структура("supportAppId, supportDate","",Дата(1,1,1)));
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СохраненнаяИнформация) Тогда
				СоответствиеУстройствДатам.Вставить(deviceId,СохраненнаяИнформация);
			КонецЕсли;			
		КонецЕсли;
		
	КонецЦикла;
	#Область НесовместимыйКодFresh
	Если ЗначениеЗаполнено(СтрокаИдентификаторов) Тогда 
			
		ОтправляемыеДанные = ТекстЗапроса;
		ОтправляемыеДанные = СтрЗаменить(ОтправляемыеДанные,"%DEVICEIDS%", СтрокаИдентификаторов);
		
		Соединение = Новый HTTPСоединение(
		          "license.cleverence.ru" // сервер (хост)
		        , 8090 // порт, по умолчанию
		        , // СтруктураURI.Логин, // пользователь для доступа к серверу (если он есть)
		        , // СтруктураURI.Пароль, // пароль для доступа к серверу (если он есть)
		        , // здесь указывается прокси, если он есть
		        , 5 // таймаут в секундах, 0 или пусто - не устанавливать
		        ,  // защищенное соединение, если используется https
		    );
			
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Content-Type", "application/soap+xml");
		Заголовки.Вставить("charset", "utf-8");
		Заголовки.Вставить("SOAPAction", "http://tempuri.org/GetActualLicenseState");
		
		Запрос = Новый HTTPЗапрос("/LicenseService.asmx",Заголовки);
		Запрос.УстановитьТелоИзСтроки(ОтправляемыеДанные);
		
		ОтветПолучен = Ложь;
		Попытка
			ОтветHTTP = Соединение.ВызватьHTTPМетод("POST", Запрос);
			ОтветПолучен = Истина;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось получить информацию о лицензиях подключенных устройств. Ошибка';
								|en = 'Information about the licenses of the connected devices could not be obtained. Error';
								|be = 'Не ўдалося атрымаць інфармацыю аб ліцэнзіях падлучаных прылад. Памылка'; es = 'No se pudo obtener información sobre las licencias de los dispositivos conectados. Error'; ka = 'დაკავშირებული მოწყობილობების ლიცენზიების შესახებ ინფორმაცია ვერ იქნა მიღებული. შეცდომა'; kk = 'Қосылған құрылғылардың лицензиялары туралы ақпарат алу мүмкін болмады. Қате'; ro = 'Informațiile despre licențele dispozitivelor conectate nu au putut fi obținute. Eroare'; tr = 'Bağlı cihazların lisansları hakkında bilgi alınamadı. Hata'; uk = 'Не вдалося отримати інформацію про ліцензії підключених пристроїв. Помилка'; uz = 'Ulangan qurilmalarning litsenziyalari haqida ma''lumot olishning iloji bo''lmadi. Xato'";
			пСообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
		КонецПопытки;
		
		Если ОтветПолучен Тогда
			Попытка
				ОтветСервера = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.Системная);
			
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.УстановитьСтроку(ОтветСервера);
				
				ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
				SimpleActivationCodeInfo = ОбъектXDTO.Body.GetActualLicenseStateResponse.GetActualLicenseStateResult.SimpleActivationCodeInfo;
				
				Попытка 
					КоличествоЛицензий  = SimpleActivationCodeInfo.Количество();
				Исключение
					массивИнформаций = Новый Массив;
					массивИнформаций.Добавить(SimpleActivationCodeInfo);
					SimpleActivationCodeInfo = массивИнформаций;
				КонецПопытки;	
				
				Для Каждого LicenseInfo Из SimpleActivationCodeInfo Цикл
					
					Если Не ЗначениеЗаполнено(LicenseInfo.SupportDate) Тогда
						Продолжить;
					КонецЕсли;
					DeviceId = LicenseInfo.DeviceId;
					ДатаПоддержки = Дата(СтрЗаменить(Лев(LicenseInfo.SupportDate,10),"-", ""));
					
					ТекущаяИнформация = СоответствиеУстройствДатам.Получить(LicenseInfo.DeviceId);
					Если ТекущаяИнформация = Неопределено 
						Или ТекущаяИнформация.supportDate < ДатаПоддержки Тогда				
						СоответствиеУстройствДатам.Вставить (DeviceId,Новый Структура("supportAppId, supportDate",LicenseInfo.AppId,ДатаПоддержки));
						СохраненныеДанныеОЛицензиях.Вставить(DeviceId,Новый Структура("supportAppId, supportDate",LicenseInfo.AppId,ДатаПоддержки));
					КонецЕсли;		
				КонецЦикла;
				
				ГлЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойНастройки, СохраненныеДанныеОЛицензиях);
				ГлЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойДатыПроверки, ТекущаяДата());
			Исключение
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Не удалось разобрать ответ от сервера лицензий. Ошибка';
									|en = 'The response from the license server could not be parsed. Error';
									|be = 'Не ўдалося разабраць адказ ад сервера ліцэнзій. Памылка'; es = 'No se pudo analizar la respuesta del servidor de licencias. Error'; ka = 'სალიცენზიო სერვერიდან პასუხი ვერ გაიაზრა. შეცდომა'; kk = 'Лицензия серверінен жауапты талдау мүмкін болмады. Қате'; ro = 'Răspunsul de la serverul de licență nu a putut fi analizat. Eroare'; tr = 'Lisans sunucusundan gelen yanıtı ayrıştıramadım. Hata'; uk = 'Не вдалося розібрати відповідь від сервера ліцензій. Помилка'; uz = 'Litsenziya serveridan javobni ajratib bo''lmadi. Xato'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
	#КонецОбласти //НесовместимыйКодFresh	
	Результат = Новый Структура("СоответствиеУстройствДатам, ДатаОбработки",СоответствиеУстройствДатам,ПолучитьДатуВерсии()); 
	Если ВернутьТекстЗапроса Тогда
		Результат.Вставить("ТекстЗапроса", ТекстЗапроса);
		Результат.Вставить("СохраненныеДанныеОЛицензиях", СохраненныеДанныеОЛицензиях);
		Результат.Вставить("ДатаПоследнейПроверки", ДатаПоследнейПроверки);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
КонецФункции

Функция ГлЯдро_ПолучитьОписаниеУстройствВДемоРежиме(АдресаПеременных) Экспорт
	
	ОписаниеДемоУстройств = "";
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных); //.УстройстваMS
	Если СтруктураМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтруктураМетаданных.Свойство("УстройстваMS")		
		И ТипЗнч(СтруктураМетаданных.УстройстваMS) = Тип("Массив") Тогда		
		Для Каждого Устройство Из СтруктураМетаданных.УстройстваMS Цикл
			ОписаниеДемоУстройств = ОписаниеДемоУстройств + Устройство.deviceId+" (поддержка до "+Формат(Устройство.supportDate, "ДЛФ=Д")+")"+ Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Возврат ОписаниеДемоУстройств;
КонецФункции

Функция ГлЯдро_ПроверитьДемоРежимУстройства(ИдУстройства, АдресаПеременных)
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если СтруктураМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаОбработки = ПолучитьДатуВерсии();
	
	Результат = Ложь;
	Если СтруктураМетаданных.Свойство("УстройстваMS")		
		И ТипЗнч(СтруктураМетаданных.УстройстваMS) = Тип("Массив") Тогда		
		
		Для Каждого Устройство Из СтруктураМетаданных.УстройстваMS Цикл	
			Если Устройство.deviceId = ИдУстройства Тогда				
				Результат = Устройство.isDemo;								
				Прервать;				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// @logskip
Функция ГлЯдро_ПолучитьДатуОбработки(АдресаПеременных) Экспорт
	Возврат ПолучитьДатуВерсии();	
