//
// Параметры:
//	ПолныйПутьКИнтеграционнойОбработке - Неопределено, Строка - адрес временного хранилища
//  ПутьКФайлу - Строка - путь к файлу интеграционной обработки
//  ПараметрыПодключенияMS - Неопределено, Структура - структура, ключами которой являются имена настроек подключения
//										 			   Клеверенс, значениями - значения соответствующих настроек
//  ТипОбработки - Неопределено, Строка - тип подключаемой интеграционной обработки ("ФайлНаДиске", "СправочникСсылка", "Встроенная")
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Строка - адрес структуры подключенной интеграционной обработки во временном хранилище
//         - описание ошибки, если подключить интеграционную обработку не удалось
Функция ГлЯдро_ПодключитьИнтеграционнуюОбработку(ПолныйПутьКИнтеграционнойОбработке = Неопределено,ПутьКФайлу = "",ПараметрыПодключенияMS=Неопределено,ТипОбработки = Неопределено,АдресаПеременных) Экспорт 

	ИмяСобытия = "ГлЯдро_ПодключитьИнтеграционнуюОбработку";

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПолныйПутьКИнтеграционнойОбработке,ПутьКФайлу,ПараметрыПодключенияMS,ТипОбработки",
		ПолныйПутьКИнтеграционнойОбработке, ПутьКФайлу, ПараметрыПодключенияMS, ТипОбработки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ФайлИнтеграционнойОбработкиСуществует = Ложь;
	ИнтеграционнаяОбработка = Неопределено;
	ИмяИнтеграционнойОбработки = "";
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS",АдресаПеременных);
	КонецЕсли;
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;
	
	Если ТипОбработки = Неопределено Тогда
		ТипОбработки= ?(НЕ ПараметрыПодключенияMS.Свойство("ТипОбработки") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыПодключенияMS.ТипОбработки),"ФайлНаДиске",ПараметрыПодключенияMS.ТипОбработки);
	КонецЕсли;
	
	ДвоичныеДанныеДляФЗ = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(ПолныйПутьКИнтеграционнойОбработке) Тогда
		#Область НесовместимыйКодFresh
		ФайлИнтеграционнойОбработкиСуществует = Истина;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			пДвоичныеДанные = ПолучитьИзВременногоХранилища(ПолныйПутьКИнтеграционнойОбработке);
			пИмяОбработки = ПолучитьИмяВременногоФайла();
			пДвоичныеДанные.Записать(пИмяОбработки);
		#Иначе	
			ЗащитаОтОпасныхДействий  = Новый ОписаниеЗащитыОтОпасныхДействий;
			ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
			пИмяОбработки = ВнешниеОбработки.Подключить(ПолныйПутьКИнтеграционнойОбработке,, Ложь, ЗащитаОтОпасныхДействий);
			
			// Получить ИО в виде двоичных данных
			ДвоичныеДанныеДляФЗ = ПолучитьИзВременногоХранилища(ПолныйПутьКИнтеграционнойОбработке);
		#КонецЕсли
		
		ЗащитаОтОпасныхДействий  = Новый ОписаниеЗащитыОтОпасныхДействий;
		ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		Попытка
			ИнтеграционнаяОбработка = ВнешниеОбработки.Создать(пИмяОбработки,ложь, ЗащитаОтОпасныхДействий);
		Исключение
			пАдресСтруктуры = Неопределено;
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Ошибка подключения интеграционной обработки';
								|en = 'Integration processing connection error'; be = 'Інтэграцыйная апрацоўка памылка падлучэння'; es = 'Error de conexión del procesamiento de integración'; ka = 'ინტეგრაციის დამუშავების კავშირის შეცდომა'; kk = 'Интеграциялық өңдеуді қосу қатесі'; ro = 'Eroare conexiune procesare integrare'; tr = 'Entegrasyon işleme bağlantı hatası'; uk = 'Помилка підключення інтеграційної обробки'; uz = 'Integratsiyani qayta ishlash ulanishidagi xato'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТекстОшибки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат ТекстОшибки;
		КонецПопытки;
	ИначеЕсли ТипОбработки = "ФайлНаДиске" Тогда
		Если (Не ПараметрыПодключенияMS.Свойство("РабочийКаталог")) // в старых версиях не сохранялись эти параметры 
			ИЛИ (Не ПараметрыПодключенияMS.Свойство("ИмяИнтеграционнойОбработки"))
			ИЛИ (Не ПараметрыПодключенияMS.Свойство("ПутьИнтеграционнойОбработки")) Тогда 
			ГлЯдро_ПересохранитьНастройкиПодключения(АдресаПеременных);
		КонецЕсли;
		
		РабочийКаталог = ПараметрыПодключенияMS.РабочийКаталог;
		
		Попытка
			ПутьОсновнойОбработки = ЭтотОбъект.ИспользуемоеИмяФайла;
		Исключение
			ПутьОсновнойОбработки = "";
		КонецПопытки;
		
		мАдресХранилища = Неопределено;
		ПолныйПутьКИнтеграционнойОбработке = "";
		ФайлИнтеграционнойОбработкиСуществует = Ложь;
		
		Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ПолныйПутьКИнтеграционнойОбработке = ПутьКФайлу;
			
			#Если ВебКлиент Тогда
				ФайлИнтеграционнойОбработкиСуществует = Ложь;
				
				СтрРезультат = НСтр("ru = 'Файл интеграционной обработки по пути ""%1"" не найден.';
										|en = 'The integration processing file on the path ""%1"" was not found.';
										|be = 'Файл інтэграцыйнай апрацоўкі па шляху ""%1 "" Не знойдзены.'; es = 'No se encontró el archivo de integración en la ruta ""%1"".'; ka = 'ინტეგრაციის დამუშავების ფაილი გზაზე ""%1 "" ვერ იქნა ნაპოვნი.'; kk = '""%1 "" жолы бойынша интеграциялық өңдеу файлы табылмады.'; ro = 'Fișierul de procesare a integrării pe calea ""%1 "" nu a fost găsit.'; tr = '""%1"" yolundaki entegrasyon işleme dosyası bulunamadı.'; uk = 'Файл інтеграційної обробки на шляху ""%1 "" не знайдено.'; uz = '""%1 "" yo''lida integratsiyani qayta ishlash fayli topilmadi.'");
				СтрРезультат = ГлЯдро_СтрШаблон(СтрРезультат, Строка(ПолныйПутьКИнтеграционнойОбработке));
	
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтрРезультат);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат СтрРезультат;
			#Иначе
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			#КонецЕсли
		КонецЕсли;
		
		Если НЕ ФайлИнтеграционнойОбработкиСуществует Тогда
			ИмяИнтеграционнойОбработки = ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
			ПутьИнтеграционнойОбработки = ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки;
			
			РазделительПути = ПолучитьРазделительПути();
			
			ДополнитьРазделительПути = ?(Прав(ПутьИнтеграционнойОбработки, 1) = РазделительПути, "", РазделительПути);
			ДополнитьРасширениеФайла = ?(Прав(ИмяИнтеграционнойОбработки, 4) = ".epf", "", ".epf");
			
			ПолныйПутьКИнтеграционнойОбработке = Строка(ПутьИнтеграционнойОбработки) + ДополнитьРазделительПути
				+ Строка(ИмяИнтеграционнойОбработки) + ДополнитьРасширениеФайла;
				
			// 1) Подключение по сохраненным данным
			Если ПутьИнтеграционнойОбработки = "REST_API" Тогда
				// ИО подключена из файла, загруженного по REST API. 
				// Получаем сохранённые двоичные данные.
				ИнтеграционнаяОбработкаДвоичныеДанные = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS);
				Если ИнтеграционнаяОбработкаДвоичныеДанные <> Неопределено Тогда
					мАдресХранилища = ПоместитьВоВременноеХранилище(ИнтеграционнаяОбработкаДвоичныеДанные, Новый УникальныйИдентификатор());
					ФайлИнтеграционнойОбработкиСуществует = Истина;
					ПолныйПутьКИнтеграционнойОбработке = "REST_API" + ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
				КонецЕсли;
				
			Иначе
				// Сохраненный путь ИО
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			КонецЕсли;
				
		КонецЕсли;
		
		// Ищем типовой файл, если не удалось получить интеграционную обработку из сохранённых данных
		
		// 2) Подключение из файла полученного по REST_API.
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(ИмяИнтеграционнойОбработки) Тогда
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("ПутьКФайлу", "DataProcessors\Integrations\");
			ПараметрыФайла.Вставить("ИмяФайла",   ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла);
			
			мАдресХранилища = ГлЯдро_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла, "REST_API", АдресаПеременных);
			
			Если мАдресХранилища <> Неопределено
				И ЭтоАдресВременногоХранилища(мАдресХранилища) Тогда
				
				ФайлИнтеграционнойОбработкиСуществует = Истина;
				ПолныйПутьКИнтеграционнойОбработке = "REST_API" + ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
						
				// Сохраняем двоичные данные для повторного использования
				ИнтеграционнаяОбработкаДвоичныеДанные = ПолучитьИзВременногоХранилища(мАдресХранилища);
				ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS, ИнтеграционнаяОбработкаДвоичныеДанные);		
						
			КонецЕсли;
			
		КонецЕсли;
		
		// 3) Подключение из рабочего каталога базы Mobile SMARTS (РабочийКаталог+Путь+Имя)
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(РабочийКаталог) Тогда
			РабочийКаталог = Строка(РабочийКаталог);
			
			// Если в ПутьИнтеграционнойОбработки указан абсолютный путь (упрощенная проверка для Windows), вариант (РабочийКаталог+Путь+Имя) не имеет смысла
			УказанАбсолютныйПуть = НЕ ГлЯдро_СтрНайти(ПутьИнтеграционнойОбработки, ":" + РазделительПути) = 0;
			
			Если НЕ УказанАбсолютныйПуть Тогда
				ДополнитьРазделительРабочийКаталог
					= ?(Прав(РабочийКаталог, 1) = РазделительПути, "", РазделительПути);
				ПутьИнтеграционнойОбработки = ?(Лев(ПутьИнтеграционнойОбработки, 1) = РазделительПути,
					Сред(ПутьИнтеграционнойОбработки, 2),
					ПутьИнтеграционнойОбработки);
				
				ПолныйПутьКИнтеграционнойОбработке = РабочийКаталог	+ ДополнитьРазделительРабочийКаталог
					+ ПутьИнтеграционнойОбработки + ДополнитьРазделительПути
					+ ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
						
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			КонецЕсли;
		КонецЕсли;
			
		// 4) Подключение по относительному пути из каталога файла основной обработки
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(ПутьОсновнойОбработки) Тогда
				
			ПутьИнтеграционнойОбработки = ГлЯдро_ПолучитьПутьИнтеграционнойОбработки(ПутьОсновнойОбработки);
			Если НЕ ПустаяСтрока(ПутьИнтеграционнойОбработки) Тогда
				ПолныйПутьКИнтеграционнойОбработке = ПутьИнтеграционнойОбработки
					+ ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
						
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			КонецЕсли;
		КонецЕсли;
		
		Если ФайлИнтеграционнойОбработкиСуществует Тогда
			
			ПолноеИмяФайла = ПолныйПутьКИнтеграционнойОбработке;
			Если мАдресХранилища <> Неопределено Тогда
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					пДвоичныеДанные = ПолучитьИзВременногоХранилища(мАдресХранилища);
					ПолноеИмяФайла = ПолучитьИмяВременногоФайла();
					пДвоичныеДанные.Записать(ПолноеИмяФайла);
				#Иначе	
					ЗащитаОтОпасныхДействий  = Новый ОписаниеЗащитыОтОпасныхДействий;
					ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
					ПолноеИмяФайла = ВнешниеОбработки.Подключить(мАдресХранилища,, Ложь, ЗащитаОтОпасныхДействий);
					
					// Получить ИО в виде двоичных данных
					ДвоичныеДанныеДляФЗ = ПолучитьИзВременногоХранилища(мАдресХранилища);
					
				#КонецЕсли
			КонецЕсли;
			
			ЗащитаОтОпасныхДействий  = Новый ОписаниеЗащитыОтОпасныхДействий;
			ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
			Попытка
				ИнтеграционнаяОбработка = ВнешниеОбработки.Создать(ПолноеИмяФайла,ложь, ЗащитаОтОпасныхДействий);
				пИмяОбработки = ИнтеграционнаяОбработка.Метаданные().Имя;
				Если ДвоичныеДанныеДляФЗ = Неопределено Тогда
					// Получить ИО в виде двоичных данных
					ДвоичныеДанныеДляФЗ = Новый ДвоичныеДанные(ПолноеИмяФайла);
				КонецЕсли;
			Исключение
				пАдресСтруктуры = Неопределено;
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Ошибка подключения интеграционной обработки';
									|en = 'Integration processing connection error'; be = 'Інтэграцыйная апрацоўка памылка падлучэння'; es = 'Error de conexión del procesamiento de integración'; ka = 'ინტეგრაციის დამუშავების კავშირის შეცდომა'; kk = 'Интеграциялық өңдеуді қосу қатесі'; ro = 'Eroare conexiune procesare integrare'; tr = 'Entegrasyon işleme bağlantı hatası'; uk = 'Помилка підключення інтеграційної обробки'; uz = 'Integratsiyani qayta ishlash ulanishidagi xato'";
				ТекстОшибки = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТекстОшибки);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат ТекстОшибки;
			КонецПопытки;
		Иначе
			// <Лог>
			ЯзСтрока = "ru = 'Файл интеграционной обработки по пути ""%1"" не найден.';
								|en = 'The integration processing file on the path ""%1"" was not found.';
