Процедура ГлЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокРеквизитов, СоответствияИмен)
	
	Для каждого Реквизит Из СписокРеквизитов Цикл
		ИмяПоля = Строка(Реквизит.Значение);
		ВнутренийИдентификатор = СоответствияИмен.Получить(ИмяПоля);
		Если ВнутренийИдентификатор <> Неопределено Тогда
			Реквизит.Значение = ВнутренийИдентификатор;
		КонецЕсли;
		Реквизит.Вставить("Имя", ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ГлЯдро_ПреобразоватьКлючиКВнешнимИдентификаторам(СтруктураРеквизитов, МетаданныеДокументаMS);
	
	СоответствиеРеквизитовИмена = МетаданныеДокументаMS.СоответствиеРеквизитовИмена;
	
	Результат = Новый Структура;
	Для каждого Поле Из СтруктураРеквизитов Цикл
		Если СоответствиеРеквизитовИмена.Свойство(Поле.Ключ) Тогда
			Результат.Вставить(СоответствиеРеквизитовИмена[Поле.Ключ], Поле.Значение);
		Иначе
			Результат.Вставить(Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураРеквизитов = Результат;
	
КонецПроцедуры

Функция ГлЯдро_ВычисляемыеПоляШапкиДокументаMS(Ключ, АдресаПеременных = Неопределено)
	
	Перем ПредставлениеПоля;
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	
	Если ЯзыкПлатформыMS = "RU" Тогда
		
		Если Ключ = "СтрокиПланКоличество"			Тогда	ПредставлениеПоля = "Количество (План)";
		ИначеЕсли Ключ = "СтрокиФактКоличество"		Тогда	ПредставлениеПоля = "Количество (Факт)";
		ИначеЕсли Ключ = "Состояние"				Тогда	ПредставлениеПоля = "Состояние";
		КонецЕсли;
		
	ИначеЕсли ЯзыкПлатформыMS = "EN" Тогда
				
		Если Ключ = "СтрокиПланКоличество"			Тогда	ПредставлениеПоля = "Rows (plan)";
		ИначеЕсли Ключ = "СтрокиФактКоличество"		Тогда	ПредставлениеПоля = "Rows (fact)";
		ИначеЕсли Ключ = "Состояние"				Тогда	ПредставлениеПоля = "State";
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПолей = Новый Структура("Представление", ПредставлениеПоля);
	Возврат СтруктураПолей;
		
КонецФункции

