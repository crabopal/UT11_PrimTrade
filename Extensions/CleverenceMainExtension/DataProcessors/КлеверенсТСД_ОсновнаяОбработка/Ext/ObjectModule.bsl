		СтруктураПараметров.Вставить("ЗначенияПараметров", ЗначенияПараметров);
		
		РезультатПроверки = ИнтеграционнаяОбработка.ПроверитьРаботуСМаркированнойПродукцией(СтруктураПараметров);
		
		УровеньЖурнала = ?(РезультатПроверки.Статус,
