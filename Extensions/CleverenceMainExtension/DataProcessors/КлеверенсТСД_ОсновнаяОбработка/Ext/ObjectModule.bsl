// Точка входа для пересылки накопленных лог-сообщений указанной базы Mobile SMARTS
// в Elasticsearch. При необходимости выполняет переинициализацию настроек.
//
// Параметры:
//  ИдентификаторБазыMS - Строка - идентификатор базы Mobile SMARTS.
//
// Возвращаемое значение:
//  Булево - Истина после завершения работы.
//
Функция ПереслатьОтправляемыеСообщенияВElasticsearch(ИдентификаторБазыMS) Экспорт
	
	ИмяСобытия = "ПереслатьОтправляемыеСообщенияВElasticsearch";
	
	ТипИнтерфейса 		= ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	АдресаПеременных 	= КомЯдро_СоздатьСтруктуруАдресаПеременных(, ИдентификаторБазыMS);
	НачалоОтправки 		= ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	НастройкиИнициализированы = КомЯдро_ПолучитьЗначениеПеременной("НастройкиИнициализированы", АдресаПеременных);
	
	НастройкиИзменились = ГлЯдро_НастройкиИзменились(АдресаПеременных);
	
	Если НастройкиИзменились ИЛИ НЕ НастройкиИнициализированы = Истина Тогда
		
		пСообщение = ГлЯдро_СтрШаблон("Переинициализация настроек. НастройкиИнициализированы = %1, НастройкиИзменились = %2",
			Строка(НастройкиИнициализированы), Строка(НастройкиИзменились));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
		ГлЯдро_Инициализация(ИмяСобытия, НастройкиИзменились,, АдресаПеременных);
		
	КонецЕсли;
	
	Попытка
		
		ГлЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearch(АдресаПеременных);
		
	Исключение
		
		пОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = ГлЯдро_СтрШаблон("Ошибка отправки логов в Elasticsearch: %1", пОписаниеОшибки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", пСообщение,, АдресаПеременных);
		
	КонецПопытки;
	
	пСообщение = НСтр("ru = 'Конец.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Информация", пСообщение, НачалоОтправки, АдресаПеременных);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

