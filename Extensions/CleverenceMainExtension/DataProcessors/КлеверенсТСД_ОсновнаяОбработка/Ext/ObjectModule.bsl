	//	ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников
	//	ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников
	
	СтрокаНастройки = Новый Структура();
	СтрокаНастройки.Вставить("Выгружать",							Ложь);
	СтрокаНастройки.Вставить("ИмяТаблицы",							"");
	СтрокаНастройки.Вставить("ИмяТаблицыПредставление",				"");
	СтрокаНастройки.Вставить("НастройкаКомпоновщикаСтрокой",		"");
	СтрокаНастройки.Вставить("СпособВыгрузки", 						"");
	СтрокаНастройки.Вставить("ИмяМакетаИО", 						"");
	СтрокаНастройки.Вставить("ТекстЗапросаВыгрузкиНаТСД", 			"");
	СтрокаНастройки.Вставить("ТекстКодаПолучениеПараметров", 		"");
	СтрокаНастройки.Вставить("ТаблицаСопоставленияПолей", 			Новый Массив);
	СтрокаНастройки.Вставить("Типовой",								Ложь);
	СтрокаНастройки.Вставить("ОчищатьПередВыгрузкой",				Ложь);
	СтрокаНастройки.Вставить("РазмерПорции",						0);
	Возврат СтрокаНастройки;
	
КонецФункции

