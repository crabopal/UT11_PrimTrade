//	- Строка - данные таблицы отобранных товаров в формате JSON, если тип интерфейса - REST_API
//	- Неопределено - если не удалось установить соединение с базой Клеверенс
Функция ПолучитьСписокНоменклатуры(ПараметрНоменклатуры, userId, mXmlDoc = Неопределено, Режим = 0) Экспорт
	
	ИмяСобытия = "ПолучитьСписокНоменклатуры";	
	
	Возврат ПолучитьТовар(ПараметрНоменклатуры, "", UserId, 6, mXmlDoc,, ИмяСобытия);
	
КонецФункции

// Обрабатывает запрос сервера Клеверенс на получение списка номенклатуры по массивам номенклатуры и упаковок
//
// Параметры:
//	ПараметрНоменклатуры - COMSafeArray из Строка - идентификаторы номенклатуры для отбора
//	ПараметрУпаковки - COMSafeArray из Строка - идентификаторы упаковок для отбора
//  userId - Строка - идентификатор пользователя Клеверенс		
//  mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//
// Возвращаемое значение:
//	- Строка - данные таблицы отобранных товаров в формате XML, если тип интерфейса - COM
//	- Строка - данные таблицы отобранных товаров в формате JSON, если тип интерфейса - REST_API
//	- Неопределено - если не удалось установить соединение с базой Клеверенс
Функция ПолучитьТовары(ПараметрНоменклатуры, ПараметрУпаковки, UserId, mXmlDoc) Экспорт
	
	ИмяСобытия = "ПолучитьТовары";
	
	Возврат	ПолучитьТовар(ПараметрНоменклатуры, ПараметрУпаковки, UserId, 4, mXmlDoc,, ИмяСобытия);
	
КонецФункции

// Обрабатывает запрос сервера Клеверенс на получение номенклатуры
//
// Параметры:
//	ПараметрНоменклатуры - Строка - идентификатор номенклатуры
//                       - Строка - штрихкод, код, алкокод, артикул номенклатуры
//                       - COMSafeArray из Строка - массив идентификаторов номенклатуры
//  ПараметрУпаковки - Строка - идентификатор упаковки
//                   - COMSafeArray из Строка - массив идентификаторов упаковок
//					 - Неопределено - если поиск по упаковкам не требуется
//  userId - Строка - идентификатор пользователя Клеверенс
//  Режим - Число - режим поиска номенклатуры
//  mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//	barcodeData - Строка - строка в формате XML или JSON, содержащая информацию об отсканированном штрихкоде
//	ИмяСобытия - Строка - имя события сервера Клеверенс
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Строка - данные таблицы отобранных товаров в формате XML, если тип интерфейса - COM
//	- Строка - данные таблицы отобранных товаров в формате JSON, если тип интерфейса - REST_API
//	- Неопределено - если не удалось установить соединение с базой Клеверенс
//
// @logskip
Функция ПолучитьТовар(ПараметрНоменклатуры, ПараметрУпаковки, UserId, Режим = 0, mXmlDoc = Неопределено, barcodeData = Неопределено, ИмяСобытия = "ПолучитьТовар", АдресаПеременных = Неопределено) Экспорт
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	логПоток = Неопределено;
	логСобытие = Неопределено;
	
	Попытка
		
		Если АдресаПеременных = Неопределено Тогда
			АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
		КонецЕсли;
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		
		// <Лог>
		логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
		
		SessionSMARTS = REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса);
		Если SessionSMARTS = Неопределено Тогда
			SessionSMARTS = mXmlDoc;
		КонецЕсли;
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ПараметрНоменклатуры,ПараметрУпаковки,UserId,Режим,mXmlDoc,barcodeData",
			ПараметрНоменклатуры, ПараметрУпаковки, UserId, Режим, SessionSMARTS, barcodeData);
			
		логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
		// </Лог>
		
		ПредставлениеПараметров = ГлЯдро_ПолучитьТекстовоеПредставлениеПараметров(Новый Структура("ПараметрНоменклатуры, ПараметрУпаковки", ПараметрНоменклатуры, ПараметрУпаковки));
		пСообщение 				= НСтр("ru = 'Начало, Режим: %1, Ид пользователя: %2%3';
										|en = 'Start, Mode: %1, User ID: %2%3'; be = 'Пачатак, Рэжым: %1, Ід карыстальніка: %2% 3'; es = 'Inicio, Modo: %1, Id de usuario: %2% 3'; ka = 'დაწყება, რეჟიმი: %1, მომხმარებლის ID: %2% 3'; kk = 'Басталуы, режимі: %1, пайдаланушы идентификаторы: %2%3'; ro = 'Pornire, Mod: %1, ID Utilizator: %2%3'; tr = 'Başlangıç, Mod: % 1, Kullanıcı Kimliği: % 2% 3'; uk = 'Початок, Режим: %1, ІД користувача: %2% 3'; uz = 'Boshlash, tartib: %1, foydalanuvchi identifikatori: %2% 3'");
		пСообщение 				= ГлЯдро_СтрШаблон(пСообщение, Строка(Режим), Строка(UserId), ПредставлениеПараметров);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		
		// Согласно PRODUCTS-16337: сброс и проверка ONLEX выполняется только для Режим = 6
		// (список номенклатуры). Финальная проверка после УстановитьДанныеТекущегоУзла
		// в центральном методе пропускается по ИмяВнешнегоВызова.
		ПараметрыИнициализации = Новый Структура("СбрасыватьONLEX", Режим = 6);
		
		Инит = ГлЯдро_ИнициализацияВнешнегоВызова(ИмяСобытия, mXmlDoc, ПараметрыИнициализации, АдресаПеременных);
				
		Если НЕ Инит.Успех Тогда
			
			Если Инит.ОшибкаСоединения И НЕ ЗначениеЗаполнено(Инит.ТекстОшибки) Тогда
				Результат = Неопределено;
			Иначе
				Результат = "#" + Инит.ТекстОшибки;
			КонецЕсли;
			
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка инициализации: %1, Режим: %2, Ид пользователя: %3'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), Инит.ТекстОшибки, Строка(Режим), Строка(UserId));
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"UserId,Режим",
				UserId, Режим);
				
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, Инит.ТекстОшибки,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			ЛогЗакрытьПоток(логПоток, АдресаПеременных);
			// </Лог>
			
			Возврат Результат;
			
		КонецЕсли;
		
		СтруктураШтрихкода = Неопределено;
		
		Если Режим = 0 Тогда
			Режим = "ПоискПоНоменклатуре";
		ИначеЕсли Режим = 1 Тогда
			Режим = "ПоискПоАртикулуКодуШК";
		ИначеЕсли Режим = 2 ИЛИ Режим = 3 Тогда
			Режим = "ПоискПоНоменклатуреУпаковке";
		ИначеЕсли Режим = 4 Тогда
			Режим = "ПоискПоМассивамНоменклатурыУпаковки";
		ИначеЕсли Режим = 5 Тогда
			Режим = "ПоискПоЧастиНаименования";
		ИначеЕсли Режим = 6 Тогда
			Режим = "СписокНоменклатуры";
		Иначе
			Режим = "";
		КонецЕсли;	
		
		Если Режим = "ПоискПоАртикулуКодуШК" Тогда
			ПозицииGTIN = Новый Массив;
			ПозицииGTIN.Добавить("(01)");
			ПозицииGTIN.Добавить("(02)");
			Для каждого ПозицияGTIN ИЗ ПозицииGTIN Цикл
				ПозицияВхождения = ГлЯдро_СтрНайти(ПараметрНоменклатуры, ПозицияGTIN);
				Если ПозицияВхождения Тогда
					ПараметрНоменклатуры = Сред(ПараметрНоменклатуры, ПозицияВхождения + 4, 14);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ИспользоватьbarcodeData = Ложь;
			Если НЕ ПозицияВхождения Тогда
				ПараметрДлина = СтрДлина(ПараметрНоменклатуры);
				
				// КМ табачной продукции
				ИспользоватьbarcodeData = ПараметрДлина = 21
					ИЛИ ПараметрДлина = 25
					ИЛИ ПараметрДлина = 29;
			КонецЕсли;
			
			Если ИспользоватьbarcodeData Тогда
				Попытка
					ДанныеШтрихкода = ГлЯдро_ЗагрузитьИзJSON(barcodeData);
				Исключение
					ДанныеШтрихкода = Неопределено;
					
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЯзСтрока = "ru = 'Ошибка при разборе barcodeData. Режим: %1, Ид пользователя: %2, barcodeData: %3'";
					
					прРежим  = Строка(Режим);
					прUserId = Строка(UserId);
					пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прРежим, прUserId, Строка(barcodeData));
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"Режим,UserId",
						прРежим, прUserId);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
					// </Лог>
				КонецПопытки;
				
				Если ТипЗнч(ДанныеШтрихкода) = Тип("Соответствие") Тогда
					GTIN = ДанныеШтрихкода.Получить("GTIN");
					Если НЕ ПустаяСтрока(GTIN) Тогда
						ПараметрНоменклатуры = GTIN;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтруктураШтрихкода = ГлЯдро_ПолучитьСтруктуруШтрихкодаEAN13(ПараметрНоменклатуры, АдресаПеременных);	
		КонецЕсли;
		
		ПараметрыВыгрузки = ГлЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника("Номенклатура", "Онлайн", АдресаПеременных);
		
		НастройкиКомпоновщика = "";
		Если ЗначениеЗаполнено(ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой) Тогда
			НастройкиКомпоновщика = ГлЯдро_ЗначениеИзСтрокиXML(ПараметрыВыгрузки.НастройкаКомпоновщикаСтрокой);
		КонецЕслИ;
		
		// Данные получаем по ID упаковки без постфикса, результат возвращаем - с постфиксом
		ПерезаполнитьПараметрУпаковки = Ложь;
		Если Режим = "ПоискПоНоменклатуреУпаковке" Тогда
			Если ЗначениеЗаполнено(ПараметрУпаковки) И ТипЗнч(ПараметрУпаковки) = Тип("Строка") Тогда
				ПараметрУпаковкиСПостфиксом = ПараметрУпаковки;
				
				ПерезаполнитьПараметрУпаковки = ГлЯдро_УдалитьПостфиксыУпаковок(ПараметрУпаковки);
			КонецЕсли;
		ИначеЕсли Режим = "ПоискПоМассивамНоменклатурыУпаковки" Тогда	
			РезультатОбработкиПараметров = ГлЯдро_УдалитьПостфиксыУпаковокИСкопироватьПараметры(ПараметрНоменклатуры, ПараметрУпаковки);
			
			ТаблицаИсходныхПараметров 	  = РезультатОбработкиПараметров.ТаблицаИсходныхПараметров;
			ПерезаполнитьПараметрУпаковки = РезультатОбработкиПараметров.ПерезаполнитьПараметрУпаковки;
		КонецЕсли;
		
		ПараметрыУзлов = ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных);
		ПараметрыОнлайн = Новый Структура("ПараметрНоменклатуры,ПараметрУпаковки,Режим,СтруктураШтрихкода", ПараметрНоменклатуры, ПараметрУпаковки, Режим, СтруктураШтрихкода);
		
		// Перенес из ГлЯдро_УстановитьПараметрыСКДДляНоменклатуры
		Если Режим = "СписокНоменклатуры" Тогда
			МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
			ИмяСправочникаНоменклатуры = МетаданныеНСИ.Номенклатура.ИмяСправочника;
			СсылкаНоменклатуры = ГлЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаНоменклатуры, ПараметрыОнлайн.ПараметрНоменклатуры);
			ПараметрыОнлайн.Вставить("СсылкаНоменклатуры",СсылкаНоменклатуры);
			
			Если СсылкаНоменклатуры.ЭтоГруппа ИЛИ НЕ ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда // если заходим в корень справочника, то родитель будет пустой ссылкой
				Режим = "СписокНоменклатурыДляГрупп";
			Иначе
				Режим = "СписокУпаковокДляНоменклатуры";
			КонецЕсли;
			ПараметрыОнлайн.Вставить("Режим",Режим);
		КонецЕсли;
		
		РаботаБезАлкоголя = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя",,АдресаПеременных);
		
		пСообщение = НСтр("ru = '1. Получение таблицы товаров в 1С %1, Режим: %2, Ид пользователя: %3';
							|en = '1. Getting a table of products in 1C %1, Mode: %2, User ID: %3';
							|be = '1. Атрыманне табліцы тавараў у 1С %1, Рэжым: %2, Ід карыстальніка: %3'; es = '1. Obtención de la tabla de productos en 1C %1, Modo: %2, Id de usuario: %3'; ka = '1. პროდუქციის ცხრილის მიღება 1c %1-ში, რეჟიმი: %2, მომხმარებლის ID: %3'; kk = '1. 1С % 1 тауарлар кестесін алу, режимі: %2, пайдаланушы идентификаторы: %3'; ro = '1. Obținerea unui tabel de produse în 1C %1, Mod: %2, ID Utilizator: %3'; tr = '1. Mal tablosunun % 1''de alınması 1, Mod: % 2, Kullanıcı Kimliği: %3'; uk = '1. Отримання таблиці товарів в 1С %1, Режим: %2, ВД користувача: %3'; uz = '1. 1C %1-da tovarlar jadvalini olish, rejim: %2, foydalanuvchi identifikatori: %3'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ПараметрыУзлов), Строка(Режим), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		Если Режим = "ПоискПоАртикулуКодуШК"
			И СтрДлина(ПараметрНоменклатуры) = 14 Тогда
			ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыПоАртикулуКодуШК(ПараметрНоменклатуры, НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
		Иначе
			ТаблицаТоваров = ГлЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS("Номенклатура", НастройкиКомпоновщика, ПараметрыУзлов, ПараметрыОнлайн, РаботаБезАлкоголя, ПараметрыВыгрузки, АдресаПеременных);
		КонецЕсли;
		
		ТекстКоличествоСтрок = " (" + Строка(ТаблицаТоваров.Количество()) + " стр.)";
		
		пСообщение = НСтр("ru = '2. Таблица товаров в 1С получена %1%2, Режим: %3, Ид пользователя: %4';
							|en = '2. The table of products in 1C received %1%2, Mode: %3, User ID: %4';
							|be = '2. Табліца тавараў у 1С атрымана %1% 2, Рэжым: %3, Ід карыстальніка: %4'; es = '2. Tabla de productos en 1C recibida %1% 2, Modo: %3, Id de usuario: %4'; ka = '2. პროდუქტების ცხრილი 1C-ში მიიღო %1% 2, რეჟიმი: %3, მომხმარებლის ID: %4'; kk = '2. 1С тауарлар кестесі %1% 2, режимі: % 3, Пайдаланушы идентификаторы: %4'; ro = '2. Tabelul de produse în 1C a primit %1%2, MOD: %3, ID Utilizator: %4'; tr = '2. 1s''deki mal tablosu% 1% 2, Mod:% 3, Kullanıcı Kimliği:% 4 alındı'; uk = '2. Таблиця товарів в 1С отримана %1% 2, Режим: %3, ВД користувача: %4'; uz = '2. 1C-dagi tovarlar jadvali %1% 2, rejim: %3, foydalanuvchi identifikatori: %4'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ТаблицаТоваров), ТекстКоличествоСтрок, Строка(Режим), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		Если СтруктураШтрихкода <> Неопределено И СтруктураШтрихкода.ЭтоВесовойТовар Тогда
			ТаблицаТоваров.Колонки.Добавить("Quantity");
			ТаблицаТоваров.ЗаполнитьЗначения(СтруктураШтрихкода.КоличествоТовара, "Quantity");	
		КонецЕсли;
		
		КолонкиТаблицыТоваров = ТаблицаТоваров.Колонки;
			
		// При онлайн запросе надо очистить BasePackingId что бы не приходило с сервера запроса уточняющего за данными в BasePackingId 
		//Возможны проблемы в работе без него		
		//Если КолонкиТаблицыТоваров.Найти("Product_BasePackingId") <> Неопределено Тогда
		//	ТаблицаТоваров.ЗаполнитьЗначения("", "Product_BasePackingId");
		//КонецЕсли;
		
		// При запросе через "ПоискПоНоменклатуреУпаковке" и "ПоискПоМассивамНоменклатурыУпаковки" Поля: ИмяХарактеристики, ИдХарактеристики, ИмяСерии, ИдСерии - очистить
		Если Режим = "ПоискПоНоменклатуреУпаковке" 
			ИЛИ Режим = "ПоискПоМассивамНоменклатурыУпаковки" Тогда
			//Если КолонкиТаблицыТоваров.Найти("Product_BasePackingId") <> Неопределено Тогда
			//	ТаблицаТоваров.ЗаполнитьЗначения("", "Product_BasePackingId");
			//КонецЕсли;
			Если КолонкиТаблицыТоваров.Найти("Packing_Barcode") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_Barcode");
			КонецЕсли;				
			Если КолонкиТаблицыТоваров.Найти("Packing_price") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения(0, "Packing_price");
			КонецЕсли;
			Если КолонкиТаблицыТоваров.Найти("Packing_qty") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения(0, "Packing_qty");
			КонецЕсли;
			Если КолонкиТаблицыТоваров.Найти("Packing_ИмяХарактеристики") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_ИмяХарактеристики");
			КонецЕсли;	
			Если КолонкиТаблицыТоваров.Найти("Packing_ИдХарактеристики") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_ИдХарактеристики");
			КонецЕсли;	
			Если КолонкиТаблицыТоваров.Найти("Packing_ИмяСерии") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_ИмяСерии");
			КонецЕсли;	
			Если КолонкиТаблицыТоваров.Найти("Packing_ИдСерии") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_ИдСерии");
			КонецЕсли;
			Если КолонкиТаблицыТоваров.Найти("Packing_ИсходныйGTIN") <> Неопределено Тогда
				ТаблицаТоваров.ЗаполнитьЗначения("", "Packing_ИсходныйGTIN");
			КонецЕсли;
			
			// Нужно восстановить Packing_Id с постфиксом
			Если КолонкиТаблицыТоваров.Найти("Packing_Id") <> Неопределено И ПерезаполнитьПараметрУпаковки Тогда
				Если Режим = "ПоискПоНоменклатуреУпаковке" Тогда
					ТаблицаТоваров.ЗаполнитьЗначения(ПараметрУпаковкиСПостфиксом, "Packing_Id");
				ИначеЕсли Режим = "ПоискПоМассивамНоменклатурыУпаковки"	Тогда
					ГлЯдро_ВосстановитьПостфиксыУпаковок(ТаблицаТоваров, ТаблицаИсходныхПараметров);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Режим = "ПоискПоАртикулуКодуШК" Тогда
			//Если КолонкиТаблицыТоваров.Найти("Product_BasePackingId") <> Неопределено Тогда
			//	ТаблицаТоваров.ЗаполнитьЗначения("", "Product_BasePackingId");
			//КонецЕсли;
		КонецЕсли;						
		
		Если ТаблицаТоваров <> Неопределено Тогда
			ГлЯдро_СвернутьТаблицуЗначений(ТаблицаТоваров);			
			ТекстКоличествоСтрок = " (" + Строка(ТаблицаТоваров.Количество()) + " стр.)";
		КонецЕсли;
		
		пСообщение = НСтр("ru = '3. Закончена пост обработка %1%2, Режим: %3, Ид пользователя: %4';
							|en = '3. Post processing is completed %1%2, Mode: %3, User ID: %4';
							|be = '3. Скончана пост апрацоўка %1% 2, Рэжым: %3, Ід карыстальніка: %4'; es = '3. Acabado post procesamiento %1% 2, Modo: %3, id de usuario: %4'; ka = '3. Post დამუშავება დასრულებულია %1% 2, რეჟიმი: %3, მომხმარებლის ID: %4'; kk = '3. Өңдеу %1% 2, режимі: %3, Пайдаланушы идентификаторы: %4'; ro = '3. Procesarea ulterioară este finalizată %1% 2, MOD: %3, ID Utilizator: %4'; tr = '3. İşlem sonrası% 1% 2 tamamlandı, Mod:% 3, Kullanıcı kimliği:% 4'; uk = '3. Закінчена пост обробка %1% 2, Режим: %3, ІД користувача: %4'; uz = '3. Post tugadi ishlov berish %1%2, rejim: %3, foydalanuvchi ID: %4'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ТаблицаТоваров), ТекстКоличествоСтрок, Строка(Режим), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Ошибка при получении товара. Режим: %1, Ид пользователя: %2'";
		
		прРежим 	= Строка(Режим);
		прUserId 	= Строка(UserId);
		пСообщение 	= ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прРежим, прUserId);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"Режим,UserId",
			прРежим, прUserId);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
		Результат = Неопределено;
	КонецПопытки;
	
	Если ТаблицаТоваров <> Неопределено Тогда
		
		ИспJSON_mXmlDoc = КомЯдро_ПолучитьЗначениеПеременной("ИспJSON_mXmlDoc",АдресаПеременных);
		Если ИспJSON_mXmlDoc = Истина
			ИЛИ (ИспJSON_mXmlDoc = Неопределено И ТипИнтерфейса = "REST_API") Тогда
			
			Если Режим = "ПоискПоАртикулуКодуШК" Тогда
				SessionSMARTS = ГлЯдро_ЗагрузитьИзJSON(mXmlDoc);
				camelCase = Ложь;	
				Если SessionSMARTS.Получить("deviceInfo") <> Неопределено Тогда
					camelCase = Истина;
				КонецЕсли;
				ДокИнфо = SessionSMARTS[?(camelCase,"deviceInfo","DeviceInfo")];
				// Если это просмотр справочника дополняем результат изображением
				Если ДокИнфо.Получить("DocumentTypeName") = "ПросмотрСправочников" Тогда					
					ГлЯдро_ДополнитьНоменклатуруИзображением(ТаблицаТоваров, АдресаПеременных);					
				КонецЕсли;	
			КонецЕсли;
			
			Результат = REST_API_ТаблицаЗначенийВМассивСтруктур(ТаблицаТоваров);
			Результат = ГлЯдро_ПолучитьJSON(Результат);
		Иначе
			Результат = ГлЯдро_ТаблицаЗначенийВCOMSafeArray(ТаблицаТоваров);	
		КонецЕсли; 
	КонецЕсли; 
	
	пСообщение = НСтр("ru = 'Конец, Режим: %1, Ид пользователя: %2';
						|en = 'End, Mode: %1, User ID: %2'; be = 'Канец, Рэжым: %1, Ід карыстальніка: %2'; es = 'Fin, Modo: %1, Id de usuario: %2'; ka = 'დასასრული, რეჟიმი: %1, მომხმარებლის ID: %2'; kk = 'Соңы, режимі: %1, пайдаланушы идентификаторы: %2'; ro = 'Sfârșit, Mod: %1, ID Utilizator: %2'; tr = 'Son, Mod: % 1, Kullanıcı kimliği: % 2'; uk = 'Кінець, Режим: %1, Ідентифікатор користувача: %2'; uz = 'Tugatish, rejim: %1, foydalanuvchi ID: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(Режим), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЯчейкуПоИд(Ид, ИдСклада, userId, mXmlDoc=Неопределено) Экспорт
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ПолучитьЯчейкуПоИд";
	логПоток = Неопределено;
	логСобытие = Неопределено;
	
	АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	SessionSMARTS = REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса);
	Если SessionSMARTS = Неопределено Тогда
		SessionSMARTS = mXmlDoc;
	КонецЕсли;
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Ид,ИдСклада,userId,mXmlDoc",
		Ид, ИдСклада, userId, SessionSMARTS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыИнициализации = Новый Структура("ПроверятьСоединение, УстанавливатьДанныеУзла, СбрасыватьONLEX", Ложь, Ложь, Ложь);
	
	Инит = ГлЯдро_ИнициализацияВнешнегоВызова(ИмяСобытия, Неопределено, ПараметрыИнициализации, АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Начало, Ид: %1, ИдСклада: %2, Ид пользователя: %3';
						|en = 'Start, Id: %1, Warehouse ID: %2, User ID: %3'; be = 'Пачатак, Ід: %1, ИдСклада: %2, Вд карыстальніка: %3'; es = 'Inicio, Id: %1, id de Archivo: %2, id de usuario: %3'; ka = 'დაწყება, Id: %1, საწყობის ID: %2, მომხმარებლის ID: %3'; kk = 'Басталуы, идентификаторы: %1, идентификаторы: %2, пайдаланушы идентификаторы: %3'; ro = 'Start, Id: %1, ID depozit: %2, ID Utilizator: %3'; tr = 'Başlangıç, Kimlik: % 1, Kimlik Bilgileri: % 2, Kullanıcı Kimliği: % 3'; uk = 'Початок, ІД: %1, Ідсклад: %2, ІД користувача: %3'; uz = 'Boshlash, ID: %1, Idsklada: %2, foydalanuvchi ID: %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(Ид), Строка(ИдСклада), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
	Если МетаданныеНСИ.Свойство("Ячейки") И МетаданныеНСИ.Ячейки.Свойство("ИмяСправочника") И ЗначениеЗаполнено(МетаданныеНСИ.Ячейки.ИмяСправочника) Тогда
		ИмяСправочникаЯчейки = МетаданныеНСИ.Ячейки.ИмяСправочника;
	Иначе
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", "");
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных);
		// </Лог>
		Возврат "";
	КонецЕсли;
	
	Попытка
		Ячейка = Справочники[ИмяСправочникаЯчейки].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Если Не ГлЯдро_СсылкаСуществует(Ячейка) Тогда
			Ячейка = Неопределено;
		КонецЕсли;
	Исключение
		
		// <Лог>
		ИнфоОшибка 	= ИнформацияОбОшибке();
		ЯзСтрока 	= "ru = 'Ошибка при получении ячейки по Ид: %1, ИдСклада: %2, Ид пользователя: %3'";
		пСообщение 	= ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), Строка(Ид), Строка(ИдСклада), Строка(userId));
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"Ид,ИдСклада,userId",
			Ид, ИдСклада, userId);
			
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", "");
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных);
		// </Лог>
		
		Возврат "";
	КонецПопытки;
	
	Результат = ПолучитьДанныеЯчейки(Ячейка, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЯчейкуПоШтрихкоду(ШК, ИдСклада, userId, mXmlDoc=Неопределено) Экспорт	
			
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ПолучитьЯчейкуПоШтрихкоду";
	логПоток = Неопределено;
	логСобытие = Неопределено;
	
	АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	SessionSMARTS = REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса);
	Если SessionSMARTS = Неопределено Тогда
		SessionSMARTS = mXmlDoc;
	КонецЕсли;
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ШК,ИдСклада,userId,mXmlDoc",
		ШК, ИдСклада, userId, SessionSMARTS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыИнициализации = Новый Структура("ПроверятьСоединение, УстанавливатьДанныеУзла, СбрасыватьONLEX", Ложь, Ложь, Ложь);
	
	Инит = ГлЯдро_ИнициализацияВнешнегоВызова(ИмяСобытия, Неопределено, ПараметрыИнициализации, АдресаПеременных);
		
	пСообщение = НСтр("ru = 'Начало, ШК: %1, ИдСклада: %2, Ид пользователя: %3';
						|en = 'Start, Barcode: %1, Warehouse ID: %2, User ID: %3'; be = 'Пачатак, штрыхкодаў: %1, ИдСклада: %2, Ід карыстальніка: %3'; es = 'Origen, código De Barras: %1, id de Usuario: %2, id de usuario: %3'; ka = 'დაწყება, შტრიხკოდი: %1, საწყობის ID: %2, მომხმარებლის ID: %3'; kk = 'Басталуы, Штрихкод: %1, Идскад: % 2, пайдаланушы идентификаторы: %3'; ro = 'Start, cod de bare: %1, ID depozit: %2, ID Utilizator: %3'; tr = 'Başlangıç, Barkod: % 1, Depo: % 2, Kullanıcı Kimliği:% 3'; uk = 'Початок, Штрихкод: %1, Ідсклада: %2, ІД користувача: %3'; uz = 'Boshlash, shtrix kod: % 1, ombor identifikatori: %2, foydalanuvchi identifikatori: %3'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ШК), Строка(ИдСклада), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
	
	Если СтрДлина(ШК) = 36 Тогда
		пСообщение = НСтр("ru = 'Выполняем поиск ячейки по GUID: %1, ИдСклада: %2, Ид пользователя: %3';
							|en = 'We search for the cell by GUID: %1, Folder ID: %2, User ID: %3';
							|be = 'Выконваем пошук ячэйкі па GUID: %1, ИдСклада: %2, ВД карыстальніка: %3'; es = 'Buscando una celda por GUID: %1, id de Archivo: %2, id de usuario: %3'; ka = 'ჩვენ ვეძებთ უჯრედს GUID-ით: %1, საქაღალდის ID: %2, მომხმარებლის ID: %3'; kk = 'Біз ұяшықты GUID бойынша іздейміз: %1, id қоймасы: %2, пайдаланушы идентификаторы: %3'; ro = 'Căutăm celula după GUID: %1, ID Folder: %2, ID Utilizator: %3'; tr = 'Hücreyi GUID''YE göre arıyoruz: % 1, Depolama alanı:% 2, Kullanıcı kimliği:% 3'; uk = 'Виконуємо пошук комірки по GUID: %1, Ідсклада: %2, ІД користувача: %3'; uz = 'Biz GUID: %1, Idsclad: %2, foydalanuvchi ID: %3 bo''yicha katakchani qidiramiz'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ШК), Строка(ИдСклада), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
		// ШК может быть 36 символов и не быть гуид
		ДанныеЯчейки = ПолучитьЯчейкуПоИд(ШК, ИдСклада, userId, mXmlDoc);
		Если Не ПустаяСтрока(ДанныеЯчейки) Тогда
			пСообщение = НСтр("ru = 'Ячейка по GUID найдена: %1, ИдСклада: %2, Ид пользователя: %3';
								|en = 'GUID cell found: %1, Warehouse ID: %2, User ID: %3';
								|be = 'Вочка па GUID знойдзена: %1, ИдСклада: %2, Ід карыстальніка: %3'; es = 'Celda por GUID encontrada: %1, id de Archivo: %2, id de usuario: %3'; ka = 'GUID საკანში ნაპოვნია: %1, ანაბარი ID: %2, მომხმარებლის ID: %3'; kk = 'GUID ұяшығы табылды: %1, Сақтау: %2, Пайдаланушы идентификаторы: %3'; ro = 'GUID cell găsit: %1, ID depozit: %2, ID Utilizator: %3'; tr = 'Guıd''ye göre hücre bulundu: % 1, Depolama alanı: % 2, Kullanıcı kimliği: %3'; uk = 'Клітинка по GUID знайдена: %1, Ідсклада: %2, ІД користувача: %3'; uz = 'GUID tomonidan topilgan hujayra: %1, Idsclad: %2, foydalanuvchi ID: %3'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ШК), Строка(ИдСклада), Строка(UserId));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеЯчейки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			ЛогЗакрытьПоток(логПоток, АдресаПеременных);
			// </Лог>
			
			Возврат ДанныеЯчейки;
		Иначе
			пСообщение = НСтр("ru = 'Ячейка по GUID не найдена: %1, ИдСклада: %2, Ид пользователя: %3';
								|en = 'GUID cell not found: %1, Warehouse ID: %2, User ID: %3';
								|be = 'Вочка па GUID не знойдзена: %1, ИдСклада: %2, Ід карыстальніка: %3'; es = 'Celda por GUID no encontrada: %1, id de Archivo: %2, id de usuario: %3'; ka = 'GUID cell ვერ მოიძებნა: %1, საწყობის ID: %2, მომხმარებლის ID: %3'; kk = 'GUID ұяшығы табылмады: %1, Idspad: %2, пайдаланушы идентификаторы: %3'; ro = 'Celula GUID nu a fost găsită: %1, ID depozit: %2, ID Utilizator: %3'; tr = 'Guıd''ye göre hücre bulunamadı: %1, Depolama alanı: % 2, Kullanıcı kimliği: %3'; uk = 'Клітинку GUID не знайдено: %1, Ідсклад: %2, Ідентифікатор користувача: %3'; uz = 'GUID tomonidan hujayra topilmadi: %1, Idsclad: %2, foydalanuvchi ID: %3'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ШК), Строка(ИдСклада), Строка(UserId));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	МетаданныеНСИ = ГлЯдро_ПолучитьМетаданныеНСИ(АдресаПеременных);
	Если МетаданныеНСИ.Свойство("Ячейки") И МетаданныеНСИ.Ячейки.Свойство("ИмяСправочника") И ЗначениеЗаполнено(МетаданныеНСИ.Ячейки.ИмяСправочника) Тогда
		ИмяСправочникаЯчейки = МетаданныеНСИ.Ячейки.ИмяСправочника;			
	Иначе
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", "");
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных);
		// </Лог>
		Возврат "";
	КонецЕсли;
	
	Ячейка = Неопределено;
	
	Попытка
		КодЯчейки10 = Число(ШК);
		КодЯчейки16 = ГлЯдро_ПреобразоватьДесятичноеЧислоВШестнадцатиричнуюСистемуСчисления(КодЯчейки10);
		
		Пока СтрДлина(КодЯчейки16) < 32 Цикл
			КодЯчейки16 = "0" + КодЯчейки16;
		КонецЦикла;
		
		Если СтрДлина(КодЯчейки16) = 32 Тогда
			Guid = Лев(КодЯчейки16, 8) + "-" + 
				Сред(КодЯчейки16, 9, 4) + "-" + Сред(КодЯчейки16, 13, 4) + "-" + Сред(КодЯчейки16, 17, 4) + "-" + Сред(КодЯчейки16, 21, 12);
								
			Ячейка = Справочники[ИмяСправочникаЯчейки].ПолучитьСсылку(Новый УникальныйИдентификатор(Guid));
			Если Не ГлЯдро_СсылкаСуществует(Ячейка) Тогда
				Ячейка = Неопределено;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
		
	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	СпрЯчейки.Ссылка КАК Ссылка
			|ИЗ
			|	&ИмяСправочника КАК СпрЯчейки
			|ГДЕ
			|	НЕ СпрЯчейки.ПометкаУдаления
			|	И СпрЯчейки.Код = &ШК";
		Запрос.УстановитьПараметр("ШК", ШК);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ИмяСправочника",
			"Справочник." + ИмяСправочникаЯчейки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ячейка = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Ячейка: %1, Ид пользователя: %2';
						|en = 'End, Cell: %1, User ID: %2'; be = 'Канец, вочка: %1, Ід карыстальніка: %2'; es = 'Final, Celda: %1, Id de usuario: %2'; ka = 'დასასრული, უჯრედი: %1, მომხმარებლის ID: %2'; kk = 'Соңы, ұяшық: %1, пайдаланушы идентификаторы: %2'; ro = 'Sfârșit, celulă: %1, ID Utilizator: %2'; tr = 'Son, Hücre: % 1, Kullanıcı Kimliği: %2'; uk = 'Кінець, клітинка: %1, Ідентифікатор користувача: %2'; uz = 'Tugatish, hujayra: %1, foydalanuvchi ID: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(Ячейка), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	Результат = ПолучитьДанныеЯчейки(Ячейка, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// @logskip
Функция ПолучитьДанныеЯчейки(Ячейка, АдресаПеременных)
	
	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");		
	
	СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);

	ИспJSON_mXmlDoc = КомЯдро_ПолучитьЗначениеПеременной("ИспJSON_mXmlDoc",АдресаПеременных);
	Если ИспJSON_mXmlDoc = Истина ИЛИ (ИспJSON_mXmlDoc = Неопределено И ТипИнтерфейса = "REST_API") Тогда
		 Cell = Новый Структура;
		 Cell.Вставить("Id",		  XmlСтрока(Ячейка));
		 Cell.Вставить("Name",		  Ячейка.Код);
		 Cell.Вставить("Barcode",	  ГлЯдро_ЧисловойКодПоСсылке(Ячейка));
		 Cell.Вставить("Description", Ячейка.Наименование);

		 Результат = ГлЯдро_ПолучитьJSON(Cell);
	Иначе
		#Область НесовместимыйКодFresh
		Cell = Новый COMОбъект("Cleverence.Warehouse.Cell");
		Cell.Id			 = XmlСтрока(Ячейка);
		Cell.Name 		 = Ячейка.Код;
		Cell.Barcode 	 = ГлЯдро_ЧисловойКодПоСсылке(Ячейка);
		Cell.Description = Ячейка.Наименование;
		
		Результат = СтруктураПодключенияБазыMS.StorageConnector.СохранитьОбъектВ_XML(Cell);	
		#КонецОбласти //НесовместимыйКодFresh
	КонецЕсли;
	
	Возврат Результат;

	
КонецФункции

// Обрабатывает запрос сервера Клеверенс на вызов пользовательской экспортной функции из интеграционной обработки
//
// Параметры:
//	ИмяФункции - Строка - Наименование функции в интеграционной обработке
//	ТипВозвращаемогоЗначения - Строка - Тип объекта Клеверенс
//  Параметр1..Параметр10 - Произвольный - Параметры, передаваемые из Клеверенс в 1С.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	    - Произвольный - данные, возвращаемые пользовательской функцией
//      - Строка - Текст ошибки в случае исключения
// @logskip
Функция ВызовПроизвольнойФункции(ИмяФункции, ТипВозвращаемогоЗначения = "",  
											Параметр1 = Неопределено,
											Параметр2 = Неопределено,
											Параметр3 = Неопределено,
											Параметр4 = Неопределено,
											Параметр5 = Неопределено,
											Параметр6 = Неопределено,
											Параметр7 = Неопределено,
											Параметр8 = Неопределено,
											Параметр9 = Неопределено,
											Параметр10 = Неопределено, АдресаПеременных = Неопределено) Экспорт	
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия 	= "ВызовПроизвольнойФункции";
	логПоток 	= Неопределено;
	логСобытие 	= Неопределено;
	
	пСообщение = НСтр("ru = 'Начало, Выполнение вызова произвольной функции: %1';
						|en = 'Start, Execution of a call to an arbitrary function: %1';
						|be = 'Пачатак, Выкананне выкліку адвольнай функцыі: %1'; es = 'Inicio, Ejecución de una llamada a una función arbitraria: %1'; ka = 'დაწყება, თვითნებური ფუნქციის გამოძახების შესრულება: %1'; kk = 'Ерікті функцияның басталуы, орындалуы: %1'; ro = 'Start, executarea unui apel către o funcție arbitrară: %1'; tr = 'Başlangıç, Keyfi bir işlev çağrısı yürütme: %1'; uk = 'Початок, виконання виклику довільної функції: %1'; uz = 'Boshlash, ixtiyoriy funktsiyani chaqirish: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяФункции));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);	
	
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		
	Если АдресаПеременных = Неопределено Тогда
		АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных();
	КонецЕсли;
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяФункции",
		ИмяФункции);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НастройкиИнициализированы = КомЯдро_ПолучитьЗначениеПеременной("НастройкиИнициализированы", АдресаПеременных);
	
	НастройкиИзменились = ГлЯдро_НастройкиИзменились(АдресаПеременных);
	Если НастройкиИзменились
		ИЛИ НЕ НастройкиИнициализированы = Истина Тогда
		пСообщение = НСтр("ru = 'Переинициализация настроек. НастройкиИнициализированы = %1, НастройкиИзменились = %2';
							|en = 'Reinitialization of settings. Settings Initialized = %1, Settings Changed = %2';
							|be = 'Переинициализация налад. Настройкіініцыялізаваныя = %1, Наладызмяніліся = %2'; es = 'Re-inicialización de la configuración. Configuración Inicializada = %1, Configuración Cambiada = %2'; ka = 'პარამეტრების რეინიტიალიზაცია. პარამეტრები ინიციალიზებულია = %1, პარამეტრები შეიცვალა = % 2'; kk = 'Параметрлерді қайта инициализациялау. Параметрлер Инициализацияланған = %1, Параметрлер Өзгертілген = %2'; ro = 'Reinițializarea setărilor. Setări Inițializate = %1, Setări Modificate = %2'; tr = 'Ayarların yeniden başlatılması. Ayarlar başlatıldı = %1, ayarlar değiştirildi = %2'; uk = 'Переініціалізація налаштувань. Налаштуванняініціалізовані = %1, Налаштуваннязмінилися = %2'; uz = 'Sozlamalarni qayta boshlash. Sozlamalar Boshlang''ich = %1, Sozlamalar O''zgartirilgan = %2'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(НастройкиИнициализированы), Строка(НастройкиИзменились));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение,,АдресаПеременных);
		ГлЯдро_Инициализация(ИмяСобытия,НастройкиИзменились,,АдресаПеременных);		
	КонецЕсли;		
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		пСообщение = НСтр("ru = 'Конец, Выполнение вызова произвольной функции: %1';
							|en = 'End, Making a call to an arbitrary function: %1'; be = 'Канец, Выкананне выкліку адвольнай функцыі: %1'; es = 'Fin, Ejecución de una llamada a una función arbitraria: %1'; ka = 'ბოლოს, მიღების ზარი თვითნებური ფუნქცია: %1'; kk = 'Соңы, ерікті функцияға қоңырау шалу: %1'; ro = 'Sfârșit, efectuarea unui apel către o funcție arbitrară: %1'; tr = 'Son, Keyfi işlev çağrısının yürütülmesi: %1'; uk = 'Кінець, виконання виклику довільної функції: %1'; uz = 'Tugatish, ixtiyoriy funktsiyani chaqirish: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяФункции));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		ЛогЗакрытьПоток(логПоток, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Параметр1", Параметр1);
	СтруктураПараметров.Вставить("Параметр2", Параметр2);
	СтруктураПараметров.Вставить("Параметр3", Параметр3);
	СтруктураПараметров.Вставить("Параметр4", Параметр4);
	СтруктураПараметров.Вставить("Параметр5", Параметр5);
	СтруктураПараметров.Вставить("Параметр6", Параметр6);
	СтруктураПараметров.Вставить("Параметр7", Параметр7);
	СтруктураПараметров.Вставить("Параметр8", Параметр8);
	СтруктураПараметров.Вставить("Параметр9", Параметр9);
	СтруктураПараметров.Вставить("Параметр10", Параметр10);
	
	СтрокаПараметров = "";
	Инд = 10;	
	Пока Инд > 0 Цикл
		ИмяПараметра = "Параметр"+Строка(Инд);
		СтрокаВызова = "Параметры." + ИмяПараметра; 
		Параметр= ГлЯдро_ВычислитьВБезопасномРежиме(СтрокаВызова, СтруктураПараметров);
		Если Параметр <> Неопределено Тогда
			СтрокаПараметров = ","+ "Параметры." + ИмяПараметра + СтрокаПараметров;
		ИначеЕсли СтрокаПараметров <> "" Тогда
			СтрокаПараметров = ","+СтрокаПараметров;
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;
	Если Лев(СтрокаПараметров,1) = "," Тогда
		СтрокаПараметров = Прав(СтрокаПараметров, СтрДлина(СтрокаПараметров)-1);
	КонецЕсли;
	
	Если ИнтеграционнаяОбработка <> Неопределено Тогда
		Попытка
			
			Если ИмяФункции = "ДобавитьНоменклатуруВЯчейкуСправочно" Тогда
				Результат = ГлЯдро_ДобавитьНоменклатуруВЯчейкуСправочно(Параметр1, Параметр2, Параметр3, Параметр4, АдресаПеременных);
			ИначеЕсли ИмяФункции = "УдалитьНоменклатуруИзЯчейкиСправочно" Тогда
				Результат = ГлЯдро_УдалитьНоменклатуруИзЯчейкиСправочно(Параметр1, Параметр2, Параметр3, Параметр4, АдресаПеременных);
			Иначе
				СтрокаВызова = "Параметры.ИнтеграционнаяОбработка." + ИмяФункции + "(" + СтрокаПараметров + ")";
				СтруктураПараметров.Вставить("ИнтеграционнаяОбработка", ИнтеграционнаяОбработка);
				Результат = ГлЯдро_ВычислитьВБезопасномРежиме(СтрокаВызова, СтруктураПараметров);
			КонецЕсли;
			
			Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
				Результат = REST_API_ТаблицаЗначенийВМассивСтруктур(Результат);
			КонецЕсли;
			
			ЕстьСостав = Ложь;
			Если ЗначениеЗаполнено(ТипВозвращаемогоЗначения) Тогда
				Если ГлЯдро_СтрНайти(ТипВозвращаемогоЗначения,"Collection") > 0 Тогда
					ЕстьСостав = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипВозвращаемогоЗначения <> "" И НРег(ТипВозвращаемогоЗначения) <> "string" Тогда
				Результат = ГлЯдро_ПолучитьJSON(Результат, ТипВозвращаемогоЗначения, ЕстьСостав);
			КонецЕсли;
		Исключение
			
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Ошибка при вызове функции: %1';
								|en = 'Error when calling the function: %1'; be = 'Памылка пры выкліку функцыі: %1'; es = 'Error al llamar a la función: %1'; ka = 'შეცდომა ფუნქციის გამოძახებისას: %1'; kk = 'Функцияны шақыру кезінде қате: %1'; ro = 'Eroare la apelarea funcției: %1'; tr = 'İşlev çağrılırken hata oluştu: %1'; uk = 'Помилка виклику функції: %1'; uz = 'Funktsiyani chaqirishda xato: %1'";
			прИмяФункции = Строка(ИмяФункции);
			ТекстОшибки = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прИмяФункции);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ИмяФункции",
				прИмяФункции);
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
			Результат = "#" + ТекстОшибки;
		КонецПопытки;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Выполнение вызова произвольной функции: %1';
						|en = 'End, Making a call to an arbitrary function: %1'; be = 'Канец, Выкананне выкліку адвольнай функцыі: %1'; es = 'Fin, Ejecución de una llamada a una función arbitraria: %1'; ka = 'ბოლოს, მიღების ზარი თვითნებური ფუნქცია: %1'; kk = 'Соңы, ерікті функцияға қоңырау шалу: %1'; ro = 'Sfârșit, efectuarea unui apel către o funcție arbitrară: %1'; tr = 'Son, Keyfi işlev çağrısının yürütülmesi: %1'; uk = 'Кінець, виконання виклику довільної функції: %1'; uz = 'Tugatish, ixtiyoriy funktsiyani chaqirish: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИмяФункции));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

