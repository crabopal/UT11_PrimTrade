#Область ГлобальныйКонтекст_Настройки_Инициализация

Процедура ГлЯдро_Инициализация(пИмяСобытия = "ГлЯдро_Инициализация", ПолнаяИнициализация = Ложь, mXmlDoc = Неопределено, АдресаПеременных = Неопределено)
	
	ИмяСобытия = "ГлЯдро_Инициализация";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяСобытия,ПолнаяИнициализация,mXmlDoc",
		ИмяСобытия, ПолнаяИнициализация, mXmlDoc);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'Начало инициализации';
						|en = 'Start of initialization'; be = 'Пачатак ініцыялізацыі'; es = 'Inicio de la inicialización'; ka = 'ინიციალიზაციის დაწყება'; kk = 'Инициализацияның басталуы'; ro = 'Începutul inițializării'; tr = 'Başlatmanın başlangıcı'; uk = 'Початок ініціалізації'; uz = 'Ishga tushirishni boshlash'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	Если АдресаПеременных = Неопределено Тогда	
		АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
	КонецЕсли;
	
	ЭтоВнешнееСоединение = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;	
	#КонецЕсли
	
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса",ТипИнтерфейса,АдресаПеременных);
	
	ИспJSON_mXmlDoc = Истина;
		
	Если ТипЗнч(mXmlDoc)=Тип("Строка") И Лев(mXmlDoc,5)="<?xml" ИЛИ ТипИнтерфейса <> "REST_API" Тогда
		ИспJSON_mXmlDoc = Ложь;
	КонецЕсли;
		
	SessionSMARTS = Неопределено;
	
	Ошибка_mXmlDoc = Ложь;
	Если mXmlDoc <> Неопределено И mXmlDoc <> "AutoSerialization" Тогда
		Попытка
			SessionSMARTS = ГлЯдро_ЗагрузитьИзJSON(mXmlDoc);
		Исключение
			ИспJSON_mXmlDoc = Ложь;
			Если ТипИнтерфейса = "REST_API" Тогда
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Не удалось распознать JSON во входящем параметре mXmlDoc. Возможно в настройках базы Клеверенс установлен режим XML';
									|en = 'Failed to recognize JSON in the incoming mXmlDoc parameter. It is possible that the XML mode is set in the settings of the Cleverence database';
									|be = 'Не ўдалося распазнаць JSON ва ўваходным параметры mXmlDoc. Магчыма ў наладах базы Cleverence усталяваны рэжым XML'; es = 'No se pudo reconocer JSON en el parámetro mxmldoc entrante. Tal vez en la configuración de la base de Cleverence se establece el modo XML'; ka = 'ვერ ცნობს JSON შემომავალი mXmlDoc პარამეტრი. შესაძლებელია, რომ XML რეჟიმი დაყენებულია Cleverence მონაცემთა ბაზის პარამეტრებში'; kk = 'Кіріс mxmldoc параметрінде JSON тану мүмкін болмады. Cleverence базасының параметрлерінде XML режимі орнатылған болуы мүмкін'; ro = 'Nu a reușit să recunoască JSON în parametrul mxmldoc de intrare. Este posibil ca modul XML să fie setat în setările bazei de date Cleverence'; tr = 'Gelen mXmlDoc parametresindeki JSON tanınamadı. Belki de Cleverence tabanının ayarlarında XML modu ayarlanmıştır'; uk = 'Не вдалося розпізнати JSON у вхідному параметрі mXmlDoc. Можливо в Налаштуваннях бази Cleverence встановлений режим XML'; uz = 'Kiruvchi mxmldoc parametrida JSONNI tanib bo''lmadi. Ehtimol, XML rejimi Cleverence bazasi sozlamalarida o''rnatilgan'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
				
				Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
					Ошибка_mXmlDoc = Истина;
					
					ОписаниеОшибкиONLEX = Новый Структура();
					ОписаниеОшибкиONLEX.Вставить("КодОшибкиONLEX", "ONLEX004");
					
					КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", ОписаниеОшибкиONLEX, АдресаПеременных);
				КонецЕсли;	
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	
	Если ПараметрыПодключенияMS <> Неопределено Тогда
		КомЯдро_СохранитьЗначениеПеременной("ID_ТекущейБазы", ПараметрыПодключенияMS.Ид, АдресаПеременных);
	КонецЕсли;
	
	ПодключенныеБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПодключенныеБазыMS");
	Если ПодключенныеБазыMS <> Неопределено Тогда
		КомЯдро_СохранитьЗначениеПеременной("ПодключенныеБазыMS", ПодключенныеБазыMS, АдресаПеременных);
	КонецЕсли;
	
	Если ПолнаяИнициализация Тогда
		ПараметрыПодключенияMS = ГлЯдро_АктуализацияСтруктурыПараметровПодключенияSMARTS(ПараметрыПодключенияMS);		
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда 
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	 	КомЯдро_СохранитьЗначениеПеременной(КлючПеременной,ПараметрыПодключенияMS,АдресаПеременных);
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ИспJSON_mXmlDoc",ИспJSON_mXmlDoc,АдресаПеременных);
	КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS",ПараметрыПодключенияMS,АдресаПеременных);
	
	Если ПолнаяИнициализация Тогда
		КомЯдро_УдалитьПеременныеCOM(АдресаПеременных);
	КонецЕсли;
	
	Если НЕ ГлЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,, АдресаПеременных) = Истина Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось подключиться к базе Клеверенс';
							|en = 'Couldn''t connect to the Cleverence database'; be = 'Не атрымалася падлучыцца да базы Cleverence'; es = 'No se pudo conectar a la base de Cleverence'; ka = 'ვერ დაუკავშირდა Cleverence მონაცემთა ბაზას'; kk = 'Cleverence базасына қосылу мүмкін болмады'; ro = 'Nu s-a putut conecta la baza de date Cleverence'; tr = 'Cleverence veritabanına bağlanılamadı'; uk = 'Не вдалося підключитися до бази Cleverence'; uz = 'Cleverence bazasiga ulanib bo''lmadi'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
		
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;	
	КонецЕсли;
	
	ИспользоватьКэш = ЭтоWebСервис или ЭтоВнешнееСоединение;
	
	Если ИспользоватьКэш Тогда	
		ГлЯдро_ПодключитьИнтеграционнуюОбработкуРасширения(АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Подключаем интеграционную обработку. Начало.';
						|en = 'Enabling integration processing. Beginning.'; be = 'Падключаем інтэграцыйную апрацоўку. Пачатак.'; es = 'Conectamos el procesamiento de integración. Comienzo.'; ka = 'ინტეგრაციის დამუშავების შესაძლებლობა. დასაწყისი.'; kk = 'Интеграциялық өңдеуді қосыңыз. Басталуы.'; ro = 'Activarea procesării integrării. Început.'; tr = 'Entegrasyon işlemeyi bağlıyoruz. Başlangıç.'; uk = 'Підключаємо інтеграційну обробку. Почавши.'; uz = 'Biz integratsiyani qayta ishlashni ulaymiz. Boshlanish.'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	ИнтеграционнаяОбработка = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если ИнтеграционнаяОбработка = Неопределено Тогда
		РезультатПодключенияВО = ГлЯдро_ПодключитьИнтеграционнуюОбработку(,,,,АдресаПеременных);
		Если НЕ (ЭтоАдресВременногоХранилища(РезультатПодключенияВО) 
			ИЛИ РезультатПодключенияВО = "Интеграционная обработка не соответствует конфигурации или версии 1С") Тогда		
				КомЯдро_СохранитьЗначениеПеременной("НастройкиИнициализированы",Ложь,АдресаПеременных);
				Если ТипЗнч(РезультатПодключенияВО) = Тип("Строка") И НЕ ПустаяСтрока(РезультатПодключенияВО) Тогда
					
					// <Лог>
					ЛогОшибка(логСобытие, РезультатПодключенияВО,,,,, АдресаПеременных);
					// </Лог>
					
					Если ЭтоВнешнееСоединение ИЛИ ЭтоWebСервис Тогда
						ОписаниеОшибкиONLEX = Новый Структура;
						ОписаниеОшибкиONLEX.Вставить("КодОшибкиONLEX", "ONLEX002");
						ОписаниеОшибкиONLEX.Вставить("СтруктураПараметровONLEX",
							Новый Структура("ОшибкаПодключенияИО", РезультатПодключенияВО));
							
						КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", ОписаниеОшибкиONLEX, АдресаПеременных);
					КонецЕсли;
				КонецЕсли;
				
				// <Лог>
				ЯзСтрока = "ru = 'Ошибка инициализации, не удалось подключить интеграционную обработку';
									|en = 'Initialization error, integration processing could not be enabled';
									|be = 'Памылка ініцыялізацыі, не ўдалося падключыць інтэграцыйную апрацоўку'; es = 'Error de inicialización, no se pudo conectar el procesamiento de integración'; ka = 'ინიციალიზაციის შეცდომა, ინტეგრაციის დამუშავება ვერ მოხერხდა'; kk = 'Инициализация қатесі, интеграциялық өңдеуді қосу мүмкін болмады'; ro = 'Eroare de inițializare, procesarea integrării nu a putut fi activată'; tr = 'Başlatma hatası, entegrasyon işlemi bağlanamadı'; uk = 'Помилка ініціалізації, не вдалося підключити інтеграційну обробку'; uz = 'Initsializatsiya xatosi, integratsiyani qayta ishlashni ulab bo''lmadi'";
				пСообщение = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
				
				ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
				// </Лог>
				
				Возврат;
		КонецЕсли;
		КомЯдро_СохранитьЗначениеПеременной("ИнтеграционнаяОбработкаПодключена",Истина,АдресаПеременных);
	Иначе
		Если ТипЗнч(АдресаПеременных) = Тип("Структура")
			И АдресаПеременных.Свойство("ИнтеграционнаяОбработка") Тогда
			РезультатПодключенияВО = АдресаПеременных.ИнтеграционнаяОбработка;
		КонецЕсли;
		// Для актуализации значений в кэше сессии
		КомЯдро_СохранитьЗначениеПеременной("ИнтеграционнаяОбработка", 			 ИнтеграционнаяОбработка, АдресаПеременных);
		КомЯдро_СохранитьЗначениеПеременной("ИнтеграционнаяОбработкаПодключена", Истина, 				  АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Интеграционная обработка: %1 РезультатПодключенияВО: %2';
						|en = 'Integration processing: %1connection result: %2';
						|be = 'Інтэграцыйная апрацоўка: %1 РезультатПодключенияВО: %2'; es = 'Procesamiento de integración: %1 Resultadoconexión: %2'; ka = 'ინტეგრაციის დამუშავება: %1connection შედეგი: %2'; kk = 'Интеграциялық өңдеу: %1 қосылым Нәтижесібо: %2'; ro = 'Procesare integrare: %1rezultatul conexiunii: %2'; tr = 'Entegrasyon işleme: %1 Bağlantıların sonucu: %2'; uk = 'Інтеграційна обробка: % 1 Результатпідключенняво: %2'; uz = 'Integratsiyani qayta ishlash: %1 Natijasio''chirish: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ИнтеграционнаяОбработка), Строка(РезультатПодключенияВО));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	Если ИспользоватьКэш Тогда
		Если ПолнаяИнициализация Тогда
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиКэша", ТекущаяДата());
			ГлЯдро_ПолучитьДанныеДляИнициализации(,АдресаПеременных);
			пСообщение = НСтр("ru = 'Полная инициализация и сохранение настроек в кеш для онлайна';
								|en = 'Full initialization and saving of settings to the online cache';
								|be = 'Поўная ініцыялізацыя і захаванне налад у кэш для анлайну'; es = 'Inicialización completa y almacenamiento en caché de la configuración en línea'; ka = 'პარამეტრების სრული ინიციალიზაცია და შენახვა ონლაინ ქეშში'; kk = 'Параметрлерді толығымен инициализациялау және желідегі кэшке сақтау'; ro = 'Inițializarea completă și salvarea setărilor în memoria cache online'; tr = 'Ayarların çevrimiçi olarak tam olarak başlatılması ve önbelleğe kaydedilmesi'; uk = 'Повна ініціалізація і збереження налаштувань в кеш для онлайну'; uz = 'Sozlamalarni to''liq ishga tushirish va onlayn Keshga saqlash'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		Иначе
			ГлЯдро_ПолучитьДанныеДляИнициализацииИзКэша(ИмяСобытия, АдресаПеременных);
			пСообщение = НСтр("ru = 'Получаем данные из кеша для онлайна';
								|en = 'Getting data from the cache for online'; be = 'Атрымліваем дадзеныя з кэша для анлайну'; es = 'Obtener datos de la caché en línea'; ka = 'მონაცემების მიღება ქეშიდან ინტერნეტით'; kk = 'Интернеттегі кэштен деректерді аламыз'; ro = 'Obținerea datelor din cache pentru online'; tr = 'Çevrimiçi için önbellekten veri alıyoruz'; uk = 'Отримуємо дані з кеша для онлайну'; uz = 'Biz onlayn uchun Keshdan ma''lumotlarni olamiz'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
			Если НЕ ГлЯдро_ПроверитьТекущиеНастройки(АдресаПеременных) Тогда
				ГлЯдро_ПолучитьДанныеДляИнициализации(,АдресаПеременных);		
			КонецЕсли;
		КонецЕсли;
	Иначе
		ГлЯдро_ПолучитьДанныеДляИнициализации(,АдресаПеременных);
	КонецЕсли;
	Если Ошибка_mXmlDoc Тогда
		КомЯдро_СохранитьЗначениеПеременной("НастройкиИнициализированы", Ложь, АдресаПеременных);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец инициализации';
						|en = 'End of initialization'; be = 'Канец ініцыялізацыі'; es = 'Fin de la inicialización'; ka = 'ინიციალიზაციის დასასრული'; kk = 'Инициализацияның аяқталуы'; ro = 'Sfârșitul inițializării'; tr = 'Başlatmanın sonu'; uk = 'Кінець ініціалізації'; uz = 'Ishga tushirishning oxiri'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Проверяет актуальность настроек, при необходимости переинициализирует,
// проверяет соединение с сервером SMARTS, устанавливает данные текущего узла.
//
// Параметры:
//  ИмяВнешнегоВызова      - Строка - имя точки входа для ЖР и ГлЯдро_Инициализация.
//  mXmlDoc                - Строка, Неопределено - данные сессии SMARTS.
//  ПараметрыИнициализации - Структура, Неопределено - опциональные флаги инициализации.
//                           При отсутствии ключа или Неопределено используется Истина:
//   * ПроверятьСоединение     - Булево - проверять подключение к серверу SMARTS.
//   * УстанавливатьДанныеУзла - Булево - вызывать ГлЯдро_УстановитьДанныеТекущегоУзла.
//   * СбрасыватьONLEX         - Булево - сбрасывать и проверять ошибки ONLEX.
//                               Финальная проверка после УстановитьДанныеТекущегоУзла
//                               выполняется только для ИмяВнешнегоВызова = "ПолучитьДокумент"
//                               (см. PRODUCTS-16337).
//  АдресаПеременных       - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//
// Возвращаемое значение:
//  Структура:
//   * Успех              - Булево - Истина если инициализация завершена без ошибок.
//   * ТекстОшибки        - Строка - текст ошибки без префикса "#". Пустая строка при успехе.
//   * ОшибкаСоединения   - Булево - Истина если именно соединение с SMARTS не удалось.
//   * ТипИнтерфейса      - Строка - результат ГлЯдро_ПолучитьДанныеИзХранилища1С.
//   * Переинициализация  - Булево - Истина если настройки были переинициализированы.
//
Функция ГлЯдро_ИнициализацияВнешнегоВызова(ИмяВнешнегоВызова, mXmlDoc = Неопределено, ПараметрыИнициализации = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ИнициализацияВнешнегоВызова";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяВнешнегоВызова,mXmlDoc,ПараметрыИнициализации",
		ИмяВнешнегоВызова, mXmlDoc, ПараметрыИнициализации);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Новый Структура(
		"Успех, ТекстОшибки, ОшибкаСоединения, ТипИнтерфейса, Переинициализация",
		Истина, "", Ложь, "", Ложь);
		
	Результат.ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	
	ПроверятьСоединение 	= Истина;
	УстанавливатьДанныеУзла = Истина;
	СбрасыватьONLEX 		= Истина;
	
	Если ТипЗнч(ПараметрыИнициализации) = Тип("Структура") Тогда
		
		Если ПараметрыИнициализации.Свойство("ПроверятьСоединение") Тогда
			ПроверятьСоединение = ПараметрыИнициализации.ПроверятьСоединение;
		КонецЕсли;
		
		Если ПараметрыИнициализации.Свойство("УстанавливатьДанныеУзла") Тогда
			УстанавливатьДанныеУзла = ПараметрыИнициализации.УстанавливатьДанныеУзла;
		КонецЕсли;
		
		Если ПараметрыИнициализации.Свойство("СбрасыватьONLEX") Тогда
			СбрасыватьONLEX = ПараметрыИнициализации.СбрасыватьONLEX;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СбрасыватьONLEX Тогда
		КомЯдро_СохранитьЗначениеПеременной("Cleverence_ОписаниеОшибкиONLEX", Неопределено, АдресаПеременных);
	КонецЕсли;
	
	НастройкиИнициализированы = КомЯдро_ПолучитьЗначениеПеременной("НастройкиИнициализированы", АдресаПеременных);
	НастройкиИзменились = ГлЯдро_НастройкиИзменились(АдресаПеременных);
	
	Если НастройкиИзменились
		ИЛИ НЕ НастройкиИнициализированы = Истина Тогда
		
		Результат.Переинициализация = Истина;
		
		пСообщение = НСтр("ru = 'Переинициализация настроек. НастройкиИнициализированы = %1, НастройкиИзменились = %2';
							|en = 'Reinitialization of settings. Settings Initialized = %1, Settings Changed = %2';
							|be = 'Переинициализация налад. Настройкіініцыялізаваныя = %1, Наладызмяніліся = %2'; es = 'Re-inicialización de la configuración. Configuración Inicializada = %1, Configuración Cambiada = %2'; ka = 'პარამეტრების რეინიტიალიზაცია. პარამეტრები ინიციალიზებულია = %1, პარამეტრები შეიცვალა = % 2'; kk = 'Параметрлерді қайта инициализациялау. Параметрлер Инициализацияланған = %1, Параметрлер Өзгертілген = %2'; ro = 'Reinițializarea setărilor. Setări Inițializate = %1, Setări Modificate = %2'; tr = 'Ayarların yeniden başlatılması. Ayarlar başlatıldı = %1, ayarlar değiştirildi = %2'; uk = 'Переініціалізація налаштувань. Налаштуванняініціалізовані = %1, Налаштуваннязмінилися = %2'; uz = 'Sozlamalarni qayta boshlash. Sozlamalar Boshlang''ich = %1, Sozlamalar O''zgartirilgan = %2'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(НастройкиИнициализированы), Строка(НастройкиИзменились));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяВнешнегоВызова, "Предупреждение", пСообщение,, АдресаПеременных);
		
		ГлЯдро_Инициализация(ИмяВнешнегоВызова, НастройкиИзменились, mXmlDoc, АдресаПеременных);
		
		Если СбрасыватьONLEX Тогда
			
			ТекстОшибки = ГлЯдро_ПроверитьНаличиеИсключительнойСитуацииONLEX(АдресаПеременных);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				
				// <Лог>
				ЯзСтрока = "ru = 'Ошибка инициализации: %1'";
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ТекстОшибки",
					ТекстОшибки);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
				// </Лог>
				
				Результат.Успех = Ложь;
				Результат.ТекстОшибки = ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Успех И ПроверятьСоединение Тогда
		
		Если НЕ ГлЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,, АдресаПеременных) = Истина Тогда
			
			// <Лог>
			ЯзСтрока = "ru = 'Подключиться к серверу Клеверенс не удалось';
								|en = 'Failed to connect to the Cleverence server'; be = 'Падлучыцца да сервера Cleverence не ўдалося'; es = 'No se pudo conectar al servidor Cleverence'; ka = 'ვერ მოხერხდა Cleverence სერვერთან დაკავშირება'; kk = 'Cleverence серверіне қосылу мүмкін болмады'; ro = 'Nu s-a reușit conectarea la serverul Cleverence'; tr = 'Cleverence sunucusuna bağlanılamadı'; uk = 'Не вдалося підключитися до сервера Cleverence'; uz = 'Cleverence serveriga ulanib bo''lmadi'";
			пСообщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока,,,, АдресаПеременных);
			// </Лог>
			
			ТекстОшибки = "";
			Если СбрасыватьONLEX Тогда
				
				ТекстОшибки = ГлЯдро_ПроверитьНаличиеИсключительнойСитуацииONLEX(АдресаПеременных);
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					
					// <Лог>
					ЯзСтрока = "ru = 'Ошибка подключения к серверу Клеверенс: %1'";
					пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"ТекстОшибки",
						ТекстОшибки);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
					// </Лог>
					
				КонецЕсли;
				
			КонецЕсли;
			
			Результат.Успех 			= Ложь;
			Результат.ОшибкаСоединения 	= Истина;
			Результат.ТекстОшибки 		= ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Успех И УстанавливатьДанныеУзла Тогда
		
		ГлЯдро_УстановитьДанныеТекущегоУзла(mXmlDoc,,, Результат.ТипИнтерфейса, АдресаПеременных);
		
		// Согласно PRODUCTS-16337: проверка объекта сессии (ONLEX006) после установки
		// данных текущего узла оставлена только для ПолучитьДокумент. В остальных
		// онлайн-вызовах mXmlDoc может приходить без DeviceInfo (например, второй
		// вызов ПолучитьТовар при сканировании), и возврат ошибки ломает сценарий.
		Если СбрасыватьONLEX И ИмяВнешнегоВызова = "ПолучитьДокумент" Тогда
			
			ТекстОшибки = ГлЯдро_ПроверитьНаличиеИсключительнойСитуацииONLEX(АдресаПеременных);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				
				// <Лог>
				ЯзСтрока = "ru = 'Ошибка установки текущего узла: %1'";
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ТекстОшибки",
					ТекстОшибки);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
				// </Лог>
				
				Результат.Успех = Ложь;
				Результат.ТекстОшибки = ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру настроек подключаемой базы Клеверенс
//
// Параметры:
// 	ЗаполнятьДанные - Булево
// 	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
// 	Структура - содержит:
// 		* ДанныеТекущегоУзла - Структура - содержит:
// 			** ID_Узла - Строка
// 			** Наименование - Строка
//          ** ЧастнаяБазаMS - Строка
//      * КатегорииНастроекMS - Структура - см. ГлЯдро_ПолучитьКатегорииНастроекMS
// 	    * ТекущиеНастройкиMS - Структура - см. ГлЯдро_ПолучитьПустуюСтруктуруНастроекSMARTS
//      * СтруктураМетаданных - Структура - содержит:
//      	** Документы1С - Структура - см. ГлЯдро_ПолучитьМетаданныеДокументов1С
//          ** НастройкиMS - Структура - см. ГлЯдро_СформироватьМетаданныеНастроекMS
//          ** ДокументыMS - Структура - см. КомЯдро_ПолучитьМетаданныеДокументовMS или REST_API_ПолучитьМетаданныеДокументовMS (в зависимости от типа интерфейса)
// 		   	** ПользователиMS - см. КомЯдро_ПолучитьМетаданныеДокументовMS или REST_API_ПолучитьМетаданныеДокументовMS (в зависимости от типа интерфейса)
//          ** УстройстваMS - см. КомЯдро_ПолучитьМетаданныеДокументовMS или REST_API_ПолучитьМетаданныеДокументовMS (в зависимости от типа интерфейса)
//          ** Tables - см. КомЯдро_ПолучитьМетаданныеДокументовMS или REST_API_ПолучитьМетаданныеДокументовMS (в зависимости от типа интерфейса)
//          ** UniПолейНоменклатуры - см. КомЯдро_ПолучитьМетаданныеДокументовMS или REST_API_ПолучитьМетаданныеДокументовMS (в зависимости от типа интерфейса)
//      * ПраваПользователя - Структура - содержит:
// 			** РольПользователя - Строка
Функция ГлЯдро_ПолучитьДанныеДляИнициализации(ЗаполнятьДанные = Истина, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьДанныеДляИнициализации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЗаполнятьДанные",
		ЗаполнятьДанные);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ДанныеДляИнициализации = Новый Структура;
	
	КатегорииНастроек = ГлЯдро_ПолучитьКатегорииНастроекMS();
	СтруктураНастроек = ГлЯдро_ПолучитьПустуюСтруктуруНастроекSMARTS(КатегорииНастроек.СериализуемыеНастройки);
	
	Если ЗаполнятьДанные Тогда
		КомЯдро_СохранитьЗначениеПеременной("КатегорииНастроекMS", КатегорииНастроек, АдресаПеременных);
	КонецЕсли;
	
	СтруктураМетаданных = Новый Структура;
	СтруктураМетаданных.Вставить("Документы1С", ГлЯдро_ОбновитьМетаданныеДокументов1С());
	СтруктураМетаданных.Вставить("НастройкиMS", ГлЯдро_СформироватьМетаданныеНастроекMS());
	ЭтоВнешнееСоединение = Ложь;
	#Если ВнешнееСоединение Тогда
		ЭтоВнешнееСоединение = Истина;
	#КонецЕсли
	ИспользоватьКэш = ЭтоWebСервис ИЛИ ЭтоВнешнееСоединение;
	Если ИспользоватьКэш Тогда
		ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_СтруктураМетаданныхДокументы1С", СтруктураМетаданных.Документы1С);
	КонецЕсли;
	
	ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	
	Если ЗаполнятьДанные Тогда
		
		ГлЯдро_ПроверитьАктуальностьКэшируемыхНастроекПриИнициализации(, АдресаПеременных);
		
		ГлЯдро_ПроверитьАктуальностьСтруктурыАтрибутов(КатегорииНастроек, АдресаПеременных);
		
		// Данные настройки будут получены дальше через ГлЯдро_ПолучитьНастройкиОтборовСправочников
		// 	т.к настройки являются узловыми, но только для частных баз
		СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Интерактивный");
		СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Автообмен");
		
		// Настройки для онлайна узловые для всех ТО
		// Если это внешнее соединение, то можно получить только онлайн настройки обычным способом
		Если НЕ ИспользоватьКэш Тогда
			СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Онлайн");
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Начало';
							|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьНастройкиНаСервереSMARTS", "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроек,,, АдресаПеременных);
		пСообщение = НСтр("ru = 'Конец';
							|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьНастройкиНаСервереSMARTS", "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		ДанныеТекущегоУзла = Новый Структура;
		ДанныеТекущегоУзла.Вставить("ID_Узла", 			"");
		ДанныеТекущегоУзла.Вставить("Наименование", 	"");
		ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS", 	"");
		
		// Текущий узел
		ID_ТекущегоУзла = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущегоУзла_" + ПараметрыПодключенияMS.Ид);
		Если НЕ ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
			ID_ТекущегоУзла = "";
		КонецЕсли;
		
		// Структуру настроек получаем для всех узлов
		Если ИспользоватьКэш Тогда
			КомЯдро_СохранитьЗначениеПеременной("ТекущиеНастройкиMS_ГлавныйУзел", ГлЯдро_СобратьСтруктуруНастроекИзКэша("", АдресаПеременных), АдресаПеременных);
			
			Если ТипЗнч(СтруктураНастроек.Узлы) = Тип("Массив") Тогда
				Для Каждого пУзел Из СтруктураНастроек.Узлы Цикл
					Если пУзел.Свойство("ID_Узла") Тогда
						КомЯдро_СохранитьЗначениеПеременной("ТекущиеНастройкиMS_" + пУзел.ID_Узла, ГлЯдро_СобратьСтруктуруНастроекИзКэша(пУзел.ID_Узла, АдресаПеременных), АдресаПеременных);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеУзла = Неопределено;
		Если ID_ТекущегоУзла <> "" И (ТипЗнч(СтруктураНастроек.Узлы) = Тип("Массив")) Тогда
			Для Каждого пУзел Из СтруктураНастроек.Узлы Цикл
				Если пУзел.Свойство("ID_Узла") И пУзел.ID_Узла = ID_ТекущегоУзла Тогда
					ДанныеУзла = пУзел;
				КонецЕсли;
			КонецЦикла;
			Если ДанныеУзла <> Неопределено Тогда
				ДанныеТекущегоУзла.Вставить("ID_Узла", ID_ТекущегоУзла);
				ДанныеТекущегоУзла.Вставить("Наименование", ДанныеУзла.Наименование);
				Если ДанныеУзла.ИспользоватьЧастнуюБазу Тогда
					ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS", ДанныеУзла.ЧастнаяБазаMS);
				КонецЕсли;
				
				Если ИспользоватьКэш Тогда
					СтруктураНастроек = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS_" + ID_ТекущегоУзла, АдресаПеременных);
				Иначе
					пСообщение = НСтр("ru = 'Начало';
										|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьНастройкиНаСервереSMARTS", "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
					СтруктураНастроек = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, КатегорииНастроек, ID_ТекущегоУзла,, АдресаПеременных);
					пСообщение = НСтр("ru = 'Конец';
										|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьНастройкиНаСервереSMARTS", "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Если это НЕ внешнее соединение, то необходимо заполнить настройки отборов для всех режимов
		Если НЕ ИспользоватьКэш Тогда
			НастройкиОтборовСправочников = ГлЯдро_ПолучитьНастройкиОтборовСправочников(ID_ТекущегоУзла,, АдресаПеременных);
			Для Каждого КлючЗначение Из НастройкиОтборовСправочников Цикл
				СтруктураНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		
		ДанныеДляИнициализации.Вставить("ДанныеТекущегоУзла", ДанныеТекущегоУзла);
		
		// Если метаданные будут актуализированы из базы MS, необходимо выполнить проверку применимости бизнес-процессов
		КомЯдро_СохранитьЗначениеПеременной("ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS", Истина, АдресаПеременных);
		
		пСтруктураМетаданных = ГлЯдро_ОбновитьМетаданныеДокументовMS(, АдресаПеременных);
		
		СтруктураМетаданных.Вставить("ДокументыMS", 							?(пСтруктураМетаданных = Неопределено, Новый Структура(), пСтруктураМетаданных.ДокументыMS));
		СтруктураМетаданных.Вставить("ПользователиMS", 							?(пСтруктураМетаданных = Неопределено, "", пСтруктураМетаданных.ПользователиMS));
		СтруктураМетаданных.Вставить("УстройстваMS", 							?(пСтруктураМетаданных = Неопределено, "", пСтруктураМетаданных.УстройстваMS));
		СтруктураМетаданных.Вставить("Tables", 									?(пСтруктураМетаданных = Неопределено, Новый СписокЗначений(), пСтруктураМетаданных.Tables));
		СтруктураМетаданных.Вставить("UniПолейНоменклатуры", 					?(пСтруктураМетаданных = Неопределено, Новый Соответствие(), пСтруктураМетаданных.UniПолейНоменклатуры));
		СтруктураМетаданных.Вставить("ВыгружаемыеПоляНоменклатурыMS", 			?(пСтруктураМетаданных = Неопределено, Новый Структура, пСтруктураМетаданных.ВыгружаемыеПоляНоменклатурыMS));
		СтруктураМетаданных.Вставить("ВыгружаемыеПоляЯчеекMS", 					?(пСтруктураМетаданных = Неопределено, Новый Структура, пСтруктураМетаданных.ВыгружаемыеПоляЯчеекMS));
		СтруктураМетаданных.Вставить("ПлатформаПоддерживаетSupportUntilDate", 	?(пСтруктураМетаданных = Неопределено, Ложь, пСтруктураМетаданных.ПлатформаПоддерживаетSupportUntilDate));
		СтруктураМетаданных.Вставить("ЯзыкПлатформыMS", 						?(пСтруктураМетаданных = Неопределено, "", пСтруктураМетаданных.ЯзыкПлатформыMS));
		
		ГлЯдро_ПроверитьЛицензииУстройств(СтруктураМетаданных, АдресаПеременных);
		
		Если ИспользоватьКэш Тогда
			// ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_СтруктураМетаданныхДокументыMS", СтруктураМетаданных.ДокументыMS);
			// ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ПользователиMS", СтруктураМетаданных.ПользователиMS);
			// ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_УстройстваMS", СтруктураМетаданных.УстройстваMS);
			// ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ТаблицыMS", СтруктураМетаданных.Tables);
		КонецЕсли;
		
		ДанныеДляИнициализации.Вставить("КатегорииНастроекMS", КатегорииНастроек);
		ДанныеДляИнициализации.Вставить("ТекущиеНастройкиMS", СтруктураНастроек);
		
		ПодключенныеБазыMS = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ПодключенныеБазыMS");
		ДанныеДляИнициализации.Вставить("ПодключенныеБазыMS", ПодключенныеБазыMS);
		
	КонецЕсли;
	
	ДанныеДляИнициализации.Вставить("СтруктураМетаданных", СтруктураМетаданных);
	
	// Заготовка для своей системы разграничения прав
