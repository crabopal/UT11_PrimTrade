		ПризнакиНоменклатуры.Вставить("АртикулТовара", 			НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляProduct + ".Marking"));
		ПризнакиНоменклатуры.Вставить("НаименованиеУпаковки", 	НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляPacking + ".Name"));
		ПризнакиНоменклатуры.Вставить("ШтрихкодТовара", 		НоменклатураДляВыгрузки.МассивИмен.Найти(ИмяПоляPacking + ".Barcode"));
