				прСсылка = Строка(ДокументОснование.Ссылка);
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прСсылка);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ТекстОшибки,Ссылка",
					ТекстОшибки, прСсылка);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;
			
		КонецЕсли;
				
		// конец записи документа онлайн
		//////////////////////////////////
		
	КонецЕсли;			
	
	// Возможно в предыдущем условии был записан новый документ, 
	// обновим на всякий случай его ссылку в структуре результата
	РезультатЗаписи.Вставить("Ссылка", ДокументДляЗаписи.Ссылка);
	
	Если СтруктураДанных.Свойство("СообщениеОбОшибках") И СтруктураДанных.СообщениеОбОшибках <> "" Тогда
		Сообщение = НСтр("ru = 'Не удалось записать или провести документ ""%1"" в 1С, попробуйте загрузить документ вручную в 1С. Подробности об ошибке смотрите в ЖР базы 1С.';
							|en = 'It was not possible to record or save the ""%1"" document in 1C, try uploading the document manually to 1C. For more information about the error, see the LR database 1C.';
							|be = 'Не ўдалося запісаць або правесці Дакумент ""%1"" у 1С, паспрабуйце загрузіць дакумент ўручную ў 1С. падрабязнасці пра памылку глядзіце ў ЖР базы 1С.'; es = 'No se pudo escribir o mantener el documento ""%1 "" en 1C, intente cargar el documento manualmente en 1C. consulte la base de datos 1C para obtener Más información sobre el error.'; ka = 'შეუძლებელი იყო ""%1"" დოკუმენტის ჩაწერა ან შენახვა 1C-ში, სცადეთ დოკუმენტის ხელით ატვირთვა 1c-ზე. შეცდომის შესახებ დამატებითი ინფორმაციისთვის იხილეთ lr მონაცემთა ბაზა 1c.'; kk = '1С-да ""%1"" құжатын жазу немесе жүргізу мүмкін болмады, құжатты 1С-та қолмен жүктеп көріңіз.'; ro = 'Nu a fost posibil să scrieți sau să țineți documentul ""%1 "" în 1C, încercați să încărcați documentul manual în 1C. pentru mai multe informații despre eroare, consultați jurnalul bazei de date 1C.'; tr = '""% 1"" belgesini 1c''ye yazamadım veya tutamadım, belgeyi manuel olarak 1c''ye yüklemeyi deneyin. Hatayla ilgili ayrıntılar için 1c''nin veri tabanına bakın.'; uk = 'Не вдалося записати або провести документ ""%1 "" в 1С, спробуйте завантажити документ вручну в 1С. подробиці про помилку дивіться в ЖР бази 1С.'; uz = '""%1"" hujjatini 1C da yozish yoki ushlab turishning iloji bo''lmadi, hujjatni qo''lda 1C ga yuklashga harakat qiling. xato haqida qo''shimcha ma''lumot olish uchun 1C ma''lumotlar bazasi jurnaliga qarang.'");
		Сообщение = ГлЯдро_СтрШаблон(Сообщение, ДанныеДокументаMS.ШапкаДокумента.Имя)
			+ Символы.ПС
			+ НСтр("ru = 'ОШИБКИ';
					|en = 'mistakes'; be = 'ПАМЫЛКА'; es = 'ERRORES'; ka = 'შეცდომები'; kk = 'Қателер'; ro = 'greșeli'; tr = 'SAKATAT'; uk = 'ПОМИЛКА'; uz = 'Xatolar'")
			+ ":" + Символы.ПС + СтруктураДанных.СообщениеОбОшибках;
		РезультатЗаписи.Вставить("Сообщение", Сообщение);
	КонецЕсли;
	
	Если Не Онлайн Тогда
		
		РезультатЗаписи.Вставить("МетаданныеИмя",РезультатЗаписи.Данные.Метаданные().Имя);
		//РезультатЗаписи.Данные = ?(ДокументЗаписан = Истина,РезультатЗаписи.Данные.Ссылка,ПоместитьВоВременноеХранилище(Новый Структура("Объект",РезультатЗаписи.Данные),новый УникальныйИдентификатор()));
		
		Если ДокументЗаписан = Истина Тогда			
			РезультатЗаписи.Данные = РезультатЗаписи.Данные.Ссылка;			
		Иначе
			
			// сериализация в xml
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку("UTF8"); 
			ЗаписьXML.ЗаписатьОбъявлениеXML();
			ЗаписатьXML(ЗаписьXML, РезультатЗаписи.Данные, НазначениеТипаXML.Явное);
			
			РезультатЗаписи.Данные = ЗаписьXML.Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Онлайн И РезультатЗаписи.Статус = Истина Тогда
		РезультатЗаписи.Вставить("ДокументОснование", СтруктураДанных.ДокументОснование);
	КонецЕсли;
	
	// +++ Последовательность БП
	Если НастройкаБП.Свойство("НастройкаПоследовательностиБПМассивСтруктур")
		И ЗначениеЗаполнено(НастройкаБП.НастройкаПоследовательностиБПМассивСтруктур) Тогда
		
		ПрерыватьПриКритическойОшибке = Ложь;
		Если НастройкаБП.Свойство("ПрерыватьПоследовательностьПриКритическойОшибке") Тогда
			ПрерыватьПриКритическойОшибке = НастройкаБП.ПрерыватьПоследовательностьПриКритическойОшибке;
		КонецЕсли;
		
		ПрерватьПоследовательность = Ложь;
		Если ПрерыватьПриКритическойОшибке
			И РезультатЗаписи.Статус = Ложь Тогда
			ПрерватьПоследовательность = Истина;
		КонецЕсли;
		
		ПоследовательностьБП = ГлЯдро_МассивСтруктурВТаблицуЗначений(НастройкаБП.НастройкаПоследовательностиБПМассивСтруктур);
		Если ПоследовательностьБП.Количество() > 0 Тогда
			Если РезультатыВыполненияПоследовательныхБП = Неопределено Тогда
				РезультатыВыполненияПоследовательныхБП = Новый ТаблицаЗначений;
				РезультатыВыполненияПоследовательныхБП.Колонки.Добавить("ID_БизнесПроцесса");
				РезультатыВыполненияПоследовательныхБП.Колонки.Добавить("Результат");
				РезультатыВыполненияПоследовательныхБП.Колонки.Добавить("НастройкаБП");
				
				//первой записью сохраним результат корневого БП
				СтрокаРезультатов = РезультатыВыполненияПоследовательныхБП.Добавить();
				СтрокаРезультатов.ID_БизнесПроцесса = НастройкаБП.ID_БизнесПроцесса;
				СтрокаРезультатов.Результат = РезультатЗаписи;				
				СтрокаРезультатов.НастройкаБП = НастройкаБП;
			КонецЕсли;
			
			Для Каждого СледующийБП Из ПоследовательностьБП Цикл
				
				Если ПрерватьПоследовательность Тогда
					Прервать;
				КонецЕсли;
				
				Если СледующийБП.Использование = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
				Если СледующийБП.ИсточникДокументаОснования = "РезультирующийДокумент" Тогда
					ИсточникДокументаОснования = ДокументДляЗаписи.Ссылка;
				ИначеЕсли СледующийБП.ИсточникДокументаОснования = "ИсходныйДокумент" Тогда
					Если НастройкаБП.ЗагружатьВТотЖе
						Или ДокументОснование = Неопределено Тогда
						ИсточникДокументаОснования = ДокументДляЗаписи.Ссылка;
					Иначе
						ИсточникДокументаОснования = ДокументОснование;
					КонецЕсли;
				Иначе
					ИсточникДокументаОснования = Неопределено;	
				КонецЕсли;
				
				Если ДанныеНастроекИзКэша = Неопределено ИЛИ НЕ ДанныеНастроекИзКэша.Свойство("НастройкиДляОбмена") ИЛИ ДанныеНастроекИзКэша.НастройкиДляОбмена = Неопределено Тогда
					НастройкиДляОбмена = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",,АдресаПеременных)
				Иначе
					НастройкиДляОбмена = ДанныеНастроекИзКэша.НастройкиДляОбмена;
				КонецЕсли;				
				НастройкаСледующегоБП = ГлЯдро_ПолучитьНастройкуБизнесПроцесса(СледующийБП.ID_БизнесПроцесса, НастройкаБП.ТипДокументаMS,НастройкиДляОбмена,Истина,АдресаПеременных);
				Если НастройкаСледующегоБП.Статус = Ложь Тогда
					Продолжить;
				КонецЕсли;					
				
				// проверяем условие выполнения БП
				РезультатПроверкиУсловия = ГлЯдро_ПроверитьУсловиеВыполненияБизнесПроцесса(СледующийБП, РезультатыВыполненияПоследовательныхБП, АдресаПеременных);
				Если РезультатПроверкиУсловия.Статус = Истина Тогда
					
					Если РезультатПроверкиУсловия.Данные = Ложь Тогда
						//сохраним в результатах что БП пропущен					
						СтрокаРезультатов = РезультатыВыполненияПоследовательныхБП.Добавить();
						СтрокаРезультатов.ID_БизнесПроцесса = СледующийБП.ID_БизнесПроцесса;
						СтрокаРезультатов.Результат = "Пропущен по условию";
						СтрокаРезультатов.НастройкаБП = СледующийБП;
						Продолжить;
					КонецЕсли;
					
				Иначе
					
					// <Лог>
					ЯзСтрока = "ru = 'Не удалось выполнить произвольный код проверки условия выполнения бизнес процесса [%1]: %2';
													|en = 'An arbitrary verification code for the business process execution condition could not be executed [%1]: %2';
													|be = 'Не ўдалося выканаць адвольны код праверкі ўмовы выканання бізнес працэсу [%1]: %2'; es = 'No se pudo ejecutar ningún código arbitrario para verificar la condición de ejecución del proceso de negocio [%1]: %2'; ka = 'ბიზნეს პროცესის შესრულების პირობის თვითნებური გადამოწმების კოდი ვერ შესრულდა [%1]: %2'; kk = 'Бизнес-процестің орындалу шарттарын тексерудің ерікті кодын орындау мүмкін болмады [%1]: %2'; ro = 'Un cod de verificare arbitrar pentru condiția de execuție a procesului de afaceri nu a putut fi executat [%1]: %2'; tr = 'İş sürecinin yürütme koşulunu kontrol etmek için keyfi kod tamamlanamadı [%1]: %2'; uk = 'Не вдалося виконати довільний код перевірки умови виконання бізнес процесу [%1]: %2'; uz = 'Biznes-jarayonni bajarish sharti uchun o''zboshimchalik bilan tasdiqlash kodi bajarilmadi [%1]: %2'";
					СообщениеПользователю = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), СледующийБП.УсловиеВыполненияБизнесПроцессаПредставление, РезультатПроверкиУсловия.СообщениеПользователю);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"УсловиеВыполненияБизнесПроцессаПредставление,СообщениеПользователю",
						СледующийБП.УсловиеВыполненияБизнесПроцессаПредставление, РезультатПроверкиУсловия.СообщениеПользователю);
					ЛогОшибка(логСобытие, СообщениеПользователю, ЯзСтрока, логКонтекст,,, АдресаПеременных);
					// </Лог>
					Сообщить(СообщениеПользователю); 
					
					//сохраним в результатах что БП пропущен					
					СтрокаРезультатов = РезультатыВыполненияПоследовательныхБП.Добавить();
					СтрокаРезультатов.ID_БизнесПроцесса = СледующийБП.ID_БизнесПроцесса;
					СтрокаРезультатов.Результат = "Пропущен по ошибке условия";
					СтрокаРезультатов.НастройкаБП = СледующийБП;
					
					Если ПрерыватьПриКритическойОшибке Тогда
						Прервать;
					Иначе
						Продолжить; // пропуск выполнения БП
					КонецЕсли;
					
				КонецЕсли;
				
				РезультатВыполнения = ГлЯдро_СформироватьИЗаписатьДокументВБазу1С(
					ДанныеДокументаMS,
					НастройкаСледующегоБП.Данные,
					ДанныеНастроекИзКэша,
					,
					Онлайн, // mserg27, было Ложь
					ФильтрТЧПоИдДокумента,
					ИсточникДокументаОснования,
					РезультатыВыполненияПоследовательныхБП, 
					АдресаПеременных);												
								
				Если Не РезультатВыполнения = "Повтор" Тогда
					НС = РезультатыВыполненияПоследовательныхБП.Добавить();
					НС.ID_БизнесПроцесса = НастройкаБП.ID_БизнесПроцесса;
					НС.Результат = РезультатВыполнения;
					НС.НастройкаБП = СледующийБП;
				КонецЕсли;
				
				Если РезультатВыполнения.Статус = Ложь 
					И ПрерыватьПриКритическойОшибке Тогда
					ПрерватьПоследовательность = Истина;	
				КонецЕсли;
				
			КонецЦикла;			
		КонецЕсли;
	КонецЕсли;
	// ---
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗаписи);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатЗаписи;
	
КонецФункции

Функция ГлЯдро_ПроверитьУсловиеВыполненияБизнесПроцесса(ЭлементПоследовательностиБП, РезультатыВыполненияПоследовательныхБП, АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ПроверитьУсловиеВыполненияБизнесПроцесса";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЭлементПоследовательностиБП,РезультатыВыполненияПоследовательныхБП",
		ЭлементПоследовательностиБП, РезультатыВыполненияПоследовательныхБП);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Результат = Новый Структура("Статус, Данные, СообщениеПользователю", Истина, Истина, ""); // успешный
	
	// после обновления, поля таблицы не будет
	Попытка
		УсловиеВыполненияБизнесПроцессаКод = ЭлементПоследовательностиБП.УсловиеВыполненияБизнесПроцессаКод;
		УсловиеВыполненияБизнесПроцессаПредставление = ЭлементПоследовательностиБП.УсловиеВыполненияБизнесПроцессаПредставление;
	Исключение
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецПопытки;
	
	// если не заполнено, то выполнять всегда
	Если ПустаяСтрока(УсловиеВыполненияБизнесПроцессаКод) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	// поиск произвольного кода по коду
	Отбор = Новый Структура("ID_ПроизвольногоКода", УсловиеВыполненияБизнесПроцессаКод);
	ПроизвольныеКоды = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор,,, АдресаПеременных);
		
	Если ПроизвольныеКоды.Количество() > 0 Тогда
		
		ПроизвольныйКод = ПроизвольныеКоды[0]; 
		
		// структура переменных для выполнения кода
		СтруктураПеременных = Новый Структура;
		СтруктураПеременных.Вставить("ТаблицаВыполненияПоследовательныхБП", РезультатыВыполненияПоследовательныхБП);
		СтруктураПеременных.Вставить("ДокументТСД", РезультатыВыполненияПоследовательныхБП[0].Результат.ДанныеДокументаMS);
		
		СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		ИнтеграционнаяОбработка = Неопределено;
		СтруктураИО.Свойство("ИнтеграционнаяОбработка", ИнтеграционнаяОбработка);
		СтруктураПеременных.Вставить("МодульОбработки", ИнтеграционнаяОбработка);	
		
		СтруктураПеременных.Вставить("АдресаПеременных", 		АдресаПеременных);
		
		ТекущиеНастройкиMS = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS", АдресаПеременных);
		СтруктураПеременных.Вставить("ТекущиеНастройкиMS", ТекущиеНастройкиMS);
		
		Результат = ГлЯдро_ВыполнитьПроизвольныйКод(ПроизвольныйКод.ТекстПроизвольногоКода, СтруктураПеременных, ПроизвольныйКод.ID_ПроизвольногоКода, ПроизвольныйКод.Наименование, АдресаПеременных);
				
	Иначе
		Результат.Статус = Ложь;
		Результат.СообщениеПользователю = НСтр("ru = 'Произвольный код не найден';
												|en = 'Arbitrary code was not found'; be = 'Адвольны код не знойдзены'; es = 'Código arbitrario no encontrado'; ka = 'თვითნებური კოდი არ იქნა ნაპოვნი'; kk = 'Ерікті код табылмады'; ro = 'Codul arbitrar nu a fost găsit'; tr = 'Keyfi kod bulunamadı'; uk = 'Довільний код не знайдено'; uz = 'O''zboshimchalik bilan kod topilmadi'");
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ЗаполнитьДокумент1С(ДанныеДокументаMS, НастройкаБП, ДанныеНастроекИзКэша = Неопределено, ДокументДляЗаполнения = Неопределено, Онлайн = Ложь, ФильтрТЧПоИдДокумента = Неопределено, ДокументОснование = Неопределено ,АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ЗаполнитьДокумент1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеДокументаMS,НастройкаБП,ДанныеНастроекИзКэша,ДокументДляЗаполнения,Онлайн,ФильтрТЧПоИдДокумента,ДокументОснование",
		ДанныеДокументаMS, НастройкаБП, ДанныеНастроекИзКэша, ДокументДляЗаполнения, Онлайн, ФильтрТЧПоИдДокумента, ДокументОснование);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Заполнение документа 1С';
						|en = 'The beginning, Filling out the 1C document'; be = 'Пачатак, Запаўненне дакумента 1С'; es = 'Inicio, Cumplimentación del documento 1C'; ka = 'დასაწყისი, 1c დოკუმენტის შევსება'; kk = '1С құжаттың басталуы, толтырылуы'; ro = 'Începutul, completarea documentului 1C'; tr = 'Başlangıç, 1C belgesinin doldurulması'; uk = 'Початок, заповнення документа 1С'; uz = '1C hujjatni boshlash, to''ldirish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
		
	ПроизвольныеКодыДокумента = Неопределено;
	Если ДанныеНастроекИзКэша = Неопределено ИЛИ НЕ ДанныеНастроекИзКэша.Свойство("ПроизвольныеКодыДокумента") ИЛИ ДанныеНастроекИзКэша.ПроизвольныеКодыДокумента = Неопределено Тогда
		Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", "Документ");
		ПроизвольныеКодыДокумента = ГлЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор,,, АдресаПеременных);
	Иначе
		Если ТипЗнч(ДанныеНастроекИзКэша.ПроизвольныеКодыДокумента) = Тип("ТаблицаЗначений")
			ИЛИ ТипЗнч(ДанныеНастроекИзКэша.ПроизвольныеКодыДокумента) = Тип("Массив") Тогда
			ПроизвольныеКодыДокумента = ДанныеНастроекИзКэша.ПроизвольныеКодыДокумента;
		КонецЕсли;
	КонецЕсли;	
	
	ПроизвольныеКодыШапки 				= ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыШапки", ДанныеНастроекИзКэша, "Загрузка", "Шапка", АдресаПеременных);	
	ПроизвольныеКодыТабличнойЧасти 		= ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыТабличнойЧасти", ДанныеНастроекИзКэша, "Загрузка", "ТабличнаяЧасть", АдресаПеременных);	
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередЗагрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеЗагрузкиДокумента");
	
	ПроизвольныеКодыОбработчикаЗагрузки = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаЗагрузки", ДанныеНастроекИзКэша, "Загрузка", МассивТиповОбъектов, АдресаПеременных);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередЗаполнениемТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияТЧ");
	
	ПроизвольныеКодыОбработчикаТЧ 		= ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаТЧ", ДанныеНастроекИзКэша, "Загрузка", МассивТиповОбъектов, АдресаПеременных);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередЗаполнениемСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияСтрокиТЧ");
	
	ПроизвольныеКодыОбработчикаСтрокиТЧ = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаСтрокиТЧ", ДанныеНастроекИзКэша, "Загрузка", МассивТиповОбъектов, АдресаПеременных);
	
	Если ДанныеНастроекИзКэша = Неопределено 
		ИЛИ НЕ ДанныеНастроекИзКэша.Свойство("ЗначенияПараметров") 
		ИЛИ ТипЗнч(ДанныеНастроекИзКэша.ЗначенияПараметров) <> Тип("Массив") Тогда
		ЗначенияПараметров = ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных);
	Иначе
		ЗначенияПараметров = ДанныеНастроекИзКэша.ЗначенияПараметров;
    КонецЕсли;
	
	// Определяем обший модуль для выполнения кода в безопасном режиме (для передачи в ИО)
	ИнтеграционнаяОбработка = ГлЯдро_ПолучитьИнтеграционнуюОбработку(АдресаПеременных);
	
	Попытка
		ПараметрыАлгоритма = Новый Структура;
		ПараметрыАлгоритма.Вставить("ИнтеграционнаяОбработка", ИнтеграционнаяОбработка);
		ИмяМодуляБезопасногоРежима = ГлЯдро_ВычислитьВБезопасномРежиме("Параметры.ИнтеграционнаяОбработка.ПолучитьОбщийМодульВыполненияВБезопасномРежиме()", ПараметрыАлгоритма);				
	Исключение
		ИмяМодуляБезопасногоРежима = "";
	КонецПопытки;
		
	// Поиск существующего документа
	ДокументДляЗаписи = Неопределено;
	//ДокументОснование = Неопределено;
	Если НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина Тогда
		Если ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) Тогда
			Если ДокументОснование = Неопределено Тогда
				ДокументОснование = ГлЯдро_ПолучитьСсылкуНаДокументПоИд(НастройкаБП.ТипИсходногоДокумента1С,?(ЗначениеЗаполнено(ФильтрТЧПоИдДокумента),ФильтрТЧПоИдДокумента,ДанныеДокументаMS.ШапкаДокумента.Ид));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли НастройкаБП.ЗагружатьВТотЖе Тогда
		Если ТипЗнч(ДокументДляЗаполнения) = Тип("Структура") Тогда
			Если ЭтоАдресВременногоХранилища(ДокументДляЗаполнения.Данные) Тогда
				ДокументДляЗаписи = ПолучитьИзВременногоХранилища(ДокументДляЗаполнения.Данные).Объект;
			Иначе
				ДокументДляЗаписи = ДокументДляЗаполнения.Данные;
				Если ТипЗнч(ДокументДляЗаписи) = Тип("ДанныеФормыСтруктура") Тогда
					ДокументДляЗаписи = ДанныеФормыВЗначение(ДокументДляЗаписи,Тип("ДокументОбъект."+НастройкаБП.ТипИсходногоДокумента1С));
				КонецЕсли;
			КонецЕсли;				
		Иначе
			Попытка				
				ДокументДляЗаписи = ГлЯдро_ПолучитьСсылкуНаДокументПоИд(НастройкаБП.ТипИсходногоДокумента1С,?(ЗначениеЗаполнено(ФильтрТЧПоИдДокумента),ФильтрТЧПоИдДокумента,ДанныеДокументаMS.ШапкаДокумента.Ид));
				ДокументДляЗаписи = ДокументДляЗаписи.ПолучитьОбъект();
				Если ДокументДляЗаписи.Метаданные().Реквизиты.Найти("ДокументОснование") <> Неопределено
					И ДокументОснование = Неопределено Тогда
						ДокументОснование = ДокументДляЗаписи.ДокументОснование;					
				КонецЕсли;
			Исключение
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());				
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Ошибка при получении объекта документа для записи: %1, Документ: %2';
									|en = 'Error when getting a document object to write: %1, Document: %2';
									|be = 'Памылка пры атрыманні аб''екта дакумента для запісу: %1, Дакумент: %2'; es = 'Error al recuperar el objeto de documento para escribir: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის ობიექტის დაწერისას: %1, დოკუმენტი: %2'; kk = 'Жазу үшін құжат нысанын алу кезіндегі қате: %1, құжат: %2'; ro = 'Eroare la obținerea unui obiect document pentru a scrie: %1, Document: %2'; tr = 'Yazılacak belge nesnesini alırken hata oluştu: %1, Belge: %2'; uk = 'Помилка отримання об''єкта документа для запису: %1, Документ: % 2'; uz = 'Yozish uchun hujjat ob''ektini olishda xato: %1, hujjat: %2'";
				прДокументДляЗаписи = Строка(ДокументДляЗаписи);
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прДокументДляЗаписи);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ТекстОшибки,ДокументДляЗаписи",
					ТекстОшибки, прДокументДляЗаписи);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;
			Если ДокументДляЗаписи = Неопределено Тогда
				// документ не нашелся, возможно его удалили, создаем новый
				ДокументДляЗаписи = Документы[НастройкаБП.ТипРезультирующегоДокумента1С].СоздатьДокумент();
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ТипЗнч(ДокументДляЗаполнения) = Тип("Структура") Тогда
			Если ЭтоАдресВременногоХранилища(ДокументДляЗаполнения.Данные) Тогда
				ДокументДляЗаписи = ПолучитьИзВременногоХранилища(ДокументДляЗаполнения.Данные).Объект;
			Иначе
				ДокументДляЗаписи = ДокументДляЗаполнения.Данные;
				Если ТипЗнч(ДокументДляЗаписи) = Тип("ДанныеФормыСтруктура") Тогда
					ДокументДляЗаписи = ДанныеФормыВЗначение(ДокументДляЗаписи,Тип("ДокументОбъект."+НастройкаБП.ТипРезультирующегоДокумента1С));
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если НастройкаБП.СоздаватьНовыйДокументПриЗагрузке = Истина ИЛИ НЕ ЗначениеЗаполнено(ДокументДляЗаполнения) ИЛИ ДокументДляЗаполнения = Ложь Тогда
				ДокументДляЗаписи = Документы[НастройкаБП.ТипРезультирующегоДокумента1С].СоздатьДокумент();
				Если ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) И НастройкаБП.ТипИсходногоДокумента1С <> НастройкаБП.ТипРезультирующегоДокумента1С Тогда
					Попытка
						Если ДокументОснование = Неопределено Тогда
							Если ЗначениеЗаполнено(ФильтрТЧПоИдДокумента) Тогда
								ИдентификаторДокумента = ФильтрТЧПоИдДокумента;
							Иначе
								ИдентификаторДокумента = ДанныеДокументаMS.ШапкаДокумента.Ид;
							КонецЕсли;
							ДокументОснование = ГлЯдро_ПолучитьСсылкуНаДокументПоИд(НастройкаБП.ТипИсходногоДокумента1С, ИдентификаторДокумента);
						КонецЕсли;
						Если ДокументДляЗаписи.Метаданные().Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
							ДокументДляЗаписи.ДокументОснование = ДокументОснование;
						КонецЕсли;
					Исключение
						ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						// <Лог>
						ИнфоОшибка = ИнформацияОбОшибке();
						ЯзСтрока = "ru = 'Ошибка при получении объекта документа - основания: %1, Документ: %2';
											|en = 'Error when receiving the document object - grounds: %1, Document: %2';
											|be = 'Памылка пры атрыманні аб''екта дакумента-падставы: %1, Дакумент: %2'; es = 'Error al recuperar el objeto de documento base: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის მიღების დროს ობიექტი-საფუძვლები: %1, დოკუმენტი: %2'; kk = 'Құжат - негіз объектісін алу кезіндегі қателік: %1, құжат: %2'; ro = 'Eroare la primirea obiectului document-motive: %1, Document: %2'; tr = 'Belge tabanı nesnesini alırken hata oluştu: %1, Belge: %2'; uk = 'Помилка при отриманні об''єкта документа-підстави: %1, Документ: %2'; uz = 'Asosiy hujjat ob''ektini olishda xato: %1, hujjat: %2'";
						прДокументДляЗаписи = Строка(ДокументДляЗаписи);
						пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прДокументДляЗаписи);
						
						логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
							"ТекстОшибки,ДокументДляЗаписи",
							ТекстОшибки, прДокументДляЗаписи);
						ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
						// </Лог>
					КонецПопытки;
				КонецЕсли;
			Иначе			
				Попытка 
					ДокументДляЗаписи = ДокументДляЗаполнения.ПолучитьОбъект();	
				Исключение
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЯзСтрока = "ru = 'Ошибка при получении объекта документа для записи: %1, Документ: %2';
										|en = 'Error when getting a document object to write: %1, Document: %2';
										|be = 'Памылка пры атрыманні аб''екта дакумента для запісу: %1, Дакумент: %2'; es = 'Error al recuperar el objeto de documento para escribir: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის ობიექტის დაწერისას: %1, დოკუმენტი: %2'; kk = 'Жазу үшін құжат нысанын алу кезіндегі қате: %1, құжат: %2'; ro = 'Eroare la obținerea unui obiect document pentru a scrie: %1, Document: %2'; tr = 'Yazılacak belge nesnesini alırken hata oluştu: %1, Belge: %2'; uk = 'Помилка отримання об''єкта документа для запису: %1, Документ: % 2'; uz = 'Yozish uchun hujjat ob''ektini olishda xato: %1, hujjat: %2'";
					прДокументДляЗаписи = Строка(ДокументДляЗаписи);
					пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прДокументДляЗаписи);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"ТекстОшибки,ДокументДляЗаписи",
						ТекстОшибки, прДокументДляЗаписи);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
					// </Лог>
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДляЗагрузкиПоКлючам = Новый ТаблицаЗначений;
	ДанныеДляЗагрузкиПоКлючам.Колонки.Добавить("Таблица1СИсточник");
	ДанныеДляЗагрузкиПоКлючам.Колонки.Добавить("Таблица1СПриемник");
	ДанныеДляЗагрузкиПоКлючам.Колонки.Добавить("ИндексСтрокиMS");
	ДанныеДляЗагрузкиПоКлючам.Колонки.Добавить("ИндексСтроки1С");
	ДанныеДляЗагрузкиПоКлючам.Колонки.Добавить("ЗначениеКлюча");
	
	ПроизвольныеПараметры = Новый Структура;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("СообщениеОбОшибках", 								""); 
	СтруктураДанных.Вставить("СообщениеПользователю",							НСтр("ru = 'Данные документа обработаны!';
