				Если СтрокаНоменклатуры[IndexProductId] = СтрокаПлана[ИмяПоляИдТовара]
					И СтрокаНоменклатуры[IndexPackingId] = СтрокаПлана[ИмяПоляИдУпаковки] Тогда
