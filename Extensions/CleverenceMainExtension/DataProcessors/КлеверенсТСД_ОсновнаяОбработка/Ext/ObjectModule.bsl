				НайденныйПК = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПроизвольныеКодыДокумента, "ID_ПроизвольногоКода", НастройкаБП.ID_ПроизвольногоКода_Загрузка_Документ);
