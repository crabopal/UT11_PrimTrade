				СтруктураПеременных.Вставить("ДанныеНастроекИзКэша", 		ДанныеНастроекИзКэша);
				СтруктураПеременных.Вставить("ПроизвольныеПараметры", 		ПроизвольныеПараметры);
				СтруктураПеременных.Вставить("АдресаПеременных", 			АдресаПеременных);
				
				РезультатВыполненияКода = ГлЯдро_ВыполнитьПроизвольныйКод(НайденныйПК.ТекстПроизвольногоКода, СтруктураПеременных, НайденныйПК.ID_ПроизвольногоКода, НайденныйПК.Наименование, АдресаПеременных);
				
				Если НЕ РезультатВыполненияКода.Статус Тогда
					Сообщение = НСтр("ru = 'Ошибка! Не удалось выполнить произвольный код загрузки документа ""%1""';
										|en = 'Mistake! The arbitrary document upload code ""%1"" could not be executed';
										|be = 'Памылка! Не атрымалася выканаць адвольны код загрузкі дакумента""%1""'; es = '¡Error! No se pudo ejecutar un código de carga de documento arbitrario ""%1""'; ka = 'შეცდომა! თვითნებური დოკუმენტის ატვირთვის კოდი ""%1 "" ვერ შესრულდა'; kk = 'Қате! ""%1 "" құжатының ерікті жүктеу кодын орындау мүмкін болмады'; ro = 'Greșeală! Codul arbitrar de încărcare a documentului ""%1 "" nu a putut fi executat'; tr = 'Hata! Keyfi belge yükleme kodu ""%1"" yürütülemedi'; uk = 'Помилка! Не вдалося виконати довільний код завантаження документа""%1""'; uz = 'Xato! ""%1 "" o''zboshimchalik bilan hujjatni yuklash kodini bajarib bo''lmadi'");
					Сообщение = ГлЯдро_СтрШаблон(Сообщение, НайденныйПК.Наименование);
					Сообщить(Сообщение); 
					СтруктураДанных.СтатусВыполненияПроизвольногоКода = Ложь;
				КонецЕсли; 
				Если НЕ ПустаяСтрока(РезультатВыполненияКода.СообщениеПользователю) Тогда
					СтруктураДанных.СообщениеПользователю = РезультатВыполненияКода.СообщениеПользователю;
				ИначеЕсли НЕ РезультатВыполненияКода.Статус Тогда
					СтруктураДанных.СообщениеПользователю = НСтр("ru = 'Данные документа обработаны с ошибкой!';
																	|en = 'The document data was processed with an error!'; be = 'Дадзеныя дакумента апрацаваны з памылкай!'; es = '¡Los datos del documento se procesaron con un error!'; ka = 'დოკუმენტის მონაცემები შეცდომით დამუშავდა!'; kk = 'Құжат деректері қатемен өңделеді!'; ro = 'Datele documentului au fost procesate cu o eroare!'; tr = 'Belge verileri bir hatayla işlendi!'; uk = 'Дані документа оброблені з помилкою!'; uz = 'Hujjat ma''lumotlari xato bilan qayta ishlanadi!'");
				КонецЕсли;
				
				Если РезультатВыполненияКода.Свойство("КритическаяОшибка")
					И РезультатВыполненияКода.КритическаяОшибка = Истина Тогда
					
					Если Не ПустаяСтрока(РезультатВыполненияКода.КритическаяОшибкаОписание) Тогда
						КритическаяОшибкаОписание = РезультатВыполненияКода.КритическаяОшибкаОписание;	
					Иначе	
						КритическаяОшибкаОписание = НСтр("ru = '(Пусто)';
															|en = '(Empty)'; be = '(Пуста)'; es = '(Está vacío)'; ka = '(ცარიელი)'; kk = '(Бос)'; ro = '(Gol)'; tr = '(Boş)'; uk = '(Порожньо)'; uz = '(Bo''sh)'");
					КонецЕсли;
					
					// <Лог>
					ЯзСтрока = "ru = 'Критическая ошибка при выполнении обработчика <%1>. Причина: %2';
										|en = 'Critical error when executing the handler <%1>. Reason: %2';
										|be = 'Крытычная памылка пры выкананні апрацоўшчыка < %1>. Прычына: %2'; es = 'Error crítico al ejecutar el controlador <%1>. Causa: %2'; ka = 'კრიტიკული შეცდომა დამმუშავებლის <%1>შესრულებისას. მიზეზი: %2'; kk = 'Өңдегішті орындау кезінде маңызды қате <%1>. Себебі: %2'; ro = 'Eroare critică la executarea manipulatorului <%1>. Motiv: %2'; tr = 'işleyicinin yürütülmesinde kritik hata <%1>. Sebep: %2'; uk = 'Критична помилка при виконанні обробника <%1>. Причина: %2'; uz = 'Ishlov beruvchini bajarishda muhim xato <%1>. Sababi: %2'";
					пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), НайденныйПК.Наименование, КритическаяОшибкаОписание);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"Наименование,КритическаяОшибкаОписание",
						НайденныйПК.Наименование, КритическаяОшибкаОписание);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
					// </Лог>
										
				КонецЕсли;
				
			КонецЕсли; 
			
		ИначеЕсли НастройкаБП.ТипОбработчикаЗагрузки = 1 И ЗначениеЗаполнено(НастройкаБП.Обработчик_ПередЗаполнениемДокумента) Тогда
			
			ГлЯдро_ВыполнитьОбработчикЗагрузкиДокумента1С("Обработчик_ПередЗаполнениемДокумента", ДокументДляЗаписи, ДокументОснование, НастройкаБП,,,, ДанныеДокументаMS,, СтруктураДанных, АдресаПеременных);
			
			Если СтруктураДанных.Свойство("КритическаяОшибка")
				И СтруктураДанных.КритическаяОшибка = Истина Тогда
				СообщениеПользователюТСД = НСтр("ru = 'Данные документа обработаны с ошибкой!';
													|en = 'The document data was processed with an error!'; be = 'Дадзеныя дакумента апрацаваны з памылкай!'; es = '¡Los datos del documento se procesaron con un error!'; ka = 'დოკუმენტის მონაცემები შეცდომით დამუშავდა!'; kk = 'Құжат деректері қатемен өңделеді!'; ro = 'Datele documentului au fost procesate cu o eroare!'; tr = 'Belge verileri bir hatayla işlendi!'; uk = 'Дані документа оброблені з помилкою!'; uz = 'Hujjat ma''lumotlari xato bilan qayta ishlanadi!'");
				Если СтруктураДанных.Свойство("КритическаяОшибкаОписание")
					И ЗначениеЗаполнено(СтруктураДанных.КритическаяОшибкаОписание) Тогда
					СообщениеПользователюТСД = НСтр("ru = '%1 Причина: %2';
														|en = '%1 Reason: %2'; be = '% 1 Прычына: %2'; es = '% 1 Causa: %2'; ka = '%1 მიზეზი: %2'; kk = '%1 себеп: %2'; ro = '% 1 motiv: %2'; tr = '%1 Sebep: %2'; uk = '% 1 Причина: %2'; uz = '%1 sababi: %2'");
					СообщениеПользователюТСД = ГлЯдро_СтрШаблон(СообщениеПользователюТСД, СообщениеПользователюТСД, Строка(СтруктураДанных.КритическаяОшибкаОписание));
				Иначе
					СообщениеПользователюТСД = НСтр("ru = '%1 Подробности см. в журнале регистрации 1С.';
														|en = '%1 For details, see in the 1C registration log.'; be = '%1 падрабязнасці гл. у часопісе рэгістрацыі 1С.'; es = '%1 consulte el registro 1C para obtener más Detalles.'; ka = '% 1 დეტალებისთვის იხილეთ 1C სარეგისტრაციო ჟურნალში.'; kk = '%1 Толығырақ 1С тіркеу журналын қараңыз.'; ro = '%1 Pentru detalii, consultați jurnalul de înregistrare 1C.'; tr = '%1 Ayrıntılar için 1C kayıt defterine bakın.'; uk = '%1 подробиці див.в журналі реєстрації 1С.'; uz = '%1 tafsilotlar uchun 1C ro''yxatdan o''tish jurnaliga qarang.'");
					СообщениеПользователюТСД = ГлЯдро_СтрШаблон(СообщениеПользователюТСД, СообщениеПользователюТСД);
				КонецЕсли;
				
				СтруктураДанных.Вставить("СтатусВыполненияПроизвольногоКода", Ложь);
				СтруктураДанных.Вставить("СообщениеПользователю", СообщениеПользователюТСД);
			КонецЕсли;
			
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Конец, Заполнение документа 1С';
							|en = 'End, Filling out the 1C document'; be = 'Канец, Запаўненне дакумента 1С'; es = 'Fin, rellenar el documento 1C'; ka = 'დასასრული, 1c დოკუმენტის შევსება'; kk = 'Соңы, 1С құжатты толтыру'; ro = 'Încheiați, completând documentul 1C'; tr = 'Son, 1C belgesinin doldurulması'; uk = 'Кінець, заповнення документа 1С'; uz = 'Tugatish, 1C hujjatni to''ldirish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанных);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураДанных;
	КонецЕсли;
	// Шапка документа
	// Реквизиты Клеверенс
	ГлЯдро_ЗаполнитьДанныеДляЗагрузкиРеквизитамиMS(СтруктураДанных, АдресаПеременных);
	// Произвольные значения
	ГлЯдро_ЗаполнитьДанныеДляЗагрузкиПроизвольнымиЗначениями(СтруктураДанных);
	// Глобальные параметры
	ГлЯдро_ЗаполнитьДанныеДляЗагрузкиГлобальнымиПараметрами(СтруктураДанных);
	// Произвольные коды
	ГлЯдро_ЗаполнитьДанныеДляЗагрузкиПроизвольнымиКодами(СтруктураДанных,АдресаПеременных);	
	
	ГлЯдро_ВыполнитьОбработчикЗагрузкиДокумента1С("Обработчик_ПередЗаполнениемДокумента", ДокументДляЗаписи, ДокументОснование, НастройкаБП,,,, ДанныеДокументаMS,,СтруктураДанных,АдресаПеременных);	
		
	Если СтруктураДанных.Свойство("КритическаяОшибка")
		И СтруктураДанных.КритическаяОшибка = Истина Тогда
		пСообщение = НСтр("ru = 'Конец, Заполнение документа 1С';
							|en = 'End, Filling out the 1C document'; be = 'Канец, Запаўненне дакумента 1С'; es = 'Fin, rellenar el documento 1C'; ka = 'დასასრული, 1c დოკუმენტის შევსება'; kk = 'Соңы, 1С құжатты толтыру'; ro = 'Încheiați, completând documentul 1C'; tr = 'Son, 1C belgesinin doldurulması'; uk = 'Кінець, заповнення документа 1С'; uz = 'Tugatish, 1C hujjatni to''ldirish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанных);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураДанных;
	КонецЕсли;
	
	// Заполняем шапку документа только если в новый документ
	Если ДокументДляЗаписи.ЭтоНовый() Тогда
		// Перед заполнением документа		
		Если НЕ ЗначениеЗаполнено(ДокументДляЗаписи.Дата) Тогда
			ДокументДляЗаписи.Дата = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
		
	// Загружаем
	Если ТипЗнч(НастройкаБП.НастройкаЗагрузкиПолей) = Тип("Массив") Тогда
		Для Каждого НастройкаРеквизита из НастройкаБП.НастройкаЗагрузкиПолей Цикл
			Если НастройкаРеквизита.Свойство("ТипПриемника") И НастройкаРеквизита.ТипПриемника = "Реквизит1С"
				И НастройкаРеквизита.Свойство("Загружать") И НастройкаРеквизита.Загружать = Истина Тогда
				
				Если СтруктураДанных.ДанныеДляЗагрузки_Шапка.Свойство(НастройкаРеквизита.ИмяПриемника) 
					И ЗначениеЗаполнено(СтруктураДанных.ДанныеДляЗагрузки_Шапка[НастройкаРеквизита.ИмяПриемника]) Тогда
					Попытка
						ЗначениеДляЗагрузки = REST_API_ПреобразованиеЗначенияРеквизитаИсточникаВТип1С(
							СтруктураДанных.ДанныеДляЗагрузки_Шапка[НастройкаРеквизита.ИмяПриемника],
							ДокументДляЗаписи[НастройкаРеквизита.ИмяПриемника]);	
						ДокументДляЗаписи[НастройкаРеквизита.ИмяПриемника] = ЗначениеДляЗагрузки;
					Исключение
						ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						// <Лог>
						ИнфоОшибка = ИнформацияОбОшибке();
						ЯзСтрока = "ru = 'Ошибка при заполнении реквизита документа: %1, Документ: %2';
											|en = 'Error when filling in the details of the document: %1, Document: %2';
											|be = 'Памылка пры запаўненні рэквізіту дакумента: %1, Дакумент: %2'; es = 'Error al rellenar los detalles del documento: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის დეტალების შევსებისას: %1, დოკუმენტი: %2'; kk = 'Құжаттың деректемесін толтыру кезіндегі қателік: %1, құжат: %2'; ro = 'Eroare la completarea detaliilor documentului: %1, Document: %2'; tr = 'Belge ayrıntılarını doldururken hata oluştu: %1, Belge: %2'; uk = 'Помилка при заповненні реквізиту документа: %1, Документ: %2'; uz = 'Hujjat tafsilotlarini to''ldirishda xato: %1, hujjat: %2'";
						прДокументДляЗаписи = Строка(ДокументДляЗаписи);
						пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прДокументДляЗаписи);
						
						логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
							"ТекстОшибки,ДокументДляЗаписи",
							ТекстОшибки, прДокументДляЗаписи);
						ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
						// </Лог>
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Табличные части
	СтруктураДанных.Вставить("КонтрольКоличества", НастройкаБП.КонтрольКоличества);
	СтруктураДанных.Вставить("ДанныеДляЗагрузки_Строка", Новый Структура); 
	СтруктураДанных.Вставить("ИмяПриемникаДанных", "ДанныеДляЗагрузки_Строка"); 
	СтруктураДанных.Вставить("ИмяИсточникаДанных", "ТаблицаMS"); 
	
	//Найдем основную ТЧ и поставим её на первое место т.к. она должна обработаться первой
	НастройкиТЧ = НастройкаБП.НастройкаЗагрузкиТЧ;Индекс=0;
	Для Каждого СтрокаНастройкиТЧ Из НастройкиТЧ Цикл
		Если СтрокаНастройкиТЧ.Свойство("ОсновнаяТабличнаяЧасть") и СтрокаНастройкиТЧ.ОсновнаяТабличнаяЧасть = Истина Тогда
			СтруктураДанных.Вставить("ИмяОсновнойТЧ",СтрокаНастройкиТЧ.НастройкаТЧСтрокой);
			НастройкиТЧ.Удалить(Индекс);
			Если НастройкиТЧ[0].Свойство("ЭтоТаблицаЗначений") Тогда
				НастройкиТЧ.Вставить(1,СтрокаНастройкиТЧ);
			Иначе
				НастройкиТЧ.Вставить(0,СтрокаНастройкиТЧ);
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Индекс=Индекс+1;
	КонецЦикла;
	
	Для Каждого СтрокаНастройкиТЧ Из НастройкиТЧ Цикл
		Если СтрокаНастройкиТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		СтруктураДанных.Вставить("СтрокаНастройкиТЧ", СтрокаНастройкиТЧ); 
		ГлЯдро_ЗагрузитьСтрокиТабличнойЧасти(СтруктураДанных,АдресаПеременных);
		Если СтруктураДанных.Свойство("КритическаяОшибка")
			И СтруктураДанных.КритическаяОшибка = Истина Тогда
			пСообщение = НСтр("ru = 'Конец, Заполнение документа 1С';
								|en = 'End, Filling out the 1C document'; be = 'Канец, Запаўненне дакумента 1С'; es = 'Fin, rellenar el documento 1C'; ka = 'დასასრული, 1c დოკუმენტის შევსება'; kk = 'Соңы, 1С құжатты толтыру'; ro = 'Încheiați, completând documentul 1C'; tr = 'Son, 1C belgesinin doldurulması'; uk = 'Кінець, заповнення документа 1С'; uz = 'Tugatish, 1C hujjatni to''ldirish'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанных);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат СтруктураДанных;
	КонецЕсли;
	КонецЦикла;
	
	СтруктураДанных.Вставить("ИмяИсточникаДанных", "ШапкаДокументаMS");
	СтруктураДанных.Вставить("ИмяПриемникаДанных", "ДанныеДляЗагрузки_Шапка"); 
	
	// После заполнения документа
	ГлЯдро_ВыполнитьОбработчикЗагрузкиДокумента1С("Обработчик_ПослеЗаполненияДокумента", ДокументДляЗаписи, ДокументОснование, НастройкаБП,,,, ДанныеДокументаMS,,СтруктураДанных,АдресаПеременных);
	
	Если СтруктураДанных.Свойство("КритическаяОшибка")
		И СтруктураДанных.КритическаяОшибка = Истина Тогда
		пСообщение = НСтр("ru = 'Конец, Заполнение документа 1С';
							|en = 'End, Filling out the 1C document'; be = 'Канец, Запаўненне дакумента 1С'; es = 'Fin, rellenar el documento 1C'; ka = 'დასასრული, 1c დოკუმენტის შევსება'; kk = 'Соңы, 1С құжатты толтыру'; ro = 'Încheiați, completând documentul 1C'; tr = 'Son, 1C belgesinin doldurulması'; uk = 'Кінець, заповнення документа 1С'; uz = 'Tugatish, 1C hujjatni to''ldirish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанных);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураДанных;
	КонецЕсли;
		
	Если ГлЯдро_УдалитьСтрокиПоУсловию(ДокументДляЗаписи, НастройкаБП) Тогда
		//// если выполнено удаление строк по условию, необходимо сбросить флаг ДокументЗаписанВОбработчике, иначе изменения пропадут
		//СтруктураДанных.Вставить("ДокументЗаписанВОбработчике", Ложь);
		
		// Если удалены какие-то строки в документе, и при этом он был записан в обработчике, то необходимо еще раз записать документ,
		// чтобы сохранились эти изменения (флаг не трогаем)
		Если СтруктураДанных.Свойство("ДокументЗаписанВОбработчике") 
			И СтруктураДанных.ДокументЗаписанВОбработчике = Истина Тогда
			
			Попытка
				ДокументДляЗаписи.Записать();
			Исключение
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Ошибка при записи документа по удаления строк по условию: %1, Документ: %2';
									|en = 'Error when writing a document by deleting lines under the condition: %1, Document: %2';
									|be = 'Памылка пры запісе дакумента па выдалення радкоў па ўмове: %1, Дакумент: %2'; es = 'Error al escribir un documento sobre la condición de eliminación de filas: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის წერისას ხაზების წაშლით პირობით: %1, დოკუმენტი: %2'; kk = 'Жолдарды жою бойынша құжатты жазу кезіндегі қате: %1, құжат: %2'; ro = 'Eroare la scrierea unui document prin ștergerea liniilor cu condiția: %1, Document: %2'; tr = 'Koşula göre satırları silmek için belge yazarken hata oluştu: %1, Belge: %2'; uk = 'Помилка при записі документа по видалення рядків за умовою: %1, Документ: %2'; uz = 'Shart bo''yicha satrlarni o''chirish uchun hujjatni yozishda xato: %1, hujjat: %2'";
				прДокументДляЗаписи = Строка(ДокументДляЗаписи);
				пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки, прДокументДляЗаписи);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
					"ТекстОшибки,ДокументДляЗаписи",
					ТекстОшибки, прДокументДляЗаписи);
				ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;                 				
			
		КонецЕсли;
	КонецЕсли;	
		
	ДокументДляЗаписи.ДополнительныеСвойства.Вставить("ПроводитьДокумент", НастройкаБП.ПроводитьДокументПослеЗагрузки);
	
	пСообщение = НСтр("ru = 'Конец, Заполнение документа 1С';
						|en = 'End, Filling out the 1C document'; be = 'Канец, Запаўненне дакумента 1С'; es = 'Fin, rellenar el documento 1C'; ka = 'დასასრული, 1c დოკუმენტის შევსება'; kk = 'Соңы, 1С құжатты толтыру'; ro = 'Încheiați, completând documentul 1C'; tr = 'Son, 1C belgesinin doldurulması'; uk = 'Кінець, заповнення документа 1С'; uz = 'Tugatish, 1C hujjatni to''ldirish'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ГлЯдро_ЗаписатьИПровестиДокумент1С(Знач РезультатЗаписи, НастройкаБизнесПроцесса, ИмяТипаДокумента, ИмяДокумента,АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_ЗаписатьИПровестиДокумент1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатЗаписи,НастройкаБизнесПроцесса,ИмяТипаДокумента,ИмяДокумента",
		РезультатЗаписи, НастройкаБизнесПроцесса, ИмяТипаДокумента, ИмяДокумента);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если РезультатЗаписи.Статус = Истина Тогда
		
		// Результат выполнения произвольного кода загрузки
		Если РезультатЗаписи.Данные = Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗаписи);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат РезультатЗаписи;
		КонецЕсли;
		
		// ******************************************* +++ Алгоритм записи и проведения документов *******************************************
		
		НастройкиДляОбмена 	= ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",,АдресаПеременных);
		// т.к. для документа уже был правильно подобран БП в методе "ГлЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID", то и здесь БП будет правильно подобран
		РезультатПодбораБП 	= ГлЯдро_ПолучитьНастройкуБизнесПроцесса(НастройкаБизнесПроцесса, ИмяТипаДокумента, НастройкиДляОбмена,,АдресаПеременных);										
		НастройкаБП 		= РезультатПодбораБП.Данные;
				
		ДокументДляЗаписи 	= РезультатЗаписи.Данные;
		ЭтоНовыйДокумент 	= ДокументДляЗаписи.ЭтоНовый();				
		СтрокаДокумента 	= "";
		#Область НесовместимыйКодFresh
		ДокументДляЗаписи.ОбменДанными.Загрузка = Ложь;
		#КонецОбласти //НесовместимыйКодFresh
		
		Если ДокументДляЗаписи.ЭтоНовый() И НЕ ЗначениеЗаполнено(ДокументДляЗаписи.Номер) Тогда
			ДокументДляЗаписи.УстановитьНовыйНомер();
		КонецЕсли;	
		
		Попытка
			Если ДокументДляЗаписи.Проведен Тогда
				Если Не РезультатЗаписи.ДокументЗаписанВОбработчике Тогда					
					РежимПроведения = ?(ДокументДляЗаписи.Метаданные().ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить, 
						РежимПроведенияДокумента.Оперативный, РежимПроведенияДокумента.Неоперативный);
						
					Если (РежимПроведения = РежимПроведенияДокумента.Оперативный) И (ДокументДляЗаписи.Дата < НачалоДня(ТекущаяДата())) Тогда
						РежимПроведения = РежимПроведенияДокумента.Неоперативный;
					КонецЕсли;						
					
					ДокументДляЗаписи.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
				КонецЕсли;	
				СтрокаДокумента = Строка(ДокументДляЗаписи.Ссылка);
				пСообщение = НСтр("ru = 'Документ %1 записан и перепроведен!';
									|en = 'The %1 document has been recorded and rechecked!'; be = 'Дакумент %1 запісаны і пераправедзены!'; es = '¡El documento %1 está grabado y revisado!'; ka = '%1 დოკუმენტი დაფიქსირდა და გადაამოწმეს!'; kk = '% 1 құжат жазылды және қайта жүргізілді!'; ro = 'Documentul %1 a fost înregistrat și verificat din nou!'; tr = 'Belge % 1 kaydedildi ve yeniden kontrol edildi!'; uk = 'Документ %1 записаний і перепроведен!'; uz = '%1 hujjati yozib olingan va ikki marta tekshirilgan!'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, СтрокаДокумента);
				РезультатЗаписи.Вставить("Сообщение", пСообщение);
				
				пСообщение = НСтр("ru = 'Документ перепроведен: %1';
									|en = 'The document has been rechecked: %1'; be = 'Дакумент пераправедзены: %1'; es = 'Documento revisado: %1'; ka = 'დოკუმენტი გადაამოწმეს: %1'; kk = 'Құжат қайта жүргізілді: %1'; ro = 'Documentul a fost reverificat: %1'; tr = 'Belge yeniden kontrol edildi: %1'; uk = 'Документ перепроведений: %1'; uz = 'Hujjat ikki marta tasdiqlangan: %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, СтрокаДокумента);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
			Иначе	
				// Из-за странностей в некоторых релизах УТ 11, ЕРП 2.4 добавим попытку
				Попытка
					Если Не РезультатЗаписи.ДокументЗаписанВОбработчике Тогда
						ДокументДляЗаписи.Записать(РежимЗаписиДокумента.Запись);						
					КонецЕсли;						
				Исключение
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЯзСтрока = "ru = 'Ошибка при записи документа без режима ОбменДаннымиЗагрузка=Истина: %1, Документ: %2';
										|en = 'Error when writing a document without the recommended upload mode=True: %1, Document: %2';
										|be = 'Памылка пры запісе дакумента без рэжыму ОбменДаннымиЗагрузка=ісціна: %1, Дакумент: %2'; es = 'Error al escribir un documento sin modo de intercambio De datos Carga = Verdadero: %1, Documento: %2'; ka = 'შეცდომა დოკუმენტის დაწერისას რეკომენდებული ატვირთვის რეჟიმის გარეშე = True: %1, დოკუმენტი: %2'; kk = 'Құжатты айырбастау режимінсіз жазу кезіндегі қателік жүктеу=шындық: %1, құжат: %2'; ro = 'Eroare la scrierea unui document fără modul de încărcare recomandat=True: %1, Document: %2'; tr = 'Değişim modu olmadan bir belge yazarken hata yükleniyor=Doğru: %1, Belge: %2'; uk = 'Помилка при записі документа без режиму Обмінданимизавантаження=істина: %1, Документ: %2'; uz = 'Hujjatni almashish rejimisiz yozishda xato yuk=haqiqat: %1, hujjat: %2'";
					прРежимЗаписиДокумента = Строка(РежимЗаписиДокумента);
