		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		mXmlDoc = "AutoSerialization";
		ГлЯдро_Инициализация(ИмяСобытия, Истина, mXmlDoc, АдресаПеременных);
		
		пСообщение = НСтр("ru = 'Конец, Вызов полной инициализации из СМАРТС. Проверка актуальности кэшируемых настроек.';
							|en = 'End, Calling full initialization from Cleverence. Checking the relevance of cached settings.';
							|be = 'Канец, выклік поўнай ініцыялізацыі з Cleverence. Праверка актуальнасці кэшируемых налад.'; es = 'Fin, Llamando a la inicialización completa desde Cleverence. Comprobar si los ajustes almacenados en caché están actualizados.'; ka = 'დასასრული, სრული ინიციალიზაციის მოწოდება Cleverence-დან. ქეშირებული პარამეტრების შესაბამისობის შემოწმება.'; kk = 'Аяқтау, Cleverence-тен толық инициализацияға шақыру. Кэштелген параметрлердің өзектілігін тексеру.'; ro = 'Sfârșit, apelând la inițializarea completă de la Cleverence. Verificarea relevanței setărilor din cache.'; tr = 'Son, Cleverence''den tam başlatma çağrısı. Önbelleğe alınan ayarların alaka düzeyini kontrol edin.'; uk = 'Кінець, виклик повної ініціалізації з Cleverence. Перевірка актуальності кешованих налаштувань.'; uz = 'Tugatish, Cleverence-dan to''liq ishga tushirishni chaqirish. Keshlangan sozlamalarning dolzarbligini tekshirish.'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		Возврат Ложь;
