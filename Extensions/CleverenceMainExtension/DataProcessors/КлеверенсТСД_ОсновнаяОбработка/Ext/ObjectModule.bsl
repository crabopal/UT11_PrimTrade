Функция ГлЯдро_ПолучитьЗначениеОбъектаИзПредставленияXML(ОписаниеТиповОбъекта, СтрокаXML, ИмяТаблицы, МетаданныеНСИ) Экспорт
	
	Перем Значение;
	
	МассивТипов = ОписаниеТиповОбъекта.Типы();
	ПорядокОбходаТипов = Новый Массив;
	Для каждого Тип Из МассивТипов Цикл
		Если Тип <> Тип("Строка") Тогда
			ПорядокОбходаТипов.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивТипов.Найти(Тип("Строка")) <> Неопределено Тогда
		ПорядокОбходаТипов.Добавить(Тип("Строка"));
	КонецЕсли;
	
	Для Каждого Тип Из ПорядокОбходаТипов Цикл
		Если НЕ ТипЗнч(СтрокаXML) = Тип("Строка") Тогда
			Значение = СтрокаXML;
			Прервать;
		КонецЕсли;
			
		Попытка
			Значение = XMLЗначение(Тип, СтрокаXML);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Значение)
			И НЕ ГлЯдро_СтрНайти(Строка(Значение), "бъект не найден")
			И НЕ ГлЯдро_СтрНайти(Строка(Значение), "bject not found") Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если НЕ ЗначениеЗаполнено(Значение)
		ИЛИ ГлЯдро_СтрНайти(Строка(Значение), "бъект не найден")
		ИЛИ ГлЯдро_СтрНайти(Строка(Значение), "bject not found") Тогда
		Значение = ОписаниеТиповОбъекта.ПривестиЗначение();
		
		Если Значение = Неопределено Тогда
			Попытка
				Если МетаданныеНСИ.Свойство(ИмяТаблицы) Тогда
					Значение = ГлЯдро_ПолучитьЗначениеСправочникаПоID(МетаданныеНСИ[ИмяТаблицы].ИмяСправочника, Значение);
				КонецЕсли;	
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ГлЯдро_ПолучитьСсылкуСПроверкой(ИмяСправочника, Идентификатор) Экспорт	
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Попытка
			Если ТипЗнч(Идентификатор) = Тип("Строка") Тогда
				Гуид = Новый УникальныйИдентификатор(Идентификатор);
			Иначе
				Гуид = Идентификатор;
			КонецЕсли;
			
			Результат = Справочники[ИмяСправочника].ПолучитьСсылку(Гуид);
			
			РезультатСтрокой = Строка(Результат);
			Если Результат = Неопределено
				ИЛИ ГлЯдро_СтрНайти(РезультатСтрокой, "бъект не найден") > 0
				ИЛИ ГлЯдро_СтрНайти(РезультатСтрокой, "bject not found") > 0 Тогда
				Результат = Неопределено;
			КонецЕсли;
		
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ГлЯдро_ДоступноВыполнениеВФоне(локПараметрЗапуска) Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Ложь;
	#КонецЕсли
	
	#Если ВебКлиент Тогда
		ЭтоВнешняяОбработка = ГлЯдро_ЭтоВнешняяОбработка();
		Если ЭтоВнешняяОбработка
			И НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
			// В веб-клиенте в открытой ОО из файла не доступно выполнение в фоне из-за ограничений метода ИспользуемоеИмяФайла,
			// который в веб-клиенте не возвращает полный путь к файлу внешней обработки
			Возврат Ложь;
		КонецЕсли;
	#КонецЕсли
	
	Если Найти(ВРег(локПараметрЗапуска), "НЕЗАПУСКАТЬФОНОВЫЕЗАДАНИЯ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДоступностьВыполненияВФоне = Ложь;
	
	ВерсияБСП = ГлЯдро_ПолучитьВерсиюБСП();
	
	// Определяем, что выполнение в фоне доступно, если версия БСП больше 3.0.0.0
	Если ВерсияБСП <> Неопределено Тогда
		РезультатСравнения = ГлЯдро_СравнитьВерсии(ВерсияБСП, "3.0.0.0");
		
		Если РезультатСравнения > 0 Тогда
			ДоступностьВыполненияВФоне = Истина;		
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДоступностьВыполненияВФоне;
	
КонецФункции

Функция ГлЯдро_ПолучитьВерсиюБСП() Экспорт
	
	ВерсияБСП = Неопределено;

	ИмяМодуля = "СтандартныеПодсистемыВызовСервера";

	МодульЕсть = ГлЯдро_ВычислитьВБезопасномРежиме("Метаданные.ОбщиеМодули.Найти(" + """" + ИмяМодуля + """" + ") <> Неопределено");
	
	Если МодульЕсть Тогда
		Попытка
			ВерсияБСП = ГлЯдро_ВычислитьВБезопасномРежиме("" + ИмяМодуля + "" + ".ВерсияБиблиотеки()");
		Исключение
		КонецПопытки;
	Иначе
		ИмяМодуля = "StandardSubsystemsServerCall";

		МодульЕсть = ГлЯдро_ВычислитьВБезопасномРежиме("Метаданные.ОбщиеМодули.Найти(" + """" + ИмяМодуля + """" + ") <> Неопределено");
		
		Если МодульЕсть <> Неопределено Тогда
			Попытка
				ВерсияБСП = ГлЯдро_ВычислитьВБезопасномРежиме("" + ИмяМодуля + "" + ".LibraryVersion()");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВерсияБСП;
				
КонецФункции

Функция ГлЯдро_ЭтоВнешняяОбработка()
	
	ПолноеИмя = "";
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ПолноеИмя = ЭтотОбъект.Метаданные().ПолноеИмя();
	#КонецЕсли
	
	ЧастиИмени = ГлЯдро_СтрРазделить(ПолноеИмя, ".");
	Возврат ВРег(ЧастиИмени[0]) = "ВНЕШНЯЯОБРАБОТКА" или ВРег(ЧастиИмени[0]) = "EXTERNALDATAPROCESSOR";
	
КонецФункции

Функция ГлЯдро_СравнитьВерсии(Знач ЧастиВерсии1, Знач ЧастиВерсии2) Экспорт
	
	Результат = 0;
	
	Если ТипЗнч(ЧастиВерсии1) = Тип("Строка") И ТипЗнч(ЧастиВерсии2) = Тип("Строка") Тогда
		Строка1 = ?(ПустаяСтрока(ЧастиВерсии1), "0.0.0.0", ЧастиВерсии1);
		Версия1 = ГлЯдро_РазложитьСтрокуВМассивПодстрок(Строка1, ".");	
		Строка2 = ?(ПустаяСтрока(ЧастиВерсии2), "0.0.0.0", ЧастиВерсии2);
		Версия2 = ГлЯдро_РазложитьСтрокуВМассивПодстрок(Строка2, ".");
	ИначеЕсли ТипЗнч(ЧастиВерсии1) = Тип("Массив") И ТипЗнч(ЧастиВерсии2) = Тип("Массив") Тогда
		Версия1 = ЧастиВерсии1;
		Версия2 = ЧастиВерсии2;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Если Версия1.Количество() < 4 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Версия2.Количество() < 4 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Разряд = 0 По 3 Цикл
		Результат = Число(ГлЯдро_ОставитьЦифрыВСтроке(Версия1[Разряд], Истина)) - Число(ГлЯдро_ОставитьЦифрыВСтроке(Версия2[Разряд], Истина));
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ОставитьЦифрыВСтроке(ИсходнаяСтрока, ОставитьТолькоПервыеЦифры = Ложь)
	
	ПолученнаяСтрока = "";
	
	Для Индекс = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		Символ = Сред(ИсходнаяСтрока, Индекс, 1);
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
			ПолученнаяСтрока = ПолученнаяСтрока + Символ;
		ИначеЕсли ОставитьТолькоПервыеЦифры Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПолученнаяСтрока;
	
КонецФункции

// Рекурсивно сравнивает две структуры настроек и массивы в них.
// Возвращает только отличия, где приоритетными считаются значения из правой структуры. 
// 	Важно. В элементах массивов также возращает только измененные ключи, а не целую строку.
// Сделано для сравнения типовых и пользовательских значений настроек.
//
// Параметры:
//  НастройкиЛево - Структура - Левая структура для сравнения (обычно типовые настройки).
//  НастройкиПраво - Структура - Правая структура для сравнения (обычно пользовательские настройки).
//  ДополнительныеПараметры - Структура - Дополнительные параметры сравнения.
//      * ПропуститьНастройки - Структура - Структура с ключами настроек, которые следует пропустить при сравнении.
//
// Возвращаемое значение:
//   Структура - результат сравнения:
//      * Изменено - Булево - Истина, если найдены отличия.
//      * ИзмененныеЗначения - Структура - Содержит только те ключи и значения, которые отличаются или
//                                        присутствуют только в правой структуре.
//
Функция ГлЯдро_СравнитьСтруктуруНастроек(НастройкиЛево, НастройкиПраво, ДополнительныеПараметры = Неопределено) Экспорт
	
	РезультатСравнения = Новый Структура("Изменено, ИзмененныеЗначения", Ложь, Новый Структура);
	
	// Имена настроек, которые не нужно сравнивать
	ПропуститьНастройки = Новый Структура;
	Если ДополнительныеПараметры = Неопределено
		ИЛИ НЕ ДополнительныеПараметры.Свойство("ПропуститьНастройки") Тогда
		ПропуститьНастройки.Вставить("ЭтоТиповойБизнесПроцесс");
		ПропуститьНастройки.Вставить("ИспользоватьТиповыеНастройки");
	КонецЕсли;
	
	Для каждого КлючЗначение Из НастройкиЛево Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеЛево = КлючЗначение.Значение;
		
		Если ПропуститьНастройки.Свойство(ИмяНастройки) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПраво = Неопределено;
		НастройкиПраво.Свойство(ИмяНастройки, ЗначениеПраво);
		
		// Если ЗначениеПраво = Неопределено то считаем, что этого ключа нет
		Если ЗначениеПраво = Неопределено
			ИЛИ ЗначениеЛево = ЗначениеПраво Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗнчЛево = ТипЗнч(ЗначениеЛево);
		ТипЗнчПраво = ТипЗнч(ЗначениеПраво);
		
		Если ТипЗнчЛево <> ТипЗнчПраво Тогда
			РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ЗначениеПраво);
			РезультатСравнения.Изменено = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			
			// Сравниваем массивы полным соединением
			
			// Для возможности сравнивать массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			МассивИзменен = Ложь;
			ИзмененныйМассив = Новый Массив;
			ИндексыПроверенныхЭлементов = Новый Массив;
			
			// Сравниваем типовые настройки с пользовательскими
			Для каждого ЭлементЛево Из ЗначениеЛево Цикл
				
				Если ЭлементЛево.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементЛево);
				
				ЭлементыПраво = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПраво, Отбор, Ложь);
				Если ЭлементыПраво <> Неопределено Тогда
					Для каждого ЭлементПраво Из ЭлементыПраво Цикл
						
						// Новые пользовательские строки обязательно должны быть помечены Типовой = Ложь
						// 	проверка сделана на случай, если в типовых настройках появится новое поле, которое уже есть у пользователя.
						Если ЭлементПраво.Свойство("Типовой") И ЭлементПраво.Типовой = Ложь Тогда
							Продолжить;
						КонецЕсли;
						
						// Индекс правого элемента, которые являются типовыми
						ИндексыПроверенныхЭлементов.Добавить(ЗначениеПраво.Найти(ЭлементПраво));
						
						// Рекурсивное сравнение, т.к могут быть вложения как в с НастройкаЗагрузкиТЧ -> ТабличнаяЧастьДокумента1С
						пРезультатСравнения = ГлЯдро_СравнитьСтруктуруНастроек(ЭлементЛево, ЭлементПраво);
						Если пРезультатСравнения.Изменено Тогда
							
							// Добавляем ключи уникальности, для возможности объединить настройку в будущем
							Для каждого КлючЗначение Из Отбор Цикл
								пРезультатСравнения.ИзмененныеЗначения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
							КонецЦикла;
							
							ИзмененныйМассив.Добавить(пРезультатСравнения.ИзмененныеЗначения);
							МассивИзменен = Истина;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			
			// Вставляем элементы, которые находятся только в ПравоеЗначение (пользовательские настройки)
			Для Индекс = 0 По ЗначениеПраво.ВГраница() Цикл
				
				Если ИндексыПроверенныхЭлементов.Найти(Индекс) <> Неопределено Тогда
					// Элемент является типовым и он уже добавлен в предыдущем цикле
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво = ЗначениеПраво[Индекс];
				
				Если ЭлементПраво.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ИзмененныйМассив.Добавить(ГлЯдро_СкопироватьСтруктуру(ЭлементПраво));
				МассивИзменен = Истина;
				
			КонецЦикла;
			
			Если МассивИзменен Тогда
				РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ИзмененныйМассив);
				РезультатСравнения.Изменено = Истина;
			КонецЕсли;
			
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			
			пРезультатСравнения = ГлЯдро_СравнитьСтруктуруНастроек(ЗначениеЛево, ЗначениеПраво);
			Если пРезультатСравнения.Изменено Тогда
				РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, пРезультатСравнения.ИзмененныеЗначения);
				РезультатСравнения.Изменено = Истина;
			КонецЕсли;
			
		Иначе
			РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ЗначениеПраво);
			РезультатСравнения.Изменено = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатСравнения;
	
КонецФункции 

// Рекурсивно объединяет две структуры настроек и массивы в них.
// Для структур выполняется левая связь, для массивов полное.
// Для массивов структур выполняет слияние по уникальным ключам, добавляя поле Типовой.
// Сделано для объединения типовых и пользовательских значений настроек.
//
// Параметры:
//  НастройкиЛево - Структура - Левая структура для объединения (источник, обычно типовые настройки).
//  НастройкиПраво - Структура - Правая структура для объединения (приоритетный источник, обычно пользовательские настройки).
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//   Структура - Объединенная структура настроек.
//
Функция ГлЯдро_ОбъединитьСтруктуруНастроек(НастройкиЛево, НастройкиПраво, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОбъединеннаяСтруктура = Новый Структура;
	
	Для каждого КлючЗначение Из НастройкиЛево Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеЛево = КлючЗначение.Значение;
		
		ЗначениеПраво = Неопределено;
		НастройкиПраво.Свойство(ИмяНастройки, ЗначениеПраво);
		
		ТипЗнчЛево = ТипЗнч(ЗначениеЛево);
		ТипЗнчПраво = ТипЗнч(ЗначениеПраво);
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			ЗначениеЛево = ГлЯдро_СкопироватьМассив(ЗначениеЛево);
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			ЗначениеЛево = ГлЯдро_СкопироватьСтруктуру(ЗначениеЛево);
		КонецЕсли;
		
		Если ТипЗнчПраво = Тип("Массив") Тогда
			ЗначениеПраво = ГлЯдро_СкопироватьМассив(ЗначениеПраво);
		ИначеЕсли ТипЗнчПраво = Тип("Структура") Тогда
			ЗначениеПраво = ГлЯдро_СкопироватьСтруктуру(ЗначениеПраво);
		КонецЕсли;
		
		Если ЗначениеПраво = Неопределено Тогда
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеЛево);
			Продолжить;
		ИначеЕсли ТипЗнчЛево <> ТипЗнчПраво Тогда
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеПраво);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			
			// Для возможности объединить массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			ИзмененныйМассив = Новый Массив;
			ИндексыПроверенныхЭлементов = Новый Массив;
			
			// Сравнение типовых и пользовательских настроек
			Для каждого ЭлементЛево Из ЗначениеЛево Цикл
				
				Если ЭлементЛево.Свойство("ЭтоТаблицаЗначений") Тогда
					ИзмененныйМассив.Добавить(ЭлементЛево);
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементЛево);
				
				ЕстьТиповоеСовпадение = Ложь;
				ЭлементыПраво = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПраво, Отбор, Ложь);
				Если ЭлементыПраво <> Неопределено И ЭлементыПраво.Количество() > 0 Тогда
					Для каждого ЭлементПраво Из ЭлементыПраво Цикл
						
						// Новые пользовательские строки обязательно должны быть помечены Типовой = Ложь
						// 	проверка сделана на случай, если в типовых настройках появится новое поле, которое уже есть у пользователя.
						Если ЭлементПраво.Свойство("Типовой") И ЭлементПраво.Типовой = Ложь Тогда
							Продолжить;
						КонецЕсли;
						
						ЕстьТиповоеСовпадение = Истина;
						
						// Индекс правого элемента, которые являются типовыми
						ИндексыПроверенныхЭлементов.Добавить(ЗначениеПраво.Найти(ЭлементПраво));
						
						пОбъединеннаяСтруктура = ГлЯдро_ОбъединитьСтруктуруНастроек(ЭлементЛево, ЭлементПраво);
						пОбъединеннаяСтруктура.Вставить("Типовой", Истина);
						ИзмененныйМассив.Добавить(пОбъединеннаяСтруктура);
						
					КонецЦикла;
				КонецЕсли;
				
				// Все совпадения — пользовательские (Типовой=Ложь): типовое поле не было объединено.
				// Добавляем его, чтобы оно отображалось в отключённом состоянии рядом с пользовательским дублём.
				Если НЕ ЕстьТиповоеСовпадение Тогда
					ЭлементЛево.Вставить("Типовой", Истина);
					ИзмененныйМассив.Добавить(ЭлементЛево);
				КонецЕсли;
				
			КонецЦикла;
			
			// Вставляем элементы, которые находятся только в ЗначениеПраво (пользовательские настройки)
			Для Индекс = 0 По ЗначениеПраво.ВГраница() Цикл
				
				Если ИндексыПроверенныхЭлементов.Найти(Индекс) <> Неопределено Тогда
					// Элемент является типовым и он уже добавлен в предыдущем цикле
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво = ЗначениеПраво[Индекс];
				
				Если ЭлементПраво.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				// Это типовое поле, которые было удалено из типовых настроек
				Если НЕ ЭлементПраво.Свойство("Типовой") Тогда
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво.Вставить("Типовой", Ложь);
				ИзмененныйМассив.Добавить(ЭлементПраво);
				
			КонецЦикла;
			
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ИзмененныйМассив);
			
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			
			пОбъединеннаяСтруктура = ГлЯдро_ОбъединитьСтруктуруНастроек(ЗначениеЛево, ЗначениеПраво);
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
			
		Иначе
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеПраво);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъединеннаяСтруктура;
	
КонецФункции

// Метод для удаления дублированных и выключенных полей.
// Приоритет зависит от типа источника и самым последним полям.
Процедура ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей)
		
	ИспользуемыеИменаПолей = Новый Массив;
	УдаляемыеПоля = Новый Массив;
	
	// Группируем по типам источников
	ИндексыРеквизит = Новый Массив;
	ИндексыПроизвольноеЗначение = Новый Массив;
	ИндексыГлобальныйПараметр = Новый Массив;
	ИндексыПроизвольныйКод = Новый Массив;
	
	Для Индекс = 0 По МассивПолей.ВГраница() Цикл
		
		СтрокаПоля = МассивПолей[Индекс];
		
		Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (СтрокаПоля.Свойство("Выгружать") И СтрокаПоля.Выгружать <> Истина)
			ИЛИ (СтрокаПоля.Свойство("Загружать") И СтрокаПоля.Загружать <> Истина) Тогда
			УдаляемыеПоля.Добавить(Индекс);
			Продолжить;
		КонецЕсли;
		
		// Группируем по типам источников. 
		// Так как выгрузка полей происходит не по порядку полей, а по типам источника.
		ТипИсточника = СтрокаПоля.ТипИсточника;
		Если ТипИсточника = "Реквизит1С" ИЛИ ТипИсточника = "РеквизитMS" Тогда
			ИндексыРеквизит.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ПроизвольноеЗначение" Тогда
			ИндексыПроизвольноеЗначение.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ГлобальныйПараметр" Тогда
			ИндексыГлобальныйПараметр.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ПроизвольныйКод" Тогда
			ИндексыПроизвольныйКод.Добавить(Индекс);
			
		Иначе
			ВызватьИсключение "Неизвестный тип источника";
		КонецЕсли;
		
	КонецЦикла;
	
	// Обходим группы индексов в обратном порядке, 
	//	так-как ПК выполняются последними, а значит затирают другие результаты. Поэтому ПК для нас важнее.
	ПорядокОбхода = Новый Массив;
	ПорядокОбхода.Добавить(ИндексыПроизвольныйКод);
	ПорядокОбхода.Добавить(ИндексыГлобальныйПараметр);
	ПорядокОбхода.Добавить(ИндексыПроизвольноеЗначение);
	ПорядокОбхода.Добавить(ИндексыРеквизит);
	
	Для каждого МассивИндексов Из ПорядокОбхода Цикл
		
		// Цикл в обратном порядке для приоритета последним полям при дубле
		Индекс = МассивИндексов.ВГраница();
		Пока Индекс >= 0 Цикл
			
			ИндексПоля = МассивИндексов[Индекс];
			СтрокаПоля = МассивПолей[ИндексПоля];
			
			Если СтрокаПоля.ТипИсточника = "РеквизитMS" И Найти(СтрокаПоля.СинонимИсточника, "Ключ связи для """) > 0 Тогда
				
				// Это поля для связи таблиц, они могут дублироваться
				ИспользуемыеИменаПолей.Добавить(СтрокаПоля.ИмяПриемника);
				
			ИначеЕсли ИспользуемыеИменаПолей.Найти(СтрокаПоля.ИмяПриемника) <> Неопределено Тогда
				
				// Удаляем дубли полей, оставляем только последнюю строку.
				УдаляемыеПоля.Добавить(ИндексПоля);
				
			Иначе
				
				// TODO возможно следует добавить поддержку нескольких ключей уникальности
				// 	 - КлючиУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
				ИспользуемыеИменаПолей.Добавить(СтрокаПоля.ИмяПриемника);
				
			КонецЕсли;
			
			Индекс = Индекс - 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Удаляем поля
	Индекс = МассивПолей.ВГраница();
	Пока Индекс >= 0 Цикл
		ИндексПоля = УдаляемыеПоля.Найти(Индекс);
		Если ИндексПоля <> Неопределено Тогда
			МассивПолей.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры 

Функция ГлЯдро_ДополнитьСтрокуЛидирующимиНулями(Строка, ДоДлины)
	
	ДлинаСтроки = СтрДлина(СокрЛП(Строка));
	
	Для Сч = ДлинаСтроки По ДоДлины - 1 Цикл
	    Строка = "0" + Строка;			
	КонецЦикла; 
	
	Возврат Строка;

КонецФункции

// @logskip
Функция ГлЯдро_ИзвлечьDeflateИзGZIP(ИсходныеДвоичныеДанные, АдресаПеременных)

	Поток = ИсходныеДвоичныеДанные.ОткрытьПотокДляЧтения();
	Поток.Перейти(10, ПозицияВПотоке.Начало);
	
	БуферDeflate = Новый БуферДвоичныхДанных(Поток.Размер() - 10);
	
	Поток.Прочитать(БуферDeflate, 0, Поток.Размер() - 18);	
	Поток.Закрыть();
	
	Возврат БуферDeflate;
	
КонецФункции

Функция ГлЯдро_ПреобразоватьБизнесПроцессыВПользовательские(НастройкиБизнесПроцессов, ДополнительныеПараметры = Неопределено) Экспорт
	
	Типовой = Ложь;
	
	НовыеНастройкиБизнесПроцессов = Новый Массив;
	Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
		
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
			ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов());
			НовыеНастройкиБизнесПроцессов.Добавить(ОписаниеТЧ);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаБП = ГлЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаБП, НастройкаБП);
		
		Если НоваяСтрокаБП.Свойство("ПереопределяемыеНастройки") Тогда
			НоваяСтрокаБП.Удалить("ПереопределяемыеНастройки")
		КонецЕсли;
		
		Если НоваяСтрокаБП.Свойство("ПользовательскаяНастройка") Тогда
			НоваяСтрокаБП.Удалить("ПользовательскаяНастройка")
		КонецЕсли;
		
		НоваяСтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс", Ложь);
		НоваяСтрокаБП.Вставить("ИспользоватьТиповыеНастройки", Ложь);
		
		// Если документ создается на ТСД или выгружается в обработчике, то удаляем настройки выгрузки шапки и ТЧ
		ДоступныНастройкиВыгрузки = ЗначениеЗаполнено(НоваяСтрокаБП.ТипИсходногоДокумента1С) 
										И НЕ НоваяСтрокаБП.ВыполнитьТолькоПроизвольныйКодВыгрузка = Истина;
										
		// Если документ загружается в обработчике, то удаляем настройки загрузки шапки и ТЧ
		ДоступныНастройкиЗагрузки = ЗначениеЗаполнено(НоваяСтрокаБП.ТипРезультирующегоДокумента1С) 
										И НЕ НоваяСтрокаБП.ВыполнитьТолькоПроизвольныйКод = Истина;
		
		// ==============================
		// ===== Настройки выгрузки =====
		
		// Поля шапки выгрузки
		ИмяНастройки = "НастройкаВыгрузкиПолей";
		МассивПолей = Неопределено;
		НоваяСтрокаБП.Свойство(ИмяНастройки, МассивПолей);
		НовыйМассивПолей = Неопределено;
		
		Если ДоступныНастройкиВыгрузки Тогда
			
			НовыйМассивПолей = Новый Массив;
			ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаВыгрузкиПолейШапки());
			НовыйМассивПолей.Добавить(ОписаниеТЧ);
			
			Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				Для каждого СтрокаПоля Из МассивПолей Цикл
					
					Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
					НовоеПоле.Вставить("Типовой", Типовой);
					НовыйМассивПолей.Добавить(НовоеПоле);
					
				КонецЦикла;	
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрокаБП.Вставить(ИмяНастройки, НовыйМассивПолей);
		
		// ТЧ выгрузки
		НастройкиТЧ = Неопределено;
		НоваяСтрокаБП.Свойство("НастройкаВыгрузкиТЧ", НастройкиТЧ);
		НовыеНастройкиТЧ = Неопределено;
		
		Если ДоступныНастройкиВыгрузки Тогда
			
			НовыеНастройкиТЧ = Новый Массив;
			ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаВыгрузкиТЧ());
			НовыеНастройкиТЧ.Добавить(ОписаниеТЧ);
			
			Если ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрокаТаблицы = ГлЯдро_СкопироватьСтруктуру(СтрокаТаблицы);
					НоваяСтрокаТаблицы.Вставить("Типовой", Типовой);
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					НоваяСтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					НовыйМассивПолей = Новый Массив;
