// Централизованная обработка события "ПриСозданииНаСервере" для всех форм.
// Выполняет инициализацию общих параметров, настройку элементов формы
//
// Параметры:
//  ФормаИсточник - УправляемаяФорма - Открываемая форма
//  ДополнительныеПараметры - Структура - Параметры открытия формы
//
Процедура ГлЯдро_ПриСозданииНаСервере(ФормаИсточник, ДополнительныеПараметры = Неопределено) Экспорт
	
	// Добавляем пользовательские подсказки для форм
	ГлЯдро_Подсказки_ДобавитьПодсказкиНаФорму(ФормаИсточник, ДополнительныеПараметры);

КонецПроцедуры

// Создает пустую структуру описания подсказки с инициализацией всех ключей
// Используется для создания описания подсказки в функции ГлЯдро_Подсказки_ДобавитьПодсказкиНаФорму.
//
// Возвращаемое значение:
//  Структура - Пустая структура описания подсказки с ключами:
//    * Имя - Строка - Уникальное имя подсказки (обязательно)
//    * Заголовок - Строка - Заголовок подсказки (обязательно)
//    * Описание - Строка - Текст описания подсказки (обязательно)
//    * РодительскийЭлемент - Строка - Имя родительского элемента (необязательно)
//    * ВставитьПередЭлементом - Строка - Имя элемента, перед которым вставлять подсказку (необязательно)
//
Функция ГлЯдро_Подсказки_СтруктураОписанияПодсказки() Экспорт
	
	СтруктураПодсказки = Новый Структура;
	СтруктураПодсказки.Вставить("Имя", "");
	СтруктураПодсказки.Вставить("Заголовок", "");
	СтруктураПодсказки.Вставить("Описание", "");
	СтруктураПодсказки.Вставить("РодительскийЭлемент", "");
	СтруктураПодсказки.Вставить("ВставитьПередЭлементом", "");
	
	Возврат СтруктураПодсказки;
	
КонецФункции

