									ИначеЕсли СтрокаНастройкиШапки.СпособСопоставления = "Код" Тогда
										ЗначениеПреобразованное = ЗначениеКВыгрузке.Код;
									Иначе // подразумевается "КакЕсть", но всё равно преобразуем в строку
										ЗначениеПреобразованное = Строка(ЗначениеКВыгрузке);									
									КонецЕсли;																	
								Исключение
								КонецПопытки;
								
								DocDescr.SetField(СтрокаНастройкиШапки.ИмяПриемника,ЗначениеПреобразованное);								
							КонецЦикла;
						КонецЕсли;
						
						Если НастройкаБП.ЗаменитьПредставлениеДокументаПриВыгрузке 
							И НастройкаБП.ШаблонИмени <> "" Тогда											
							DocDescr.SetField("ПредставлениеИмениДокумента", НастройкаБП.ШаблонИмени);	
						КонецЕсли;
						
					КонецЕсли;
					Попытка					
						DocDescr.SetField("ИмяБП", Строка(СтрокаДок.ИмяБП));									
					Исключение
					КонецПопытки;				
					Попытка					
						DocDescr.SetField("ИмяКонтрагента", Строка(СтрокаДок.ИмяКонтрагента));					
					Исключение
					КонецПопытки;				
					Попытка					
						DocDescr.SetField("ИмяСклада", Строка(СтрокаДок.ИмяСклада));					
					Исключение
					КонецПопытки;				
					Попытка					
						DocDescr.SetField("ИмяСкладаКуда", Строка(СтрокаДок.ИмяСкладаКуда));					
					Исключение
					КонецПопытки;				
					DocDescrs.Add(DocDescr);
				КонецЦикла;
				пСообщение = НСтр("ru = 'Постобработка списка документов закончена, кладем в XML: %1, Тип документа: %2, Ид пользователя: %3';
									|en = 'The post-processing of the document list is completed, we put it in XML: %1, Document type: %2, User ID: %3';
									|be = 'Постобработка спісу дакументаў скончана, кладзем у XML: %1, Тып дакумента: %2, Вд карыстальніка: %3'; es = 'El procesamiento posterior de la lista de documentos ha terminado, lo ponemos en XML: %1, tipo de documento: %2, Id de usuario: %3'; ka = 'დოკუმენტების სიის შემდგომი დამუშავება დასრულებულია, ჩვენ მას xml-ში ვდებთ: %1, დოკუმენტის ტიპი: %2, მომხმარებლის ID: %3'; kk = 'Құжаттар тізімін кейінгі өңдеу аяқталды, XML-ге салыңыз: %1, құжат түрі: %2, пайдаланушы идентификаторы: %3'; ro = 'Post-procesarea listei de documente este finalizată, o punem în XML: %1, Tip Document: %2, ID Utilizator: %3'; tr = 'Belge listesinin son işlenmesi bitti, xml''e koyduk: % 1, Belge türü:% 2, Kullanıcı kimliği:%3'; uk = 'Постобробка списку документів закінчена, кладемо в XML: %1, Тип документа: %2, ВД користувача: %3'; uz = 'Hujjatlar ro''yxatini qayta ishlash tugallandi, XML-ga qo''ying: %1, hujjat turi: %2, foydalanuvchi identifikatori: %3'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ОтобранныеДокументы), Строка(ТипДокумента), Строка(UserId));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
				СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);
				СписокДокументов = СтруктураПодключенияБазыMS.StorageConnector.СохранитьОбъектВ_XML(DocDescrs);
				Результат = СписокДокументов;
				пСообщение = НСтр("ru = 'Сохранили в XML, получили список документов на отправку, Тип документа: %1, Ид пользователя: %2';
									|en = 'Saved in XML, received a list of documents to send, Document type: %1, User ID: %2';
									|be = 'Захавалі ў XML, атрымалі спіс дакументаў на адпраўку, тып дакумента: %1, Ід карыстальніка: %2'; es = 'Guardado en XML, lista de documentos para enviar, tipo de documento: %1, Id de usuario: %2'; ka = 'შენახული XML, მიიღო დოკუმენტების ჩამონათვალი გაგზავნის, დოკუმენტის ტიპი: %1, მომხმარებლის ID: %2'; kk = 'XML-де сақталды, жіберілетін құжаттардың тізімін алды, құжат түрі: %1, пайдаланушының идентификаторы: %2'; ro = 'Salvat în XML, a primit o listă de documente de trimis, Tip Document: %1, ID Utilizator: %2'; tr = 'Xml''e kaydettiler, gönderilecek belgelerin bir listesini aldık, Belge türü:% 1, Kullanıcı Kimliği:% 2'; uk = 'Зберегли в XML, отримали список документів на відправку, Тип документа: %1, ВД користувача: %2'; uz = 'XML-da saqlangan, yuborish uchun hujjatlar ro''yxati, hujjat turi: %1, foydalanuvchi identifikatori: %2'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ТипДокумента), Строка(UserId));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
				#КонецОбласти //НесовместимыйКодFresh
			КонецЕсли;
		Иначе
			пСообщение = НСтр("ru = 'Нет документов учавствующих в отборе для типа документа: %1, Ид пользователя: %2';
								|en = 'There are no documents participating in the selection for the document type: %1, User ID: %2';
								|be = 'Няма дакументаў учавствующих ў адборы для тыпу дакумента: %1, ВД карыстальніка: %2'; es = 'No hay documentos seleccionados para el tipo de documento: %1, Id de usuario: %2'; ka = 'დოკუმენტის ტიპის შერჩევაში მონაწილე დოკუმენტები არ არის: %1, მომხმარებლის ID: %2'; kk = 'Құжат түрі үшін іріктеуге қатысатын құжаттар жоқ: %1, пайдаланушының идентификаторы: %2'; ro = 'Nu există documente care să participe la selecție pentru tipul de document: %1, ID Utilizator: %2'; tr = 'Belge türü için seçime katılan belge yok: %1, Kullanıcı kimliği: %2'; uk = 'Немає документів учавствующих у відборі для типу документа: %1, ВД користувача: %2'; uz = 'Hujjat turini tanlashda ishtirok etadigan hujjatlar yo''q: %1, foydalanuvchi identifikatori: %2'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ТипДокумента), Строка(UserId));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			ЛогЗакрытьПоток(логПоток, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибка);
		
		ЯзСтрока = "ru = 'Ошибка при получении списка документов. Тип документа: %1, Ид пользователя: %2'";
		
		прТипДокумента 	= Строка(ТипДокумента);
		прUserId 		= Строка(UserId);
		пСообщение 		= ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прТипДокумента, прUserId);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ТекстОшибки,ТипДокумента,UserId",
			ТекстОшибки, прТипДокумента, прUserId);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
		Результат = НСтр("ru = '#Ошибка при получения списка документов: %1';
							|en = '#Error when receiving the list of documents: %1'; be = '# Памылка пры атрыманні спісу дакументаў: %1'; es = '#Error al obtener la lista de documentos: %1'; ka = '# შეცდომა დოკუმენტების ჩამონათვალის მიღებისას: %1'; kk = '# Құжаттар тізімін алу кезінде қате: %1'; ro = '# Eroare la primirea listei de documente: %1'; tr = '#Belge listesini alırken hata oluştu: %1'; uk = '# Помилка при отримання списку документів: %1'; uz = '# Hujjatlar ro''yxatini olishda xato: %1'");
		Результат = ГлЯдро_СтрШаблон(Результат, ТекстОшибки);
	КонецПопытки;
	
	пСообщение = НСтр("ru = 'Конец, Тип документа: %1, Ид пользователя: %2';
						|en = 'End, Document type: %1, User ID: %2'; be = 'Канец, тып дакумента: %1, Ід карыстальніка: %2'; es = 'Final, tipo de documento: %1, Id de usuario: %2'; ka = 'დასასრული, დოკუმენტის ტიპი: %1, მომხმარებლის ID: %2'; kk = 'Соңы, құжат түрі: %1, пайдаланушы идентификаторы: %2'; ro = 'Sfârșit, Tip Document: %1, ID Utilizator: %2'; tr = 'Son, Belge türü: %1, Kullanıcı Kimliği: %2'; uk = 'Кінець, тип документа: %1, Ідентифікатор користувача: %2'; uz = 'Tugatish, hujjat turi: %1, foydalanuvchi ID: %2'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ТипДокумента), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат; 
		
КонецФункции

// Обрабатывает запрос сервера Клеверенс на получение документа
//
// Параметры:
//	userId - Строка - идентификатор пользователя Клеверенс		
//  КодДокумента - Строка - идентификатор документа
//  ОперацияТСД - Строка - тип документа Клеверенс
//	Режим - Число - режим получения документа
//  mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//
// Возвращаемое значение:
//	    - Строка - данные документа в формате XML, если тип интерфейса - COM
//      - Строка - данные документа в формате JSON, если тип интерфейса - REST_API
//		- Строка - текст ошибки получения документа
//		- Неопределено - если не удалось установить соединение с базой Клеверенс
Функция ПолучитьДокумент(UserId, КодДокумента, ОперацияТСД, Режим, mXmlDoc = Неопределено) Экспорт
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ПолучитьДокумент";
	логПоток = Неопределено;
	логСобытие = Неопределено;
	
	// Сделаем проверку на служебный УИД - пользователь пытается получить весь список документов, но технически пока невозможно
	Если КодДокумента = "11111111-2222-3333-4444-555555555555" Тогда	
		пСообщение = НСтр("ru = '#1CEDWR001. Документов для отображения слишком много, настройте отборы документов в основной обработке Клеверенс для данного типа документа Клеверенс или выполните поиск по штрихкоду или коду документа.';
							|en = '#1CEDWR001. There are too many documents to display, set up document selections in the main Cleverence processing for this type of Cleverence document or search by barcode or document code.';
							|be = '#1CEDWR001. Дакументаў для адлюстравання занадта шмат, Наладзьце адборы дакументаў у асноўнай апрацоўцы Cleverence для дадзенага тыпу дакумента Cleverence або выканайце пошук па штрыхкодаў або коду дакумента.'; es = '#1CEDWR001. Hay demasiados documentos para Mostrar, configure selecciones de documentos en el procesamiento principal de Cleverence para este tipo de documento de Cleverence o busque por código de barras o código de documento.'; ka = '#1cedwr001. არსებობს ძალიან ბევრი დოკუმენტები არიან, შეიქმნა დოკუმენტი selections ძირითადი Cleverence დამუშავება ამ ტიპის Cleverence დოკუმენტი ან ძიება შტრიხკოდების ან დოკუმენტის კოდი.'; kk = '#1CEDWR001. Көрсетілетін құжаттар тым көп, Cleverence құжатының осы түрі үшін Cleverence негізгі өңдеуінде құжаттарды таңдауды реттеңіз немесе штрих-код немесе құжат коды бойынша іздеңіз.'; ro = '#1CEDWR001. Există prea multe documente pentru a fi afișate, pentru a configura selecții de documente în procesarea principală Cleverence pentru acest tip de document Cleverence sau pentru a căuta după codul de bare sau codul documentului.'; tr = '#1CEDWR001. Görüntülenecek çok fazla belge var, bu tür bir Cleverence belgesi için Cleverence''ın ana işlemesinde belge seçimlerini yapılandırın veya belgenin barkoduna veya koduna göre arama yapın.'; uk = '#1CEDWR001. Документів для відображення занадто багато, налаштуйте добори документів в основній обробці Cleverence для даного типу документа Cleverence або виконайте пошук по штрихкоду або коду документа.'; uz = '#1CEDWR001. Ko''rsatish uchun juda ko''p hujjatlar mavjud, ma''lum bir turdagi hujjatlar uchun asosiy ishlov berishda hujjatlarni tanlashni sozlang yoki shtrix-kod yoki hujjat kodini qidiring.'");
		Возврат пСообщение;
	КонецЕсли;
	
	Попытка
		
		АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		
		// <Лог>
		логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
		
		SessionSMARTS = REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса);
		Если SessionSMARTS = Неопределено Тогда
			SessionSMARTS = mXmlDoc;
		КонецЕсли;
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"UserId,КодДокумента,ОперацияТСД,Режим,mXmlDoc",
			UserId, КодДокумента, ОперацияТСД, Режим, SessionSMARTS);
			
		логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
		// </Лог>
		
		пСообщение = НСтр("ru = 'Начало, Тип документа: %1, Режим: %2, Код документа: %3, Ид пользователя: %4';
							|en = 'Start, Document type: %1, Mode: %2, Document Code: %3, User ID: %4';
							|be = 'Пачатак, тып дакумента: %1, Рэжым: %2, Код дакумента: %3, Ід карыстальніка: %4'; es = 'Inicio, tipo de documento: %1, Modo: %2, código de documento: %3, Id de usuario: %4'; ka = 'დაწყება, დოკუმენტის ტიპი: %1, რეჟიმი: %2, დოკუმენტის კოდი: %3, მომხმარებლის ID: %4'; kk = 'Басталуы, құжат түрі: %1, режимі: % 2, құжат коды: %3, Пайдаланушы идентификаторы: %4'; ro = 'Start, Tip Document: %1, Mod: %2, Cod Document: %3, ID Utilizator: %4'; tr = 'Başlangıç, Belge Türü: %1, Mod: %2, Belge Kodu: %3, Kullanıcı Kimliği: %4'; uk = 'Початок, тип документа: %1, Режим: %2, Код документа: %3, Ідентифікатор користувача: %4'; uz = 'Boshlash, hujjat turi: %1, tartib: % 2, hujjat kodi: %3, foydalanuvchi identifikatori: %4'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ОперацияТСД), Строка(Режим), Строка(КодДокумента), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		Инит = ГлЯдро_ИнициализацияВнешнегоВызова(ИмяСобытия, mXmlDoc,, АдресаПеременных);
				
		Если НЕ Инит.Успех Тогда
			
			Если Инит.ОшибкаСоединения И НЕ ЗначениеЗаполнено(Инит.ТекстОшибки) Тогда
				Результат = Неопределено;
			Иначе
				Результат = "#" + Инит.ТекстОшибки;
			КонецЕсли;
			
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка инициализации: %1, Режим: %2, Ид пользователя: %3'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), Результат, Строка(Режим), Строка(UserId));
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"UserId,Режим",
				UserId, Режим);
				
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, Результат,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			ЛогЗакрытьПоток(логПоток, АдресаПеременных);
			// </Лог>
			
			Возврат Результат;
			
		КонецЕсли;
		
		Результат = Неопределено;
		
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);
		пСообщение = НСтр("ru = 'Перед Обработкой получения документа, Тип документа: %1, Режим: %2, Код документа: %3, Ид пользователя: %4';
							|en = 'Before Processing the receipt of the document, Document type: %1, Mode: %2, Document Code: %3, User ID: %4';
							|be = 'Перад апрацоўкай атрымання дакумента, тып дакумента: %1, Рэжым: % 2, Код дакумента: %3, Ід карыстальніка: %4'; es = 'Antes de Procesar la Recepción del documento, tipo de documento: %1, Modo: %2, código de documento: %3, Id de usuario: %4'; ka = 'დოკუმენტის მიღების დამუშავებამდე დოკუმენტის ტიპი: %1, რეჟიმი: %2, დოკუმენტის კოდი: %3, მომხმარებლის ID: %4'; kk = 'Құжатты алғанға дейін, құжат түрі: %1, режимі: % 2, құжат коды: %3, Пайдаланушы идентификаторы: %4'; ro = 'Înainte de a procesa primirea documentului, tipul documentului: %1, Modul: %2, Codul documentului: %3, ID Utilizator: %4'; tr = 'Belgenin alınmasını işlemeden önce Belge türü: %1, Mod: %2, Belge kodu: %3, Kullanıcı Kimliği: %4'; uk = 'Перед обробкою отримання документа, Тип документа: %1, Режим: %2, Код документа: %3, ВД користувача: %4'; uz = 'Hujjatni qabul qilishdan oldin, hujjat turi: %1, rejim: %2, hujjat kodi: %3, foydalanuvchi identifikatori: %4'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ОперацияТСД), Строка(Режим), Строка(КодДокумента), Строка(UserId));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		Если Режим = 0 Тогда
			
			ИспJSON_mXmlDoc = КомЯдро_ПолучитьЗначениеПеременной("ИспJSON_mXmlDoc",АдресаПеременных);
			
			Если ИспJSON_mXmlDoc = Истина
				ИЛИ (ИспJSON_mXmlDoc = Неопределено И ТипИнтерфейса = "REST_API") Тогда
				SessionSMARTS = ГлЯдро_ЗагрузитьИзJSON(mXmlDoc);
				camelCase = Ложь;	
				Если SessionSMARTS.Получить("deviceInfo") <> Неопределено Тогда
					camelCase = Истина;
				КонецЕсли;
				ДокИнфо 					= SessionSMARTS[?(camelCase,"deviceInfo","DeviceInfo")][?(camelCase,"document","Document")];
				МетаданныеДокументаMS 		= ГлЯдро_МетаданныеДокументаПоТипуДокумента(ДокИнфо["DocumentTypeName"], АдресаПеременных);
				UniНастройкаБизнесПроцесса	= МетаданныеДокументаMS.СоответствиеРеквизитовИмена.НастройкаБизнесПроцесса;
				ID_БизнесПроцесса 			= ДокИнфо[UniНастройкаБизнесПроцесса];
			Иначе
				SessionSMARTS 				= СтруктураПодключенияБазыMS.StorageConnector.ЗагрузитьОбъектИз_XML(mXmlDoc);
				ДокИнфо 					= SessionSMARTS.DeviceInfo.Document;
				МетаданныеДокументаMS 		= ГлЯдро_МетаданныеДокументаПоТипуДокумента(ДокИнфо.ПолучитьПоле("DocumentTypeName"), АдресаПеременных);
				UniНастройкаБизнесПроцесса	= МетаданныеДокументаMS.СоответствиеРеквизитовИмена.НастройкаБизнесПроцесса;
				ID_БизнесПроцесса 			= ДокИнфо.ПолучитьПоле(UniНастройкаБизнесПроцесса);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ID_БизнесПроцесса) Тогда
				ТекстОшибки = НСтр("ru = 'Не выбран бизнес-процесс! Проверьте, выгружены ли бизнес-процессы на ТСД.'");
				
				пСообщение = НСтр("ru = '%1 Тип документа: %2, Режим: %3, Код документа: %4, Ид пользователя: %5'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение,
					ТекстОшибки, Строка(ОперацияТСД), Строка(Режим), Строка(КодДокумента), Строка(UserId));
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", "#" + ТекстОшибки);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				ЛогЗакрытьПоток(логПоток, АдресаПеременных);
				// </Лог>
				
				Возврат "#" + ТекстОшибки;
			КонецЕсли;
			
			Результат = ГлЯдро_ПолучитьДокумент1СДляВыгрузкиОнлайн(UserId, КодДокумента, ОперацияТСД, ID_БизнесПроцесса, ТипИнтерфейса, АдресаПеременных);
			
		ИначеЕсли Режим = 1 Тогда
			
			Результат = ГлЯдро_ПолучитьДокументПоШтрихкоду(UserId, КодДокумента, ОперацияТСД, mXmlDoc, ИмяСобытия, ТипИнтерфейса, АдресаПеременных);		
			
		Иначе
			
			ТекстОшибки = НСтр("ru = 'Задан неверный режим получения документа: '") + Режим;
				
			пСообщение = НСтр("ru = '%1. Тип документа: %2, Режим: %3, Код документа: %4, Ид пользователя: %5'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение,
				ТекстОшибки, Строка(ОперацияТСД), Строка(Режим), Строка(КодДокумента), Строка(UserId));
			
			Результат =  "#" + ТекстОшибки;
			
		КонецЕсли;
		
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибка);
		
		ЯзСтрока = "ru = 'Ошибка при получении документа, Тип документа: %1, Режим: %2, Код документа: %3, Ид пользователя: %4';
							|en = 'Error: %1, Document type: %2, Mode: %3, Document Code: %4, User ID: %5';
							|be = 'Памылка: %1, тып дакумента: % 2, Рэжым: %3, код дакумента: %4, Ід карыстальніка: %5'; es = 'Error: %1, tipo de documento: % 2, Modo: %3, código de documento: %4, Id de usuario: %5'; ka = 'შეცდომა: %1, დოკუმენტის ტიპი: %2, რეჟიმი: %3, დოკუმენტის კოდი: %4, მომხმარებლის ID: %5'; kk = 'Қате: %1, құжат түрі: %2, Режим: %3, құжат коды: %4, пайдаланушы идентификаторы: %5'; ro = 'Eroare: %1, Tip Document: %2, MOD: %3, Cod Document: %4, id utilizator: %5'; tr = 'Hata: %1, Belge Türü: %2, Mod: %3, Belge Kodu: %4, Kullanıcı Kimliği: %5'; uk = 'Помилка: %1, тип документа: %2, Режим: %3, Код документа: %4, ідентифікатор користувача: %5'; uz = 'Xato: %1, hujjat turi: %2, rejim: %3, hujjat kodi: %4, foydalanuvchi identifikatori: %5'";
		прОперацияТСД 	= Строка(ОперацияТСД);
		прРежим 		= Строка(Режим);
		прКодДокумента 	= Строка(КодДокумента);
		прUserId 		= Строка(UserId);
		пСообщение 		= ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прОперацияТСД, прРежим, прКодДокумента, прUserId);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ТекстОшибки,ОперацияТСД,Режим,КодДокумента,UserId",
			ТекстОшибки, прОперацияТСД, прРежим, прКодДокумента, прUserId);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
		Результат = "#Ошибка при получения документа: " + ТекстОшибки;		
	КонецПопытки;
	пСообщение = НСтр("ru = 'Конец, Тип документа: %1, Режим: %2, Код документа: %3, Ид пользователя: %4';
						|en = 'End, Document Type: %1, Mode: %2, Document Code: %3, User ID: %4';
						|be = 'Канец, тып дакумента: %1, Рэжым: %2, код дакумента: %3, Ід карыстальніка: %4'; es = 'Final, tipo de documento: %1, Modo: %2, código de documento: %3, Id de usuario: %4'; ka = 'დასასრული, დოკუმენტის ტიპი: %1, რეჟიმი: %2, დოკუმენტის კოდი: %3, მომხმარებლის ID: %4'; kk = 'Соңы, құжат түрі: %1, режимі: % 2, құжат коды: %3, Пайдаланушы идентификаторы: %4'; ro = 'Sfârșit, Tip Document: %1, Mod: %2, Cod Document: %3, ID Utilizator: %4'; tr = 'Son, Belge Türü: %1, Mod: %2, Belge Kodu: %3, Kullanıcı Kimliği: %4'; uk = 'Кінець, тип документа: %1, Режим: %2, Код документа: %3, Ідентифікатор користувача: %4'; uz = 'Tugatish, hujjat turi: %1, rejim: %2, hujjat kodi: %3, foydalanuvchi identifikatori: %4'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ОперацияТСД), Строка(Режим), Строка(КодДокумента), Строка(UserId));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Обрабатывает событие сервера Клеверенс о завершении документа
//
// Параметры:
//	ID_Документа - Строка - идентификатор документа
//  mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//
// Возвращаемое значение:
//	- Булево - флаг успешности формирования, записи и проведения документа в базе 1С и удаления документа в базе Клеверенс
//	- Неопределено - если не удалось установить соединение с базой Клеверенс
Функция ДокументЗавершен(ID_Документа, mXmlDoc) Экспорт
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяСобытия = "ДокументЗавершен";
	логПоток = Неопределено;
	логСобытие = Неопределено;
	
	Попытка
		
		АдресаПеременных = КомЯдро_СоздатьСтруктуруАдресаПеременных(mXmlDoc);
		ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса", ТипИнтерфейса, АдресаПеременных);
		
		// <Лог>
		логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
		
		SessionSMARTS = REST_API_РазобратьMXmlDoc(mXmlDoc, ТипИнтерфейса);
		Если SessionSMARTS = Неопределено Тогда
			SessionSMARTS = mXmlDoc;
		КонецЕсли;
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ID_Документа,mXmlDoc",
			ID_Документа, SessionSMARTS);
			
		логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
		// </Лог>
		
		пСообщение = НСтр("ru = 'Начало, Документ: %1';
							|en = 'Start, Document: %1'; be = 'Пачатак, Дакумент: %1'; es = 'Inicio, Documento: %1'; ka = 'დაწყება, დოკუმენტი: %1'; kk = 'Басталуы, Құжат: %1'; ro = 'Început, Document: %1'; tr = 'Başlangıç, Belge: %1'; uk = 'Початок, Документ: %1'; uz = 'Boshlanish, Hujjat: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		Инит = ГлЯдро_ИнициализацияВнешнегоВызова(ИмяСобытия, mXmlDoc,, АдресаПеременных);
		
		Если НЕ Инит.Успех Тогда
			
			// <Лог>
			ЯзСтрока = "ru = 'Подключится к серверу Клеверенс не удалось, Документ: %1';
								|en = 'Failed to connect to the Cleverence server, Document: %1';
								|be = 'Падключыцца да сервера Cleverence не ўдалося, Дакумент: %1'; es = 'Se conectará al servidor Cleverence falló, Documento: %1'; ka = 'ვერ მოხერხდა Cleverence სერვერთან დაკავშირება, დოკუმენტი: %1'; kk = 'Cleverence серверіне қосылу сәтсіз аяқталды, құжат: %1'; ro = 'Nu s-a reușit conectarea la serverul Cleverence, Document: %1'; tr = 'Cleverence sunucusuna bağlanılamadı, Belge: %1'; uk = 'Підключиться до сервера Cleverence не вдалося, Документ: %1'; uz = 'Men Cleverence serveriga ulana olmadim, hujjat: %1'";
			прID_Документа = Строка(ID_Документа);
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прID_Документа);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ID_Документа",
				прID_Документа);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			ЛогЗакрытьПоток(логПоток, АдресаПеременных);
			// </Лог>
			
			Возврат Ложь;
			
		КонецЕсли;
		
		СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной("COMБазыMS",АдресаПеременных);
		СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных",АдресаПеременных);
		
		СтатусДокумента = "";
		НастройкаБизнесПроцесса = "";
		Если ТипИнтерфейса = "REST_API" Тогда
			СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS",АдресаПеременных);
			
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 		  "GET");
			СтруктураЗапроса.Вставить("Метод", 			  "Docs('" + ID_Документа + "')");
			СтруктураЗапроса.Вставить("ВернутьСтруктуру", Истина);
			СтруктураЗапроса.Вставить("ТипЗапроса", 	  "ПолучениеШапкиДокумента");
			
			СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
			Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				ЛогЗакрытьПоток(логПоток, АдресаПеременных);
				// </Лог>
				Возврат Неопределено;
			КонецЕсли;
			
			ДокументSMARTS = СтруктураОтвета.ОтветСервера;
			Если ТипЗнч(ДокументSMARTS) = Тип("Структура") Тогда
				Если ДокументSMARTS.Свойство("Status") Тогда
					СтатусДокумента = ДокументSMARTS.Status;
				КонецЕсли;
				
				ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
				
				ИмяПоляБП = ?(ЯзыкПлатформыMS = "EN",
					"businessProcessId", "nastrojkaBiznesProcessa");
				Если ДокументSMARTS.Свойство(ИмяПоляБП) Тогда
					НастройкаБизнесПроцесса = ДокументSMARTS[ИмяПоляБП];
				КонецЕсли;
			КонецЕсли;
			
			ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ДокументSMARTS.documentTypeName);
			ИмяДокумента = ДокументSMARTS.name;
			
			СтруктураДокумента = СтруктураМетаданных.ДокументыMS[ИмяТипаДокумента];
			
			Если СтатусДокумента = "Отменен"
				ИЛИ СтатусДокумента = "Cancelled" Тогда
				// Если документ к удалению - удаляем
				РезультатЗаписи = ГлЯдро_УдалитьДокументНаСервереSMARTS(ID_Документа, "Основная", Новый Структура("ИмяДокумента", ИмяДокумента), АдресаПеременных);
				
				ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов",, АдресаПеременных);
				ВыводитьСообщение =
					ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ВсяИнформация" 
						ИЛИ (РезультатЗаписи.Статус = Ложь И (ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = Ложь ИЛИ ПустаяСтрока(ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов) ИЛИ ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ТолькоОшибки"));
				Если ВыводитьСообщение Тогда
					СообщениеНаСТД = Новый Структура("text,sender,appointment", РезультатЗаписи.Сообщение, "", ДокументSMARTS.userId);
					
					REST_API_ВыполнитьМетод(СтруктураПодключенияMS,
						Новый Структура("HTTPМетод, Метод", "POST", "Messages"), СообщениеНаСТД, АдресаПеременных);
				КонецЕсли;
					
				пСообщение = НСтр("ru = 'Удаление документа из Клеверенс, Документ: %1';
									|en = 'Deleting a document from Cleverence, Document: %1'; be = 'Выдаленне дакумента з Cleverence, Дакумент: %1'; es = 'Eliminación de un documento de Cleverence, Documento: %1'; ka = 'დოკუმენტის წაშლა Cleverence-დან, დოკუმენტი: %1'; kk = 'Cleverence-тен құжатты жою, құжат: %1'; ro = 'Ștergerea unui document din Cleverence, Document: %1'; tr = 'Cleverence''den bir belgeyi silme, Belge: %1'; uk = 'Видалення документа з Cleverence, Документ: %1'; uz = 'Hujjatni Cleverence-dan olib tashlash, hujjat: %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗаписи.Статус);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				ЛогЗакрытьПоток(логПоток, АдресаПеременных);
				// </Лог>
				
				Возврат РезультатЗаписи.Статус;
			КонецЕсли;

		Иначе
			ДокументSMARTS = СтруктураПодключенияБазыMS.StorageConnector.ПолучитьДокумент(ID_Документа);
			ИмяТипаДокумента = ГлЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ДокументSMARTS.documentTypeName);
			СтруктураДокумента = СтруктураМетаданных.ДокументыMS[ИмяТипаДокумента];			
			ИмяТипаДокумента = ДокументSMARTS.ИмяТипаДокумента;
			ИмяДокумента = ДокументSMARTS.Имя;
			Попытка 
				СтатусДокумента = ДокументSMARTS.ПолучитьПоле("Статус");
			Исключение
			КонецПопытки;
			Попытка 
				НастройкаБизнесПроцесса = ДокументSMARTS.ПолучитьПоле("НастройкаБизнесПроцесса");
			Исключение
			КонецПопытки;
			Если СтатусДокумента = "Отменен"
				ИЛИ СтатусДокумента = "Cancelled" Тогда
				// Если документ к удалению - удаляем
				РезультатЗаписи = ГлЯдро_УдалитьДокументНаСервереSMARTS(ID_Документа, "Основная", Новый Структура("ИмяДокумента", ИмяДокумента), АдресаПеременных);
				
				ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов",, АдресаПеременных);
				ВыводитьСообщение =
					ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ВсяИнформация" 
						ИЛИ (РезультатЗаписи.Статус = Ложь И (ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = Ложь ИЛИ ПустаяСтрока(ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов) ИЛИ ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ТолькоОшибки"));
				Если ВыводитьСообщение Тогда
					СтруктураПодключенияБазыMS.StorageConnector.ОтправитьСообщение(РезультатЗаписи.Сообщение, "", ДокументSMARTS.ИдПользователя);
				КонецЕсли;
					
				пСообщение = НСтр("ru = 'Удаление документа из Клеверенс, Документ: %1';
									|en = 'Deleting a document from Cleverence, Document: %1'; be = 'Выдаленне дакумента з Cleverence, Дакумент: %1'; es = 'Eliminación de un documento de Cleverence, Documento: %1'; ka = 'დოკუმენტის წაშლა Cleverence-დან, დოკუმენტი: %1'; kk = 'Cleverence-тен құжатты жою, құжат: %1'; ro = 'Ștergerea unui document din Cleverence, Document: %1'; tr = 'Cleverence''den bir belgeyi silme, Belge: %1'; uk = 'Видалення документа з Cleverence, Документ: %1'; uz = 'Hujjatni Cleverence-dan olib tashlash, hujjat: %1'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатЗаписи.Статус);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				ЛогЗакрытьПоток(логПоток, АдресаПеременных);
				// </Лог>
				
				Возврат РезультатЗаписи.Статус;
			КонецЕсли;	
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Перед записью документа в 1С, Документ: %1';
							|en = 'Before writing the document to 1C, Document: %1'; be = 'Перад запісам дакумента ў 1С, Дакумент: %1'; es = 'Antes de escribir el documento en 1C, el Documento: %1'; ka = 'დოკუმენტის 1c-ზე დაწერამდე დოკუმენტი: %1'; kk = 'Құжатты 1С-қа жазар алдында, құжат: %1'; ro = 'Înainte de a scrie documentul la 1C, Document: %1'; tr = 'Belgeyi 1c''ye yazmadan önce, Belge: %1'; uk = 'Перед записом документа в 1С, Документ: %1'; uz = 'Hujjatni 1C ga yozishdan oldin, hujjat: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		РезультатЗаписи = ГлЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID(ID_Документа, СтруктураДокумента, НастройкаБизнесПроцесса,, "Основная", , , Истина,,Ложь,АдресаПеременных);		
		ПользовательТСД = РезультатЗаписи.Дополнение;
		пСообщение = НСтр("ru = 'После записи документа и перед отправкой сообщения на ТСД, Статус: %1, Документ: %2';
							|en = 'After recording the document and before sending the message to the Mobile device, Status: %1, Document: %2';
							|be = 'Пасля запісу дакумента і перад адпраўкай паведамлення на Мабільнае прылада, Статус: %1, Дакумент: %2'; es = 'Después de grabar el documento y antes de enviar el mensaje al dispositivo Móvil, Estado: %1, Documento: %2'; ka = 'დოკუმენტის ჩაწერის შემდეგ და მობილურ მოწყობილობაზე შეტყობინების გაგზავნამდე, სტატუსი: %1, დოკუმენტი: %2'; kk = 'Құжат жазылғаннан кейін және хабарламаны мобильді құрылғыға жібермес бұрын, мәртебесі: %1, құжат: %2'; ro = 'După înregistrarea documentului și înainte de a trimite mesajul către dispozitivul mobil, stare: %1, Document: %2'; tr = 'Belgeyi kaydettikten sonra ve Mobil cihaza mesaj göndermeden önce Durum: %1, Belge: %2'; uk = 'Після запису документа і перед відправкою повідомлення на мобільний пристрій, Статус: %1, Документ: %2'; uz = 'Hujjat yozilgandan so''ng va xabarni mobil qurilmaga yuborishdan oldin, holati: %1, hujjat: %2'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(РезультатЗаписи.Статус), Строка(ID_Документа));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
		
		// Возвращаем сообщения на ТСД
		ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов",,АдресаПеременных);
		Если ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ВсяИнформация" 
			или (РезультатЗаписи.Статус = Ложь и (ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = Ложь или ПустаяСтрока(ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов) или ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ТолькоОшибки")) 
		Тогда
			Если ТипИнтерфейса = "REST_API" Тогда
				СообщениеНаСТД = Новый Структура("text,sender,appointment",РезультатЗаписи.Сообщение,"",ПользовательТСД);
				REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод","POST","Messages"),СообщениеНаСТД,АдресаПеременных); 
			Иначе			
				СтруктураПодключенияБазыMS.StorageConnector.ОтправитьСообщение(РезультатЗаписи.Сообщение, "", ПользовательТСД); 
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатЗаписи.Статус = Истина Тогда
			НеУдалятьДокументПослеЗавершения = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НеУдалятьДокументПослеЗавершения",, АдресаПеременных);
			Если НеУдалятьДокументПослеЗавершения <> Истина Тогда
				Результат = ГлЯдро_УдалитьДокументНаСервереSMARTS(ID_Документа, "Основная", Новый Структура("ИмяДокумента", ИмяДокумента), АдресаПеременных);
			КонецЕсли;
		Иначе
			Результат = ГлЯдро_УстановитьСтатусДокументаНаСервереSMARTS(ID_Документа, "Основная", "ОшибкаЗаписи", АдресаПеременных);
		КонецЕсли;
		
		Результат = РезультатЗаписи.Статус;
		
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Ошибка при завершении документа. Документ: %1'";
		
		прID_Документа = Строка(ID_Документа);
		пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), прID_Документа);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ID_Документа",
			прID_Документа);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
		Результат = Неопределено;
	КонецПопытки;
	
	пСообщение = НСтр("ru = 'Конец, Документ: %1';
						|en = 'End, Document: %1'; be = 'Канец, Дакумент: %1'; es = 'Fin, Documento: %1'; ka = 'დასასრული, დოკუმენტი: %1'; kk = 'Соңы, Құжат: %1'; ro = 'Sfârșit, Document: %1'; tr = 'Son, Belge: %1'; uk = 'Кінець, Документ: %1'; uz = 'Tugatish, Hujjat: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,НачалоСобытия,АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Обрабатывает запрос сервера Клеверенс на получение номенклатуры по части наименования
//
// Параметры:
//	ПараметрНоменклатуры - Строка - часть наименование, артикула, кода номенклатуры, по которому производится поиск		
//  userId - Строка - идентификатор пользователя Клеверенс		
//  mXmlDoc	- Строка - строка в формате XML или JSON, содержащая информацию о текущей сессии Клеверенс
//
// Возвращаемое значение:
//	- Строка - данные таблицы отобранных товаров в формате XML, если тип интерфейса - COM
//	- Строка - данные таблицы отобранных товаров в формате JSON, если тип интерфейса - REST_API
//	- Неопределено - если не удалось установить соединение с базой Клеверенс
Функция НайтиНоменклатуруПоЧастиНаименования(ПараметрНоменклатуры, userId, mXmlDoc = Неопределено) Экспорт
	
	ИмяСобытия = "НайтиНоменклатуруПоЧастиНаименования";
	
	Возврат ПолучитьТовар(ПараметрНоменклатуры, "", UserId, 5, mXmlDoc,, ИмяСобытия);
	
КонецФункции

// Обрабатывает запрос сервера Клеверенс на получение списка номенклатуры
//
// Параметры:
