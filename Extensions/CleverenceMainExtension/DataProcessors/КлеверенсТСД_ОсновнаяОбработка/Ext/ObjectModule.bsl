	Возврат Результат;
	
КонецФункции

Процедура ГлЯдро_ОбновитьМетаданныеПользователейMSВХранилище1С(СписокПользователейMS, ПользователиMSАдрес, АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ОбновитьМетаданныеПользователейMSВХранилище1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СписокПользователейMS,ПользователиMSАдрес",
		СписокПользователейMS, ПользователиMSАдрес);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если ТипЗнч(СтруктураМетаданных) <> Тип("Структура") Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;		
	КонецЕсли;
	
	ИдентификаторБазыMS = "";
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);	
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;	
	КонецЕсли;	
	
	ИмяПеременнойНастройки 	= "Cleverence_СтруктураМетаданныхMS_" + ИдентификаторБазыMS;
	
	СтруктураМетаданных.Вставить("ПользователиMS", СписокПользователейMS);
	
	ГлЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойНастройки, СтруктураМетаданных);
		
	СтруктураМетаданных.Вставить("ПользователиMS", ПользователиMSАдрес);
	
	КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных", СтруктураМетаданных, АдресаПеременных);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьМобильныеУстройстваSMARTS(ТипБазы, ТипИнтерфейса, АдресаПеременных) Экспорт
	
	Если ТипИнтерфейса = "REST_API" Тогда
		ПользователиMS = REST_API_ПолучитьМобильныеУстройстваSMARTS(ТипБазы, АдресаПеременных);
	Иначе
		ПользователиMS = КомЯдро_ПолучитьМобильныеУстройстваSMARTS(ТипБазы, АдресаПеременных);
	КонецЕсли;        
	
	Возврат ПользователиMS;
	
КонецФункции

// Возвращает структуру описания устройства МС.
// 
// Параметры:
//	deviceId - Строка - Ид устройства
//	deviceName - Строка - Имя устройства
//	lastInfoTime - Строка - Время последнего обмена устройства с сервером
//	pincode - Строка - пинкод, используется только для "легкого облака"
//
// Возвращаемое значение:
//	Структура - с заполненными или пустыми полями:
//		* deviceId - Строка - Ид устройства
//		* deviceName - Строка - Имя устройства
//		* deviceDescription - Строка - Описание устройства
//		* pincode - Строка - пинкод
//		* lastInfoTime - ДатаВремя - Время последнего обмена устройства с сервером
//		* supportDate - ДатаВремя - Дата окончания подписки на обновления
//		* supportAppId - Строка - Id продукта, для которого определили дату подписки на обновления
//		* isDemo - Булево - Демо режим для устройства
Функция ГлЯдро_СтруктураОписанияУстройстваSMARTS(deviceId = "", deviceName = "", lastInfoTime = '00010101',supportDate = '00010101', pincode ="") Экспорт
	
	deviceDescription = ?(НЕ ЗначениеЗаполнено(deviceName), deviceId, deviceName + ", (" + deviceId + ")");
	СтруктураОписания =  Новый Структура("deviceId,deviceName,deviceDescription,pincode,lastInfoTime,supportDate,supportAppId,isDemo", deviceId, deviceName, deviceDescription,pincode,lastInfoTime,supportDate,"",Ложь);
	
	Возврат СтруктураОписания;
КонецФункции

Процедура ГлЯдро_СкопироватьНастройкиПодключенияДругимПользователям1С(СписокПользователей, НаборыТокенов = Неопределено, КопироватьПрава, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СкопироватьНастройкиПодключенияДругимПользователям1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СписокПользователей,НаборыТокенов,КопироватьПрава",
		СписокПользователей, НаборыТокенов, КопироватьПрава);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыПодключенияMS 	= ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
	РасположениеКомпоненты 	= ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
	ТипИнтерфейса		   	= ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПолучитьНаборыТокенов = ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
			И ПараметрыПодключенияMS.Свойство("АвторизацияВключена")
			И ПараметрыПодключенияMS.АвторизацияВключена = Истина;
			
		Если ПолучитьНаборыТокенов Тогда
			НаборыТокенов = ГлЯдро_ПолучитьТокеныДляДругихПользователей1С(СписокПользователей,, ТипИнтерфейса, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	ПолученыНаборыТокенов = НЕ НаборыТокенов = Неопределено;
	
	Если Метаданные.Справочники.Найти("ГруппыДоступа") = Неопределено Тогда
		ИмяГруппыДоступа = "AccessGroups";
		ИмяПользователи = "Users";
		ИмяПользователь = "User";
	Иначе
		ИмяГруппыДоступа = "ГруппыДоступа";
		ИмяПользователи = "Пользователи";
		ИмяПользователь = "Пользователь";
	КонецЕсли;
	
	Если КопироватьПрава Тогда
		
		ИсходныйПользователь = ГлЯдро_ПолучитьТекущегоПользователя();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
				"ВЫБРАТЬ
				|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник." + ИмяГруппыДоступа + "." + ИмяПользователи + " КАК ГруппыДоступаПользователи
				|ГДЕ
				|	ГруппыДоступаПользователи." + ИмяПользователь + " = &Пользователь
				|	И ГруппыДоступаПользователи.Ссылка.Наименование ПОДОБНО ""Клеверенс%""";
		
		Запрос.УстановитьПараметр("Пользователь", ИсходныйПользователь);
		
		ТЗГруппыДоступа = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Для Каждого Пользователь Из СписокПользователей Цикл
		ИмяПользователя = ГлЯдро_ПолучитьИмяПользователяДляКопированияНастроек(Пользователь.Значение);
		
		ПараметрыПодключенияMS.Вставить("АвторизацияТокен", 	  "");
		ПараметрыПодключенияMS.Вставить("АвторизацияРефрешТокен", "");
		
		Если ПолученыНаборыТокенов Тогда
			НаборТокенов = НаборыТокенов.Получить(Пользователь.Значение);	
			Если НЕ НаборТокенов = Неопределено Тогда
				ПараметрыПодключенияMS.Вставить("АвторизацияТип",			"tempuid");
				ПараметрыПодключенияMS.Вставить("АвторизацияТокен", 	  	НаборТокенов.АвторизацияТокен);
				ПараметрыПодключенияMS.Вставить("АвторизацияРефрешТокен", 	НаборТокенов.АвторизацияРефрешТокен);
			КонецЕсли;
		КонецЕсли;
		
		ПодключенныеБазыMS = Новый Соответствие;
		ПодключенныеБазыMS.Вставить(ПараметрыПодключенияMS.Ид, ПараметрыПодключенияMS.Имя);
		
		ХранилищеОбщихНастроек.Сохранить("Cleverence_ПараметрыПодключенияMS_" + ПараметрыПодключенияMS.Ид, "", ПараметрыПодключенияMS, , ИмяПользователя);
		ХранилищеОбщихНастроек.Сохранить("Cleverence_ПодключенныеБазыMS", "", ПодключенныеБазыMS, , ИмяПользователя);
		ХранилищеОбщихНастроек.Сохранить("Cleverence_ID_ТекущейБазы", "", ПараметрыПодключенияMS.Ид, , ИмяПользователя);
		
		ХранилищеОбщихНастроек.Сохранить("Cleverence_РасположениеКомпоненты", "", РасположениеКомпоненты, , ИмяПользователя);
		ХранилищеОбщихНастроек.Сохранить("Cleverence_ТипИнтерфейса", "", ТипИнтерфейса, , ИмяПользователя); 
		
		Если КопироватьПрава И ТЗГруппыДоступа.Количество() > 0 Тогда
			Для Каждого ГруппаДоступа из ТЗГруппыДоступа Цикл
				Группа = ГруппаДоступа.Ссылка;
				ГруппаОбъект = Группа.ПолучитьОбъект();
				ТЧПользователи = ГруппаОбъект[ИмяПользователи];
				НоваяСтрока = ТЧПользователи.добавить();
				НоваяСтрока[ИмяПользователь] = Пользователь.Значение;
				ГруппаОбъект.Записать();
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ПолучитьИмяПользователяДляКопированияНастроек(Пользователь)

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Для обычных форм, например, УТ 10.3
		ИмяПользователя = СокрЛП(Пользователь.Код);
	#Иначе	
		// Для управляемых форм, например УТ 11.5
		Попытка
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
			Если НЕ ПользовательИБ = Неопределено Тогда
				ИмяПользователя = ПользовательИБ.Имя;
			Иначе
				ИмяПользователя = Пользователь.Наименование;
			КонецЕсли;
		Исключение
			ИмяПользователя = Пользователь.Наименование;
		КонецПопытки;
	#КонецЕсли
	
	Возврат ИмяПользователя;
    
КонецФункции

Функция ГлЯдро_ПолучитьТокеныДляДругихПользователей1С(СписокПользователей, ТипБазы = "Основная", ТипИнтерфейса = "REST_API", АдресаПеременных)

	ИмяСобытия = "ГлЯдро_ПолучитьТокеныДляДругихПользователей1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СписокПользователей,ТипБазы,ТипИнтерфейса",
		СписокПользователей, ТипБазы, ТипИнтерфейса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ТипИнтерфейса = "REST_API" Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза", АдресаПеременных);
	Если ЕстьЧастнаяБаза = Истина Тогда
		ТипБазы = "Частная";
	КонецЕсли;
	
	// Получаем настройки подключения (тип интерфейса не проверяем, т.к. при подключении по COM не могла быть выполнена авторизация по темпуид)
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	НаборыТокенов = Новый Соответствие;
	Для каждого Пользователь ИЗ СписокПользователей Цикл
		
		// BaseInfo получаем для каждого пользователя, чтобы был сгенерирован новый темпуид
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
		СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		ОтветСервера = Неопределено;
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
			ТекстОшибки = НСтр("ru = 'Произошла ошибка при подключении к базе Клеверенс. Подробности см. в журнале регистрации';
								|en = 'An error occurred when connecting to the Cleverence database. For details, see in the registration log';
								|be = 'Адбылася памылка пры падключэнні да базы Cleverence. Падрабязнасці гл. у часопісе рэгістрацыі'; es = 'Se ha producido un error al conectarse a la base de Cleverence. Consulte el registro para obtener más detalles'; ka = 'შეცდომა მოხდა Cleverence მონაცემთა ბაზასთან დაკავშირებისას. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში'; kk = 'Cleverence базасына қосылу кезінде қате пайда болды. Толық ақпаратты тіркеу журналынан қараңыз'; ro = 'A apărut o eroare la conectarea la baza de date Cleverence. Consultați jurnalul de înregistrare pentru detalii'; tr = 'Cleverence veritabanına bağlanırken bir hata oluştu. Ayrıntılar için kayıt defterine bakın'; uk = 'Сталася помилка при підключенні до бази Cleverence. Подробиці див. в журналі реєстрації'; uz = 'Cleverence ma''lumotlar bazasiga ulanishda xato yuz berdi. Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang'");
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("ТекстСообщения", ТекстОшибки);
			
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
			Прервать;
		КонецЕсли;
		
		Темпуид = "";
		
		allConnectionStrings = ОтветСервера.Получить("allConnectionStrings");
		Если ТипЗнч(allConnectionStrings) = Тип("Массив") Тогда
			Для каждого ConnectionString ИЗ allConnectionStrings Цикл
				ПозицияСтрокиПоиска = ГлЯдро_СтрНайти(ConnectionString, "tempuid=");
				Если ПозицияСтрокиПоиска Тогда
					Темпуид	= Сред(ConnectionString, ПозицияСтрокиПоиска + 8);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ПустаяСтрока(Темпуид) Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось получить tempuid из строки подключения';
								|en = 'Couldn''t get tempuid from connection string'; be = 'Не атрымалася атрымаць tempuid з радка падлучэння'; es = 'No se pudo obtener el tempuid de la cadena de conexión'; ka = 'ვერ tempuid კავშირი სიმებიანი'; kk = 'Қосылу жолынан tempuid алу мүмкін болмады'; ro = 'Nu s-a putut obține tempuid din șirul de conexiune'; tr = 'Bağlantı dizesinden tempuıd alınamadı'; uk = 'Не вдалося отримати tempuid з рядка підключення'; uz = 'Tempuidni ulanish satridan olish mumkin emas'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			// </Лог>
			Прервать;
		КонецЕсли;
		
		ДанныеТокена = ГлЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, "__tempuid__", Темпуид, ТипБазы, ТипИнтерфейса, Ложь, АдресаПеременных);
		
		Если ТипЗнч(ДанныеТокена) = Тип("Структура") Тогда
			НаборТокенов = Новый Структура;
			НаборТокенов.Вставить("АвторизацияТокен", 		ДанныеТокена.Access_token);
			НаборТокенов.Вставить("АвторизацияРефрешТокен", ДанныеТокена.Refresh_token);
			
			НаборыТокенов.Вставить(Пользователь.Значение, НаборТокенов);
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НаборыТокенов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат НаборыТокенов;
	
КонецФункции

Функция ГлЯдро_СтрокиПодключенияСовпадают(СтрокаПодключения1, СтрокаПодключения2)
	
	// Для строк clgt сравниваем только идентификаторы баз Клеверенс, т.к. может быть редирект
	Если ГлЯдро_СтрНайти(СтрокаПодключения1, "clgt") ИЛИ ГлЯдро_СтрНайти(СтрокаПодключения2, "clgt") Тогда
		СтруктураURI1 = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения1);
		СтруктураURI2 = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения2);
		
		СтрокиПодключенияСовпадают = СтруктураURI1.ПутьНаСервере = СтруктураURI2.ПутьНаСервере;		
	Иначе
		СтрокиПодключенияСовпадают = СтрокаПодключения1 = СтрокаПодключения2;
	КонецЕсли;
	
	Возврат СтрокиПодключенияСовпадают;
	
КонецФункции

Функция ГлЯдро_ПолучитьФункциональныеПараметры1С(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьФункциональныеПараметры1С";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Попытка
		СписокПараметров = ИнтеграционнаяОбработка.Конф_ПолучитьФункциональныеПараметры1С();		
	Исключение		
		пСообщение = НСтр("ru = 'Не удалось получить функциональные параметры 1С';
							|en = 'Couldn''t get the functional parameters of 1C'; be = 'Не атрымалася атрымаць функцыянальныя параметры 1С'; es = 'No se pudieron obtener los parámetros funcionales 1C'; ka = 'ვერ მოხერხდა 1c-ის ფუნქციური პარამეტრების მიღება'; kk = '1С функционалдық параметрлерін алу мүмкін болмады'; ro = 'Nu am putut obține parametrii funcționali ai 1C'; tr = '1c''nin işlevsel parametrelerini alamadım'; uk = 'Не вдалося отримати функціональні параметри 1С'; uz = '1C funktsional parametrlarini olish mumkin emas'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, , АдресаПеременных);
		СписокПараметров = Неопределено;
	КонецПопытки;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокПараметров);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СписокПараметров;
	
КонецФункции

Процедура ГлЯдро_ОбновитьФункциональныеПараметры1СВБазеMS(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ОбновитьФункциональныеПараметры1СВБазеMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	РасположениеКомпоненты = КомЯдро_ПолучитьЗначениеПеременной("РасположениеКомпоненты", АдресаПеременных);
	Если РасположениеКомпоненты = "НаКлиенте" Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
					
	СтруктураНастроек = ГлЯдро_ПолучитьФункциональныеПараметры1С(АдресаПеременных);
	
	Если СтруктураНастроек = Неопределено ИЛИ СтруктураНастроек.Количество() = 0 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СохраненныеНастройки = КомЯдро_ПолучитьЗначениеПеременной("ТекущиеНастройкиMS", АдресаПеременных);
	ФлагНастроекИнициализирован = КомЯдро_ПолучитьЗначениеПеременной("НастройкиИнициализированы", АдресаПеременных);
	
	НастройкиИнициализированы = ФлагНастроекИнициализирован = Истина
		И ТипЗнч(СохраненныеНастройки) = Тип("Структура");
	Если НЕ НастройкиИнициализированы Тогда
		СохраненныеНастройки = ГлЯдро_СкопироватьСтруктуру(СтруктураНастроек);
		Для каждого ФункциональныйПараметр ИЗ СохраненныеНастройки Цикл
			СохраненныеНастройки.Вставить(ФункциональныйПараметр.Ключ, Ложь); // сбрасываем значение на значение по умолчанию
		КонецЦикла;
		СохраненныеНастройки = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(СохраненныеНастройки,,,, АдресаПеременных);
	КонецЕсли;
	
	НастройкиКПолучению = Новый Структура;
	Для каждого КЗ Из СтруктураНастроек Цикл
		Если НЕ СохраненныеНастройки.Свойство(КЗ.Ключ) Тогда
			НастройкиКПолучению.Вставить(КЗ.Ключ, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкиКПолучению.Количество() > 0 Тогда
		НастройкиКПолучению = ГлЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,,,, АдресаПеременных);
		Для каждого КЗ Из НастройкиКПолучению Цикл
			СохраненныеНастройки.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// удаляем не измененные настройки
	Для каждого КЗ Из СтруктураНастроек Цикл
		ТекущееЗначение = Неопределено;
		Если СохраненныеНастройки.Свойство(КЗ.Ключ, ТекущееЗначение) и ТекущееЗначение = КЗ.Значение Тогда
			СтруктураНастроек.Удалить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураНастроек.Количество() > 0 Тогда
		ГлЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроек,,, АдресаПеременных);
		
		Если НастройкиИнициализированы Тогда
			ГлЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция ГлЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS(АдресаПеременных) Экспорт

	Перем UnavailableDocuments;
	
	ИмяСобытия = "ГлЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураВозврата = Новый Структура;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	
	ДокументыMS = Неопределено;
	Если НЕ ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		ИЛИ НЕ СтруктураМетаданных.Свойство("ДокументыMS", ДокументыMS) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS", Ложь, АдресаПеременных);
	
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS", АдресаПеременных);
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		Если ПараметрыПодключенияMS.Свойство("УровеньПриложенияСтрокой") И ПараметрыПодключенияMS.УровеньПриложенияСтрокой = "Минимум" Тогда
			UnavailableDocuments = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("UnavailableDocuments",, АдресаПеременных);
		КонецЕсли;
	КонецЕсли;
	
	ПроверятьДостуностьБизнесПроцессов = ТипЗнч(UnavailableDocuments) = Тип("Массив");
	
	ОтключаемыеБизнесПроцессы = Новый Массив;
	ИзмененныеБизнесПроцессы = Новый Массив;
	НедоступныеБизнесПроцессы = Новый Массив;
	
	СтруктураНастроек_ПоУмолчанию 		= ГлЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов(АдресаПеременных);
	СтруктураНастроек_Пользовательские	= ГлЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов(АдресаПеременных);
	
	НастройкиБизнесПроцессов_ПоУмолчанию		= СтруктураНастроек_ПоУмолчанию.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_Пользовательские 	= СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов;
	
	// Настройки _ПоУмолчанию для главного узла
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_ПоУмолчанию);
		КонецЕсли;
			
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ОтключитьБизнесПроцесс = Ложь;
			
			Если ЗначениеЗаполнено(СтрокаБП.ТипДокументаMS)
				И НЕ ДокументыMS.Свойство(СтрокаБП.ТипДокументаMS) Тогда
				ОтключитьБизнесПроцесс = Истина;
			КонецЕсли;
			
			Если ПроверятьДостуностьБизнесПроцессов И ЗначениеЗаполнено(СтрокаБП.ТипРезультирующегоДокумента1С) Тогда
				Если НЕ UnavailableDocuments.Найти(СтрокаБП.ТипРезультирующегоДокумента1С) = Неопределено Тогда
					НедоступныеБизнесПроцессы.Добавить(
						СтрокаБП.ID_БизнесПроцесса);
					ОтключитьБизнесПроцесс = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ОтключитьБизнесПроцесс Тогда
				СтруктураБизнесПроцесса = Новый Структура("ID_БизнесПроцесса, Название, Используется, ТипДокументаMS, Типовой");
				ЗаполнитьЗначенияСвойств(СтруктураБизнесПроцесса, СтрокаБП);
				СтруктураБизнесПроцесса.Типовой = Истина;
				
				ОтключаемыеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Настройки _Пользовательские для главного узла
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);		
		КонецЕсли;		
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("ТаблицаЗначений") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_Пользовательские);
		КонецЕсли;
			
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаБП.ТипДокументаMS)
				И НЕ ДокументыMS.Свойство(СтрокаБП.ТипДокументаMS) Тогда
				СтруктураБизнесПроцесса = Новый Структура("ID_БизнесПроцесса, Название, Используется, ТипДокументаMS, Типовой");
				ЗаполнитьЗначенияСвойств(СтруктураБизнесПроцесса, СтрокаБП);
				СтруктураБизнесПроцесса.Типовой = Истина;
				
				ОтключаемыеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);
				
				Если СтрокаБП.Используется Тогда
					СтрокаБП.Вставить("Используется", Ложь);
					ИзмененныеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИзмененныеБизнесПроцессы.Количество() Тогда
		СтруктураНастроекБизнесПроцессов_Пользовательские = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_Пользовательские, 
			ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(),
			АдресаПеременных);
					
		ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, "", АдресаПеременных);
		ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, АдресаПеременных);
		СтруктураВозврата.Вставить("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские);
		
		// Если изменились настройки пользовательских бизнес-процессов, нужно будет пересобрать общую структуру для всех узлов
		ГлЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов", АдресаПеременных);
	КонецЕсли;

	Если НЕ ОтключаемыеБизнесПроцессы.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	// Настройки _ПользовательскиеНастройки для главного узла и торговых объектов
	
	МассивУзлов = Новый Массив;
	МассивУзлов.Добавить("");
		
	ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			МассивУзлов.Добавить(СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;
		
	Для каждого ID_Узла ИЗ МассивУзлов Цикл
		ЭтоТекущийУзел = ID_ТекущегоУзла = ID_Узла;
		Если ЭтоТекущийУзел Тогда
			СтруктураНастроек_ПользовательскиеНастройки	= ГлЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов(АдресаПеременных);
		Иначе
			СтруктураНастроек_ПользовательскиеНастройки	= ГлЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла, АдресаПеременных);
		КонецЕсли;
		НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроек_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
				
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) <> Тип("Массив") ИЛИ НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки.Количество() Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
			ИначеЕсли ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Массив") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_Пользовательские[0]);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);		
			КонецЕсли;		
			Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("ТаблицаЗначений") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(НастройкиБизнесПроцессов_Пользовательские);
			КонецЕсли;
		КонецЕсли;
				
		СохранитьОбщуюНастройку = Ложь;
		
		Для каждого СтрокаБП ИЗ ОтключаемыеБизнесПроцессы Цикл
			Если ID_Узла = "" И НЕ СтрокаБП.Типовой Тогда
				Продолжить;
			КонецЕсли;
					
			БизнесПроцессДоступен = НедоступныеБизнесПроцессы.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено;
			
			СохранитьТекущуюНастройку = Ложь;
				
			СтруктураНастройки = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Новый Структура("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса));
			Если СтруктураНастройки = Неопределено Тогда
				Если СтрокаБП.Используется Тогда
					СтрокаНастройки = Новый Структура;
					СтрокаНастройки.Вставить("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса);
					СтрокаНастройки.Вставить("Используется", 	  Ложь);
					СтрокаНастройки.Вставить("Доступность",		  БизнесПроцессДоступен);
					НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(СтрокаНастройки);
							
					СохранитьТекущуюНастройку = Истина;
				КонецЕсли;
			Иначе	
				СтрокаНастройки = СтруктураНастройки[0];
						
				Если СтрокаНастройки.Свойство("Используется")
					И СтрокаНастройки.Используется Тогда
					СтрокаНастройки.Вставить("Используется", Ложь);
							
					СохранитьТекущуюНастройку = Истина;
				ИначеЕсли СтрокаБП.Используется И НЕ СтрокаНастройки.Свойство("Используется") Тогда
					СтрокаНастройки.Вставить("Используется", Ложь);
								
					СохранитьТекущуюНастройку = Истина;
				КонецЕсли;
				
				Если НЕ БизнесПроцессДоступен Тогда
					Если НЕ СтрокаНастройки.Свойство("Доступность")
						ИЛИ СтрокаНастройки.Доступность Тогда
						СтрокаНастройки.Вставить("Доступность",	БизнесПроцессДоступен);
								
						СохранитьТекущуюНастройку = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
					
			Если СохранитьТекущуюНастройку Тогда
				ИзмененныйБП = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(ИзмененныеБизнесПроцессы, Новый Структура("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса));
				Если ИзмененныйБП = Неопределено Тогда
					ИзмененныеБизнесПроцессы.Добавить(СтрокаБП);
				КонецЕсли;
					
				СохранитьОбщуюНастройку = Истина;
			КонецЕсли;
		КонецЦикла;
				
		Если СохранитьОбщуюНастройку Тогда
			СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = ГлЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
				ГлЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки(),
				АдресаПеременных);
								
			ГлЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла, АдресаПеременных);
			Если ЭтоТекущийУзел Тогда
				ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, АдресаПеременных);
				СтруктураВозврата.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
			КонецЕсли;
				
			ГлЯдро_СохранитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", Неопределено, ID_Узла, АдресаПеременных);
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого ИзмененныйБП ИЗ ИзмененныеБизнесПроцессы Цикл
		Если НЕ НедоступныеБизнесПроцессы.Найти(ИзмененныйБП.ID_БизнесПроцесса) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'Отключен бизнес-процесс ""%1"" по причине: документ ""%2"" отсутствует в метаданных Клеверенс';
								|en = 'The business process ""%1"" is disabled for the reason: the document ""%2"" is missing from the Cleverence metadata';
								|be = 'Адключаны бізнэс-працэс ""%1 ""па прычыне: дакумент"" %2 "" адсутнічае ў метададзеных Cleverence'; es = 'El proceso de negocio ""%1 "" está deshabilitado porque el documento ""%2 "" no se encuentra en los metadatos de Cleverence'; ka = 'ბიზნეს პროცესი ""%1 "" გამორთულია მიზეზის გამო: დოკუმენტი ""%2"" აკლია კლევერენციის მეტამონაცემებს'; kk = 'Cleverence метадеректерінде ""%1"" бизнес-процесі өшірілді: ""%2 "" құжаты жоқ'; ro = 'Procesul de afaceri ""%1 ""este dezactivat din motivul: documentul"" %2 "" lipsește din metadatele Cleverence'; tr = '""%1"" iş süreci şu nedenle devre dışı bırakıldı: ""%2"" belgesi Cleverence meta verilerinde eksik'; uk = 'Бізнес-процес ""%1 ""вимкнено з причини: документ"" %2 "" відсутній у метаданих Cleverence'; uz = '""%1 "" biznes jarayoni o''chirib qo''yilgan: ""%2"" hujjati Cleverence metama''lumotlarida mavjud emas'");
		ТекстСообщения = ГлЯдро_СтрШаблон(ТекстСообщения, ИзмененныйБП.Название, ИзмененныйБП.ТипДокументаMS);
			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстСообщения,, АдресаПеременных);
	КонецЦикла;
	
	Если ИзмененныеБизнесПроцессы.Количество() Тогда
		ГлЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(АдресаПеременных);
		ГлЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS(АдресаПеременных);
		
		СтруктураВозврата.Вставить("НастройкиБизнесПроцессов", ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",, АдресаПеременных));
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураВозврата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ГлЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS(АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НастройкиБизнесПроцессов = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов",, АдресаПеременных);
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда			
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли; 	
		
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла", АдресаПеременных);
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
		
	ВерсияВыгрузки_6_0 = Истина; // Всегда выгружаем таблицу в новом формате
		
	// Получение настроек бизнес-процессов для узлов
	МассивНастроекБизнесПроцессовПоУзлам = Новый Массив;
	
	МассивУзловЧастныхБаз = Новый Массив;
	
	ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		// Скопируем массив всех узлов, чтобы при редактировании массива ВсеУзлы не изменять значение в кэше
		ВсеУзлы = ГлЯдро_СкопироватьМассив(ВсеУзлы);
			
		СтруктураПустогоУзла = Новый Структура;
		СтруктураПустогоУзла.Вставить("ID_Узла", "");
		ВсеУзлы.Добавить(СтруктураПустогоУзла);
			
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
					
			Если СтрокаУзла.Свойство("ID_Узла")
				И СтрокаУзла.ID_Узла <> ID_ТекущегоУзла Тогда
				НастройкиБизнесПроцессовПоУзлу = ГлЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(СтрокаУзла.ID_Узла, АдресаПеременных);
					
				МассивНастроекБизнесПроцессовПоУзлам.Добавить(Новый Структура("ID_Узла, НастройкиБизнесПроцессов", СтрокаУзла.ID_Узла, НастройкиБизнесПроцессовПоУзлу));
			КонецЕсли;
			
			Если СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу")
				И СтрокаУзла.ИспользоватьЧастнуюБазу Тогда
				МассивУзловЧастныхБаз.Добавить(СтрокаУзла.ID_Узла);
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
		
	ИмяТаблицыБП = "БизнесПроцессы";
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных", АдресаПеременных);
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		И СтруктураМетаданных.Свойство("Tables") Тогда
		Если ГлЯдро_НайтиВСпискеПоПредставлению(СтруктураМетаданных.Tables, "БизнесПроцессы") <> Неопределено Тогда
			ИмяТаблицыБП = "БизнесПроцессы";
		Иначе
			ИмяТаблицыБП = "BusinessProcesses";		
		КонецЕсли;
	КонецЕсли;
	
	// Выгружаются все бизнес-процессы, которые активны хотя бы для одного узла
	ТаблицаДляВыгрузки = Новый Массив;
	
	Для каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
			
		МассивУзлов = Новый Массив;
		Для каждого СтруктураНастроекБизнесПроцессовПоУзлу ИЗ МассивНастроекБизнесПроцессовПоУзлам Цикл
			НастройкиБизнесПроцессовПоУзлу = СтруктураНастроекБизнесПроцессовПоУзлу.НастройкиБизнесПроцессов;
				
			Если ТипЗнч(НастройкиБизнесПроцессовПоУзлу) = Тип("Массив") Тогда
				СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
					
				НастройкиПоБизнесПроцессуПоУзлу = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессовПоУзлу, СтруктураОтбора);
				Если НастройкиПоБизнесПроцессуПоУзлу <> Неопределено Тогда
					НастройкаПоБизнесПроцессуПоУзлу = НастройкиПоБизнесПроцессуПоУзлу[0];
					Если НастройкаПоБизнесПроцессуПоУзлу.Свойство("Используется") 
						И НастройкаПоБизнесПроцессуПоУзлу.Используется Тогда
						МассивУзлов.Добавить(СтруктураНастроекБизнесПроцессовПоУзлу.ID_Узла);
						Продолжить;
					КонецЕсли;
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНастройки.Используется Тогда
			МассивУзлов.Добавить(ID_ТекущегоУзла);
		КонецЕсли;
				
		Если МассивУзлов.Количество() = 0 Тогда
			// Бизнес-процесс отключен на всех узлах
			Продолжить;
		КонецЕсли;
		
		Если НЕ ВерсияВыгрузки_6_0 Тогда
			// Удаляем идентификатор пустого узла
			ИндексУзла = МассивУзлов.Найти("");
			Если ИндексУзла <> Неопределено Тогда
				МассивУзлов.Удалить(ИндексУзла);
			КонецЕсли;
				
			СтрокаУзел = ГлЯдро_СтрСоединить(МассивУзлов, ",");
			
			МассивУзлов = Новый Массив;
			МассивУзлов.Добавить(СтрокаУзел);
		КонецЕсли;
		
		Для каждого СтрокаУзел ИЗ МассивУзлов Цикл
		
			Настройка = Новый Структура();
			Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
				Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
				Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Узел",							СтрокаУзел);
			Иначе
				Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Name",							СтрокаНастройки.Название);
				Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
				Настройка.Вставить("Nodes",							СтрокаУзел);
			КонецЕсли;		
			ТаблицаДляВыгрузки.Добавить(Настройка);
			
		КонецЦикла; // Для каждого СтрокаУзел ИЗ МассивУзлов
	КонецЦикла;
		
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза", АдресаПеременных);
	Если ЕстьЧастнаяБаза = Истина Тогда
		ТипБазы = "Частная";
	Иначе
		ТипБазы = "Основная";
	КонецЕсли;
		
	ГлЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, ТипБазы, АдресаПеременных);
	
	// Выгрузка бизнес-процессов в частные базы
	Если МассивУзловЧастныхБаз.Количество() > 0 Тогда
		ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
		
		Попытка
			Для Каждого ИдУзла Из МассивУзловЧастныхБаз Цикл
				ГлЯдро_УстановитьДанныеТекущегоУзла(ИдУзла, Ложь,, ТипИнтерфейса, АдресаПеременных);
				ГлЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, "Частная", АдресаПеременных);
			КонецЦикла;
		Исключение
			ТекстОшибки	   = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось выгрузить бизнес-процессы в частные базы. Причина: %1';
								|en = 'Failed to upload business processes to private databases. Reason: %1';
								|be = 'Не атрымалася выгрузіць бізнес-працэсы ў прыватныя базы. Прычына: %1'; es = 'No se pudieron descargar los procesos de negocio a bases de datos privadas. Causa: %1'; ka = 'ვერ მოხერხდა ბიზნეს პროცესების ატვირთვა კერძო მონაცემთა ბაზებში. მიზეზი: %1'; kk = 'Бизнес-процестерді жеке базаларға түсіру мүмкін болмады. Себебі: %1'; ro = 'Nu s-a reușit încărcarea proceselor de afaceri în baze de date private. Motiv: %1'; tr = 'İş süreçlerini özel üslere boşaltmak mümkün değildi. Sebep: % 1'; uk = 'Не вдалося вивантажити бізнес-процеси в приватні бази. Причина: %1'; uz = 'Biznes-jarayonlarni xususiy bazalarga tushirib bo''lmadi. Sababi: %1'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ТекстОшибки",
				ТекстОшибки);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
		КонецПопытки;
		
		ГлЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзла, Ложь,, ТипИнтерфейса, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

// Функция - Формирует структуру с описанием таблицы значений. Заполняет имена колонок из СтруктураСтрокаКолонок
//
// Параметры:
//  СтруктураСтрокаКолонок	 - Структура	 - Структура, Строка, Массив
// 
Функция ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтруктураСтрокаКолонок) Экспорт
	
	КолонкиТаблицыЗначений = "";
	Если ТипЗнч(СтруктураСтрокаКолонок) = Тип("Строка") Тогда
		КолонкиТаблицыЗначений = СтрЗаменить(СтруктураСтрокаКолонок, " ", "");
	ИначеЕсли ТипЗнч(СтруктураСтрокаКолонок) = Тип("Структура") Тогда
		
		Для каждого КлючЗначение Из СтруктураСтрокаКолонок Цикл
			КолонкиТаблицыЗначений = КолонкиТаблицыЗначений + КлючЗначение.Ключ + ",";
		КонецЦикла;
		Если КолонкиТаблицыЗначений <> "" Тогда
			КолонкиТаблицыЗначений = Лев(КолонкиТаблицыЗначений, СтрДлина(КолонкиТаблицыЗначений) - 1);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СтруктураСтрокаКолонок) = Тип("Массив") Тогда
		КолонкиТаблицыЗначений = ГлЯдро_СтрСоединить(СтруктураСтрокаКолонок, ",");
	КонецЕсли;
	
	Описание = Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, КолонкиТаблицыЗначений);
	Возврат Описание;
		
КонецФункции 

Функция ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки) Экспорт
	
	// При изменении актуализировать в ЛокЯдро и ГлЯдро
	//	ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек
	//	ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек
	
	КлючиОтбора = "";
	Если ИмяНастройки = "Узлы" Тогда
		КлючиОтбора = "ID_Узла";
		
	ИначеЕсли ИмяНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки = "НастройкиБизнесПроцессов_Пользовательские" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки =  "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_Пользовательские" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_Значения" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеОтборыДокументов" Тогда
		КлючиОтбора = "ID_ПроизвольногоОтбора";
		
	ИначеЕсли ИмяНастройки = "НастройкиОбменаСправочников" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Онлайн" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Интерактивный" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Автообмен" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_ПроизвольногоКода";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды_Пользовательские" Тогда
		КлючиОтбора = "ID_ПроизвольногоКода";
		
	ИначеЕсли ИмяНастройки = "Пользователи" Тогда
		КлючиОтбора = "Ид";
		
	ИначеЕсли ИмяНастройки = "ГруппыПользователей" Тогда
		КлючиОтбора = "Ид";
		
	ИначеЕсли ИмяНастройки = "ПользователиТСД" Тогда
		КлючиОтбора = "ID_Пользователя";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Онлайн" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Интерактивный" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Автообмен" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиПолей" ИЛИ ИмяНастройки = "НастройкаЗагрузкиПолей" Тогда
		КлючиОтбора = "ИмяПриемника";
		
	ИначеЕсли ИмяНастройки = "ТабличнаяЧастьДокумента1С" Тогда
		КлючиОтбора = "ИмяПриемника";
		
	ИначеЕсли ИмяНастройки = "ТабличнаяЧастьДокументаMS" Тогда
		КлючиОтбора = "ИмяПриемника";	
		
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиТЧ" ИЛИ ИмяНастройки = "НастройкаЗагрузкиТЧ" Тогда
		КлючиОтбора = "ТабличнаяЧастьДокументаMS,НастройкаТЧСтрокой";
		
	ИначеЕсли ИмяНастройки = "СвязиТабличныхЧастей" Тогда
		КлючиОтбора = "ГлавнаяТаблица,ПодчиненнаяТаблица,ПолеГлавнойТаблицы";
		
	КонецЕсли;
		
	Возврат КлючиОтбора;
	
КонецФункции 

// Получает пустую структуру параметров выгрузки справочника
//
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//   Структура   - содержит:
//		* СпособВыгрузки - Строка - ПоУмолчанию, СвойМакетСКД, ПроизвольныйЗапрос
//		* ИмяМакетаИО - Строка - имя макета ИО, по которому необходимо получить СКД
//		* ТекстЗапроса - Строка - текст запроса, по которому необходимо построить СКД
//		* ТекстКодаПолучениеПараметров - Строка - строка кода, из которой будут получены параметры
//		* ТаблицаСопоставленияПолей - Массив - массив строк с сопоставлением реквизит 1с - реквизит Клеверенс
//		* ИмяИсточникаДанных - Строка - имя источника данных, который будет указан в наборе данных СКД
//			в дальнейшем происходит получение запроса из набора данных СКД по имени выгружаемой таблицы
//
Функция ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников(АдресаПеременных = Неопределено) Экспорт
	
