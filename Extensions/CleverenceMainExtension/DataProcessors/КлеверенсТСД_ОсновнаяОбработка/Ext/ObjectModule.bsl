// Вызывает методы для удаления тестовых документов после проверки работы с маркированной продукцией из интеграционной обработки
//
// Параметры:
//	МассивДокументов - Массив ИЗ ДокументСсылка
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
Процедура ГлЯдро_ПроверитьРаботуСМаркированнойПродукцией_УдалитьДокументы(МассивДокументов, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПроверитьРаботуСМаркированнойПродукцией_УдалитьДокументы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивДокументов",
		МассивДокументов);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Попытка
		РезультатУдаления = ИнтеграционнаяОбработка.УдалитьТестовыеДокументы(МассивДокументов);
		
		Если РезультатУдаления.Статус Тогда
			пСообщение = НСтр("ru = 'Удаление тестовых документов после проверки работы с маркированной продукцией выполнено успешно';
								|en = 'Deletion of test documents after checking the work with labeled products was completed successfully';
								|be = 'Выдаленне тэставых дакументаў пасля праверкі працы з маркіраванай прадукцыяй выканана паспяхова'; es = 'La eliminación de los documentos de prueba después de verificar el trabajo con productos Etiquetados se realizó correctamente'; ka = 'ეტიკეტირებულ პროდუქტებთან მუშაობის შემოწმების შემდეგ სატესტო დოკუმენტების წაშლა წარმატებით დასრულდა'; kk = 'Таңбаланған өнімдермен жұмысты тексергеннен кейін тест құжаттарын жою сәтті аяқталды'; ro = 'Ștergerea documentelor de testare după verificarea lucrărilor cu produse etichetate a fost finalizată cu succes'; tr = 'İşaretli ürünlerle çalışmayı doğruladıktan sonra test belgelerinin silinmesi başarıyla tamamlandı'; uk = 'Видалення тестових документів після перевірки роботи з маркованою продукцією виконано успішно'; uz = 'Belgilangan mahsulotlar bilan ishlashni tekshirgandan so''ng sinov hujjatlarini olib tashlash muvaffaqiyatli amalga oshirildi'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		Иначе	
			// <Лог>
			ЯзСтрока = "ru = 'Произошла ошибка при удалении тестовых документов после проверки работы с маркированной продукцией: %1%2';
								|en = 'An error occurred when deleting test documents after checking how they work with labeled products: %1%2';
								|be = 'Адбылася памылка пры выдаленні тэставых дакументаў пасля праверкі працы з маркіраванай прадукцыяй: %1% 2'; es = 'Se produjo un error al eliminar los documentos de prueba después de verificar el trabajo con productos Etiquetados: %1%2'; ka = 'შეცდომა მოხდა ტესტის დოკუმენტების წაშლისას, როდესაც შეამოწმეს, თუ როგორ მუშაობენ ისინი ეტიკეტირებულ პროდუქტებთან: %1% 2'; kk = 'Таңбаланған өнімдермен жұмысты тексергеннен кейін тест құжаттарын жою кезінде қате пайда болды: %1% 2'; ro = 'A apărut o eroare la ștergerea documentelor de testare după verificarea modului în care funcționează cu produsele etichetate: %1%2'; tr = 'İşaretli ürünlerle çalışmayı kontrol ettikten sonra test belgelerinin silinmesinde bir hata oluştu: %1%2'; uk = 'Сталася помилка при видаленні тестових документів після перевірки роботи з маркованою продукцією: %1%2'; uz = 'Belgilangan mahsulotlar bilan ishlashni tekshirgandan so''ng test hujjatlarini olib tashlashda xatolik yuz berdi: %1%2'";
			пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), Символы.ПС, РезультатУдаления.Сообщение);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ПС,Сообщение",
				Символы.ПС, РезультатУдаления.Сообщение);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст,,, АдресаПеременных);
			// </Лог>
		КонецЕсли;
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Не удалось удалить тестовые документы после проверки работы с маркированной продукцией. Причина: %1';
							|en = 'It was not possible to delete test documents after checking how they work with labeled products. Reason: %1';
							|be = 'Не атрымалася выдаліць тэставыя дакументы пасля праверкі працы з маркіраванай прадукцыяй. Прычына: %1'; es = 'No se pudieron eliminar los documentos de prueba después de verificar el trabajo con productos Etiquetados. Causa: %1'; ka = 'შეუძლებელი იყო სატესტო დოკუმენტების წაშლა ეტიკეტირებულ პროდუქტებთან მუშაობის შემოწმების შემდეგ. მიზეზი: %1'; kk = 'Таңбаланған өнімдермен жұмысты тексергеннен кейін тест құжаттарын жою мүмкін болмады. Себебі: %1'; ro = 'Nu a fost posibilă ștergerea documentelor de testare după verificarea modului în care funcționează cu produsele etichetate. Motiv: %1'; tr = 'Etiketli ürünlerle çalışmayı kontrol ettikten sonra test belgeleri silinemedi. Sebep: % 1'; uk = 'Не вдалося видалити тестові документи після перевірки роботи з маркованою продукцією. Причина: %1'; uz = 'Belgilangan mahsulotlar bilan ishlashni tekshirgandan so''ng sinov hujjatlarini olib tashlash mumkin emas edi. Sababi: %1'";
		пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстСообщения);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ТекстСообщения",
			ТекстСообщения);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
		// </Лог>
	КонецПопытки;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

