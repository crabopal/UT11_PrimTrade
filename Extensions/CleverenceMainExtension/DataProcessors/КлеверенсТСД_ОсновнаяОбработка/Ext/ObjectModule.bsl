					НоваяСтрокаТаблицы.Вставить("Типовой", Типовой);
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					НоваяСтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					Если НЕ НоваяСтрокаТаблицы.Свойство("ТабличнаяЧастьДокумента1С") // Совместимость с настройками до 2.1.0.1
						И НоваяСтрокаТаблицы.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						МассивПолей = ГлЯдро_ЗначениеИзСтрокиXML(НоваяСтрокаТаблицы.ТабличнаяЧастьДокумента1ССтрокой, Истина);
					КонецЕсли;
					
					НовыйМассивПолей = Новый Массив;
					ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкаЗагрузкиПолейТЧ());
					НовыйМассивПолей.Добавить(ОписаниеТЧ);
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						
						ГлЯдро_УдалитьНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей);
						
						Для каждого СтрокаПоля Из МассивПолей Цикл
							
							Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
								Продолжить;
							КонецЕсли;
							
							НовоеПоле = ГлЯдро_СкопироватьСтруктуру(СтрокаПоля);
							НовоеПоле.Вставить("Типовой", Типовой);
							НовыйМассивПолей.Добавить(НовоеПоле);
							
						КонецЦикла;
					КонецЕсли;
					НоваяСтрокаТаблицы.Вставить(ИмяНастройки, НовыйМассивПолей);
					
					Если НоваяСтрокаТаблицы.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						НоваяСтрокаТаблицы.Удалить("ТабличнаяЧастьДокумента1ССтрокой");
					КонецЕсли;
					
					НовыеНастройкиТЧ.Добавить(НоваяСтрокаТаблицы);
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		НоваяСтрокаБП.Вставить("НастройкаЗагрузкиТЧ", НовыеНастройкиТЧ);
		НовыеНастройкиБизнесПроцессов.Добавить(НоваяСтрокаБП);
		
	КонецЦикла;
	
	Возврат НовыеНастройкиБизнесПроцессов;
	
КонецФункции

// Проверяет заполненность значения версии и переводит в числовой формат из любого типа значений
Функция ГлЯдро_НормализоватьВерсиюВЧисло(Знач ВерсияЗначение)
	
	ВерсияЧисло = 0;
	
	Если ВерсияЗначение = Ложь ИЛИ НЕ ЗначениеЗаполнено(ВерсияЗначение) Тогда	
		ВерсияЧисло = 0;
		
	ИначеЕсли ТипЗнч(ВерсияЗначение) = Тип("Строка") Тогда
		ВерсияЧисло = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияЗначение);
		
	ИначеЕсли ТипЗнч(ВерсияЗначение) = Тип("Число") Тогда
		ВерсияЧисло = ВерсияЗначение;
		
	КонецЕсли;
	
	Возврат ВерсияЧисло
	
КонецФункции 

// Проверяет заполненность значения версии и переводит в строковый формат из любого типа значений
Функция ГлЯдро_НормализоватьВерсиюВСтроку(Знач ВерсияЗначение)
	
	ВерсияСтрока = "0.0.0.0";
	
	Если ВерсияЗначение = Ложь ИЛИ НЕ ЗначениеЗаполнено(ВерсияЗначение) Тогда	
		ВерсияСтрока = "0.0.0.0";
		
	ИначеЕсли ТипЗнч(ВерсияЗначение) = Тип("Число") Тогда
		ВерсияСтрока = ГлЯдро_КонвертироватьВерсиюВСтроку(ВерсияЗначение);
		
	ИначеЕсли ТипЗнч(ВерсияЗначение) = Тип("Строка") Тогда
		ВерсияСтрока = ВерсияЗначение;
		
	КонецЕсли;
	
	Возврат ВерсияСтрока
	
КонецФункции 

Функция ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияСтрокой) Экспорт
	
	ВерсияВМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(ВерсияСтрокой,".");
	ВерсияЧислом = Число(ВерсияВМассив[0])*1000000000
		+Число(ВерсияВМассив[1])*1000000
		+Число(ВерсияВМассив[2])*1000
		+ВерсияВМассив[3];
	
	Возврат ВерсияЧислом;
	
КонецФункции 

Функция ГлЯдро_КонвертироватьВерсиюВСтроку(ВерсияЧислом) Экспорт
	
	// Извлекаем компоненты версии
	Основная  = Цел(ВерсияЧислом / 1000000000);
	Остаток   = ВерсияЧислом % 1000000000;
	
	Минорная  = Цел(Остаток / 1000000);
	Остаток   = Остаток % 1000000;
	
	Патч      = Цел(Остаток / 1000);
	Билд      = Остаток % 1000;
	
	ВерсияСтрокой = Строка(Основная) + "." + Строка(Минорная) + "." + Строка(Патч) + "." + Строка(Билд);
	
	Возврат ВерсияСтрокой;
	
КонецФункции

Функция ГлЯдро_СтрЗаменитьНедопустимыеСимволы(Знач Строка, ПодстрокаЗамены = "", НедопустимыеСимволы = Неопределено)
	
	Если НедопустимыеСимволы = Неопределено Тогда
		НедопустимыеСимволы = ".,:;?!()[]{}+-*/=%'""`:/\?#&=@<>|^~";
		НедопустимыеСимволы = НедопустимыеСимволы + Символы.Таб + Символы.ПС;
	КонецЕсли;
	
	Для ПозицияСимвола = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ПроверяемыйСимвол = Сред(НедопустимыеСимволы,ПозицияСимвола,1);
		Строка = СтрЗаменить(Строка, ПроверяемыйСимвол, ПодстрокаЗамены);
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции 

// Получает строку подключения clgt из BaseInfo
//
// Параметры:
// 	ТипБазы - Строка - тип базы ("Основная", "Частная", "Временная")
// 	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
// 	Строка - строка подключения clgt или пустая строка если не найдена
Функция ГлЯдро_ПолучитьСтрокуClgt(ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьСтрокуClgt";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных);
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат "";
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПроверкаСоединения");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, , АдресаПеременных);
	
	ОтветСервера = Неопределено;
	
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура")
		ИЛИ НЕ СтруктураОтвета.Свойство("КодСостояния")
		ИЛИ СтруктураОтвета.КодСостояния <> 200
		ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат "";
	
	КонецЕсли;
	
	Если ТипЗнч(ОтветСервера) <> Тип("Соответствие") Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат "";
	КонецЕсли;
	
	AllConnectionStrings = ОтветСервера.Получить("allConnectionStrings");
	
	Если AllConnectionStrings = Неопределено Тогда
		AllConnectionStrings = ОтветСервера.Получить("AllConnectionStrings");
	КонецЕсли;
	
	Если ТипЗнч(AllConnectionStrings) = Тип("Массив") Тогда
	
		Для Каждого ЭлементПодключения Из AllConnectionStrings Цикл
		
			Если Найти(ВРег(Строка(ЭлементПодключения)), "//CLGT") > 0 Тогда
				СтрокаClgt = Строка(ЭлементПодключения);
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтрокаClgt);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат СтрокаClgt;
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
	Возврат "";
	
КонецФункции

Функция ГлЯдро_ПолучитьTimestamp()
	
	пМсUTC 			 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пДата 			 = Дата("00010101") + Цел(пМсUTC / 1000);
	пМиллисекунды 	 = пМсUTC % 1000;
	пМиллисекундыСтр = Прав("000" + Формат(пМиллисекунды, "ЧГ="), 3);
	
	пДатаСтр = Формат(пДата, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Возврат пДатаСтр + "." + пМиллисекундыСтр + "Z";
	
КонецФункции

// Преобразует ISO 8601 timestamp со смещением часового пояса в UTC-строку.
//
// Параметры:
//  СтрокаДата - Строка - timestamp в формате ISO 8601 с суффиксом "Z", "+HH:MM" или "-HH:MM".
//
// Возвращаемое значение:
//  Строка - timestamp в UTC (формат "yyyy-MM-ddTHH:mm:ss[.fff]Z").
//  Неопределено - часовой пояс не распознан.
//
Функция ГлЯдро_ПолучитьUTCВремяИзTimestamp(СтрокаДата) Экспорт
	
	// --- 1. Найти TZ ---
	ПозицияПлюс 	= ГлЯдро_СтрНайти(СтрокаДата, "+");
	ПозицияМинус 	= ГлЯдро_СтрНайти(СтрокаДата, "-",,, 20);
	ПозицияZ 		= ГлЯдро_СтрНайти(СтрокаДата, "Z");
	
	Если ПозицияZ > 0 Тогда
		ПозицияTZ = ПозицияZ;
		Знак = 0;
	ИначеЕсли ПозицияПлюс > 0 Тогда
		ПозицияTZ = ПозицияПлюс;
		Знак = 1;
	ИначеЕсли ПозицияМинус > 0 Тогда
		ПозицияTZ = ПозицияМинус;
		Знак =  -1;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	// --- 2. Основная часть ---
	ЧастьДаты = Лев(СтрокаДата, ПозицияTZ - 1);
	
	// --- 3. Выделяем миллисекунды ---
	Мс = "";
	ПозицияТочки = ГлЯдро_СтрНайти(ЧастьДаты, ".");
	
	Если ПозицияТочки > 0 Тогда
		Мс = Сред(ЧастьДаты, ПозицияТочки + 1);
		ЧастьДаты = Лев(ЧастьДаты, ПозицияТочки - 1);
	КонецЕсли;
	
	// --- 4. Парсим дату ---
	Год 	= Число(Сред(ЧастьДаты, 1, 4));
	Месяц 	= Число(Сред(ЧастьДаты, 6, 2));
	День 	= Число(Сред(ЧастьДаты, 9, 2));
	Час 	= Число(Сред(ЧастьДаты, 12, 2));
	Мин 	= Число(Сред(ЧастьДаты, 15, 2));
	Сек 	= Число(Сред(ЧастьДаты, 18, 2));
	
	ДатаЛокальная = Дата(Год, Месяц, День, Час, Мин, Сек);
	
	// --- 5. UTC ---
	Если Знак = 0 Тогда
		ДатаUTC = ДатаЛокальная;
	Иначе
		ЧастьTZ = Сред(СтрокаДата, ПозицияTZ + 1);
		
		ЧасыСмещения = Число(Сред(ЧастьTZ, 1, 2));
		МинутыСмещения = Число(Сред(ЧастьTZ, 4, 2));
		
		СмещениеВСекундах = Знак * (ЧасыСмещения * 3600 + МинутыСмещения * 60);
		
		ДатаUTC = ДатаЛокальная - СмещениеВСекундах;
	КонецЕсли;
	
	// --- 6. Формируем timestamp ---
	СтрокаUTC = Формат(ДатаUTC, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
	
	Если Мс <> "" Тогда
		СтрокаUTC = СтрокаUTC + "." + Мс;
	КонецЕсли;
	
	СтрокаUTC = СтрокаUTC + "Z";
	
	Возврат СтрокаUTC;
	
КонецФункции

#КонецОбласти

#Область ГлобальныйКонтекст_СлужебныеМеханизмы

// Служебный метод для массовой проверки файлов CustomSettingsDflt
Процедура ГлЯдро_АнализXML_ПроверитьCustomSettingsDflt(ПереданныеФайлы) Экспорт
	
	РезультатСообщение = "";
	
	Для каждого ОписаниеФайла Из ПереданныеФайлы Цикл
		
		ИмяФайла = ОписаниеФайла.Имя;
		АдресФайла = ОписаниеФайла.Хранение;
		
		// === Чтение настроек из файла ===
		
		ПрочитатьНастройки = Новый Структура;
		ПрочитатьНастройки.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
		
		ГлЯдро_ПрочитатьНастройкиИзФайлаCustomSettings(АдресФайла, ПрочитатьНастройки);
		
		// =================================
		
		// Сюда вставить свой код для проверки файлов
		
		// === Проверка дублей ===
		Если ТипЗнч(ПрочитатьНастройки.НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
			НастройкиБизнесПроцессов = ПрочитатьНастройки.НастройкиБизнесПроцессов_ПоУмолчанию;
		ИначеЕсли ТипЗнч(ПрочитатьНастройки.НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Структура") Тогда
			НастройкиБизнесПроцессов = ПрочитатьНастройки.НастройкиБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
		Иначе
			РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " Не найдены бизнес-процессы";
			Продолжить;
		КонецЕсли;
		
		ДублиНайдены = Ложь;
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
			
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// Если документ создается на ТСД или выгружается в обработчике, то удаляем настройки выгрузки шапки и ТЧ
			ДоступныНастройкиВыгрузки = ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) 
					И НЕ НастройкаБП.ВыполнитьТолькоПроизвольныйКодВыгрузка = Истина;
			
			// Если документ загружается в обработчике, то удаляем настройки загрузки шапки и ТЧ
			ДоступныНастройкиЗагрузки = ЗначениеЗаполнено(НастройкаБП.ТипРезультирующегоДокумента1С) 
					И НЕ НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина;
							
			// Поля шапки выгрузки
			ИмяНастройки = "НастройкаВыгрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			
			Если ДоступныНастройкиВыгрузки И ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				ЕстьДубли = Ложь;
				СообщениеДублей = "";
				ГлЯдро_НайтиНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей, ЕстьДубли, СообщениеДублей);
				НастройкаБП.Вставить(ИмяНастройки, МассивПолей);
				
				Если ЕстьДубли Тогда
					РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " БП: " + НастройкаБП.ID_БизнесПроцесса + " Дубли: " + ИмяНастройки;
					Если СообщениеДублей <> "" Тогда
						РезультатСообщение = РезультатСообщение + Символы.ПС + Символы.Таб + СообщениеДублей + Символы.ПС;
					КонецЕсли;
					ДублиНайдены = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			// ТЧ выгрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаВыгрузкиТЧ", НастройкиТЧ);
			Если ДоступныНастройкиВыгрузки И ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					ИмяНастройки = "ТабличнаяЧастьДокументаMS";
					МассивПолей = Неопределено;
					СтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						ЕстьДубли = Ложь;
						СообщениеДублей = "";
						ГлЯдро_НайтиНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей, ЕстьДубли, СообщениеДублей);
						СтрокаТаблицы.Вставить(ИмяНастройки, МассивПолей);
						
						Если ЕстьДубли Тогда
							РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " БП: " + НастройкаБП.ID_БизнесПроцесса + " Дубли в НастройкаВыгрузкиТЧ: " + СтрокаТаблицы.ТабличнаяЧастьДокументаMS;
							Если СообщениеДублей <> "" Тогда
								РезультатСообщение = РезультатСообщение + Символы.ПС + Символы.Таб + СообщениеДублей + Символы.ПС;
							КонецЕсли;
							ДублиНайдены = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			// Поля шапки загрузки
			ИмяНастройки = "НастройкаЗагрузкиПолей";
			МассивПолей = Неопределено;
			НастройкаБП.Свойство(ИмяНастройки, МассивПолей);
			Если ДоступныНастройкиЗагрузки И ТипЗнч(МассивПолей) = Тип("Массив") Тогда
				ЕстьДубли = Ложь;
				СообщениеДублей = "";
				ГлЯдро_НайтиНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей, ЕстьДубли, СообщениеДублей);
				НастройкаБП.Вставить(ИмяНастройки, МассивПолей);
				
				Если ЕстьДубли Тогда
					РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " БП: " + НастройкаБП.ID_БизнесПроцесса + " Дубли: " + ИмяНастройки;
					Если СообщениеДублей <> "" Тогда
						РезультатСообщение = РезультатСообщение + Символы.ПС + Символы.Таб + СообщениеДублей + Символы.ПС;
					КонецЕсли;
					ДублиНайдены = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			// ТЧ загрузки
			НастройкиТЧ = Неопределено;
			НастройкаБП.Свойство("НастройкаЗагрузкиТЧ", НастройкиТЧ);
			Если ДоступныНастройкиЗагрузки И ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
				Для каждого СтрокаТаблицы Из НастройкиТЧ Цикл
					
					Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					Если НЕ СтрокаТаблицы.Свойство("ТабличнаяЧастьДокумента1С")
						И СтрокаТаблицы.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						СтрокаТаблицы.Вставить("ТабличнаяЧастьДокумента1С", ГлЯдро_ЗначениеИзСтрокиXML(СтрокаТаблицы.ТабличнаяЧастьДокумента1ССтрокой, Истина));
					КонецЕсли;
					
					ИмяНастройки = "ТабличнаяЧастьДокумента1С";
					МассивПолей = Неопределено;
					СтрокаТаблицы.Свойство(ИмяНастройки, МассивПолей);
					
					Если ТипЗнч(МассивПолей) = Тип("Массив") Тогда
						ЕстьДубли = Ложь;
						СообщениеДублей = "";
						ГлЯдро_НайтиНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей, ЕстьДубли, СообщениеДублей);
						СтрокаТаблицы.Вставить(ИмяНастройки, МассивПолей);
						
						Если ЕстьДубли Тогда
							РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " БП: " + НастройкаБП.ID_БизнесПроцесса + " Дубли в НастройкаЗагрузкиТЧ: " + СтрокаТаблицы.НастройкаТЧСтрокой;
							Если СообщениеДублей <> "" Тогда
								РезультатСообщение = РезультатСообщение + Символы.ПС + Символы.Таб + СообщениеДублей + Символы.ПС;
							КонецЕсли;
							ДублиНайдены = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ДублиНайдены Тогда
			РезультатСообщение = РезультатСообщение + Символы.ПС + "Файл: " + ИмяФайла + " дублей нет";
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить(СокрЛП(РезультатСообщение));
	
КонецПроцедуры

// Служебный метол для обновления файла типовых настроек CustomSettingsDflt
Функция ГлЯдро_ОбновлениеXML_ОбновитьCustomSettingsDflt(АдресФайла) Экспорт
	
	Результат = Новый Структура("Изменен, АдресФайла", Ложь, АдресФайла);
	Отказ = Ложь;
	// === Чтение настроек из файла ===
	
	ПрочитатьНастройки = Новый Структура;
	ПрочитатьНастройки.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
	ПрочитатьНастройки.Вставить("ВерсияНастроек_ПоУмолчанию"); // Для БП которые хранятся в старом виде в массиве
	
	// Для обновления НастройкиОбменаСправочников_ПоУмолчанию, избавляемся от ключей Выгружать_Сразу
	ПрочитатьНастройки.Вставить("НастройкиОбменаСправочников_ПоУмолчанию");
	СоответствиеКлючейВыгружатьСразу = ГлЯдро_СоответствиеСправочниковКлючамВыгружатьСразу();
	Для каждого КлючЗначение Из СоответствиеКлючейВыгружатьСразу Цикл
		ПрочитатьНастройки.Вставить(КлючЗначение.Значение);
	КонецЦикла;
	// --- 
	
	ГлЯдро_ПрочитатьНастройкиИзФайлаCustomSettings(АдресФайла, ПрочитатьНастройки);
	
	// =================================
	
	// Проверяем заполненность настроек
	СтруктураНастроек = Новый Структура; // Структура настроек, которая будет записана в файл
	УдаляемыеНастройки = Новый Массив; // Массив ключей, которые нужно удалить из файла
	
	Для каждого КлючЗначение Из ПрочитатьНастройки Цикл
		Если КлючЗначение.Значение = Неопределено Тогда
			Если НЕ КлючЗначение.Ключ = "ВерсияНастроек_ПоУмолчанию"
				И НЕ Найти(КлючЗначение.Ключ, "Выгружать") Тогда
				Сообщить("Не найдено значение настройки: " + КлючЗначение.Ключ);
			КонецЕсли;
		Иначе
			СтруктураНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// === Обработка настроек файла ===
	ГлЯдро_ОбновлениеXML_ОбновитьБизнесПроцессы(СтруктураНастроек, Отказ);
	Если Отказ Тогда
		Сообщить("Обновление файла прервано");
		Возврат Результат;
	КонецЕсли;
	
	// Делаем все БП типовыми
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию")
		И ТипЗнч(СтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Структура") Тогда
		
		НБП_ПоУмолчанию = Новый Структура("ВерсияНастроек,НастройкиБизнесПроцессов");
		ЗаполнитьЗначенияСвойств(НБП_ПоУмолчанию, СтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию);
		НБП_ПоУмолчанию.НастройкиБизнесПроцессов = ГлЯдро_ПреобразоватьБизнесПроцессыВТиповые(НБП_ПоУмолчанию.НастройкиБизнесПроцессов);
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию", НБП_ПоУмолчанию);
		
	КонецЕсли;
	
	// Обновляем НастройкиОбменаСправочников_ПоУмолчанию, удаляем ключи Выгружать_Сразу
	ГлЯдро_ОбновлениеXML_ОбновитьНастройкиОбменаСправочников(СтруктураНастроек, УдаляемыеНастройки);
	
	// Сюда вставлять свои обработчики обновления
	
	// =================================
	
	// Записываем результаты редактирования в тот же файл xml
	Если СтруктураНастроек.Количество() Тогда
		Результат = ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресФайла, СтруктураНастроек, УдаляемыеНастройки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Процедура ГлЯдро_ОбновлениеXML_ОбновитьБизнесПроцессы(СтруктураНастроек, Отказ)
	
	ЗначениеНастройки = Неопределено;
	Если НЕ СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию", ЗначениеНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ (ТипЗнч(ЗначениеНастройки) = Тип("Структура")
		ИЛИ ТипЗнч(ЗначениеНастройки) = Тип("Массив")) Тогда
		Сообщить("Бизнес-процессы не обновлены. Тип значения: " + ТипЗнч(ЗначениеНастройки));
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеНастройки) = Тип("Массив") Тогда
		Если СтруктураНастроек.Свойство("ВерсияНастроек_ПоУмолчанию") Тогда	
			ЗначениеНастройки = Новый Структура("ВерсияНастроек,НастройкиБизнесПроцессов", СтруктураНастроек.ВерсияНастроек_ПоУмолчанию, ГлЯдро_СкопироватьМассив(ЗначениеНастройки));
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// ВерсияНастроекОбработки
	РегистрационныеДанные = СведенияОВнешнейОбработке();
	ВерсияНастроекОбработки = ГлЯдро_КонвертироватьВерсиюВЧисло(РегистрационныеДанные.ВерсияСтруктурыНастроек);
		
	// ВерсияНастроек_ПоУмолчанию
	ВерсияНастроек = ЗначениеНастройки.ВерсияНастроек;
	ВерсияНастроек_ПоУмолчанию = ГлЯдро_КонвертироватьВерсиюВЧисло(ВерсияНастроек);
										
	ИзмененияВКэше = Новый Структура("НастройкиБизнесПроцессов_ПоУмолчанию", ЗначениеНастройки);
	Если ВерсияНастроекОбработки > ВерсияНастроек_ПоУмолчанию Тогда
		
		АдресаПеременных = Новый Структура("НовыеНастройкиБизнесПроцессов, ЭтоФоновоеЗадание", Истина, Истина);
		Если ГлЯдро_ВыполнитьОбработчикОбновления(ВерсияНастроек_ПоУмолчанию, Истина, ИзмененияВКэше,, АдресаПеременных) = Истина Тогда
			
			НоваяВерсияНастроек = ГлЯдро_КонвертироватьВерсиюВСтроку(ИзмененияВКэше.ВерсияОбработкиКлеверенсТСД);
			ИзмененияВКэше.НастройкиБизнесПроцессов_ПоУмолчанию.Вставить("ВерсияНастроек", НоваяВерсияНастроек);
			
		Иначе
			Если ИзмененияВКэше.Свойство("ВерсияОбработкиКлеверенсТСД") Тогда
				НоваяВерсияНастроек = ГлЯдро_КонвертироватьВерсиюВСтроку(ИзмененияВКэше.ВерсияОбработкиКлеверенсТСД);
			КонецЕсли;
			Сообщить("Отказ. Не удалось обновить бизнес-процессы до последней версии: " +  РегистрационныеДанные.ВерсияСтруктурыНастроек 
				+ ". Бизнес-процессы обновлены с: " + ВерсияНастроек + " до: " + НоваяВерсияНастроек);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Сообщить("Бизнес-процессы обновлены с: " + ВерсияНастроек + " до: " + НоваяВерсияНастроек);
		
	КонецЕсли;
	
	// Обновляем описание ТЧ
	Если ИзмененияВКэше.НастройкиБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов.Количество()
		И ИзмененияВКэше.НастройкиБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов[0].Свойство("ЭтоТаблицаЗначений") Тогда
		
		ОписаниеТЧ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов());
		ИзмененияВКэше.НастройкиБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов[0] = ОписаниеТЧ;
		
	КонецЕсли;
	
	СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию", ИзмененияВКэше.НастройкиБизнесПроцессов_ПоУмолчанию)
	
КонецПроцедуры 

Процедура ГлЯдро_ОбновлениеXML_ОбновитьНастройкиОбменаСправочников(СтруктураНастроек, УдаляемыеНастройки)
	
	НастройкиОбменаСправочников = Неопределено;
	СтруктураНастроек.Свойство("НастройкиОбменаСправочников_ПоУмолчанию", НастройкиОбменаСправочников);
	
	НовыеНастройкиОбменаСправочников = Новый Массив;
	ОписаниеТЗ = ГлЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников());
	НовыеНастройкиОбменаСправочников.Добавить(ОписаниеТЗ);
	
	Если ТипЗнч(НастройкиОбменаСправочников) = Тип("Массив") Тогда
		Для каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл
			
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			НоваяСтрока.Типовой = Истина;
			НовыеНастройкиОбменаСправочников.Добавить(НоваяСтрока);
			
		КонецЦикла;
	КонецЕсли;
	
	СоответствиеКлючейВыгружатьСразу = ГлЯдро_СоответствиеСправочниковКлючамВыгружатьСразу();
	Для каждого КлючЗначение Из СоответствиеКлючейВыгружатьСразу Цикл
		
		ИмяСправочника = КлючЗначение.Ключ;
		ИмяКлючаВыгружатьСразу = КлючЗначение.Значение;
		
		Отбор = Новый Структура("ИмяТаблицы", ИмяСправочника);
		НоваяСтрока = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НовыеНастройкиОбменаСправочников, Отбор, Истина);
		
		Если НоваяСтрока = Неопределено Тогда
			НоваяСтрока = ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			НоваяСтрока.ИмяТаблицы 	= ИмяСправочника;
			НоваяСтрока.Типовой 	= Истина;
			НовыеНастройкиОбменаСправочников.Добавить(НоваяСтрока);
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство(ИмяКлючаВыгружатьСразу) Тогда
			НоваяСтрока.Выгружать = СтруктураНастроек[ИмяКлючаВыгружатьСразу] = Истина;
		КонецЕсли;
		
		УдаляемыеНастройки.Добавить(ИмяКлючаВыгружатьСразу);
		
	КонецЦикла;
	
	СтруктураНастроек.Вставить("НастройкиОбменаСправочников_ПоУмолчанию", НовыеНастройкиОбменаСправочников);
	
КонецПроцедуры 

// Служебный метод для чтения настроек из файлов customsettings и default_customsettings
Процедура ГлЯдро_ПрочитатьНастройкиИзФайлаCustomSettings(АдресФайла, СтруктураНастроек, ПолучитьВсе = Ложь) Экспорт
	
	URIПространстваИмен = "http://schemas.cleverence.ru/clr";
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	ПутьКФайлу = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ПутьКФайлу);
	
	// Читаем XML через DOM
	ПостроительDOM = Новый ПостроительDOM;
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		Сообщить("Не удалось прочитать файл: " + ПутьКФайлу);
		УдалитьФайлы(ПутьКФайлу);
		Возврат;
	КонецПопытки;
	
	// Находим корневой элемент и контейнер для настроек
	КорневойУзел = ДокументDOM.ДочерниеУзлы[0];
	Если КорневойУзел = Неопределено Тогда
		Сообщить("Неверная структура XML файла");
		УдалитьФайлы(ПутьКФайлу);
		Возврат;
	КонецЕсли;
	
	// Определяем структуру файла и находим контейнер настроек
	// Структура платформы 3: SettingsValueList -> SettingsValueNode (прямо в корне)
	// Структура платформы 4: SettingsStorageModel -> Settings -> Setting
	КонтейнерНастроек = Неопределено;
	ИмяКорневогоУзла = КорневойУзел.ИмяУзла;
	
	Если ИмяКорневогоУзла = "SettingsValueList" Тогда // Платформа 3
		
		// В этой структуре элементы SettingsValueNode находятся прямо в корне
		КонтейнерНастроек = КорневойУзел;
		ИмяУзлаНастроек = "SettingsValueNode";
		
	ИначеЕсли ИмяКорневогоУзла = "SettingsStorageModel" Тогда // Платформа 4
		
		// Ищем контейнер Settings внутри SettingsStorageModel
		Для каждого ДочернийУзел Из КорневойУзел.ДочерниеУзлы Цикл
			Если ДочернийУзел.ИмяУзла = "Settings" Тогда
				КонтейнерНастроек = ДочернийУзел;
				ИмяУзлаНастроек = "Setting";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если КонтейнерНастроек = Неопределено Тогда
		УдалитьФайлы(ПутьКФайлу);
		Возврат;
	КонецЕсли;
	
	УзлыНастроек = КонтейнерНастроек.ПолучитьЭлементыПоИмени(ИмяУзлаНастроек);
	
	// Ищем признак использования атрибутов
	ИспользуютсяАтрибуты = Ложь;
	Если ИмяКорневогоУзла = "SettingsStorageModel" Тогда
		
		ВерсияСтруктурыАтрибутов = 0;
		
		Для каждого УзелНастройки Из УзлыНастроек Цикл
			ИмяНастройки = УзелНастройки.ПолучитьАтрибут("name");
			Если ИмяНастройки = "ВерсияСтруктурыАтрибутов_ПоУмолчанию"
				ИЛИ ИмяНастройки = "ВерсияСтруктурыАтрибутов_Пользовательские" Тогда
				
				ЭлементыValue = УзелНастройки.ПолучитьЭлементыПоИмени("Value");
				Для каждого УзелValue Из ЭлементыValue Цикл
					ЗначениеУзла = ГлЯдро_ПолучитьЗначениеУзлаValue(УзелValue, URIПространстваИмен);
				КонецЦикла;
				
				Если ЗначениеУзла <> Неопределено
					И ТипЗнч(ЗначениеУзла) = Тип("Число") Тогда
					ВерсияСтруктурыАтрибутов = ЗначениеУзла;
				КонецЕсли;
				
				ИспользуютсяАтрибуты = Истина;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ИспользуютсяАтрибуты Тогда
			
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
			
			УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
			НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
			НастройкиПоУмолчанию = КатегорииНастроекMS.НастройкиПоУмолчанию;
			
			АдресаПеременных = Новый Структура;
			АтрибутыНастроекMS = ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктурыАтрибутов, АдресаПеременных);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Находим все узлы настроек (Setting и SettingsValueNode) и читаем их значения
	Для каждого УзелНастройки Из УзлыНастроек Цикл
		
		ИмяНастройки = УзелНастройки.ПолучитьАтрибут("name");
		Если ИмяНастройки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверка, если попадется ключ с недопустимыми символами в имени
		Попытка
			пСтруктура = Новый Структура(ИмяНастройки);
		Исключение
			Продолжить;
		КонецПопытки;
		
		// Если атрибуты используются, то узлов Value может быть несколько, иначе только один
		УзлыValue = УзелНастройки.ПолучитьЭлементыПоИмени("Value");
		Для каждого УзелValue Из УзлыValue Цикл
			
			Если ИспользуютсяАтрибуты 
				И АтрибутыНастроекMS <> Неопределено Тогда
				
				// Собираем соответствие, как как из ответа REST
				СоответствиеАтрибутов = ГлЯдро_ПолучитьСоответствиеАтрибутовУзлаValue(УзелValue, АтрибутыНастроекMS);
				ИмяНастройки = REST_API_ПолучитьКлючНастройкиПоАтрибутам(СоответствиеАтрибутов,, АтрибутыНастроекMS);
				
				nodeId = СоответствиеАтрибутов.Получить("nodeId");
				Если nodeId <> Неопределено И nodeId <> "Empty" Тогда
					ИмяНастройки = ИмяНастройки + "_" + nodeId;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ПолучитьВсе ИЛИ СтруктураНастроек.Свойство(ИмяНастройки) Тогда
				ЗначениеУзла = ГлЯдро_ПолучитьЗначениеУзлаValue(УзелValue, URIПространстваИмен);
				СтруктураНастроек.Вставить(ИмяНастройки, ЗначениеУзла);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	УдалитьФайлы(ПутьКФайлу);
	
КонецПроцедуры

// Метод для редактирования XML файлов customsettings и default_customsettings
// Использует DOM для возможности добавления новых нод, если их нет в файле
Функция ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресФайла, СтруктураНастроек, УдаляемыеНастройки = Неопределено) Экспорт
	
	URIПространстваИмен = "http://schemas.cleverence.ru/clr";
	
	Результат = Новый Структура("Изменен, АдресФайла", Ложь, АдресФайла);
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	ПутьКФайлу = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ПутьКФайлу);
	
	// Читаем XML через DOM
	ПостроительDOM = Новый ПостроительDOM;
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		Сообщить("Не удалось прочитать файл: " + ПутьКФайлу);
		Возврат Результат;
	КонецПопытки;
	
	// Находим корневой элемент и контейнер для настроек
	КорневойУзел = ДокументDOM.ДочерниеУзлы[0];
	Если КорневойУзел = Неопределено Тогда
		Сообщить("Неверная структура XML файла");
		Возврат Результат;
	КонецЕсли;
	
	// Определяем структуру файла и находим контейнер настроек
	// Структура платформы 3: SettingsValueList -> SettingsValueNode (прямо в корне)
	// Структура платформы 4: SettingsStorageModel -> Settings -> Setting
	КонтейнерНастроек = Неопределено;
	ИмяКорневогоУзла = КорневойУзел.ИмяУзла;
	
	Если ИмяКорневогоУзла = "SettingsValueList" Тогда // Платформа 3
		
		// В этой структуре элементы SettingsValueNode находятся прямо в корне
		КонтейнерНастроек = КорневойУзел;
		
	ИначеЕсли ИмяКорневогоУзла = "SettingsStorageModel" Тогда // Платформа 4
		
		// Ищем контейнер Settings внутри SettingsStorageModel
		Для каждого ДочернийУзел Из КорневойУзел.ДочерниеУзлы Цикл
			Если ДочернийУзел.ИмяУзла = "Settings" Тогда
				КонтейнерНастроек = ДочернийУзел;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если КонтейнерНастроек = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИспользуютсяАтрибуты = Ложь;
	АтрибутыНастроекMS = Неопределено;
	
	КартаУзлов = Новый Соответствие;
	Если ИмяКорневогоУзла = "SettingsValueList" Тогда // Платформа 3
		
		// Проверяем также узлы с именем "SettingsValueNode"
		УзлыНастроек = КонтейнерНастроек.ПолучитьЭлементыПоИмени("SettingsValueNode");
		Для каждого УзелНастройки Из УзлыНастроек Цикл
			ИмяНастройки = УзелНастройки.ПолучитьАтрибут("name");
			Если ИмяНастройки <> Неопределено Тогда
				КартаУзлов.Вставить(ИмяНастройки, УзелНастройки);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ИмяКорневогоУзла = "SettingsStorageModel" Тогда // Платформа 4
		
		// Создаем карту существующих настроек для быстрого поиска
		УзелВерсииСтруктурыАтрибутов = Неопределено;
		УзлыНастроек = КонтейнерНастроек.ПолучитьЭлементыПоИмени("Setting");
		Для каждого УзелНастройки Из УзлыНастроек Цикл
			ИмяНастройки = УзелНастройки.ПолучитьАтрибут("name");
			Если ИмяНастройки <> Неопределено Тогда
				КартаУзлов.Вставить(ИмяНастройки, УзелНастройки);
				
				Если ИмяНастройки = "ВерсияСтруктурыАтрибутов_ПоУмолчанию"
					ИЛИ ИмяНастройки = "ВерсияСтруктурыАтрибутов_Пользовательские" Тогда
					УзелВерсииСтруктурыАтрибутов = УзелНастройки;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		// Ищем признак использования атрибутов
		Если УзелВерсииСтруктурыАтрибутов <> Неопределено Тогда
			
			// Собираем АтрибутыНастроекMS для версии атрибутов из файла
			ЭлементыValue = УзелВерсииСтруктурыАтрибутов.ПолучитьЭлементыПоИмени("Value");
			Для каждого УзелValue Из ЭлементыValue Цикл
				ЗначениеУзла = ГлЯдро_ПолучитьЗначениеУзлаValue(УзелValue, URIПространстваИмен);
			КонецЦикла;
			
			ВерсияСтруктурыАтрибутов = 0;
			Если ЗначениеУзла <> Неопределено
				И ТипЗнч(ЗначениеУзла) = Тип("Число") Тогда
				ВерсияСтруктурыАтрибутов = ЗначениеУзла;
			КонецЕсли;
			
			КатегорииНастроекMS = ГлЯдро_ПолучитьКатегорииНастроекMS();
			
			УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
			НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
			НастройкиПоУмолчанию = КатегорииНастроекMS.НастройкиПоУмолчанию;
			
			АдресаПеременных = Новый Структура;
			АтрибутыНастроекMS = ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктурыАтрибутов, АдресаПеременных);
			
			// Дополняем карту узлов узлами Value с внутренними именами ключей
			пКартаУзлов = Новый Соответствие;
			Для каждого КлючЗначение Из КартаУзлов Цикл
				
				БазовоеИмя 		= КлючЗначение.Ключ;
				УзелНастройки 	= КлючЗначение.Значение;
				пКартаУзлов.Вставить(БазовоеИмя, УзелНастройки);
				
				УзлыValue = УзелНастройки.ПолучитьЭлементыПоИмени("Value");
				Для каждого УзелValue Из УзлыValue Цикл
					СоответствиеАтрибутов = ГлЯдро_ПолучитьСоответствиеАтрибутовУзлаValue(УзелValue, АтрибутыНастроекMS);
					ИмяНастройки = REST_API_ПолучитьКлючНастройкиПоАтрибутам(СоответствиеАтрибутов,, АтрибутыНастроекMS);
					
					nodeId = СоответствиеАтрибутов.Получить("nodeId");
					Если nodeId <> Неопределено И nodeId <> "Empty" Тогда
						ИмяНастройки = ИмяНастройки + "_" + nodeId;
					КонецЕсли;
					
					Если БазовоеИмя <> ИмяНастройки Тогда
						пКартаУзлов.Вставить(ИмяНастройки, УзелValue);
					Иначе
						// Т.к атрибуты не используются, то отдельно сохраним узел value,
						// 	чтобы не искать его повторно
						пКартаУзлов.Вставить(ИмяНастройки + "_Value", УзелValue); 
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			КартаУзлов = пКартаУзлов;
			
			ИспользуютсяАтрибуты = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Сериализуем настройки
	СтруктураНастроек = ГлЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, "ВСтроку");
	
	// Обрабатываем каждую настройку из структуры
	Для каждого КлючЗначение Из СтруктураНастроек Цикл
		
		ИмяНастройки 		= КлючЗначение.Ключ;
		ЗначениеНастройки 	= КлючЗначение.Значение;
		ТипЗначения 		= ТипЗнч(ЗначениеНастройки);
		НужныйТипАтрибут 	= ГлЯдро_ОпределитьТипАтрибутаClrType(ТипЗначения, ИмяКорневогоУзла);
		
		// Конвертируем значения настроек в JSON формат
		Если ТипЗначения = Тип("Дата") Тогда
			ТекстовоеСодержимое = ЗаписатьДатуJSON(ЗначениеНастройки, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата);
			
		ИначеЕсли ТипЗначения = Тип("Булево") Тогда
			ТекстовоеСодержимое = ?(ЗначениеНастройки, "True", "False");
			
		ИначеЕсли ТипЗначения = Тип("Число") Тогда
			ТекстовоеСодержимое = Формат(ЗначениеНастройки, "ЧРД=.; ЧГ=");
			
		ИначеЕсли ТипЗначения = Тип("Строка") Тогда
			ТекстовоеСодержимое = ЗначениеНастройки;
			
		Иначе
			
			ТекстовоеСодержимое = ГлЯдро_ЗначениеВСтрокуXML(ЗначениеНастройки);
			Если ТекстовоеСодержимое = Неопределено Тогда
				ТекстовоеСодержимое = Строка(ЗначениеНастройки);
			КонецЕсли;
			
		КонецЕсли;
		
		// Разбираем имя ключа на атрибуты
		БазовоеИмя = ИмяНастройки;
		ЭтоНастройкаСАтрибутами = Ложь;
		Если ИспользуютсяАтрибуты Тогда
			
			ЭтоНастройкаСАтрибутами = НЕ НастройкиСАтрибутами.Найти(ИмяНастройки) = Неопределено;
			Если ЭтоНастройкаСАтрибутами Тогда				
				СоответствиеАтрибутов = REST_API_ПолучитьАтрибутыПоКлючуНастройки(ИмяНастройки, АтрибутыНастроекMS);
				БазовоеИмя = СоответствиеАтрибутов.Получить("name");								
			КонецЕсли;
			
		КонецЕсли;
		
		УзелНастройки = КартаУзлов.Получить(БазовоеИмя);
		
		// Настройка не существует - создаем новую
		Если УзелНастройки = Неопределено Тогда
			
			// Определяем имя элемента на основе существующих узлов
			ИмяЭлементаНастройки = ?(ИмяКорневогоУзла = "SettingsValueList", "SettingsValueNode", "Setting");
			
			// Создаем новый узел настройки
			НовыйУзелНастройки = ДокументDOM.СоздатьЭлемент(ИмяЭлементаНастройки);
			НовыйУзелНастройки.УстановитьАтрибут("name", БазовоеИмя);
			
			// Для структуры SettingsValueNode нужно добавить узлы List и SortedDictionary
			Если ИмяЭлементаНастройки = "SettingsValueNode" Тогда // Платформа 3
				УзелList = ДокументDOM.СоздатьЭлемент("List");
				НовыйУзелНастройки.ДобавитьДочерний(УзелList);
				
				УзелSortedDictionary = ДокументDOM.СоздатьЭлемент("SortedDictionary");
				УзелSortedDictionary.ТекстовоеСодержимое = "null";
				НовыйУзелНастройки.ДобавитьДочерний(УзелSortedDictionary);
			КонецЕсли;
						
			// Добавляем новый узел в контейнер (в конец)
			КонтейнерНастроек.ДобавитьДочерний(НовыйУзелНастройки);
			УзелНастройки = НовыйУзелНастройки;
			
			Результат.Изменен = Истина;
			
		КонецЕсли;
		
		// Ищем подходящий узел Value для обновления значения
		Если БазовоеИмя = ИмяНастройки Тогда
			УзелValueДляОбновления = КартаУзлов.Получить(ИмяНастройки + "_Value");
		Иначе
			УзелValueДляОбновления = КартаУзлов.Получить(ИмяНастройки);
		КонецЕсли;
		
		Если УзелValueДляОбновления = Неопределено Тогда
			
			// Создаем узел Value
			НовыйУзелValue = ДокументDOM.СоздатьЭлемент("Value");
			НовыйУзелValue.ТекстовоеСодержимое = ТекстовоеСодержимое;
			
			// Добавляем атрибуты
			Если ЭтоНастройкаСАтрибутами Тогда
				Для каждого ДанныеАтрибута Из СоответствиеАтрибутов Цикл
					Если ДанныеАтрибута.Ключ <> "name" Тогда
						НовыйУзелValue.УстановитьАтрибут(ДанныеАтрибута.Ключ, ДанныеАтрибута.Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ИмяКорневогоУзла = "SettingsStorageModel" Тогда
				НовыйУзелValue.УстановитьАтрибут("Uid", Строка(Новый УникальныйИдентификатор()));
			КонецЕсли;
			
			// Добавляем атрибут clr:Type, если он нужен
			Если НужныйТипАтрибут <> Неопределено Тогда
				НовыйУзелValue.УстановитьАтрибут(URIПространстваИмен, "clr:Type", НужныйТипАтрибут);
			КонецЕсли;
			
			УзелНастройки.ДобавитьДочерний(НовыйУзелValue);
			УзелValueДляОбновления = НовыйУзелValue;
			
		КонецЕсли;
		
		// Обновляем значение узла Value
		УзелValueДляОбновления.ТекстовоеСодержимое = ТекстовоеСодержимое;
		
		// Обновляем атрибут clr:Type, если он изменился или отсутствует, но должен быть
		ТекущийТипАтрибут = УзелValueДляОбновления.ПолучитьАтрибут(URIПространстваИмен, "Type");
		Если НужныйТипАтрибут <> Неопределено Тогда
			Если ТекущийТипАтрибут <> НужныйТипАтрибут Тогда
				УзелValueДляОбновления.УстановитьАтрибут(URIПространстваИмен, "clr:Type", НужныйТипАтрибут);
			КонецЕсли;
		ИначеЕсли ТекущийТипАтрибут <> Неопределено Тогда
			// Атрибут есть, но для нового типа он не нужен - удаляем
			УзелValueДляОбновления.УдалитьАтрибут(URIПространстваИмен, "Type");
		КонецЕсли;
		
		Результат.Изменен = Истина;
		
	КонецЦикла;
	
	// Удаляем настройки из массива УдаляемыеНастройки
	Если УдаляемыеНастройки <> Неопределено И УдаляемыеНастройки.Количество() > 0 Тогда
		Для каждого ИмяУдаляемойНастройки Из УдаляемыеНастройки Цикл
			
			УзелДляУдаления = КартаУзлов.Получить(ИмяУдаляемойНастройки);
			Если УзелДляУдаления <> Неопределено Тогда
				
				ИмяНастройки = УзелДляУдаления.ПолучитьАтрибут("name");
				Если ИмяНастройки = Неопределено Тогда
					// Это узел Value
					ЭлементыValue = УзелДляУдаления.РодительскийУзел.ПолучитьЭлементыПоИмени("Value");
					Если ЭлементыValue.Количество() <= 1 Тогда
						// Если это единственный узел Value, то удаляем РодительскийУзел из контейнера
						//	т.к он останется пустым.
						КонтейнерНастроек.УдалитьДочерний(УзелДляУдаления.РодительскийУзел);
					Иначе
						// Если есть другие узлы Value, то удалим только нужный
						УзелДляУдаления.РодительскийУзел.УдалитьДочерний(УзелДляУдаления);
					КонецЕсли;
					
				Иначе
					// Удаляем узел из контейнера
					КонтейнерНастроек.УдалитьДочерний(УзелДляУдаления);
				КонецЕсли;
				
				// Удаляем из карты, чтобы не обрабатывать повторно
				КартаУзлов.Удалить(ИмяУдаляемойНастройки);
				
				Результат.Изменен = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	// Обновляем атрибут count в корневом элементе для платформы 3 (SettingsValueList)
	Если Результат.Изменен И ИмяКорневогоУзла = "SettingsValueList" Тогда
		УзлыНастроек = КонтейнерНастроек.ПолучитьЭлементыПоИмени("SettingsValueNode");
		КорневойУзел.УстановитьАтрибут("count", Строка(УзлыНастроек.Количество()));
	КонецЕсли;
	
	// Записываем DOM обратно в XML файл
	Если Результат.Изменен Тогда
		
		ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ВременныйФайл, "UTF-8");
		
		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
		
		ЗаписьXML.Закрыть();
		
		Если ИмяКорневогоУзла = "SettingsValueList" Тогда
			// Заменяем самозакрывающиеся теги Value на парные для пустых значений, иначе 3 платформа не читает файл
			Попытка
				ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл, "UTF-8");
				ТекстXML = ЧтениеТекста.Прочитать();
				ЧтениеТекста.Закрыть();
				
				ТекстXML = СтрЗаменить(ТекстXML, "<Value clr:Type=""String""/>", "<Value clr:Type=""String""></Value>");
				
				ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, "UTF-8");
				ЗаписьТекста.Записать(ТекстXML);
				ЗаписьТекста.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ДД = Новый ДвоичныеДанные(ВременныйФайл);
		Результат.АдресФайла = ПоместитьВоВременноеХранилище(ДД, АдресФайла);
		
		УдалитьФайлы(ВременныйФайл);
	КонецЕсли;
	
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ПолучитьСоответствиеАтрибутовУзлаValue(УзелValue, АтрибутыНастроекMS)
	
	СоответствиеАтрибутов = Новый Соответствие;
	
	БазовоеИмя = УзелValue.РодительскийУзел.ПолучитьАтрибут("name");
	
	СоответствиеАтрибутов.Вставить("name", 		БазовоеИмя);
	СоответствиеАтрибутов.Вставить("uid", 		УзелValue.ПолучитьАтрибут("Uid"));
	//СоответствиеАтрибутов.Вставить("value", 	УзелValue.ТекстовоеСодержимое);
	СоответствиеАтрибутов.Вставить("nodeId", 	УзелValue.ПолучитьАтрибут("nodeId"));
	
	СтруктураАтрибутов = АтрибутыНастроекMS.Получить(БазовоеИмя);
	Если СтруктураАтрибутов = Неопределено Тогда
		Возврат СоответствиеАтрибутов;
	КонецЕсли;
	
	// Заполним значения атрибутов из имени по совпадениям с допустимыми значениями
	Для каждого СвойстваАтрибута ИЗ СтруктураАтрибутов Цикл
		
		ЗначениеАтрибута = УзелValue.ПолучитьАтрибут(СвойстваАтрибута.Ключ);
		Если ЗначениеАтрибута = Неопределено Тогда
			ЗначениеАтрибута = "Empty";
		КонецЕсли;
		СоответствиеАтрибутов.Вставить(СвойстваАтрибута.Ключ, ЗначениеАтрибута);
		
	КонецЦикла;
	
	Возврат СоответствиеАтрибутов;
	
КонецФункции

Функция ГлЯдро_ПолучитьЗначениеУзлаValue(УзелValue, URIПространстваИмен)
	
	ЗначениеУзла = Неопределено;
	
	ТекстовоеСодержимое = УзелValue.ТекстовоеСодержимое;
	Если ЗначениеЗаполнено(ТекстовоеСодержимое) Тогда
		
		ТипАтрибут = УзелValue.ПолучитьАтрибут(URIПространстваИмен, "Type");
		
		Если ТипАтрибут = "Boolean" Тогда
			ЗначениеУзла = ТекстовоеСодержимое = "True";
		ИначеЕсли ТипАтрибут = "Decimal" Тогда
			Попытка
				ЗначениеУзла = Число(ТекстовоеСодержимое);
			Исключение
			КонецПопытки;
		ИначеЕсли ТипАтрибут = "DateTime" Тогда
			Попытка
				ЗначениеУзла = ПрочитатьДатуJSON(ТекстовоеСодержимое, ФорматДатыJSON.ISO);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеУзла = Неопределено Тогда
			ЗначениеУзла = ГлЯдро_ЗначениеИзСтрокиXML(ТекстовоеСодержимое);
			Если ЗначениеУзла = Неопределено Тогда
				ЗначениеУзла = ТекстовоеСодержимое;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначениеУзла;
	
КонецФункции

// Вспомогательная функция для определения типа атрибута clr:Type
// Для платформы 3 (SettingsValueList) возвращает тип для всех типов значений
// Для платформы 4 (SettingsStorageModel) возвращает тип только для булево
Функция ГлЯдро_ОпределитьТипАтрибутаClrType(ТипЗначения, ИмяКорневогоУзла)
	
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат "Boolean";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "Decimal";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "DateTime";
	ИначеЕсли ИмяКорневогоУзла = "SettingsValueList" Тогда
		Возврат "String"; // Тип String используется только в платформе 3
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Метод для поиска дублированных полей, выключенные поля не учитываются.
Процедура ГлЯдро_НайтиНеиспользуемыеНастройкиПолей(ИмяНастройки, МассивПолей, ЕстьДубли, СообщениеДублей)
	
	ИспользуемыеИменаПолей = Новый Соответствие;
	УдаляемыеПоля = Новый Массив;
	
	// Группируем по типам источников
	ИндексыРеквизит = Новый Массив;
	ИндексыПроизвольноеЗначение = Новый Массив;
	ИндексыГлобальныйПараметр = Новый Массив;
	ИндексыПроизвольныйКод = Новый Массив;
	
	Для Индекс = 0 По МассивПолей.ВГраница() Цикл
		
		СтрокаПоля = МассивПолей[Индекс];
		
		Если СтрокаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (СтрокаПоля.Свойство("Выгружать") И СтрокаПоля.Выгружать <> Истина)
			ИЛИ (СтрокаПоля.Свойство("Загружать") И СтрокаПоля.Загружать <> Истина) Тогда
			УдаляемыеПоля.Добавить(Индекс);
			Продолжить;
		КонецЕсли;
		
		// Группируем по типам источников. 
		// Так как выгрузка полей происходит не по порядку полей, а по типам источника.
		ТипИсточника = СтрокаПоля.ТипИсточника;
		Если ТипИсточника = "Реквизит1С" ИЛИ ТипИсточника = "РеквизитMS" Тогда
			ИндексыРеквизит.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ПроизвольноеЗначение" Тогда
			ИндексыПроизвольноеЗначение.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ГлобальныйПараметр" Тогда
			ИндексыГлобальныйПараметр.Добавить(Индекс);
			
		ИначеЕсли ТипИсточника = "ПроизвольныйКод" Тогда
			ИндексыПроизвольныйКод.Добавить(Индекс);
			
		Иначе
			СообщениеДублей = "Неверная структура поля";
			ЕстьДубли = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	// Обходим группы индексов в обратном порядке, 
	//	так-как ПК выполняются последними, а значит затирают другие результаты. Поэтому ПК для нас важнее.
	ПорядокОбхода = Новый Массив;
	ПорядокОбхода.Добавить(ИндексыПроизвольныйКод);
	ПорядокОбхода.Добавить(ИндексыГлобальныйПараметр);
	ПорядокОбхода.Добавить(ИндексыПроизвольноеЗначение);
	ПорядокОбхода.Добавить(ИндексыРеквизит);
	
	Для каждого МассивИндексов Из ПорядокОбхода Цикл
		
		// Цикл в обратном порядке для приоритета последним полям при дубле
		Индекс = МассивИндексов.ВГраница();
		Пока Индекс >= 0 Цикл
			
			ИндексПоля = МассивИндексов[Индекс];
			СтрокаПоля = МассивПолей[ИндексПоля];
			
			Если СтрокаПоля.ТипИсточника = "РеквизитMS" И Найти(СтрокаПоля.СинонимИсточника, "Ключ связи для """) > 0 Тогда
				
				// Это поля для связи таблиц, они могут дублироваться
				ИспользуемыеИменаПолей.Вставить(СтрокаПоля.ИмяПриемника, СтрокаПоля);
				
			ИначеЕсли ИспользуемыеИменаПолей.Получить(СтрокаПоля.ИмяПриемника) <> Неопределено Тогда
				
				ПриоритетноеПоле = ИспользуемыеИменаПолей.Получить(СтрокаПоля.ИмяПриемника);
				
				// Проверка полного дубля поля
				ПолныйДубль = Истина;
				Для каждого КлючЗначение Из ПриоритетноеПоле Цикл
					Если НЕ СтрокаПоля.Свойство(КлючЗначение.Ключ) Тогда
						ПолныйДубль = Ложь;
						Прервать;
					ИначеЕсли СтрокаПоля[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
						ПолныйДубль = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				пТипИсточника = ПриоритетноеПоле.ТипИсточника;
				уТипИсточника = СтрокаПоля.ТипИсточника;
				
				Если пТипИсточника = "Реквизит1С" Тогда
					пТипИсточника = пТипИсточника  + " - " + ПриоритетноеПоле.СпособСопоставления;
				КонецЕсли;
				Если уТипИсточника = "Реквизит1С" Тогда
					уТипИсточника = уТипИсточника  + " - " + СтрокаПоля.СпособСопоставления;
				КонецЕсли;
				
				Шаблон = "Приемник: %1 – Источники: Останется: %2 (%3) – Удалится: %4 (%5)";
				СообщениеСтроки = ГлЯдро_СтрШаблон(Шаблон, СтрокаПоля.ИмяПриемника, ПриоритетноеПоле.ИмяИсточника, пТипИсточника, СтрокаПоля.ИмяИсточника, уТипИсточника);
				
				Если ПолныйДубль Тогда
					СообщениеСтроки = СообщениеСтроки + " –> Полный дубль поля";
				КонецЕсли;
				
				СообщениеДублей = СообщениеДублей + Символы.ПС + Символы.Таб + СообщениеСтроки;
				
				ЕстьДубли =  Истина;
				
			Иначе
				
				// TODO возможно следует добавить поддержку нескольких ключей уникальности
				// 	 - КлючиУникальности = ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
				ИспользуемыеИменаПолей.Вставить(СтрокаПоля.ИмяПриемника, СтрокаПоля);
				
			КонецЕсли;
			
			Индекс = Индекс - 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СообщениеДублей = СокрЛП(СообщениеДублей);
	
КонецПроцедуры 

#КонецОбласти

#Область ГлобальныйКонтекст_МеханизмыИзБСП

// Возвращает текстовое представление интервала времени, заданного в секундах.
//
// Параметры:
//	Время - Число - интервал времени в секундах.
//	ПолноеПредставление	- Булево - кратное или полное представление времени.
//		Например, интервал 1 000 000 секунд:
//			- полное представление:  11 дней 13 часов 46 минут 40 секунд;
//			- краткое представление: 11 дней 13 часов.
//
// Возвращаемое значение:
//	Строка - представление интервала времени.
