Функция ГлЯдро_СерверКачества_РучноеФормированиеОтчетаОбОшибках(ДанныеОбращения, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СерверКачества_РучноеФормированиеОтчетаОбОшибках";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеОбращения",
		ДанныеОбращения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ГлЯдро_СерверКачества_ПроверитьДоступностьСервера(АдресаПеременных) = Ложь Тогда
		Результат = Новый Структура;
		Результат.Вставить("ОтчетОтправлен", Ложь);
		Результат.Вставить("НомерОбращения");
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	ДанныеЖурнала = ГлЯдро_СерверКачества_ОтобратьОшибкиЖурналаРегистрации(ДанныеОбращения.ДатаТекущейПроверки, ДанныеОбращения.ГлубинаОтбора, Истина);
	ОшибкиСтрокой = ГлЯдро_СерверКачества_СформироватьТекстЛогаИзТаблицы(ДанныеЖурнала, АдресаПеременных);
	ДанныеОбращения.Вставить("ОшибкиСтрокой", ОшибкиСтрокой);
	
	Результат = ГлЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер(ДанныеОбращения, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

