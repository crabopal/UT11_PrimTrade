								ТаблицаБыстрогоДоступа = ГлЯдро_ЗаполнитьПолучитьБыстрыйДоступВнешнейОбработкиОтчета(ОбъектСправочника, ДобавитьВБыстрыйДоступТекПользователя, ПеренестиБыстрыйДоступИзПредыдущейВерсии, ПредыдущаяПодключеннаяОбработка);
							Исключение
								// <Лог>
								ИнфоОшибка = ИнформацияОбОшибке();
								ЯзСтрока = "ru = 'Ошибка заполнения быстрого доступа для файла %1';
													|en = 'Error filling in the shortcut for the %1 file'; be = 'Памылка запаўнення хуткага доступу для файла %1'; es = 'Error al rellenar el acceso rápido para el archivo %1'; ka = 'შეცდომა შევსების მალსახმობი %1 ფაილი'; kk = '%1 файлы үшін жылдам қатынауды толтыру қатесі'; ro = 'Eroare la completarea comenzii rapide pentru fișierul %1'; tr = '%1 dosyası için hızlı erişim doldurma hatası'; uk = 'Помилка заповнення швидкого доступу для файлу %1'; uz = '%1 fayli uchun tezkor kirishni to''ldirishda xato'";
								пСообщение = ГлЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяФайла);
								
								логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
									"ИмяФайла",
									ИмяФайла);
								ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка,, АдресаПеременных);
								// </Лог>
							КонецПопытки;

							ОбъектСправочника.Записать();
							
							ОбработкаСсылка = ОбъектСправочника.Ссылка;
							
							// В некоторых конфигурациях при записи объекта быстрый доступ не записывется в регистр. Попробуем записать его напрямую
