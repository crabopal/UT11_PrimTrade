Функция REST_API_ЗагрузкаПользователей_ВыполнитьЗапрос(ПараметрыЭлемента, ТипБазы, АдресаПеременных, HTTPМетод, Метод, ТипЗапроса, ИмяСобытия)
	
	ИмяСобытия = "REST_API_ЗагрузкаПользователей_ВыполнитьЗапрос";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЭлемента,ТипБазы,HTTPМетод,Метод,ТипЗапроса,ИмяСобытия",
		ПараметрыЭлемента, ТипБазы, HTTPМетод, Метод, ТипЗапроса, ИмяСобытия);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	// Посылаем запрос на сервер
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	HTTPМетод);
	СтруктураЗапроса.Вставить("Метод", 		Метод);
	СтруктураЗапроса.Вставить("ТипЗапроса", ТипЗапроса);
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ПараметрыЭлемента, АдресаПеременных);
		
	Ответ = Новый Структура("Результат, ТекстОшибки", Истина, "");
		
	// Обрабатываем ответ сервера
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Ответ.Результат = Ложь;
		
		ТекстОшибки = "";		
		
		error = СтруктураОтвета.ОтветСервера.Получить("error");
		Если error <> Неопределено И ТипЗнч(error) = Тип("Соответствие") Тогда    
			innererror = error.Получить("innererror");
			Если innererror <> Неопределено И ТипЗнч(innererror) = Тип("Соответствие") Тогда    			
				ТекстОшибки = "{" + innererror.Получить("message") + "}";	
			Иначе                                                      
				ТекстОшибки = СтруктураОтвета.ОтветСервераНеРасшифрованный;
			КонецЕсли;
		Иначе
			ТекстОшибки = СтруктураОтвета.ОтветСервераНеРасшифрованный;
		КонецЕсли; 	                     	
		Ответ.ТекстОшибки 	= ТекстОшибки;
	КонецЕсли;   
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ответ);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Ответ;
	
КонецФункции

Функция REST_API_ПолучитьСписокСлужебныхДокументовMS(ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ПолучитьСписокСлужебныхДокументовMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	// Посылаем запрос на сервер
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"DocTypes?$expand=tables");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		DocumentTypes = Неопределено;	
	Иначе
		DocumentTypes = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	СлужебныеДокументыMS = Новый СписокЗначений;
	
	Если DocumentTypes <> Неопределено Тогда
		Для Каждого ТипДокумента из DocumentTypes Цикл			
			
			Если Не ТипДокумента.Получить("virtual") Тогда
				Продолжить;
			КонецЕсли;                                		
			
			СлужебныеДокументыMS.Добавить(ТипДокумента.Получить("name"), ТипДокумента.Получить("displayName"));
			
		КонецЦикла;		
	КонецЕсли;	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СлужебныеДокументыMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СлужебныеДокументыMS;
	
КонецФункции

Функция REST_API_ОбновитьМетаданныеПользователейMS(ТипБазы, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ОбновитьМетаданныеПользователейMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Users");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		Users = Неопределено;	
	Иначе
		Users = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	СписокПользователейMS = Новый СписокЗначений;
	
	СписокПользователейMS.Добавить("Выгружать всем;Выгружать всем"); 	
	СписокПользователейMS.Добавить("Спрашивать при выгрузке;Спрашивать при выгрузке");	
	Если Users <> Неопределено Тогда
		Для Каждого ТекущийПользователь ИЗ Users Цикл
			Попытка
				СписокПользователейMS.Добавить(ТекущийПользователь.Получить("id") + ";" + ТекущийПользователь.Получить("name"), ТекущийПользователь.Получить("groupId") + ";" + ТекущийПользователь.Получить("groupName"));
			Исключение
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
				// </Лог>
			КонецПопытки;
		КонецЦикла;	
	КонецЕсли;
	
	ПользователиMSАдрес = ГлЯдро_ДеревоПользователейВоВременноеХранилище(СписокПользователейMS);
	
	ГлЯдро_ОбновитьМетаданныеПользователейMSВХранилище1С(СписокПользователейMS, ПользователиMSАдрес, АдресаПеременных);
	
	АдресМетаданных = ?(ПользователиMSАдрес = Неопределено, "", ПользователиMSАдрес);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресМетаданных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат АдресМетаданных;
		
КонецФункции

Функция REST_API_ПолучитьСписокРеквизитовСущностиMS(СущностьMS, ДополнительныйСписок = Неопределено, ИсключатьВычисляемые = Ложь)
	
	ИмяСобытия = "REST_API_ПолучитьСписокРеквизитовСущностиMS";
	СписокРеквизитов = Новый Массив;
	
	Для Каждого ДанныеРеквизита ИЗ СущностьMS Цикл 
		Если НЕ ДанныеРеквизита.Получить("readOnly") = Истина Тогда
			Если ИсключатьВычисляемые
				И ЗначениеЗаполнено(ДанныеРеквизита.Получить("valueTemplate")) Тогда
				Продолжить;
			КонецЕсли;
			
			fieldName = ДанныеРеквизита.Получить("fieldName");
			displayName = ДанныеРеквизита.Получить("displayName");
			uni = ДанныеРеквизита.Получить("uni");
			
			Если ГлЯдро_ПроверитьПервыйСимволНаЦифру(fieldName) 
				Или ГлЯдро_ПроверитьПервыйСимволНаЦифру(uni) Тогда
				пСообщение = НСтр("ru = 'Реквизит %1 нельзя использовать в интеграции с 1С. Имя реквизита не должно начинаться с цифры.';
									|en = 'The %1 banking details cannot be used in integration with 1C. The name of the prop must not start with a number.';
									|be = 'Рэквізіт %1 нельга выкарыстоўваць у інтэграцыі з 1С. імя рэквізіту не павінна пачынацца з лічбы.'; es = 'Los apoyos %1 no se pueden usar en la integración con 1C. El nombre de los apoyos no debe comenzar con un número.'; ka = '%1 საბანკო დეტალები არ შეიძლება გამოყენებულ იქნას 1c-თან ინტეგრაციაში. რეკვიზიტის სახელი არ უნდა დაიწყოს ნომრით.'; kk = '%1 деректемесін 1С интеграциясында қолдануға болмайды.'; ro = 'Contul %1 nu poate fi utilizat în integrarea cu 1C. numele contului nu trebuie să înceapă cu o cifră.'; tr = '1C ile entegrasyonda %1 sahne kullanılamaz. Sahne adı bir rakamla başlamamalıdır.'; uk = 'Реквізит %1 не можна використовувати в інтеграції з 1С. Ім''я реквізиту не повинно починатися з цифри.'; uz = '1C bilan integratsiyada %1 rekvizitidan foydalanish mumkin emas.rekvizit nomi raqam bilan boshlanmasligi kerak.'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, fieldName);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение,, Неопределено);
				Продолжить;
			КонецЕсли;
			
			Если ПустаяСтрока(displayName) Тогда
				displayName = fieldName;
			КонецЕсли;
			
			СписокРеквизитов.Добавить(Новый Структура("Значение,Ключ,Uni,Имя", fieldName, displayName, ГлЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(uni), fieldName));
		КонецЕсли;
	КонецЦикла;
	
	Если ДополнительныйСписок <> Неопределено Тогда
		Для Каждого ДополнительныйЭлемент Из ДополнительныйСписок Цикл
			СписокРеквизитов.Добавить(ДополнительныйЭлемент);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокРеквизитов;
	
КонецФункции

Процедура REST_API_ЗаписатьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS, ID_Узла = "", СтруктураНастроекДляКэширования, ДополнительныеПараметры = Неопределено, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ЗаписатьНастройкиSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,КатегорииНастроекMS,ID_Узла,СтруктураНастроекДляКэширования,ДополнительныеПараметры",
		СтруктураНастроек, КатегорииНастроекMS, ID_Узла, СтруктураНастроекДляКэширования, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если СтруктураНастроек.Количество() = 0 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеКэшировать 			= ДополнительныеПараметры.Свойство("НеКэшировать") И ДополнительныеПараметры.НеКэшировать;
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
	НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
	ИспользуютсяАтрибуты = ВерсияAPI = 2;
	
	АтрибутыНастроекMS = Неопределено;
	Если ИспользуютсяАтрибуты Тогда
		Если НЕ ДополнительныеПараметры.Свойство("АтрибутыНастроекMS", АтрибутыНастроекMS) Тогда
			АтрибутыНастроекMS = ГлЯдро_ПолучитьАтрибутыНастроекMS(,, АдресаПеременных);
		КонецЕсли;
		
		Если АтрибутыНастроекMS = Неопределено Тогда
			ИспользуютсяАтрибуты = Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	//Обновляем дату актуальности настроек, чтобы при последующем онлайн-вызове были получены сохраненные настройки.
	ИзменилисьКлючевыеНастройки = Ложь;
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("НастройкиОтборовУзлов_Онлайн");
	МассивИсключений.Добавить("НастройкиБизнесПроцессов_Пользовательские");
	МассивИсключений.Добавить("НастройкиОбменаСправочников");
	МассивИсключений.Добавить("НастройкиОтборовСправочников_Онлайн");
	МассивИсключений.Добавить("ИспользоватьШаблоныВесовогоТовара");
	МассивИсключений.Добавить("ПрефиксКодаВесовогоТовара");
	МассивИсключений.Добавить("ЧислоЗнаковПослеЗапятойВесТовара");
	МассивИсключений.Добавить("ДлинаКодаВесовогоТовара");
	МассивИсключений.Добавить("ПрефиксВключенВКодВесовогоТовара");
	МассивИсключений.Добавить("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента");
	МассивИсключений.Добавить("ЗначенияПараметровУзлов");
	МассивИсключений.Добавить("ГлобальныеПараметры_Значения");
	МассивИсключений.Добавить("ГлобальныеПараметры");
	МассивИсключений.Добавить("ГлобальныеПараметры_Пользовательские");
	МассивИсключений.Добавить("НастройкиБизнесПроцессов_ПользовательскиеНастройки");
	МассивИсключений.Добавить("РежимОтладки");
	МассивИсключений.Добавить("ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов");
	
	ИзменилисьКэшируемыеНастройки = Ложь;
	МассивИсключенийКэшируемыеНастройки = Новый Массив; // Ключевые настройки для оффлайна в дополнение к МассивИсключений
	МассивИсключенийКэшируемыеНастройки.Добавить("НастройкиОтборовУзлов_Интерактивный");
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS",АдресаПеременных);
	
	Для Каждого Настройка Из СтруктураНастроек Цикл
		ОтправляемыеДанные = Новый Соответствие;
		ИтоговыйКлючНастройки = Настройка.Ключ;
		
		// Если мы пытаемся отключить сжатие данных, саму настройку уже нужно сохранять без сжатия данных
		Если Настройка.Ключ = "ОтключитьСжатиеДанных"
			И Настройка.Значение = Истина Тогда
			ГлЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьСжатиеДанных", Истина, АдресаПеременных);
		КонецЕсли;
		
		Если НЕ ИзменилисьКлючевыеНастройки
			И МассивИсключений.Найти(Настройка.Ключ) <> Неопределено Тогда
			ИзменилисьКлючевыеНастройки = Истина;
			пСообщение = НСтр("ru = 'Изменение ключевых настроек, изменена настройка: %1';
								|en = 'Key settings have been changed, the setting has been changed: %1';
								|be = 'Змена ключавых налад, змененая налада: %1'; es = 'Cambio de configuración clave, cambio de configuración: %1'; ka = 'შეიცვალა ძირითადი პარამეტრები, შეიცვალა პარამეტრი: %1'; kk = 'Негізгі параметрлерді өзгертіңіз, параметр өзгертілді: %1'; ro = 'Setările cheilor au fost modificate, setarea a fost modificată: %1'; tr = 'Anahtar ayarları değiştiriliyor, ayar değiştirildi: %1'; uk = 'Зміна ключових налаштувань, змінена настройка: %1'; uz = 'Asosiy sozlamalarni o''zgartirish, sozlamani o''zgartirish: %1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИтоговыйКлючНастройки);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		КонецЕсли;
		
		Если НЕ ИзменилисьКэшируемыеНастройки
			И (ИзменилисьКлючевыеНастройки ИЛИ МассивИсключенийКэшируемыеНастройки.Найти(Настройка.Ключ) <> Неопределено) Тогда
			ИзменилисьКэшируемыеНастройки = Истина;
			пСообщение = НСтр("ru = 'Изменение кэшируемых настроек, изменена настройка: %1';
								|en = 'Changing cached settings, the setting has been changed: %1';
								|be = 'Змена кэшируемых налад, зменена налада: %1'; es = 'Cambio de la configuración en caché, cambio de configuración: %1'; ka = 'ქეშირებული პარამეტრების შეცვლა, პარამეტრი შეიცვალა: %1'; kk = 'Кэштелген параметрлерді өзгертіңіз, параметр өзгертілді: %1'; ro = 'Modificarea setărilor din cache, setarea a fost modificată: %1'; tr = 'Önbelleğe alınan ayarların değiştirilmesi, ayar değiştirildi: %1'; uk = 'Зміна кешованих налаштувань, змінена настройка: %1'; uz = 'Keshlangan sozlamalarni o''zgartirish, sozlamani o''zgartirish: %1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИтоговыйКлючНастройки);
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		КонецЕсли;
		
		ЭтоУзловаяНастройка = НЕ УзловыеНастройки.Найти(Настройка.Ключ) = Неопределено;
		
		Если ИспользуютсяАтрибуты Тогда
			ЭтоНастройкаСАтрибутами = НЕ НастройкиСАтрибутами.Найти(Настройка.Ключ) = Неопределено;
			Если ЭтоНастройкаСАтрибутами Тогда
				REST_API_ПолучитьАтрибутыПоКлючуНастройки(ИтоговыйКлючНастройки, АтрибутыНастроекMS, ОтправляемыеДанные);
			Иначе
				ОтправляемыеДанные.Вставить("name", ИтоговыйКлючНастройки);
			КонецЕсли;
			
			Если ЭтоУзловаяНастройка Тогда
				ОтправляемыеДанные.Вставить("nodeId", ?(ID_Узла = "", "Empty", ID_Узла));
			КонецЕсли;
		Иначе
			Если ЭтоУзловаяНастройка Тогда			
				ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
			КонецЕсли;			
			
			ОтправляемыеДанные.Вставить("name", ИтоговыйКлючНастройки);
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Запись настройки в CustomSettings: %1';
							|en = 'Setting entry in CustomSettings: %1'; be = 'Запіс налады ў CustomSettings: %1'; es = 'Escribir la configuración en CustomSettings: %1'; ka = 'შექმნის შესვლის CustomSettings: %1'; kk = 'Customsettings ішіндегі теңшеу жазбасы: %1'; ro = 'Setarea intrării în CustomSettings: %1'; tr = 'Customsettings''e ayar girişi: %1'; uk = 'Запис налаштування в CustomSettings: %1'; uz = 'CustomSettings-da sozlash yozuvi: %1'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИтоговыйКлючНастройки);
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,,АдресаПеременных);
		
		ОтправляемыеДанные.Вставить("value", Настройка.Значение);
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
		СтруктураЗапроса.Вставить("Метод", 		"CustomSettings");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			СтруктураНастроекДляКэширования.Удалить(Настройка.Ключ);
			
			ТекстОшибки = НСтр("ru = 'Запрос: POST, CustomSettings: %1. Получен некорректный ответ от сервера, Код состояния: %2. Содержание ошибки: %3';
								|en = 'Request: POST, CustomSettings: %1. Received an incorrect response from the server, Status code: %2. Error content: %3';
								|be = 'Запыт: POST, CustomSettings: %1. Атрыманы некарэктны адказ ад сервера, Код стану: %2. Змест памылкі: %3'; es = 'Solicitud: POST, CustomSettings: %1. Se recibió una respuesta incorrecta del servidor, Código de estado: %2. Contenido del error: %3'; ka = 'მოთხოვნა: პოსტი, CustomSettings: %1. მიიღო არასწორი პასუხი სერვერიდან, სტატუსის კოდი: %2. შეცდომის შინაარსი: %3'; kk = 'Сұрау: POST, CustomSettings: %1. Серверден қате жауап алынды, күй коды: %2. Қате мазмұны: %3'; ro = 'Cerere: POST, CustomSettings: %1. Un răspuns incorect a fost primit de la server, cod de stare: %2. Conținut eroare: %3'; tr = 'Talep: POST, CustomSettings: %1. Sunucudan yanlış bir yanıt alındı, Durum kodu: %2. Hata içeriği: %3'; uk = 'Запит: POST, CustomSettings: %1. Отримано некоректну відповідь від сервера, Код стану: % 2. Зміст помилки: %3'; uz = 'So''rov: POST, CustomSettings: %1. Serverdan noto''g''ri javob olindi, holat kodi: %2. Xato tarkibi: %3'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки,
				ИтоговыйКлючНастройки, СтруктураОтвета.КодСостояния, СтруктураОтвета.ТекстОшибки);
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("ТекстСообщения", ТекстОшибки);
			
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи, АдресаПеременных);
		КонецЕсли;
	КонецЦикла;
	
	// При сохранении настроек в базу также обновляем их в настройках пользователя
	Если НЕ НеКэшировать Тогда
		ГлЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураНастроекДляКэширования, ID_Узла, АдресаПеременных);
	КонецЕсли;
	
	Если ИзменилисьКлючевыеНастройки ИЛИ ИзменилисьКэшируемыеНастройки Тогда
		Если СтруктураПодключения.Свойство("IdBaseSMARTS") Тогда
			ПостфиксБазы = СтрЗаменить(СтруктураПодключения.IdBaseSMARTS,"-","_");
		Иначе
			ПостфиксБазы = "";
		КонецЕсли;
		ДатаАктуальности = ТекущаяДата();

		Если ИзменилисьКлючевыеНастройки Тогда
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиНастроек_" + ПостфиксБазы, ТекущаяДата());
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_REST_API_ДатаАктуальностиСоединения", Неопределено);
			пСообщение = НСтр("ru = 'Сброшена дата актуальности настроек, постфикс базы: %1';
								|en = 'The date of the current settings has been reset, the database postfix is %1';
								|be = 'Скінутая дата актуальнасці налад, постфикс базы: %1'; es = 'Se ha restablecido la fecha de actualización de la configuración, postfix base: %1'; ka = 'მიმდინარე პარამეტრების თარიღი გადატვირთულია, მონაცემთა ბაზის postfix არის %1'; kk = 'Параметрлердің жаңартылған күні, базаның постфиксі қалпына келтірілді: %1'; ro = 'Data setărilor curente a fost resetată, baza de date postfix este %1'; tr = 'Ayarların güncel olduğu tarih sıfırlandı, taban sonrası düzeltme: % 1'; uk = 'Скинута дата актуальності налаштувань, постфікс бази: %1'; uz = 'Sozlamalar yangilangan sana, postfiks bazasi: %1'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ?(ПостфиксБазы = "", "<нет>", ПостфиксБазы));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
		КонецЕсли;	
			
		Если ИзменилисьКэшируемыеНастройки Тогда
			
			// ДатаАктуальностиМиграцииНастроек — дублирует ДатаАктуальностиКэшируемыхНастроек.
			// Используется для отслеживания запуска старых версий ОО.
			// Если даты не совпадают, значит выполнялся запуск версии ОО 1.7.0, и будет произведена миграция настроек.
			НастройкиКСохранению = Новый Структура;
			НастройкиКСохранению.Вставить("ДатаАктуальностиКэшируемыхНастроек", ДатаАктуальности);
			НастройкиКСохранению.Вставить("ДатаАктуальностиМиграцииНастроек", ДатаАктуальности);
			ГлЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению,,, АдресаПеременных);
			
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиКэшируемыхНастроек_" + ПостфиксБазы, ДатаАктуальности);
			ГлЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиМиграцииНастроек_" + ПостфиксБазы, ДатаАктуальности);
			
		КонецЕсли;			
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура REST_API_УдалитьНастройкиSMARTS(СтруктураНастроек, УзловыеНастройки, ID_Узла = "", АдресаПеременных)
		
	Перем ИдентификаторНастройки;
	
	ИмяСобытия = "REST_API_УдалитьНастройкиSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,УзловыеНастройки,ID_Узла",
		СтруктураНастроек, УзловыеНастройки, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	Если ВерсияAPI = 2 Тогда
		СтруктураИдентификаторов = ГлЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроек, ID_Узла,, АдресаПеременных);
		
		Если СтруктураИдентификаторов = Неопределено Тогда
			пСообщение = НСтр("ru = 'Не удалось получить uid настроек на сервере SMARTS';
								|en = 'Couldn''t get the settings uid on the Cleverence server';
								|be = 'Не атрымалася атрымаць uid налад на серверы Cleverence'; es = 'No se pudo obtener el UID de configuración en el servidor Cleverence'; ka = 'ვერ მოხერხდა პარამეტრების uid-ის მიღება Cleverence სერვერზე'; kk = 'Cleverence серверінде uid параметрлерін алу мүмкін болмады'; ro = 'Nu s-a putut obține UID-ul de setări pe serverul Cleverence'; tr = 'Cleverence sunucusundaki ayarların uıd''si alınamadı'; uk = 'Не вдалося отримати UID налаштувань на сервері Cleverence'; uz = 'Cleverence serverida uid sozlamalarini olish mumkin emas'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение,, АдресаПеременных);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
			// </Лог>
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НастройкиКУдалению = Новый Массив;
		
	Для Каждого Настройка Из СтруктураНастроек Цикл
		ИтоговыйКлючНастройки = Настройка.Ключ;
		Если УзловыеНастройки.Найти(Настройка.Ключ) <> Неопределено Тогда
			ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_"+ ID_Узла);
		КонецЕсли;
		
		Если ВерсияAPI = 2 Тогда
			СтруктураИдентификаторов.Свойство(ИтоговыйКлючНастройки, ИдентификаторНастройки);
			
			Если ИдентификаторНастройки = Неопределено Тогда
				пСообщение = НСтр("ru = 'Не удалось получить uid настройки %1 на сервере SMARTS';
									|en = 'Couldn''t get the uid of the %1 setting on the Cleverence server';
									|be = 'Не атрымалася атрымаць UID налады %1 на сэрвэры Cleverence'; es = 'No se pudo obtener el UID de configuración %1 en el servidor Cleverence'; ka = 'ვერ მივიღე Uid %1 პარამეტრი Cleverence სერვერზე'; kk = 'Cleverence серверінде %1 UID параметрлерін алу мүмкін болмады'; ro = 'Nu s-a putut obține uid-ul setării %1 pe serverul Cleverence'; tr = 'Cleverence sunucusunda %1 kurulum uıd''si alınamadı'; uk = 'Не вдалося отримати uid налаштування %1 на сервері Cleverence'; uz = 'Cleverence serverida %1 uid sozlamalarini olish mumkin emas'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИтоговыйКлючНастройки);
				ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение,, АдресаПеременных);
				Продолжить;
			КонецЕсли;
		Иначе
			ИдентификаторНастройки = ИтоговыйКлючНастройки;
		КонецЕсли;
			
		РезультатОтвет = REST_API_УдалитьНастройкуSMARTSПоИдентификатору(ИдентификаторНастройки, АдресаПеременных);
		
		Если ВерсияAPI = 2 И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния) Тогда
			НастройкиКУдалению.Добавить(ИтоговыйКлючНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкиКУдалению.Количество() Тогда
		ГлЯдро_УдалитьИдентификаторыНастроекMS(НастройкиКУдалению,, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Процедура REST_API_УдалитьНастройкиSMARTSПоИдентификаторам(ИдентификаторыНастроек, АдресаПеременных)
		
	ИмяСобытия = "REST_API_УдалитьНастройкиSMARTSПоИдентификаторам";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИдентификаторыНастроек",
		ИдентификаторыНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НастройкиКУдалению = Новый Массив;
		
	Для Каждого СтрокаНастройки Из ИдентификаторыНастроек Цикл
		ИдентификаторНастройки = СтрокаНастройки.Значение;
		
		РезультатОтвет = REST_API_УдалитьНастройкуSMARTSПоИдентификатору(ИдентификаторНастройки, АдресаПеременных);
		Если REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния) Тогда
			НастройкиКУдалению.Добавить(ИдентификаторНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкиКУдалению.Количество() Тогда
		ГлЯдро_УдалитьИдентификаторыНастроекMS(НастройкиКУдалению, Истина, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

Функция REST_API_УдалитьНастройкуSMARTSПоИдентификатору(ИдентификаторНастройки, АдресаПеременных)
		
	ИмяСобытия = "REST_API_УдалитьНастройкуSMARTSПоИдентификатору";
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS", АдресаПеременных);
		
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"DELETE");
	СтруктураЗапроса.Вставить("Метод", 		"CustomSettings('" + ИдентификаторНастройки + "')");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСохранениеНастроек");
	РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
	Возврат РезультатОтвет;
	
КонецФункции

Функция REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой = Ложь, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ВыгрузитьТаблицуНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ДанныеДляВыгрузки,ТипБазы,ОчищатьСправочникПередВыгрузкой",
		ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ВыгрузкаБлоками = Ложь;
	Если ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура")
			И ИмяТаблицы <> "Номенклатура" Тогда
		ВыгрузкаБлоками = ДанныеДляВыгрузки.Свойство("ВыгрузкаБлоками") И ДанныеДляВыгрузки.ВыгрузкаБлоками;
		ДанныеДляВыгрузки = ДанныеДляВыгрузки.МассивыСтрок;
	КонецЕсли;
	
	ТекстКоличествоСтрок = Формат(?(ИмяТаблицы = "Номенклатура", ДанныеДляВыгрузки.МассивыСтрок.Количество(), ДанныеДляВыгрузки.Количество()), "ЧН=0; ЧГ=3,0") + " строк";
	
	Если ИмяТаблицы = "БизнесПроцессы" Тогда
		КоличествоУзлов = 0;
			
		ВсеУзлы = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы",, АдресаПеременных);
		Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			СтрокаЭтоТаблицаЗначений = ГлЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы, "ЭтоТаблицаЗначений", Истина, Истина);
			
			КоличествоУзлов = ВсеУзлы.Количество() - ?(СтрокаЭтоТаблицаЗначений = Неопределено, 0, 1);
		КонецЕсли;
		
		Если КоличествоУзлов Тогда
			ТекстКоличествоСтрок = ТекстКоличествоСтрок + " для " + Формат(КоличествоУзлов + 1, "ЧГ=0") + " торговых объектов";
		КонецЕсли;
	КонецЕсли;	
	
	РезультатВыгрузки = Новый Структура;
	РезультатВыгрузки.Вставить("Статус"		, Истина);	
	пСообщение = НСтр("ru = 'Таблица [%1] успешно выгружена. Выгружено:%2%3- %4';
						|en = 'Table [%1] has been successfully uploaded. Unloaded: %2%3-%4';
						|be = 'Табліца [%1] паспяхова выгружаная. Выгружана:%2% 3 - % 4'; es = 'La tabla [%1] se descargó correctamente. Descargado:%2% 3- %4'; ka = 'ცხრილი [%1] წარმატებით აიტვირთა. გადმოტვირთულია: %2% 3- % 4'; kk = 'Кесте [%1] сәтті түсірілді. Түсірілді:%2%3 - %4'; ro = 'Tabelul [%1] a fost încărcat cu succes. Descărcate: %2%3 - %4'; tr = 'Tablo [%1] başarıyla boşaltıldı. Boşaltıldı:% 2% 3-% 4'; uk = 'Таблиця [%1] успішно вивантажена. Вивантажено:%2% 3 - %4'; uz = 'Jadval [%1] muvaffaqiyatli Yuklandi. Yuklanmagan: %2% 3 - %4'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы, Символы.ВК, Символы.Таб, ТекстКоличествоСтрок);
	РезультатВыгрузки.Вставить("Сообщение", пСообщение);

	Если ИмяТаблицы = "Номенклатура" Тогда											
		
		КоличествоРазличныхТоваров = ?(ДанныеДляВыгрузки.Свойство("КоличествоТоваров"),ДанныеДляВыгрузки.КоличествоТоваров,0);
		РезультатВыгрузки.Сообщение = РезультатВыгрузки.Сообщение 
										+ Символы.ВК + Символы.Таб + "- " + Формат(КоличествоРазличныхТоваров, "ЧН=0; ЧГ=3,0") + " товаров"; 
										
		Если ДанныеДляВыгрузки.Свойство("ВыгрузкаБлоками") Тогда
			ВыгрузкаБлоками = ДанныеДляВыгрузки.ВыгрузкаБлоками;
		КонецЕсли;
		
	КонецЕсли;											
	
	ЯзыкПлатформыMS = ГлЯдро_ЯзыкПлатформыMS(АдресаПеременных);
	ИмяТаблицыENG = ГлЯдро_ПолучитьСоответствиеТаблицеMS(ИмяТаблицы, ЯзыкПлатформыMS, АдресаПеременных);
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных);
	
	РезультатПопытки = Истина;
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI(,, АдресаПеременных);
	
	СтруктураПараметровМетода = Новый Структура;
	СтруктураПараметровМетода.Вставить("ИмяТаблицы", 			 ИмяТаблицы);
	СтруктураПараметровМетода.Вставить("СтруктураПодключенияMS", СтруктураПодключенияMS);
	СтруктураПараметровМетода.Вставить("ВерсияAPI",				 ВерсияAPI);
	Если ИмяТаблицы = "Номенклатура" Тогда
		useFullTextSearch = ГлЯдро_ПолучитьИзКэшаНастройкуSMARTS("УстановитьПоискПоНаименованиюИАртикулу",, АдресаПеременных);
		Если useFullTextSearch = Неопределено Тогда
			useFullTextSearch = Ложь;
		КонецЕсли;
		
		ИмяRewriteInventory = ?(ВерсияAPI = 1, "rewriteProductsBook", "rewriteInventory");
		
		ПакетДляОтправки = Новый Структура();
		ПакетДляОтправки.Вставить("lschema",					ДанныеДляВыгрузки.МассивИмен);
		ПакетДляОтправки.Вставить(ИмяRewriteInventory,			ОчищатьСправочникПередВыгрузкой);
		ПакетДляОтправки.Вставить("useFullTextSearch",			useFullTextSearch);
		СтруктураПараметровМетода.Вставить("ПакетДляОтправки", 	ПакетДляОтправки);
		
	ИначеЕсли ИмяТаблицы = "Ячейки" Тогда	
		СтруктураПараметровМетода.Вставить("ВызываемыйМетод",	?(ОчищатьСправочникПередВыгрузкой, "Overwrite", "Update"));
		
	Иначе
		СтруктураПараметровМетода.Вставить("ИмяТаблицыENG", 	ИмяТаблицыENG);
		СтруктураПараметровМетода.Вставить("ВызываемыйМетод",	?(ОчищатьСправочникПередВыгрузкой, "Overwrite", "Update"));
		
	КонецЕсли;
	
	// Первая попытка начать выгрузку
	РезультатОтвет = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Начало(СтруктураПараметровМетода, АдресаПеременных);
	РезультатПопытки = РезультатПопытки И REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
	
	Если НЕ РезультатПопытки Тогда
		// Если при начале выгрузки возвращается ошибка, возможно на сервере не была завершена предыдущая выгрузка. Попытаемся сбросить и повторить начало выгрузки
		РезультатСброса = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_СбросВыгрузки(СтруктураПараметровМетода, АдресаПеременных);
		Если REST_API_КодСостоянияУспешно(РезультатСброса.КодСостояния) Тогда
			// Вторая попытка начать выгрузку
			РезультатОтвет = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Начало(СтруктураПараметровМетода, АдресаПеременных);
			РезультатПопытки = REST_API_КодСостоянияУспешно(РезультатОтвет.КодСостояния);
		КонецЕсли;
		Если НЕ РезультатПопытки Тогда
			ОписаниеОшибки = РезультатОтвет.ТекстОшибки;
			пСообщение = НСтр("ru = 'Таблица [%1] не выгружается!%2%3';
								|en = 'Table [%1] cannot be uploaded! %2%3'; be = 'Табліца [%1] не выгружаецца!%2%3'; es = '¡La tabla [%1] no se descarga!%2%3'; ka = 'ცხრილი [%1] ვერ აიტვირთება! %2%3'; kk = 'Кесте [%1] түсірілмейді!%2%3'; ro = 'Tabelul [%1] nu este încărcat!%2%3'; tr = 'Tablo [%1] boşaltılmıyor!%2%3'; uk = 'Таблиця [%1] не вивантажується!%2%3'; uz = 'Jadval [%1] tushirilmaydi!%2%3'");
			пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяТаблицы, Символы.ВК, ОписаниеОшибки);
			РезультатВыгрузки = Новый Структура("Сообщение,Статус", пСообщение, Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатВыгрузки.Статус = Истина Тогда
		КоличествоСтрок = ДанныеДляВыгрузки.Количество();
		МассивОтправляемыхЗначений = Новый Массив;
		Если ИмяТаблицы = "Номенклатура" Тогда
			МассивДанныхДляВыгрузки = ДанныеДляВыгрузки.МассивыСтрок;
		Иначе
			МассивДанныхДляВыгрузки = ДанныеДляВыгрузки;
		КонецЕсли;
		
		Икс = 0;
		МассивСтрокиВыгрузки = Новый Массив;
		РазмерБлока = 5000;
		Для Каждого СтрокаВыгрузки из МассивДанныхДляВыгрузки Цикл
			Икс = Икс +1;
			Если Икс%РазмерБлока = 0 Тогда
				МассивОтправляемыхЗначений.Добавить(МассивСтрокиВыгрузки);					
				МассивСтрокиВыгрузки = Новый Массив;
			КонецЕсли;
			МассивСтрокиВыгрузки.Добавить(СтрокаВыгрузки);
		КонецЦикла;
		МассивОтправляемыхЗначений.Добавить(МассивСтрокиВыгрузки);
		
		ВыгруженоДанных = 0;
		РазмерДанных = МассивДанныхДляВыгрузки.Количество();
		
		Если Не ВыгрузкаБлоками Тогда
			Сообщение = НСтр("ru = 'Выгрузка';
								|en = 'Discharge'; be = 'Выгрузка'; es = 'Descargo'; ka = 'გამონადენი'; kk = 'Түсіру'; ro = 'Descărcare'; tr = 'Boşaltma'; uk = 'Вивантаження'; uz = 'Tushirish'");
			ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение + " " + Строка(ВыгруженоДанных) + "/" + Строка(РазмерДанных));
		КонецЕсли;
		
		Для Каждого МассивСтрокиВыгрузки из МассивОтправляемыхЗначений Цикл
			
			Если ИмяТаблицы = "Номенклатура" Тогда
				
				СовмещенныйМассив = Новый Массив();
				Для каждого МассивСтроки Из МассивСтрокиВыгрузки Цикл 
					Для каждого Строка Из МассивСтроки Цикл
						СовмещенныйМассив.Добавить(XMLСтрока(Строка));
					КонецЦикла;
				КонецЦикла;
				ОтправляемыеДанные = Новый Структура();
				ОтправляемыеДанные.Вставить("flds",СовмещенныйМассив);
				
			ИначеЕсли ИмяТаблицы = "Ячейки" Тогда
				ОтправляемыеДанные = Новый Соответствие;
				ОтправляемыеДанные.Вставить("value",МассивСтрокиВыгрузки);
				
			Иначе
				ОтправляемыеДанные = Новый Соответствие;
				ОтправляемыеДанные.Вставить("value",МассивСтрокиВыгрузки);
				
			КонецЕсли;
			
			СтруктураПараметровМетода.Вставить("ОтправляемыеДанные",ОтправляемыеДанные);
			
			РезультатОтвет = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_ОтправкаЗначений(СтруктураПараметровМетода,АдресаПеременных);
			РезультатПопытки = РезультатПопытки И НЕ ЗначениеЗаполнено(РезультатОтвет.ТекстОшибки);
	
			Если НЕ РезультатПопытки Тогда
				ОписаниеОшибки = РезультатОтвет.ТекстОшибки;
				Сообщение = НСтр("ru = 'Ошибка выгрузки таблицы [%1].';
									|en = 'Error unloading the table [%1].'; be = 'Памылка выгрузкі табліцы [%1].'; es = 'Error al cargar la tabla [%1].'; ka = 'შეცდომა გადმოტვირთვის მაგიდა [%1].'; kk = 'Кестені жүктеу қатесі [%1].'; ro = 'Eroare la descărcarea tabelului [%1].'; tr = 'Tablo boşaltma hatası [%1].'; uk = 'Помилка вивантаження таблиці [%1].'; uz = 'Jadvalni yuklash xatosi [%1].'");
				Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
				РезультатВыгрузки =  Новый Структура("Сообщение,Статус", Сообщение, Ложь);
				
				// Если при отправке данных произошла ошибка, попытаемся сбросить выгрузку, чтоб сервер дальше не ждал от нас новую порцию
				РезультатСброса = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_СбросВыгрузки(СтруктураПараметровМетода, АдресаПеременных);								
				Прервать;
			КонецЕсли;
			
			ВыгруженоДанных = ВыгруженоДанных + МассивСтрокиВыгрузки.Количество();
			Если Не ВыгрузкаБлоками Тогда
				Сообщение = НСтр("ru = 'Выгрузка';
									|en = 'Discharge'; be = 'Выгрузка'; es = 'Descargo'; ka = 'გამონადენი'; kk = 'Түсіру'; ro = 'Descărcare'; tr = 'Boşaltma'; uk = 'Вивантаження'; uz = 'Tushirish'");
				ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(ИмяТаблицы, Сообщение + " " + Строка(ВыгруженоДанных) + "/" + Строка(РазмерДанных));
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Если РезультатВыгрузки.Статус = Истина Тогда
		
		РезультатОтвет = REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Завершение(СтруктураПараметровМетода, АдресаПеременных);
		РезультатПопытки = РезультатПопытки И НЕ ЗначениеЗаполнено(РезультатОтвет.ТекстОшибки);
		
		Если НЕ РезультатПопытки Тогда
			ОписаниеОшибки = РезультатОтвет.ТекстОшибки;
			Сообщение = НСтр("ru = 'Не удалось закончить выгрузку таблицы [%1].';
								|en = 'Couldn''t finish unloading the table [%1].'; be = 'Не ўдалося скончыць выгрузку табліцы [%1].'; es = 'No se pudo terminar de descargar la tabla [%1].'; ka = 'ვერ დაასრულა ცხრილის გადმოტვირთვა [%1].'; kk = '[%1] кестесін түсіруді аяқтау мүмкін болмады.'; ro = 'Nu s-a putut termina descărcarea tabelului [%1].'; tr = 'Tabloyu [%1] boşaltmayı bitiremedim.'; uk = 'Не вдалося закінчити вивантаження таблиці [%1].'; uz = 'Jadvalni tushirishni tugata olmadi [%1].'");
			Сообщение = ГлЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
			РезультатВыгрузки =  Новый Структура("Сообщение,Статус", Сообщение, Ложь);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

Функция REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Начало(СтруктураПараметровМетода, АдресаПеременных)
	
	ИмяСобытия = "REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Начало";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметровМетода",
		СтруктураПараметровМетода);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ИмяТаблицы 				= СтруктураПараметровМетода.ИмяТаблицы;
	СтруктураПодключенияMS 	= СтруктураПараметровМетода.СтруктураПодключенияMS;
	ВерсияAPI 				= СтруктураПараметровМетода.ВерсияAPI;
	
