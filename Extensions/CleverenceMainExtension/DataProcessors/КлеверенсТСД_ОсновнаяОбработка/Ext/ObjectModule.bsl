				СтруктураПараметров.ДанныеНастроекИзКэша 	= ДанныеНастроекИзКэша;
				СтруктураПараметров.ИнтеграционнаяОбработка = ИнтеграционнаяОбработка;
				СтруктураПараметров.ИмяПриемникаДанных 		= "ДанныеДляВыгрузки_Строка";
				СтруктураПараметров.ТЧ 						= МассивДанныхСтрок;
				СтруктураПараметров.ПроизвольныеПараметры	= ПроизвольныеПараметры;
				
				ГлЯдро_ВыполнитьОбработчикВыгрузкиДокумента1С(ИмяТекОбработчика, СтруктураПараметров, АдресаПеременных);	
				
				Если ДанныеДокумента.Свойство("КритическаяОшибка") И ДанныеДокумента.КритическаяОшибка = Истина Тогда
					пСообщение = НСтр("ru = 'Конец, Выгрузка документа 1С';
										|en = 'End, Uploading a 1C document'; be = 'Канец, Выгрузка дакумента 1С'; es = 'Fin, descarga del documento 1C'; ka = 'დასასრული, 1c დოკუმენტის ატვირთვა'; kk = 'Соңы, 1С құжатты түсіру'; ro = 'Sfârșit, încărcarea unui document 1C'; tr = 'Son, 1C belgesinin boşaltılması'; uk = 'Кінець, вивантаження документа 1С'; uz = '1C hujjatni tugatish, tushirish'");
					ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
					
					// <Лог>
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
					ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
					// </Лог>
					
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	ДанныеДокумента.Вставить("ТабличныеЧасти", пТабличныеЧасти);
	
	СтруктураПараметров = ГлЯдро_ПолучитьСтруктуруПараметровВыполненияОбработчикаВыгрузки();
	СтруктураПараметров.СсылкаДокумент1С 		= Документ1С;
	СтруктураПараметров.ДанныеДокумента 		= ДанныеДокумента;
	СтруктураПараметров.НастройкаБП 			= НастройкаБП;
	СтруктураПараметров.ДанныеНастроекИзКэша 	= ДанныеНастроекИзКэша;
	СтруктураПараметров.ИнтеграционнаяОбработка = ИнтеграционнаяОбработка;
	СтруктураПараметров.ИмяПриемникаДанных 		= "ДанныеДляВыгрузки_Шапка";
	СтруктураПараметров.ПроизвольныеПараметры	= ПроизвольныеПараметры;
	
	ГлЯдро_ВыполнитьОбработчикВыгрузкиДокумента1С("Обработчик_ПослеВыгрузкиДокумента", СтруктураПараметров, АдресаПеременных);	
	
	Если ДанныеДокумента.Свойство("КритическаяОшибка") И ДанныеДокумента.КритическаяОшибка = Истина Тогда
		пСообщение = НСтр("ru = 'Конец, Выгрузка документа 1С';
							|en = 'End, Uploading a 1C document'; be = 'Канец, Выгрузка дакумента 1С'; es = 'Fin, descarga del documento 1C'; ka = 'დასასრული, 1c დოკუმენტის ატვირთვა'; kk = 'Соңы, 1С құжатты түсіру'; ro = 'Sfârșit, încărcarea unui document 1C'; tr = 'Son, 1C belgesinin boşaltılması'; uk = 'Кінець, вивантаження документа 1С'; uz = '1C hujjatni tugatish, tushirish'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ГлЯдро_ДополнитьДанныеДокументаДаннымиНоменклатуры(ДанныеДокумента, Документ1С, НастройкаБП, АдресаПеременных);
	
	// Закончили
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеДокумента);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ДанныеДокумента;
	
КонецФункции

Процедура ГлЯдро_ДополнитьДанныеДокументаДаннымиНоменклатуры(ДанныеДокумента, Документ1С, НастройкаБП, АдресаПеременных)
	
