Функция ГлЯдро_ПолучитьСкладыSMARTS(ТипБазы, ТипИнтерфейса, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьСкладыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы,ТипИнтерфейса",
		ТипБазы, ТипИнтерфейса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипИнтерфейса = "REST_API" Тогда
		СкладыMS = REST_API_ПолучитьСкладыSMARTS(ТипБазы, АдресаПеременных);
	Иначе
		СкладыMS = КомЯдро_ПолучитьСкладыSMARTS(ТипБазы, АдресаПеременных);
	КонецЕсли;        
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СкладыMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СкладыMS;
	
КонецФункции

