Функция ГлЯдро_ПолучитьАтрибутыНастроекMS(ВерсияСтруктуры = Неопределено, ПоУмолчанию = Ложь, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьАтрибутыНастроекMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияСтруктуры,ПоУмолчанию",
		ВерсияСтруктуры, ПоУмолчанию);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ВерсияСтруктуры = Неопределено Тогда
		СтруктураАтрибутов = ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктуры, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураАтрибутов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СтруктураАтрибутов;
	КонецЕсли;
	
	СуффиксКлюча = ?(ПоУмолчанию, "ПоУмолчанию", "Пользовательские");
	
	СоответствиеАтрибутов = КомЯдро_ПолучитьЗначениеПеременной("СоответствиеАтрибутов_" + СуффиксКлюча, АдресаПеременных);
	
	Если НЕ СоответствиеАтрибутов = Неопределено
		И НЕ СоответствиеАтрибутов = Ложь Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеАтрибутов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат СоответствиеАтрибутов;
	КонецЕсли;
	
	ВерсияСтруктуры = КомЯдро_ПолучитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_" + СуффиксКлюча, АдресаПеременных);
	
	Если ВерсияСтруктуры = Неопределено
		ИЛИ ВерсияСтруктуры = Ложь Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СоответствиеАтрибутов = ГлЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктуры, АдресаПеременных);
	
	КомЯдро_СохранитьЗначениеПеременной("СоответствиеАтрибутов_" + СуффиксКлюча, СоответствиеАтрибутов, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеАтрибутов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СоответствиеАтрибутов;
	
КонецФункции

Функция ГлЯдро_СобратьСтруктуруАтрибутов(Знач ВерсияСтруктуры, АдресаПеременных) Экспорт

    ИмяСобытия = "ГлЯдро_СобратьСтруктуруАтрибутов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияСтруктуры",
		ВерсияСтруктуры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если НЕ ЗначениеЗаполнено(ВерсияСтруктуры) ИЛИ ВерсияСтруктуры = Ложь Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;           
	КонецЕсли;
		
	МассивПереходныхВерсий = ГлЯдро_ОбновлениеАтрибутов_МассивПереходныхВерсий();
		
	МаксимальныйИндекс = -1;
	Для каждого ЧислоВерсии ИЗ МассивПереходныхВерсий Цикл
		Если ЧислоВерсии.Значение > ВерсияСтруктуры Тогда
			Прервать;
		КонецЕсли;
		МаксимальныйИндекс = МаксимальныйИндекс + 1;
	КонецЦикла;
	
	СоответствиеАтрибутов = Новый Соответствие;
	
	Для ИндексВерсии = 0 ПО МаксимальныйИндекс Цикл
		Попытка
			РезультатВыполнения = Новый Соответствие;
			
			СтрокаВызова = "РезультатВыполнения = Параметры.ОсновнаяОбработка.ГлЯдро_ПолучитьАтрибутыНастроек_"
				+ МассивПереходныхВерсий[ИндексВерсии].Представление + "()";
			СтрокаВызова = СтрЗаменить(СтрокаВызова, "РезультатВыполнения", "Параметры.РезультатВыполнения");
			
			ПараметрыАлгоритма = Новый Структура;
			ПараметрыАлгоритма.Вставить("РезультатВыполнения", РезультатВыполнения);
			ПараметрыАлгоритма.Вставить("ОсновнаяОбработка",   ЭтотОбъект);
			
			ГлЯдро_ВыполнитьВБезопасномРежиме(СтрокаВызова, ПараметрыАлгоритма, АдресаПеременных);
			
			РезультатВыполнения = ПараметрыАлгоритма.РезультатВыполнения;
			Для каждого СтруктураАтрибута ИЗ РезультатВыполнения Цикл
				СоответствиеАтрибутов.Вставить(СтруктураАтрибута.Ключ, СтруктураАтрибута.Значение);
			КонецЦикла;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЛогОшибка(логСобытие,,,, ИнфоОшибка,, АдресаПеременных);
			// </Лог>
			Прервать;
		КонецПопытки;
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеАтрибутов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СоответствиеАтрибутов;
	
КонецФункции

