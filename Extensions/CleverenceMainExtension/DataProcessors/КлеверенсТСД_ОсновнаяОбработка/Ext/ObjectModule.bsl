		ОписаниеПодсказки.РодительскийЭлемент 		= "ГруппаОбменДокументами_НастройкиОбмена";
		ОписаниеПодсказки.ВставитьПередЭлементом 	= "ГруппаОбменДокументами_НастройкиОбмена_Плитки";
		ОписаниеПодсказки.Заголовок 				= Заголовок;
		ОписаниеПодсказки.Описание 					= Новый ФорматированнаяСтрока(ФорматСтроки);
		СписокПодсказок.Добавить(ОписаниеПодсказки);
		
		// +++ Вкладка Настройки
		
		// Подсказка: Использование торговых объектов
		ФорматСтроки = Новый Массив;
		пСообщение = НСтр("ru = 'Используйте '");
		ФорматСтроки.Добавить(пСообщение);
		
		пСообщение = НСтр("ru = 'торговые объекты';
							|en = 'shopping facilities'; be = 'гандлёвыя аб''екты'; es = 'instalaciones comerciales'; ka = 'სავაჭრო ობიექტები'; kk = 'сауда нысандары'; ro = 'facilități comerciale'; tr = 'ticari tesisler'; uk = 'торгові об''єкти'; uz = 'savdo ob''ektlari'");
		пСообщение = Новый ФорматированнаяСтрока(пСообщение,,,, "https://www.cleverence.ru/support/category:820/");
		ФорматСтроки.Добавить(пСообщение);
		
		пСообщение = НСтр("ru = ', чтобы разделять настройки и данные между складами, магазинами и подразделениями.';
							|en = ' to share settings and data between warehouses, stores, and divisions.';
							|be = ', каб падзяляць налады і дадзеныя паміж складамі, крамамі і падраздзяленнямі.'; es = ' para dividir la configuración y los datos entre almacenes, tiendas y departamentos.'; ka = ' პარამეტრების და მონაცემების გაზიარება საწყობებს, მაღაზიებსა და განყოფილებებს შორის.'; kk = ', қоймалар, дүкендер мен бөлімшелер арасында параметрлер мен деректерді бөлу.'; ro = ' pentru a partaja setările și datele între depozite, magazine și divizii.'; tr = ' ayarları ve verileri depolar, mağazalar ve bölümler arasında bölmek için'; uk = ', щоб розділити налаштування та дані між складами, магазинами та підрозділами.'; uz = ', Sozlamalar va ma''lumotlarni omborlar, do''konlar va bo''linmalar o''rtasida taqsimlash.'");
		ФорматСтроки.Добавить(пСообщение);
		
		ОписаниеПодсказки = ГлЯдро_Подсказки_СтруктураОписанияПодсказки();
		ОписаниеПодсказки.Имя 						= "Настройки_ИспользованиеУзлов";
		ОписаниеПодсказки.РодительскийЭлемент 		= "ГруппаНастройки_Тело";
		ОписаниеПодсказки.ВставитьПередЭлементом 	= "ГруппаПлитки_Настройки_Строка1";
		ОписаниеПодсказки.Заголовок 				= Заголовок;
		ОписаниеПодсказки.Описание 					= Новый ФорматированнаяСтрока(ФорматСтроки);
		СписокПодсказок.Добавить(ОписаниеПодсказки);
		
	ИначеЕсли ИмяФормыИсточник = "ФормаНастройки_ПравилаВыгрузкиПолей" Тогда
		
		// Подсказка: Переопределение типовых полей
		ФорматСтроки = Новый Массив;
		пСообщение = НСтр("ru = 'Чтобы переопределить настройки типового поля, создайте его копию и отключите использование типового.'");
		ФорматСтроки.Добавить(пСообщение);
		
		ОписаниеПодсказки = ГлЯдро_Подсказки_СтруктураОписанияПодсказки();
		ОписаниеПодсказки.Имя 						= "ПереопределениеТиповыхПолей";
		ОписаниеПодсказки.РодительскийЭлемент 		= "ГруппаПодсказкиТаблицаРеквизитов_Тело";
		ОписаниеПодсказки.ВставитьПередЭлементом 	= Неопределено;
		ОписаниеПодсказки.Заголовок 				= Заголовок;
		ОписаниеПодсказки.Описание 					= Новый ФорматированнаяСтрока(ФорматСтроки);
		СписокПодсказок.Добавить(ОписаниеПодсказки);
		
	ИначеЕсли ИмяФормыИсточник = "ФормаНастройки_ПравилаЗагрузкиПолей" Тогда
		
		// Подсказка: Переопределение типовых полей
		ФорматСтроки = Новый Массив;
		пСообщение = НСтр("ru = 'Чтобы переопределить настройки типового поля, создайте его копию и отключите использование типового.'");
		ФорматСтроки.Добавить(пСообщение);
		
		ОписаниеПодсказки = ГлЯдро_Подсказки_СтруктураОписанияПодсказки();
		ОписаниеПодсказки.Имя 						= "ПереопределениеТиповыхПолей";
		ОписаниеПодсказки.РодительскийЭлемент 		= "ГруппаПодсказкиТаблицаРеквизитов_Тело";
		ОписаниеПодсказки.ВставитьПередЭлементом 	= Неопределено;
		ОписаниеПодсказки.Заголовок 				= Заголовок;
		ОписаниеПодсказки.Описание 					= Новый ФорматированнаяСтрока(ФорматСтроки);
		СписокПодсказок.Добавить(ОписаниеПодсказки);
		
	КонецЕсли;
	
	НастройкиПодсказокПользователю = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_НастройкиПодсказокПользователю");
	НастройкиПодсказокПользователю = ?(НастройкиПодсказокПользователю = Неопределено, Новый Структура, НастройкиПодсказокПользователю);
	
	// Добавляем подсказки на форму
	Для Каждого ОписаниеПодсказки Из СписокПодсказок Цикл
		
		// Проверяем видимость подсказки через пользовательские настройки
		ИмяНастройки = ИмяФормыИсточник + "_ГруппаПодсказка_" + ОписаниеПодсказки.Имя;
		Если НЕ НастройкиПодсказокПользователю.Свойство(ИмяНастройки) ИЛИ НастройкиПодсказокПользователю[ИмяНастройки] <> Ложь Тогда
			
			Попытка
				ГлЯдро_Подсказки_СоздатьЭлементПодсказки(ИмяФормыИсточник, ФормаИсточник, ОписаниеПодсказки, ДополнительныеПараметры);
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Создает элемент подсказки на форме программно
//
// Функция создает группу элементов формы с иконкой, заголовком, описанием и кнопкой закрытия. 
// Кнопка закрытия использует обработчик Подсказки_ЗакрытьПодсказку(Элемент) формы.
//
// Параметры:
//  ИмяФормыИсточник - Строка - Имя формы для формирования имени настройки
//  ФормаИсточник - УправляемаяФорма - Форма, на которой создается подсказка
//  ОписаниеПодсказки - Структура - Описание подсказки с полями: 
//    * Имя - Строка - Уникальное имя подсказки
//    * Заголовок - Строка - Заголовок подсказки
//    * Описание - Строка - Текст описания подсказки (может содержать HTML-разметку)
//    * РодительскийЭлемент - Строка - Имя родительского элемента (необязательно)
//    * ВставитьПередЭлементом - Строка - Имя элемента, перед которым вставлять подсказку (необязательно)
//    * ФорматированныйТекст - Булево - Использовать форматированный текст (необязательно)
//  ДополнительныеПараметры - Структура - Дополнительные параметры создания подсказки (необязательный)
//
Процедура ГлЯдро_Подсказки_СоздатьЭлементПодсказки(ИмяФормыИсточник, ФормаИсточник, ОписаниеПодсказки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяПодсказки = ОписаниеПодсказки.Имя;
	ИмяНастройки = ИмяФормыИсточник + "_ГруппаПодсказка_" + ИмяПодсказки;
	ИмяГруппыПодсказки = "ГруппаПодсказка_" + ИмяПодсказки;
	
	// Проверяем, не существует ли уже такой элемент
	СуществующийЭлемент = ФормаИсточник.Элементы.Найти(ИмяГруппыПодсказки);
	Если СуществующийЭлемент <> Неопределено Тогда
		Возврат; // Элемент уже существует
	КонецЕсли;
	
	// Определяем родительский элемент
	РодительскийЭлемент = Неопределено;
	Если ЗначениеЗаполнено(ОписаниеПодсказки.РодительскийЭлемент) Тогда
		РодительскийЭлемент = ФормаИсточник.Элементы.Найти(ОписаниеПодсказки.РодительскийЭлемент);
	КонецЕсли;
	
	// Определяем позицию вставки
	ВставитьПередЭлементом = Неопределено;
	Если ЗначениеЗаполнено(ОписаниеПодсказки.ВставитьПередЭлементом) Тогда
		ВставитьПередЭлементом = ФормаИсточник.Элементы.Найти(ОписаниеПодсказки.ВставитьПередЭлементом);
	КонецЕсли;
	
	// Создаем основную группу подсказки с учетом позиционирования
	Если ВставитьПередЭлементом <> Неопределено И РодительскийЭлемент <> Неопределено Тогда
		// Вставляем после указанного элемента
		ГруппаПодсказки = ФормаИсточник.Элементы.Вставить(ИмяГруппыПодсказки, Тип("ГруппаФормы"), РодительскийЭлемент, ВставитьПередЭлементом);
	Иначе
		// Добавляем в конец
		ГруппаПодсказки = ФормаИсточник.Элементы.Добавить(ИмяГруппыПодсказки, Тип("ГруппаФормы"), РодительскийЭлемент);
	КонецЕсли;
	
	ГруппаПодсказки.Вид 							= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПодсказки.Отображение 					= ОтображениеОбычнойГруппы.Нет;
	ГруппаПодсказки.ОтображатьЗаголовок				= Ложь;
	ГруппаПодсказки.РастягиватьПоГоризонтали 		= Истина;
	ГруппаПодсказки.ЦветФона 						= Новый Цвет(235, 240, 255);		// Голубая подложка
	ГруппаПодсказки.ВертикальныйИнтервал 			= ИнтервалМеждуЭлементамиФормы.Одинарный;
	
	// Создаем группу для отступа
	ИмяЭлемента = ИмяГруппыПодсказки + "_Отступ";
	ГруппаОтступ = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаПодсказки);
	ГруппаОтступ.Вид 									= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтступ.Группировка 							= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаОтступ.Отображение 							= ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаОтступ.ОтображатьЗаголовок					= Ложь;
	ГруппаОтступ.ГоризонтальныйИнтервал 				= ИнтервалМеждуЭлементамиФормы.Половинный;
	
	// Создаем декорацию-картинку (иконку подсказки)
	ИмяЭлемента = "Подсказка_" + ИмяПодсказки + "_Иконка";
	ДекорацияКартинка = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаОтступ);
	ДекорацияКартинка.Вид 								= ВидДекорацииФормы.Картинка;
	ДекорацияКартинка.ВертикальноеПоложениеВГруппе 		= ВертикальноеПоложениеЭлемента.Верх;
	
	// Картинка из стиля доступна в главной форме
	КартинкаПодсказкаИконка = Неопределено;
	Если ДополнительныеПараметры <> Неопределено Тогда
		ДополнительныеПараметры.Свойство("КартинкаПодсказкаИконка", КартинкаПодсказкаИконка);
	КонецЕсли;
	Если КартинкаПодсказкаИконка = Неопределено Тогда
		ДекорацияКартинка.Картинка = БиблиотекаКартинок.Информация;
	Иначе
		ДекорацияКартинка.Картинка = КартинкаПодсказкаИконка;
	КонецЕсли;
	
	// Создаем группу для тела подсказки
	ИмяЭлемента = ИмяГруппыПодсказки + "_Тело";
	ГруппаТело = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаОтступ);
	ГруппаТело.Вид 										= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТело.Группировка 								= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаТело.ВертикальныйИнтервал 					= ИнтервалМеждуЭлементамиФормы.Половинный;
	ГруппаТело.Отображение 								= ОтображениеОбычнойГруппы.Нет;
	ГруппаТело.ОтображатьЗаголовок						= Ложь;
	
	// Создаем группу для шапки (заголовок + кнопка закрытия)
	ИмяЭлемента = ИмяГруппыПодсказки + "_Шапка";
	ГруппаШапка = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаТело);
	ГруппаШапка.Вид 									= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаШапка.Высота 									= 1;
	ГруппаШапка.РастягиватьПоГоризонтали 				= Истина;
	ГруппаШапка.Группировка 							= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаШапка.ВертикальноеПоложениеПодчиненных 		= ВертикальноеПоложениеЭлемента.Центр;
	ГруппаШапка.Отображение 							= ОтображениеОбычнойГруппы.Нет;
	ГруппаШапка.ОтображатьЗаголовок						= Ложь;
	
	// Создаем заголовок подсказки
	ИмяЭлемента = "Подсказка_" + ИмяПодсказки + "_Заголовок";
	ДекорацияЗаголовок = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаШапка);
	ДекорацияЗаголовок.Вид 								= ВидДекорацииФормы.Надпись;
	ДекорацияЗаголовок.Заголовок 						= ОписаниеПодсказки.Заголовок;
	ДекорацияЗаголовок.Шрифт 							= Новый Шрифт(,, Истина,,,, 80); // Жирный шрифт
	ДекорацияЗаголовок.ЦветТекста						= Новый Цвет(56, 88, 201);			// Синий светлый
	ДекорацияЗаголовок.РастягиватьПоГоризонтали 		= Истина;
	
	// Создаем кнопку закрытия
	ИмяЭлемента = "Подсказка_" + ИмяПодсказки + "_Закрыть";
	ДекорацияЗакрытие = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаШапка);
	ДекорацияЗакрытие.Вид 								= ВидДекорацииФормы.Картинка;
	ДекорацияЗакрытие.ГоризонтальноеПоложениеВГруппе 	= ГоризонтальноеПоложениеЭлемента.Право;
	ДекорацияЗакрытие.Гиперссылка 						= Истина;
	ДекорацияЗакрытие.Картинка = БиблиотекаКартинок.ПолеВводаОчистить;
	
	пСообщение = НСтр("ru = 'Скрыть. Восстановить их можно в: Настройки → Расширенные настройки → Восстановить все подсказки.';
						|en = 'Hide. You can restore them in: Settings → Advanced Settings → Restore all hints.';
						|be = 'Схаваць. Аднавіць іх можна ў: Налады → Пашыраныя налады → аднавіць усе падказкі.'; es = 'Ocultar. Puede restaurarlos en: Configuración → configuración Avanzada → Restaurar todas las sugerencias.'; ka = 'დამალვა. მათი აღდგენა შეგიძლიათ: პარამეტრები → გაფართოებული პარამეტრები → ყველა მინიშნების აღდგენა.'; kk = 'Жасыру. Оларды қалпына келтіруге болады: Параметрлер → Қосымша параметрлер → барлық кеңестерді қалпына келтіріңіз.'; ro = 'Ascunde-te. Le puteți restaura în: Settings (Setări) Setări avansate (Setări avansate).'; tr = 'Gizlemek için. Bunları şuradan geri yükleyebilirsiniz: Ayarlar → Gelişmiş Ayarlar → Tüm ipuçlarını geri yükle.'; uk = 'Сховавши. Відновити їх можна в: Налаштування → Розширені налаштування → відновити всі підказки.'; uz = 'Yashirish. Siz ularni tiklashingiz mumkin: Sozlamalar → Kengaytirilgan Sozlamalar → barcha maslahatlarni tiklash.'");
	ДекорацияЗакрытие.Подсказка 						= пСообщение;
	ДекорацияЗакрытие.УстановитьДействие("Нажатие", "Подсказки_ЗакрытьПодсказку");
	
	// Создаем описание подсказки
	ИмяЭлемента = "Подсказка_" + ИмяПодсказки + "_Описание";
	ДекорацияОписание = ФормаИсточник.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаТело);
	ДекорацияОписание.Вид 								= ВидДекорацииФормы.Надпись;
	ДекорацияОписание.Заголовок 						= ОписаниеПодсказки.Описание;
	ДекорацияОписание.АвтоМаксимальнаяШирина 			= Ложь;
	ДекорацияОписание.МаксимальнаяШирина 				= 80;
	ДекорацияОписание.РастягиватьПоГоризонтали 			= Истина;
	
КонецПроцедуры

Функция ГлЯдро_ГлавнаяФорма_ПервичнаяИнициализация(ДополнительныеПараметры, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ГлавнаяФорма_ПервичнаяИнициализация";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	локПараметрЗапуска 					= ДополнительныеПараметры.локПараметрЗапуска;
	СпособЗапуска						= ДополнительныеПараметры.СпособЗапуска;
	ОшибкиФоновойИнициализации 			= ДополнительныеПараметры.ОшибкиФоновойИнициализации;
	ВыполнятьЗамерыПроизводительности	= ДополнительныеПараметры.ВыполнятьЗамерыПроизводительности;
	
	СтруктураРезультата = Новый Структура;
	
	СтруктураРезультата.Вставить("ВерсияОсновнойОбработки", 		ГлЯдро_ПолучитьИнформациюОВнешнейОбработке("Версия"));
	СтруктураРезультата.Вставить("ПодключеннаяКонфигурация", 		Метаданные.Имя + ", " + Метаданные.Версия);
	СтруктураРезультата.Вставить("ID_ТекущейБазы", 					ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы"));
	СтруктураРезультата.Вставить("ТипИнтерфейса", 					"REST_API");
	
	ДоступноВыполнениеВФоне = ГлЯдро_ДоступноВыполнениеВФоне(локПараметрЗапуска) И НЕ ОшибкиФоновойИнициализации;
	
	// Проверим не отключал ли ранее пользователь работу в фоне
	ОтключитьРаботуВФоне = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ОтключитьРаботуВФоне");
	Если ОтключитьРаботуВФоне <> Неопределено Тогда
		КомЯдро_СохранитьЗначениеПеременной("ОтключитьРаботуВФоне", ОтключитьРаботуВФоне, АдресаПеременных);
		ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне И НЕ ОтключитьРаботуВФоне;
	КонецЕсли;
	
	// Запрещаем фоновые задания, если выполняется замер производительности
	ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне И НЕ ВыполнятьЗамерыПроизводительности;
	
	КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", 			ДоступноВыполнениеВФоне, АдресаПеременных); // Записываем в кэш
	
	СтруктураРезультата.Вставить("ДоступноВыполнениеВФоне", 				ДоступноВыполнениеВФоне);
	СтруктураРезультата.Вставить("ИмяТекущейСтраницы", 						ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТекущаяСтраницаГлавнойФормы"));
	
	Если ЗначениеЗаполнено(локПараметрЗапуска) 		
		и Найти(локПараметрЗапуска, "КлеверенсАвтотесты.") Тогда
		КомЯдро_СохранитьЗначениеПеременной("Автотест", Истина, АдресаПеременных);
		
		ИдАвтотеста = Строка(Новый УникальныйИдентификатор);
		КомЯдро_СохранитьЗначениеПеременной("ИдАвтотеста", ИдАвтотеста, АдресаПеременных);	
	КонецЕсли;
	
	// Иницализируем пользовательские настройки подсказок - загрузим их в кэш
	НастройкиПодсказокПользователю = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_НастройкиПодсказокПользователю");
	КомЯдро_СохранитьЗначениеПеременной("НастройкиПодсказокПользователю", НастройкиПодсказокПользователю, АдресаПеременных);
	
	КомЯдро_СохранитьЗначениеПеременной("ИспользоватьREST_API", Истина, АдресаПеременных);	
	
	#Если ВебКлиент тогда
		РасположениеКомпоненты = "НаСервере";
	#Иначе
		РасположениеКомпоненты = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		РасположениеКомпоненты = ?(РасположениеКомпоненты = Неопределено, "НаСервере", РасположениеКомпоненты);
	#КонецЕсли
	СтруктураРезультата.Вставить("РасположениеКомпоненты", 	РасположениеКомпоненты);
	СтруктураРезультата.Вставить("ТипИнтерфейса", 			"REST_API");
	
	Если СпособЗапуска = "Обычный" Тогда
		
		ПараметрыПодключенияMS = ГлЯдро_ПолучитьПараметрыПодключенияMS(,, АдресаПеременных);
		СтруктураРезультата.Вставить("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
		
		Если ПараметрыПодключенияMS <> Неопределено Тогда
			
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS, АдресаПеременных);
			
			КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты", РасположениеКомпоненты, АдресаПеременных);
			СтруктураРезультата.Вставить("РасположениеКомпоненты", РасположениеКомпоненты);
			
			ТипИнтерфейса = ГлЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
			КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса", ТипИнтерфейса, АдресаПеременных);
			СтруктураРезультата.Вставить("ТипИнтерфейса", ТипИнтерфейса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураРезультата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураРезультата;
	
КонецФункции 

Функция ГлЯдро_ПолучитьИмяФормы(Форма) Экспорт
	
	МассивПодстрок = ГлЯдро_СтрРазделить(Форма.ИмяФормы, ".");
	Возврат МассивПодстрок[МассивПодстрок.ВГраница()];
	
КонецФункции 

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ГлобальныйКонтекст_СправочникиИТаблицы_ПечатьЭтикеток

Функция ГлЯдро_ПолучитьСписокПолейШаблона(СтруктураПараметров, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьСписокПолейШаблона";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	// в инт. обработке может не существовать данного метода
	Попытка
		СписокПолейШаблона = ИнтеграционнаяОбработка.ПолучитьСписокПолейШаблона(СтруктураПараметров);	
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось получить список полей шаблона в интеграционной обработке: %1';
							|en = 'Couldn''t get a list of template fields in integration processing: %1';
							|be = 'Не ўдалося атрымаць спіс палёў шаблону ў інтэграцыйнай апрацоўцы: %1'; es = 'No se pudo obtener la lista de campos de plantilla en el procesamiento de integración: %1'; ka = 'ვერ მოიძებნა თარგის ველების სია ინტეგრაციის დამუშავებაში: %1'; kk = 'Интеграциялық өңдеуде үлгі өрістерінің тізімін алу мүмкін болмады: %1'; ro = 'Nu s-a putut obține o listă de câmpuri șablon în procesarea integrării: %1'; tr = 'Entegrasyon işlemede şablon alanlarının listesi alınamadı: %1'; uk = 'Не вдалося отримати список полів шаблону в обробці інтеграції: %1'; uz = 'Integratsiya jarayonida shablon maydonlari ro''yxatini olish mumkin emas: %1'");
		ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьСписокПолейШаблона", "Предупреждение", ТекстОшибки, , АдресаПеременных);
		
		СписокПолейШаблона = Неопределено;		
	КонецПопытки;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокПолейШаблона);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СписокПолейШаблона;
	
КонецФункции

Функция ГлЯдро_ПодготовитьСтруктуруМакетаШаблона(СтруктураПараметров, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПодготовитьСтруктуруМакетаШаблона";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ШаблонЭтикетки 	= СтруктураПараметров.ШаблонЭтикетки;
	ИмяТаблицы 		= СтруктураПараметров.ИмяТаблицы;
	
	ВстроенныйМакет = ТипЗнч(ШаблонЭтикетки) = Тип("ТабличныйДокумент");
	
	ПолеТабличногоДокумента	= Неопределено;
	СтруктураМакетаШаблона 	= Неопределено;
	
	Если НЕ ВстроенныйМакет Тогда
		РеквизитыСправочника = ШаблонЭтикетки.Метаданные().Реквизиты;
		Если РеквизитыСправочника.Найти("Шаблон") <> Неопределено 
			И ТипЗнч(ШаблонЭтикетки.Шаблон) = Тип("ХранилищеЗначения") Тогда
			СтруктураМакетаШаблона = ШаблонЭтикетки.Шаблон.Получить();
		Иначе
		    Для каждого Реквизит ИЗ РеквизитыСправочника Цикл
				Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
					СтруктураМакетаШаблона = ШаблонЭтикетки[Реквизит.Имя].Получить();
					Если СтруктураМакетаШаблона <> Неопределено Тогда
						Прервать;					
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	
		Если СтруктураМакетаШаблона <> Неопределено
			И ТипЗнч(СтруктураМакетаШаблона) = Тип("Структура") Тогда
			Если СтруктураМакетаШаблона.Свойство("РедакторТабличныйДокумент") Тогда
				ПолеТабличногоДокумента = СтруктураМакетаШаблона.РедакторТабличныйДокумент;	
			Иначе	
				Для каждого КлючЗначение ИЗ СтруктураМакетаШаблона Цикл
					Если ТипЗнч(КлючЗначение.Значение) = Тип("ТабличныйДокумент") Тогда
						ПолеТабличногоДокумента = КлючЗначение.Значение;
						Прервать;						
					КонецЕсли;					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ПолеТабличногоДокумента = Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;		
		КонецЕсли;
	Иначе
		ПолеТабличногоДокумента = ШаблонЭтикетки;		
	КонецЕсли;
	
	Если СтруктураМакетаШаблона = Неопределено Тогда
		СтруктураМакетаШаблона = Новый Структура;
	КонецЕсли;
	
	ПараметрыШаблона       = Новый Соответствие;
	СчетчикПараметров      = 0;
	ПрефиксИмениПараметра  = "ПараметрМакета";
	
	Если НЕ СтруктураМакетаШаблона.Свойство("МакетЭтикетки") Тогда
		
		ИмяПараметраШтрихкод   = "Штрихкод";
		ИмяПараметраКодВалюты  = "ВидЦены.ВалютаЦены.Код";
		
		Если ПолеТабличногоДокумента <> Неопределено Тогда
			Если ПолеТабличногоДокумента.ОбластьПечати = Неопределено Тогда
				ПолеТабличногоДокумента.ОбластьПечати = ПолеТабличногоДокумента.Область("R1C1:"+"R"+ПолеТабличногоДокумента.ВысотаТаблицы+"C"+ПолеТабличногоДокумента.ШиринаТаблицы);
			КонецЕсли;	
			ОбластьМакетаЭтикетки = ПолеТабличногоДокумента.ПолучитьОбласть(ПолеТабличногоДокумента.ОбластьПечати.Имя);
			
			ОбластьМакетаЭтикетки.АвтоМасштаб 				= ПолеТабличногоДокумента.АвтоМасштаб;
			ОбластьМакетаЭтикетки.ВысотаСтраницы 			= ПолеТабличногоДокумента.ВысотаСтраницы;
			ОбластьМакетаЭтикетки.ИмяПараметровПечати 		= ПолеТабличногоДокумента.ИмяПараметровПечати;
			ОбластьМакетаЭтикетки.ИмяПринтера 				= ПолеТабличногоДокумента.ИмяПринтера;
			ОбластьМакетаЭтикетки.КлючПараметровПечати 		= ПолеТабличногоДокумента.КлючПараметровПечати;
			ОбластьМакетаЭтикетки.КоличествоЭкземпляров 	= ПолеТабличногоДокумента.КоличествоЭкземпляров;
			ОбластьМакетаЭтикетки.МасштабПечати 			= ПолеТабличногоДокумента.МасштабПечати;
			ОбластьМакетаЭтикетки.ОриентацияСтраницы 		= ПолеТабличногоДокумента.ОриентацияСтраницы;
			ОбластьМакетаЭтикетки.ПолеСверху 				= ПолеТабличногоДокумента.ПолеСверху;
			ОбластьМакетаЭтикетки.ПолеСлева 				= ПолеТабличногоДокумента.ПолеСлева;
			ОбластьМакетаЭтикетки.ПолеСнизу 				= ПолеТабличногоДокумента.ПолеСнизу;
			ОбластьМакетаЭтикетки.ПолеСправа 				= ПолеТабличногоДокумента.ПолеСправа;
			ОбластьМакетаЭтикетки.РазборПоКопиям 			= ПолеТабличногоДокумента.РазборПоКопиям;
			ОбластьМакетаЭтикетки.РазмерКолонтитулаСверху 	= ПолеТабличногоДокумента.РазмерКолонтитулаСверху;
			ОбластьМакетаЭтикетки.РазмерКолонтитулаСнизу 	= ПолеТабличногоДокумента.РазмерКолонтитулаСнизу;
			ОбластьМакетаЭтикетки.РазмерСтраницы 			= ПолеТабличногоДокумента.РазмерСтраницы;
			ОбластьМакетаЭтикетки.ТочностьПечати 			= ПолеТабличногоДокумента.ТочностьПечати;
			ОбластьМакетаЭтикетки.ЧерноБелаяПечать 			= ПолеТабличногоДокумента.ЧерноБелаяПечать;
			ОбластьМакетаЭтикетки.ШиринаСтраницы 			= ПолеТабличногоДокумента.ШиринаСтраницы;
			ОбластьМакетаЭтикетки.ЭкземпляровНаСтранице 	= ПолеТабличногоДокумента.ЭкземпляровНаСтранице;
			
			ОбластьМакетаЭтикетки.ОбластьПечати = ОбластьМакетаЭтикетки.Область("R1C1:"+"R"+ОбластьМакетаЭтикетки.ВысотаТаблицы+"C"+ОбластьМакетаЭтикетки.ШиринаТаблицы);
			
			Для НомерКолонки = 1 По ОбластьМакетаЭтикетки.ШиринаТаблицы Цикл
				Для НомерСтроки = 1 По ОбластьМакетаЭтикетки.ВысотаТаблицы Цикл
					Ячейка = ОбластьМакетаЭтикетки.Область(НомерСтроки, НомерКолонки);
					Если Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон Тогда
						МассивПараметров = ГлЯдро_ПозицииПараметровШаблона(Ячейка.Текст);
						
						КоличествоПараметров = МассивПараметров.Количество();
						Для Индекс = 0 По КоличествоПараметров - 1 Цикл
							Структура = МассивПараметров[КоличествоПараметров - 1 - Индекс];
							
							ИмяПараметра = Сред(Ячейка.Текст, Структура.Начало + 1, Структура.Конец - Структура.Начало - 1);
							Если ГлЯдро_СтрНайти(ИмяПараметра, ПрефиксИмениПараметра) = 0 Тогда
								ЛеваяЧасть = Лев(Ячейка.Текст, Структура.Начало);
								ПраваяЧасть = Прав(Ячейка.Текст, СтрДлина(Ячейка.Текст) - Структура.Конец+1);
								
								СохраненноеИмяПараметраМакета = ПараметрыШаблона.Получить(ИмяПараметра);
								Если СохраненноеИмяПараметраМакета = Неопределено Тогда
									СчетчикПараметров = СчетчикПараметров + 1;
									Ячейка.Текст = ЛеваяЧасть + (ПрефиксИмениПараметра + СчетчикПараметров) + ПраваяЧасть;
									ПараметрыШаблона.Вставить(ИмяПараметра, ПрефиксИмениПараметра + СчетчикПараметров);
								Иначе
									Ячейка.Текст = ЛеваяЧасть + (СохраненноеИмяПараметраМакета) + ПраваяЧасть;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					ИначеЕсли Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр Тогда
						Если ГлЯдро_СтрНайти(Ячейка.Параметр, ПрефиксИмениПараметра) = 0 Тогда
							СохраненноеИмяПараметраМакета = ПараметрыШаблона.Получить(Ячейка.Параметр);
							Если СохраненноеИмяПараметраМакета = Неопределено Тогда
								СчетчикПараметров = СчетчикПараметров + 1;
								ПараметрыШаблона.Вставить(Ячейка.Параметр, ПрефиксИмениПараметра + СчетчикПараметров);
								Ячейка.Параметр = ПрефиксИмениПараметра + СчетчикПараметров;
							Иначе
								Ячейка.Параметр = СохраненноеИмяПараметраМакета;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			ТребуетсяПараметрШтрихкод = ПараметрыШаблона.Получить(ИмяПараметраШтрихкод) = Неопределено;
			ТребуетсяПараметрКодВалюты = ПараметрыШаблона.Получить(ИмяПараметраКодВалюты) = Неопределено;
			
			// Вставляем в параметры штрихкод
			Для Каждого Рисунок Из ОбластьМакетаЭтикетки.Рисунки Цикл
				Если ГлЯдро_СтрНайти(Рисунок.Имя, ИмяПараметраШтрихкод) = 1 Тогда
					Если ТребуетсяПараметрШтрихкод Тогда
						ПараметрыШаблона.Вставить(ИмяПараметраШтрихкод, ПрефиксИмениПараметра + (СчетчикПараметров+1));
					КонецЕсли;
					// Заменяем на пустую картинку.
					Рисунок.Картинка = Новый Картинка;
				КонецЕсли;
				Если ГлЯдро_СтрНайти(Рисунок.Имя, "ЗнакВалюты") = 1 Тогда
					Если ТребуетсяПараметрКодВалюты Тогда
						ПараметрыШаблона.Вставить(ИмяПараметраКодВалюты, ПрефиксИмениПараметра + (СчетчикПараметров+1));
					КонецЕсли;
					// Заменяем на пустую картинку.
					Рисунок.Картинка = Новый Картинка;
				КонецЕсли;
			КонецЦикла;
			
			СтруктураМакетаШаблона.Вставить("МакетЭтикетки",    ОбластьМакетаЭтикетки);
			СтруктураМакетаШаблона.Вставить("ИмяОбластиПечати", ОбластьМакетаЭтикетки.ОбластьПечати.Имя);
		Иначе
			СтруктураМакетаШаблона.Вставить("МакетЭтикетки");
			СтруктураМакетаШаблона.Вставить("ИмяОбластиПечати");
		КонецЕсли;
		
	КонецЕсли;
	
	Масштабировать = Истина;
	
	Если НЕ СтруктураМакетаШаблона.Свойство("ТипКода") Тогда
		
		Если ИмяТаблицы = "Ячейки"
			ИЛИ ИмяТаблицы = "Серии" Тогда
			ТипКода = 4;  // Code128
		ИначеЕсли ИмяТаблицы = "ТранспортныеУпаковки" Тогда
			ТипКода = 4;  // 17; // GS-1 Databar Expanded Stacked
			Масштабировать = Ложь;
		Иначе
			ТипКода = 1;  // EAN13
		КонецЕсли;
		
		СтруктураМакетаШаблона.Вставить("ТипКода", ТипКода);
		
	КонецЕсли;
	
	Если НЕ СтруктураМакетаШаблона.Свойство("ТипШтрихкода") Тогда
		СтруктураМакетаШаблона.Вставить("ТипШтрихкода", Неопределено);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("РазмерШрифта") Тогда
		СтруктураМакетаШаблона.Вставить("РазмерШрифта", 12);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("УровеньЧеткости") Тогда
		СтруктураМакетаШаблона.Вставить("УровеньЧеткости", 1);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("МонохромныйШрифт") Тогда
		СтруктураМакетаШаблона.Вставить("МонохромныйШрифт", Истина);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("GS1DatabarКоличествоСтрок") Тогда
		СтруктураМакетаШаблона.Вставить("GS1DatabarКоличествоСтрок", 102);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("УголПоворота") Тогда
		СтруктураМакетаШаблона.Вставить("УголПоворота", 0);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("Масштабировать") Тогда
		СтруктураМакетаШаблона.Вставить("Масштабировать", Масштабировать);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("СохранятьПропорции") Тогда
		СтруктураМакетаШаблона.Вставить("СохранятьПропорции", Ложь);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("ВертикальноеВыравнивание") Тогда
		СтруктураМакетаШаблона.Вставить("ВертикальноеВыравнивание", 1);
	КонецЕсли;
	
	Если НЕ СтруктураМакетаШаблона.Свойство("ОтображатьТекст") Тогда
		СтруктураМакетаШаблона.Вставить("ОтображатьТекст", Истина);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("ПараметрыШаблона") Тогда
		СтруктураМакетаШаблона.Вставить("ПараметрыШаблона", ПараметрыШаблона);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("РедакторТабличныйДокумент") Тогда
		СтруктураМакетаШаблона.Вставить("РедакторТабличныйДокумент", ПолеТабличногоДокумента);
	КонецЕсли;
	
	Если НЕ СтруктураМакетаШаблона.Свойство("КоличествоПоВертикали") Тогда
        СтруктураМакетаШаблона.Вставить("КоличествоПоВертикали", 1);
	КонецЕсли;
	Если НЕ СтруктураМакетаШаблона.Свойство("КоличествоПоГоризонтали") Тогда
		СтруктураМакетаШаблона.Вставить("КоличествоПоГоризонтали", 1);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураМакетаШаблона);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат СтруктураМакетаШаблона;	
	
КонецФункции

Функция ГлЯдро_ПозицииПараметровШаблона(ТекстЯчейки) Экспорт
	
	Массив = Новый Массив;
	
	Начало = -1;
	Конец  = -1;
	СчетчикСкобокОткрывающих = 0;
	СчетчикСкобокЗакрывающих = 0;
	
	Для Индекс = 1 По СтрДлина(ТекстЯчейки) Цикл
		Символ = Сред(ТекстЯчейки, Индекс, 1);
		Если Символ = "[" Тогда
			СчетчикСкобокОткрывающих = СчетчикСкобокОткрывающих + 1;
			Если СчетчикСкобокОткрывающих = 1 Тогда
				Начало = Индекс;
			КонецЕсли;
		ИначеЕсли Символ = "]" Тогда
			СчетчикСкобокЗакрывающих = СчетчикСкобокЗакрывающих + 1;
			Если СчетчикСкобокЗакрывающих = СчетчикСкобокОткрывающих Тогда
				Конец = Индекс;
				
				Массив.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
				
				Начало = -1;
				Конец  = -1;
				СчетчикСкобокОткрывающих = 0;
				СчетчикСкобокЗакрывающих = 0;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ГлЯдро_СформироватьПечатнуюФормуЭтикетки(СтруктураПараметров, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СформироватьПечатнуюФормуЭтикетки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	СтруктураПараметров.Вставить("ЗначенияПараметров", ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных));  
	
	// в инт. обработке может не существовать данного метода
	Попытка
		ТабличныйДокумент = ИнтеграционнаяОбработка.СформироватьПечатнуюФормуЭтикетки(СтруктураПараметров);	
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось сформировать печатную форму этикетки в интеграционной обработке: %1';
							|en = 'The printed form of the label could not be formed during integration processing: %1';
							|be = 'Не атрымалася сфармаваць друкаваную форму этыкеткі ў інтэграцыйнай апрацоўцы: %1'; es = 'No se pudo formar la forma de impresión de la etiqueta en el proceso de integración: %1'; ka = 'ეტიკეტის ნაბეჭდი ფორმა ვერ ჩამოყალიბდა ინტეგრაციის დამუშავების დროს: %1'; kk = 'Интеграциялық өңдеуде жапсырманың баспа формасын қалыптастыру мүмкін болмады: %1'; ro = 'Forma tipărită a etichetei nu a putut fi formată în timpul procesării integrării: %1'; tr = 'Entegrasyon işlemede etiketin basılı formu oluşturulamadı: %1'; uk = 'Не вдалося сформувати друковану форму етикетки в інтеграційній обробці: %1'; uz = 'Integratsion ishlov berishda yorliqning bosma shaklini shakllantirish mumkin emas: %1'");
		ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_СформироватьПечатнуюФормуЭтикетки", "Предупреждение", ТекстОшибки, , АдресаПеременных);	
	КонецПопытки;
	
	Если ТабличныйДокумент <> Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТабличныйДокумент);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат ТабличныйДокумент;	
	КонецЕсли;
	
	// Если табличный документ не сформирован в интеграционной обработке, формируем его общим методом
	
	СтруктураШаблона = СтруктураПараметров.СтруктураШаблона;
	ДанныеДляПечати = СтруктураПараметров.ДанныеДляПечати;	
	
	КоличествоЭкземпляров = 1;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	НомерКолонки = 0;
	НомерРяда = 0;
	
	Область = СтруктураШаблона.МакетЭтикетки.ПолучитьОбласть(СтруктураШаблона.ИмяОбластиПечати);
	
	Для Каждого СтрокаТаблицы Из ДанныеДляПечати Цикл
		
		ЗаполнитьЗначенияСвойств(ТабличныйДокумент, СтруктураШаблона.МакетЭтикетки, , "ОбластьПечати");
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		Для каждого ПараметрШаблона Из СтруктураШаблона.ПараметрыШаблона Цикл
			КлючСтруктуры = ПараметрШаблона.Ключ;
			Пока Найти(КлючСтруктуры, ".") Цикл
				КлючСтруктуры = СтрЗаменить(КлючСтруктуры, ".", "_СимволТочки_");				
			КонецЦикла;
			Если НЕ КлючСтруктуры = "Штрихкод" Тогда
				Попытка	
					Область.Параметры[ПараметрШаблона.Значение] = ?(СтрокаТаблицы.Свойство(КлючСтруктуры), СтрокаТаблицы[КлючСтруктуры], "");
				Исключение                                                 
					// <Лог>
					ИнфоОшибка = ИнформацияОбОшибке();
					ЯзСтрока = "ru = 'При установке параметра макета возникла ошибка';
										|en = 'An error occurred when setting the layout parameter';
										|be = 'Пры ўсталёўцы параметру макета Паўстала памылка'; es = 'Error al configurar el parámetro de diseño'; ka = 'შეცდომა მოხდა განლაგების პარამეტრის დაყენებისას'; kk = 'Орналасу параметрін орнатқан кезде қате пайда болды'; ro = 'A apărut o eroare la setarea parametrului layout'; tr = 'Düzen parametresini ayarlarken bir hata oluştu'; uk = 'Під час встановлення параметра макета виникла помилка'; uz = 'Layout parametrini o''rnatishda xatolik yuz berdi'";
					ТекстОшибки = НСтр(ЯзСтрока);
					
					ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка,, АдресаПеременных);
					// </Лог>
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		// Заполнить картинки штрихкодов
		Попытка
			ИнтеграционнаяОбработка.ЗаполнитьКартинкиШтрихкодов(Новый Структура("Область,СтруктураШаблона,СтрокаТаблицы", Область, СтруктураШаблона, СтрокаТаблицы));
		Исключение
			ТекстОшибки = НСтр("ru = 'Не удалось заполнить картинки штрихкодов в интеграционной обработке: %1';
								|en = 'Barcode images could not be filled in during integration processing: %1';
								|be = 'Не ўдалося запоўніць карцінкі штрыхкодаў у інтэграцыйнай апрацоўцы: %1'; es = 'No se pudieron completar las imágenes de códigos de barras en el procesamiento de integración: %1'; ka = 'შტრიხკოდების სურათები ვერ შეივსო ინტეგრაციის დამუშავების დროს: %1'; kk = 'Интеграциялық өңдеуде штрих-кодтардың суреттерін толтыру мүмкін болмады: %1'; ro = 'Imaginile codurilor de bare nu au putut fi completate în timpul procesării integrării: %1'; tr = 'Entegrasyon işlemede barkod resimleri doldurulamadı: %1'; uk = 'Не вдалося заповнити картинки штрихкодів в інтеграційній обробці: %1'; uz = 'Integratsiya jarayonida shtrixli rasmlarni to''ldirib bo''lmadi: %1'");
			ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_СформироватьПечатнуюФормуЭтикетки", "Предупреждение", ТекстОшибки, , АдресаПеременных);		
		КонецПопытки;
		
		Для Инд = 1 По КоличествоЭкземпляров Цикл // Цикл по количеству экземпляров
			НомерКолонки = НомерКолонки + 1;
			Если НомерКолонки = 1 Тогда
				НомерРяда = НомерРяда + 1;
				ТабличныйДокумент.Вывести(Область);
			Иначе
				ТабличныйДокумент.Присоединить(Область);
			КонецЕсли;
			
			Если НомерКолонки = СтруктураШаблона.КоличествоПоГоризонтали
				И НомерРяда = СтруктураШаблона.КоличествоПоВертикали Тогда
				
				НомерРяда    = 0;
				НомерКолонки = 0;
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
			ИначеЕсли НомерКолонки = СтруктураШаблона.КоличествоПоГоризонтали Тогда
				НомерКолонки = 0;
			КонецЕсли;
		КонецЦикла; // Цикл по количеству экземпляров
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ТабличныйДокумент);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ГлЯдро_ЗаполнитьКартинкиШтрихкодов(СтруктураПараметров, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ЗаполнитьКартинкиШтрихкодов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	// в инт. обработке может не существовать данного метода
	Попытка
		ИнтеграционнаяОбработка.ЗаполнитьКартинкиШтрихкодов(СтруктураПараметров);	
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить картинки штрихкодов в интеграционной обработке: %1';
							|en = 'Barcode images could not be filled in during integration processing: %1';
							|be = 'Не ўдалося запоўніць карцінкі штрыхкодаў у інтэграцыйнай апрацоўцы: %1'; es = 'No se pudieron completar las imágenes de códigos de barras en el procesamiento de integración: %1'; ka = 'შტრიხკოდების სურათები ვერ შეივსო ინტეგრაციის დამუშავების დროს: %1'; kk = 'Интеграциялық өңдеуде штрих-кодтардың суреттерін толтыру мүмкін болмады: %1'; ro = 'Imaginile codurilor de bare nu au putut fi completate în timpul procesării integrării: %1'; tr = 'Entegrasyon işlemede barkod resimleri doldurulamadı: %1'; uk = 'Не вдалося заповнити картинки штрихкодів в інтеграційній обробці: %1'; uz = 'Integratsiya jarayonida shtrixli rasmlarni to''ldirib bo''lmadi: %1'");
		ТекстОшибки = ГлЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации("ГлЯдро_ПолучитьСписокПолейШаблона", "Предупреждение", ТекстОшибки, , АдресаПеременных);	
	КонецПопытки;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие,, АдресаПеременных);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ГлобальныйКонтекст_Документы

#Область ГлобальныйКонтекст_Документы_MobileSMARTS

#Область ГлобальныйКонтекст_Документы_MobileSMARTS_ЧтениеДанных

// Вызывает функцию получения таблицы документов из базы Клеверенс
//
// Параметры:
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Массив из Структура - ключами являются имена колонок таблицы документов Клеверенс,
//						  значениями - значения соответствующих реквизитов документов Клеверенс
Функция ГлЯдро_ПолучитьСписокДокументовНаСервереSMARTS(ТипБазы, РазмерВыборки = 0, ОтборПоПериоду = Неопределено, ОтборПоУзлу = Неопределено, АдресаПеременных) Экспорт
	ПустаяТаблица = ГлЯдро_ПолучитьПустуюТаблицуДокументовSMARTS();
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		СписокДокументов = REST_API_ПолучитьСписокДокументовНаСервереSMARTS(ПустаяТаблица, ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу, АдресаПеременных);
	Иначе
		СписокДокументов = КомЯдро_ПолучитьСписокДокументовНаСервереSMARTS(ПустаяТаблица, ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу, АдресаПеременных);
	КонецЕсли;
	
	Возврат СписокДокументов;
КонецФункции

// Вызывает функцию получения данных документа на сервере Клеверенс и - при необходимости -
// преобразует табличные данные документа из таблиц значений в массивы структур
//
// Параметры:
//	ID_Документа - Строка - идентификатор документа в базе Клеверенс	
//	СтруктураДанныхДокументаMS - Структура - см. КомЯдро_ПолучитьМетаданныеДокументовMS.ДокументыMS или REST_API_ПолучитьМетаданныеДокументовMS.ДокументыMS
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//	КонвертироватьТаблицуЗначенийВМассивСтруктур - Булево - определяет необходимость преобразования табличных данных из таблиц значений в массивы структур
//  ФильтрТЧПоИдДокумента - Неопределено, Строка - фильтр получения табличной части для случая, когда она была объединена из нескольких документов
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	- Структура	- содержит:
//		* ШапкаДокумента - Структура - содержит значения реквизитов шапки документа Клеверенс
//		* СтрокиПлан - ТаблицаЗначений, Массив из Структура - содержит таблицу плановых строк документа Клеверенс  	
//		* СтрокиФакт - ТаблицаЗначений, Массив из Структура - содержит таблицу фактических строк документа Клеверенс
//		* СовмещенныеСтроки - ТаблицаЗначений, Массив из Структура - содержит таблицу совмещенных строк документа Клеверенс
//		* [Имена дополнительных таблиц] - ТаблицаЗначений, Массив из Структура - содержит дополнительные таблицы документа Клеверенс
//		* [Имена таблиц Клеверенс] - ТаблицаЗначений, Массив из Структура - содержит дополнительные таблицы документа Клеверенс, не определенные в метаданных документа Клеверенс,
//																				но фактически присутствующие в экземпляре документа
//	- Неопределено - если получить данные документа не удалось
Функция ГлЯдро_ПолучитьДанныеДокументаMS(ID_Документа, СтруктураДанныхДокументаMS, ТипБазы, КонвертироватьТаблицуЗначенийВМассивСтруктур = Ложь, ФильтрТЧПоИдДокумента = Неопределено, ЗапрашиватьCombinedItems = Истина, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьДанныеДокументаMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,СтруктураДанныхДокументаMS,ТипБазы,КонвертироватьТаблицуЗначенийВМассивСтруктур,ФильтрТЧПоИдДокумента,ЗапрашиватьCombinedItems",
		ID_Документа, СтруктураДанныхДокументаMS, ТипБазы, КонвертироватьТаблицуЗначенийВМассивСтруктур, ФильтрТЧПоИдДокумента, ЗапрашиватьCombinedItems);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Получение данных документа Клеверенс: %1';
						|en = 'Getting started, Getting the Cleverence document data: %1'; be = 'Пачатак, Атрыманне дадзеных дакумента Cleverence: %1'; es = 'Inicio, Obtención de datos del documento Cleverence: %1'; ka = 'მიღება დაიწყო, მიღების Cleverence დოკუმენტის მონაცემები: %1'; kk = 'Бастау, Cleverence құжатының деректерін алу: %1'; ro = 'Noțiuni de bază, obținerea datelor din documentul Cleverence: %1'; tr = 'Başlangıç, Cleverence belgesinin verilerini alma: %1'; uk = 'Початок, отримання даних документа Cleverence: %1'; uz = 'Boshlash, Cleverence hujjat ma''lumotlarini olish: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		ДанныеДокументаMS = REST_API_ПолучитьДанныеДокументаНаСервереSMARTS(ID_Документа, СтруктураДанныхДокументаMS, ТипБазы, ФильтрТЧПоИдДокумента, ЗапрашиватьCombinedItems, АдресаПеременных);
	Иначе
		ДанныеДокументаMS = КомЯдро_ПолучитьДанныеДокументаНаСервереSMARTS(ID_Документа, СтруктураДанныхДокументаMS, ТипБазы, ФильтрТЧПоИдДокумента,, АдресаПеременных);
	КонецЕсли;
	
	Если ДанныеДокументаMS = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
		
	Если КонвертироватьТаблицуЗначенийВМассивСтруктур Тогда
		Для Каждого КЗ Из ДанныеДокументаMS Цикл
			Если ТипЗнч(КЗ.Значение) = Тип("ТаблицаЗначений") Тогда 
				ДанныеДокументаMS.Вставить(КЗ.Ключ,ГлЯдро_ТаблицуЗначенийВМассивСтруктур(КЗ.Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Получение данных документа Клеверенс: %1';
						|en = 'End, Getting the Cleverence document data: %1'; be = 'Канец, Атрыманне дадзеных дакумента Cleverence: %1'; es = 'Fin, Obtención de datos del documento Cleverence: %1'; ka = 'ბოლოს, კლევერენციის დოკუმენტის მონაცემების მიღება: %1'; kk = 'Соңы, Cleverence құжатының деректерін алу: %1'; ro = 'Sfârșit, obținerea datelor documentului Cleverence: %1'; tr = 'Son, Cleverence belgesinin verilerini alma: %1'; uk = 'Кінець, отримання даних документа Cleverence: %1'; uz = 'Tugatish, Cleverence hujjat ma''lumotlarini olish: %1'");
	пСообщение = ГлЯдро_СтрШаблон(пСообщение, Строка(ID_Документа));
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеДокументаMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат ДанныеДокументаMS;
	
КонецФункции

#КонецОбласти

#Область ГлобальныйКонтекст_Документы_MobileSMARTS_ЗаписьДанных

// Вызывает функцию получения данных документа 1С для выгрузки и процедуру записи полученных данных в базу Клеверенс
Функция ГлЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыВБазуSMARTS(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыВБазуSMARTS";
	
	ЗапускВФоне 			= ТипЗнч(АдресРезультата) = Тип("Строка");
	АдресаПеременных 		= ?(ЗапускВФоне, Параметры.ЗначенияПеременных, АдресРезультата);
	
	// <Лог>
	логПоток = ЛогОткрытьПоток(ИмяСобытия, ЭтотОбъект, АдресаПеременных);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Параметры",
		Параметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ПараметрыВыгрузки 		= Параметры.ПараметрыВыгрузки;
	
	СтрокиДокументов1С 		= ПараметрыВыгрузки.СтрокиДокументов1С;
	СоответствиеНастроекБП 	= ПараметрыВыгрузки.СоответствиеНастроекБП;
	ТипБазы					= ПараметрыВыгрузки.ТипБазы;
	ВыгрузитьВОдин			= ПараметрыВыгрузки.ВыгрузитьВОдин;
	
	Если ЗапускВФоне Тогда
		// Временное решение
		ПрогрессВыгрузкиСправочников = Новый Массив;
		Для Каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
			ИмяСправочника = Строка(СтрокаДокумента.Ссылка);
			ИмяТаблицыПредставление = Неопределено;
			
			ПрогрессВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ИмяТаблицыПредставление, Прогресс", ИмяСправочника, ИмяСправочника, 
			НСтр("ru = 'Ожидает';
					|en = 'Awaiting'; be = 'Чакаць'; es = 'Espera'; ka = 'ელოდება'; kk = 'Күтеді'; ro = 'În așteptare'; tr = 'Bekliyor'; uk = 'Очікувавши'; uz = 'Kutmoqda'")
			));
			Если ВыгрузитьВОдин Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ГлЯдро_СообщитьПрогрессВыгрузкиСправочников();
	КонецЕсли;
	
	СписокПередаваемыхНастроек = Новый Структура();
			
	ПроизвольныеКодыШапки = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыШапки", СписокПередаваемыхНастроек, "Выгрузка", "Шапка", АдресаПеременных);	
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыШапки",ПроизвольныеКодыШапки);
	
	ПроизвольныеКодыТабличнойЧасти = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыТабличнойЧасти", СписокПередаваемыхНастроек, "Выгрузка", "ТабличнаяЧасть", АдресаПеременных);	
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыТабличнойЧасти",ПроизвольныеКодыТабличнойЧасти);
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередВыгрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОтправкиДокумента");
	ПроизвольныеКодыОбработчикаВыгрузки = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаВыгрузки", СписокПередаваемыхНастроек, "Выгрузка", МассивТиповОбъектов, АдресаПеременных);		
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаВыгрузки",ПроизвольныеКодыОбработчикаВыгрузки);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередВыгрузкойТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиТЧ");
	МассивТиповОбъектов.Добавить("ПослеОбъединенияТЧ");
	ПроизвольныеКодыОбработчикаТЧ = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаТЧ", СписокПередаваемыхНастроек, "Выгрузка", МассивТиповОбъектов, АдресаПеременных);		
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаТЧ",ПроизвольныеКодыОбработчикаТЧ);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередВыгрузкойСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеОбъединенияСтрокиТЧ");
	ПроизвольныеКодыОбработчикаСтрокиТЧ = ГлЯдро_ПолучитьПроизвольныеКоды("ПроизвольныеКодыОбработчикаСтрокиТЧ", СписокПередаваемыхНастроек, "Выгрузка", МассивТиповОбъектов, АдресаПеременных);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаСтрокиТЧ",ПроизвольныеКодыОбработчикаСтрокиТЧ);
	
	СписокПередаваемыхНастроек.Вставить("ЗначенияПараметров", ГлЯдро_ПолучитьЗначенияГлобальныхПараметров(,,,, АдресаПеременных));
	
	РезультатыВыгрузки = Новый Соответствие;
	
	Если ВыгрузитьВОдин Тогда
		
		МассивСсылокДокументов = Новый Массив;
		Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
			МассивСсылокДокументов.Добавить(СтрокаДокумента.Ссылка);
		КонецЦикла;
		
		Документ1С = МассивСсылокДокументов[0];
		ID_БизнесПроцесса = ПараметрыВыгрузки.ВыгрузитьВОдин_НастройкаБП;
		
		НастройкаБП = СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
		УказатьПользователя 				= НастройкаБП.НазначитьПользователю =  "Спрашивать при выгрузке";	
		НазначенныеПользователи 			= ?(НастройкаБП.НазначитьПользователю = "Выгружать всем", Неопределено, ПараметрыВыгрузки.ВыгрузитьВОдин_НазначенныеПользователи);
		КопияДляКаждогоПользователя 		= ?(ЗначениеЗаполнено(НазначенныеПользователи), НастройкаБП.КопияДокументаДляКаждогоПользователя, Ложь);
		СпособНазначения 					= ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
		
		СписокБизнесПроцессов = Новый Массив;
		СписокБизнесПроцессов.Добавить(НастройкаБП);
		СписокПередаваемыхНастроек.Вставить("СписокБизнесПроцессов",  СписокБизнесПроцессов);
		
		РезультатВыгрузки = ГлЯдро_СформироватьИЗаписатьДокументВБазуSMARTS(МассивСсылокДокументов, 
								СписокПередаваемыхНастроек, 
								ID_БизнесПроцесса, 
								ТипБазы, 
								НазначенныеПользователи, 
								КопияДляКаждогоПользователя, 
								СпособНазначения, 
								АдресаПеременных);
			
		Если ЗапускВФоне Тогда
			// Временное решение
			ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(Строка(Документ1С), ?(РезультатВыгрузки.СтатусВыгрузки, 
				НСтр("ru = 'Выгружено';
						|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'"), 
				НСтр("ru = 'Ошибка';
						|en = 'Mistake'; be = 'Памылка'; es = 'Error'; ka = 'შეცდომა'; kk = 'Қате'; ro = 'Greșeală'; tr = 'Hata'; uk = 'Помилка'; uz = 'Xato'")
				));  
		КонецЕсли;
		
		РезультатыВыгрузки.Вставить(СтрокиДокументов1С[0], РезультатВыгрузки);
		
	Иначе
		Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл			
			Документ1С = СтрокаДокумента.Ссылка;
			ID_БизнесПроцесса = СтрокаДокумента.НастройкаБизнесПроцесса;
			
			НастройкаБП = СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
			УказатьПользователя 				= НастройкаБП.НазначитьПользователю =  "Спрашивать при выгрузке";	
			НазначенныеПользователи 			= ?(НастройкаБП.НазначитьПользователю = "Выгружать всем", Неопределено, СтрокаДокумента.НазначенныеПользователи);
			КопияДляКаждогоПользователя 		= ?(ЗначениеЗаполнено(НазначенныеПользователи), НастройкаБП.КопияДокументаДляКаждогоПользователя, Ложь);
			СпособНазначения 					= ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
			
			СписокБизнесПроцессов = Новый Массив;
			СписокБизнесПроцессов.Добавить(НастройкаБП);
			СписокПередаваемыхНастроек.Вставить("СписокБизнесПроцессов",  СписокБизнесПроцессов);
			
			РезультатВыгрузки = ГлЯдро_СформироватьИЗаписатьДокументВБазуSMARTS(Документ1С, 
									СписокПередаваемыхНастроек, 
									ID_БизнесПроцесса, 
									ТипБазы, 
									НазначенныеПользователи, 
									КопияДляКаждогоПользователя, 
									СпособНазначения, 
									АдресаПеременных);
															
			Если ЗапускВФоне Тогда
				// Временное решение
				ГлЯдро_СообщитьПрогрессВыгрузкиСправочников(Строка(Документ1С), ?(РезультатВыгрузки.СтатусВыгрузки, 
					НСтр("ru = 'Выгружено';
							|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'"), 
					НСтр("ru = 'Ошибка';
							|en = 'Mistake'; be = 'Памылка'; es = 'Error'; ka = 'შეცდომა'; kk = 'Қате'; ro = 'Greșeală'; tr = 'Hata'; uk = 'Помилка'; uz = 'Xato'")
					));  
			КонецЕсли;
			
			РезультатыВыгрузки.Вставить(СтрокаДокумента, РезультатВыгрузки);
			
		КонецЦикла;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	ЛогЗакрытьПоток(логПоток, АдресаПеременных);
	// </Лог>
	
	Если ЗапускВФоне Тогда
		ПоместитьВоВременноеХранилище(РезультатыВыгрузки, АдресРезультата);
	Иначе
		Возврат РезультатыВыгрузки;
	КонецЕсли;
	
КонецФункции

// Вызывает функцию получения данных документа 1С для выгрузки и процедуру записи полученных данных в базу Клеверенс
//
// Параметры:
//	Документ1С - ДокументСсылка - документ в базе, выгружаемый на сервер Клеверенс
//  СписокПередаваемыхНастроек - Неопределено, Структура - содержит:
//		* СписокБизнесПроцессов - Неопределено, ТаблицаЗначений, Массив из Структура - содержит настройки отобранных бизнес-процессов
//		* ПроизвольныеКодыШапки - Неопределено, ТаблицаЗначений, Массив из Структура - содержит произвольные коды для выгрузки шапки документа
//		* ПроизвольныеКодыТабличнойЧасти - Неопределено, ТаблицаЗначений, Массив из Структура - содержит произвольные коды для выгрузки табличных частей документа
//		* ГлобальныеПараметры - Неопределено, ТаблицаЗначений, Массив из Структура - содержит значения глобальных параметров
//  ID_БизнесПроцесса - Строка - идентификатор бизнес-процесса
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//  НазначенныеПользователи - Неопределено
//							- Строка - идентификторы пользователей или устройств Клеверенс, которым назначается документ, разделенные "|"
//							- Массив из Структура - содержит:
//								* Ид - Строка - идентификатор пользователя или устройства Клеверенс, которому назначается документ
//                              * Имя - Строка - наименование пользователя или устройства Клеверенс, которому назначается документ
//  КопияДляКаждогоПользователя - Булево - признак необходимости создавать отдельную копию выгружаемого документа для каждого из назначенных пользователей
//  СпособНазначения - Строка - "", "Устройству", "Пользователям"
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
Функция ГлЯдро_СформироватьИЗаписатьДокументВБазуSMARTS(Документ1С, СписокПередаваемыхНастроек, ID_БизнесПроцесса = "", ТипБазы,НазначенныеПользователи,КопияДляКаждогоПользователя = Ложь, СпособНазначения = "", АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_СформироватьИЗаписатьДокументВБазуSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Документ1С,СписокПередаваемыхНастроек,ID_БизнесПроцесса,ТипБазы,НазначенныеПользователи,КопияДляКаждогоПользователя,СпособНазначения",
		Документ1С, СписокПередаваемыхНастроек, ID_БизнесПроцесса, ТипБазы, НазначенныеПользователи, КопияДляКаждогоПользователя, СпособНазначения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	РезультатВыгрузки = Новый Структура;
	РезультатВыгрузки.Вставить("СтатусВыгрузки", Ложь);
	РезультатВыгрузки.Вставить("СообщениеОбОшибках", "");
	
	пСообщение = НСтр("ru = 'Начало, Выгрузка документа в базу SMARTS';
						|en = 'Getting started, Uploading a document to the Cleverence database'; be = 'Пачатак, Выгрузка дакумента ў базу Cleverence'; es = 'Inicio, Descarga el documento en la base de Cleverence'; ka = 'დაწყება, დოკუმენტის ატვირთვა Cleverence მონაცემთა ბაზაში'; kk = 'Бастау, құжатты Cleverence базасына түсіру'; ro = 'Noțiuni de bază, încărcarea unui document în baza de date Cleverence'; tr = 'Başlangıç, Belgeyi Cleverence veritabanına yükleme'; uk = 'Початок, вивантаження документа в базу Cleverence'; uz = 'Boshlash, hujjatni Cleverence bazasiga yuklash'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, , АдресаПеременных);
	
	Если ТипЗнч(Документ1С) = Тип("Массив") Тогда
		МассивДанныхДокументовКОбъединению = Новый Массив;
		СтрокаИдИсходныхДокументов = "";
		Для Каждого ДокументКОбъединению Из Документ1С Цикл
			ДанныеДокумента = ГлЯдро_ПолучитьДанныеДокумента1СДляВыгрузки(ДокументКОбъединению, СписокПередаваемыхНастроек, ID_БизнесПроцесса, АдресаПеременных);
			
			Если ДанныеДокумента = Неопределено Тогда
				пСообщение = НСтр("ru = 'Не удалось получить данные документа «%1». Выгрузка объединённого документа продолжится без этого документа. Подробности см. в журнале регистрации.';
									|en = 'Document data ""%1"" could not be retrieved. The combined document will continue to be uploaded without this document. For details, see in the registration log.';
									|be = 'Не атрымалася атрымаць дадзеныя дакумента «%1». Выгрузка аб''яднанага дакумента працягнецца без гэтага дакумента. Падрабязнасці гл. у часопісе рэгістрацыі.'; es = 'No se pudieron obtener los datos del documento ""%1"". La descarga del documento combinado continuará sin este documento. Consulte el registro para obtener más detalles.'; ka = 'დოკუმენტის მონაცემები ""%1 "" ვერ იქნა მოძიებული. კომბინირებული დოკუმენტის ატვირთვა გაგრძელდება ამ დოკუმენტის გარეშე. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში.'; kk = '""%1 "" құжатының деректерін алу мүмкін болмады. Біріктірілген құжатты түсіру осы құжатсыз жалғасады. Мәліметтерді тіркеу журналынан қараңыз.'; ro = 'Datele documentului ""%1 "" nu au putut fi recuperate. Documentul combinat va continua să fie încărcat fără acest document. Consultați jurnalul de înregistrare pentru detalii.'; tr = '«%1"" belgesinin verileri alınamadı. Birleştirilmiş belgenin yüklenmesi bu belge olmadan devam edecektir. Ayrıntılar için kayıt defterine bakın.'; uk = 'Не вдалося отримати дані документа ""%1"". Вивантаження об''єднаного документа продовжиться без цього документа. Подробиці див. в журналі реєстрації.'; uz = '""%1 "" hujjat ma''lumotlarini olish mumkin emas edi. Birlashtirilgan hujjatni tushirish ushbu hujjatsiz davom etadi. Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang.'");
				пСообщение = ГлЯдро_СтрШаблон(пСообщение, ДокументКОбъединению);
				Сообщить(пСообщение);
				Продолжить;
			КонецЕсли;     
			
			МассивДанныхДокументовКОбъединению.Добавить(ДанныеДокумента);
			СтрокаИдИсходныхДокументов = СтрокаИдИсходныхДокументов +?(СтрокаИдИсходныхДокументов="","",";")+ ДанныеДокумента.ШапкаДокумента.Ид;
		КонецЦикла;
		
		// Если во всех документах были критические ошибки - завершаем процесс
		Если Не МассивДанныхДокументовКОбъединению.Количество() Тогда
			пСообщение = НСтр("ru = 'Конец, Выгрузка документа в базу SMARTS';
								|en = 'End, Uploading the document to the Cleverence database'; be = 'Канец, выгрузка дакумента ў базу Cleverence'; es = 'Fin, Descarga el documento a la base de Cleverence'; ka = 'დასასრული, დოკუმენტის ატვირთვა Cleverence მონაცემთა ბაზაში'; kk = 'Соңы, құжатты Cleverence базасына түсіру'; ro = 'End, încărcarea documentului în baza de date Cleverence'; tr = 'Son, Belgenin Cleverence veritabanına yüklenmesi'; uk = 'Кінець, вивантаження документа в базу Cleverence'; uz = 'Tugatish, hujjatni Cleverence bazasiga yuklash'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			пСообщение = НСтр("ru = 'Выгрузка объединённого документа прервана, так как не удалось получить данные ни по одному документу. Подробности см. в журнале регистрации.';
								|en = 'The combined document was aborted because it was not possible to receive data on any document. For details, see in the registration log.';
								|be = 'Выгрузка аб''яднанага дакумента перапыненая, бо не ўдалося атрымаць дадзеныя ні па адным з дакументаў. Падрабязнасці гл. у часопісе рэгістрацыі.'; es = 'La descarga del documento combinado se interrumpió porque no se pudieron recuperar datos de ningún documento. Consulte el registro para obtener más detalles.'; ka = 'კომბინირებული დოკუმენტი შეწყდა, რადგან ვერცერთ დოკუმენტზე მონაცემების მიღება ვერ მოხერხდა. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში.'; kk = 'Біріктірілген құжатты түсіру үзілді, өйткені бірде-бір құжат бойынша деректерді алу мүмкін болмады. Мәліметтерді тіркеу журналынан қараңыз.'; ro = 'Documentul combinat a fost anulat deoarece nu a fost posibil să se primească date despre niciun document. Consultați jurnalul de înregistrare pentru detalii.'; tr = 'Herhangi bir belgeden veri alınamadığı için birleştirilmiş belgenin yüklenmesi kesintiye uğradı. Ayrıntılar için kayıt defterine bakın.'; uk = 'Вивантаження об''єднаного документа перервана, так як не вдалося отримати дані ні по одному документу. Подробиці див. в журналі реєстрації.'; uz = 'Birlashtirilgan hujjatni tushirish to''xtatildi, chunki biron bir hujjat bo''yicha ma''lumot olishning iloji bo''lmadi. Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang.'");
			Сообщить(пСообщение);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат РезультатВыгрузки;
		КонецЕсли;                                             
		
		// В шапке будет информация из первого выбранного документа+ список Ид объединенных документов
		ШапкаДокумента = МассивДанныхДокументовКОбъединению[0].ШапкаДокумента;
		ШапкаДокумента.Вставить("ИдИсходныхДокументов",СтрокаИдИсходныхДокументов);
		
		// добавим ключи всех выгружаемых ТЧ по полученной структуре из первого документа
		ТабличныеЧастиОбъединенные = Новый Структура;			
		Для Каждого ТабличнаяЧасть Из МассивДанныхДокументовКОбъединению[0].ТабличныеЧасти Цикл
			ТабличныеЧастиОбъединенные.Вставить(ТабличнаяЧасть.Ключ, Новый Массив);	
		КонецЦикла;
		
		Для Каждого ДокументКОбъединению Из МассивДанныхДокументовКОбъединению Цикл
			Для Каждого ТабличнаяЧасть Из ДокументКОбъединению.ТабличныеЧасти Цикл 
				Для Каждого СтрокаТЧ Из  ТабличнаяЧасть.Значение Цикл
					СтрокаСтруктурой = СтрокаТЧ;
					СтрокаСтруктурой.Вставить("ИдДокумента",ДокументКОбъединению.ШапкаДокумента.Ид);
					ТабличныеЧастиОбъединенные[ТабличнаяЧасть.Ключ].Добавить(СтрокаСтруктурой);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		ДанныеОбъединенногоДокумента = Новый Структура;			
		ДанныеОбъединенногоДокумента.Вставить("ШапкаДокумента",ШапкаДокумента);
		ДанныеОбъединенногоДокумента.Вставить("ТабличныеЧасти", ТабличныеЧастиОбъединенные);
		ДанныеОбъединенногоДокумента.Вставить("МетаданныеДокументаMS", МассивДанныхДокументовКОбъединению[0].МетаданныеДокументаMS);
		ДанныеДокумента = ДанныеОбъединенногоДокумента;
	Иначе
				
		ДанныеДокумента = ГлЯдро_ПолучитьДанныеДокумента1СДляВыгрузки(Документ1С, СписокПередаваемыхНастроек, ID_БизнесПроцесса,АдресаПеременных);				
		// Если в документе были критические ошибки, завершаем процесс
		Если ДанныеДокумента = Неопределено Тогда
			пСообщение = НСтр("ru = 'Конец, Выгрузка документа в базу SMARTS';
								|en = 'End, Uploading the document to the Cleverence database'; be = 'Канец, выгрузка дакумента ў базу Cleverence'; es = 'Fin, Descarga el documento a la base de Cleverence'; ka = 'დასასრული, დოკუმენტის ატვირთვა Cleverence მონაცემთა ბაზაში'; kk = 'Соңы, құжатты Cleverence базасына түсіру'; ro = 'End, încărcarea documentului în baza de date Cleverence'; tr = 'Son, Belgenin Cleverence veritabanına yüklenmesi'; uk = 'Кінець, вивантаження документа в базу Cleverence'; uz = 'Tugatish, hujjatni Cleverence bazasiga yuklash'");
			ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат РезультатВыгрузки;
		КонецЕсли;     
		
	КонецЕсли;
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	
	Если ТипЗнч(НазначенныеПользователи) = Тип("Массив")
		И НазначенныеПользователи.Количество() > 0 Тогда
		НазначенныеПользователиМассив = НазначенныеПользователи;
		НазначенныеПользователиСтрокой = "";
		Для Каждого НазначенныйПользователь ИЗ НазначенныеПользователи Цикл
			НазначенныеПользователиСтрокой = НазначенныеПользователиСтрокой+?(НазначенныеПользователиСтрокой = "","","|")+НазначенныйПользователь.Ид;
		КонецЦикла;
	ИначеЕсли ТипЗнч(НазначенныеПользователи) = Тип("Строка")
		И ЗначениеЗаполнено(НазначенныеПользователи) Тогда
		НазначенныеПользователиМассив = ГлЯдро_РазложитьСтрокуВМассивПодстрок(НазначенныеПользователи, "|");
		НазначенныеПользователиСтрокой = НазначенныеПользователи;
	Иначе
		НазначенныеПользователиМассив = Неопределено;
		НазначенныеПользователиСтрокой = Неопределено;
	КонецЕсли;
	
	Если НазначенныеПользователиМассив <> Неопределено 
		И НазначенныеПользователиСтрокой <> Неопределено Тогда
		Если КопияДляКаждогоПользователя Тогда
			Если ТипИнтерфейса = "REST_API" Тогда
				Для Каждого НазначенныйПользователь ИЗ НазначенныеПользователиМассив Цикл
					ДокументSMARTS  = REST_API_СформироватьНовыйДокументSMARTS(ДанныеДокумента,НазначенныйПользователь,АдресаПеременных,,СпособНазначения);
					REST_API_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы, АдресаПеременных);
				КонецЦикла;
			Иначе
				Для Каждого НазначенныйПользователь ИЗ НазначенныеПользователиМассив Цикл
					ДокументSMARTS  = КомЯдро_СформироватьНовыйДокументSMARTS(ДанныеДокумента,НазначенныйПользователь, СпособНазначения);		
					КомЯдро_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных);
				КонецЦикла;
			КонецЕсли;
		Иначе
			Если ТипИнтерфейса = "REST_API" Тогда
				ДокументSMARTS  = REST_API_СформироватьНовыйДокументSMARTS(ДанныеДокумента,НазначенныеПользователиСтрокой,АдресаПеременных,,СпособНазначения);
				REST_API_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных);
			Иначе
				ДокументSMARTS  = КомЯдро_СформироватьНовыйДокументSMARTS(ДанныеДокумента,НазначенныеПользователиСтрокой, СпособНазначения);		
				КомЯдро_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных);	
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если ТипИнтерфейса = "REST_API" Тогда
			ДокументSMARTS  = REST_API_СформироватьНовыйДокументSMARTS(ДанныеДокумента,"",АдресаПеременных);		
			REST_API_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных);
		Иначе
			ДокументSMARTS  = КомЯдро_СформироватьНовыйДокументSMARTS(ДанныеДокумента);		
			КомЯдро_ЗаписатьДокументВБазуSMARTS(ДокументSMARTS, ТипБазы,АдресаПеременных);	
		КонецЕсли;
	КонецЕсли;
	      	
	ГлЯдро_ОбработатьДокумент1СПослеВыгрузкиНаСерверSMARTS(Документ1С, ДанныеДокумента, СписокПередаваемыхНастроек, ID_БизнесПроцесса, АдресаПеременных);
	
	пСообщение = НСтр("ru = 'Конец, Выгрузка документа в базу SMARTS';
						|en = 'End, Uploading the document to the Cleverence database'; be = 'Канец, выгрузка дакумента ў базу Cleverence'; es = 'Fin, Descarga el documento a la base de Cleverence'; ka = 'დასასრული, დოკუმენტის ატვირთვა Cleverence მონაცემთა ბაზაში'; kk = 'Соңы, құжатты Cleverence базасына түсіру'; ro = 'End, încărcarea documentului în baza de date Cleverence'; tr = 'Son, Belgenin Cleverence veritabanına yüklenmesi'; uk = 'Кінець, вивантаження документа в базу Cleverence'; uz = 'Tugatish, hujjatni Cleverence bazasiga yuklash'");
	ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия, АдресаПеременных);
	
	Если ТипЗнч(ДанныеДокумента) = Тип("Структура")
		И ДанныеДокумента.Свойство("КритическаяОшибка")
		И ДанныеДокумента.КритическаяОшибка = Истина Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат РезультатВыгрузки;
	КонецЕсли;
	
	РезультатВыгрузки.СтатусВыгрузки = Истина;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатВыгрузки;
	
КонецФункции

// Вызывает процедуру удаления документа на сервере Клеверенс
//
// Параметры:
//	ID_Документа - Строка - идентификатор документа, который требуется удалить	
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности операции удаления
//		* Сообщение - Строка - информационное сообщение о результате удаления документа
Функция ГлЯдро_УдалитьДокументНаСервереSMARTS(ID_Документа, ТипБазы, ДополнительныеПараметры = Неопределено, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_УдалитьДокументНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,ТипБазы,ДополнительныеПараметры",
		ID_Документа, ТипБазы, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
		
	Если ТипИнтерфейса = "REST_API" Тогда
		ДокументУдален = REST_API_УдалитьДокументНаСервереSMARTS(ID_Документа, ТипБазы,АдресаПеременных);
	Иначе
		ДокументУдален = КомЯдро_УдалитьДокументНаСервереSMARTS(ID_Документа, ТипБазы,АдресаПеременных);
	КонецЕсли;
	
	ИмяДокумента = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")	И ДополнительныеПараметры.Свойство("ИмяДокумента") Тогда
		ИмяДокумента = СокрЛП(ДополнительныеПараметры.ИмяДокумента);
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			ИмяДокумента = """" + ИмяДокумента + """ ";
		КонецЕсли;
	КонецЕсли;
	
	Если ДокументУдален Тогда
		пСообщение = НСтр("ru = 'Документ %1 удален с ТСД!';
							|en = 'Document %1 has been deleted from the Mobile device!'; be = 'Дакумент %1 выдалены з Мабільнае прылада!'; es = '¡El documento %1 se ha eliminado del dispositivo móvil!'; ka = 'დოკუმენტი %1 ამოღებულია მობილური მოწყობილობიდან!'; kk = '% 1 құжаты жойылды мобильді құрылғы!'; ro = 'Documentul %1 a fost șters de pe dispozitivul mobil!'; tr = 'Belge %1 silindi Mobil cihaz!'; uk = 'Документ %1 видалено з мобільний пристрій!'; uz = '%1 hujjati o''chirildi mobil qurilma!'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяДокумента);
		РезультатУдаления = Новый Структура("Сообщение,Статус", пСообщение, Истина);
	Иначе
		пСообщение = НСтр("ru = 'Не удалось удалить документ %1с ТСД!';
							|en = 'Couldn''t delete %1c Mobile Device document!'; be = 'Не атрымалася выдаліць дакумент %1с Мабільнае прылада!'; es = 'No se pudo eliminar el documento %1C ¡dispositivo Móvil!'; ka = 'ვერ წაშალა %1c მობილური მოწყობილობის დოკუმენტი!'; kk = '%1С мобильді құрылғы құжатын жою мүмкін болмады!'; ro = 'Nu s-a putut șterge documentul dispozitivului mobil %1C!'; tr = '%1c Mobil cihaz belgesi silinemedi!'; uk = 'Не вдалося видалити документ % 1С мобільний пристрій!'; uz = '%1C mobil qurilma hujjatini o''chirib bo''lmadi!'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, ИмяДокумента);
		РезультатУдаления = Новый Структура("Сообщение,Статус", пСообщение, Ложь);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатУдаления);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатУдаления;
	
КонецФункции

Функция ГлЯдро_УстановитьСтатусДокументаНаСервереSMARTS(ID_Документа, ТипБазы, Статус,АдресаПеременных)
	
	ИмяСобытия = "ГлЯдро_УстановитьСтатусДокументаНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Документа,ТипБазы,Статус",
		ID_Документа, ТипБазы, Статус);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	ТипИнтерфейса = ГлЯдро_ПолучитьТипИнтерфейса(ТипБазы, АдресаПеременных);
	Если ТипИнтерфейса = "REST_API" Тогда
		СтатусУстановлен = REST_API_УстановитьСтатусДокументаНаСервереSMARTS(ID_Документа, ТипБазы, Статус,АдресаПеременных);
	Иначе
		СтатусУстановлен = КомЯдро_УстановитьСтатусДокументаНаСервереSMARTS(ID_Документа, ТипБазы, Статус,АдресаПеременных);
	КонецЕсли;
	
	Если СтатусУстановлен = Истина Тогда
		пСообщение = НСтр("ru = 'Успешно установлен статус [%1]!';
							|en = 'The [%1] status has been successfully established!'; be = 'Паспяхова ўсталяваны статус [%1]!'; es = '¡El estado [%1] se ha establecido correctamente!'; ka = '[%1] სტატუსი წარმატებით დამკვიდრდა!'; kk = '[%1] мәртебесі сәтті орнатылды!'; ro = 'Statutul [%1] a fost stabilit cu succes!'; tr = '[%1] durumu başarıyla belirlendi!'; uk = 'Успішно встановлено статус [%1]!'; uz = 'Status muvaffaqiyatli o''rnatildi [%1]!'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Статус);
		РезультатУстановкиСтатуса = Новый Структура("Сообщение,Статус", пСообщение, Истина);
	Иначе
		пСообщение = НСтр("ru = 'Не удалось установить статус [%1]!';
							|en = 'The [%1] status could not be set!'; be = 'Не атрымалася ўсталяваць статус [%1]!'; es = '¡No se pudo establecer el estado [%1]!'; ka = '[%1] სტატუსი ვერ შეიქმნა!'; kk = '[%1] мәртебесін орнату мүмкін болмады!'; ro = 'Starea [%1] nu a putut fi setată!'; tr = '[%1] statüsü belirlenemedi!'; uk = 'Не вдалося встановити статус [%1]!'; uz = 'Statusni o''rnatib bo''lmadi [%1]!'");
		пСообщение = ГлЯдро_СтрШаблон(пСообщение, Статус);
		РезультатУстановкиСтатуса = Новый Структура("Сообщение,Статус", пСообщение, Ложь);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатУстановкиСтатуса);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат РезультатУстановкиСтатуса;

КонецФункции

// Возвращает SMARTS-документ в работу.
//
// Параметры:
//  ИдДокумента - Строка - идентификатор документа SMARTS.
//  ТипБазы - Строка - тип базы SMARTS.
//  НазначениеДокумента - Строка, Неопределено - назначение документа.
//  АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//  Булево - Истина, если шапка документа обновлена.
//
Функция ГлЯдро_ВозвратДокументаВРаботу_ВернутьВРаботу(ИдДокумента, ТипБазы, НазначениеДокумента, АдресаПеременных) Экспорт
	
	ПоляШапки = Новый Соответствие;
	ПоляШапки.Вставить("finished", Ложь);
	ПоляШапки.Вставить("inProcess", Ложь);
	
	Если ЗначениеЗаполнено(НазначениеДокумента) Тогда
		ПоляШапки.Вставить("appointment", НазначениеДокумента);
	КонецЕсли;
	
	Возврат REST_API_ОбновитьШапкуДокументаSMARTS(ИдДокумента, ТипБазы, ПоляШапки, АдресаПеременных);
	
КонецФункции

#КонецОбласти

#Область ГлобальныйКонтекст_Документы_MobileSMARTS_ВспомогательныеМеханизмы

// Возвращает массив, содержащий структуру, ключами которой являются имена колонок таблицы документов Клеверенс
//
// Возващаемое значение:
//	Массив из Структура - содержит имена колонок таблицы документов Клеверенс	
Функция ГлЯдро_ПолучитьПустуюТаблицуДокументовSMARTS(АдресаПеременных = Неопределено) Экспорт
		
	ТаблицаДокументов = Новый Массив;
	ТаблицаДокументов.Добавить(Новый Структура("КолонкиТаблицыЗначений,ЭтоТаблицаЗначений", "ДатаСоздания,Имя,Ид,ИмяТипаДокумента,СтрокиПланКоличество,СтрокиФактКоличество,ИмяПользователя,ВОбработке,Завершен,НастройкаБизнесПроцесса,ИдИсходныхДокументов,ИдУзла,КонтрольКоличества", Истина));
	
	Возврат ТаблицаДокументов;
КонецФункции

Функция ГлЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента(ПинКод, ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПинКод,ТипБазы",
		ПинКод, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МассивУстройств = Новый Массив;
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной,АдресаПеременных); 
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивУстройств);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат МассивУстройств;
	КонецЕсли;
	
	// Посылаем запрос на сервер
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"Devices");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);	
	
	// Обрабатываем ответ сервера
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивУстройств);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат МассивУстройств;
	Иначе
		Devices = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	// Ищем по введенному пин-коду устройство
	Для Каждого Устройство Из Devices Цикл
		Если Устройство.Получить("pincode") = ПинКод Тогда
			ИдУстройства = Устройство.Получить("deviceId");
			МассивУстройств.Добавить(Новый Структура("Ид,Имя", ИдУстройства, ИдУстройства));			
			Прервать;
		КонецЕсли;
	КонецЦикла;    	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивУстройств);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивУстройств;
	
КонецФункции

Функция ГлЯдро_ПолучениеАрхивныхДокументовSMARTS(ПараметрыЗапроса, ФильтрыЗапроса, ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучениеАрхивныхДокументовSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗапроса,ФильтрыЗапроса,ТипБазы",
		ПараметрыЗапроса, ФильтрыЗапроса, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МассивДокументов = Новый Массив;
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных); 
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивДокументов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат МассивДокументов;
	КонецЕсли;
	
	ОтправляемыеДанные = Новый Соответствие;	
	Для Каждого СтрПараметра Из ПараметрыЗапроса Цикл
		ОтправляемыеДанные.Вставить(СтрПараметра.Ключ, СтрПараметра.Значение);				
	КонецЦикла;                                                               	
	
	ТекстМетода = "Operations('ПолучитьАрхДокументы')";
	
	Если ЗначениеЗаполнено(ФильтрыЗапроса) Тогда
		ТекстМетода = ТекстМетода + "?$filter=";
		Для Каждого СтрФильтра Из ФильтрыЗапроса Цикл
			Если (СтрФильтра.Ключ = "id")Тогда                                   
				ТекстФильтра = СтрФильтра.Ключ + " eq '" + СтрФильтра.Значение + "' and ";				
			Иначе
				ТекстФильтра = "contains(" + СтрФильтра.Ключ + ",'" + СтрФильтра.Значение + "') and ";
			КонецЕсли;
			ТекстМетода = ТекстМетода + ТекстФильтра;
		КонецЦикла;
		ТекстМетода = Лев(ТекстМетода, СтрДлина(ТекстМетода) - 5);
	КонецЕсли;                                              
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
	СтруктураЗапроса.Вставить("Метод", 		ТекстМетода);
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеСпискаДокументов");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
	// Обрабатываем ответ сервера
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета,, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивДокументов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат МассивДокументов;
	Иначе
		Documets = СтруктураОтвета.ОтветСервера.Получить("documentList");	
		Если Documets = Неопределено Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивДокументов);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат МассивДокументов;
		КонецЕсли;
	КонецЕсли;
			
	// Обходим выборку, заполняем массив данных для возврата на форму
	Для Каждого Document Из Documets Цикл
		
		СтруктураДокумента = Новый Структура("Синоним,УИД,ИДУстройства,ИмяФайла,Тип,ВремяБэкапа", "", "", "", "", "", "");
		
		СтруктураДокумента.Синоним 			= Document["name"];
		СтруктураДокумента.УИД 				= Document["id"];
		СтруктураДокумента.ИДУстройства 	= Document["deviceId"];
		
		СтруктураДокумента.ИмяФайла 		= Document["fileName"];		
		СтруктураДокумента.Тип 				= Document["documentTypeName"];
		СтруктураДокумента.ВремяБэкапа		= REST_API_ПреобразоватьКДате(Document["backupTime"]);
		
		МассивДокументов.Добавить(СтруктураДокумента);
		
	КонецЦикла;    	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивДокументов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ГлЯдро_ВосстановитьДокументыSMARTS(МассивДокументов, ТипБазы, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ВосстановитьДокументыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивДокументов,ТипБазы",
		МассивДокументов, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	// Получаем настройки подключения
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной, АдресаПеременных); 
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	МассивДокументовНаВосстановление = Новый Массив;
	
	Для Каждого СтруктураДокумента Из МассивДокументов Цикл
		МассивДокументовНаВосстановление.Добавить(СтруктураДокумента.УИД);		
	КонецЦикла;
	
	ОтправляемыеДанные = Новый Соответствие;
	ОтправляемыеДанные.Вставить("FilesInfo@odata.type", "#Collection(Guid)");
	ОтправляемыеДанные.Вставить("FilesInfo", 			МассивДокументовНаВосстановление);
	
	// Посылаем запрос на сервер
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
	СтруктураЗапроса.Вставить("Метод", 		"Operations('ВосстановитьДокументы')");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	// Обрабатываем ответ сервера
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		Результат = Ложь;
	Иначе
		Результат = СтруктураОтвета.ОтветСервера.Получить("result");			
	КонецЕсли;

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

Функция ГлЯдро_ПроверитьНаличиеСовмещенныхСтрокВНастройкеБП(НастройкаБП)

	ЗапрашиватьCombinedItems = Истина; // По умолчанию запрашиваем CombinedItems
	
	Если ТипЗнч(НастройкаБП) <> Тип("Структура") Тогда
		Возврат ЗапрашиватьCombinedItems;	
	КонецЕсли;		
		
	СовмещенныеСтрокиЗагрузка = Ложь;
	СовмещенныеСтрокаВыгрузка = Ложь;
	
	НастройкаЗагрузкиТЧ = Неопределено;
	НастройкаВыгрузкиТЧ = Неопределено;
	Если НастройкаБП.Свойство("НастройкаЗагрузкиТЧ", НастройкаЗагрузкиТЧ)
		И ТипЗнч(НастройкаЗагрузкиТЧ) = Тип("Массив") Тогда
		СовмещенныеСтрокиЗагрузка = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкаЗагрузкиТЧ, Новый Структура("ТабличнаяЧастьДокументаMS", "СовмещенныеСтроки"));
	КонецЕсли;
	Если НастройкаБП.Свойство("НастройкаВыгрузкиТЧ", НастройкаВыгрузкиТЧ)
		И ТипЗнч(НастройкаВыгрузкиТЧ) = Тип("Массив") Тогда
		СовмещенныеСтрокиВыгрузка = ГлЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкаВыгрузкиТЧ, Новый Структура("ТабличнаяЧастьДокументаMS", "СовмещенныеСтроки"));
	КонецЕсли;
		
	Если СовмещенныеСтрокиЗагрузка = Неопределено
		И СовмещенныеСтрокиВыгрузка = Неопределено Тогда
		ЗапрашиватьCombinedItems = Ложь;				
	КонецЕсли;		
	
    Возврат ЗапрашиватьCombinedItems;
	
КонецФункции

