Функция ГлЯдро_ИзвлечьDeflateИзДвоичныхДанных(ИсходныеДвоичныеДанные, АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ИзвлечьDeflateИзДвоичныхДанных";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИсходныеДвоичныеДанные",
		ИсходныеДвоичныеДанные);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	Если ТипЗнч(ИсходныеДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Несоответствие типов (параметр номер 1)';
							|en = 'Type mismatch (parameter number 1)'; be = 'Неадпаведнасць тыпаў (параметр нумар 1)'; es = 'Discrepancia de tipo (parámetro número 1)'; ka = 'ტიპის შეუსაბამობა (პარამეტრის ნომერი 1)'; kk = 'Түрлердің сәйкес келмеуі (параметр нөмірі 1)'; ro = 'Nepotrivire de tip (parametrul numărul 1)'; tr = 'Tür uyuşmazlığı (parametre numarası 1)'; uk = 'Невідповідність типів (параметр номер 1)'; uz = 'Turlarning nomuvofiqligi(1-parametr)'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;

	Поток = ИсходныеДвоичныеДанные.ОткрытьПотокДляЧтения();
	
	Размер = Поток.Размер();
	Если Размер < 2 Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Двоичные данные: поток слишком короткий';
							|en = 'Binary data: the stream is too short'; be = 'Двайковыя дадзеныя: паток занадта кароткі'; es = 'Datos binarios: el flujo es demasiado corto'; ka = 'ორობითი მონაცემები: ნაკადი ძალიან მოკლეა'; kk = 'Екілік деректер: ағын тым қысқа'; ro = 'Date binare: fluxul este prea scurt'; tr = 'İkili veriler: Akış çok kısa'; uk = 'Двійкові дані: потік занадто короткий'; uz = 'Ikkilik ma''lumotlar: oqim juda qisqa'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;

	БуферВсего = Новый БуферДвоичныхДанных(Размер);
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Поток.Прочитать(БуферВсего, 0, Размер);
	Поток.Закрыть();

	Б0 = БуферВсего.Получить(0);
	Б1 = БуферВсего.Получить(1);

	// Вариант 1: GZIP (RFC1952)
	Если Б0 = 31 И Б1 = 139 Тогда // 0x1F, 0x8B
		Если Размер < 18 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'GZIP: поток слишком короткий';
								|en = 'GZIP: the stream is too short'; be = 'GZIP: паток занадта кароткі'; es = 'GZIP: el flujo es demasiado corto'; ka = 'GZIP: ნაკადი ძალიან მოკლეა'; kk = 'GZIP: ағын тым қысқа'; ro = 'GZIP: fluxul este prea scurt'; tr = 'GZİP: Akış çok kısa'; uk = 'GZIP: потік занадто короткий'; uz = 'GZIP: oqim juda qisqa'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		CM = БуферВсего.Получить(2);
		Если CM <> 8 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'GZIP: метод сжатия не DEFLATE';
								|en = 'GZIP: compression method does not DEFLATE'; be = 'GZIP: метад сціску ня DEFLATE'; es = 'GZIP: método de compresión no DEFLATE'; ka = 'GZIP: შეკუმშვის მეთოდი არ იშლება'; kk = 'GZIP: DEFLATE емес қысу әдісі'; ro = 'GZIP: metoda de compresie nu se dezumflă'; tr = 'GZİP: sıkıştırma yöntemi DEFLATE değil'; uk = 'Gzip: метод стиснення не DEFLATE'; uz = 'GZIP: DEFLATE bo''lmagan siqish usuli'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		FLG = БуферВсего.Получить(3);
		Позиция = 10; // базовый заголовок
		// FEXTRA (бит 2)
		Если (Цел(FLG / 4) % 2) <> 0 Тогда
			Если Позиция + 2 > Размер Тогда
				// <Лог>
				ЯзСтрока = "ru = 'GZIP: нет XLEN';
									|en = 'GZIP: no XLEN'; be = 'GZIP: няма XLEN'; es = 'GZIP: no XLEN'; ka = 'GZIP: არა XLEN'; kk = 'GZIP: XLEN жоқ'; ro = 'GZIP: fără XLEN'; tr = 'GZİP: XLEN yok'; uk = 'GZIP: немає XLEN'; uz = 'GZIP: XLEN yo''q'";
				ТекстОшибки = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
				
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
				// </Лог>
				
				Возврат Неопределено;
			КонецЕсли;
			XLEN = БуферВсего.ПрочитатьЦелое16(Позиция);
			Позиция = Позиция + 2 + XLEN;
		КонецЕсли;
		// FNAME (бит 3)
		Если (Цел(FLG / 8) % 2) <> 0 Тогда
			Пока Позиция < Размер И БуферВсего.Получить(Позиция) <> 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Позиция = Позиция + 1; // нуль-терминатор
		КонецЕсли;
		// FCOMMENT (бит 4)
		Если (Цел(FLG / 16) % 2) <> 0 Тогда
			Пока Позиция < Размер И БуферВсего.Получить(Позиция) <> 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Позиция = Позиция + 1;
		КонецЕсли;
		// FHCRC (бит 1)
		Если (Цел(FLG / 2) % 2) <> 0 Тогда
			Позиция = Позиция + 2;
		КонецЕсли;
		Если Позиция >= Размер - 8 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'GZIP: некорректные границы данных';
								|en = 'GZIP: incorrect data boundaries'; be = 'GZIP: некарэктныя межы дадзеных'; es = 'GZIP: límites de datos incorrectos'; ka = 'GZIP: მონაცემთა არასწორი საზღვრები'; kk = 'GZIP: деректердің дұрыс емес шекаралары'; ro = 'Gzip: limite incorecte ale datelor'; tr = 'GZİP: Hatalı veri sınırları'; uk = 'GZIP: неправильні межі даних'; uz = 'GZIP: noto''g''ri ma''lumotlar chegaralari'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		ДлинаDeflate = Размер - Позиция - 8; // CRC32 + ISIZE
		БуферDeflate = Новый БуферДвоичныхДанных(ДлинаDeflate);
		Для i = 0 По ДлинаDeflate - 1 Цикл
			БуферDeflate.Установить(i, БуферВсего.Получить(Позиция + i));
		КонецЦикла;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", БуферDeflate);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат БуферDeflate;
	КонецЕсли;

	// Вариант 2: ZLIB (RFC1950)
	CMF = Б0;
	FLG = Б1;
	// Проверка FCHECK и метода 8 (DEFLATE)
	Если ((CMF * 256 + FLG) % 31) = 0 И (CMF - Цел(CMF / 16) * 16) = 8 Тогда
		Смещение = 2;
		Если (Цел(FLG / 32) % 2) <> 0 Тогда // FDICT
			Смещение = 6;
		КонецЕсли;
		Если Размер < Смещение + 4 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'ZLIB: поток слишком короткий';
								|en = 'ZLIB: the stream is too short'; be = 'ZLIB: паток занадта кароткі'; es = 'ZLIB: el flujo es demasiado corto'; ka = 'ზლიბი: ნაკადი ძალიან მოკლეა'; kk = 'ZLIB: ағын тым қысқа'; ro = 'ZLIB: fluxul este prea scurt'; tr = 'ZLİB: Akış çok kısa'; uk = 'ZLIB: потік занадто короткий'; uz = 'ZLIB: oqim juda qisqa'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		ДлинаDeflate = Размер - Смещение - 4; // минус Adler-32
		Если ДлинаDeflate < 0 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'ZLIB: некорректная длина';
								|en = 'ZLIB: incorrect length'; be = 'ZLIB: некарэктная даўжыня'; es = 'ZLIB: longitud incorrecta'; ka = 'ZLIB: არასწორი სიგრძე'; kk = 'ZLIB: дұрыс емес ұзындық'; ro = 'ZLIB: lungime incorectă'; tr = 'ZLİB: Yanlış uzunluk'; uk = 'ZLIB: неправильна довжина'; uz = 'ZLIB: noto''g''ri uzunlik'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,,,, АдресаПеременных);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
			// </Лог>
			
			Возврат Неопределено;
		КонецЕсли;
		БуферDeflate = Новый БуферДвоичныхДанных(ДлинаDeflate);
		Для i = 0 По ДлинаDeflate - 1 Цикл
			БуферDeflate.Установить(i, БуферВсего.Получить(Смещение + i));
		КонецЦикла;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", БуферDeflate);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат БуферDeflate;
	КонецЕсли;

	// Вариант 3: считаем, что это уже сырой DEFLATE
	БуферКопия = Новый БуферДвоичныхДанных(Размер);
	Для i = 0 По Размер - 1 Цикл
		БуферКопия.Установить(i, БуферВсего.Получить(i));
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", БуферКопия);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат БуферКопия;

КонецФункции

Функция ГлЯдро_РаспаковатьDeflateИзБуфераДвоичныхДанных(Буфер) Экспорт

	Если Буфер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовок64 = "AgFTS2/0iI3BTqDV67a9oKcNAFEArv89AAAAAAAAAO+7v3siIyIsODcxMjYyMDAt
	|M2U5OC00NGUwLWI5MzEtY2NiMWQ3ZWRjNDk3LA0KezEsDQp7MH0NCn0NCn0AAAAA
	|//////////8=";
	ЗаголовокДД = Base64Значение(Заголовок64);

	Поток = Новый ПотокВПамяти();
	ЗаписьДанных = Новый ЗаписьДанных(Поток);
	ЗаписьДанных.Записать(ЗаголовокДД);
	ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(Буфер);
	Результат = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	ХранилищеРезультат = XMLЗначение(Тип("ХранилищеЗначения"), Base64Строка(Результат));
	
	Возврат ХранилищеРезультат.Получить();

КонецФункции

Процедура ГлЯдро_ПреобразоватьUni(МассивИлиСоответствие)
	// Если приходит массив, то находим в каждой структуре реквизит Uni
	Если ТипЗнч(МассивИлиСоответствие) = Тип("Массив") Тогда
		Для Каждого Структура Из МассивИлиСоответствие Цикл
			Если ТипЗнч(Структура) = Тип("Структура") 
				И Структура.Свойство("Uni") Тогда
				Структура.Uni = ГлЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(Структура.Uni);
			КонецЕсли;
		КонецЦикла;
	// Если приходит соответствие, то преобразовываем значение каждого элемента соответствия
	ИначеЕсли ТипЗнч(МассивИлиСоответствие) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из МассивИлиСоответствие Цикл
			МассивИлиСоответствие.Вставить(Элемент.Ключ, ГлЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(Элемент.Значение));
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ГлЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(Строка)
 	Возврат	НРег(Лев(Строка,1))+Сред(Строка,2,СтрДлина(Строка)-1);
КонецФункции

Функция ГлЯдро_ПроверитьПервыйСимволНаЦифру(Строка)
	Возврат ГлЯдро_СтрНайти("0123456789", Лев(Строка,1)) > 0;	
КонецФункции

// Возвращает список полей запроса по переданному типу документа 1С и тексту запроса
//
// Параметры:
//	ТипДокумента1С - Строка - тип документа 1С	
//  ТекстЗапроса - Строка - текст запроса
//
// Возвращаемое значение:
//	СписокЗначений
Функция ГлЯдро_ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапроса) Экспорт
	
	СписокПолей = Новый СписокЗначений;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документы[ТипДокумента1С].ПустаяСсылка());
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
		Для Каждого Колонка из Результат.Колонки Цикл
			СписокПолей.Добавить(Колонка.Имя, Колонка.Имя);
		КонецЦикла;
	Исключение
		Сообщение = НСтр("ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.';
							|en = 'The list of fields could not be retrieved due to a request execution error.';
							|be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; es = 'No se pudo obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სია ვერ მოიძებნა მოთხოვნის შესრულების შეცდომის გამო.'; kk = 'Сұрауды орындау қатесі себебінен өрістер тізімін алу мүмкін болмады.'; ro = 'Lista câmpurilor nu a putut fi recuperată din cauza unei erori de execuție a cererii.'; tr = 'Sorgu yürütme hatası nedeniyle alanların listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = 'So''rovni bajarish xatosi tufayli maydonlar ro''yxatini olishning iloji bo''lmadi.'");
		Сообщить(Сообщение); 
	КонецПопытки;
	
	Возврат СписокПолей;

КонецФункции

Функция ГлЯдро_ЗагрузитьИзJSON(СтрокаJSON)
	
	Если СтрокаJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON ;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("$type");
	
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина, , , "ФункцияВосстановленияЧтенияJSON", ЭтотОбъект, ,Реквизиты) ;
КонецФункции

Функция ГлЯдро_ПолучитьJSON(ОтправляемыеДанные, Тип="", ЕстьСостав=Ложь)
	
	ЗаписьJSON = Новый ЗаписьJSON; 
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто,"",Истина,,Ложь,Ложь,Ложь,Истина,Ложь);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, ОтправляемыеДанные); 
	ЗакрытыйJSON = ЗаписьJSON.Закрыть();
	
	Если ЕстьСостав Тогда
		// Передается коллекция		
		ЗакрытыйJSON = "{
			|""$type"":""" + Тип + """,
			|""$values"":" + ЗакрытыйJSON + "
			|}";	
	ИначеЕсли ЗначениеЗаполнено(Тип) ТОгда
		Инд = ГлЯдро_СтрНайти(ЗакрытыйJSON, "{");
		Если Инд > 0 Тогда
			ЗакрытыйJSON = "{
			|""$type"":""" + Тип + """," + Прав(ЗакрытыйJSON, СтрДлина(ЗакрытыйJSON)-Инд);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗакрытыйJSON;
	
КонецФункции

// Получает структуру из переданного соответствия
//
// Параметры:
//	ЗначВход - Соответствие, Массив из Соответствие - соответствие или массив соответствий, которые требуется преобразовать в структуру		
//
// Возвращаемое значение:
//	- Структура - если было передано соответствие
//	- Массив из Структура - если был передан массив соответствий
Функция ГлЯдро_ПолучитьСтруктуруИзСоответствия(ЗначВход) Экспорт
 
 СтруктураВозврат=Новый Структура;
 
 Если ТипЗнч(ЗначВход)=Тип("Соответствие") Тогда
  
  ФлагОщибка=Ложь;
  
  Для Каждого р Из ЗначВход Цикл
	Если Лев(р.Ключ, 1) = "$" Тогда		  		  
		Продолжить;
	 КонецЕсли;
	Попытка
    СтруктураВозврат.Вставить(р.Ключ,ГлЯдро_ПолучитьСтруктуруИзСоответствия(р.Значение));
   Исключение
    ФлагОщибка=Истина;
    Прервать;
   КонецПопытки;
  КонецЦикла;
  
   Если ФлагОщибка Тогда // пришел ключ который не возможно поместить в структуру
   СтруктураВозврат = Новый Массив;
   Для Каждого р Из ЗначВход Цикл
    ДопСтруктура=Новый Структура;
    ДопСтруктура.Вставить("Ключ",р.Ключ);
    ДопСтруктура.Вставить("Значение",ГлЯдро_ПолучитьСтруктуруИзСоответствия(р.Значение));
    СтруктураВозврат.Добавить(ДопСтруктура);
   КонецЦикла;
  КонецЕсли;
  
  Возврат СтруктураВозврат; 
  
 ИначеЕсли ТипЗнч(ЗначВход)=Тип("Массив") Тогда
  
  НовыйМассив=Новый Массив;
  Для Каждого ЭлМ Из ЗначВход Цикл
   НовыйМассив.Добавить(ГлЯдро_ПолучитьСтруктуруИзСоответствия(ЭлМ));
  КонецЦикла;
  Возврат НовыйМассив;
  
 КонецЕсли;
 
 Возврат ЗначВход; 
 
КонецФункции

// Вызывается при чтении свойств объекта JSON
//
// Параметры:
//	Свойство - Строка - имя свойства	
//	Значение - [Допустимый для сериализации тип] - значение свойства
//	ДополнительныеПараметры - Структура - дополнительные параметры
//
// Возвращаемое значение:
//	Строка
Функция ФункцияВосстановленияЧтенияJSON(Свойство, Значение, ДополнительныеПараметры) Экспорт
	 Возврат "";
КонецФункции	

Функция ГлЯдро_НайтиВМассивеСтруктурПоОтбору(пМассив, пОтбор, ВернутьПервоеЗначение = Ложь)
	
	Если ТипЗнч(пМассив) <> Тип("Массив") 
		ИЛИ ТипЗнч(пОтбор) <> Тип("Структура") 
		ИЛИ пМассив.Количество() = 0
		ИЛИ ТипЗнч(пМассив[0]) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	МассивРезультат = Новый Массив;	
	Для Каждого пСтруктура Из пМассив Цикл
		Если пСтруктура.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Подходит = Истина;
		Для Каждого ЭлОтбора Из пОтбор Цикл
			Значение = Неопределено;
			Если НЕ пСтруктура.Свойство(ЭлОтбора.Ключ,Значение)
				ИЛИ Значение <> ЭлОтбора.Значение Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Подходит Тогда
			Если ВернутьПервоеЗначение Тогда
				Возврат пСтруктура;
			Иначе
				МассивРезультат.Добавить(пСтруктура);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если МассивРезультат.Количество() > 0 Тогда
		Возврат МассивРезультат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

Функция ГлЯдро_ЗначениеИзСтрокиXML(Знач ЗначениеНастройки, КонвертироватьТаблицуЗначенийВМассивСтруктур = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначениеНастройки) Или ТипЗнч(ЗначениеНастройки) <> Тип("Строка") Тогда
		Возврат ЗначениеНастройки;
	КонецЕсли;
	
	ПолученноеЗначение = Неопределено;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЗначениеНастройки);
	
	ПовторитьПолучениеXML = Ложь;
	
	Попытка
		ПолученноеЗначение = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		ЭтоНастройкаXML = Найти(ЗначениеНастройки, "http://v8.1c.ru/8.1/data/core") > 0;
		Попытка
			Если НЕ ЭтоНастройкаXML Тогда
				// Это не xml, пытаемся использовать ЗначениеИзСтрокиВнутр
				ПолученноеЗначение = ЗначениеИзСтрокиВнутр(ЗначениеНастройки);
			Иначе
				ПолученноеЗначение = ГлЯдро_ПреобразованиеЗначенияXMLЧерезXSL(ЗначениеНастройки);    
			КонецЕсли;
		Исключение
			Если НЕ ЭтоНастройкаXML Тогда
				ПовторитьПолучениеXML = Истина;	
			КонецЕсли;
		КонецПопытки;
	КонецПопытки;
	
	Если ПовторитьПолучениеXML Тогда
		ПолученноеЗначение = ГлЯдро_ПреобразованиеЗначенияXMLИзBase64(ЗначениеНастройки);
	КонецЕсли;
		
	Если ТипЗнч(ПолученноеЗначение) = Тип ("ТаблицаЗначений") И КонвертироватьТаблицуЗначенийВМассивСтруктур Тогда
		ПолученноеЗначение = ГлЯдро_ТаблицуЗначенийВМассивСтруктур(ПолученноеЗначение);
	КонецЕсли; 
	
	Возврат ПолученноеЗначение;
	
КонецФункции

Функция ГлЯдро_ЗначениеВСтрокуXML(Знач ЗначениеНастройки, КонвертироватьМассивСтруктурВТаблицуЗначений = Ложь) Экспорт
	
	ВозвращаемоеЗначение = ЗначениеНастройки;
	
	Если ТипЗнч(ЗначениеНастройки) = Тип("Массив") И КонвертироватьМассивСтруктурВТаблицуЗначений Тогда
		ВозвращаемоеЗначение = ГлЯдро_МассивСтруктурВТаблицуЗначений(ЗначениеНастройки);	
	КонецЕсли;
	
	ПолученнаяСтрока = Новый ЗаписьXML;
	ПолученнаяСтрока.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ПолученнаяСтрока, ВозвращаемоеЗначение, НазначениеТипаXML.Явное);
	
	СтрокаXML = ПолученнаяСтрока.Закрыть();
	
	Возврат СтрокаXML;
	
КонецФункции

// Вызывает функцию получения строки штрихкода
//
// Параметры:
//	СтруктураЗаполненияСтрокиШК - Структура - структура, содержащие параметры заполнения строки штрихкода
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	Структура - содержит данные строки штрихкода, полученные из интеграционной обработки
//
Функция ГлЯдро_ПолучитьЗаполнитьСтрокуШК(СтруктураЗаполненияСтрокиШК, АдресаПеременных) Экспорт
	
	ИмяСобытия = "ГлЯдро_ПолучитьЗаполнитьСтрокуШК";

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураЗаполненияСтрокиШК",
		СтруктураЗаполненияСтрокиШК);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка",АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Попытка
		Результат = ИнтеграционнаяОбработка.ПолучитьЗаполнитьСтрокуШК(СтруктураЗаполненияСтрокиШК);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат Результат;
	Исключение
		пСообщение = НСтр("ru = 'Не удалось получить строку штрихкода';
							|en = 'Couldn''t get barcode string'; be = 'Не атрымалася атрымаць радок штрыхкода'; es = 'No se pudo obtener la cadena de código de barras'; ka = 'ვერ მიიღო შტრიხკოდების სტრიქონი'; kk = 'Штрих код жолын алу мүмкін болмады'; ro = 'Nu s-a putut obține șir de coduri de bare'; tr = 'Barkod dizesi alınamadı'; uk = 'Не вдалося отримати рядок штрих-коду'; uz = 'Shtrix-kod satrini olish mumkin emas'");
		ГлЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение, , АдресаПеременных);
	КонецПопытки;
	
КонецФункции

// Получает массив имен макетов из интеграционной обработки
//
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//   Массив   - массив имен макетов
//
Функция ГлЯдро_ПолучитьМассивИменМакетовИО(АдресаПеременных) Экспорт

	ИмяСобытия = "ГлЯдро_ПолучитьМассивИменМакетовИО";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтотОбъект, АдресаПеременных);
	// </Лог>
	
	МассивИменМакетов = Новый Массив;
	
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
		
	Если (СтруктураИО = Неопределено
		ИЛИ НЕ ТипЗнч(СтруктураИО) = Тип("Структура")
		ИЛИ НЕ СтруктураИО.Свойство("ИнтеграционнаяОбработка")
		ИЛИ СтруктураИО.ИнтеграционнаяОбработка = Неопределено)
		И НЕ ГлЯдро_ПересоздатьИнтеграционнуюОбработку(АдресаПеременных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивИменМакетов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
		// </Лог>
		
		Возврат МассивИменМакетов;
	КонецЕсли;
	СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка", АдресаПеременных);
	ИнтеграционнаяОбработка = СтруктураИО.ИнтеграционнаяОбработка;
	
	Если ИнтеграционнаяОбработка <> Неопределено Тогда
		МетаданныеМакетов = ИнтеграционнаяОбработка.Метаданные().Макеты;
		
		Для каждого МетаданныеМакета Из МетаданныеМакетов Цикл
		
			МассивИменМакетов.Добавить(МетаданныеМакета.Имя);
		
		КонецЦикла;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивИменМакетов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст, АдресаПеременных);
	// </Лог>
	
	Возврат МассивИменМакетов;
	
КонецФункции

