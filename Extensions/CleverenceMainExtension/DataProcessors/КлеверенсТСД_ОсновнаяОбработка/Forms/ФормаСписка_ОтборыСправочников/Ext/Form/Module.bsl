/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
	#Иначе
		РежимОбменаПредставление = "";
		Если РежимОбмена = "Онлайн" Тогда
			Элементы.РежимОбмена.ЦветТекста = WebЦвета.Зеленый;
			РежимОбменаПредставление = НСтр("ru = 'Онлайн';
												|en = 'Online'; be = 'Анлайн'; es = 'En línea'; ka = 'ონლაინ'; kk = 'Онлайн'; ro = 'Online'; tr = 'Çevrimiçi'; uk = 'Онлайн'; uz = 'Onlayn'");
		ИначеЕсли РежимОбмена = "Автообмен" Тогда
			Элементы.РежимОбмена.ЦветТекста = WebЦвета.Красный;
			РежимОбменаПредставление = НСтр("ru = 'Автообмен';
												|en = 'Auto-exchange'; be = 'Аўтаабмен'; es = 'Intercambio automático'; ka = 'ავტომატური გაცვლა'; kk = 'АВТО алмасу'; ro = 'Schimb automat'; tr = 'Otomatik Değişim'; uk = 'Автообмін'; uz = 'Avtomatik almashtirish'");
		ИначеЕсли РежимОбмена = "Интерактивный" Тогда
			Элементы.РежимОбмена.ЦветТекста = WebЦвета.Синий;
			РежимОбменаПредставление = НСтр("ru = 'Интерактивный';
												|en = 'Interactive'; be = 'Інтэрактыўны'; es = 'Interactivo'; ka = 'ინტერაქტიული'; kk = 'Интерактивті'; ro = 'Interactiv'; tr = 'İnteraktif'; uk = 'Інтерактивний'; uz = 'Interaktiv'");
		КонецЕсли;
		Элементы.РежимОбмена.Заголовок = РежимОбменаПредставление;
	#КонецЕсли
	
	// Настройки шапки
	ПереписыватьНоменклатуруПриВыгрузке = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке");
	ИспользоватьШаблоныВесовогоТовара 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИспользоватьШаблоныВесовогоТовара");
	ПрефиксКодаВесовогоТовара 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксКодаВесовогоТовара");
	ЧислоЗнаковПослеЗапятойВесТовара 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ЧислоЗнаковПослеЗапятойВесТовара");
	ДлинаКодаВесовогоТовара 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ДлинаКодаВесовогоТовара");
	ПрефиксВключенВКодВесовогоТовара	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксВключенВКодВесовогоТовара");
	РазмерПорцииНоменклатуры			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РазмерПорцииНоменклатуры");
	ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента");
	УстановитьПоискПоНаименованиюИАртикулу	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("УстановитьПоискПоНаименованиюИАртикулу");
	
	КоэффициентПревышенияВеса = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("КоэффициентПревышенияМеры");
	Если НЕ ТипЗнч(КоэффициентПревышенияВеса) = Тип("Число") Тогда
		КоэффициентПревышенияВеса = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("КоэффициентПревышенияВеса");
	КонецЕсли;
	
	Если НЕ ТипЗнч(КоэффициентПревышенияВеса) = Тип("Число") Тогда
		// Сохраняем значение по умолчанию
		КоэффициентПревышенияВеса = 0.05;
		СтруктураОбщихНастроек = Новый Структура;
		СтруктураОбщихНастроек.Вставить("КоэффициентПревышенияМеры", КоэффициентПревышенияВеса);
		СтруктураОбщихНастроек.Вставить("КоэффициентПревышенияВеса", КоэффициентПревышенияВеса);
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураОбщихНастроек);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураОбщихНастроек);
	КонецЕсли;
	
	ПроцентПревышенияВеса = КоэффициентПревышенияВеса * 100;
	
	пНастройкиОбменаСправочников = _ЛокКонтекст.ЛокЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима(РежимОбмена, ID_Узла);
	Для каждого СтрокаНастройки Из пНастройкиОбменаСправочников Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НастройкиОбменаСправочников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
		
		Если СтрокаНастройки.Свойство("ТаблицаСопоставленияПолей")
			И ТипЗнч(СтрокаНастройки.ТаблицаСопоставленияПолей) = Тип("Массив") Тогда
			НоваяСтрока.СписокСопоставленияПолей.ЗагрузитьЗначения(СтрокаНастройки.ТаблицаСопоставленияПолей);
		КонецЕсли;
		НоваяСтрока.Картинка = ?(НоваяСтрока.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
	КонецЦикла;
		                                              
	ЗаполнитьКолонкиФиктивнымиНадписями();
	
	ЗаполнитьСписокВыбораСпособовВыгрузки();
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДобавитьУсловноеОформлениеТекстаДляСпискаВыбораСпособаВыгрузки();
	#КонецЕсли

	ЗаполнитьСписокВыбораПроизвольныхСКД();
	
	ЗаполнитьТаблицуИменМакетовИОПоУмолчанию();
	
	ЗаполнитьИменаМакетовИОПоУмолчаниюВТаблицеНастроек();
	
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ЭтаФорма.НаименованиеУзла;	
	//Элементы.НастройкиОбменаСправочниковИмяТаблицы.Видимость = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
		Элементы.НаименованиеУзла.Видимость = Ложь;		
	КонецЕсли;
	
	ОбновитьДоступностьЭлементов();

	Если ВыгрузитьСправочникиПриОткрытии = Истина Тогда
		
		//даем отрисоваться окну
		ПодключитьОбработчикОжидания("ВыгрузитьОтмеченныеСправочники", 0.3, Истина);
				
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементыФормы.НастройкиОбменаСправочников.Колонки.РазмерПорции.ПодсказкаВШапке = НСтр("ru = 'Разбивать справочник для выгрузки на порции (0 - не разбивать). Данную опцию рекомендуется использовать при наличии большого справочника и возникновении ошибок при выгрузке справочника стандартной выгрузкой.';
																								|en = 'Split the reference book for uploading into portions (0 - do not split). It is recommended to use this option if there is a large reference book and errors occur when uploading the reference book using standard upload.';
																								|be = 'Разбіваць даведнік для выгрузкі на порцыі (0 - не разбіваць). Дадзеную опцыю рэкамендуецца выкарыстоўваць пры наяўнасці вялікага даведніка і ўзнікненні памылак пры выгрузцы даведніка стандартнай выгрузкай.'; es = 'Dividir la guía de descarga en porciones (0 - no dividir). Se recomienda utilizar esta opción si hay un directorio grande y si se producen errores al descargar el directorio con una descarga estándar.'; ka = 'გაყავით საცნობარო წიგნი ნაწილებად ატვირთვისთვის (0 - არ გაყოთ). რეკომენდებულია ამ ვარიანტის გამოყენება, თუ არსებობს დიდი საცნობარო წიგნი და შეცდომები ხდება საცნობარო წიგნის ატვირთვისას სტანდარტული ატვირთვის გამოყენებით.'; kk = 'Түсіру анықтамалығын бөліктерге бөліңіз (0-бұзбаңыз). Бұл опцияны үлкен каталог болған кезде және стандартты жүктеу кезінде каталогты жүктеу кезінде қателер туындаған кезде пайдалану ұсынылады.'; ro = 'Împărțiți cartea de referință pentru încărcare în porțiuni (0 - nu împărțiți). Se recomandă utilizarea acestei opțiuni dacă există o carte de referință mare și apar erori la descărcarea cărții de referință utilizând descărcarea standard.'; tr = 'Boşaltma dizinini bölümlere ayırın (0 - kırmayın). Bu seçeneğin, büyük bir dizin varsa ve dizini standart boşaltma ile boşaltırken hatalar oluşursa kullanılması önerilir.'; uk = 'Розбивати довідник для вивантаження на порції (0-не розбивати). Дану опцію рекомендується використовувати при наявності великого довідника і виникненні помилок при вивантаженні довідника стандартної вивантаженням.'; uz = 'Yuklash uchun qo''llanmani qismlarga bo''ling (0-ajratmang). Ushbu parametr katta katalog mavjud bo''lganda va standart yuklash bilan katalogni yuklashda xatolar yuzaga kelganda foydalanish tavsiya etiladi.'");
	#Иначе
		Элементы.НастройкиОбменаСправочниковРазмерПорции.Подсказка = НСтр("ru = 'Разбивать справочник для выгрузки на порции (0 - не разбивать). Данную опцию рекомендуется использовать при наличии большого справочника и возникновении ошибок при выгрузке справочника стандартной выгрузкой.';
																			|en = 'Split the reference book for uploading into portions (0 - do not split). It is recommended to use this option if there is a large reference book and errors occur when uploading the reference book using standard upload.';
																			|be = 'Разбіваць даведнік для выгрузкі на порцыі (0 - не разбіваць). Дадзеную опцыю рэкамендуецца выкарыстоўваць пры наяўнасці вялікага даведніка і ўзнікненні памылак пры выгрузцы даведніка стандартнай выгрузкай.'; es = 'Dividir la guía de descarga en porciones (0 - no dividir). Se recomienda utilizar esta opción si hay un directorio grande y si se producen errores al descargar el directorio con una descarga estándar.'; ka = 'გაყავით საცნობარო წიგნი ნაწილებად ატვირთვისთვის (0 - არ გაყოთ). რეკომენდებულია ამ ვარიანტის გამოყენება, თუ არსებობს დიდი საცნობარო წიგნი და შეცდომები ხდება საცნობარო წიგნის ატვირთვისას სტანდარტული ატვირთვის გამოყენებით.'; kk = 'Түсіру анықтамалығын бөліктерге бөліңіз (0-бұзбаңыз). Бұл опцияны үлкен каталог болған кезде және стандартты жүктеу кезінде каталогты жүктеу кезінде қателер туындаған кезде пайдалану ұсынылады.'; ro = 'Împărțiți cartea de referință pentru încărcare în porțiuni (0 - nu împărțiți). Se recomandă utilizarea acestei opțiuni dacă există o carte de referință mare și apar erori la descărcarea cărții de referință utilizând descărcarea standard.'; tr = 'Boşaltma dizinini bölümlere ayırın (0 - kırmayın). Bu seçeneğin, büyük bir dizin varsa ve dizini standart boşaltma ile boşaltırken hatalar oluşursa kullanılması önerilir.'; uk = 'Розбивати довідник для вивантаження на порції (0-не розбивати). Дану опцію рекомендується використовувати при наявності великого довідника і виникненні помилок при вивантаженні довідника стандартної вивантаженням.'; uz = 'Yuklash uchun qo''llanmani qismlarga bo''ling (0-ajratmang). Ushbu parametr katta katalog mavjud bo''lganda va standart yuklash bilan katalogni yuklashda xatolar yuzaga kelganda foydalanish tavsiya etiladi.'");
	#КонецЕсли
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьИЗакрытьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого СтрокаТЧ Из НастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгружать = Истина;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого СтрокаТЧ Из НастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгружать = Ложь;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВыбранные(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ВопросВыгрузитьОтмеченныеСправочникиЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Выгрузить отмеченные справочники?';
							|en = 'Upload the marked directories?'; be = 'Выгрузіць адзначаныя даведнікі?'; es = 'Descargar directorios marcados?'; ka = 'ატვირთეთ მონიშნული დირექტორიები?'; kk = 'Белгіленген анықтамалықтарды жүктеу керек пе?'; ro = 'Încărcați directoarele marcate?'; tr = 'İşaretli dizinleri boşaltmak mı?'; uk = 'Вивантажити зазначені довідники?'; uz = 'Belgilangan kataloglarni tushirasizmi?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВыбранные(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ВопросОчиститьОтмеченныеСправочникиЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Очистить отмеченные справочники?';
							|en = 'Clear the marked directories?'; be = 'Ачысціць адзначаныя даведнікі?'; es = '¿Borrar directorios marcados?'; ka = 'გაასუფთავეთ მონიშნული დირექტორიები?'; kk = 'Белгіленген анықтамалықтарды өшіру керек пе?'; ro = 'Ștergeți directoarele marcate?'; tr = 'İşaretli dizinleri temizle mi?'; uk = 'Очистити відмічені довідники?'; uz = 'Belgilangan kataloglarni tozalaysizmi?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	КолонкаИмя = Поле.Имя;
	ТекущаяСтрокаНастройки = Элемент.ТекущиеДанные;
	ИмяТаблицы 						= ТекущаяСтрокаНастройки.ИмяТаблицы;
	СпособВыгрузки 					= ТекущаяСтрокаНастройки.СпособВыгрузки;
	ИмяМакетаИО 					= ТекущаяСтрокаНастройки.ИмяМакетаИО;
	ТекстЗапросаВыгрузкиНаТСД 		= ТекущаяСтрокаНастройки.ТекстЗапросаВыгрузкиНаТСД;
	ТекстКодаПолучениеПараметров 	= ТекущаяСтрокаНастройки.ТекстКодаПолучениеПараметров;
	СписокСопоставленияПолей 		= ТекущаяСтрокаНастройки.СписокСопоставленияПолей;
	ИмяТаблицыПредставление 		= ТекущаяСтрокаНастройки.ИмяТаблицыПредставление;
	
	Если КолонкаИмя = "НастройкиОбменаСправочниковНастройка" ИЛИ КолонкаИмя = "НастройкиОбменаСправочниковПредпросмотр"  Тогда 
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборСправочников = ПолучитьФорму("ОФ_ФормаНастройки_ОтборСправочников",  ЭтаФорма);
		#Иначе
			ФормаНастройки_ОтборСправочников = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборСправочников", , ЭтаФорма, "ФормаНастройки_ОтборСправочников_"+ИмяТаблицы);
			//ФормаСписка_ОтборыСправочников.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		ФормаНастройки_ОтборСправочников.ЗакрыватьПриЗакрытииВладельца = Истина;
		ФормаНастройки_ОтборСправочников._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_ОтборСправочников.ТипБазы = ТипБазы;
		ФормаНастройки_ОтборСправочников.ID_Узла = ID_Узла;
		ФормаНастройки_ОтборСправочников.ИмяТаблицы = ИмяТаблицы;
		ФормаНастройки_ОтборСправочников.НастройкаКомпоновщикаСтрокой = ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой;
		ФормаНастройки_ОтборСправочников.НаименованиеУзла = _ЛокКонтекст.ДанныеТекущегоУзла.Наименование;
		ФормаНастройки_ОтборСправочников.СпособВыгрузки = СпособВыгрузки;
		ФормаНастройки_ОтборСправочников.ИмяМакетаИО = ИмяМакетаИО;
		ФормаНастройки_ОтборСправочников.ТекстЗапросаВыгрузкиНаТСД = ТекстЗапросаВыгрузкиНаТСД;
		ФормаНастройки_ОтборСправочников.ТекстКодаПолучениеПараметров = ТекстКодаПолучениеПараметров;
		ФормаНастройки_ОтборСправочников.СписокСопоставленияПолей = СписокСопоставленияПолей;
		ФормаНастройки_ОтборСправочников.Предпросмотр = КолонкаИмя = "НастройкиОбменаСправочниковПредпросмотр";
		ОП = Новый ОписаниеОповещения("НастройкиОтборСправочниковЗакрытие",ЭтаФорма,ТекущаяСтрокаНастройки);
		ФормаНастройки_ОтборСправочников.ОписаниеОповещенияОЗакрытии = ОП;
		ФормаНастройки_ОтборСправочников.Открыть();
			
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковВыгрузка" Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ВопросВыгрузитьСправочникЗавершение", ЭтаФорма, ТекущаяСтрокаНастройки);
		ТекстВопроса = НСтр("ru = 'Выгрузить справочник %1?';
								|en = 'Upload the %1 directory?'; be = 'Выгрузіць даведнік %1?'; es = '¿Descargar el directorio %1?'; ka = 'ატვირთეთ % 1 დირექტორია?'; kk = '%1 анықтамалығын жүктеңіз?'; ro = 'Încărcați directorul %1?'; tr = '%1 dizinini boşaltın mı?'; uk = 'Вивантажити довідник %1?'; uz = '% 1 katalogini tushirasizmi?'");
		ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ИмяТаблицыПредставление);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 
		
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковОчисткаСправочника" Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ВопросОчиститьСправочникЗавершение", ЭтаФорма,ИмяТаблицы);
		ТекстВопроса = НСтр("ru = 'Очистить справочник %1?';
								|en = 'Clear the %1 directory?'; be = 'Ачысціць даведнік %1?'; es = '¿Borrar el directorio %1?'; ka = 'გაასუფთავეთ %1 დირექტორია?'; kk = '% 1 анықтамалығын тазалаңыз?'; ro = 'Ștergeți directorul %1?'; tr = 'Dizini temizle %1?'; uk = 'Очистити довідник %1?'; uz = 'Katalogni tozalash %1?'");
		ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ИмяТаблицыПредставление);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0); 	
		
	ИначеЕсли КолонкаИмя = "НастройкиОбменаСправочниковПроизвольныйЗапрос" Тогда
		
		Если СпособВыгрузки <> "ПроизвольныйЗапрос" Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Сообщение = НСтр("ru = 'Не заполнена таблица для выгрузки!';
								|en = 'The upload table is not filled in!'; be = 'Не запоўненая табліца для выгрузкі!'; es = '¡La tabla de descarga no está llena!'; ka = 'ატვირთვის ცხრილი არ არის შევსებული!'; kk = 'Жүктеу кестесі толтырылмаған!'; ro = 'Tabelul de încărcare nu este completat!'; tr = 'Boşaltma için tablo dolu değil!'; uk = 'Не заповнена таблиця для вивантаження!'; uz = 'Yuklash jadvali to''ldirilmagan!'");
			Сообщить(Сообщение); 
			Возврат;			
		КонецЕсли;
		
		ФормаНастройки_ПравилаВыгрузкиПолей = _ЛокКонтекст.ЛокЯдро_ПолучитьФорму("ФормаНастройки_ПравилаВыгрузкиПолей", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ФормаНастройки_ПравилаВыгрузкиПолей._ЛокКонтекст 		= _ЛокКонтекст;
		ФормаНастройки_ПравилаВыгрузкиПолей.КлючНастройки 		= "Выгрузка_Справочник";
		ФормаНастройки_ПравилаВыгрузкиПолей.ТипДокумента1С 		= "Запрос";
		ФормаНастройки_ПравилаВыгрузкиПолей.ТипДокументаMS 		= ИмяТаблицы;
		ФормаНастройки_ПравилаВыгрузкиПолей.ИмяТабличнойЧасти1С = "(Запрос)";
		
		ФормаНастройки_ПравилаВыгрузкиПолей.ТекстЗапросаВыгрузкиНаТСД 		= ТекущаяСтрокаНастройки.ТекстЗапросаВыгрузкиНаТСД;
		ФормаНастройки_ПравилаВыгрузкиПолей.ТекстКодаПолучениеПараметров 	= ТекущаяСтрокаНастройки.ТекстКодаПолучениеПараметров;
		ФормаНастройки_ПравилаВыгрузкиПолей.ТаблицаРеквизитовИсходная 		= ТекущаяСтрокаНастройки.СписокСопоставленияПолей.ВыгрузитьЗначения();
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие",ЭтаФорма,Новый Структура("ТекущаяСтрокаНастройки",ТекущаяСтрокаНастройки));
		ФормаНастройки_ПравилаВыгрузкиПолей.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ПравилаВыгрузкиПолей.ОткрытьМодально();
		#Иначе
			ФормаНастройки_ПравилаВыгрузкиПолей.Открыть();
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

