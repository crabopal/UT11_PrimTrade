// Собирает структуры настроек выгрузки справочников, сохраняет в базу SMARTS и обновляет кэш
// 
// Параметры:
&НаКлиенте
Процедура СохранитьНастройки()
	
	СохранитьТабличныеНастройки();
	
	СтруктураОбщихНастроек = Новый Структура;
	СтруктураОбщихНастроек.Вставить("ИспользоватьШаблоныВесовогоТовара",   ИспользоватьШаблоныВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ПрефиксКодаВесовогоТовара",           ПрефиксКодаВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ЧислоЗнаковПослеЗапятойВесТовара",    ЧислоЗнаковПослеЗапятойВесТовара);
	СтруктураОбщихНастроек.Вставить("ДлинаКодаВесовогоТовара",             ДлинаКодаВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("ПрефиксВключенВКодВесовогоТовара",    ПрефиксВключенВКодВесовогоТовара);
	СтруктураОбщихНастроек.Вставить("РазмерПорцииНоменклатуры",    		   РазмерПорцииНоменклатуры);
	СтруктураОбщихНастроек.Вставить("ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента",    ВыгружатьНоменклатуруДокументаПередВыгрузкойДокумента);
	СтруктураОбщихНастроек.Вставить("УстановитьПоискПоНаименованиюИАртикулу",    УстановитьПоискПоНаименованиюИАртикулу);
	
	СтруктураОбщихНастроек.Вставить("ПереписыватьНоменклатуруПриВыгрузке", ПереписыватьНоменклатуруПриВыгрузке);
	СтруктураОбщихНастроек.Вставить("ID_ТекущегоУзла", 					   ID_Узла);
	
	СтруктураОбщихНастроек.Вставить("КоэффициентПревышенияМеры", ПроцентПревышенияВеса / 100);
	СтруктураОбщихНастроек.Вставить("КоэффициентПревышенияВеса", ПроцентПревышенияВеса / 100);
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураОбщихНастроек);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураОбщихНастроек);
	_ЛокКонтекст.ЛокЯдро_СохранитьШаблоныВесовогоТовараВБазеSMARTS();
	_ЛокКонтекст.ЛокЯдро_УстановитьПоискПоНаименованиюИАртикулу();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьТабличныеНастройки()
	
	СобранныеНастройкиОбменаСправочников = ПолучитьМассивСтруктурНастроекКлиент();
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	// Для совместимости с ОО 1.6.3
	// В НастройкиОбменаСправочников всегда храним настройки отборов Онлайн для главного узла
	Если РежимОбмена <> "Онлайн" Тогда
		Если ЭтоТекущийУзел И ПустаяСтрока(ID_Узла) Тогда
			НастройкиОтборовСправочников_Онлайн = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовСправочников_Онлайн");				
		Иначе
			НастройкиОтборовСправочников_Онлайн = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовСправочников_Онлайн", "");
		КонецЕсли;
	Иначе
		Если ЭтоТекущийУзел И ПустаяСтрока(ID_Узла) Тогда
			// Отборы уже заполнены для Онлайн главного узла
			НастройкиОтборовСправочников_Онлайн = Неопределено;				
		Иначе
			НастройкиОтборовСправочников_Онлайн = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовСправочников_Онлайн", "");
		КонецЕсли;
	КонецЕсли;
	
	НастройкиОтборовСправочников_Онлайн = ?(ТипЗнч(НастройкиОтборовСправочников_Онлайн) = Тип("Массив"), НастройкиОтборовСправочников_Онлайн, Неопределено);
	
	// Разбираем настройки обмена, т.к настройки отборов хранятся в других ключах в разрезе режимов обмена
	НастройкиОтборовСправочников = Новый Массив;
	КолонкиТаблицы = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
	НастройкиОтборовСправочников.Добавить(_ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	
	Для каждого СтрокаНастройки Из СобранныеНастройкиОбменаСправочников Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
		НастройкиОтборовСправочников.Добавить(НоваяСтрока);
		
		Если НастройкиОтборовСправочников_Онлайн <> Неопределено Тогда
			
			// Восстанавливаем настройки отборов из Онлайн
			Отбор = Новый Структура("ИмяТаблицы");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаНастройки);
			СтрокаНастройкиОтборов = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборовСправочников_Онлайн, Отбор, Истина);
			Если СтрокаНастройкиОтборов <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаНастройки, СтрокаНастройкиОтборов);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОбменаСправочников", СобранныеНастройкиОбменаСправочников);
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиОтборовСправочников(РежимОбмена, НастройкиОтборовСправочников, ID_Узла);
	
	Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОбменаСправочников", СобранныеНастройкиОбменаСправочников);	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, НастройкиОтборовСправочников);	
	КонецЕсли;
	
	// Совместимость с ОО 1.6.3
	Если РежимОбмена = "Онлайн" Тогда
		
		// Для совместимости с ОО 1.6.3:
		// Считаем, что в старых ОО работа идет с онлайн режимом, поэтому в других режимах сюда не заходим.
		//	1) Отборы НастройкиОбменаСправочников нужно восстановить из Онлайн главного узла (сделано выше).
		//	2) Нужно сохранить используемые справочники в устаревшие ключи Выгружать<ИмяТаблицы>Сразу.
		//	3) Если ID_Узла заполнен, то восстановить узловые отборы НастройкиОбменаСправочников из Онлайн значения узла.
		//		Сохранить узловое значение НастройкиОбменаСправочников.
		//
		// Подробнее: ГлЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5
		
		// ВерсияНастройкиОбменаСправочников 1_3_25_2 - поддерживаем совместимость НастройкиОбменаСправочников с ОО 1.6.3
		// ВерсияНастройкиОбменаСправочников 2_1_0_5 - поддержка прекращена, считаем, что мы полностью перешли на ОО 2.0
		ВерсияНастройкиОбменаСправочников = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияНастройкиОбменаСправочников");
		Если ВерсияНастройкиОбменаСправочников = 1003025002 Тогда
			
			СоответствиеКлючейВыгружатьСразу = _ЛокКонтекст.ЛокЯдро_СоответствиеСправочниковКлючамВыгружатьСразу();
			
			НастройкиКСохранению = Новый Структура;
			
			// Повторно получаем таблицу, т.к. ранее настройки отборов могли быть перезаписаны из главного узла
			СобранныеНастройкиОбменаСправочников = ПолучитьМассивСтруктурНастроекКлиент();
			
			Для каждого СтрокаНастройки Из СобранныеНастройкиОбменаСправочников Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
					Продолжить;
				КонецЕсли;
				
				КлючТаблицы = СоответствиеКлючейВыгружатьСразу.Получить(СтрокаНастройки.ИмяТаблицы);
				
				Если КлючТаблицы <> Неопределено Тогда
					НастройкиКСохранению.Вставить(КлючТаблицы, СтрокаНастройки.Выгружать);
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ПустаяСтрока(ID_Узла) Тогда
				// Сохраняем только узловое значение, значение главного узла было сохранено ранее
				НастройкиКСохранению.Вставить("НастройкиОбменаСправочников", СобранныеНастройкиОбменаСправочников);
			КонецЕсли;
			
			Если НастройкиКСохранению.Количество() Тогда
				
				// НастройкиОбменаСправочников больше не является узловой настройкой, поэтому временно добавим его в узловые
				КатегорииНастроекMS = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(_ЛокКонтекст.КатегорииНастроекMS);
				КатегорииНастроекMS.УзловыеНастройки.Добавить("НастройкиОбменаСправочников");
				
				ДополнительныеПараметры = Новый Структура("КатегорииНастроекMS", КатегорииНастроекMS);
				_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению, ID_Узла, ДополнительныеПараметры);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

// Устанавливает видимость настройки для весового товара
// 
// Параметры:
&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	
	Элементы.ПрефиксКодаВесовогоТовара.Видимость 				= ИспользоватьШаблоныВесовогоТовара;
	Элементы.ПрефиксВключенВКодВесовогоТовара.Видимость 		= ИспользоватьШаблоныВесовогоТовара;
	Элементы.ЧислоЗнаковПослеЗапятойВесТовара.Видимость 		= ИспользоватьШаблоныВесовогоТовара;
	Элементы.ДлинаКодаВесовогоТовара.Видимость 					= ИспользоватьШаблоныВесовогоТовара;
		
КонецПроцедуры

// Собирает структуру настроек выгрузки справочников
// 
// Параметры:
// Возвращаемое значение:
// 	Массив - Структура настроек
&НаКлиенте
Функция ПолучитьМассивСтруктурНастроекКлиент()
	
	МассивНастроек = Новый Массив;
	КолонкиТаблицы = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
	МассивНастроек.Добавить(_ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	
	Для Каждого СтрокаТЧ ИЗ НастройкиОбменаСправочников Цикл
		
		НоваяСтрока = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.ТаблицаСопоставленияПолей = СтрокаТЧ.СписокСопоставленияПолей.ВыгрузитьЗначения();
		МассивНастроек.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат МассивНастроек;
	
КонецФункции

// Заполняет табличную часть декоративными значениями 
// 
// Параметры:
//&НаСервере
Процедура ЗаполнитьКолонкиФиктивнымиНадписями()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		рНастройкиОбменаСправочников = НастройкиОбменаСправочников;
	#Иначе
		рНастройкиОбменаСправочников = РеквизитФормыВЗначение("НастройкиОбменаСправочников");
	#КонецЕсли
	
	Для каждого СтрокаТЧ ИЗ рНастройкиОбменаСправочников Цикл
		СтрокаТЧ.Выгрузка = НСтр("ru = 'Выгрузка...';
									|en = 'Discharge...'; be = 'Выгрузка...'; es = 'Descargo...'; ka = 'გამონადენი...'; kk = 'Түсіру...'; ro = 'Descărcarea de gestiune...'; tr = 'Boşaltma...'; uk = 'Вивантаження...'; uz = 'Tushirish...'");
		СтрокаТЧ.Предпросмотр = НСтр("ru = 'Предпросмотр и печать...';
										|en = 'Preview and print...'; be = 'Прадпрагляд і друк...'; es = 'Previsualización e impresión...'; ka = 'გადახედვა და ბეჭდვა...'; kk = 'Алдын ала қарау және басып шығару...'; ro = 'Previzualizare și imprimare...'; tr = 'Önizleyin ve yazdırın...'; uk = 'Попередній і печатка...'; uz = 'Ko''rib chiqish va chop etish...'");
		СтрокаТЧ.ОчисткаСправочника = НСтр("ru = 'Очистка справочника...';
											|en = 'Clearing the directory...'; be = 'Ачыстка даведніка...'; es = 'Limpieza del directorio...'; ka = 'დირექტორიის გასუფთავება...'; kk = 'Анықтамалықты тазалау...'; ro = 'Ștergerea directorului...'; tr = 'El kitabının temizlenmesi...'; uk = 'Очищення довідника...'; uz = 'Katalogni tozalash...'");
		Если СтрокаТЧ.НастройкаКомпоновщикаСтрокой = "" Тогда
			СтрокаТЧ.Настройка = НСтр("ru = 'Настроить';
										|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
		Иначе
			СтрокаТЧ.Настройка = НСтр("ru = 'Настроено';
										|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
		КонецЕсли;
		Если СтрокаТЧ.СпособВыгрузки = "" Тогда
			СтрокаТЧ.СпособВыгрузки = "ПоУмолчанию";
		КонецЕсли;
		Если СтрокаТЧ.СпособВыгрузки = "ПроизвольныйЗапрос" Тогда
			СтрокаТЧ.ПроизвольныйЗапрос = НСтр("ru = 'Запрос';
												|en = 'Request'; be = 'Запыт'; es = 'Petición'; ka = 'მოთხოვნა'; kk = 'Сұрау'; ro = 'Cerere'; tr = 'Talep'; uk = 'Запит'; uz = 'So''rov'");
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		НастройкиОбменаСправочников = рНастройкиОбменаСправочников;
	#Иначе
		ЗначениеВРеквизитФормы(рНастройкиОбменаСправочников,"НастройкиОбменаСправочников");
	#КонецЕсли
	
КонецПроцедуры

// Заполняет список выбора элемента "СпособВыгрузки"
//
&НаКлиенте
Процедура ЗаполнитьСписокВыбораСпособовВыгрузки(Типовой = Истина)
		
	СписокВыбора = ЭтаФорма.Элементы.НастройкиОбменаСправочниковСпособВыгрузки.СписокВыбора;
	СписокВыбора.Очистить();
	
	Если Типовой Тогда
		СписокВыбора.Добавить("ПоУмолчанию", 		
			НСтр("ru = 'По умолчанию';
					|en = 'By default'; be = 'Безумоўна'; es = 'Por defecto'; ka = 'სტანდარტულად'; kk = 'Әдепкі бойынша'; ro = 'În mod implicit'; tr = 'Varsayılan olarak'; uk = 'За замовчуванням'; uz = 'Odatiy'")
		);	
	КонецЕсли;
	СписокВыбора.Добавить("СвойМакетСКД", 			
			НСтр("ru = 'Свой макет СКД из ИО';
					|en = 'Your own SKD layout from Integration Processing'; be = 'Свой макет СКД з інтэграцыйная апрацоўка'; es = 'Su diseño SKD de proceso de Integración'; ka = 'თქვენი საკუთარი SKD განლაგება ინტეგრაციის დამუშავებისგან'; kk = 'Оның макеті СКД бастап интеграциялық өңдеу'; ro = 'Propriul aspect SKD din procesarea Integrării'; tr = 'SKD düzenimi Entegrasyon işlemesinden'; uk = 'Свій макет СКД з інтеграційна обробка'; uz = 'Uning SKD tartibi ning integratsiyani qayta ishlash'")
	);
	СписокВыбора.Добавить("ПроизвольныйЗапрос", 	
			НСтр("ru = 'Произвольный запрос';
					|en = 'Custom request'; be = 'Адвольны запыт'; es = 'Consulta arbitraria'; ka = 'საბაჟო მოთხოვნა'; kk = 'Ерікті сұрау'; ro = 'Cerere personalizată'; tr = 'Keyfi sorgu'; uk = 'Довільний запит'; uz = 'Maxsus so''rov'")
	);

КонецПроцедуры

// Заполняет список выбора элемента "ИмяМакетаИО" именами макетов, полученных из ИО
//
&НаКлиенте
Процедура ЗаполнитьСписокВыбораПроизвольныхСКД()

	МассивИменМакетов = ПолучитьМассивИменМакетовИО();
	
	ЭтаФорма.Элементы.НастройкиОбменаСправочниковИмяМакетаИО.СписокВыбора.ЗагрузитьЗначения(МассивИменМакетов);

КонецПроцедуры

// Получает массив имен макетов из интеграционной обработки
//
// Возвращаемое значение:
//   Массив   - массив имен макетов
//
&НаКлиенте
Функция ПолучитьМассивИменМакетовИО()

	МассивИменМакетов = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивИменМакетовИО();

	Возврат МассивИменМакетов;
	
КонецФункции

// Заполняет таблицу макетов ИО по умолчанию для каждого имени справочника
//
&НаКлиенте
Процедура ЗаполнитьТаблицуИменМакетовИОПоУмолчанию()

	МассивСтруктурИменСправочников = Новый Массив;
	Для Каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл
		МассивСтруктурИменСправочников.Добавить(Новый Структура("ИмяСправочника, ИмяМакета", СтрокаНастройки.ИмяТаблицы, ""));
	КонецЦикла;
	
	МассивСтруктурИменМакетовИОПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивСтруктурМакетовИОПоУмолчанию(МассивСтруктурИменСправочников);
	
	ТаблицаИменМакетовИОПоУмолчанию.Очистить();
	
	Для Каждого СтруктураИменМакетовИОПоУмолчанию Из МассивСтруктурИменМакетовИОПоУмолчанию Цикл
		НоваяСтрока = ТаблицаИменМакетовИОПоУмолчанию.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураИменМакетовИОПоУмолчанию);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет имена макетов ИО по умолчанию в таблице настроек
//
&НаКлиенте
Процедура ЗаполнитьИменаМакетовИОПоУмолчаниюВТаблицеНастроек()

	НайденныеСтроки = НастройкиОбменаСправочников.НайтиСтроки(Новый Структура("СпособВыгрузки", "ПоУмолчанию"));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ИмяМакетаИО = ПолучитьИмяМакетаИОПоУмолчанию(НайденнаяСтрока.ИмяТаблицы);
        НайденнаяСтрока.ИмяМакетаИО = ИмяМакетаИО;
	КонецЦикла;
	
КонецПроцедуры

// Получает имя макета ИО по умолчанию
//
// Параметры:
//  ИмяТаблицы  - Строка - имя таблицы, для которой необходимо получить имя макета ИО по умолчанию
//
// Возвращаемое значение:
//   Строка   - имя макета ИО по умолчанию
//
&НаКлиенте
Функция ПолучитьИмяМакетаИОПоУмолчанию(ИмяТаблицы)

	ИмяМакетаИО = "";
	
	НайденныеСтроки = ТаблицаИменМакетовИОПоУмолчанию.НайтиСтроки(Новый Структура("ИмяСправочника", ИмяТаблицы));
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		ИмяМакетаИО = НайденныеСтроки[0].ИмяМакета;
	КонецЕсли;

	Возврат ИмяМакетаИО;
	
КонецФункции

// Получает параметры выгрузки справочника
//
// Возвращаемое значение:
//   Структура   - см. ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников()
//
&НаКлиенте
Функция ПолучитьПараметрыВыгрузки(СтрокаНастроек)

	ПараметрыВыгрузки = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
	
	ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, СтрокаНастроек);
	ПараметрыВыгрузки.ТаблицаСопоставленияПолей 	= СтрокаНастроек.СписокСопоставленияПолей.ВыгрузитьЗначения();
	
	Если НЕ ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		ПараметрыВыгрузки.Вставить("НастройкаКомпоновщикаСтрокой", СтрокаНастроек.НастройкаКомпоновщикаСтрокой);
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		ПараметрыВыгрузки.Вставить("ТипБазы", ТипБазы);
	КонецЕсли;
	
	Возврат ПараметрыВыгрузки;

КонецФункции

// Создание элементов условного оформления для отображения представлений, а не значений списка выбора для колонки СпособВыгрузки
//
&НаСервере
Процедура ДобавитьУсловноеОформлениеТекстаДляСпискаВыбораСпособаВыгрузки()
	
	Элемент = ЭтаФорма.Элементы.НастройкиОбменаСправочниковСпособВыгрузки;
	
	Для Каждого ЭлементСпискаВыбора Из Элемент.СписокВыбора Цикл

        // Новое правило оформления
        ЭлементУсловногоОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
        ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСпискаВыбора.Представление);

        // Условие
        ЭлементУсловия  = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ЭлементУсловия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(Элемент.ПутьКДанным);
        ЭлементУсловия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
        ЭлементУсловия.ПравоеЗначение 	= ЭлементСпискаВыбора.Значение;

        // Поле
        ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
        ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элемент.Имя);

	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьМассивСуществующихНастроекОбмена()

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МассивСуществующихНастроек = НастройкиОбменаСправочников.ВыгрузитьКолонку("ИмяТаблицы");
	#Иначе
		МассивСуществующихНастроек = НастройкиОбменаСправочников.Выгрузить().ВыгрузитьКолонку("ИмяТаблицы");
	#КонецЕсли
	
	Возврат МассивСуществующихНастроек;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры

#КонецОбласти

#Область Описанияоповещений

&НаКлиенте
Процедура ВопросВыгрузитьОтмеченныеСправочникиЗавершение(РезультатВопроса, Параметр = Неопределено) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьОтмеченныеСправочники();
			
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтмеченныеСправочники()

	ПараметрыВыгрузкиСправочников = Новый Массив;
	
	Для Каждого Строка Из НастройкиОбменаСправочников Цикл
		Если Строка.Выгружать = Истина Тогда
			ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки(Строка);
			ПараметрыВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ПараметрыВыгрузки", Строка.ИмяТаблицы, ПараметрыВыгрузки));			
		КонецЕсли;
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьОтмеченныеСправочникиЗавершение(РезультатВопроса,Параметр) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из НастройкиОбменаСправочников Цикл		
		Если Строка.Выгружать = Истина Тогда
			_ЛокКонтекст.ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(Строка.ИмяТаблицы);	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВопросВыгрузитьСправочникЗавершение(РезультатВопроса, ТекущаяСтрокаНастройки) Экспорт
	
	ИмяСобытия = "ВопросВыгрузитьСправочникЗавершение";
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицы = ТекущаяСтрокаНастройки.ИмяТаблицы;
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки(ТекущаяСтрокаНастройки);
	
	// <Лог>
	логПоток 	= _ЛокКонтекст.ЛогОткрытьПоток(ИмяСобытия, ЭтаФорма);
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,, "ИмяСправочника,ПараметрыВыгрузки", ИмяТаблицы, ПараметрыВыгрузки);
	логСобытие 	= _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыВыгрузкиСправочников = Новый Массив;
	ПараметрыВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ПараметрыВыгрузки", ИмяТаблицы, ПараметрыВыгрузки));
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте 
Процедура ВопросОчиститьСправочникЗавершение(РезультатВопроса, ИмяТаблицы) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		_ЛокКонтекст.ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтборСправочниковЗакрытие(РезультатНастройки,СтрокаНастройки) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаНастройки.НастройкаКомпоновщикаСтрокой = РезультатНастройки.НастройкаКомпоновщикаСтрокой;
	СохранитьТабличныеНастройки();
	ЗаполнитьКолонкиФиктивнымиНадписями();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрытьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 		
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ТекущаяСтрокаНастройки = СтруктураПараметров.ТекущаяСтрокаНастройки;
		
		ТекущаяСтрокаНастройки.ТекстЗапросаВыгрузкиНаТСД 		= РезультатРедактирования.ТекстЗапросаВыгрузкиНаТСД;
		ТекущаяСтрокаНастройки.ТекстКодаПолучениеПараметров 	= РезультатРедактирования.ТекстКодаПолучениеПараметров;
		ТекущаяСтрокаНастройки.СписокСопоставленияПолей.ЗагрузитьЗначения(РезультатРедактирования.ТаблицаНастроек);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Процедура НастройкиОбменаСправочниковПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		
		Если ДанныеСтроки.Настройка = "Настроено" Тогда
			ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковНастройка.ЦветТекста = WebЦвета.Зеленый;	
		Иначе	
			ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковНастройка.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСтроки.СпособВыгрузки) Тогда
			ЭлементСписка = ЭлементыФормы.НастройкиОбменаСправочников.Колонки.НастройкиОбменаСправочниковСпособВыгрузки.ЭлементУправления.СписокВыбора.НайтиПоЗначению(ДанныеСтроки.СпособВыгрузки);
			Если ЭлементСписка <> Неопределено Тогда
				ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковСпособВыгрузки.Текст = ЭлементСписка.Представление;
			Иначе
				ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковСпособВыгрузки.Текст = "По умолчанию";				
			КонецЕсли;
		КонецЕсли;
			
		ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковИмяМакетаИО.ТолькоПросмотр = ДанныеСтроки.СпособВыгрузки <> "СвойМакетСКД";

		// Отображение картинки
		ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковКартинка.ОтображатьКартинку = Истина;
		ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковКартинка.ОтображатьТекст 	= Ложь;
		
		ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковИмяТаблицыПредставление.ТолькоПросмотр = ДанныеСтроки.Типовой;
		Если ДанныеСтроки.Типовой = Истина Тогда
			ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковКартинка.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
		Иначе
			ОформлениеСтроки.Ячейки.НастройкиОбменаСправочниковКартинка.Картинка = БиблиотекаКартинок.Пользователь;
		КонецЕсли;
		
	КонецПроцедуры

	Процедура ПриЗакрытии()
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии);
		КонецЕсли;
	КонецПроцедуры
	
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
#КонецЕсли