/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаПользователейMS.Колонки.ТаблицаПользователейMSИдСкладов.Видимость = _ЛокКонтекст.ЛокЯдро_ПроверитьИспользованиеСкладовSMARTS();
	#Иначе
		Элементы.ТаблицаПользователейMSИдСкладов.Видимость = _ЛокКонтекст.ЛокЯдро_ПроверитьИспользованиеСкладовSMARTS();
	#КонецЕсли
	
	ОбновлениеТаблицФормыИзБазыSMARTS();
	
	_ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеПользователейMS(); // TODO. Убрать повторное получение пользователей
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обработчики команд
&НаКлиенте
Процедура СоздатьГруппу(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СозданиеГруппыПользователей = ПолучитьФорму("ОФ_ФормаСлужебная_СозданиеГруппыПользователей", ЭтаФорма);
	#Иначе
		ФормаНастройки_СозданиеГруппыПользователей = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_СозданиеГруппыПользователей", , ЭтаФорма);	
		ФормаНастройки_СозданиеГруппыПользователей.РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаНастройки_СозданиеГруппыПользователей.ЗакрыватьПриЗакрытииВладельца 	= Истина;	
	ФормаНастройки_СозданиеГруппыПользователей._ЛокКонтекст 					= _ЛокКонтекст;	
	ФормаНастройки_СозданиеГруппыПользователей.Заголовок 						= НСтр("ru = 'Создание новой группы пользователей Клеверенс';
																						|en = 'Creating a new Cleverence User Group'; be = 'Стварэнне новай групы карыстальнікаў Cleverence'; es = 'Crear un nuevo grupo de usuarios de Cleverence'; ka = 'ახალი Cleverence მომხმარებლის ჯგუფის შექმნა'; kk = 'Cleverence пайдаланушыларының жаңа тобын құру'; ro = 'Crearea unui nou grup de utilizatori Cleverence'; tr = 'Yeni bir Cleverence kullanıcı grubu oluşturma'; uk = 'Створення нової групи користувачів Cleverence'; uz = 'Yangi Cleverence foydalanuvchilar guruhini yaratish'");	
	ФормаНастройки_СозданиеГруппыПользователей.АдресИдентификаторов				= ВыгрузитьТаблицуИдентификаторов(Истина);	
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СозданиеНовогоЭлементаЗакрытие", ЭтаФорма);
	ФормаНастройки_СозданиеГруппыПользователей.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаНастройки_СозданиеГруппыПользователей.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПользователя(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СозданиеПользователя = ПолучитьФорму("ОФ_ФормаСлужебная_СозданиеПользователя", ЭтаФорма);
	#Иначе
		ФормаНастройки_СозданиеПользователя = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_СозданиеПользователя", , ЭтаФорма);	
		ФормаНастройки_СозданиеПользователя.РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаНастройки_СозданиеПользователя.ЗакрыватьПриЗакрытииВладельца 	= Истина;	
	ФормаНастройки_СозданиеПользователя._ЛокКонтекст 					= _ЛокКонтекст;
	
	ФормаНастройки_СозданиеПользователя.Заголовок 						= НСтр("ru = 'Создание нового пользователя Клеверенс';
																				|en = 'Creating a new Cleverence user'; be = 'Стварэнне новага карыстальніка Cleverence'; es = 'Crear un nuevo usuario Cleverence'; ka = 'ახალი Cleverence მომხმარებლის შექმნა'; kk = 'Жаңа cleverence пайдаланушысын құру'; ro = 'Crearea unui nou utilizator Cleverence'; tr = 'Yeni bir Cleverence kullanıcısı oluşturma'; uk = 'Створення нового користувача Cleverence'; uz = 'Yangi Cleverence foydalanuvchisini yaratish'");
	ФормаНастройки_СозданиеПользователя.АдресГруппыПользователей		= ВыгрузитьТаблицуГруппПользователейНаСервере();
	ФормаНастройки_СозданиеПользователя.АдресСкладов					= ВыгрузитьТаблицуСкладовНаСервере();
	ФормаНастройки_СозданиеПользователя.АдресИдентификаторов			= ВыгрузитьТаблицуИдентификаторов();	

	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ФормаНастройки_СозданиеПользователя.ИмяГруппы 					= ТекДанные.Ид;	
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ПозицияСтроки", ТаблицаГруппMS.Индекс(Элементы.ТаблицаГруппMS.ТекущиеДанные));	
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СозданиеНовогоЭлементаЗакрытие", ЭтаФорма, ДопПараметры);
	ФормаНастройки_СозданиеПользователя.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаНастройки_СозданиеПользователя.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьГруппу(Команда)
		
	ОткрытьФормуРедактированияГруппы();

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьПользователя(Команда)
		
	ОткрытьФормуРедактированияПользователя();

КонецПроцедуры
                               
&НаКлиенте
Процедура УдалитьГруппу(Команда)

	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	// Проверка на наличие пользователей в удаляемой группе
	Если ТаблицаПользователейПолная.НайтиСтроки(Новый Структура("ИдГруппы", ТекДанные.Ид)).Количество() > 0 Тогда
		Сообщение = НСтр("ru = 'Есть пользователи в группе ""%1"". Удаление невозможно!';
							|en = 'There are users in the ""%1"" group. Deletion is not possible!';
							|be = 'Ёсць карыстальнікі ў групе ""%1"". Выдаленне немагчыма!'; es = 'Hay usuarios en el grupo ""%1"". Eliminación imposible!'; ka = '""%1 "" ჯგუფში არიან მომხმარებლები. წაშლა შეუძლებელია!'; kk = '""%1 "" тобында пайдаланушылар бар. Жою мүмкін емес!'; ro = 'Există utilizatori în grupul ""%1"". Ștergerea nu este posibilă!'; tr = '""%1"" grubunda kullanıcılar var. Kaldırma mümkün değil!'; uk = 'Є користувачі в групі ""%1"". Видалення неможливо!'; uz = '""%1 "" guruhida foydalanuvchilar bor. Olib tashlash mumkin emas!'");
		Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТекДанные.Имя);
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;
	
	Если ТаблицаГруппMS.Количество() = 1 Тогда
		Сообщение = НСтр("ru = 'Нельзя удалить единственную группу!';
							|en = 'You can''t delete a single group!'; be = 'Нельга выдаліць адзіную групу!'; es = '¡No se puede eliminar un solo grupo!'; ka = 'თქვენ არ შეგიძლიათ წაშალოთ ერთი ჯგუფი!'; kk = 'Бір топты жою мүмкін емес!'; ro = 'Nu puteți șterge un singur grup!'; tr = 'Tek bir grubu silemezsiniz!'; uk = 'Не можна видалити єдину групу!'; uz = 'Siz bitta guruhni o''chira olmaysiz!'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;	
	
	ИндексТекГруппы = ТаблицаГруппMS.Индекс(ТекДанные);
		
	ПараметрыГруппы = Новый Структура;
	ПараметрыГруппы.Вставить("Ид", ТекДанные.Ид);
	УдалениеЭлемента = _ЛокКонтекст.ЛокЯдро_УдалитьГруппыПользователейВSMARTS(ПараметрыГруппы);
	
	Если УдалениеЭлемента <> Неопределено И УдалениеЭлемента.Результат = Истина Тогда
		ОбновлениеТаблицФормыИзБазыSMARTS();
		// Позиционируем строку либо на строке удаленной группы, либо на последней
		#Если ТолстыйКлиентОбычноеПриложение Тогда                                                                          
			Если ИндексТекГруппы < ТаблицаГруппMS.Количество() Тогда
				Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ИндексТекГруппы);
			Иначе
				Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ТаблицаГруппMS.Количество() - 1);			
			КонецЕсли;
		#Иначе
			Если ИндексТекГруппы < ТаблицаГруппMS.Количество() Тогда
				Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ИндексТекГруппы).ПолучитьИдентификатор();
			Иначе
				Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ТаблицаГруппMS.Количество() - 1).ПолучитьИдентификатор();			
			КонецЕсли;
		#КонецЕсли
	Иначе		
		Сообщение = НСтр("ru = 'Не удалось удалить группу %1. Причина: %2. Подробности в журнале регистрации';
							|en = 'The %1 group could not be deleted. Reason: %2. Details in the registration log';
							|be = 'Не атрымалася выдаліць групу %1. Прычына: %2. Падрабязнасці ў часопісе рэгістрацыі'; es = 'No se pudo eliminar el grupo %1. Causa: %2. Detalles en el registro'; ka = '%1 ჯგუფი ვერ წაიშალა. მიზეზი: %2. დეტალები სარეგისტრაციო ჟურნალში'; kk = '% 1 тобын жою мүмкін болмады. Себебі: %2. Тіркеу журналындағы мәліметтер'; ro = 'Grupul %1 nu a putut fi șters. Motiv: %2. Detalii în Jurnalul de înregistrare'; tr = '%1 grubu silinemedi. Nedeni: %2. Kayıt defterindeki ayrıntılar'; uk = 'Не вдалося видалити групу %1. Причина: %2. Подробиці в журналі реєстрації'; uz = '%1 guruhini olib tashlash mumkin emas edi. Sababi: %2. Ro''yxatdan o''tish jurnalidagi tafsilotlar'");
		Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТекДанные.Имя, УдалениеЭлемента.ТекстОшибки);
		Сообщить(Сообщение); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользователя(Команда)
	
	ВыделенныеСтроки = Элементы.ТаблицаПользователейMS.ВыделенныеСтроки;
	Если Не ВыделенныеСтроки.Количество() Тогда
		Возврат;		
	КонецЕсли;
	
	Если ТаблицаПользователейПолная.Количество() = 1 Тогда
		Сообщение = НСтр("ru = 'Нельзя удалить единственного пользователя!';
							|en = 'You can''t delete a single user!'; be = 'Нельга выдаліць адзінага карыстальніка!'; es = '¡No se puede eliminar un solo usuario!'; ka = 'თქვენ არ შეგიძლიათ წაშალოთ ერთი მომხმარებელი!'; kk = 'Жалғыз пайдаланушыны жою мүмкін емес!'; ro = 'Nu puteți șterge un singur utilizator!'; tr = 'Tek bir kullanıcıyı silemezsiniz!'; uk = 'Не можна видалити єдиного користувача!'; uz = 'Yagona foydalanuvchini o''chirib bo''lmaydi!'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;  
	
	ОповещениеУдалитьПользователя = Новый ОписаниеОповещения("УдалитьПользователяЗавершение", ЭтаФорма, ВыделенныеСтроки);
	Если ВыделенныеСтроки.Количество() > 1 Тогда
		ТекстВопроса = НСтр("ru = 'Будет произведено удаление выбранных пользователей.';
								|en = 'The selected users will be deleted.';
								|be = 'Будзе выраблена выдаленне выбраных карыстальнікаў.'; es = 'Se eliminarán los usuarios seleccionados.'; ka = 'შერჩეული მომხმარებლები წაიშლება.'; kk = 'Таңдалған пайдаланушылар жойылады.'; ro = 'Utilizatorii selectați vor fi șterși.'; tr = 'Seçilen kullanıcılar silinecektir.'; uk = 'Буде проведено видалення обраних користувачів.'; uz = 'Tanlangan foydalanuvchilar o''chiriladi.'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Будет произведено удаление выбранного пользователя.';
								|en = 'The selected user will be deleted.';
								|be = 'Будзе выраблена выдаленне абранага карыстальніка.'; es = 'Se eliminará el usuario seleccionado.'; ka = 'შერჩეული მომხმარებელი წაიშლება.'; kk = 'Таңдалған пайдаланушы жойылады.'; ro = 'Utilizatorul selectat va fi șters.'; tr = 'Seçilen kullanıcı silinecektir.'; uk = 'Буде проведено видалення обраного користувача.'; uz = 'Tanlangan foydalanuvchi o''chiriladi.'");
	КонецЕсли;
	ТекстВопроса = ТекстВопроса + " "
					+ НСтр("ru = 'Продолжить?';
							|en = 'Continue?'; be = 'Працягнуць?'; es = '¿Continuar?'; ka = 'გაგრძელება?'; kk = 'Жалғастыру?'; ro = 'Continuați?'; tr = 'Devam etmek mi?'; uk = 'Продовжити?'; uz = 'Davom etasizmi?'");
	ПоказатьВопрос(ОповещениеУдалитьПользователя, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользователяЗавершение(РезультатВопроса, ВыделенныеСтроки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если Элементы.ТаблицаГруппMS.ТекущиеДанные <> Неопределено Тогда
		ИндексТекГруппы = ТаблицаГруппMS.Индекс(Элементы.ТаблицаГруппMS.ТекущиеДанные);
	Иначе     
		ИндексТекГруппы = 0;
	КонецЕсли;
	
	// Определяем строку перед первой удаляемой и ее индекс
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИндексВыделеннойСтроки = ТаблицаПользователейMS.Индекс(ВыделенныеСтроки[0]);		
	#Иначе
		ВыделеннаяСтрока = ТаблицаПользователейMS.НайтиПоИдентификатору(ВыделенныеСтроки[0]);
		Если ВыделеннаяСтрока <> Неопределено Тогда
			ИндексВыделеннойСтроки = ТаблицаПользователейMS.Индекс(ВыделеннаяСтрока);
		КонецЕсли;
	#КонецЕсли	
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ОбработкаУдаленияПользователя(ВыделеннаяСтрока, ИндексТекГруппы);
	КонецЦикла;
	
	ОбновлениеТаблицФормыИзБазыSMARTS();	
	
	// Позиционируем строку на последней выделенной группе
	#Если ТолстыйКлиентОбычноеПриложение Тогда                                                                          
		Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ИндексТекГруппы);		
	#Иначе
		Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ИндексТекГруппы).ПолучитьИдентификатор();		
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаУдаленияПользователя(ВыделеннаяСтрока, ИндексТекГруппы)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда                      	
		ТекДанные = ВыделеннаяСтрока;
	#Иначе
		ТекДанные = ТаблицаПользователейMS.НайтиПоИдентификатору(ВыделеннаяСтрока);
	#КонецЕсли

	ПараметрыПользователя = Новый Структура;
	ПараметрыПользователя.Вставить("Ид", ТекДанные.Ид);
	УдалениеЭлемента = _ЛокКонтекст.ЛокЯдро_УдалитьПользователейВSMARTS(ПараметрыПользователя);
	
	Если УдалениеЭлемента = Неопределено Или УдалениеЭлемента.Результат <> Истина Тогда		
		Сообщение = НСтр("ru = 'Не удалось удалить пользователя %1. Причина: %2. Подробности в журнале регистрации';
							|en = 'Couldn''t delete user %1. Reason: %2. Details in the registration log';
							|be = 'Не атрымалася выдаліць карыстальніка %1. Прычына: %2. Падрабязнасці ў часопісе рэгістрацыі'; es = 'No se pudo eliminar el usuario %1. Causa: %2. Detalles en el registro'; ka = 'ვერ წაშალა მომხმარებელი %1. მიზეზი: %2. დეტალები სარეგისტრაციო ჟურნალში'; kk = '% 1 пайдаланушысын жою мүмкін болмады. Себебі: %2. Тіркеу журналындағы мәліметтер'; ro = 'Nu s-a putut șterge utilizatorul %1. Motiv: %2. Detalii în Jurnalul de înregistrare'; tr = 'Kullanıcı %1 silinemedi. Nedeni: %2. Kayıt defterindeki ayrıntılar'; uk = 'Не вдалося видалити користувача %1. Причина: %2. Подробиці в журналі реєстрації'; uz = '%1 foydalanuvchisini o''chirib bo''lmadi. Sababi: %2. Ro''yxatdan o''tish jurnalidagi tafsilotlar'");
		Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТекДанные.Имя, УдалениеЭлемента.ТекстОшибки);
		Сообщить(Сообщение); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортПользователей(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортПользователейИз1С = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортПользователейИз1С", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортПользователейИз1С = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортПользователейИз1С", , ЭтаФорма);	
	#КонецЕсли
	
	ФормаСлужебная_ИмпортПользователейИз1С.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСлужебная_ИмпортПользователейИз1С._ЛокКонтекст 					= _ЛокКонтекст;	
	ФормаСлужебная_ИмпортПользователейИз1С.АдресГруппыПользователей			= ВыгрузитьТаблицуГруппПользователейНаСервере();
	ФормаСлужебная_ИмпортПользователейИз1С.АдресСкладов						= ВыгрузитьТаблицуСкладовНаСервере();
	ФормаСлужебная_ИмпортПользователейИз1С.АдресИдентификаторов				= ВыгрузитьТаблицуИдентификаторов();	

	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ФормаСлужебная_ИмпортПользователейИз1С.ИмяГруппы 					= ТекДанные.Ид;	
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СозданиеСпискаНовыхЭлементовЗакрытие", ЭтаФорма);
	ФормаСлужебная_ИмпортПользователейИз1С.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ИмпортПользователейИз1С.Открыть();
		
КонецПроцедуры

