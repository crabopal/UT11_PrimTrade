КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппMSПриАктивизацииСтроки(Элемент)

	// При выделении группы фильтруем список пользователей в соседней таблице
	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда	
		ФильтрПользователейПоВыбраннойГруппе(ТекДанные.Ид);
	КонецЕсли;
	
	// Устанавливаем текущую строку
	Если ИндексВыделеннойСтроки > 0 Тогда
		Если ТаблицаПользователейMS.Количество() > (ИндексВыделеннойСтроки) Тогда
			ИндексВыделеннойСтроки = ИндексВыделеннойСтроки;
		Иначе
			ИндексВыделеннойСтроки = ИндексВыделеннойСтроки - 1;			
		КонецЕсли;		                                                                           
		#Если ТолстыйКлиентОбычноеПриложение Тогда                                                                  
			ТекСтрока = ТаблицаПользователейMS.Получить(ИндексВыделеннойСтроки);			
		#Иначе
			ТекСтрока = ТаблицаПользователейMS.Получить(ИндексВыделеннойСтроки).ПолучитьИдентификатор();			
		#КонецЕсли
		Элементы.ТаблицаПользователейMS.ТекущаяСтрока = ТекСтрока;					
		// Обнуляем реквизит, т.к. до след. удаления он не нужен
		ИндексВыделеннойСтроки = 0;
	КонецЕсли; 		  	       	
	
КонецПроцедуры

&НаСервере
Процедура ФильтрПользователейПоВыбраннойГруппе(ИдГруппы)
	
	МассивСтрокПоВыбраннойГруппе = ТаблицаПользователейПолная.НайтиСтроки(Новый Структура("ИдГруппы", ИдГруппы));	
	#Если ТолстыйКлиентОбычноеПриложение Тогда                                                            
		ТаблицаПользователейMS = ТаблицаПользователейПолная.Скопировать(МассивСтрокПоВыбраннойГруппе);
	#Иначе                                                                                               
		ТаблицаПользователейMS.Загрузить(ТаблицаПользователейПолная.Выгрузить(МассивСтрокПоВыбраннойГруппе));
	#КонецЕсли 	
	
КонецПроцедуры

// Обработчики перетаскивания пользователей по группам
&НаКлиенте
Процедура ТаблицаПользователейMSНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.Действие 			= ДействиеПеретаскивания.Перемещение;
	ПараметрыПеретаскивания.ДопустимыеДействия 	= ДопустимыеДействияПеретаскивания.Перемещение;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппMSПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаГруппMSПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;

	// Если нет строки назначения переноса - не продолжаем
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заносим переносимые данные (ИД и имя пользователей) в структуру
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") И ПараметрыПеретаскивания.Значение.Количество() Тогда                                    		
		СтруктураИсточник = Новый Массив;
		Для Каждого СтрокаПользователя Из ПараметрыПеретаскивания.Значение Цикл
			СтруктураИсточник.Добавить(Новый Структура("Ид,Имя", СтрокаПользователя.Ид, СтрокаПользователя.Имя));
		КонецЦикла;
	Иначе
		Возврат;
	КонецЕсли;		
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СтрокаГруппы	= Строка;
	#Иначе 
		СтрокаГруппы 	= ТаблицаГруппMS.НайтиПоИдентификатору(Строка); // Группа назначения		
	#КонецЕсли
	ТекСтрокаГруппы		= Элемент.ТекущиеДанные;  // Группа источник                                                       
	
	СтруктураПриемник 	= Новый Структура("Ид,Имя", СтрокаГруппы.Ид, СтрокаГруппы.Имя);
	СтруктураТекГруппа 	= Новый Структура("Ид,Имя", ТекСтрокаГруппы.Ид, ТекСтрокаГруппы.Имя);
	
	ОкончаниеПеретаскиванияПользователя(СтруктураИсточник, СтруктураПриемник, СтруктураТекГруппа);
	
КонецПроцедуры  

&НаКлиенте
Процедура ОкончаниеПеретаскиванияПользователя(СтруктураИсточник, СтруктураПриемник, СтруктураТекГруппа)
	
	Успешно = Ложь;
	
	// Меняем у переносимых пользователей данные группы
	Если ТипЗнч(СтруктураИсточник) = Тип("Массив") Тогда
		Для Каждого ЭлементСтруктуры Из СтруктураИсточник Цикл
			МассивСтрокТаблицы = ТаблицаПользователейПолная.НайтиСтроки(Новый Структура("Ид, Имя", ЭлементСтруктуры.Ид, ЭлементСтруктуры.Имя));
			Если МассивСтрокТаблицы.Количество() Тогда
				ТекПользователь = МассивСтрокТаблицы[0];
				ТекПользователь.ИмяГруппы 	= СтруктураПриемник.Имя;
				ТекПользователь.ИдГруппы 	= СтруктураПриемник.Ид;
				
				ПараметрыПользователя = Новый Соответствие;
				ПараметрыПользователя.Вставить("id", 			ТекПользователь.Ид);
				ПараметрыПользователя.Вставить("name", 			ТекПользователь.Имя);		
				ПараметрыПользователя.Вставить("description", 	ТекПользователь.Описание);		
				ПараметрыПользователя.Вставить("groupId", 		ТекПользователь.ИдГруппы);		
				ПараметрыПользователя.Вставить("groupName", 	ТекПользователь.ИмяГруппы);		
				ПараметрыПользователя.Вставить("warehouseIds", 	ТекПользователь.ИдСкладов.ВыгрузитьЗначения());		
				
				// Склады для кома-режима
				ПараметрыПользователя.Вставить("allWarehouses", Новый СписокЗначений);		
				
				Перенос = _ЛокКонтекст.ЛокЯдро_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя);
				Если Перенос.Результат Тогда
					Успешно = Истина;
				Иначе
					Сообщение = НСтр("ru = 'Не удалось переместить пользователя. Причина: %1. Подробности в журнале регистрации';
										|en = 'Couldn''t move the user. Reason: %1. Details in the registration log';
										|be = 'Не атрымалася перамясціць карыстальніка. Прычына: %1. Падрабязнасці ў часопісе рэгістрацыі'; es = 'No se pudo mover el usuario. Causa: %1. Detalles en el registro'; ka = 'მომხმარებლის გადაადგილება ვერ მოხერხდა. მიზეზი: %1. დეტალები სარეგისტრაციო ჟურნალში'; kk = 'Пайдаланушыны жылжыту мүмкін болмады. Себебі: %1. Тіркеу журналындағы мәліметтер'; ro = 'Nu a putut muta utilizatorul. Motiv: %1. Detalii în Jurnalul de înregistrare'; tr = 'Kullanıcı taşınamadı. Sebep: % 1. Kayıt defterindeki ayrıntılar'; uk = 'Не вдалося перемістити користувача. Причина: %1. Подробиці в журналі реєстрації'; uz = 'Foydalanuvchini ko''chirish mumkin emas. Sababi: %1. Ro''yxatdan o''tish jurnalidagi tafsilotlar'");
					Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, Перенос.ТекстОшибки);
					Сообщить(Сообщение); 
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;	
	
	Если Успешно Тогда
		// Обновляем фильтры таблицы пользователей
		ФильтрПользователейПоВыбраннойГруппе(СтруктураТекГруппа.Ид);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ФормаНастройки_СозданиеНовогоЭлементаЗакрытие(НовыйЭлемент, СтрокаНастройки) Экспорт
	
	Если ТипЗнч(НовыйЭлемент) = Тип("Структура") Тогда
		
		Если НовыйЭлемент.Результат = Истина Тогда
			_ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеПользователейMS();
			ОбновлениеТаблицФормыИзБазыSMARTS();           
			// Позиционируем строку либо на новой группе, либо на созданной
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Если СтрокаНастройки <> Неопределено И СтрокаНастройки.Свойство("ПозицияСтроки") Тогда            			
					Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(СтрокаНастройки.ПозицияСтроки);
				Иначе
					Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ТаблицаГруппMS.Количество() - 1);			
				КонецЕсли;
			#Иначе
				Если СтрокаНастройки <> Неопределено И СтрокаНастройки.Свойство("ПозицияСтроки") Тогда            			
					Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(СтрокаНастройки.ПозицияСтроки).ПолучитьИдентификатор();
				Иначе
					Элементы.ТаблицаГруппMS.ТекущаяСтрока = ТаблицаГруппMS.Получить(ТаблицаГруппMS.Количество() - 1).ПолучитьИдентификатор();			
				КонецЕсли;
			#КонецЕсли
		Иначе		
			Сообщение = НСтр("ru = 'Не удалось создать новый элемент. Причина: %1. Подробности в журнале регистрации';
								|en = 'Couldn''t create a new element. Reason: %1. Details in the registration log';
								|be = 'Не атрымалася стварыць новы элемент. Прычына: %1. Падрабязнасці ў часопісе рэгістрацыі'; es = 'No se pudo crear un nuevo elemento. Causa: %1. Detalles en el registro'; ka = 'ვერ შექმნა ახალი ელემენტი. მიზეზი: %1. დეტალები სარეგისტრაციო ჟურნალში'; kk = 'Жаңа элемент жасау мүмкін болмады. Себебі: %1. Тіркеу журналындағы мәліметтер'; ro = 'Nu am putut crea un element nou. Motiv: %1. Detalii în Jurnalul de înregistrare'; tr = 'Yeni bir öğe oluşturulamadı. Sebep: % 1. Kayıt defterindeki ayrıntılar'; uk = 'Не вдалося створити новий елемент. Причина: %1. Подробиці в журналі реєстрації'; uz = 'Yangi element yaratilmadi. Sababi: %1. Ro''yxatdan o''tish jurnalidagi tafsilotlar'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, НовыйЭлемент.ТекстОшибки);
			Сообщить(Сообщение); 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_СозданиеСпискаНовыхЭлементовЗакрытие(НовыеЭлементы, СтрокаНастройки) Экспорт
	
	_ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеПользователейMS();
	ОбновлениеТаблицФормыИзБазыSMARTS();
		
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыФункции

&НаКлиенте
Процедура ОткрытьФормуРедактированияГруппы()
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СозданиеГруппыПользователей = ПолучитьФорму("ОФ_ФормаСлужебная_СозданиеГруппыПользователей", ЭтаФорма);
	#Иначе
		ФормаНастройки_СозданиеГруппыПользователей = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_СозданиеГруппыПользователей", , ЭтаФорма);	
		ФормаНастройки_СозданиеГруппыПользователей.РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
		
	ФормаНастройки_СозданиеГруппыПользователей.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаНастройки_СозданиеГруппыПользователей._ЛокКонтекст 					= _ЛокКонтекст;     	
	ФормаНастройки_СозданиеГруппыПользователей.Заголовок 						= НСтр("ru = 'Редактирование группы пользователей Клеверенс';
																						|en = 'Editing the Cleverence User Group'; be = 'Рэдагаванне групы карыстальнікаў Cleverence'; es = 'Editar un grupo de usuarios de Cleverence'; ka = 'Cleverence მომხმარებლის ჯგუფის რედაქტირება'; kk = 'Cleverence пайдаланушылар тобын өңдеу'; ro = 'Editarea grupului de utilizatori Cleverence'; tr = 'Cleverence kullanıcı grubunu düzenleme'; uk = 'Редагування групи користувачів Cleverence'; uz = 'Cleverence foydalanuvchilar guruhini tahrirlash'");
	ФормаНастройки_СозданиеГруппыПользователей.ТолькоРедактирование				= Истина;	
	
	ТекДанные = Элементы.ТаблицаГруппMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ФормаНастройки_СозданиеГруппыПользователей.Идентификатор 				= ТекДанные.Ид;	
		ФормаНастройки_СозданиеГруппыПользователей.ИмяГруппы 					= ТекДанные.Имя;	
		ФормаНастройки_СозданиеГруппыПользователей.Роль 						= ТекДанные.Роль;
		
		ТипыДокументовКПередаче = Новый СписокЗначений;
		Для Каждого Тип Из ТекДанные.ТипыДокументов Цикл
			Если Тип.Пометка Тогда
				ТипыДокументовКПередаче.Добавить(Тип.Значение, Тип.Представление);
			КонецЕсли;
		КонецЦикла;
		ФормаНастройки_СозданиеГруппыПользователей.ТипыДокументов				= ТипыДокументовКПередаче;
	Иначе
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ПозицияСтроки", ТаблицаГруппMS.Индекс(Элементы.ТаблицаГруппMS.ТекущиеДанные));	
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СозданиеНовогоЭлементаЗакрытие", ЭтаФорма, ДопПараметры);
	ФормаНастройки_СозданиеГруппыПользователей.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаНастройки_СозданиеГруппыПользователей.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияПользователя()
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СозданиеПользователя = ПолучитьФорму("ОФ_ФормаСлужебная_СозданиеПользователя", ЭтаФорма);
	#Иначе
		ФормаНастройки_СозданиеПользователя = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_СозданиеПользователя", , ЭтаФорма);	
		ФормаНастройки_СозданиеПользователя.РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;		
	#КонецЕсли
		
	ФормаНастройки_СозданиеПользователя.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаНастройки_СозданиеПользователя._ЛокКонтекст 					= _ЛокКонтекст;     	
	ФормаНастройки_СозданиеПользователя.Заголовок 						= НСтр("ru = 'Редактирование пользователя Клеверенс';
																				|en = 'Editing the Cleverence user'; be = 'Рэдагаванне карыстальніка Cleverence'; es = 'Editar usuario Cleverence'; ka = 'Cleverence მომხმარებლის რედაქტირება'; kk = 'Cleverence пайдаланушысын өңдеу'; ro = 'Editarea utilizatorului Cleverence'; tr = 'Cleverence kullanıcısını düzenleme'; uk = 'Редагування користувача Cleverence'; uz = 'Cleverence foydalanuvchisini tahrirlash'");
	ФормаНастройки_СозданиеПользователя.ТолькоРедактирование			= Истина;
	ФормаНастройки_СозданиеПользователя.АдресГруппыПользователей		= ВыгрузитьТаблицуГруппПользователейНаСервере();
	ФормаНастройки_СозданиеПользователя.АдресСкладов					= ВыгрузитьТаблицуСкладовНаСервере();
	ФормаНастройки_СозданиеПользователя.АдресИдентификаторов			= ВыгрузитьТаблицуИдентификаторов();	
	
	ТекДанные = Элементы.ТаблицаПользователейMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ФормаНастройки_СозданиеПользователя, ТекДанные, "Описание,Пароль,Штрихкод");
		ФормаНастройки_СозданиеПользователя.ИдСкладовПользователя 		= ТекДанные.ИдСкладов;	
		ФормаНастройки_СозданиеПользователя.Идентификатор 				= ТекДанные.Ид;	
		ФормаНастройки_СозданиеПользователя.ИмяПользователя 			= ТекДанные.Имя;	
		ФормаНастройки_СозданиеПользователя.ИмяГруппы 					= ТекДанные.ИдГруппы;	
	Иначе
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ПозицияСтроки", ТаблицаГруппMS.Индекс(Элементы.ТаблицаГруппMS.ТекущиеДанные));	
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СозданиеНовогоЭлементаЗакрытие", ЭтаФорма, ДопПараметры);
	ФормаНастройки_СозданиеПользователя.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаНастройки_СозданиеПользователя.Открыть();

КонецПроцедуры

// Загрузка таблиц с данными при инициализации формы
&НаСервере
Процедура ЗагрузитьТаблицуПользователейНаСервере(Адрес)
	
	пМассивПользователейMS 	= ПолучитьИзВременногоХранилища(Адрес);
	пТаблицаПользователейMS = МассивСтруктурВТаблицуЗначений(пМассивПользователейMS);
	
	Если пТаблицаПользователейMS <> Неопределено Тогда      
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ТаблицаПользователейПолная 	= пТаблицаПользователейMS.Скопировать();
			ТаблицаПользователейMS 		= ТаблицаПользователейПолная.Скопировать();
		#Иначе                                                    
			ТаблицаПользователейПолная.Загрузить(пТаблицаПользователейMS);
			ТаблицаПользователейMS.Загрузить(пТаблицаПользователейMS);
		#КонецЕсли                                                	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТаблицуСкладовНаСервере(Адрес)
	
	пМассивСкладовMS 	= ПолучитьИзВременногоХранилища(Адрес); 
	пТаблицаСкладовMS 	= МассивСтруктурВТаблицуЗначений(пМассивСкладовMS);
	
	Если пТаблицаСкладовMS <> Неопределено Тогда  
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			СкладыВспомогательные = пТаблицаСкладовMS.Скопировать();
		#Иначе                                                 
			СкладыВспомогательные.Загрузить(пТаблицаСкладовMS);
		#КонецЕсли
	КонецЕсли; 
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если СкладыВспомогательные.Колонки.Количество() = 0 Тогда
			СкладыВспомогательные.Колонки.Добавить("Ид");
			СкладыВспомогательные.Колонки.Добавить("Имя");
		КонецЕсли;
	#КонецЕсли

	Если СкладыВспомогательные.Количество() Тогда	
		Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл
			СписокСкладов = СтрокаПользователя.ИдСкладов;
			Для Каждого КлючИЗначение Из СписокСкладов Цикл
				НайденныеСклады = СкладыВспомогательные.НайтиСтроки(Новый Структура("Ид", КлючИЗначение.Значение));
				Если НайденныеСклады.Количество() Тогда
					КлючИЗначение.Представление = НайденныеСклады[0].Имя;
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТаблицуГруппПользователейНаСервере(Адрес)
	
	ТаблицаГруппMS.Очистить();
	пМассивГруппПользователейMS 	= ПолучитьИзВременногоХранилища(Адрес);
	пТаблицаГруппПользователейMS 	= МассивСтруктурВТаблицуЗначений(пМассивГруппПользователейMS);
	
	Если пТаблицаГруппПользователейMS <> Неопределено Тогда
		Для Каждого СтрокаТаблицы Из пТаблицаГруппПользователейMS Цикл
			НоваяСтрокаГруппы = ТаблицаГруппMS.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрокаГруппы, СтрокаТаблицы);
			Для Каждого Тип Из СтрокаТаблицы.ТипыДокументов Цикл
				НоваяСтрокаГруппы.ТипыДокументов.Добавить(Тип, Тип, Истина);
			КонецЦикла; 		
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеТаблицФормыИзБазыSMARTS()
	
	// Загружаем в таблицы из SMARTS склады, группы, пользователей
	ЗагрузитьТаблицуПользователейНаСервере(_ЛокКонтекст.ЛокЯдро_ПолучитьПользователейSMARTS());
	ЗагрузитьТаблицуСкладовНаСервере(_ЛокКонтекст.ЛокЯдро_ПолучитьСкладыSMARTS());                          
	ЗагрузитьТаблицуГруппПользователейНаСервере(_ЛокКонтекст.ЛокЯдро_ПолучитьГруппыПользователейSMARTS());
	
КонецПроцедуры

