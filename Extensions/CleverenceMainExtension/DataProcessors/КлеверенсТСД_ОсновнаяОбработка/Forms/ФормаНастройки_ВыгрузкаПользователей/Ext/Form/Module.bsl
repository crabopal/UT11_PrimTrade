&НаСервере
Функция ВыгрузитьТаблицуИдентификаторов(ЭтоГруппа = Ложь)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ЭтоГруппа Тогда
			МассивИд = ТаблицаПользователейПолная.Выгрузить(, "Ид").ВыгрузитьКолонку("Ид");
		Иначе
			МассивИд = ТаблицаГруппMS.Выгрузить(, "Ид").ВыгрузитьКолонку("Ид");		
		КонецЕсли;
		
		Возврат ПоместитьВоВременноеХранилище(МассивИд, УникальныйИдентификатор);
	#Иначе
		Если Не ЭтоГруппа Тогда
			МассивИд = ТаблицаПользователейПолная.ВыгрузитьКолонку("Ид");
		Иначе
			МассивИд = ТаблицаГруппMS.ВыгрузитьКолонку("Ид");		
		КонецЕсли;
		
		Возврат ПоместитьВоВременноеХранилище(МассивИд, Новый УникальныйИдентификатор);
	#КонецЕсли		
	
КонецФункции

// Сокращенный вариант глобальной процедуры преобразования структуры данных
&НаСервере
Функция МассивСтруктурВТаблицуЗначений(МассивСтруктур)
	
	Если МассивСтруктур = Неопределено Или МассивСтруктур.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;               
	
	ОписаниеТЗ = МассивСтруктур[0];
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ОписаниеТЗ Цикл
		МассивКолонок.Добавить(Колонка.Ключ);	
	КонецЦикла;
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для Каждого НаименованиеКолонки Из МассивКолонок Цикл
		ТаблицаЗначений.Колонки.Добавить(НаименованиеКолонки);
	КонецЦикла; 
	
	Для Сч = 0 По МассивСтруктур.Количество() - 1 Цикл		
		Если ТипЗнч(МассивСтруктур[Сч]) = Тип("Структура") Тогда
			НоваяСтрока = ТаблицаЗначений.Добавить();
			Результат = Новый Структура();
			Для каждого Элемент Из МассивСтруктур[Сч] Цикл			
				Результат.Вставить(Элемент.Ключ, Элемент.Значение);                                       								
			КонецЦикла; 
		    ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат);
		КонецЕсли;		
	КонецЦикла; 
	
	Возврат ТаблицаЗначений;

КонецФункции

#КонецОбласти    

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли

