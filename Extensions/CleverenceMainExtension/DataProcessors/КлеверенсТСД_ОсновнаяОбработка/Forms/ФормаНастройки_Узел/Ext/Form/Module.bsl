/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ЧастнаяБазаMS Экспорт;

&НаКлиенте
Перем УзелСохранен;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтоНовыйУзел Тогда
		ID_Узла = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("ND");
		ТаблицаПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	Иначе
		
		Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
			ТаблицаПользователей 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Пользователи");
			ТаблицаПараметров 		= _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(, Истина);
			ТаблицаПользователейТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПользователиТСД");
		Иначе
			ТаблицаПользователей 	= _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("Пользователи", ID_Узла);
			ТаблицаПараметров 		= _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла, Истина);
			ТаблицаПользователейТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПользователиТСД", ID_Узла);
		КонецЕсли;
		
		Если ТипЗнч(ТаблицаПользователейТСД) = Тип("Массив") Тогда
			Для Каждого СтрокаНастройки Из ТаблицаПользователейТСД Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ПользователиТСД.Добавить(), СтрокаНастройки);
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаПараметров) = Тип("Массив") Тогда
		Для Каждого СтрокаНастройки Из ТаблицаПараметров Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ЗначенияПараметровУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			
			Если НЕ СтрокаНастройки.Свойство("Типовой") Тогда
				НоваяСтрока.Типовой = Ложь;
			КонецЕсли;
			НоваяСтрока.Картинка = ?(НЕ НоваяСтрока.Типовой, БиблиотекаКартинок.Пользователь, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки);
		КонецЦикла;
	КонецЕсли;
	
	Заголовок = Заголовок + Наименование;
	
	ОбновитьДоступностьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы = Ложь)
	
	Если ЗавершениеРаботы <> Истина И ЭтоНовыйУзел И УзелСохранен <> Истина Тогда
		НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НастройкаЧБ(Команда)
	
	Если ТипЗнч(ЧастнаяБазаMS) <> Тип("Структура") Тогда
		ЧастнаяБазаMS = Новый Структура;	
	КонецЕсли;
	
	ФормаСлужебная_НастройкиПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьФорму("ФормаСлужебная_НастройкиПодключения", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца,, ЭтаФорма);
	ФормаСлужебная_НастройкиПодключения.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСлужебная_НастройкиПодключения._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаСлужебная_НастройкиПодключения.ТипБазы 						= "Частная";
	ФормаСлужебная_НастройкиПодключения.Компонента						= РасположениеКомпонентыЧБ;
	ФормаСлужебная_НастройкиПодключения.ТипИнтерфейса					= "REST_API";
	ФормаСлужебная_НастройкиПодключения.ПараметрыПодключения 			= ЧастнаяБазаMS;
	ФормаСлужебная_НастройкиПодключения.РежимВыбораБазы 				= "СтрокаПодключения";
	
	ОП = Новый ОписаниеОповещения("НастройкаЧБЗавершение", ЭтаФорма);
	ФормаСлужебная_НастройкиПодключения.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_НастройкиПодключения.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_НастройкиПодключения.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЧБЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ПараметрыЧастнойБазы = Неопределено;
		Результат.Свойство("ПараметрыЧастнойБазы", ПараметрыЧастнойБазы);
		Если ПараметрыЧастнойБазы <> Неопределено Тогда
			
			ЧастнаяБазаMS 				= ПараметрыЧастнойБазы.ЧастнаяБазаMS;
			РасположениеКомпонентыЧБ 	= ПараметрыЧастнойБазы.РасположениеКомпонентыЧБ;
			РежимВыбораБазыЧБ 			= ПараметрыЧастнойБазы.РежимВыбораБазыЧБ;
			НаименованиеЧБ 				= ПараметрыЧастнойБазы.НаименованиеЧБ;
			ТипИнтерфейсаЧБ 			= ПараметрыЧастнойБазы.ТипИнтерфейсаЧБ;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 


&НаКлиенте
Процедура НастройкиПользователейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элементы.НастройкиПользователей.ТекущиеДанные.ID_Пользователя = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("UP");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПользователиТСДПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПользователиТСДПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если ИспользоватьЧастнуюБазу И НЕ ЗначениеЗаполнено(ЧастнаяБазаMS) Тогда
		Сообщение = НСтр("ru = 'Не выбрана частная база SMARTS';
							|en = 'The private Cleverence database has not been selected'; be = 'Не абраная прыватная база Cleverence'; es = 'Base privada Cleverence no seleccionada'; ka = 'კერძო Cleverence მონაცემთა ბაზა არ არის შერჩეული'; kk = 'Cleverence жеке базасы таңдалмаған'; ro = 'Baza de date private Cleverence nu a fost selectată'; tr = 'Özel bir Cleverence tabanı seçilmedi'; uk = 'Не вибрано приватну базу Cleverence'; uz = 'Xususiy Cleverence ma''lumotlar bazasi tanlanmagan'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;	
	
	Если НЕ НаименованиеУзлаУникально(Наименование,ID_Узла) Тогда
		Сообщение = НСтр("ru = 'Наименование торгового объекта не уникально';
							|en = 'The name of the shopping facility is not unique'; be = 'Найменне гандлёвага аб''екта не ўнікальна'; es = 'El nombre del objeto comercial no es único'; ka = 'სავაჭრო ობიექტის სახელი არ არის უნიკალური'; kk = 'Сауда объектісінің атауы бірегей емес'; ro = 'Numele facilității comerciale nu este unic'; tr = 'Ticari nesnenin adı benzersiz değildir'; uk = 'Найменування торгового об''єкта не унікально'; uz = 'Savdo ob''ektining nomi noyob emas'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;	
	
	ОП = Новый ОписаниеОповещения("СохранитьИЗакрытьПослеПодключения",ЭтаФорма);
	Если ТипЗнч(ЧастнаяБазаMS) = Тип("Структура") Тогда
		ЧастнаяБазаMS.Вставить("ТипИнтерфейса",ТипИнтерфейсаЧБ);
		ЧастнаяБазаMS.Вставить("РасположениеКомпоненты",РасположениеКомпонентыЧБ);
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Истина,"Частная",РасположениеКомпонентыЧБ,Истина,Истина,ОП)
	Иначе
		СохранитьИЗакрытьПослеПодключения(Истина,Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	СтрокаПользователейИГрупп = "";
	Для каждого Пользователь Из ПользователиТСД Цикл							
		СимволВНачалеСтроки = ?(СтрокаПользователейИГрупп = "", "", ",");
		СтрокаПользователейИГрупп = СтрокаПользователейИГрупп + СимволВНачалеСтроки + """" + СокрЛП(Пользователь.ID_Пользователя) + """";			
	КонецЦикла;
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ID_Узла", ID_Узла);
	СтруктураНастроек.Вставить("Ид",ID_Узла);
	СтруктураНастроек.Вставить("Код", ID_Узла);
	СтруктураНастроек.Вставить("ШК","");
	СтруктураНастроек.Вставить("ЭтоПапка",Ложь);
	СтруктураНастроек.Вставить("ИдРодителя","");
	СтруктураНастроек.Вставить("Владелец", СтрокаПользователейИГрупп);
	СтруктураНастроек.Вставить("НаименованиеДляПоиска",НРег(Наименование));
	СтруктураНастроек.Вставить("Наименование", Наименование);
	СтруктураНастроек.Вставить("ЧастнаяБазаMS", ЧастнаяБазаMS);
	СтруктураНастроек.Вставить("ИспользоватьЧастнуюБазу", ИспользоватьЧастнуюБазу);
	СтруктураНастроек.Вставить("Комментарий", Комментарий);
	СтруктураНастроек.Вставить("РасположениеКомпонентыЧБ", РасположениеКомпонентыЧБ);
	СтруктураНастроек.Вставить("РежимВыбораБазыЧБ", РежимВыбораБазыЧБ);
	СтруктураНастроек.Вставить("ТипИнтерфейсаЧБ", ТипИнтерфейсаЧБ);
	СтруктураНастроек.Вставить("НаименованиеЧБ", НаименованиеЧБ);
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастроек, "НастройкаУзла");
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВосстановитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкаУзла", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт

	Если СтруктураНастроек <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма,СтруктураНастроек,"ID_Узла,Наименование,ЧастнаяБазаMS,ИспользоватьЧастнуюБазу,Комментарий,РасположениеКомпонентыЧБ,РежимВыбораБазыЧБ,НаименованиеЧБ,ТипИнтерфейсаЧБ");
		Модифицированность = Истина;
		ОбновитьДоступностьЭлементов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРегламентногоОбмена(Команда)

	ОткрытьОкноНастройкиОбменаДокументов("Автообмен");		
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОнлайнОбмена(Команда)
	
	ОткрытьОкноНастройкиОбменаДокументов("Онлайн");	
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРучногоОбмена(Команда)	
	
	ОткрытьОкноНастройкиОбменаДокументов("Интерактивный");	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПользователейТСД(Команда)
	
	ТекущиеПользователи = "";
	Для каждого Строка Из ПользователиТСД Цикл
		ТекущиеПользователи = ТекущиеПользователи + Строка.ID_Пользователя + "|";
	КонецЦикла; 
	ТекущиеПользователи = Лев(ТекущиеПользователи, СтрДлина(ТекущиеПользователи) - 1);	
	
	пПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;
	ПользователиMS = _ЛокКонтекст.ЛокЯдро_ПодготовитьДеревоПользователейНаСервере(пПользователиMS);	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	
	ФормаСлужебная_ВыборПользователяИлиГруппы.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборПользователяИлиГруппы._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ТекущиеПользователи = ТекущиеПользователи;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = ПользователиMS;
	ОП = Новый ОписаниеОповещения("Служебная_ВыборПользователяИлиГруппыЗакрытие",ЭтаФорма);
	ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();		
		
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьЧастнуюБазуПриИзменении(Элемент)
	ОбновитьДоступностьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура НастройкиБизнесПроцессов(Команда)
	
	ОП = Новый ОписаниеОповещения("НастройкиБизнесПроцессовПослеПодключения", ЭтаФорма);
	Если ИспользоватьЧастнуюБазу Тогда		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS, Ложь, "Частная", РасположениеКомпонентыЧБ,, Истина, ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS, Ложь, "Основная",,, Истина, ОП);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОтборовСправочников_Онлайн(Команда)
	
	ДопПараметры = Новый Структура("РежимОбмена", "Онлайн");
	ОП = Новый ОписаниеОповещения("НастройкиОбменаСправочниковПослеПодключения", ЭтаФорма, ДопПараметры);
	Если ИспользоватьЧастнуюБазу Тогда		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Частная",РасположениеКомпонентыЧБ,,Истина,ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Основная",,,Истина,ОП);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОтборовСправочников_Интерактивный(Команда)
	
	ДопПараметры = Новый Структура("РежимОбмена", "Интерактивный");
	ОП = Новый ОписаниеОповещения("НастройкиОбменаСправочниковПослеПодключения", ЭтаФорма, ДопПараметры);
	Если ИспользоватьЧастнуюБазу Тогда		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Частная",РасположениеКомпонентыЧБ,,Истина,ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Основная",,,Истина,ОП);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОтборовСправочников_Автообмен(Команда)
	
	ДопПараметры = Новый Структура("РежимОбмена", "Автообмен");
	ОП = Новый ОписаниеОповещения("НастройкиОбменаСправочниковПослеПодключения", ЭтаФорма, ДопПараметры);
	Если ИспользоватьЧастнуюБазу Тогда		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Частная",РасположениеКомпонентыЧБ,,Истина,ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Основная",,,Истина,ОП);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте
Функция НаименованиеУзлаУникально(Наименование,ID_Узла)

	Результат = Истина;
	пТаблицаУзлов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(пТаблицаУзлов) = Тип("Массив") Тогда
		Для Каждого Узел Из пТаблицаУзлов Цикл
			Если Узел.Свойство("Наименование")
					И ВРег(СокрЛП(Узел.Наименование)) = ВРег(СокрЛП(Наименование))
					И ВРег(СокрЛП(Узел.ID_Узла)) <> ВРег(СокрЛП(ID_Узла)) Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;
		КонецЦикла;
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СохранитьПодчиненныеТаблицы()
	
	// Сохраняем подчиненные таблицы
	МассивЗначенияПараметровУзлов = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицы("ЗначенияПараметровУзлов"));
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", МассивЗначенияПараметровУзлов, ID_Узла);
	МассивПользователиТСД = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицы("ПользователиТСД"));
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПользователиТСД", МассивПользователиТСД, ID_Узла);	
	
	// Сохраняем в кэш
	Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Пользователи", Новый Массив());	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры_Значения", МассивЗначенияПараметровУзлов);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПользователиТСД", МассивПользователиТСД);
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_Узла);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицы(ИмяТЧ)

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		#Область НесовместимыйКодFresh
		ТЗ = Вычислить(ИмяТЧ);
		Возврат ПоместитьВоВременноеХранилище(ТЗ,Новый УникальныйИдентификатор());
		#КонецОбласти //НесовместимыйКодFresh
	#Иначе
		ТЗ = РеквизитФормыВЗначение(ИмяТЧ);
		Возврат ПоместитьВоВременноеХранилище(ТЗ,ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОкноНастройкиОбменаДокументов(ТипОбмена)
	
	ОП = Новый ОписаниеОповещения("ОткрытьОкноНастройкиОбменаДокументовПослеПодключения",ЭтаФорма,Новый Структура("ТипОбмена",ТипОбмена));
	Если ИспользоватьЧастнуюБазу Тогда		
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Частная",РасположениеКомпонентыЧБ,,Истина,ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ЧастнаяБазаMS,Ложь,"Основная",,,Истина,ОП);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	Элементы.ЧастнаяБазаMS.Доступность = ИспользоватьЧастнуюБазу;
	Элементы.НастройкаЧБ.Доступность = ИспользоватьЧастнуюБазу;
	
	Если ТипЗнч(ЧастнаяБазаMS) = Тип("Структура")
		И ЧастнаяБазаMS.Свойство("ИмяБазыСМАРТС") Тогда
		НаименованиеЧБ = ЧастнаяБазаMS.ИмяБазыСМАРТС;
	ИначеЕсли ТипЗнч(ЧастнаяБазаMS) = Тип("Структура")
		И ЧастнаяБазаMS.Свойство("Имя") Тогда
		НаименованиеЧБ = ЧастнаяБазаMS.Имя;
	КонецЕсли;
	
	Если НЕ ИспользоватьЧастнуюБазу Тогда
		НаименованиеЧБ = "";
		ЧастнаяБазаMS = "";
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	СохранитьВФайл("");
	
КонецПроцедуры

&НаКлиенте
Процедура Служебная_ВыборПользователяИлиГруппыЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		ПользователиТСД.Очистить();					
		Для каждого Элемент Из РезультатРедактирования Цикл								
			
			НоваяСтрока 				= ПользователиТСД.Добавить();
			НоваяСтрока.Наименование 	= Элемент.Имя;
			НоваяСтрока.ID_Пользователя = Элемент.Ид; 			
			НоваяСтрока.ID_Узла 		= ID_Узла;
			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрытьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	СтрокаПользователейИГрупп = "";
	Для каждого Пользователь Из ПользователиТСД Цикл							
		СимволВНачалеСтроки = ?(СтрокаПользователейИГрупп = "", "", ",");
		СтрокаПользователейИГрупп = СтрокаПользователейИГрупп + СимволВНачалеСтроки + """" + СокрЛП(Пользователь.ID_Пользователя) + """";			
	КонецЦикла;

	СохранитьПодчиненныеТаблицы();	
	РезультатРедактирования = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_Узлы();
	РезультатРедактирования.ID_Узла 						= ID_Узла;
	РезультатРедактирования.Ид 								= ID_Узла;
	РезультатРедактирования.Код 							= ID_Узла;
	РезультатРедактирования.ШК 								= "";
	РезультатРедактирования.ЭтоПапка 						= Ложь;
	РезультатРедактирования.ИдРодителя 						= "";
	РезультатРедактирования.Владелец 						= СтрокаПользователейИГрупп;
	РезультатРедактирования.НаименованиеДляПоиска 			= НРег(Наименование);
	РезультатРедактирования.Наименование 					= Наименование;
	РезультатРедактирования.ЧастнаяБазаMS 					= ЧастнаяБазаMS;
	РезультатРедактирования.ИспользоватьЧастнуюБазу 		= ИспользоватьЧастнуюБазу;
	РезультатРедактирования.Комментарий 					= Комментарий;
	РезультатРедактирования.РасположениеКомпонентыЧБ 		= РасположениеКомпонентыЧБ;
	РезультатРедактирования.РежимВыбораБазыЧБ 				= РежимВыбораБазыЧБ;
	РезультатРедактирования.ТипИнтерфейсаЧБ 				= ТипИнтерфейсаЧБ;
	
	// Сохраняем настройки частной базы для ее автоматического последующего подключения
	Если _ЛокКонтекст.ЕстьЧастнаяБаза Тогда
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("СтруктураПодключенияЧастнойБазыMS", ЧастнаяБазаMS);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,РезультатРедактирования);
		КонецЕсли;
	#КонецЕсли
	
	УзелСохранен = Истина;
	Закрыть(РезультатРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОбменаСправочниковПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ОтборыСправочников = ПолучитьФорму("ОФ_ФормаСписка_ОтборыСправочников", ЭтаФорма);
	#Иначе
		ФормаСписка_ОтборыСправочников = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ОтборыСправочников", , ЭтаФорма, ЭтаФорма);		
	#КонецЕсли
	
	ФормаСписка_ОтборыСправочников.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСписка_ОтборыСправочников._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаСписка_ОтборыСправочников.ID_Узла 							= ID_Узла;
	ФормаСписка_ОтборыСправочников.ТипБазы 							= ?(ИспользоватьЧастнуюБазу,"Частная","Основная");
	ФормаСписка_ОтборыСправочников.НаименованиеУзла 				= Наименование;
	ФормаСписка_ОтборыСправочников.РежимОбмена 						= ДопПараметры.РежимОбмена;
	ФормаСписка_ОтборыСправочников.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиБизнесПроцессовПослеПодключения(СерверДоступен, ДопПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(Новый Структура("НастройкиБизнесПроцессов_ПользовательскиеНастройки", Ложь), ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);	
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСпискаБизнесПроцессов = ПолучитьФорму("ОФ_ФормаСписка_БизнесПроцессы", ЭтаФорма);
	#Иначе
		ФормаСпискаБизнесПроцессов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_БизнесПроцессы", , ЭтаФорма, ЭтаФорма);		
		
		ОП = Новый ОписаниеОповещения("НастройкиБизнесПроцессовПриЗакрытии", ЭтаФорма);
		ФормаСпискаБизнесПроцессов.ОписаниеОповещенияОЗакрытии = ОП;
	#КонецЕсли
	
	ФормаСпискаБизнесПроцессов.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСпискаБизнесПроцессов._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаСпискаБизнесПроцессов.ID_Узла 							= ID_Узла;
	ФормаСпискаБизнесПроцессов.НаименованиеУзла 				= Наименование;
	ФормаСпискаБизнесПроцессов.Открыть();
		
КонецПроцедуры

&НаКлиенте
Функция НастройкиБизнесПроцессовПриЗакрытии(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ID_ТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	Если ID_ТекущегоУзла <> ID_Узла Тогда
		
		// Восстановление настроек бизнес-процессов для текущего узла
		СтруктураНастроек = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(Новый Структура("НастройкиБизнесПроцессов_ПользовательскиеНастройки", Ложь), ID_ТекущегоУзла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_ТекущегоУзла);
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОкноНастройкиОбменаДокументовПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ОтборыДокументов = ПолучитьФорму("ОФ_ФормаСписка_ОтборыДокументов", ЭтаФорма);
	#Иначе
		ФормаСписка_ОтборыДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ОтборыДокументов", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
		
	ФормаСписка_ОтборыДокументов.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСписка_ОтборыДокументов._ЛокКонтекст = _ЛокКонтекст;	
	ФормаСписка_ОтборыДокументов.ID_Узла = ID_Узла;
	ФормаСписка_ОтборыДокументов.НаименованиеУзла = Наименование;
	ФормаСписка_ОтборыДокументов.ТипОбмена = ДопПараметры.ТипОбмена;
	ФормаСписка_ОтборыДокументов.ТипБазы = ?(ИспользоватьЧастнуюБазу,"Частная","Основная");
	ФормаСписка_ОтборыДокументов.Открыть();

КонецПроцедуры

