&НаКлиенте
Процедура ОбновитьТаблицуНастроекБизнесПроцессов(ID_ТекущейСтроки = "")
	
	ОтображаемыеНастройкиБизнесПроцессов.Очистить();
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	
	Если НЕ НастройкиБизнесПроцессов = Ложь И ЗначениеЗаполнено(НастройкиБизнесПроцессов)
		И НастройкиБизнесПроцессов.Количество() > 0 //И НастройкиБизнесПроцессов[0].Свойство("КолонкиТаблицыЗначений")
		Тогда	
		НомерСтроки = 0;
		Для Каждого СтрокаНастройки Из НастройкиБизнесПроцессов Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НомерСтроки = НомерСтроки+1;
			НоваяСтрока = ОтображаемыеНастройкиБизнесПроцессов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			НоваяСтрока.НомерСтроки = НомерСтроки;
			
			Если ЗначениеЗаполнено(СтрокаНастройки.ТипИсходногоДокумента1С) Тогда
				ТипИсходногоДокумента1С = СтрЗаменить(СтрокаНастройки.ТипИсходногоДокумента1С," ","");
				Если _ЛокКонтекст.СтруктураМетаданных.Документы1С.Свойство(ТипИсходногоДокумента1С) Тогда
					НоваяСтрока.ТипИсходногоДокумента1С_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С].Синоним;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаНастройки.ТипДокументаMS) Тогда
				ТипДокументаMS = СтрЗаменить(СтрокаНастройки.ТипДокументаMS," ","");
				Если _ЛокКонтекст.СтруктураМетаданных.ДокументыMS.Свойство(ТипДокументаMS) Тогда
					НоваяСтрока.ТипДокументаMS_Синоним = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Синоним;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаНастройки.ТипРезультирующегоДокумента1С) Тогда
				ТипРезультирующегоДокумента1С = СтрЗаменить(СтрокаНастройки.ТипРезультирующегоДокумента1С," ","");
				Если _ЛокКонтекст.СтруктураМетаданных.Документы1С.Свойство(ТипРезультирующегоДокумента1С) Тогда
					НоваяСтрока.ТипРезультирующегоДокумента1С_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипРезультирующегоДокумента1С].Синоним;
				КонецЕсли;
			КонецЕсли;
			Если СтрокаНастройки.Свойство("ЭтоТиповойБизнесПроцесс") И СтрокаНастройки.ЭтоТиповойБизнесПроцесс = Истина Тогда
				Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументТолькоПросмотр;		
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
				КонецЕсли;
			Иначе
				Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.Изменить;		
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаНастройки.Свойство("Доступность") И СтрокаНастройки.Доступность = Ложь Тогда
				НоваяСтрока.Недоступен = Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(ID_ТекущейСтроки) Тогда
		Отбор = Новый Структура("ID_БизнесПроцесса",ID_ТекущейСтроки);
		НайденнаяСтрока = ОтображаемыеНастройкиБизнесПроцессов.НайтиСтроки(Отбор);
		Если НайденнаяСтрока.Количество() > 0 Тогда
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущаяСтрока = НайденнаяСтрока[0];
			#Иначе
				Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущаяСтрока = НайденнаяСтрока[0].ПолучитьИдентификатор();
			#КонецЕсли
		КонецЕсли;
	КонецЕсли;
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда 
		Элементы.ОтображаемыеНастройкиБизнесПроцессов.Обновить();
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияНастройки(ЭтоНовыйБизнесПроцесс, ЭтоКопирование = Ложь, КопироватьПользовательскиеНастройки = Неопределено)
	
	ЭтоТиповойБизнесПроцесс = Ложь;	
	ПолноеЗначениеНастройки = Неопределено;
	Если НЕ ЭтоНовыйБизнесПроцесс ИЛИ ЭтоКопирование Тогда
		ТекущаяСтрока = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;
		
		Если ТекущаяСтрока = Неопределено И ЭтоКопирование Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Не выбран бизнес-процесс!';
									|en = 'The business process is not selected!'; be = 'Не абраны бізнес-працэс!'; es = 'No hay proceso de negocio seleccionado!'; ka = 'ბიზნეს პროცესი არ არის შერჩეული!'; kk = 'Бизнес-процесс таңдалмаған!'; ro = 'Procesul de afaceri nu este selectat!'; tr = 'İş süreci seçilmedi!'; uk = 'Не вибрано бізнес-процес!'; uz = 'Biznes jarayoni tanlanmagan!'");
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов,"ID_БизнесПроцесса",ТекущаяСтрока.ID_БизнесПроцесса);
		
		ПользовательскаяНастройка = Неопределено;
		ПолноеЗначениеНастройки.Свойство("ПользовательскаяНастройка", ПользовательскаяНастройка);
		
		ИспользоватьТиповыеНастройки = Неопределено;
		ПолноеЗначениеНастройки.Свойство("ИспользоватьТиповыеНастройки", ИспользоватьТиповыеНастройки);
		
		Если ЭтоКопирование
			И ПолноеЗначениеНастройки.ЭтоТиповойБизнесПроцесс 
			И ПользовательскаяНастройка = Истина 
			И ИспользоватьТиповыеНастройки <> Истина Тогда
			
			Если КопироватьПользовательскиеНастройки = Неопределено Тогда
				
				ТекстВопроса = НСтр("ru = 'Скопировать бизнес-процесс вместе с пользовательскими настройками?'");
				ОП = Новый ОписаниеОповещения("ВопросКопироватьПользовательскиеНастройкиЗавершение", ЭтаФорма);
				ПоказатьВопрос(ОП, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				Возврат;
				
			ИначеЕсли КопироватьПользовательскиеНастройки = Ложь Тогда
				
				НБП_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
				НБП_ПоУмолчанию = НБП_ПоУмолчанию.НастройкиБизнесПроцессов;
				ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НБП_ПоУмолчанию, "ID_БизнесПроцесса", ТекущаяСтрока.ID_БизнесПроцесса);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоКопирование Тогда
		ЭтоТиповойБизнесПроцесс = Ложь;
		ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(ПолноеЗначениеНастройки);
		
		МассивБП = Новый Массив;
		МассивБП.Добавить(ПолноеЗначениеНастройки);
		ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПреобразоватьБизнесПроцессыВПользовательские(МассивБП)[0];
		
	ИначеЕсли ПолноеЗначениеНастройки <> Неопределено Тогда
		ЭтоТиповойБизнесПроцесс = ПолноеЗначениеНастройки.ЭтоТиповойБизнесПроцесс;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_БизнесПроцесс = ПолучитьФорму("ОФ_ФормаНастройки_БизнесПроцесс",ЭтаФорма);
		ФормаНастройки_БизнесПроцесс.Параметры = Новый Структура("ID_Узла,ЭтоТиповойБизнесПроцесс",ID_Узла,ЭтоТиповойБизнесПроцесс);
	#Иначе
		ФормаНастройки_БизнесПроцесс = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_БизнесПроцесс",Новый Структура("ID_Узла,ЭтоТиповойБизнесПроцесс",ID_Узла,ЭтоТиповойБизнесПроцесс) , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_БизнесПроцесс.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаНастройки_БизнесПроцесс._ЛокКонтекст = _ЛокКонтекст;
	ФормаНастройки_БизнесПроцесс.НаименованиеУзла = НаименованиеУзла;
	ФормаНастройки_БизнесПроцесс.ID_Узла = ID_Узла;
	ФормаНастройки_БизнесПроцесс.ЭтоНовыйБизнесПроцесс = ЭтоНовыйБизнесПроцесс;
	
	Если ПолноеЗначениеНастройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ФормаНастройки_БизнесПроцесс, ПолноеЗначениеНастройки);
		#Если ВебКлиент Тогда
			// В веб-клиенте через ЗаполнитьЗначенияСвойств не заполняются значения экспортных переменных модуля формы. Заполним их
			Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиПолей") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаВыгрузкиПолей = ПолноеЗначениеНастройки.НастройкаВыгрузкиПолей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиТЧ") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаВыгрузкиТЧ = ПолноеЗначениеНастройки.НастройкаВыгрузкиТЧ;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиПолей") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаЗагрузкиПолей = ПолноеЗначениеНастройки.НастройкаЗагрузкиПолей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиТЧ") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаЗагрузкиТЧ = ПолноеЗначениеНастройки.НастройкаЗагрузкиТЧ;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("СвязиТабличныхЧастей") Тогда
				ФормаНастройки_БизнесПроцесс.СвязиТабличныхЧастей = ПолноеЗначениеНастройки.СвязиТабличныхЧастей;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаПредставленийРеквизитовДокумента") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаПредставленийРеквизитовДокумента = ПолноеЗначениеНастройки.НастройкаПредставленийРеквизитовДокумента;	
			КонецЕсли;
			Если ПолноеЗначениеНастройки.Свойство("НастройкаПоследовательностиБПМассивСтруктур") Тогда
				ФормаНастройки_БизнесПроцесс.НастройкаПоследовательностиБПМассивСтруктур = ПолноеЗначениеНастройки.НастройкаПоследовательностиБПМассивСтруктур;	
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	Если ПолноеЗначениеНастройки = Неопределено 
		ИЛИ ПолноеЗначениеНастройки.ЗаписыватьДокументПослеЗагрузки = Ложь Тогда
		ФормаНастройки_БизнесПроцесс.ЗаписыватьДокументПослеЗагрузки = "НеЗаписывать";
	ИначеЕсли ПолноеЗначениеНастройки.ЗаписыватьДокументПослеЗагрузки = Истина Тогда
		ФормаНастройки_БизнесПроцесс.ЗаписыватьДокументПослеЗагрузки = "Всегда";
	КонецЕсли;
	
	Если ЭтоКопирование Тогда
		ФормаНастройки_БизнесПроцесс.Название = "(Копия) "+ФормаНастройки_БизнесПроцесс.Название;
	ИначеЕсли ЭтоНовыйБизнесПроцесс Тогда
		ФормаНастройки_БизнесПроцесс.Название = "НОВЫЙ БИЗНЕС-ПРОЦЕСС";
	КонецЕсли;
	ФормаНастройки_БизнесПроцесс.ЭтоТиповойБизнесПроцесс = ЭтоТиповойБизнесПроцесс;
	ОП = Новый ОписаниеОповещения("ФормаНастройки_БизнесПроцессЗакрытие",ЭтаФорма,ТекущаяСтрока);
	ФормаНастройки_БизнесПроцесс.ОписаниеОповещенияОЗакрытии = ОП;
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РезультатРедактирования = ФормаНастройки_БизнесПроцесс.ОткрытьМодально();
		ВыполнитьОбработкуОповещения(ОП,РезультатРедактирования);
	#Иначе
		ФормаНастройки_БизнесПроцесс.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки)

	// 1. Для текущей строки БП узнать, типовой это БП или нет
	// 2. Если типовой, тогда получить из кэша пользовательские настройки этого БП по ID, изменить у него соотв-щий флаг и записать настройки в базу и в кэш
	// 3. Если пользовательский БП, тогда получить из кэша пользовательские БП, найти нужный по ID, изменить у него соотв-щий флаг и записать настройки в базу и в кэш
	// 4. Собрать общую структуру БП и выгрузить их в базу
				
	ТекущаяСтрока = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;	
		
	Если ТекущаяСтрока.ЭтоТиповойБизнесПроцесс 
		ИЛИ ЗначениеЗаполнено(ID_Узла) Тогда
						
		СтруктураНастроекБизнесПроцессов_ПоУмолчанию 				= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
			
		НастройкиБизнесПроцессов_ПоУмолчанию 				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
		НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;	
			
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) <> Тип("Массив") ИЛИ НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки.Количество() Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
			НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
		КонецЕсли;	
			
		Отбор = Новый Структура("ID_БизнесПроцесса",ТекущаяСтрока.ID_БизнесПроцесса);
		Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_ПользовательскиеНастройки,Отбор);
		Если Результат = Неопределено Тогда				
			СтруктураНастройки = Новый Структура;
			СтруктураНастройки.Вставить("ID_БизнесПроцесса", ТекущаяСтрока.ID_БизнесПроцесса);
			СтруктураНастройки.Вставить(ИмяНастройки, ЗначениеНастройки);
			НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(СтруктураНастройки);	
		Иначе
			Результат[0].Вставить(ИмяНастройки, ЗначениеНастройки);
		КонецЕсли;		
			
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
					
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		
	Иначе	
			
		СтруктураНастроекБизнесПроцессов_Пользовательские 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();
		НастройкиБизнесПроцессов_Пользовательские 			= СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов;

		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Массив") Тогда						
			Отбор = Новый Структура("ID_БизнесПроцесса",ТекущаяСтрока.ID_БизнесПроцесса);
			Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_Пользовательские,Отбор);
			Если Результат <> Неопределено Тогда				
				Результат[0].Вставить(ИмяНастройки, ЗначениеНастройки);
			КонецЕсли;
				
			СтруктураНастроекБизнесПроцессов_Пользовательские = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_Пользовательские, 
				_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
				
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, ID_Узла);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
		КонецЕсли;		
			
	КонецЕсли; 
		
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
	ВыгрузитьБизнесПроцессыВБазуSMARTS(ТекущаяСтрока.ID_БизнесПроцесса);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеФлагаИспользуется(Значение)
	
	Если ОтображаемыеНастройкиБизнесПроцессов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// 1. получить пользовательские настройки, если их нет, создать новый массив
	// 2. пройтись по всем типовым: 
	// 		если для типового есть пользовательская настройка, то у нее установить значение флага "Используется"
	// 		если нет пользовательской настройки, то создать ее и установить значение флага "Используется"
	// 3. потом всю таблицу пользовательских настроек сохранить в базу и в кэш
	// 4. для пользовательских БП просто в цикле пройтись, установить значение флага "Используется", сохранить в базу и в кэш
	// 5. В отображаемой на форме таблице БП изменить значения флагов				
	
	
	СтруктураНастроекБизнесПроцессов_Пользовательские 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();
	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 				= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	
	НастройкиБизнесПроцессов_Пользовательские 			= СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_ПоУмолчанию 				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;	
	
	ИзмененыНастройки_Пользовательские 			= Ложь;
	ИзмененыНастройки_ПользовательскиеНастройки = Ложь;
	
	Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) <> Тип("Массив") ИЛИ НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки.Количество() Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
			НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
		КонецЕсли;
		
        Для Каждого СтрокаНастройки Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда				
				Продолжить;
			КонецЕсли;
						
			Отбор = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
			Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Отбор);
			Если Результат = Неопределено Тогда				
				СтруктураНастройки = Новый Структура;
				СтруктураНастройки.Вставить("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				СтруктураНастройки.Вставить("Используется", 	 Значение);
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(СтруктураНастройки);	
			Иначе
				Результат[0].Вставить("Используется", Значение);
			КонецЕсли;		
		КонецЦикла;
		
		ИзмененыНастройки_ПользовательскиеНастройки = Истина;
	КонецЕсли;

	Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Массив") Тогда		
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) <> Тип("Массив") ИЛИ НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки.Количество() Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
			КонецЕсли;
			ИзмененыНастройки_ПользовательскиеНастройки = Истина;
		Иначе
			ИзмененыНастройки_Пользовательские = Истина;	
		КонецЕсли;
		
		Для каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов_Пользовательские Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда			
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ID_Узла) Тогда
				Отбор = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				Результат = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Отбор);
				Если Результат = Неопределено Тогда				
					СтруктураНастройки = Новый Структура;
					СтруктураНастройки.Вставить("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
					СтруктураНастройки.Вставить("Используется", 	 Значение);
					НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(СтруктураНастройки);	
				Иначе
					Результат[0].Вставить("Используется", Значение);
				КонецЕсли;	
			Иначе	
				СтрокаНастройки.Используется = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИзмененыНастройки_ПользовательскиеНастройки Тогда
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
			
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	 СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);	
	КонецЕсли;
	
	Если ИзмененыНастройки_Пользовательские Тогда
		СтруктураНастроекБизнесПроцессов_Пользовательские = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_Пользовательские, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
			
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
    КонецЕсли;
	
	Для каждого СтрокаНастройки Из ОтображаемыеНастройкиБизнесПроцессов Цикл
		СтрокаНастройки.Используется = Значение;			
	КонецЦикла; 			
	
	ID_ТекущейСтроки = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные.ID_БизнесПроцесса;
	
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);	
	
	ВыгрузитьБизнесПроцессыВБазуSMARTS(ID_ТекущейСтроки);                                   	
	
КонецПроцедуры

&НаСервере
Функция ИмяТекущейКолонкиТаблицы()

	ИмяКолонки = "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ЗначениеЗаполнено(ТекущийЭлемент.ТекущаяКолонка.ДанныеФлажка) Тогда
			ИмяКолонки = ТекущийЭлемент.ТекущаяКолонка.ДанныеФлажка;
		ИначеЕсли ЗначениеЗаполнено(ТекущийЭлемент.ТекущаяКолонка.Данные) Тогда
			ИмяКолонки = ТекущийЭлемент.ТекущаяКолонка.Данные;
		КонецЕсли;	
	#Иначе				
		ПутьКДаннымТаблицы = ТекущийЭлемент.ПутьКДанным;
		ПутьКДаннымКолонкиВТаблице = ТекущийЭлемент.ТекущийЭлемент.ПутьКДанным;	
		ИмяКолонки = Прав(ПутьКДаннымКолонкиВТаблице, СтрДлина(ПутьКДаннымКолонкиВТаблице) - СтрДлина(ПутьКДаннымТаблицы) - 1);	
	#КонецЕсли	

	Возврат ИмяКолонки;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьБизнесПроцессыВБазуSMARTS(ID_ТекущейСтроки = "") Экспорт

	ОП = Новый ОписаниеОповещения("ВыгрузитьБизнесПроцессыПослеПодключения",ЭтаФорма, ID_ТекущейСтроки);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,,ОП);	

КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтборыДляУдаленныхБизнесПроцессов(ID_БизнесПроцесса = Неопределено)

	_ЛокКонтекст.ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОтборыДляДобавленныхБизнесПроцессов()

	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда
		Возврат;
	КонецЕсли;
	Если НЕ НастройкиБизнесПроцессов.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		НастройкиОтборов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
		Если НастройкиОтборов = Неопределено ИЛИ НастройкиОтборов = Ложь Тогда
			// Если настроек отборов нет, формируем новый массив структур
			НастройкиОтборов = Новый Массив;
			
			ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + РежимОбмена];
			ПеречислениеКолонок = "";
			Для Каждого Свойство Из ШаблонНастройки Цикл
				ПеречислениеКолонок = ПеречислениеКолонок + ?(ПеречислениеКолонок = "", "", ",") + Свойство.Ключ;
			КонецЦикла;
			СтрокаОписания = Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, ПеречислениеКолонок);
			
			НастройкиОтборов.Вставить(0, СтрокаОписания);
		КонецЕсли;
		
		НужноСохранить = Ложь;
		
		Для каждого НастройкаБП ИЗ НастройкиБизнесПроцессов Цикл
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений")	Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ НастройкаБП.Свойство("ТипИсходногоДокумента1С")
				ИЛИ НЕ ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) Тогда
				Продолжить;
			КонецЕсли;
			
			// Если бизнес-процесс не включен, создавать отсутствующую настройку по умолчанию не нужно
			Если НЕ НастройкаБП.Используется Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", НастройкаБП.ID_БизнесПроцесса);
			
			МассивНастроекОтбора = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборов, СтруктураОтбора);
			Если МассивНастроекОтбора = Неопределено Тогда
				СтрокаНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
				Если СтрокаНастройки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				НастройкиОтборов.Добавить(СтрокаНастройки);
				НужноСохранить = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НужноСохранить	Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов, ID_Узла);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросПослеПроверкиБизнесПроцессов(ОписаниеОповещения, ТипДокументаMS = "")
	
	Если ЗначениеЗаполнено(ТипДокументаMS) Тогда
		ТекстВопроса = НСтр("ru = 'Документ ""%1"" отсутствует в метаданных Клеверенс. Продолжить?';
								|en = 'The document ""%1"" is missing from the Cleverence metadata. Continue?';
								|be = 'Дакумент"" %1 "" адсутнічае ў метададзеных Cleverence. Працягнуць?'; es = 'El documento ""%1"" no se encuentra en los metadatos de Cleverence. ¿Continuar?'; ka = 'დოკუმენტი ""%1 "" არ არის კლევერენციის მეტამონაცემებში. გაგრძელება?'; kk = '""%1"" құжаты Cleverence метадеректерінде жоқ. Жалғастыру?'; ro = 'Documentul ""%1 "" lipsește din metadatele Cleverence. Continuați?'; tr = 'Cleverence meta verilerinde ""%1"" belgesi eksik. Devam etmek mi?'; uk = 'Документ ""%1 "" відсутній у метаданих Cleverence. Продовжити?'; uz = '""%1 "" hujjati Cleverence metama''lumotlarida mavjud emas. Davom etasizmi?'");
		ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТипДокументаMS);
	Иначе
		ТекстВопроса = НСтр("ru = 'Не заполнен документ Клеверенс. Продолжить?';
								|en = 'The Cleverence document is incomplete. Continue?'; be = 'Не запоўнены дакумент Cleverence. Працягнуць?'; es = 'No se ha completado el documento Cleverence. ¿Continuar?'; ka = 'კლევერენციის დოკუმენტი არასრულია. გაგრძელება?'; kk = 'Cleverence құжаты толтырылмаған. Жалғастыру?'; ro = 'Documentul Cleverence este incomplet. Continuați?'; tr = 'Cleverence belgesi dolu değil. Devam etmek mi?'; uk = 'Не заповнений документ Cleverence. Продовжити?'; uz = 'Cleverence hujjati to''liq emas. Davom etasizmi?'");
	КонецЕсли;
				
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS(ПроверятьИспользование = Истина)

	НекорректныеБизнесПроцессы = Новый Массив;
	
	СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
	
	Если НЕ ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		И СтруктураМетаданных.Свойство("ДокументыMS") Тогда
		// Проверку выполнять не будем
		Возврат НекорректныеБизнесПроцессы;
	КонецЕсли;
	
	Для каждого СтрокаНастройки ИЗ ОтображаемыеНастройкиБизнесПроцессов Цикл
		Если ПроверятьИспользование
			И НЕ СтрокаНастройки.Используется Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьДокументMS = ЗначениеЗаполнено(СтрокаНастройки.ТипДокументаMS)
			И СтруктураМетаданных.ДокументыMS.Свойство(СтрокаНастройки.ТипДокументаMS);
		
		Если НЕ ЕстьДокументMS Тогда
			НекорректныеБизнесПроцессы.Добавить(СтрокаНастройки.Название);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НекорректныеБизнесПроцессы;
	
КонецФункции

&НаКлиенте
Процедура УдалитьПользовательскуюНастройку(ID_БизнесПроцесса)

	СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	
	Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Массив") Тогда
		Индекс = 0;
		Для каждого Настройка ИЗ НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если Настройка.Свойство("ID_БизнесПроцесса") И Настройка.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Удалить(Индекс);		
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		

		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	 СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);	
	КонецЕсли;
	
	ВыгрузитьБизнесПроцессыВБазуSMARTS("");	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУсловногоОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ГруппаОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтображаемыеНастройкиБизнесПроцессов.ТипРезультирующегоДокумента1С");
	ЭлементОтбора.ВидСравнения	 = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтображаемыеНастройкиБизнесПроцессов.ВыполнитьТолькоПроизвольныйКод");
	ЭлементОтбора.ВидСравнения	 = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОтображаемыеНастройкиБизнесПроцессовТипРезультирующегоДокумента1С_Синоним");
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", 		"Не используется");
	
	
	ЭлементУсловногоОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтображаемыеНастройкиБизнесПроцессов.Недоступен");
	ЭлементОтбора.ВидСравнения	 = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	КолонкиТаблицы = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ПодчиненныеЭлементы;
	Для каждого КолонкаТаблицы ИЗ КолонкиТаблицы Цикл 
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(КолонкаТаблицы.Имя);
	КонецЦикла;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ВосстановитьНастройкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", ID_Узла);		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", Ложь);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
		
		_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_Интерактивный", ID_Узла);		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_Интерактивный", Ложь);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруОтборов("Интерактивный", ID_Узла);
		
		_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_Онлайн", ID_Узла);		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_Онлайн", Ложь);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруОтборов("Онлайн", ID_Узла);
			
		ЕстьОтключенныеБизнесПроцессы = _ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
		Если ЕстьОтключенныеБизнесПроцессы Тогда
			ОбновитьТаблицуНастроекБизнесПроцессов();
		Иначе
			ВыгрузитьБизнесПроцессыВБазуSMARTS(); // Отключенные бизнес-процессы были выгружены в базу в момент отключения
		КонецЕсли;
	Иначе	
		
		СтруктураНастроекБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовПоУмолчаниюНаСервереSMARTS();		
		НастройкиБизнесПроцессовПоУмолчанию = СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
		
		Если НастройкиБизнесПроцессовПоУмолчанию <> Неопределено Тогда
			Если ТипЗнч(НастройкиБизнесПроцессовПоУмолчанию) = Тип("Строка") Тогда
				НастройкиБизнесПроцессовПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессовПоУмолчанию,Истина);
			КонецЕсли;
			
			СтруктураНастроекБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессовПоУмолчанию, 
				_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
			
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПоУмолчанию", 				СтруктураНастроекБизнесПроцессов_ПоУмолчанию);
			_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки");
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки",	Ложь);
			_ЛокКонтекст.ЛокЯдро_УдалитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские");
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские",			Ложь);
			
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
			
			//Выполним обновление - Начало
			пСтруктураНастроек = Новый Структура("ВерсияОбработкиНастроек",Неопределено);
			пСтруктураНастроек = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(пСтруктураНастроек);
			ВерсияОбработкиНастроек = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ВерсияОбработкиКлеверенсТСД");
			пСтруктураНастроек.Вставить("ВерсияОбработкиКлеверенсТСД",ВерсияОбработкиНастроек);
			
			// Дополняем передаваемую структуру настроек настройками по-умолчанию
			СтруктураНастроек_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьСтруктуруНастроекБизнесПроцессовПоУмолчаниюНаСервереSMARTS();
			пСтруктураНастроек.Вставить("ВерсияНастроек_ПоУмолчанию", СтруктураНастроек_ПоУмолчанию.ВерсияНастроек);
		
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция"); 
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеСтруктурыНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("пСтруктураНастроек", пСтруктураНастроек));
			
			СтруктураИзменений = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,_ЛокКонтекст.АдресаПеременных,2);
			
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураИзменений.ИзменениеВНастройках);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураИзменений.ИзмененияВКэше);
			_ЛокКонтекст.ЛокЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураИзменений.ИзмененияКэшируемыхНастроек, ID_Узла);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураИзменений.ИзмененияКэшируемыхНастроек);
			//Выполним обновление - Конец
			
			_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
			
			УдалитьОтборыДляУдаленныхБизнесПроцессов();
			ДобавитьОтборыДляДобавленныхБизнесПроцессов();
			
			ЕстьОтключенныеБизнесПроцессы = _ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
			Если ЕстьОтключенныеБизнесПроцессы Тогда
				ОбновитьТаблицуНастроекБизнесПроцессов();
			Иначе
				ВыгрузитьБизнесПроцессыВБазуSMARTS(); // Отключенные бизнес-процессы были выгружены в базу в момент отключения
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУдалитьПользовательскуюНастройкуЗавершение(РезультатВопроса, ТекущиеДанные) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	
	ID_БизнесПроцесса = ТекущиеДанные.ID_БизнесПроцесса;
	
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	НастройкиБизнесПроцессов_ПоУмолчанию 		 = СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	НастройкаБизнесПроцесса_ПоУмолчанию 		 = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессов_ПоУмолчанию, "ID_БизнесПроцесса", ID_БизнесПроцесса);
	
	Если ТипЗнч(НастройкаБизнесПроцесса_ПоУмолчанию) = Тип("Структура")
		И НастройкаБизнесПроцесса_ПоУмолчанию.Свойство("Используется")
		И НастройкаБизнесПроцесса_ПоУмолчанию.Используется Тогда
		
		СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
		
		ЕстьДокументMS = ЗначениеЗаполнено(ТекущиеДанные.ТипДокументаMS)
			И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("ДокументыMS")
			И СтруктураМетаданных.ДокументыMS.Свойство(ТекущиеДанные.ТипДокументаMS);
					
		Если ЕстьДокументMS Тогда
			УдалитьПользовательскуюНастройку(ID_БизнесПроцесса);
		Иначе	
			ДопПараметры = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
			ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьПользовательскуюНастройкуПослеОтветаНаВопрос", ЭтаФорма, ДопПараметры);
					
			ПоказатьВопросПослеПроверкиБизнесПроцессов(ОписаниеОповещения, ТекущиеДанные.ТипДокументаMS);
		КонецЕсли;		
		
	Иначе
		УдалитьПользовательскуюНастройку(ID_БизнесПроцесса);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ВопросУдалитьНастройкуЗавершение(РезультатВопроса, ТекущиеДанные) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	ID_ТекущегоБизнесПроцесса = ТекущиеДанные.ID_БизнесПроцесса;
	
	Отбор = Новый Структура("ID_БизнесПроцесса",ID_ТекущегоБизнесПроцесса);
	НайденнаяСтрока = ОтображаемыеНастройкиБизнесПроцессов.НайтиСтроки(Отбор);
	Если НайденнаяСтрока.Количество() > 0 Тогда
		СтрокаНастройкиБП = НайденнаяСтрока[0];
	Иначе
		СтрокаНастройкиБП = Неопределено;
	КонецЕсли;
	
	Если СтрокаНастройкиБП <> Неопределено Тогда
		
		СтруктураНастроекБизнесПроцессов_Пользовательские 			= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
		
		НастройкиБизнесПроцессов_Пользовательские 			= СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов;
		НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
		
		ОтображаемыеНастройкиБизнесПроцессов.Удалить(ТекущиеДанные);
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Массив") Тогда
			Индекс = 0;
			Для Каждого СтрокаНастройки Из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Индекс = Индекс+1;
					Продолжить;
				КонецЕсли;
				Если СтрокаНастройки.ID_БизнесПроцесса = ID_ТекущегоБизнесПроцесса Тогда
					НастройкиБизнесПроцессов_ПользовательскиеНастройки.Удалить(Индекс);	
					Прервать;	
				КонецЕсли;
				Индекс = Индекс+1;
			КонецЦикла;
			
			СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
				_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
				
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	 СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		КонецЕсли;
		
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Массив") Тогда
			Индекс = 0;
			Для Каждого СтрокаНастройки Из НастройкиБизнесПроцессов_Пользовательские Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Индекс = Индекс+1;
					Продолжить;
				КонецЕсли;
				Если СтрокаНастройки.ID_БизнесПроцесса = ID_ТекущегоБизнесПроцесса Тогда
					НастройкиБизнесПроцессов_Пользовательские.Удалить(Индекс);	
					Прервать;	
				КонецЕсли;
				Индекс = Индекс+1;
			КонецЦикла;
			
			СтруктураНастроекБизнесПроцессов_Пользовательские = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_Пользовательские, 
				_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
				
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, ID_Узла);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");	
		КонецЕсли;
		
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
		ВыгрузитьБизнесПроцессыВБазуSMARTS("");
		
		УдалитьОтборыДляУдаленныхБизнесПроцессов(ID_ТекущегоБизнесПроцесса);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_БизнесПроцессЗакрытие(РезультатНастройки,СтрокаНастройки) Экспорт
	
	Если ЗначениеЗаполнено(РезультатНастройки) Тогда
		Копирование = Ложь;
		Если ТипЗнч(РезультатНастройки) = Тип("Строка") Тогда
			ID_РедактируемогоБП = РезультатНастройки;
		ИначеЕсли ТипЗнч(РезультатНастройки) = Тип("Структура") Тогда
			ID_РедактируемогоБП = РезультатНастройки.ID_РедактируемогоБП;
			Копирование = РезультатНастройки.Копирование;
		КонецЕсли;
		ОбновитьТаблицуНастроекБизнесПроцессов(ID_РедактируемогоБП);
		Если Копирование Тогда
			ОткрытьФормуРедактированияНастройки(Истина,Истина);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьБизнесПроцессыПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	ОбновитьТаблицуНастроекБизнесПроцессов(ДопПараметры);
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов, ID_Узла);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросКопироватьПользовательскиеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОткрытьФормуРедактированияНастройки(Истина, Истина, Истина);
	Иначе
		ОткрытьФормуРедактированияНастройки(Истина, Истина, Ложь);
	КонецЕсли;
	
КонецПроцедуры 


&НаКлиенте
Процедура УстановитьЗначениеНастройкиВТекущейСтрокеПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

	ИмяНастройки 	  = ДополнительныеПараметры.ИмяНастройки;
	ЗначениеНастройки = ДополнительныеПараметры.ЗначениеНастройки;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки);
	Иначе
		ТекущаяСтрока = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;
		ТекущаяСтрока[ИмяНастройки] = НЕ ЗначениеНастройки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеФлагаИспользуетсяПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УстановитьЗначениеФлагаИспользуется(Истина);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользовательскуюНастройкуПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УдалитьПользовательскуюНастройку(ДополнительныеПараметры.ID_БизнесПроцесса);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
Процедура ОтображаемыеНастройкиБизнесПроцессовПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	
	ОформлениеСтроки.Ячейки.Картинка.ОтображатьКартинку = Истина;
	ОформлениеСтроки.Ячейки.Картинка.ОтображатьТекст = Ложь;
	Если ДанныеСтроки.ЭтоТиповойБизнесПроцесс = Истина Тогда
		Если ДанныеСтроки.ПользовательскаяНастройка = Истина Тогда
			ОформлениеСтроки.Ячейки.Картинка.Картинка = БиблиотекаКартинок.ТабличныйДокументТолькоПросмотр;		
		Иначе
			ОформлениеСтроки.Ячейки.Картинка.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
		КонецЕсли;
		ОформлениеСтроки.Ячейки.ЗагружатьВТотЖе.ТолькоПросмотр = Истина;
		ОформлениеСтроки.Ячейки.СоздаватьНовыйДокументПриЗагрузке.ТолькоПросмотр = Истина;
	Иначе
		Если ДанныеСтроки.ПользовательскаяНастройка = Истина Тогда
			ОформлениеСтроки.Ячейки.Картинка.Картинка = БиблиотекаКартинок.Изменить;		
		Иначе
			ОформлениеСтроки.Ячейки.Картинка.Картинка = БиблиотекаКартинок.Пользователь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ТипРезультирующегоДокумента1С)
		И ДанныеСтроки.ВыполнитьТолькоПроизвольныйКод = Истина Тогда
		ОформлениеСтроки.Ячейки.ТипРезультирующегоДокумента1С_Синоним.ЦветТекста = WebЦвета.Серый;
		ОформлениеСтроки.Ячейки.ТипРезультирующегоДокумента1С_Синоним.Текст		 = "Не используется";
	КонецЕсли;
	
КонецПроцедуры

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли