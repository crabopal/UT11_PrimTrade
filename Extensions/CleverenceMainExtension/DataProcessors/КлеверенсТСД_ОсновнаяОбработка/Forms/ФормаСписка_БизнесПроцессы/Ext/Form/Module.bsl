/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем НастройкиБизнесПроцессов Экспорт;

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ?(ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла), " """+ ЭтаФорма.НаименованиеУзла +"""","");
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;
		 
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			
			Элементы.ОтображаемыеНастройкиБизнесПроцессовДобавить.Видимость = Ложь;
			Элементы.ОтображаемыеНастройкиБизнесПроцессовСкопировать.Видимость = Ложь;
		КонецЕсли;
	#Иначе
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.КоманднаяПанельОтображаемыеНастройкиБизнесПроцессов.Кнопки.ОтображаемыеНастройкиБизнесПроцессовДобавить.Доступность = Ложь;
			Элементы.КоманднаяПанельОтображаемыеНастройкиБизнесПроцессов.Кнопки.ОтображаемыеНастройкиБизнесПроцессовСкопировать.Доступность = Ложь;
		КонецЕсли;
	#КонецЕсли
	
	ОбновитьТаблицуНастроекБизнесПроцессов();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		УстановитьУсловноеОформление();
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)	
	Отказ = Истина;     
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		Сообщение = НСтр("ru = 'Добавление бизнес процессов доступно только для главного торгового объекта';
							|en = 'Adding business processes is only available for the main shopping facility';
							|be = 'Даданне бізнес працэсаў даступна толькі для галоўнага гандлёвага аб''екта'; es = 'La adición de procesos de negocio solo está disponible para el centro comercial principal'; ka = 'ბიზნეს პროცესების დამატება მხოლოდ მთავარი სავაჭრო ობიექტისთვის არის შესაძლებელი'; kk = 'Бизнес процестерді қосу тек негізгі сауда объектісі үшін қол жетімді'; ro = 'Adăugarea proceselor de afaceri este disponibilă numai pentru unitatea principală de cumpărături'; tr = 'İş süreçlerinin eklenmesi yalnızca ana ticaret tesisi için geçerlidir'; uk = 'Додавання бізнес процесів доступно тільки для головного торгового об''єкта'; uz = 'Biznes-jarayonlarni qo''shish faqat asosiy savdo ob''ekti uchun mavjud'");
		Сообщить(Сообщение); 	
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуРедактированияНастройки(Истина, Копирование);
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередНачаломИзменения(Элемент, Отказ)	
	
	ИмяНастройки = ИмяТекущейКолонкиТаблицы();	
	
	Если ИмяНастройки <> "Используется"
		И ИмяНастройки <> "ЗагружатьВТотЖе" Тогда
		
		Отказ = Истина;
		ОткрытьФормуРедактированияНастройки(Ложь);
	
	Иначе
		
		ТекущаяСтрока = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;	
		ЗначениеНастройки = НЕ ТекущаяСтрока[ИмяНастройки]; // Берем противоположное значение, т.к. в этом обработчике значение еще не изменилось
		
		Если ИмяНастройки = "Используется"
			И ЗначениеНастройки = Истина Тогда
			
			СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
			ЕстьДокументMS = ЗначениеЗаполнено(ТекущаяСтрока.ТипДокументаMS)
				И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
				И СтруктураМетаданных.Свойство("ДокументыMS")
				И СтруктураМетаданных.ДокументыMS.Свойство(ТекущаяСтрока.ТипДокументаMS);
				
			Если ЕстьДокументMS Тогда
				УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки);
			Иначе	
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("ИмяНастройки",	   ИмяНастройки);
				ДопПараметры.Вставить("ЗначениеНастройки", ЗначениеНастройки);
				ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьЗначениеНастройкиВТекущейСтрокеПослеОтветаНаВопрос", ЭтаФорма, ДопПараметры);
				
				ПоказатьВопросПослеПроверкиБизнесПроцессов(ОписаниеОповещения, ТекущаяСтрока.ТипДокументаMS);
			КонецЕсли;
			
		Иначе
			УстановитьЗначениеНастройкиВТекущейСтроке(ИмяНастройки, ЗначениеНастройки);
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ОтображаемыеНастройкиБизнесПроцессов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда		
		Возврат;
	КонецЕсли;                     
	Отказ = Истина;
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		Если НЕ ТекущиеДанные.ПользовательскаяНастройка Тогда
			Сообщение = НСтр("ru = 'Удаление бизнес процессов доступно только для главного торгового объекта';
								|en = 'Deleting business processes is only available for the main shopping facility';
								|be = 'Выдаленне бізнес працэсаў даступна толькі для галоўнага гандлёвага аб''екта'; es = 'La eliminación de procesos de negocio solo está disponible para el centro comercial principal'; ka = 'ბიზნეს პროცესების წაშლა მხოლოდ მთავარი სავაჭრო ობიექტისთვის არის შესაძლებელი'; kk = 'Бизнес процестерді жою тек негізгі сауда объектісі үшін қол жетімді'; ro = 'Ștergerea proceselor de afaceri este disponibilă numai pentru unitatea principală de cumpărături'; tr = 'İş süreçlerinin silinmesi yalnızca ana ticaret tesisi için geçerlidir'; uk = 'Видалення бізнес процесів доступно тільки для головного торгового об''єкта'; uz = 'Biznes jarayonlarini olib tashlash faqat asosiy savdo ob''ekti uchun mavjud'");
			Сообщить(Сообщение); 
		Иначе
			ТекстВопроса = НСтр("ru = 'Вы действительно хотите удалить пользовательскую настройку и вернуть исходное значение бизнес-процесса ""%1""?';
									|en = 'Do you really want to remove the custom setting and return to the original business process value ""%1""?';
									|be = 'Вы сапраўды хочаце выдаліць карыстацкую наладу і вярнуць зыходнае значэнне бізнес-працэсу ""%1""?'; es = '¿Realmente desea eliminar la configuración personalizada y devolver el valor original del proceso comercial ""%1""?'; ka = 'ნამდვილად გსურთ წაშალოთ საბაჟო პარამეტრი და დაუბრუნდეთ თავდაპირველ ბიზნეს პროცესის ღირებულებას ""%1""?'; kk = 'Сіз шынымен теңшелетін параметрді жойып, ""%1 "" бизнес-процесінің бастапқы мәнін қайтарғыңыз келе ме?'; ro = 'Chiar doriți să eliminați setarea personalizată și să reveniți la valoarea inițială a procesului de afaceri ""%1""?'; tr = 'Gerçekten kullanıcı ayarını kaldırmak ve iş sürecinin orijinal değeri olan ""%1"" i döndürmek mi istiyorsunuz?'; uk = 'Ви дійсно хочете видалити налаштування користувача та повернути початкове значення бізнес-процесу ""%1""?'; uz = 'Siz haqiqatan ham maxsus sozlamani olib tashlashni va ""%1 "" biznes jarayonining asl qiymatini qaytarishni xohlaysizmi?'");
			ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьПользовательскуюНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоТиповойБизнесПроцесс = Истина Тогда
		Если НЕ ТекущиеДанные.ПользовательскаяНастройка Тогда
			Сообщение = НСтр("ru = 'Удаление типовых бизнес процессов запрещено';
								|en = 'Deleting typical business processes is prohibited'; be = 'Выдаленне тыпавых бізнес працэсаў забаронена'; es = 'No se permite la eliminación de procesos empresariales típicos'; ka = 'აკრძალულია ტიპიური ბიზნეს პროცესების წაშლა'; kk = 'Типтік бизнес процестерді жоюға тыйым салынады'; ro = 'Ștergerea proceselor tipice de afaceri este interzisă'; tr = 'Tipik iş süreçlerinin kaldırılması yasaktır'; uk = 'Видалення типових бізнес процесів заборонено'; uz = 'Oddiy biznes jarayonlarini olib tashlash taqiqlanadi'");
			Сообщить(Сообщение); 
		Иначе
			ТекстВопроса = НСтр("ru = 'Вы действительно хотите удалить пользовательскую настройку и вернуть исходное значение бизнес-процесса ""%1""?';
									|en = 'Do you really want to remove the custom setting and return to the original business process value ""%1""?';
									|be = 'Вы сапраўды хочаце выдаліць карыстацкую наладу і вярнуць зыходнае значэнне бізнес-працэсу ""%1""?'; es = '¿Realmente desea eliminar la configuración personalizada y devolver el valor original del proceso comercial ""%1""?'; ka = 'ნამდვილად გსურთ წაშალოთ საბაჟო პარამეტრი და დაუბრუნდეთ თავდაპირველ ბიზნეს პროცესის ღირებულებას ""%1""?'; kk = 'Сіз шынымен теңшелетін параметрді жойып, ""%1 "" бизнес-процесінің бастапқы мәнін қайтарғыңыз келе ме?'; ro = 'Chiar doriți să eliminați setarea personalizată și să reveniți la valoarea inițială a procesului de afaceri ""%1""?'; tr = 'Gerçekten kullanıcı ayarını kaldırmak ve iş sürecinin orijinal değeri olan ""%1"" i döndürmek mi istiyorsunuz?'; uk = 'Ви дійсно хочете видалити налаштування користувача та повернути початкове значення бізнес-процесу ""%1""?'; uz = 'Siz haqiqatan ham maxsus sozlamani olib tashlashni va ""%1 "" biznes jarayonining asl qiymatini qaytarishni xohlaysizmi?'");
			ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьПользовательскуюНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
	ТекстВопроса = НСтр("ru = 'Вы действительно хотите удалить настройку бизнес-процесса ""%1""?';
							|en = 'Do you really want to remove the ""%1"" business process setting?';
							|be = 'Вы сапраўды хочаце выдаліць наладу бізнес-працэсу ""%1""?'; es = '¿De verdad desea eliminar la configuración del proceso de negocio ""%1""?'; ka = 'ნამდვილად გსურთ წაშალოთ"" %1 "" ბიზნეს პროცესის პარამეტრი?'; kk = 'Сіз шынымен ""%1 "" бизнес-процесс параметрін жойғыңыз келе ме?'; ro = 'Chiar doriți să eliminați setarea"" %1 "" business process?'; tr = '""%1"" iş süreci ayarını gerçekten kaldırmak istiyor musunuz?'; uk = 'Ви дійсно хочете видалити Налаштування бізнес-процесу ""%1""?'; uz = 'Siz haqiqatan ham ""%1 "" biznes jarayoni sozlamalarini olib tashlamoqchimisiz?'");
	ТекстВопроса = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстВопроса, ТекущиеДанные.Название);
			
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУдалитьНастройкуЗавершение", ЭтаФорма, ТекущиеДанные);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеНастройкиБизнесПроцессовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуРедактированияНастройки(Ложь);
КонецПроцедуры

&НаКлиенте 
Функция ПолучитьТаблицуНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек, ИмяНастройки)
	
	НастройкиБизнесПроцессов = СтруктураНастроек[ИмяНастройки];			
	Если ТипЗнч(НастройкиБизнесПроцессов) = Тип("Строка") Тогда
		НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов, Истина);	
	КонецЕсли;	                                         				
	
	Возврат НастройкиБизнесПроцессов;
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьНастройки(Команда)
	ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ВосстановитьНастройкиЗавершение", ЭтаФорма);
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		ТекстВопроса = НСтр("ru = 'Текущие настройки торгового объекта будут утеряны! Типовые и пользовательские бизнес процессы останутся без изменения. Продолжить?';
								|en = 'The current settings of the shopping facility will be lost! Standard and custom business processes will remain unchanged. Continue?';
								|be = 'Бягучыя налады гандлёвага аб''екта будуць згубленыя! Тыпавыя і прыстасаваныя бізнес працэсы застануцца без змены. Працягнуць?'; es = '¡La configuración actual del objeto comercial se perderá! Los procesos de negocio estándar y personalizados permanecerán sin cambios. ¿Continuar?'; ka = 'სავაჭრო ობიექტის მიმდინარე პარამეტრები დაიკარგება! სტანდარტული და საბაჟო ბიზნეს პროცესები უცვლელი დარჩება. გაგრძელება?'; kk = 'Ағымдағы сауда орнының параметрлері жоғалады! Типтік және пайдаланушылық бизнес-процестер өзгеріссіз қалады. Жалғастыру?'; ro = 'Setările actuale ale facilității de cumpărături vor fi pierdute! Procesele de afaceri Standard și personalizate vor rămâne neschimbate. Continuați?'; tr = 'Ticaret nesnesinin mevcut ayarları kaybolacaktır! Tipik ve kullanıcı iş süreçleri değişmeden kalacaktır. Devam etmek mi?'; uk = 'Поточні налаштування торгового об''єкта будуть втрачені! Типові і призначені для користувача бізнес процеси залишаться без зміни. Продовжити?'; uz = 'Savdo ob''ektining joriy sozlamalari yo''qoladi! Oddiy va foydalanuvchi biznes jarayonlari o''zgarishsiz qoladi. Davom etasizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ТекстВопроса = НСтр("ru = 'Текущие настройки будут утеряны! Перезаписать их?';
								|en = 'The current settings will be lost! Overwrite them?'; be = 'Бягучыя налады будуць згубленыя! Перазапісаць іх?'; es = '¡La configuración actual se perderá! ¿Sobrescribirlos?'; ka = 'მიმდინარე პარამეტრები დაიკარგება! გადაწერეთ ისინი?'; kk = 'Ағымдағы параметрлер жоғалады! Оларды қайта жазасыз ба?'; ro = 'Setările curente vor fi pierdute! Le suprascrieți?'; tr = 'Mevcut ayarlar kaybolacak! Bunların üzerine yazmak mı?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Joriy Sozlamalar yo''qoladi! Ularni ustiga yozish?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВОдинКлюч(Команда)
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов", _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(НастройкиБизнесПроцессов), ID_Узла);
