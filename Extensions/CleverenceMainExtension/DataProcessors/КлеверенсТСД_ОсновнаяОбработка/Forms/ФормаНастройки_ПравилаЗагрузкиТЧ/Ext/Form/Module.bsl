&НаКлиенте
Процедура ТабличныеЧастиПриАктивизацииСтроки(Элемент)
	
	ДоступностьИзменения = Элементы.ТабличныеЧасти.ТекущиеДанные <> Неопределено И НЕ Элементы.ТабличныеЧасти.ТекущиеДанные.Типовой;
	
	Элементы.ТабличныеЧастиУдалить.Доступность = ДоступностьИзменения;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	НоваяСтрока = ТабличныеЧасти.Добавить();
	НоваяСтрока.Настроить = "Настроить";
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элемент.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	#КонецЕсли
	
	НоваяСтрока.Типовой = Ложь;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиОсновнаяТабличнаяЧастьПриИзменении(Элемент)
	ТекДанные = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекДанные.ОсновнаяТабличнаяЧасть Тогда
		Если НЕ ОсновнаяТЧ = Неопределено Тогда
			ОсновнаяТЧ.ОсновнаяТабличнаяЧасть = Ложь;	
		КонецЕсли;
		ТекДанные.СопоставлятьСОсновнойТЧ = Ложь;
		ОсновнаяТЧ = ТекДанные;
	Иначе
		ОсновнаяТЧ = Неопределено;
		Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
			СтрокаТЧ.СопоставлятьСОсновнойТЧ = Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиСопоставлятьСОсновнойТЧПриИзменении(Элемент)
	ТекДанные = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекДанные.ОсновнаяТабличнаяЧасть Или ОсновнаяТЧ = Неопределено Тогда	
		ТекДанные.СопоставлятьСОсновнойТЧ = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиПослеУдаления(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

Процедура ТабличныеЧастиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	Если ДанныеСтроки.Настроить = НСтр("ru = 'Настроено';
										|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'") 
		Тогда
		ОформлениеСтроки.Ячейки.ТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Зеленый;	
	Иначе	
		ОформлениеСтроки.Ячейки.ТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Если ДанныеСтроки.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
		ОформлениеСтроки.Ячейки.ТабличныеЧастиУдалятьСтрокиПоУсловию.ЦветТекста = WebЦвета.Зеленый;	
	Иначе	
		ОформлениеСтроки.Ячейки.ТабличныеЧастиУдалятьСтрокиПоУсловию.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
КонецПроцедуры

// Используется только в ОФ
&НаКлиенте
Процедура ТабличныеЧастиПриИзмененииФлажка(Элемент, Колонка)
	
	Если Колонка.Имя = "ТабличныеЧастиОсновнаяТабличнаяЧасть" Тогда
		ТабличныеЧастиОсновнаяТабличнаяЧастьПриИзменении(Элемент);
	КонецЕсли;
	
	Если Колонка.Имя = "ТабличныеЧастиСопоставлятьСОсновнойТЧ" Тогда
		ТабличныеЧастиСопоставлятьСОсновнойТЧПриИзменении(Элемент);
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ДекорацияПредупреждение.Видимость 					= ЭтоТиповаяНастройка;
		Элементы.ВосстановитьТиповыеНастройки.Видимость 			= ЭтоТиповаяНастройка;
		Элементы.ТабличныеЧастиВосстановить.Видимость 				= ЭтоТиповаяНастройка;
	#КонецЕсли

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	
	// Таблица ТабличныеЧасти
	// Отображение типовых
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиТабличнаяЧастьДокументаMS");
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиНастройкаТЧСтрокой");
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТабличныеЧасти.Типовой");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(140, 140, 140));
	
	// Надпись Восстановить
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиВосстановить");
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТабличныеЧасти.Типовой");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "Восстановить");
	
	// Надпись настроить
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиНастроить");
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТабличныеЧасти.Настроить");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
	ОтборЭлемента.ПравоеЗначение = "Настроено";
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 128, 0));
	
	// Надпись условие выгрузки Красный
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиУдалятьСтрокиПоУсловию");
	
	//ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТабличныеЧасти.УдалятьСтрокиПоУсловию");
	//ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
	//ОтборЭлемента.ПравоеЗначение = "Выключено";
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "Выключено");
	
	// Надпись условие выгрузки Зеленый
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТабличныеЧастиУдалятьСтрокиПоУсловию");
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТабличныеЧасти.УдалятьСтрокиПоУсловию");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
	ОтборЭлемента.ПравоеЗначение = "Включено";
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 128, 0));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "Включено");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТабличныеЧасти.Скопировать();
	#Иначе
		ТЗ = ТабличныеЧасти.Выгрузить();
	#КонецЕсли
	
	ТЗ.Сортировать("Типовой Убыв"); // Сортируем, т.к типовые поля всегда должны быть сверху
	ТЗ.Колонки.Удалить("Восстановить");
	
	Возврат ПоместитьВоВременноеХранилище(ТЗ, Новый УникальныйИдентификатор());
	
