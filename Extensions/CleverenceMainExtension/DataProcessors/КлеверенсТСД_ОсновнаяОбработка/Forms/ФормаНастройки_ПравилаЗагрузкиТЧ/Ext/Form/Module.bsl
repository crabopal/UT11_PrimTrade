&НаКлиенте
Процедура ОбновитьТабличныеЧасти()
	
	ТабличныеЧасти.Очистить();
	
	Если НастройкаЗагрузкиТЧ = Неопределено Тогда
		НастройкаЗагрузкиТЧ = Новый Массив;
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из НастройкаЗагрузкиТЧ Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПриемник = ТабличныеЧасти.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаНастройки);
		
		Если ЭтоТиповаяНастройка
			И (НЕ СтрокаНастройки.Свойство("Типовой")
			ИЛИ СтрокаНастройки.Типовой <> Ложь) Тогда
			СтрокаПриемник.Типовой = Истина;
		КонецЕсли;
		
		Если НЕ СтрокаНастройки.Свойство("ТабличнаяЧастьДокумента1С")
			И СтрокаНастройки.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
			СтрокаНастройки.Вставить("ТабличнаяЧастьДокумента1С",_ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрокаНастройки.ТабличнаяЧастьДокумента1ССтрокой,Истина));
		КонецЕсли;
		СтрокаПриемник.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(СтрокаНастройки.ТабличнаяЧастьДокумента1С);
		Если ТипЗнч(СтрокаНастройки.ТабличнаяЧастьДокумента1С) = Тип("Массив")
			И СтрокаНастройки.ТабличнаяЧастьДокумента1С.Количество() > 1 Тогда
			СтрокаПриемник.Настроить = НСтр("ru = 'Настроено';
												|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
		Иначе
			СтрокаПриемник.Настроить = НСтр("ru = 'Настроить';
												|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
		КонецЕсли;
		
		Если СтрокаНастройки.Свойство("УдалятьСтрокиПоУсловиюФлаг") 
			И СтрокаНастройки.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			СтрокаПриемник.УдалятьСтрокиПоУсловию = НСтр("ru = 'Включено';
															|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'");
		Иначе
			СтрокаПриемник.УдалятьСтрокиПоУсловию = НСтр("ru = 'Выключено';
															|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
		Если СтрокаТЧ.ОсновнаяТабличнаяЧасть Тогда
			ОсновнаяТЧ = СтрокаТЧ;
			Прервать;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСопоставленияТЧ()
	
	ИндОсновнойТЧ = Неопределено;
	ИндПодчиненнойТЧ = Неопределено;
	Инд = 0;
	Для Каждого Строка Из ТабличныеЧасти Цикл
		Если Строка.ОсновнаяТабличнаяЧасть = Истина Тогда
			ИндОсновнойТЧ = Инд;
		ИначеЕсли Строка.СопоставлятьСОсновнойТЧ = Истина Тогда
			ИндПодчиненнойТЧ = Инд;
		КонецЕсли;
		Инд = Инд +1;
	КонецЦикла;
	
	// Если установлена галочка основной табличной части, но не задана сопоставляемая ТЧ, то надо сбросить эту галочку
	Если ИндОсновнойТЧ <> Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		#Если Не ТолстыйКлиентОбычноеПриложение Тогда
			Сообщение.ИдентификаторНазначения = ВладелецФормы.УникальныйИдентификатор;			
		#КонецЕсли
		
		Строка = ТабличныеЧасти.Получить(ИндОсновнойТЧ);
		Если  ИндПодчиненнойТЧ = Неопределено Тогда			
			Строка.ОсновнаяТабличнаяЧасть = Ложь;
			Текст = НСтр("ru = 'С табличной частью %1 не было настроено сопоставление с другой табличной частью. Флаг ""Основная табличная часть"" был снят.';
							|en = 'The tabular part of %1 has not been mapped to another tabular part. The ""Main table part"" flag has been removed.';
							|be = 'З таблічнай часткай %1 не было наладжана супастаўленне з другога таблічнай часткай. Сцяг ""асноўная Таблічная частка"" быў зняты.'; es = 'La parte de tabla %1 no se ha configurado para asignar a otra parte de tabla. La bandera ""Parte principal de la tabla"" fue eliminada.'; ka = '%1-ის ტაბულური ნაწილი არ არის მიბმული სხვა ტაბულურ ნაწილზე. ""მთავარი მაგიდის ნაწილი"" დროშა ამოღებულია.'; kk = '%1 кестелік бөлігімен басқа кестелік бөлікке сәйкестік орнатылмаған. ""Негізгі кесте бөлігі"" Туы алынып тасталды.'; ro = 'Partea tabelară a %1 nu a fost mapată la o altă parte tabelară. Steagul ""partea principală a mesei"" a fost eliminat.'; tr = '%1 tablo bölümü ile başka bir tablo bölümü ile eşleme yapılandırılmadı. ""Ana Tablo Bölümü"" bayrağı kaldırıldı.'; uk = 'З табличною частиною %1 не було налаштовано зіставлення з іншою табличною частиною. Прапор ""основна таблична частина"" був знятий.'; uz = '%1 jadval qismi bilan boshqa jadval qismiga mos kelish o''rnatilmagan. ""Asosiy jadval qismi"" bayrog''i olib tashlandi.'");
			Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, Строка.НастройкаТЧСтрокой);
			Сообщение.Текст = Текст;			
			Сообщение.Сообщить(); 
		Иначе
			КлючСвязиНайден = Ложь;
			НастройкаТЧ = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(Строка.ТабличнаяЧастьДокумента1ССтрокой);
			Для Каждого СтрокаРеквизита Из НастройкаТЧ Цикл
				Если СтрокаРеквизита.Свойство("ЭтоТаблицаЗначений") 
					Или СтрокаРеквизита.Загружать = Ложь Тогда
					Продолжить;				
				ИначеЕсли Лев(СтрокаРеквизита.СинонимИсточника,15) = "Ключ связи для " Тогда
					КлючСвязиНайден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не КлючСвязиНайден Тогда
				Текст = НСтр("ru = 'В настройке табличной части %1 не указан ключ связи с другой табличной частью. Возможны ошибки при загрузке документа.';
								|en = 'The setting of the %1 tabular part does not specify a key for communication with another tabular part. There may be errors when loading the document.';
								|be = 'У наладзе таблічнай часткі %1 Не паказаны ключ сувязі з другога таблічнай часткай. Магчымыя памылкі пры загрузцы дакумента.'; es = 'La configuración de la parte de tabla %1 no especifica una clave de asociación con otra parte de tabla. Puede haber errores al cargar el documento.'; ka = '%1 ცხრილის ნაწილის დაყენება არ განსაზღვრავს სხვა ცხრილის ნაწილთან კომუნიკაციის გასაღებს. დოკუმენტის ჩატვირთვისას შეიძლება იყოს შეცდომები.'; kk = '%1 кестелік бөлігін орнату басқа кестелік бөлікпен байланыс кілтін көрсетпейді. Құжатты жүктеу кезінде қателер болуы мүмкін.'; ro = 'Setarea părții tabulare %1 nu specifică o cheie pentru comunicarea cu o altă parte tabulară. Pot exista erori la încărcarea documentului.'; tr = 'Tablo bölümünün %1 ayarında, diğer tablo bölümüyle iletişim anahtarı belirtilmemiştir. Belgeyi yüklerken hatalar olabilir.'; uk = 'У налаштуванні табличній частині %1 не вказано ключ зв''язку з іншою табличною частиною. Можливі помилки при завантаженні документа.'; uz = '%1 jadval qismini sozlashda boshqa jadval qismi bilan aloqa kaliti ko''rsatilmagan. Hujjatni yuklashda xatolar bo''lishi mumkin.'");
				Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, Строка.НастройкаТЧСтрокой);
				Сообщение.Текст = Текст;
				Сообщение.Сообщить(); 
			КонецЕсли;
		КонецЕсли;
		
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДоступностьСохранения()
	
	КонтрольПройден = Истина;
	
	Индекс = ТабличныеЧасти.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		СтрокаТЧ = ТабличныеЧасти[Индекс];
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НастройкаТЧСтрокой) Тогда
			
			// Проверка заполнения ТЧ источника
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
				Сообщение = Новый СообщениеПользователю;
				Текст = НСтр("ru = 'Не выбрана табличная часть документа 1С'");
				
				Сообщение.Текст = Текст;
				Сообщение.Поле = "ТабличныеЧасти[" + Индекс + "].НастройкаТЧСтрокой";
				Сообщение.УстановитьДанные(ЭтаФорма);
				Сообщение.Сообщить(); 
			#Иначе
				НомерСтроки = Индекс + 1;
				ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа 1С в строке %2'");
				ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(НомерСтроки));
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#КонецЕсли
			
			КонтрольПройден = Ложь;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТЧ.ТабличнаяЧастьДокументаMS) Тогда
			
			// Проверка заполнения ТЧ приемника
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
				Сообщение = Новый СообщениеПользователю;
				Текст = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс'");
				
				Сообщение.Текст = Текст;
				Сообщение.Поле = "ТабличныеЧасти[" + Индекс + "].ТабличнаяЧастьДокументаMS";
				Сообщение.УстановитьДанные(ЭтаФорма);
				Сообщение.Сообщить(); 
			#Иначе
				НомерСтроки = Индекс + 1;
				ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс в строке %2'");
				ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(НомерСтроки));
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#КонецЕсли
			
			КонтрольПройден = Ложь;
			
		Иначе
			
			// Проверка дублей
			ДублиСтроки = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой", СтрокаТЧ.НастройкаТЧСтрокой));
			Если ДублиСтроки.Количество() > 1 Тогда
				
				КонтрольПройден = Ложь;
				
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, СтрокаТЧ.НастройкаТЧСтрокой);
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Текст;
					Сообщение.Поле = "ТабличныеЧасти[" + Индекс + "].НастройкаТЧСтрокой";
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить();
				#Иначе
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					ПоказатьПредупреждение(, Текст); 
				#КонецЕсли
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ФормаНастройки_ПравилаЗагрузкиПолейЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		Если ТипЗнч(РезультатРедактирования.ТаблицаНастроек) = Тип("Массив")
			И РезультатРедактирования.ТаблицаНастроек.Количество() > 1 Тогда
