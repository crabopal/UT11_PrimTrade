/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ОсновнаяТЧ Экспорт,
	СтруктураДокумента1С Экспорт,	
	СтруктураДокументаMS Экспорт,
	ТаблицаРеквизитовДополнительная Экспорт,
	НастройкаЗагрузкиТЧ Экспорт,
	пРазрешитьЗакрытие;
	
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		УстановитьУсловноеОформление();
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СтруктураНастроекТиповая = Неопределено Тогда
		СтруктураНастроекТиповая = Новый Структура;
	КонецЕсли;
	
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СтрокиПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СтрокиФакт");	
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СовмещенныеСтроки");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерииПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерииФакт");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерийныеНомераПлан");
	Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить("СерийныеНомераФакт");
	
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	СписокТЧ.СортироватьПоПредставлению();
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиНастройкаТЧСтрокой.СписокВыбора,СписокТЧ);	
	
	ОбновитьТабличныеЧасти();
	
	ОбновитьОтображениеПриОткрытии();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ПроверитьСопоставленияТЧ();
	
	Если НЕ ПроверитьДоступностьСохранения() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицыРеквизитов());
	
	НовыеНастройкаЗагрузкиТЧ = Новый Массив;
	Для каждого СтрокаНастройкиТЧ Из Результат Цикл
		
		Если СтрокаНастройкиТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ СтрокаНастройкиТЧ.Свойство("ТабличнаяЧастьДокумента1С")
			И СтрокаНастройкиТЧ.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
			СтрокаНастройкиТЧ.Вставить("ТабличнаяЧастьДокумента1С", _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрокаНастройкиТЧ.ТабличнаяЧастьДокумента1ССтрокой, Истина));
		КонецЕсли;
		
		Если СтрокаНастройкиТЧ.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
			СтрокаНастройкиТЧ.Удалить("ТабличнаяЧастьДокумента1ССтрокой");
		КонецЕсли;
		
		Если НовыеНастройкаЗагрузкиТЧ.Количество() = 0 Тогда
			НовыеНастройкаЗагрузкиТЧ.Добавить(_ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтрокаНастройкиТЧ));
		КонецЕсли;
		НовыеНастройкаЗагрузкиТЧ.Добавить(СтрокаНастройкиТЧ);
		
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, НовыеНастройкаЗагрузкиТЧ);
		КонецЕсли;
	#КонецЕсли
	
	пРазрешитьЗакрытие = Истина;
	Закрыть(НовыеНастройкаЗагрузкиТЧ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповыеНастройки(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки таблиц будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповыеНастройкиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы



#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ТабличныеЧастиПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КолонкаИмя = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элемент.ТекущийЭлемент.Имя;
	#КонецЕсли
	
	Если КолонкаИмя = "ТабличныеЧастиВосстановить" И ТекущаяСтрока.Типовой Тогда
		
		пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию для таблицы %1?'");
		пЗаголовок =  _ЛокКонтекст.ЛокЯдро_СтрШаблон(пЗаголовок, ТекущаяСтрока.НастройкаТЧСтрокой);
		пСообщение = НСтр("ru = 'Настройки таблицы будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
		
		ОП = Новый ОписаниеОповещения("ВопросВосстановитьНастройкиТЧЗавершение", ЭтаФорма, ТекущаяСтрока);
		ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
		Возврат;
		
	КонецЕсли;
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ВРег(СокрЛП("ТабличныеЧастиНастроить")) Тогда		
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокументаMS) Тогда			
			ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс';
										|en = 'The tabular part of the Cleverence document is not selected'; be = 'Не абраная Таблічная частка дакумента Cleverence'; es = 'No se ha seleccionado la parte de tabla del documento Cleverence'; ka = 'კლევერენციის დოკუმენტის ცხრილის ნაწილი არ არის შერჩეული'; kk = 'Cleverence құжатының кестелік бөлігі таңдалмаған'; ro = 'Partea tabelară a documentului Cleverence nu este selectată'; tr = 'Cleverence belgesinin tablo bölümü seçilmedi'; uk = 'Не вибрано табличну частину документа Cleverence'; uz = 'Cleverence hujjatining jadval qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда
			ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа 1С';
										|en = 'The tabular part of the 1C document is not selected'; be = 'Ня абраная Таблічная частка дакумента 1С'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = '1c დოკუმენტის ცხრილის ნაწილი არ არის შერჩეული'; kk = '1С құжатының кестелік бөлігі таңдалмаған'; ro = 'Partea tabelară a documentului 1C nu este selectată'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не вибрано табличну частину документа 1С'; uz = '1C hujjatining jadval qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;	
		КонецЕсли; 	
		
		ФормаНастройки_ПравилаЗагрузкиПолей = _ЛокКонтекст.ЛокЯдро_ПолучитьФорму("ФормаНастройки_ПравилаЗагрузкиПолей", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ФормаНастройки_ПравилаЗагрузкиПолей._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_ПравилаЗагрузкиПолей.КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
		ФормаНастройки_ПравилаЗагрузкиПолей.КонтрольКоличества = КонтрольКоличества;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокумента1С = ТипДокумента1С;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТипДокументаMS = ТипДокументаMS;
		ФормаНастройки_ПравилаЗагрузкиПолей.ИмяТабличнойЧастиMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
		ФормаНастройки_ПравилаЗагрузкиПолей.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
		
		СписокТаблицДляСвязиПоКлючу = Новый СписокЗначений;  
		
		Если ТекущаяСтрока.ОсновнаяТабличнаяЧасть И ТабличныеЧасти.Количество() > 1 Тогда     
			Для Каждого СтрокаТЧ Из ТабличныеЧасти Цикл
				Если СтрокаТЧ.СопоставлятьСОсновнойТЧ Тогда
					СписокТаблицДляСвязиПоКлючу.Добавить(_ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрокаТЧ.ТабличнаяЧастьДокумента1ССтрокой), СтрокаТЧ.НастройкаТЧСтрокой);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ФормаНастройки_ПравилаЗагрузкиПолей.СписокТаблицДляСвязиПоКлючу = СписокТаблицДляСвязиПоКлючу;
		Если ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой) Тогда
			ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой);
		Иначе 
			ТабличнаяЧастьДокумента1С = Новый Массив; 
		КонецЕсли;
		Если ТипЗнч(ТабличнаяЧастьДокумента1С) = Тип("Массив") Тогда
			ФормаНастройки_ПравилаЗагрузкиПолей.ТаблицаРеквизитовИсходная   = ТабличнаяЧастьДокумента1С;
		КонецЕсли;
		ФормаНастройки_ПравилаЗагрузкиПолей.ТаблицаРеквизитовДополнительная  					= ТаблицаРеквизитовДополнительная; 		
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти = ТекущаяСтрока.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПередЗаполнениемТабличнойЧасти 		= ТекущаяСтрока.ВидОбработчика_ПередЗаполнениемТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти 	= ТекущаяСтрока.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.ВидОбработчика_ПослеЗаполненияТабличнойЧасти 		= ТекущаяСтрока.ВидОбработчика_ПослеЗаполненияТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПередЗаполнениемТабличнойЧасти 			= ТекущаяСтрока.Обработчик_ПередЗаполнениемТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти 	= ТекущаяСтрока.Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти		= ТекущаяСтрока.Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаЗагрузкиПолей.Обработчик_ПослеЗаполненияТабличнойЧасти 			= ТекущаяСтрока.Обработчик_ПослеЗаполненияТабличнойЧасти;
		
		Если ТекущаяСтрока.Типовой Тогда
			
			пСтруктураНастроекТиповая = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроекТиповая.НастройкаЗагрузкиТЧ, "НастройкаТЧСтрокой", ТекущаяСтрока.НастройкаТЧСтрокой);
			ФормаНастройки_ПравилаЗагрузкиПолей.ЭтоТиповаяНастройка = Истина;
			ФормаНастройки_ПравилаЗагрузкиПолей.СтруктураНастроекТиповая = пСтруктураНастроекТиповая;
			
		КонецЕсли;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ПравилаЗагрузкиПолейЗакрытие",ЭтаФорма,Новый Структура("ТекущаяСтрока",ТекущаяСтрока));
		ФормаНастройки_ПравилаЗагрузкиПолей.ОписаниеОповещенияОЗакрытии 						= ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ПравилаЗагрузкиПолей.ОткрытьМодально();
		#Иначе
			ФормаНастройки_ПравилаЗагрузкиПолей.Открыть();
		#КонецЕсли
		
	ИначеЕсли ВРег(СокрЛП(КолонкаИмя)) = ВРег(СокрЛП("ТабличныеЧастиУдалятьСтрокиПоУсловию")) Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокументаMS) Тогда			
			ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс';
