&НаКлиенте
Процедура ФормаНастройки_УсловияУдаленияСтрокТЧЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.УдалятьСтрокиПоУсловию = НСтр("ru = 'Включено';
															|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'");
		Иначе
			ТекущаяСтрока.УдалятьСтрокиПоУсловию = НСтр("ru = 'Выключено';
															|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
		КонецЕсли; 
		ТекущаяСтрока.УдалятьСтрокиПоУсловиюФлаг = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.УдалятьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТаблицаРеквизитовДополнительная = СтруктураНастроекТиповая.НастройкаВыгрузкиПолей;
		НастройкаЗагрузкиТЧ				= СтруктураНастроекТиповая.НастройкаЗагрузкиТЧ;
		
		ОбновитьТабличныеЧасти();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросВосстановитьНастройкиТЧЗавершение(Результат, ТекущаяСтрока) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТиповаяСтрока = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроекТиповая.НастройкаЗагрузкиТЧ, "НастройкаТЧСтрокой", ТекущаяСтрока.НастройкаТЧСтрокой);
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТиповаяСтрока);
		ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ТиповаяСтрока.ТабличнаяЧастьДокумента1С);
		
		Если ТипЗнч(ТиповаяСтрока.ТабличнаяЧастьДокумента1С) = Тип("Массив")
			И ТиповаяСтрока.ТабличнаяЧастьДокумента1С.Количество() > 1 Тогда
			ТекущаяСтрока.Настроить = НСтр("ru = 'Настроено';
											|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
		Иначе
			ТекущаяСтрока.Настроить = НСтр("ru = 'Настроить';
											|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
		КонецЕсли; 
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

