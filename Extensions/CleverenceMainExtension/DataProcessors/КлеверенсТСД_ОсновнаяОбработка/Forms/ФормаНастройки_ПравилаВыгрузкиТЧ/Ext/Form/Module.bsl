			ТекстПредупреждения = НСтр("ru = 'Перед добавлением новой строки нужно заполнить табличные части Клеверенс у существующих строк';
										|en = 'Before adding a new row, you need to fill in the table parts of the Cleverence for existing rows';
										|be = 'Перад даданнем новага радка трэба запоўніць таблічныя часткі Cleverence ў існуючых радкоў'; es = 'Antes de agregar una nueva fila, debe completar las partes de tabla de Cleverence en las filas existentes'; ka = 'ახალი რიგის დამატებამდე, თქვენ უნდა შეავსოთ ცხრილის ნაწილები არსებული რიგებისთვის'; kk = 'Жаңа жолды қоспас бұрын Cleverence кестелік бөліктерін бар жолдармен толтыру керек'; ro = 'Înainte de a adăuga un rând nou, trebuie să completați părțile tabelului de inteligență pentru rândurile existente'; tr = 'Yeni bir satır eklemeden önce, mevcut satırların Cleverence''ın tablo bölümlerini doldurmanız gerekir'; uk = 'Перед додаванням нового рядка потрібно заповнити табличні частини Cleverence у існуючих рядків'; uz = 'Yangi qatorni qo''shmasdan oldin, mavjud satrlarda jadval jadvallarini to''ldirish kerak'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли; 			
	КонецЦикла; 
	
	НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
	НоваяСтрока.Настроить 					  = НСтр("ru = 'Настроить';
														|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
	НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
	НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = НСтр("ru = 'Выключено';
														|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
	
	Если Копирование Тогда
		
		ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "ТабличнаяЧастьДокументаMS,ТабличнаяЧастьДокументаMSПредставление");		
		
		//НайдСтроки = ТабличныеЧасти.НайтиСтроки(Новый Структура("ТабличнаяЧастьДокументаMS", ТекущаяСтрока.ТабличнаяЧастьДокументаMS));	
		Икс = 1;ВсегоКоличество = ТабличныеЧасти.Количество();
		Пока Икс < ВсегоКоличество Цикл
			СтрокаПоиска = ТабличныеЧасти[Икс];
			Если СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда									
				СтрокаТЧ = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаПоиска);
				СтрокаТЧ.НастройкаТЧСтрокой = "";
				СтрокаТЧ.ТабличнаяЧастьДокументаMS = "";
				СтрокаТЧ.Вставить("Типовой", Ложь);
				ТабличныеЧасти.Добавить(СтрокаТЧ);
			КонецЕсли;
			Икс = Икс + 1;
		КонецЦикла;
		
		Если СвязиТабличныхЧастей <> Неопределено Тогда
			Икс = 1;ВсегоКоличество = СвязиТабличныхЧастей.Количество();
			Пока Икс < ВсегоКоличество Цикл
				СтрокаПоиска = СвязиТабличныхЧастей[Икс];
				Если СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда									
					СтрокаТЧ = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтрокаПоиска);
					СтрокаТЧ.ТабличнаяЧастьДокументаMS = "";
					СтрокаТЧ.Вставить("Типовой", Ложь);
					СвязиТабличныхЧастей.Добавить(СтрокаТЧ);
				КонецЕсли;
				Икс = Икс + 1;
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	НоваяСтрока.Типовой = Ложь;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиПередНачаломИзменения(Элемент, Отказ)

	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Очистить();
	ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
	
	Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора.Добавить(ПредставлениеТабличнойЧастиДокументаMS(ТабличнаяЧастьДокументаMSПредыдущееЗначение));
	ЗаполнитьСписокВыбора(Элементы.ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMS.СписокВыбора, ПолучитьСписокВыбораТабличныхЧастейMS());
	
	НастройкаТЧСтрокойПредыдущееЗначение		= ТекущаяСтрока.НастройкаТЧСтрокой;
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ОтображаемыеТабличныеЧасти.Удалить(ТекущаяСтрока);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиТабличнаяЧастьДокументаMSПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMSПоПредставлению(ТекущаяСтрока.ТабличнаяЧастьДокументаMSПредставление);
	
	Если ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда
		Возврат;			
	КонецЕсли;	
	
	ИзменитьВладельцаПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMSПредыдущееЗначение, ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ТабличнаяЧастьДокументаMSПредыдущееЗначение = ТекущаяСтрока.ТабличнаяЧастьДокументаMS;
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемыеТабличныеЧастиНастройкаТЧСтрокойПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОтображаемыеТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НастройкаТЧСтрокойПредыдущееЗначение = ТекущаяСтрока.НастройкаТЧСтрокой Тогда
		Возврат;			
	КонецЕсли;	
	
	УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
	
	ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(ТекущаяСтрока.НастройкаТЧСтрокой, 1) = "(" ИЛИ ПустаяСтрока(ТекущаяСтрока.НастройкаТЧСтрокой),
		Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(ТекущаяСтрока.НастройкаТЧСтрокой));
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловию		  = НСтр("ru = 'Выключено';
															|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = Ложь;
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = "";
	
	Если НЕ Найти(ВРег(СокрЛП(ТекущаяСтрока.НастройкаТЧСтрокой)), ВРег(СокрЛП(НесколькоТабличныхЧастей))) Тогда
		НоваяСтруктура = ПолучитьСтруктуруТабличнойЧасти();
		ЗаполнитьЗначенияСвойств(НоваяСтруктура, ТекущаяСтрока);
		НоваяСтруктура.Настроить 					 = НСтр("ru = 'Настроить';
																|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
		НоваяСтруктура.ТабличнаяЧастьДокумента1С 	 = Неопределено;
		НоваяСтруктура.ТекстЗапросаВыгрузкиНаТСД 	 = Неопределено;
		НоваяСтруктура.ТекстКодаПолучениеПараметров  = Неопределено;
		
		ТабличныеЧасти.Добавить(НоваяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтображаемыеТабличныеЧастиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	Если ДанныеСтроки.Настроить = НСтр("ru = 'Настроено';
										|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'") 
		Тогда
		ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Зеленый;	
	Иначе	
		ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиНастроить.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Если ДанныеСтроки.ТабличнаяЧастьЕстьВМетаданных Тогда
		Если ДанныеСтроки.ВыгружатьСтрокиПоУсловию = НСтр("ru = 'Включено';
															|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'") 
			Тогда
			ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.Зеленый;
		Иначе	
			ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
	Иначе
		ОформлениеСтроки.Ячейки.ОтображаемыеТабличныеЧастиВыгружатьСтрокиПоУсловию.ЦветТекста = WebЦвета.СветлоСерый;
	КонецЕсли;
КонецПроцедуры

