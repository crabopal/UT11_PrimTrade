	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
	ОтборЭлемента.ПравоеЗначение = "Выключено";
	
	ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтображаемыеТабличныеЧасти.ТабличнаяЧастьЕстьВМетаданных");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Приемник,Список)
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение,Элем.Представление);	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеТабличнойЧастиДокументаMS(ТабличнаяЧастьДокументаMS)
	
	ЭлементПредставления = ПредставленияТабЧастейMS.НайтиПоЗначению(ТабличнаяЧастьДокументаMS);
	Возврат ?(ЭлементПредставления = Неопределено, ТабличнаяЧастьДокументаMS, ЭлементПредставления.Представление);
	
КонецФункции

&НаКлиенте
Функция ТабличнаяЧастьДокументаMSПоПредставлению(ПредставлениеТабличнойЧастиДокументаMS)
	
	Для каждого ЭлементСЗ Из ПредставленияТабЧастейMS Цикл
		Если ЭлементСЗ.Представление = ПредставлениеТабличнойЧастиДокументаMS Тогда
			Возврат ЭлементСЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПредставлениеТабличнойЧастиДокументаMS;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияВТабличнойЧасти()
	
	Для каждого Строка Из ОтображаемыеТабличныеЧасти Цикл
		ЭлементПредставления = ПредставленияТабЧастейMS.НайтиПоЗначению(Строка.ТабличнаяЧастьДокументаMS);
		Строка.ТабличнаяЧастьДокументаMSПредставление = ПредставлениеТабличнойЧастиДокументаMS(Строка.ТабличнаяЧастьДокументаMS);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастей1С()
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	Если СписокТЧ.НайтиПоЗначению("(Запрос)") = Неопределено Тогда
		СписокТЧ.Добавить("(Запрос)", "(Запрос)");
	КонецЕсли;
	Если СписокТЧ.НайтиПоЗначению("(" + НесколькоТабличныхЧастей + ")") = Неопределено Тогда
		СписокТЧ.Добавить("(" + НесколькоТабличныхЧастей + ")", "(" + НесколькоТабличныхЧастей + ")");
	КонецЕсли;
	
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено Тогда
		Для Каждого КлючЗначение Из СписокДополнительныхОбработчиков Цикл
			Синоним = ?(КлючЗначение.Значение.Свойство("Синоним"),КлючЗначение.Значение.Синоним,КлючЗначение.Ключ);
			СписокТЧ.Добавить(КлючЗначение.Ключ,Синоним);	
		КонецЦикла;
	КонецЕсли;
	
	СписокТЧ.СортироватьПоПредставлению();
	
	Возврат СписокТЧ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастейMS()
	
	СписокТЧ = Новый СписокЗначений;
	
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СтрокиПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СтрокиФакт"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерииПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерииФакт"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерийныеНомераПлан"));
	СписокТЧ.Добавить(ПредставлениеТабличнойЧастиДокументаMS("СерийныеНомераФакт"));
		
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		СписокТЧ.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	Возврат СписокТЧ;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьОтображаемыеТабличныеЧасти()
	
	СписокТабличныхЧастей1С = Элементы.ОтображаемыеТабличныеЧастиНастройкаТЧСтрокой.СписокВыбора;
	ТЧДокументаMS = Новый Массив;
	Если ТабличныеЧасти = Неопределено Тогда
		ТабличныеЧасти = Новый Массив;
	КонецЕсли;
	Для каждого Строка Из ТабличныеЧасти Цикл
		Если Строка.Свойство("ЭтоТаблицаЗначений")
			ИЛИ ТЧДокументаMS.Найти(Строка.ТабличнаяЧастьДокументаMS) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТЧДокументаMS.Добавить(Строка.ТабличнаяЧастьДокументаMS);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧастьДокументаMS Из ТЧДокументаMS Цикл
		НайдСтроки = Новый Массив;
		Для Каждого СтрокаПоиска Из ТабличныеЧасти Цикл
			Если НЕ СтрокаПоиска.Свойство("ЭтоТаблицаЗначений")
				И СтрокаПоиска.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
				НайдСтроки.Добавить(СтрокаПоиска);
			КонецЕсли	
		КонецЦикла;
		Если НайдСтроки.Количество() = 1 Тогда
			НайдСтрока = НайдСтроки[0];
			НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			
			Если ЭтоТиповаяНастройка
				И (НЕ НайдСтрока.Свойство("Типовой")
				ИЛИ НайдСтрока.Типовой <> Ложь) Тогда
				НоваяСтрока.Типовой = Истина;
			КонецЕсли;
			
			Если НайдСтрока.ТабличнаяЧастьДокумента1С<>Неопределено
				И НайдСтрока.ТабличнаяЧастьДокумента1С.Количество() Тогда
				НоваяСтрока.Настроить = НСтр("ru = 'Настроено';
												|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
			Иначе
				НоваяСтрока.Настроить = НСтр("ru = 'Настроить';
												|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
			КонецЕсли;
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(НоваяСтрока.НастройкаТЧСтрокой, 1) = "(" ИЛИ ПустаяСтрока(НоваяСтрока.НастройкаТЧСтрокой),
				Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(НоваяСтрока.НастройкаТЧСтрокой));
			Если НайдСтрока.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") И НайдСтрока.ВыгружатьСтрокиПоУсловиюФлаг = Истина Тогда
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("ru = 'Включено';
																|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'");
			Иначе
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("ru = 'Выключено';
																|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
			КонецЕсли;
		Иначе
			
			НастройкаТЧСтрокой = "(" + НесколькоТабличныхЧастей + ": ";
			
			// Если хоть один ТЧ типовой, то считаем всё типовым
			Типовой = Ложь;
			Для каждого НайдСтрока Из НайдСтроки Цикл
				НастройкаТЧСтрокой = НастройкаТЧСтрокой + НайдСтрока.НастройкаТЧСтрокой + ", ";	
				
				Если ЭтоТиповаяНастройка И Типовой = Ложь
					И (НЕ НайдСтрока.Свойство("Типовой")
					ИЛИ НайдСтрока.Типовой <> Ложь) Тогда
					Типовой = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			НастройкаТЧСтрокой = Лев(НастройкаТЧСтрокой, СтрДлина(НастройкаТЧСтрокой) - 2) + ")";			
			НоваяСтрока = ОтображаемыеТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
				
			НоваяСтрока.Типовой = Типовой;
			
			НоваяСтрока.НастройкаТЧСтрокой = НастройкаТЧСтрокой;
			Если СписокТабличныхЧастей1С.НайтиПоЗначению(НастройкаТЧСтрокой) = Неопределено Тогда
				СписокТабличныхЧастей1С.Добавить(НастройкаТЧСтрокой, НастройкаТЧСтрокой);
			КонецЕсли;
			флНастроено = Ложь;
			Для каждого НайдСтрока Из НайдСтроки Цикл
				Если НайдСтрока.Свойство("ТабличнаяЧастьДокумента1С")
				 	И ТипЗнч(НайдСтрока.ТабличнаяЧастьДокумента1С) = Тип("Массив")
				 	И НайдСтрока.ТабличнаяЧастьДокумента1С.Количество() Тогда
					флНастроено = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			Если флНастроено Тогда
				НоваяСтрока.Настроить = НСтр("ru = 'Настроено';
												|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
			Иначе
				НоваяСтрока.Настроить = НСтр("ru = 'Настроить';
												|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
			КонецЕсли;
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
			НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = НСтр("ru = 'Выключено';
																|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
		КонецЕсли;
	КонецЦикла; 		
	
	СписокТабличныхЧастей1С.СортироватьПоПредставлению();
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьСписокВыбораТабличныхЧастейMS()
	
	СписокТабличныхЧастейMS = ПолучитьСписокТабличныхЧастейMS();
	
	Для Каждого Строка Из ОтображаемыеТабличныеЧасти Цикл
		НайденныйЭлемент = СписокТабличныхЧастейMS.НайтиПоЗначению(Строка.ТабличнаяЧастьДокументаMSПредставление);
		Если НайденныйЭлемент <> Неопределено Тогда
			СписокТабличныхЧастейMS.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокТабличныхЧастейMS;
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMS)
	
	Икс = ТабличныеЧасти.Количество();
	Пока Икс > 0 Цикл
		Икс = Икс - 1;
		Если ТабличныеЧасти[икс].Свойство("ТабличнаяЧастьДокументаMS") и ТабличныеЧасти[икс].ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
			ТабличныеЧасти.Удалить(Икс);	
		КонецЕсли;
	КонецЦикла;

	Если СвязиТабличныхЧастей <> Неопределено Тогда
		Икс = СвязиТабличныхЧастей.Количество();
		Пока Икс > 1 Цикл
			Икс = Икс - 1;
			Если СвязиТабличныхЧастей[икс].ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS Тогда
				СвязиТабличныхЧастей.Удалить(Икс);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВладельцаПодчиненныхТабличныхЧастей(ТабличнаяЧастьДокументаMSПредыдущееЗначение, ТабличнаяЧастьДокументаMS);

	Для Каждого ЭлементМассива Из ТабличныеЧасти Цикл
		Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") 
			ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMSПредыдущееЗначение Тогда
			Продолжить;
		КонецЕсли;
		ЭлементМассива.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;
	КонецЦикла;
 
	Если СвязиТабличныхЧастей <> Неопределено Тогда
		Для Каждого ЭлементМассива Из СвязиТабличныхЧастей Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") 
				ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMSПредыдущееЗначение Тогда
				Продолжить;
			КонецЕсли;
			ЭлементМассива.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруТабличнойЧасти()
	
	НоваяСтруктура = Новый Структура;
	НоваяСтруктура.Вставить("ТабличнаяЧастьДокументаMS");
	НоваяСтруктура.Вставить("НастройкаТЧСтрокой");
	НоваяСтруктура.Вставить("Настроить");
	НоваяСтруктура.Вставить("ТабличнаяЧастьДокумента1С");
	НоваяСтруктура.Вставить("ТекстЗапросаВыгрузкиНаТСД");
	НоваяСтруктура.Вставить("ТекстКодаПолучениеПараметров");
	НоваяСтруктура.Вставить("Обработчик_ПередВыгрузкойТабличнойЧасти");
	НоваяСтруктура.Вставить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("Обработчик_ПослеВыгрузкиТабличнойЧасти");
	НоваяСтруктура.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПередВыгрузкойТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПослеВыгрузкиТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти");
	НоваяСтруктура.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти");
	НоваяСтруктура.Вставить("ВыгружатьСтрокиПоУсловиюФлаг");
	НоваяСтруктура.Вставить("ВыгружатьСтрокиПоУсловиюСтрокой");
	НоваяСтруктура.Вставить("Типовой");

	Возврат НоваяСтруктура;
	
КонецФункции

&НаКлиенте 
Процедура ОбновитьСтруктуруТабличныхЧастей()
	
	КолонкиТабличныхЧастей = ПолучитьСтруктуруТабличнойЧасти();
	
	Для Каждого Элемент Из ТабличныеЧасти Цикл
		
		Если Элемент.Свойство("ЭтоТаблицаЗначений") И Элемент.ЭтоТаблицаЗначений Тогда			
			Для Каждого Колонка Из КолонкиТабличныхЧастей Цикл
				Если _ЛокКонтекст.ЛокЯдро_СтрНайти(Элемент.КолонкиТаблицыЗначений, Колонка.Ключ) = 0 Тогда
					Элемент.КолонкиТаблицыЗначений = Элемент.КолонкиТаблицыЗначений + "," + Колонка.Ключ;
				КонецЕсли;				
			КонецЦикла;                      						
			Продолжить;	
		КонецЕсли;
		
		Для Каждого Колонка Из КолонкиТабличныхЧастей Цикл
			Если Не Элемент.Свойство(Колонка.Ключ) Тогда
				Элемент.Вставить(Колонка.Ключ);
			КонецЕсли;				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДоступностьСохранения()
	
	КонтрольПройден = Истина;
	
	Индекс = ОтображаемыеТабличныеЧасти.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		СтрокаТЧ = ОтображаемыеТабличныеЧасти[Индекс];
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НастройкаТЧСтрокой) Тогда
			
			// Проверка заполнения ТЧ источника
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
				Сообщение = Новый СообщениеПользователю;
				Текст = НСтр("ru = 'Не выбрана табличная часть документа 1С'");
				
				Сообщение.Текст = Текст;
				Сообщение.Поле = "ОтображаемыеТабличныеЧасти[" + Индекс + "].НастройкаТЧСтрокой";
				Сообщение.УстановитьДанные(ЭтаФорма);
				Сообщение.Сообщить(); 
			#Иначе
				НомерСтроки = Индекс + 1;
				ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа 1С в строке %2'");
				ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(НомерСтроки));
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#КонецЕсли
			
			КонтрольПройден = Ложь;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТЧ.ТабличнаяЧастьДокументаMS) Тогда
			
			// Проверка заполнения ТЧ приемника
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
				Сообщение = Новый СообщениеПользователю;
				Текст = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс'");
				
				Сообщение.Текст = Текст;
				Сообщение.Поле = "ОтображаемыеТабличныеЧасти[" + Индекс + "].ТабличнаяЧастьДокументаMSПредставление";
				Сообщение.УстановитьДанные(ЭтаФорма);
				Сообщение.Сообщить(); 
			#Иначе
				НомерСтроки = Индекс + 1;
				ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа Клеверенс в строке %2'");
				ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(НомерСтроки));
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#КонецЕсли
			
			КонтрольПройден = Ложь;
			
		Иначе
			
			// Проверка дублей
			ДублиСтроки = ОтображаемыеТабличныеЧасти.НайтиСтроки(Новый Структура("ТабличнаяЧастьДокументаMS", СтрокаТЧ.ТабличнаяЧастьДокументаMS));
			Если ДублиСтроки.Количество() > 1 Тогда
				
				КонтрольПройден = Ложь;
				
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, СтрокаТЧ.ТабличнаяЧастьДокументаMS);
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Текст;
					Сообщение.Поле = "ОтображаемыеТабличныеЧасти[" + Индекс + "].ТабличнаяЧастьДокументаMSПредставление";
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить();
				#Иначе
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					ПоказатьПредупреждение(, Текст); 
				#КонецЕсли
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		
		Если СтруктураПараметров.НайдСтрока = Неопределено Тогда
			НоваяСтруктура = ПолучитьСтруктуруТабличнойЧасти();
			ЗаполнитьЗначенияСвойств(НоваяСтруктура, ТекущаяСтрока);
			НоваяСтруктура.Настроить = "Настроить";
			НоваяСтруктура.ТабличнаяЧастьДокумента1С = Неопределено;
			НоваяСтруктура.ТекстЗапросаВыгрузкиНаТСД = Неопределено;
			НоваяСтруктура.ТекстКодаПолучениеПараметров = Неопределено;
			
			ТабличныеЧасти.Добавить(НоваяСтруктура);
			НайдСтрока = Новый Структура;
		Иначе
			ТабличнаяЧастьДокументаMS = СтруктураПараметров.НайдСтрока.ТабличнаяЧастьДокументаMS;
			Для Каждого ЭлементМассива Из ТабличныеЧасти Цикл
				Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений")
					ИЛИ НЕ ЭлементМассива.Свойство("ТабличнаяЧастьДокументаMS")
					ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMS Тогда
					Продолжить;
				КонецЕсли;
				НайдСтрока = ЭлементМассива;
				Прервать;
			КонецЦикла;
		КонецЕсли;	
				
		НайдСтрока.Вставить("ТабличнаяЧастьДокумента1С",							РезультатРедактирования.ТаблицаНастроек);		
		НайдСтрока.Вставить("ТекстЗапросаВыгрузкиНаТСД",							РезультатРедактирования.ТекстЗапросаВыгрузкиНаТСД);		
		НайдСтрока.Вставить("ТекстКодаПолучениеПараметров",							РезультатРедактирования.ТекстКодаПолучениеПараметров);				
		НайдСтрока.Вставить("ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти",	РезультатРедактирования.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПередВыгрузкойТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПередВыгрузкойТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти",		РезультатРедактирования.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеВыгрузкиТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти);
		НайдСтрока.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",	Неопределено);
		НайдСтрока.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",		Неопределено);
		НайдСтрока.Вставить("Обработчик_ПередВыгрузкойТабличнойЧасти",				РезультатРедактирования.Обработчик_ПередВыгрузкойТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти",		РезультатРедактирования.Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти",			РезультатРедактирования.Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти);
		НайдСтрока.Вставить("Обработчик_ПослеВыгрузкиТабличнойЧасти",				РезультатРедактирования.Обработчик_ПослеВыгрузкиТабличнойЧасти);		
		НайдСтрока.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",		Неопределено);
		НайдСтрока.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",			Неопределено);		
		НайдСтрока.Вставить("Настроить",											"Настроено");
		
		ТекущаяСтрока.Настроить	= НСтр("ru = 'Настроено';
										|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");   		
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_СвязиВыгрузкиТЧЗакрытие(РезультатРедактирования,СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ТекущаяСтрока = СтруктураПараметров.ТекущаяСтрока;
		УдалитьСтрокиПодчиненныхТабличныхЧастей(ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
		
		НастройкаТЧСтрокой = "(" + НесколькоТабличныхЧастей + ": ";			
		
		КоличествоТабличныхЧастей = 0;
		
		Для каждого Строка Из РезультатРедактирования.ТабличныеЧасти Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ПолучитьСтруктуруТабличнойЧасти();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(Строка.ТабличнаяЧастьДокумента1ССтрокой);
										
			ТабличныеЧасти.Добавить(НоваяСтрока);					
			НастройкаТЧСтрокой = НастройкаТЧСтрокой + Строка.НастройкаТЧСтрокой + ", ";
			
			КоличествоТабличныхЧастей = КоличествоТабличныхЧастей + 1;
		КонецЦикла; 
		
		НастройкаТЧСтрокой = Лев(НастройкаТЧСтрокой, СтрДлина(НастройкаТЧСтрокой) - 2) + ")";						
		
		Если КоличествоТабличныхЧастей = 1 Тогда 
			Для каждого Строка Из РезультатРедактирования.ТабличныеЧасти Цикл
				Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				НастройкаТЧСтрокой = Строка.НастройкаТЧСтрокой;
			КонецЦикла;
		КонецЕсли; 	
		
		ТекущаяСтрока.НастройкаТЧСтрокой 	= НастройкаТЧСтрокой; 					
		ТекущаяСтрока.Настроить				= НСтр("ru = 'Настроено';
													|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");
		
		Для Каждого ТекущаяТабличнаяЧасть Из ТабличныеЧасти Цикл
			Если ТекущаяТабличнаяЧасть.Свойство("ЭтоТаблицаЗначений")
				ИЛИ НЕ ТекущаяТабличнаяЧасть.Свойство("ТабличнаяЧастьДокументаMS")
				ИЛИ ТекущаяТабличнаяЧасть.ТабличнаяЧастьДокументаMS <> "СтрокиПлан" Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяТабличнаяЧасть.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",	РезультатРедактирования.ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",			РезультатРедактирования.ВидОбработчика_ПослеОбъединенияТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",		РезультатРедактирования.Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти);
			ТекущаяТабличнаяЧасть.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",				РезультатРедактирования.Обработчик_ПослеОбъединенияТабличнойЧасти);	
			
		КонецЦикла; 		
		
		Если СвязиТабличныхЧастей = Неопределено Тогда
			СвязиТабличныхЧастей = РезультатРедактирования.СвязиТабличныхЧастей;
		Иначе
			Для каждого Строка Из РезультатРедактирования.СвязиТабличныхЧастей Цикл
				Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				СвязиТабличныхЧастей.Добавить(Строка);
			КонецЦикла; 			
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ТекущаяСтрока 								  = СтруктураПараметров.ТекущаяСтрока;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
		
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("ru = 'Включено';
															|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'");
		Иначе
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = НСтр("ru = 'Выключено';
															|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'");
		КонецЕсли;
		
		Если СтруктураПараметров.НайдСтрока = Неопределено Тогда
			НоваяСтруктура = ПолучитьСтруктуруТабличнойЧасти();
			ЗаполнитьЗначенияСвойств(НоваяСтруктура, ТекущаяСтрока);
			НоваяСтруктура.Настроить					= "Настроить";
			НоваяСтруктура.ТабличнаяЧастьДокумента1С 	= Неопределено;
			НоваяСтруктура.ТекстЗапросаВыгрузкиНаТСД 	= Неопределено;
			НоваяСтруктура.ТекстКодаПолучениеПараметров = Неопределено;
			
			ТабличныеЧасти.Добавить(НоваяСтруктура);
			НайдСтрока = Новый Структура;
		Иначе
			ТабличнаяЧастьДокументаMS = СтруктураПараметров.НайдСтрока.ТабличнаяЧастьДокументаMS;
			Для Каждого ЭлементМассива Из ТабличныеЧасти Цикл
				Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений")
					ИЛИ НЕ ЭлементМассива.Свойство("ТабличнаяЧастьДокументаMS")
					ИЛИ ЭлементМассива.ТабличнаяЧастьДокументаMS <> ТабличнаяЧастьДокументаMS Тогда
					Продолжить;
				КонецЕсли;
				НайдСтрока = ЭлементМассива;
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
		НайдСтрока.Вставить("ВыгружатьСтрокиПоУсловиюФлаг",	   ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг);
		НайдСтрока.Вставить("ВыгружатьСтрокиПоУсловиюСтрокой", ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТаблицаРеквизитовДополнительная = СтруктураНастроекТиповая.НастройкаВыгрузкиПолей;
		ТабличныеЧасти 					= СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ;
		СвязиТабличныхЧастей 			= СтруктураНастроекТиповая.СвязиТабличныхЧастей;
		
		ОтображаемыеТабличныеЧасти.Очистить();
		
		ЗаполнитьОтображаемыеТабличныеЧасти();
		ОбновитьСтруктуруТабличныхЧастей();
		ОбновитьПредставленияВТабличнойЧасти();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросВосстановитьНастройкиТЧЗавершение(Результат, ТекущаяСтрока) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Отбор = Новый Структура("ТабличнаяЧастьДокументаMS", ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
		
		// Настройки таблиц
		ТиповыеНастройкаВыгрузкиТЧ = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ, Отбор);
		
		// Заменяем строки таблиц на типовые
		ТиповыеДобавлены = Ложь;
		НовыйТабличныеЧасти = Новый Массив;
		Если ТабличныеЧасти = Неопределено Тогда
			НовыйТабличныеЧасти = ТиповыеНастройкаВыгрузкиТЧ;
		ИНаче
			Для каждого СтрокаТЧ Из ТабличныеЧасти Цикл
				
				Если СтрокаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
					НовыйТабличныеЧасти.Добавить(СтрокаТЧ);
					Продолжить;
				КонецЕсли;
				
				// Удаляем все строки по имени ТЧ и вставляем типовые.
				Если СтрокаТЧ.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда
					
					Если НЕ ТиповыеДобавлены Тогда
						Для каждого ТиповаяСтрокаТЧ Из ТиповыеНастройкаВыгрузкиТЧ Цикл
							Если ТиповаяСтрокаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
								Продолжить;
							КонецЕсли;
							НовыйТабличныеЧасти.Добавить(ТиповаяСтрокаТЧ);
						КонецЦикла;
						ТиповыеДобавлены = Истина;
					КонецЕсли;
					
				Иначе
					НовыйТабличныеЧасти.Добавить(СтрокаТЧ);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		ТабличныеЧасти = НовыйТабличныеЧасти;
		
		// Связи таблиц
		ТиповыеСвязиТабличныхЧастей = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтруктураНастроекТиповая.СвязиТабличныхЧастей, Отбор);
		// Заменяем строки таблиц на типовые
		ТиповыеДобавлены = Ложь;
		НовыйСвязиТабличныхЧастей = Новый Массив;
		Если СвязиТабличныхЧастей = Неопределено Тогда
			НовыйСвязиТабличныхЧастей = ТиповыеСвязиТабличныхЧастей;
		Иначе
			Для каждого СтрокаТЧ Из СвязиТабличныхЧастей Цикл
				
				Если СтрокаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
					НовыйСвязиТабличныхЧастей.Добавить(СтрокаТЧ);
					Продолжить;
				КонецЕсли;
				
				// Удаляем все строки по имени ТЧ и вставляем типовые.
				Если СтрокаТЧ.ТабличнаяЧастьДокументаMS = ТекущаяСтрока.ТабличнаяЧастьДокументаMS Тогда
					
					Если НЕ ТиповыеДобавлены Тогда
						Для каждого ТиповаяСтрокаТЧ Из ТиповыеСвязиТабличныхЧастей Цикл
							Если ТиповаяСтрокаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
								Продолжить;
							КонецЕсли;
							НовыйСвязиТабличныхЧастей.Добавить(ТиповаяСтрокаТЧ);
						КонецЦикла;
						ТиповыеДобавлены = Истина;
					КонецЕсли;
					
				Иначе
					НовыйСвязиТабличныхЧастей.Добавить(СтрокаТЧ);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		СвязиТабличныхЧастей = НовыйСвязиТабличныхЧастей;
		
		//  Обновление отображения
		ОтображаемыеТабличныеЧасти.Очистить();
		
		ЗаполнитьОтображаемыеТабличныеЧасти();
		ОбновитьСтруктуруТабличныхЧастей();
		ОбновитьПредставленияВТабличнойЧасти();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
	
#КонецЕсли