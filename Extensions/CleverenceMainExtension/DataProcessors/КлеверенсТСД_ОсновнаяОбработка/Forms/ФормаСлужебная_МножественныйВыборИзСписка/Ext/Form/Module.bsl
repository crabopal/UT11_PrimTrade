/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ВнешнийСписок Экспорт;

&НаКлиенте
Перем КолонкиТаблицы Экспорт;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если КолонкиТаблицы <> Неопределено Тогда
		ЗаполнитьКолонкиТаблицы(КолонкиТаблицы);
	КонецЕсли;
	
	Если ВнешнийСписок <> Неопределено Тогда
		Если ТипЗнч(ВнешнийСписок) = Тип("СписокЗначений") Тогда
			Для каждого ЭлементСписка Из ВнешнийСписок Цикл
				НоваяСтрока = СписокВыбора.Добавить();
				НоваяСтрока.Представление = ЭлементСписка.Представление;
				НоваяСтрока.Идентификатор = ЭлементСписка.Значение;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ВнешнийСписок) = Тип("Массив") Тогда
			Для каждого ЭлементСписка Из ВнешнийСписок Цикл
				НоваяСтрока = СписокВыбора.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСписка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Описание.Заголовок = Описание;
	Элементы.Описание.Видимость = НЕ ПустаяСтрока(Описание);
	
	Если РежимОткрытия = "ВыборРасширений" Тогда
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ЗакрытьСРезультатом.Заголовок = НСтр("ru = 'Обновить'");
			Элементы.Закрыть.Заголовок = НСтр("ru = 'Отменить'");
			
			Элементы.СохранитьРасширения.Видимость = Истина;
			
			ЭлементСтрокиПоиска = Элементы.Найти("СписокВыбораОтображениеСтрокиПоиска");
			Если ЭлементСтрокиПоиска <> Неопределено Тогда
				ЭлементСтрокиПоиска.Видимость = Ложь;
			КонецЕсли;
		#Иначе
			Элементы.ОсновныеДействияФормы.Кнопки.ЗакрытьСРезультатом.Текст = НСтр("ru = 'Обновить'");
			Элементы.ОсновныеДействияФормы.Кнопки.Закрыть.Текст 			= НСтр("ru = 'Отменить'");
		#КонецЕсли
	Иначе
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.СохранитьРасширения.Видимость = Ложь;
		#Иначе
			Элементы.ОсновныеДействияФормы.Кнопки.Удалить(Элементы.ОсновныеДействияФормы.Кнопки.СохранитьРасширения);
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, Неопределено);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
// Код процедур и функций
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы
// Код процедур и функций
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для каждого СтрокаСписка Из СписокВыбора Цикл
		СтрокаСписка.Использовать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для каждого СтрокаСписка Из СписокВыбора Цикл
		СтрокаСписка.Использовать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСРезультатом(Команда)
	ЗакрытиеСРезультатом();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРасширения(Команда)
	ИменаРасширений = Новый Массив;
	Для каждого СтрокаВыбора Из СписокВыбора Цикл
		// Сохраним все расширения, а не только выбранные
		ИменаРасширений.Добавить(СтрокаВыбора.ДополнительныеПараметры.ИмяРасширения);
	КонецЦикла;
	_ЛокКонтекст.ЛокЯдро_ОбновлениеКомпонент_СохранитьРасширенияВФайл(ИменаРасширений);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКолонкиТаблицы(ОписанияКолонок)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		Для Каждого ОписаниеКолонки Из ОписанияКолонок Цикл
			ИмяКолонки = ОписаниеКолонки.Имя;
			КолонкаДанных = СписокВыбора.Колонки.Найти(ИмяКолонки);
			Если КолонкаДанных = Неопределено Тогда
				КолонкаДанных = СписокВыбора.Колонки.Добавить(ИмяКолонки, ОписаниеКолонки.Тип);
			КонецЕсли;
			
			КолонкаЭлемента = Элементы.СписокВыбора.Колонки.Найти(ИмяКолонки);
			Если КолонкаЭлемента = Неопределено Тогда
				КолонкаЭлемента = Элементы.СписокВыбора.Колонки.Добавить(ИмяКолонки, ОписаниеКолонки.Синоним);
				КолонкаЭлемента.Данные = ИмяКолонки;
				КолонкаЭлемента.УстановитьЭлементУправления(Тип("ПолеВвода"));
				КолонкаЭлемента.ТолькоПросмотр = Истина;
			КонецЕсли;
			
			Если ОписаниеКолонки.Свойство("Синоним") Тогда
				КолонкаЭлемента.ТекстШапки = ОписаниеКолонки.Синоним;
			КонецЕсли;
			
			Если ОписаниеКолонки.Свойство("ЦветТекста") Тогда
				КолонкаЭлемента.ЦветТекстаПоля = ОписаниеКолонки.ЦветТекста;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(КолонкаЭлемента, ОписаниеКолонки);
		КонецЦикла;
		
	#Иначе
		
		ДобавляемыеРеквизиты = Новый Массив;
		
		Для Каждого ОписаниеКолонки Из ОписанияКолонок Цикл
			ИмяКолонки 		= ОписаниеКолонки.Имя;
			ИмяЭлемента 	= "СписокВыбора" + ИмяКолонки;
			ЭлементКолонки 	= Элементы.Найти(ИмяЭлемента);
			Если ЭлементКолонки = Неопределено Тогда
				РеквизитКолонки = Новый РеквизитФормы(ИмяКолонки, ОписаниеКолонки.Тип, "СписокВыбора");
				ДобавляемыеРеквизиты.Добавить(РеквизитКолонки);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Для Каждого ОписаниеКолонки Из ОписанияКолонок Цикл
			ИмяКолонки 		= ОписаниеКолонки.Имя;
			ИмяЭлемента 	= "СписокВыбора" + ИмяКолонки;
			ЭлементКолонки 	= Элементы.Найти(ИмяЭлемента);
			Если ЭлементКолонки = Неопределено Тогда
				ЭлементКолонки 					= Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.СписокВыбора);
				ЭлементКолонки.ПутьКДанным 		= "СписокВыбора." + ИмяКолонки;
				ЭлементКолонки.Вид 				= ВидПоляФормы.ПолеВвода;
				ЭлементКолонки.ТолькоПросмотр 	= Истина;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ЭлементКолонки, ОписаниеКолонки);
		КонецЦикла;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеСРезультатом()
	
	МассивИдентификаторов = Новый Массив;
	Для каждого СтрокаСписка Из СписокВыбора Цикл
		Если СтрокаСписка.Использовать Тогда
			МассивИдентификаторов.Добавить(СтрокаСписка.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, МассивИдентификаторов);
		КонецЕсли;
	#КонецЕсли
	
	Закрыть(МассивИдентификаторов);
	
КонецПроцедуры 

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элементы = ЭлементыФормы;
#КонецЕсли