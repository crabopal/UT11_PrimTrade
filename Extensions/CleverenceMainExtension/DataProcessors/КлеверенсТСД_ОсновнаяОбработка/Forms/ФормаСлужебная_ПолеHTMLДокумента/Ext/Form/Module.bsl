//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.АдресHTML.Перейти(АдресHTML);
	#Иначе
		Элементы.АдресHTML.Доступность = НЕ БлокировкаHTMLДокумента;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура АдресHTMLДокументСформирован(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если БлокировкаHTMLДокумента Тогда
			Попытка
				// Платформа 8.3.14
				Для каждого link ИЗ Элементы.АдресHTML.Документ.links Цикл
					link.style.pointerEvents = "none";
				КонецЦикла;
			Исключение
				
			КонецПопытки;
		КонецЕсли;
	#КонецЕсли	
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элементы = ЭлементыФормы;
#КонецЕсли