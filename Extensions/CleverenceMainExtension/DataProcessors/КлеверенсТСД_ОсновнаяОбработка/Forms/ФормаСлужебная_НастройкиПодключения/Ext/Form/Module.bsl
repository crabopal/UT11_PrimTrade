/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем СписокБаз,
	ПараметрыПодключения Экспорт,
	пРазрешитьЗакрытие,
	ПредСтрокаПодключенияСМАРТС;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		
		#Область НесовместимыйКодFresh
		ЭтоФреш = Ложь;
		#КонецОбласти //НесовместимыйКодFresh
		#Область СовместимыйКодFresh
		//ЭтоФреш = Истина;
		#КонецОбласти //СовместимыйКодFresh
		
		ЭтоВебКлиент = Параметры.ЭтоВебКлиент;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт
		
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;
	#КонецЕсли
		
	Если ЭтоВебКлиент Или ЭтоФреш Тогда
		Компонента 		= "НаСервере";
	КонецЕсли;
	
	Если ТипИнтерфейса <> "REST_API" Тогда
		ТипИнтерфейса 	= "REST_API";
		Модифицированность = Истина;
	КонецЕсли;
	
	Если РежимВыбораБазы <> "СтрокаПодключения" Тогда
		РежимВыбораБазы = "СтрокаПодключения";
		Модифицированность = Истина;
	КонецЕсли;	
			
	Если НЕ ЗначениеЗаполнено(Компонента) Тогда
		Компонента = "НаСервере";
	КонецЕсли;
	
	ОбновитьОтображениеПослеПодключения();
	
	Если ТипБазы = "Частная" Тогда
		Компонента = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("РасположениеКомпоненты");
		ИмяСтруктурыПодключенияMS = "СтруктураПодключенияЧастнойБазыMS";
	Иначе
		ИмяСтруктурыПодключенияMS = "СтруктураПодключенияБазыMS";
	КонецЕсли;
	Если ТипИнтерфейса = "REST_API" Тогда
		ИмяСтруктурыПодключенияMS = "REST_API_" + ИмяСтруктурыПодключенияMS;
	КонецЕсли;
	СтруктураПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной(ИмяСтруктурыПодключенияMS);
	
	Если ПараметрыПодключения <> Неопределено Тогда				
		Если ТипЗнч(СтруктураПодключенияMS) = Тип("Структура") И СтруктураПодключенияMS.Свойство("IdBaseSMARTS") 
			И Компонента = "НаКлиенте" Тогда
			СтрокаПодключенияСМАРТС = СтруктураПодключенияMS.СтрокаПодключенияСМАРТС;
		ИначеЕсли ТипЗнч(ПараметрыПодключения) = Тип("Структура") И ПараметрыПодключения.Свойство("Ид") Тогда
			СтрокаПодключенияСМАРТС = ПараметрыПодключения.СтрокаПодключения;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПодключения) = Тип("Структура") Тогда 
		АвторизацияВключена = Ложь;
		Если ПараметрыПодключения.Свойство("АвторизацияВключена")
			И ПараметрыПодключения.АвторизацияВключена = Истина Тогда
			АвторизацияВключена 	= Истина;
			АвторизацияТокен 		= ?(ПараметрыПодключения.Свойство("АвторизацияТокен"), 		 ПараметрыПодключения.АвторизацияТокен, 	  "");
			АвторизацияРефрешТокен 	= ?(ПараметрыПодключения.Свойство("АвторизацияРефрешТокен"), ПараметрыПодключения.АвторизацияРефрешТокен, "");
			АвторизацияТип 			= ?(ПараметрыПодключения.Свойство("АвторизацияТип"), 		 ПараметрыПодключения.АвторизацияТип, 		  Неопределено);
		ИначеЕсли ПараметрыПодключения.Свойство("ОписаниеБазы")
			И ТипЗнч(ПараметрыПодключения.ОписаниеБазы) = Тип("Структура")
			И ПараметрыПодключения.ОписаниеБазы.Свойство("АвторизацияВключена")
			И ПараметрыПодключения.ОписаниеБазы.АвторизацияВключена = Истина Тогда
			ОписаниеБазы			= ПараметрыПодключения.ОписаниеБазы;
			
			АвторизацияВключена 	= Истина;
			АвторизацияТокен 		= ?(ОписаниеБазы.Свойство("АвторизацияТокен"), 		 ОписаниеБазы.АвторизацияТокен, 	  "");
			АвторизацияРефрешТокен 	= ?(ОписаниеБазы.Свойство("АвторизацияРефрешТокен"), ОписаниеБазы.АвторизацияРефрешТокен, "");
			АвторизацияТип 			= ?(ОписаниеБазы.Свойство("АвторизацияТип"), 		 ОписаниеБазы.АвторизацияТип, 		  Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	ПредСтрокаПодключенияСМАРТС = СтрокаПодключенияСМАРТС;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ОбновитьОтображениеПриОткрытии();
	#КонецЕсли
	
	ОбновитьВидимостьЭлементов();
	НастройкаПодключения_ПроверитьСоединение();
	ОбновитьОтображениеБуферОбменаПолеHTML();
	
	Если АвтоТестОткрытияФормы Тогда
		ПослеОткрытия();
	Иначе
		ПодключитьОбработчикОжидания("ПослеОткрытия", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытия()
	
	УстановитьСтрокуПодключенияИзБуфера();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И ПодключениеДоступно И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
    Если ИмяСобытия = "ОшибкаАвторизацииПоTempUid" Тогда
		СообщениеПользователю = Новый СообщениеПользователю();
		СообщениеПользователю.Текст = Параметр;
		СообщениеПользователю.Сообщить(); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	НастройкаПодключения_НастроитьПодключение();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ОП = Новый ОписаниеОповещения("ЗакрытьПослеСохранения",ЭтаФорма);
	ДополнительныеПараметры = Новый Структура("ОповещениеОбработкиЗавершения", ОП);
	НастройкаПодключения_НастроитьПодключение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьсяПоСтроке(Команда)
	
	Модифицированность = Истина;
	НастройкаПодключения_ПроверитьСоединение();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПодключенияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(СтрокаПодключенияСМАРТС);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводСтрокиПодключенияПриИзменении(Элемент)
	
	Модифицированность = Истина;
	НастройкаПодключения_ПроверитьСоединение();
	
КонецПроцедуры

&НаКлиенте
Процедура ВводСтрокиПодключенияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	СтрокаПодключенияСМАРТС = Текст;
	Если НЕ ПустаяСтрока(СтрокаПодключенияСМАРТС) 
		И (Найти(СтрокаПодключенияСМАРТС, "http://") > 0
			ИЛИ Найти(СтрокаПодключенияСМАРТС, "https://") > 0) Тогда
		Модифицированность = Истина;
		НастройкаПодключения_ПроверитьСоединение();
	Иначе
		НастройкаПодключения_ПроверитьСоединениеЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДоступностьОнлайнРежимаСсылкаНажатие(Элемент)
	
	СсылкаНаРесурс = "https://www.cleverence.ru/support/111317/";
	_ЛокКонтекст.ЛокЯдро_ОткрытьСсылкуВнешнегоРесурса(СсылкаНаРесурс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодробнееОСтрокеПодключенияНажатие(Элемент)
	
	СсылкаНаРесурс = "https://www.cleverence.ru/support/97039/";
	_ЛокКонтекст.ЛокЯдро_ОткрытьСсылкуВнешнегоРесурса(СсылкаНаРесурс);
	
КонецПроцедуры

&НаКлиенте
Процедура БуферОбменаПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Атрибут = ДанныеСобытия.Element.getAttribute("id");
		
	// Событие завершения асинхронного метода работы с буфером обмена
	Если Атрибут = "clipboardReadDone" Тогда
		ПрочитатьБуферОбменаJSПроверитьРезультат();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтображениеФормы

&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии(ПараметрыВыполнения = Неопределено)
	
	_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.СохранитьИЗакрыть);
	
	ЦветАкцентирования = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Акцентирование");
	Элементы.ПодробнееОСтрокеПодключения.ЦветТекста = ЦветАкцентирования;
	Элементы.ПодключитьсяПоСтроке.ЦветТекста = ЦветАкцентирования;
	
	УстановитьВнешниеКартинки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеСобытиеЭлементов(Событие, ДопПараметры = Неопределено)
	
	Если Событие = "КомпонентаПриИзменении" Тогда
		
		Если НЕ ПодключениеДоступно Тогда
			ФонГруппы 		= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("КрасныйСветлый");
			ЦветСостояния 	= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("КрасныйТемный");
			ТекстСостояния 	= НСтр("ru = 'Нет подключения';
									|en = 'There is no connection'; be = 'Няма падлучэння'; es = 'Sin conexión'; ka = 'კავშირი არ არის'; kk = 'Байланыс жоқ'; ro = 'Nu există nicio legătură'; tr = 'Bağlantı yok'; uk = 'Немає підключення'; uz = 'Ulanish yo''q'");
		ИначеЕсли Компонента = "НаКлиенте" Тогда
			ФонГруппы 		= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("ЖелтыйСветлый");
			ЦветСостояния 	= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("ЖелтыйТемный");
			ТекстСостояния 	= НСтр("ru = 'Связь с клиента';
									|en = 'Communication with the client'; be = 'Сувязь з кліента'; es = 'Comunicación con el cliente'; ka = 'კლიენტთან კომუნიკაცია'; kk = 'Клиентпен байланыс'; ro = 'Comunicarea cu clientul'; tr = 'Müşteri ile iletişim'; uk = 'Зв''язок з Клієнта'; uz = 'Mijoz bilan aloqa'");
		ИначеЕсли Компонента = "НаСервере" Тогда
			ФонГруппы 		= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("ЗеленыйСветлый");
			ЦветСостояния 	= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("ЗеленыйТемный");
			ТекстСостояния 	= НСтр("ru = 'Установлен и работает';
									|en = 'Installed and running'; be = 'Усталяваны і працуе'; es = 'Instalado y funcionando'; ka = 'დაყენებული და გაშვებული'; kk = 'Орнатылған және жұмыс істейді'; ro = 'Instalat și rulat'; tr = 'Kuruldu ve çalışıyor'; uk = 'Встановлено та працює'; uz = 'O''rnatilgan va ishlaydi'");
		КонецЕсли;
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			
			Элементы.ГруппаСостояниеОписание.Видимость = Компонента = "НаКлиенте";
			
			Элементы.ГруппаСтрокаПодключения.ЦветФона = ФонГруппы;
			Элементы.Состояние.ЦветТекста = ЦветСостояния;
			Элементы.Состояние.Заголовок = ТекстСостояния;
			
			Если ПодключениеДоступно Тогда
				Элементы.ЗаголовокИнформацияОБазе.Заголовок = НСтр("ru = 'Выбранная база:';
																	|en = 'Selected database:'; be = 'Абраная база:'; es = 'Base seleccionada:'; ka = 'შერჩეული მონაცემთა ბაზა:'; kk = 'Таңдалған база:'; ro = 'Baza de date selectată:'; tr = 'Seçilen taban:'; uk = 'Обрана база:'; uz = 'Tanlangan baza:'");
			Иначе
				Элементы.ЗаголовокИнформацияОБазе.Заголовок = НСтр("ru = 'Нет подключения к базе';
																	|en = 'There is no connection to the database'; be = 'Няма падлучэння да базы'; es = 'Sin conexión a la base'; ka = 'მონაცემთა ბაზასთან კავშირი არ არსებობს'; kk = 'Базаға қосылу жоқ'; ro = 'Nu există nicio legătură cu baza de date'; tr = 'Veritabanına bağlantı yok'; uk = 'Немає підключення до бази'; uz = 'Ma''lumotlar bazasiga ulanish yo''q'");
			КонецЕсли;
			
		#Иначе
			Элементы.СостояниеЗаголовок.Видимость = Компонента = "НаКлиенте";
			Элементы.СостояниеОписание.Видимость = Компонента = "НаКлиенте";
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()

	Если ТипБазы = "Частная" Тогда
		ТипИнтерфейса = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда		
		СтруктураПоиска = Новый Структура("ЧастнаяБазаMS", Неопределено);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВладелецФормы);
		// Изменение настроек подключения частной базы допустимо только из формы настроек узла (в которой имеется реквизит "Частная база Клеверенс")
		Если СтруктураПоиска.ЧастнаяБазаMS = Неопределено Тогда
			Элементы.ВводСтрокиПодключения.Доступность = Ложь;
		КонецЕсли;		
	КонецЕсли;
		
КонецПроцедуры

// Внешние картинки необходимо устанавливать программно, чтобы не создавать множество копий картинок.
// 	При выгрузке обработки в файлы, внешние картинки дублируются для каждого отдельного элемента.
//	Поэтому загружаем картинку только для одного элемента и далее присваиваем её программно.
// Для загрузки картинки необходимо создать элемент декорации картинка в группе ГруппаКартинкиСлужебный в форме ГлавнаяФорма
//	Загрузить в неё картинку и далее прописать элементы в СоответствиеЭлементов, которые будут использовать эту картинку.
&НаКлиенте
Процедура УстановитьВнешниеКартинки()
	
	// Пишем имена картинок без приписки "Картинка"
	СоответствиеЭлементов = Новый Соответствие;
	
	СоответствиеЭлементов.Вставить("ПодключитьсяПоСтроке", "ОбновитьПервичный");
	
	Для каждого КлючЗначение Из СоответствиеЭлементов Цикл
		Элементы[КлючЗначение.Ключ].Картинка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку(КлючЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеБуферОбменаПолеHTML()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	ШаблонHTMLПоля = 
	"<!DOCTYPE html>
	|<html lang=""ru"">
	|<head>
	|	<meta charset=""UTF-8"">
	|	<title>Clipboard Reader</title>
	|</head>
	|<body>
	|
	|<button id=""clipboardReadDone"" style=""display:none;"" type=""button""></button>
	|
	|<script>
	|	let clipboardText = """";
	|	let clipboardResult = 0; // 0 - не выполнено, 1 - успешно, 3 - ошибка
	|
	|	async function readFromClipboard() {
	|		clipboardResult = 0;
	|		clipboardText = """";
	|		try {
	|			// Пробуем через Clipboard API
	|			if (navigator.clipboard && window.isSecureContext) {
	|				clipboardText = await navigator.clipboard.readText();
	|				clipboardResult = 1;
	|			}
	|
	|			// Fallback через execCommand, если Clipboard API не сработал
	|			if (clipboardResult !== 1) {
	|				const textarea = document.createElement(""textarea"");
	|				textarea.style.position = ""fixed"";
	|				textarea.style.opacity = ""0"";
	|				document.body.appendChild(textarea);
	|				textarea.focus();
	|				textarea.select();
	|
	|				try {
	|					const execResult = document.execCommand('paste');
	|					clipboardText = textarea.value
	|					clipboardResult = execResult ? 1 : 3;
	|				} catch (err) {
	|					clipboardResult = 3;
	|				} finally {
	|					document.body.removeChild(textarea);
	|				}
	|			}
	|		} catch (err) {
	|			clipboardResult = 3;
	|		}
	|
	|		// Гарантированно назначаем 3, если вдруг clipboardResult остался 0
	|		if (clipboardResult === 0) {
	|			clipboardResult = 3;
	|		}
	
	// Так-как функция выполняется асинхронно, то вызовим событие нажатия кнопки, что бы передать в 1С событие о завершении чтения буфера обмена
	|		const hiddenButton = document.getElementById(""clipboardReadDone"");
	|		if (hiddenButton) {
	|			hiddenButton.click();
	|		}
	|	}
	|
	|function getClipboardText() {
	|	return clipboardText;
	|}
	|
	|function getClipboardResult() {
	|	return clipboardResult;
	|}
	|</script>
	|
	|</body>
	|</html>";
	
	БуферОбменаПолеHTML = ШаблонHTMLПоля;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеПослеПодключения(РасположениеКомпоненты = Неопределено, ОписаниеБазы = Неопределено)
	
	ИдБазыСмартс   			= "";
	ИмяБазыСМАРТС  			= "";
	ИдПриложения  			= "";
	ИмяПриложения  			= "";
	Комментарий    			= "";
	РабочийКаталог 			= "";
	ПапкаОбмена	   			= "";
	РежимРаботы    			= "Не получилось определить...";
	ПодключениеДоступно		= Ложь;
	Компонента				= "НаСервере";
	
	ПредСтрокаПодключенияСМАРТС = СтрокаПодключенияСМАРТС;
	АвторизацияВключена 	= Ложь;
	АвторизацияТокен 		= "";
	АвторизацияРефрешТокен 	= "";
	АвторизацияТип			= Неопределено;
	
	Если ОписаниеБазы <> Неопределено Тогда
		
		ИдБазыСмартс 			= ОписаниеБазы.Ид;
		ИмяБазыСМАРТС 			= ОписаниеБазы.Имя;
		СтрокаПодключенияСМАРТС = ОписаниеБазы.СтрокаПодключения;
		ИдПриложения 			= ОписаниеБазы.ИдПриложения;
		ИмяПриложения 			= ОписаниеБазы.ИмяПриложения;
		Комментарий 			= ОписаниеБазы.Комментарий;
		РабочийКаталог 			= ОписаниеБазы.РабочийКаталог;
		ПапкаОбмена 			= ОписаниеБазы.ПапкаОбмена;
		
		Если РасположениеКомпоненты <> Неопределено Тогда
			Компонента = РасположениеКомпоненты;			
		КонецЕсли;
		
		Если ОписаниеБазы.РаботаСУстройствомНапрямую Тогда
			РежимРаботы = "Работа с устройством напрямую";
		ИначеЕсли ОписаниеБазы.РаботаСКаталогом Тогда
			РежимРаботы = "Работа с каталогом";
		ИначеЕсли ОписаниеБазы.РаботаССервером Тогда
			РежимРаботы = "Работа с сервером";
		ИначеЕсли ОписаниеБазы.РаботаСЛокальнымСервером Тогда
			РежимРаботы = "Работа с локальным сервером";
		ИначеЕсли ОписаниеБазы.РаботаСУдаленнымСервером Тогда
			РежимРаботы = "Работа с удаленным сервером";
		КонецЕсли;
		
		ИмяИнтеграционнойОбработки 	= ОписаниеБазы.ИмяИнтеграционнойОбработки;
		ПутьИнтеграционнойОбработки = ОписаниеБазы.ПутьИнтеграционнойОбработки;
		
		АвторизацияВключена		= ОписаниеБазы.АвторизацияВключена;
		АвторизацияТокен		= ОписаниеБазы.АвторизацияТокен;
		АвторизацияРефрешТокен	= ОписаниеБазы.АвторизацияРефрешТокен;
		АвторизацияТип			= ОписаниеБазы.АвторизацияТип;
		
		ПодключениеДоступно		= Истина;
		
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		Элементы.ГруппаИнформацияОВыбраннойБазе.Видимость = ПодключениеДоступно;
	#КонецЕсли
	
	ОбновитьОтображениеСобытиеЭлементов("КомпонентаПриИзменении");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастройкаПодключения_ПроверитьСоединение(ДополнительныеПараметры  = Неопределено)
	
	Если ПустаяСтрока(СтрокаПодключенияСМАРТС) 
		ИЛИ НЕ (Найти(СтрокаПодключенияСМАРТС, "http://") > 0
			ИЛИ Найти(СтрокаПодключенияСМАРТС, "https://") > 0) Тогда
		НастройкаПодключения_ПроверитьСоединениеЗавершение();
		Возврат;
	КонецЕсли;
	
	МассивСтрокПодключений = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
	
	МассивСтруктурПодключения = Новый Массив;
	Для каждого СтрокаПодключения Из МассивСтрокПодключений Цикл
		
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
		
		СтруктураПодключения = Новый Структура;
		СтруктураПодключения.Вставить("СтруктураURI",					СтруктураURI);
		СтруктураПодключения.Вставить("СтрокаПодключения",				СтрокаПодключения);
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",		СтрокаПодключения);
		СтруктураПодключения.Вставить("TempUid",						СтруктураURI.TempUid);
		СтруктураПодключения.Вставить("IdBaseSMARTS",					Неопределено);
		
		СтруктураПодключения.Вставить("ТипБазы",						"Временная");
		СтруктураПодключения.Вставить("ТипИнтерфейса",					"REST_API");
		СтруктураПодключения.Вставить("РасположениеКомпоненты",			Компонента);
		СтруктураПодключения.Вставить("РежимВыбораБазы",				"СтрокаПодключения");
		СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
		
		СтруктураПодключения.Вставить("АвторизацияВключена", 	 Ложь);
		СтруктураПодключения.Вставить("АвторизацияТокен",		 "");
		СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 "");
		СтруктураПодключения.Вставить("АвторизацияТип",			 Неопределено);
		
		Если НЕ ЗначениеЗаполнено(СтруктураURI.TempUid)
			И ПредСтрокаПодключенияСМАРТС = СтрокаПодключенияСМАРТС Тогда
			
			// Авторизация уже была пройдена для текущей строки.
			СтруктураПодключения.Вставить("АвторизацияВключена", 	 АвторизацияВключена);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 АвторизацияТокен);
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 АвторизацияРефрешТокен);
			СтруктураПодключения.Вставить("АвторизацияТип",			 АвторизацияТип);
		КонецЕсли;
		
		МассивСтруктурПодключения.Добавить(СтруктураПодключения);
		
	КонецЦикла;
	
	ПараметрыВыполнения = _ЛокКонтекст.ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
	ПараметрыВыполнения.СтрокаПодключенияСМАРТС 		= СтрокаПодключенияСМАРТС;
	ПараметрыВыполнения.ТипБазы 						= "Временная";
	ПараметрыВыполнения.РасположениеКомпоненты 			= "НаСервере";
	ПараметрыВыполнения.СпособЗапуска 					= "ФормаНастройкиПодключения";
	ПараметрыВыполнения.МассивСтруктурПодключения		= МассивСтруктурПодключения;
	
	ОП = Новый ОписаниеОповещения("НастройкаПодключения_ПроверитьСоединениеЗавершение", ЭтаФорма, ДополнительныеПараметры);
	ПараметрыВыполнения.ОповещениеОбработкиЗавершения = ОП;
	
	_ЛокКонтекст.ЛокЯдро_НастройкаПодключения_ПроверитьСоединение(ПараметрыВыполнения);
	
КонецПроцедуры 

&НаКлиенте
Процедура НастройкаПодключения_ПроверитьСоединениеЗавершение(ПараметрыВыполнения = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыБазыMS = Неопределено;
	Если ПараметрыВыполнения <> Неопределено Тогда
		ПараметрыВыполнения.Свойство("ПараметрыБазыMS", ПараметрыБазыMS);
		РасположениеКомпоненты = ПараметрыВыполнения.СтруктураПодключения.РасположениеКомпоненты;
	КонецЕсли;
	
	ОбновитьОтображениеПослеПодключения(РасположениеКомпоненты, ПараметрыБазыMS);
	
	Если ДополнительныеПараметры <> Неопределено 
		И ДополнительныеПараметры.Свойство("ОповещениеОбработкиЗавершения") Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОбработкиЗавершения, ПараметрыВыполнения); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПодключения_НастроитьПодключение(ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "НастройкаПодключения_НастроитьПодключение";
	
	// <Лог>
	логПоток = _ЛокКонтекст.ЛогОткрытьПоток(ИмяСобытия, ЭтаФорма);
	
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПустаяСтрока(СтрокаПодключенияСМАРТС) 
		ИЛИ НЕ (Найти(СтрокаПодключенияСМАРТС, "http://") > 0
			ИЛИ Найти(СтрокаПодключенияСМАРТС, "https://") > 0) Тогда
		НастройкаПодключения_НастроитьПодключениеЗавершение();
		
		// <Лог>
		_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
		_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	МассивСтрокПодключений = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
	
	МассивСтруктурПодключения = Новый Массив;
	Для каждого СтрокаПодключения Из МассивСтрокПодключений Цикл
		
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
		
		СтруктураПодключения = Новый Структура;
		СтруктураПодключения.Вставить("СтруктураURI",					СтруктураURI);
		СтруктураПодключения.Вставить("СтрокаПодключения",				СтрокаПодключения);
		СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",		СтрокаПодключения);
		СтруктураПодключения.Вставить("TempUid",						СтруктураURI.TempUid);
		СтруктураПодключения.Вставить("IdBaseSMARTS",					Неопределено);
		
		СтруктураПодключения.Вставить("ТипБазы",						"Временная");
		СтруктураПодключения.Вставить("ТипИнтерфейса",					"REST_API");
		СтруктураПодключения.Вставить("РасположениеКомпоненты",			Компонента);
		СтруктураПодключения.Вставить("РежимВыбораБазы",				"СтрокаПодключения");
		СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
		
		Если ЗначениеЗаполнено(СтруктураURI.TempUid) Тогда
			СтруктураПодключения.Вставить("АвторизацияВключена", 	 Ложь);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 "");
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 "");
			СтруктураПодключения.Вставить("АвторизацияТип",			 Неопределено);
		Иначе
			СтруктураПодключения.Вставить("АвторизацияВключена", 	 АвторизацияВключена);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 АвторизацияТокен);
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 АвторизацияРефрешТокен);
			СтруктураПодключения.Вставить("АвторизацияТип",			 АвторизацияТип);
		КонецЕсли;
		
		МассивСтруктурПодключения.Добавить(СтруктураПодключения);
		
	КонецЦикла;
	
	ПараметрыВыполнения = _ЛокКонтекст.ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
	ПараметрыВыполнения.СтрокаПодключенияСМАРТС 		= СтрокаПодключенияСМАРТС;
	ПараметрыВыполнения.ТипБазы 						= ТипБазы;
	ПараметрыВыполнения.РасположениеКомпоненты 			= "НаСервере";
	ПараметрыВыполнения.РежимВыполнения 				= "НастройкаПодключения";
	ПараметрыВыполнения.СпособЗапуска 					= "ФормаНастройкиПодключения";
	ПараметрыВыполнения.МассивСтруктурПодключения		= МассивСтруктурПодключения;
	
	ДопПараметрыСохраненияПодключения = Неопределено;
	Если ПараметрыПодключения <> Неопределено
		И ПараметрыПодключения.Свойство("IdBaseSMARTS")
		И ЗначениеЗаполнено(ПараметрыПодключения.IdBaseSMARTS) Тогда
		ДопПараметрыСохраненияПодключения = Новый Структура("ЗаменитьИдБазы", ПараметрыПодключения.IdBaseSMARTS);
	КонецЕсли;
	ПараметрыВыполнения.ДополнительныеПараметры = ДопПараметрыСохраненияПодключения;
	
	ОП = Новый ОписаниеОповещения("НастройкаПодключения_НастроитьПодключениеЗавершение", ЭтаФорма, ДополнительныеПараметры);
	ПараметрыВыполнения.ОповещениеОбработкиЗавершения = ОП;
	
	_ЛокКонтекст.ЛокЯдро_НастройкаПодключения_НастроитьПодключение(ПараметрыВыполнения);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура НастройкаПодключения_НастроитьПодключениеЗавершение(ПараметрыВыполнения = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "НастройкаПодключения_НастроитьПодключениеЗавершение";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения,ДополнительныеПараметры",
		ПараметрыВыполнения, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыБазыMS = Неопределено;
	Если ПараметрыВыполнения <> Неопределено Тогда
		ПараметрыВыполнения.Свойство("ПараметрыБазыMS", ПараметрыБазыMS);
		РасположениеКомпоненты = ПараметрыВыполнения.СтруктураПодключения.РасположениеКомпоненты;
	КонецЕсли;
	
	ОбновитьОтображениеПослеПодключения(РасположениеКомпоненты, ПараметрыБазыMS);
	
	Если ПараметрыВыполнения <> Неопределено Тогда
		
		Если ПараметрыВыполнения.ПодключениеДоступно Тогда
			Модифицированность = Ложь;
		КонецЕсли;
		
		Если ДополнительныеПараметры <> Неопределено 
			И ДополнительныеПараметры.Свойство("ОповещениеОбработкиЗавершения")
			И ПараметрыВыполнения.ПодключениеДоступно Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОбработкиЗавершения, ПараметрыВыполнения); 
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтрокуПодключенияИзБуфера(ТекстБуфера = Неопределено)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	// Пропускаем, есть строка подключения уже заполнена
	Если НЕ ПустаяСтрока(СтрокаПодключенияСМАРТС) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекстБуфера = Неопределено Тогда
		
		// Вызываем JS метод, т.к работа с буфером обмена появилась только в 8.3.24
		// Копирование реализовано через асинхронную JS функцию в html поле БуферОбменаПолеHTML
		// После выполнения метода readFromClipboard, будет вызвано событие БуферОбменаПолеHTMLПриНажатии с атрибутом id - clipboardReadDone,
		//	которое означает, что работа асинхронного метода readFromClipboard завершена и можно проверять успешность работы с буфером обмена.
		
		Попытка
			Элементы.БуферОбменаПолеHTML.Документ.defaultView.readFromClipboard();
		Исключение
		КонецПопытки;
		Возврат;
		
	Иначе
		
		// Проверяем, что в буфере находится ссылка
		Если Найти(ТекстБуфера, "http://") > 0
			ИЛИ Найти(ТекстБуфера, "https://") > 0 Тогда
			СтрокаПодключенияСМАРТС = ТекстБуфера;
			Модифицированность = Истина;
			// Пока просто заполняем, без проверки подключения
			//НастройкаПодключения_ПроверитьСоединение();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПрочитатьБуферОбменаJSПроверитьРезультат()
	
	РезультатЧтения = 3;
	Попытка
		РезультатЧтения = Элементы.БуферОбменаПолеHTML.Документ.defaultView.getClipboardResult();
		РезультатЧтения = ?(РезультатЧтения = 0 ИЛИ РезультатЧтения = 1 ИЛИ РезультатЧтения = 3, РезультатЧтения, 3);
	Исключение
	КонецПопытки;
	
	Если РезультатЧтения = 1 Тогда
		
		Попытка
			ТекстБуфера = Элементы.БуферОбменаПолеHTML.Документ.defaultView.getClipboardText();
		Исключение
			ТекстБуфера = Неопределено;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ТекстБуфера) Тогда
			УстановитьСтрокуПодключенияИзБуфера(ТекстБуфера);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("Версия_REST_API", Неопределено);
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗакрытьПослеСохранения(РезультатСохранения, ДополнительныеПараметры) Экспорт
	
	пРазрешитьЗакрытие = Истина;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезультатСохранения);
		КонецЕсли;
		Закрыть();
	#Иначе
		Закрыть(РезультатСохранения);
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Элементы = ЭлементыФормы;
	
#КонецЕсли
