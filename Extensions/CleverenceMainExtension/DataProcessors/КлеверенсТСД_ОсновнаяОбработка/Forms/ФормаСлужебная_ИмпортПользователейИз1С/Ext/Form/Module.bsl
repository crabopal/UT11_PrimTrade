&НаСервере
Процедура СозданиеСтрокиПользователяТаблицыИмпорта(Пользователь)
	
	СозданныеСтроки = ТаблицаПользователейMS.НайтиСтроки(Новый Структура("Ид", XMLСтрока(Пользователь)));
	Если СозданныеСтроки.Количество() Тогда
		ЗаполняемаяСтрокаТаблицы = СозданныеСтроки[0];
	Иначе
		ЗаполняемаяСтрокаТаблицы = ТаблицаПользователейMS.Добавить();	
	КонецЕсли;         
	
	ЗаполняемаяСтрокаТаблицы.Ид  = XMLСтрока(Пользователь);
	ЗаполняемаяСтрокаТаблицы.Имя = Пользователь.Наименование;
	
	ГруппаПоУмолчанию = ТаблицаГруппMS.НайтиСтроки(Новый Структура("Ид", ИмяГруппы));
	
	ИдСклада = Новый СписокЗначений; 
	
	СкладПоУмолчанию	= СкладыВспомогательные.НайтиСтроки(Новый Структура("Ид", "1"));
	Если СкладПоУмолчанию.Количество() = 0 Тогда
		СкладПоУмолчанию = СкладыВспомогательные.НайтиСтроки(Новый Структура("Ид", "main"));		
	КонецЕсли;
	
	Если СкладПоУмолчанию.Количество() Тогда
		ИдСклада.Добавить(СкладПоУмолчанию[0].Ид, СкладПоУмолчанию[0].Имя);
	КонецЕсли;
	
	ЗаполняемаяСтрокаТаблицы.ИдГруппы 	= ?(ГруппаПоУмолчанию.Количество(), ГруппаПоУмолчанию[0].Ид, "");
	ЗаполняемаяСтрокаТаблицы.ИмяГруппы 	= ?(ГруппаПоУмолчанию.Количество(), ГруппаПоУмолчанию[0].Имя, "");			
	ЗаполняемаяСтрокаТаблицы.ИдСкладов 	= ИдСклада;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияПолей()
	
	Отказ = Ложь;
		
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл
		Если ПустаяСтрока(СтрокаПользователя.Ид) Тогда
			Сообщение = НСтр("ru = 'Строка %1 поле ""ID"" не заполнено';
								|en = 'Row %1 the ""ID"" field is not filled in'; be = 'Радок %1 поле ""ID"" не запоўнена'; es = 'Línea %1 el campo ID no está completo'; ka = 'Row %1 "" ID "" ველი არ არის შევსებული'; kk = '%1 жолы ""ID"" өрісі толтырылмаған'; ro = 'Rândul %1 câmpul "" ID "" nu este completat'; tr = 'Satır %1 ""İD"" alanı dolu değil'; uk = 'Рядок %1 поле ""ID"" не заповнене'; uz = '%1 qatori "" ID "" maydoni to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТаблицаПользователейMS.Индекс(СтрокаПользователя) + 1);
			Сообщить(Сообщение); 			
			Отказ = Истина;
		КонецЕсли;                                      			
		Если ПустаяСтрока(СтрокаПользователя.Имя) Тогда 
			Сообщение = НСтр("ru = 'Строка %1 поле ""Пользователь"" не заполнено';
								|en = 'Row %1 the ""User"" field is not filled in'; be = 'Радок %1 поле ""карыстальнік"" не запоўнена'; es = 'Línea %1 el campo Usuario no está completo'; ka = 'Row %1"" მომხმარებლის "" ველი არ არის შევსებული'; kk = '%1-жол ""пайдаланушы"" өрісі толтырылмаған'; ro = 'Rândul %1 câmpul"" Utilizator "" nu este completat'; tr = 'Satır %1 Kullanıcı alanı dolu değil'; uk = 'Рядок %1 поле ""Користувач"" не заповнене'; uz = '%1 qatori ""foydalanuvchi"" maydoni to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТаблицаПользователейMS.Индекс(СтрокаПользователя) + 1);
			Сообщить(Сообщение); 			
			Отказ = Истина;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаПользователя.ИмяГруппы) Тогда
			Сообщение = НСтр("ru = 'Строка %1 поле ""Имя группы"" не заполнено';
								|en = 'Row %1 the ""Group name"" field is not filled in'; be = 'Радок %1 поле ""Імя групы"" не запоўнена'; es = 'Línea %1 el campo nombre de grupo no está completo'; ka = 'Row %1"" ჯგუფის სახელი "" ველი არ არის შევსებული'; kk = '%1-жол ""топ Атауы"" өрісі толтырылмаған'; ro = 'Rândul %1 câmpul ""Nume grup"" nu este completat'; tr = 'Satır %1 ""Grup Adı"" alanı dolu değil'; uk = 'Рядок %1 поле ""ім''я групи"" не заповнене'; uz = '%1 qatori ""guruh nomi"" maydoni to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, ТаблицаПользователейMS.Индекс(СтрокаПользователя) + 1);
			Сообщить(Сообщение); 
			Отказ = Истина;
		КонецЕсли;
		Если ИспользоватьСкладыSMARTS = Истина И Не ЗначениеЗаполнено(СтрокаПользователя.ИдСкладов) Тогда
			Сообщение = НСтр("ru = 'Строка %1 пользователю не установлен ни один склад';
								|en = 'Line %1 the user has not installed any warehouse';
