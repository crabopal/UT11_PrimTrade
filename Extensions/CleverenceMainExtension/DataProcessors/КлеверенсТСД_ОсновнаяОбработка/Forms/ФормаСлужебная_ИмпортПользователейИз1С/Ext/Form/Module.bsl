/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте 
Перем ИспользоватьСкладыSMARTS;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИспользоватьСкладыSMARTS = _ЛокКонтекст.ЛокЯдро_ПроверитьИспользованиеСкладовSMARTS();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаПользователейMS.Колонки.ТаблицаПользователейMSИдСкладов.Видимость = ИспользоватьСкладыSMARTS;
	#Иначе
		Элементы.ТаблицаПользователейMSИдСкладов.Видимость = ИспользоватьСкладыSMARTS;
	#КонецЕсли
	
	ЗагрузитьТаблицуСкладовНаСервере(АдресСкладов);  
	ЗагрузитьГруппыПользователейНаСервере(АдресГруппыПользователей);          
	ЗагрузитьТаблицуИдентификаторов(АдресИдентификаторов);	
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПодборПользователей1С(Команда)

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму("ОФ_ФормаСлужебная_ПодборПользователей1С", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ПодборПользователей1С", , ЭтаФорма);	
	#КонецЕсли
	
	ФормаСлужебная_ПодборПользователей1С.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСлужебная_ПодборПользователей1С._ЛокКонтекст 					= _ЛокКонтекст;	
	ФормаСлужебная_ПодборПользователей1С.СозданныеПользователиИмпорта	= СформироватьСписокУжеИмпортированныхПользователей();
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ПодборПользователей1СЗакрытие", ЭтаФорма);
	ФормаСлужебная_ПодборПользователей1С.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ПодборПользователей1С.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Сообщение = НСтр("ru = 'Таблица импорта пользователей не заполнена.';
							|en = 'The user import table is not filled in.'; be = 'Табліца імпарту карыстальнікаў не запоўненая.'; es = 'La tabla de importación de usuarios no está completa.'; ka = 'მომხმარებლის იმპორტის ცხრილი არ არის შევსებული.'; kk = 'Пайдаланушылардың импорттық кестесі толық емес.'; ro = 'Tabelul import utilizator nu este completat.'; tr = 'Kullanıcı içe aktarma tablosu dolu değil.'; uk = 'Таблиця імпорту користувачів не заповнена.'; uz = 'Foydalanuvchi import jadvali to''ldirilmagan.'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;	
	
	Если Не ПроверкаЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ТаблицаСохраненаВФайл Тогда
		пСообщение = НСтр("ru = 'Перед продолжением необходимо сохранить данные пользователей Клеверенс в файл.';
							|en = 'Before proceeding, it is necessary to save the data of the Cleverence users to a file.';
							|uk = 'Перед продовженням необхідно зберегти дані користувачів Cleverence в файл.'");
		ОП = Новый ОписаниеОповещения("ВопросСохранитьВФайлЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ОКОтмена,,, "Сохранить в файл?");
		Возврат;
	КонецЕсли;
			
	ПовторноеСозданиеПользователя = Ложь;           
	ТекстВопроса = НСтр("ru = 'Следующие пользователи уже были созданы ранее:';
							|en = 'The following users have already been created before:'; be = 'Наступныя карыстальнікі ўжо былі створаны раней:'; es = 'Los siguientes usuarios ya se han creado anteriormente:'; ka = 'შემდეგი მომხმარებლები უკვე შეიქმნა ადრე:'; kk = 'Келесі пайдаланушылар бұрын жасалған:'; ro = 'Următorii utilizatori au fost deja creați înainte:'; tr = 'Aşağıdaki kullanıcılar daha önce oluşturulmuştu:'; uk = 'Наступні користувачі вже були створені раніше:'; uz = 'Quyidagi foydalanuvchilar ilgari yaratilgan:'");
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл	
		Если СписокИдентификаторов.НайтиПоЗначению(СтрокаПользователя.Ид) <> Неопределено Тогда
			ТекстВопроса = ТекстВопроса + Символы.ПС + "	- " + СтрокаПользователя.Имя;
			ПовторноеСозданиеПользователя = Истина;
		КонецЕсли;
	КонецЦикла;   
	Если ПовторноеСозданиеПользователя Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС 
				+ НСтр("ru = 'Перезаписать?';
						|en = 'Overwrite it?'; be = 'Перазапісаць?'; es = '¿Sobrescribir?'; ka = 'გადაწერეთ?'; kk = 'Қайта жазу керек пе?'; ro = 'Suprascrie-l?'; tr = 'Üzerine yazmak mı?'; uk = 'Перезаписати?'; uz = 'Qayta yozasizmi?'");
		ОповещениеЗаписатьИЗакрыть = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеЗаписатьИЗакрыть, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе     
		ЗаписатьИЗакрытьЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГенерацияШтрихкодов(Команда)                                    
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("ru = 'Генерация штрихкода';
																				|en = 'Barcode generation'; be = 'Генерацыя штрыхкода'; es = 'Generación de código de barras'; ka = 'შტრიხკოდების წარმოქმნა'; kk = 'Штрих-кодты құру'; ro = 'Generarea codurilor de bare'; tr = 'Barkod üretimi'; uk = 'Генерація штрихкоду'; uz = 'Shtrixli kodni yaratish'");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Истина;	
	ФормаСлужебная_ВводЗначенийЗаполнения.МаксЧислоСимволов 			= 20;	
		
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма, "ГенерацияШтрихкода");
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГруппу(Команда)
	
	Если Не Элементы.ТаблицаПользователейMS.ВыделенныеСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("ru = 'Заполнение группы';
																				|en = 'Filling out a group'; be = 'Запаўненне групы'; es = 'Llenando el grupo'; ka = 'ჯგუფის შევსება'; kk = 'Топты толтыру'; ro = 'Completarea unui grup'; tr = 'Grubu doldurma'; uk = 'Заповнення групи'; uz = 'Guruhni to''ldirish'");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Ложь;			
	ФормаСлужебная_ВводЗначенийЗаполнения.АдресХранилища 				= ВыгрузитьТаблицуГруппПользователейНаСервере();
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма);
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ГенерацияПаролей(Команда)	
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("ru = 'Генерация пароля';
																				|en = 'Password generation'; be = 'Генерацыя пароля'; es = 'Generar contraseña'; ka = 'პაროლის წარმოქმნა'; kk = 'Құпия сөзді жасау'; ro = 'Generarea parolei'; tr = 'Şifre oluşturma'; uk = 'Генерація пароля'; uz = 'Parol yaratish'");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Истина;	   
	ФормаСлужебная_ВводЗначенийЗаполнения.МаксЧислоСимволов 			= 9;	
		
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма, "ГенерацияПароля");
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();
			
КонецПроцедуры
   
&НаКлиенте
Процедура ТаблицаПользователейMSИдСкладовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму("ОФ_ФормаСлужебная_ВводЗначенийЗаполнения", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВводЗначенийЗаполнения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВводЗначенийЗаполнения", , ЭтаФорма);	
		ФормаСлужебная_ВводЗначенийЗаполнения.РежимОткрытияОкна 		= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_ВводЗначенийЗаполнения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВводЗначенийЗаполнения._ЛокКонтекст 					= _ЛокКонтекст;		
	ФормаСлужебная_ВводЗначенийЗаполнения.Заголовок						= НСтр("ru = 'Выбор складов';
																				|en = 'Choosing warehouses'; be = 'Выбар складоў'; es = 'Selección de almacenes'; ka = 'შერჩევა საწყობები'; kk = 'Қоймаларды таңдау'; ro = 'Alegerea depozitelor'; tr = 'Depo seçimi'; uk = 'Вибір складів'; uz = 'Omborlarni tanlash'");
	ФормаСлужебная_ВводЗначенийЗаполнения.ГенерацияПароля 				= Ложь;	
	ФормаСлужебная_ВводЗначенийЗаполнения.ПодборСкладов 				= Истина;	
	ФормаСлужебная_ВводЗначенийЗаполнения.АдресХранилища 				= ВыгрузитьТаблицуСкладовНаСервере();
	
	ТекДанные = Элементы.ТаблицаПользователейMS.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ФормаСлужебная_ВводЗначенийЗаполнения.ИдСкладовПользователя 		= ТекДанные.ИдСкладов;			
	Иначе
		Возврат;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие", ЭтаФорма, "ПодборСкладов");
	ФормаСлужебная_ВводЗначенийЗаполнения.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ВводЗначенийЗаполнения.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	Если Не ТаблицаПользователейMS.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	ФормированиеТабличногоДокументаЧерезПостроитель(ТабДок);
	ЗаголовокТД = НСтр("ru = 'Сформированные идентификационные данные новых пользователей Клеверенс';
						|en = 'Generated identification data of new Cleverence users';
						|be = 'Сфармаваныя ідэнтыфікацыйныя дадзеныя новых карыстальнікаў Cleverence'; es = 'Datos de identificación generados por los nuevos usuarios de Cleverence'; ka = 'გენერირებული საიდენტიფიკაციო მონაცემები ახალი Cleverence მომხმარებლებს'; kk = 'Cleverence жаңа пайдаланушыларының қалыптасқан сәйкестендіру деректері'; ro = 'Date de identificare generate de noii utilizatori Cleverence'; tr = 'Yeni Cleverence kullanıcılarının oluşturduğu kimlik bilgileri'; uk = 'Сформовані ідентифікаційні дані нових користувачів Cleverence'; uz = 'Yangi Cleverence foydalanuvchilarining identifikatsiya ma''lumotlari yaratildi'");
	ТабДок.Показать(ЗаголовокТД);
	
	ТаблицаСохраненаВФайл = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КопированиеШтрихкодовВПароли(Команда)
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл 
		СтрокаПользователя.Пароль = СтрокаПользователя.Штрихкод;			
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура КопированиеПаролейВШтрихкоды(Команда)
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл
		СтрокаПользователя.Штрихкод = СтрокаПользователя.Пароль;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ФормаСлужебная_ПодборПользователей1СЗакрытие(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура")
		И РезультатВыбора.Свойство("Пользователи") Тогда
		Для Каждого КлючЗначение Из РезультатВыбора.Пользователи Цикл
			СозданиеСтрокиПользователяТаблицыИмпорта(КлючЗначение.Значение);		
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСлужебная_ВводЗначенийЗаполненияЗакрытие(ВыбранноеЗначение, ПризнакДействия) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;		
	
	Если ПризнакДействия = "ГенерацияПароля" Тогда                                                    	
		Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл 
			#Если ВебКлиент Тогда
				СтрокаПользователя.Пароль = СгенерироватьПарольПользователяНаСервере(ВыбранноеЗначение, ТаблицаПользователейMS.Индекс(СтрокаПользователя));
			#Иначе
				СтрокаПользователя.Пароль = СгенерироватьПарольПользователя(ВыбранноеЗначение, ТаблицаПользователейMS.Индекс(СтрокаПользователя));			
			#КонецЕсли
		КонецЦикла; 
	ИначеЕсли ПризнакДействия = "ГенерацияШтрихкода" Тогда		
		Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл
			#Если ВебКлиент Тогда
				СтрокаПользователя.Штрихкод = СгенерироватьПарольПользователяНаСервере(ВыбранноеЗначение, ТаблицаПользователейMS.Индекс(СтрокаПользователя), Истина);
			#Иначе
				СтрокаПользователя.Штрихкод = СгенерироватьПарольПользователя(ВыбранноеЗначение, ТаблицаПользователейMS.Индекс(СтрокаПользователя), Истина);
			#КонецЕсли
		КонецЦикла;
	ИначеЕсли ПризнакДействия = "ПодборСкладов" Тогда                           
		ТекДанные = Элементы.ТаблицаПользователейMS.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			ТекДанные.ИдСкладов = ВыбранноеЗначение;
		КонецЕсли;
	Иначе
		Для Каждого ВыделеннаяСтрока Из Элементы.ТаблицаПользователейMS.ВыделенныеСтроки Цикл
			#Если ТолстыйКлиентОбычноеПриложение Тогда                                      
				ВыделеннаяСтрока.ИдГруппы 	= ВыбранноеЗначение.Ид;
				ВыделеннаяСтрока.ИмяГруппы 	= ВыбранноеЗначение.Имя;
			#Иначе
				ТаблицаПользователейMS[ВыделеннаяСтрока].ИдГруппы 	= ВыбранноеЗначение.Ид;
				ТаблицаПользователейMS[ВыделеннаяСтрока].ИмяГруппы 	= ВыбранноеЗначение.Имя;
			#КонецЕсли
		КонецЦикла;                                                                        		                                                                                   	
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокКУдалению 	= Новый Массив;                                                
	ЕстьОшибки 				= Ложь;
	
	Для Каждого СтрокаПользователя Из ТаблицаПользователейMS Цикл	
	
		ПараметрыПользователя = Новый Соответствие;
		ПараметрыПользователя.Вставить("id", 			СтрокаПользователя.Ид);
		ПараметрыПользователя.Вставить("name", 			СтрокаПользователя.Имя);		
		ПараметрыПользователя.Вставить("description", 	СтрокаПользователя.Описание);		
		ПараметрыПользователя.Вставить("password", 		СтрокаПользователя.Пароль);			
		ПараметрыПользователя.Вставить("barcode", 		СтрокаПользователя.Штрихкод);		
		ПараметрыПользователя.Вставить("groupId", 		СтрокаПользователя.ИдГруппы);		
		ПараметрыПользователя.Вставить("groupName", 	СтрокаПользователя.ИмяГруппы);		
		ПараметрыПользователя.Вставить("warehouseIds",  СтрокаПользователя.ИдСкладов.ВыгрузитьЗначения());				
				
		// Склады для кома-режима                       
		СтрокаПользователя.ИдСкладов.ЗаполнитьПометки(Истина);
		ПараметрыПользователя.Вставить("allWarehouses", СтрокаПользователя.ИдСкладов);		
				
		ЗагрузкаПользователя = _ЛокКонтекст.ЛокЯдро_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя);                                
		Если ЗагрузкаПользователя <> Неопределено И Не ЗагрузкаПользователя.Результат Тогда
			ЕстьОшибки = Истина;
			Сообщение = НСтр("ru = 'Не удалось создать нового пользователя ""%1"". Причина: %2. Подробности в журнале регистрации';
								|en = 'Failed to create a new user ""%1"". Reason: %2. Details in the registration log';
								|be = 'Не атрымалася стварыць новага карыстальніка ""%1"". Прычына: %2. Падрабязнасці ў часопісе рэгістрацыі'; es = 'No se pudo crear un nuevo usuario ""%1"". Causa: %2. Detalles en el registro'; ka = 'ვერ შექმნა ახალი მომხმარებელი ""%1"". მიზეზი: %2. დეტალები სარეგისტრაციო ჟურნალში'; kk = 'Жаңа ""%1 "" пайдаланушысын құру мүмкін болмады. Себебі: %2. Тіркеу журналындағы мәліметтер'; ro = 'Nu a reușit să creeze un utilizator nou ""%1"". Motiv: %2. Detalii în Jurnalul de înregistrare'; tr = 'Yeni bir kullanıcı ""%1"" oluşturulamadı. Nedeni: %2. Kayıt defterindeki ayrıntılar'; uk = 'Не вдалося створити нового користувача ""%1"". Причина: %2. Подробиці в журналі реєстрації'; uz = 'Yangi ""%1 "" foydalanuvchisini yaratib bo''lmadi. Sababi: %2. Ro''yxatdan o''tish jurnalidagi tafsilotlar'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СтрокаПользователя.Имя, ЗагрузкаПользователя.ТекстОшибки);
			Сообщить(Сообщение); 
		Иначе
			МассивСтрокКУдалению.Добавить(СтрокаПользователя);			
		КонецЕсли;                                               
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			ТаблицаПользователейMS.Удалить(СтрокаКУдалению);
		КонецЦикла;		
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии);
			КонецЕсли;
		#КонецЕсли

		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Ок Тогда
		СохранитьВФайл(Неопределено);
		ЗаписатьИЗакрыть(Неопределено);
	Иначе
		пСообщение = НСтр("ru = 'Необходимо сохранить данные пользователей Клеверенс в файл.';
							|en = 'It is necessary to save the data of the Cleverence users to a file.';
							|be = 'Неабходна захаваць дадзеныя карыстальнікаў Cleverence ў файл.'; es = 'Debe guardar los datos de los usuarios de Cleverence en un archivo.'; ka = 'აუცილებელია Cleverence მომხმარებლების მონაცემების შენახვა ფაილში.'; kk = 'Cleverence пайдаланушыларының деректерін файлға сақтау қажет.'; ro = 'Este necesar să salvați datele utilizatorilor Cleverence într-un fișier.'; tr = 'Cleverence kullanıcılarının verilerini bir dosyaya kaydetmeniz gerekir.'; uk = 'Необхідно зберегти дані користувачів Cleverence в файл.'; uz = 'Cleverence foydalanuvchi ma''lumotlarini faylga saqlash kerak.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры 


