/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем 
	ПредыдущееЗначение,
	НастройкаПоследовательностиБПМассивСтруктур Экспорт;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		БЛ = НСтр("ru = 'Продолжить';
					|en = 'Continue'; be = 'Прадоўжыць'; es = 'Continuar'; ka = 'გაგრძელება'; kk = 'Жалғастыру'; ro = 'Continuă'; tr = 'Devam et'; uk = 'Продовживши'; uz = 'Davom'");
		БИ = НСтр("ru = 'Прервать';
					|en = 'Abort'; be = 'Перапыніць'; es = 'Interrumpir'; ka = 'შეწყვეტა'; kk = 'Үзу'; ro = 'Abandonează'; tr = 'Kesmek'; uk = 'Перервавши'; uz = 'To''xtatish'");
		ЭтаФорма.Элементы.ДействиеПриКритическойОшибке.ФорматРедактирования = "БЛ='" + БЛ + "'; БИ='" + БИ + "'";
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	АдресТаблицыЦепочкиБизнесПроцессов = ПолучитьАдресТаблицыЦепочкиБизнесПроцессов();
	
	Результат = Новый Структура;
	Результат.Вставить("НастройкаПоследовательностиБПМассивСтруктур", _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыЦепочкиБизнесПроцессов));
	Результат.Вставить("ПрерыватьПоследовательностьПриКритическойОшибке",ПрерыватьПриКритическойОшибке);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли

	Закрыть(Результат);	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыЦепочкиБизнесПроцессов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(ОтображаемаяПоследовательностьБизнесПроцессов,Новый УникальныйИдентификатор());
	#Иначе
	    ТЗ = РеквизитФормыВЗначение("ОтображаемаяПоследовательностьБизнесПроцессов");
		Возврат ПоместитьВоВременноеХранилище(ТЗ,ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ЗаполнитьСпискиВыбора();					
	
	ЗаполнитьОтображаемыеТабличныеЧасти();
	
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	Если НЕ ЗначениеЗаполнено(РезультирующийДокумент) 
		Или ЗагружатьВТотЖе Тогда
		Элементы.РезультирующийДокумент.Видимость = Ложь;
	КонецЕсли;
	Если Не ЗагружатьВТотЖе Тогда
		Элементы.ЗагружатьВТотЖе.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Приемник,Список)
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение,Элем.Представление);	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСпискиВыбора()
	
	//ДействияПриКритическойОшибке.Добавить("Прервать", "Прервать");
	//ДействияПриКритическойОшибке.Добавить("Продолжить", "Продолжить");
	
	ИсточникиДокументаОснования.Добавить("ИсходныйДокумент", "Исходный документ");
	Если Не ЗагружатьВТотЖе Тогда
		ИсточникиДокументаОснования.Добавить("РезультирующийДокумент", "Результирующий документ");
	КонецЕсли;
	ИсточникиДокументаОснования.Добавить("ПоФакту", "По факту");
		
	//ЗаполнитьСписокВыбора(Элементы.ОтображаемаяПоследовательностьБизнесПроцессовИсточникДокументаОснования.СписокВыбора,ИсточникиДокументаОснования);
	ЗаполнитьСписокВыбора(Элементы.ОтображаемаяПоследовательностьБизнесПроцессовИсточникДокументаОснования_Синоним.СписокВыбора,ИсточникиДокументаОснования);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтображаемыеТабличныеЧасти()
	Если ЗначениеЗаполнено(НастройкаПоследовательностиБПМассивСтруктур) Тогда		
		Для Каждого СтрокаИсходнойТаблицы Из НастройкаПоследовательностиБПМассивСтруктур Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;			
			НоваяСтрока = ОтображаемаяПоследовательностьБизнесПроцессов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);			
		КонецЦикла;
		ОбновитьНомераСтрок();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНомераСтрок()
	НомерСтроки = 0;
	Для Каждого СтрокаТаблицы Из ОтображаемаяПоследовательностьБизнесПроцессов Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаТаблицы.НомерСтроки = НомерСтроки;
	КонецЦикла;
КонецПроцедуры
			
&НаКлиенте
Процедура ПоследовательностьБизнесПроцессовНазваниеБПНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;	
	ОткрытьФормуВыбораБП();    	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораБП()
	СтрокаТабличнойЧасти = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
	ПредыдущееЗначение = СтрокаТабличнойЧасти.ID_БизнесПроцесса;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборСтрокиИзТаблицы", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборСтрокиИзТаблицы", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ВыборСтрокиИзТаблицы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ОтборБП = Новый Структура(); //"ТипДокументаMS",ТипДокументаMS);
	Если СтрокаТабличнойЧасти.ИсточникДокументаОснования = "РезультирующийДокумент" Тогда
		ТипИсходногоДокумента1С = РезультирующийДокумент;
	ИначеЕсли СтрокаТабличнойЧасти.ИсточникДокументаОснования = "ИсходныйДокумент" Тогда
		ТипИсходногоДокумента1С = ДокументОснование;
	Иначе
		ТипИсходногоДокумента1С = "";	
	КонецЕсли;
	ОтборБП.Вставить("ТипИсходногоДокумента1С", ТипИсходногоДокумента1С);
	
	НастройкиОбмена = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	НайденныеСтроки = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОбмена, ОтборБП);
	Если НайденныеСтроки <> Неопределено 
		И НайденныеСтроки.Количество() > 0 Тогда		
		ПереданнаяТаблица = Новый Массив;
		ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Название,ID_БизнесПроцесса,ТипРезультирующегоДокумента1С,ТипДокументаMS,ЗагружатьВТотЖе,ТипИсходногоДокумента1С"));
		
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если НайденнаяСтрока.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтруктура = Новый Структура();
			НоваяСтруктура.Вставить("Название",НайденнаяСтрока.Название);
			НоваяСтруктура.Вставить("ID_БизнесПроцесса",НайденнаяСтрока.ID_БизнесПроцесса);
			НоваяСтруктура.Вставить("ТипРезультирующегоДокумента1С",НайденнаяСтрока.ТипРезультирующегоДокумента1С);
			НоваяСтруктура.Вставить("ТипДокументаMS",НайденнаяСтрока.ТипДокументаMS);
			НоваяСтруктура.Вставить("ТипИсходногоДокумента1С",НайденнаяСтрока.ТипИсходногоДокумента1С);
			НоваяСтруктура.Вставить("ЗагружатьВТотЖе",НайденнаяСтрока.ЗагружатьВТотЖе);
			
			ПереданнаяТаблица.Добавить(НоваяСтруктура);
		КонецЦикла;
	Иначе
		Сообщение = НСтр("ru = 'Для выбранного источника не удалось подобрать бизнес процесс';
							|en = 'Couldn''t find a business process for the selected source';
							|be = 'Для абранага крыніцы не ўдалося падабраць бізнес працэс'; es = 'No se pudo seleccionar el proceso de negocio para el origen seleccionado'; ka = 'ვერ მოიძებნა ბიზნეს პროცესი შერჩეული წყაროსთვის'; kk = 'Таңдалған дереккөз үшін бизнес процесті таңдау мүмкін болмады'; ro = 'Nu s-a putut găsi un proces de afaceri pentru sursa selectată'; tr = 'Seçilen kaynak için iş süreci seçilemedi'; uk = 'Для обраного джерела не вдалося підібрати бізнес процес'; uz = 'Tanlangan manba uchun biznes jarayonini tanlash mumkin emas edi'");
		Сообщить(Сообщение); 
		Возврат;
		ПереданнаяТаблица = Неопределено;
	КонецЕсли;
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ПереданнаяТаблица = ПереданнаяТаблица;	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы = "БизнесПроцессыДляЗагрузки";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст = _ЛокКонтекст;
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВыборСтрокиИзТаблицыЗакрытие",ЭтаФорма);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();	
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСлужебная_ВыборСтрокиИзТаблицыЗакрытие(РезультатВыбора,СтрокаНастройки) Экспорт
	Если ЗначениеЗаполнено(РезультатВыбора) И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		Если ПредыдущееЗначение = РезультатВыбора.Данные.ID_БизнесПроцесса Тогда
			Возврат;
		КонецЕсли;
		
		НайдСтроки = ОтображаемаяПоследовательностьБизнесПроцессов.НайтиСтроки(Новый Структура("ID_БизнесПроцесса",РезультатВыбора.Данные.ID_БизнесПроцесса));
		Если НайдСтроки.Количество() = 0 Тогда
			// Изменяем строку
			ДанныеВыбранногоБП = РезультатВыбора.Данные;
			СтрокаТабличнойЧасти = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
			
			СтрокаТабличнойЧасти.ID_БизнесПроцесса 				= ДанныеВыбранногоБП.ID_БизнесПроцесса;
			СтрокаТабличнойЧасти.НазваниеБП 					= ДанныеВыбранногоБП.Название;
			
			СтрокаТабличнойЧасти.ТипИсходногоДокумента1С 		= ДанныеВыбранногоБП.ТипИсходногоДокумента1С;
			СтрокаТабличнойЧасти.ТипРезультирующегоДокумента1С 	= ДанныеВыбранногоБП.ТипРезультирующегоДокумента1С;
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ТипИсходногоДокумента1С) Тогда
				СтрокаТабличнойЧасти.ТипИсходногоДокумента1С_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[СтрокаТабличнойЧасти.ТипИсходногоДокумента1С].Синоним;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ТипРезультирующегоДокумента1С) Тогда
				СтрокаТабличнойЧасти.ТипРезультирующегоДокумента1С_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[СтрокаТабличнойЧасти.ТипРезультирующегоДокумента1С].Синоним;
			КонецЕсли;
			
		Иначе
			Сообщение = НСтр("ru = 'Данный БП уже участвует в цепочке';
								|en = 'This Business process is already involved in the chain'; be = 'Дадзены бізнэс працэс ужо ўдзельнічае ў ланцужку'; es = 'Este proceso de Negocio ya está involucrado en la cadena'; ka = 'ეს ბიზნეს პროცესი უკვე ჩართულია ჯაჭვში'; kk = 'Бұл Бизнес процесс қазірдің өзінде тізбекке қатысады'; ro = 'Acest proces de afaceri este deja implicat în lanț'; tr = 'Bu iş süreci zaten zincire katılıyor'; uk = 'Даний бізнес процес вже бере участь в ланцюжку'; uz = 'Ushbu biznes jarayoni allaqachon zanjirda ishtirok etmoqda'");
			Сообщить(Сообщение); 
		КонецЕсли;
	КонецЕсли;
	ОбновитьНомераСтрок();
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемаяПоследовательностьБизнесПроцессовИсточникДокументаОснования_СинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИсточникДокументаОснования;
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемаяПоследовательностьБизнесПроцессовИсточникДокументаОснования_СинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
	НайденныйЭлементСписка = ИсточникиДокументаОснования.НайтиПоЗначению(ТекущаяСтрока.ИсточникДокументаОснования_Синоним);
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		НайденныйЭлементСписка = ИсточникиДокументаОснования.НайтиПоЗначению("ПоФакту");
	КонецЕсли;
	
	Если НайденныйЭлементСписка <> Неопределено 
		И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ИсточникДокументаОснования_Синоним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ИсточникДокументаОснования = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.ID_БизнесПроцесса = "";
		ТекущаяСтрока.НазваниеБП = "";
		ТекущаяСтрока.ТипИсходногоДокумента1С = "";
		ТекущаяСтрока.ТипИсходногоДокумента1С_Синоним = "";
		ТекущаяСтрока.ТипРезультирующегоДокумента1С = "";
		ТекущаяСтрока.ТипРезультирующегоДокумента1С_Синоним = "";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемаяПоследовательностьБизнесПроцессовУсловиеВыполненияБизнесПроцессаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ПроизвольныеКоды = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеКоды", ЭтаФорма);
	#Иначе
		ФормаСписка_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеКоды", , ЭтаФорма, ЭтаФорма);
		ФормаСписка_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	#КонецЕсли
	
	ФормаСписка_ПроизвольныеКоды._ЛокКонтекст = _ЛокКонтекст;
	ФормаСписка_ПроизвольныеКоды.КлючНастройки = "Настройка_УсловиеВыполненияБизнесПроцесса";
		
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКоды_ПослеВыбораУсловияВыполненияБизнесПроцесса", ЭтаФорма);
	ФормаСписка_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		ФормаСписка_ПроизвольныеКоды.Открыть();		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКоды_ПослеВыбораУсловияВыполненияБизнесПроцесса(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
	
	Отбор = Новый Структура("Направление,ТипОбъекта", "Настройка", "УсловиеВыполненияБизнесПроцесса");
	
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	
	СтрокаПроизволтногоКода = Неопределено;
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыбранноеЗначение = СтрокаТЗ.ID_ПроизвольногоКода Тогда
				СтрокаПроизвольногоКода = СтрокаТЗ;
				Прервать;
			КонецЕсли;
						
		КонецЦикла;
	КонецЕсли;
	
	Если СтрокаПроизвольногоКода = Неопределено Тогда
		ТекущаяСтрока.УсловиеВыполненияБизнесПроцессаПредставление = "";
		ТекущаяСтрока.УсловиеВыполненияБизнесПроцессаКод = "";
	Иначе
		ТекущаяСтрока.УсловиеВыполненияБизнесПроцессаПредставление = СтрокаПроизвольногоКода.Наименование;
		ТекущаяСтрока.УсловиеВыполненияБизнесПроцессаКод = СтрокаПроизвольногоКода.ID_ПроизвольногоКода;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтображаемаяПоследовательностьБизнесПроцессовУсловиеВыполненияБизнесПроцессаПредставлениеОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОтображаемаяПоследовательностьБизнесПроцессов.ТекущиеДанные;
	
	ТекущиеДанные.УсловиеВыполненияБизнесПроцессаПредставление = "";
	ТекущиеДанные.УсловиеВыполненияБизнесПроцессаКод = "";
			
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда		

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
	
#КонецЕсли