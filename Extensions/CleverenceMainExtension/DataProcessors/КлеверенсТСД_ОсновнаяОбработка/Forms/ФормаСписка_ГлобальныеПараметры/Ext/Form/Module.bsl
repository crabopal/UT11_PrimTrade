/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ?(ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла), " """+ ЭтаФорма.НаименованиеУзла +"""","");
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;
	#КонецЕсли
	ТаблицаПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(, ЗначениеЗаполнено(ID_Узла));
	
	// Если по данному ключу отсутствует настройка, то возвращается значение Ложь, поэтому используем проверку
	Если ТаблицаПараметров <> Ложь И ЗначениеЗаполнено(ТаблицаПараметров) Тогда
		Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
			Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ГлобальныеПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПараметра);
			
			Если НЕ СтрокаПараметра.Свойство("Типовой") Тогда
				НоваяСтрока.Типовой = Ложь;
			КонецЕсли;
			НоваяСтрока.Картинка = ?(НЕ НоваяСтрока.Типовой, БиблиотекаКартинок.Пользователь, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки);
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ГлобальныеПараметры.Колонки.ГлобальныеПараметрыИспользование.Видимость = Ложь;
		#Иначе
			Элементы.ГлобальныеПараметрыИспользование.Видимость = Ложь;
		#КонецЕсли
	Иначе
		Элементы.ГлобальныеПараметры.ИзменятьСоставСтрок = Ложь;
	КонецЕсли;
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	Сохранить("");
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ЧастнаяБаза,,,,ОП);
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 		
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ГлобальныеПараметры.ТекущиеДанные;
		ТекущиеДанные.ID_Параметра = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("NDS");
		ТекущиеДанные.Типовой	   = Ложь;
		ТекущиеДанные.Картинка	   = БиблиотекаКартинок.Пользователь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда
		ТекущаяСтрока = Элемент.ТекущиеДанные;
		ЗаполнитьСправочнуюИнформациюСтрокиПараметров(ТекущаяСтрока);
	КонецЕсли;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыПослеУдаления(Элемент)
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыЗначениеПриИзменении(Элемент)
	Элемент.КнопкаОчистки = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Элемент.ВыбиратьТип = ТипЗнч(ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.Значение) = Тип("Неопределено");
	Элемент.КнопкаОчистки = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыЗначениеОчистка(Элемент, СтандартнаяОбработка)
	ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.Тип = Неопределено;
	Элемент.ВыбиратьТип = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСлужебныеКолонки(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГлобальныеПараметры.Колонки.ГлобальныеПараметрыID_Параметра.Видимость = Истина;		
	#Иначе
		Элементы.ГлобальныеПараметрыID_Параметра.Видимость = Истина;		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗначенияПоУмолчанию(Команда)
	
	ОП = Новый ОписаниеОповещения("ВосстановитьЗначенияПослеПодключения", ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,, ЧастнаяБаза,,,, ОП);
	ЭтаФорма.Модифицированность = Ложь;
		
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗначенияПослеПодключения(СерверДоступен, ДополнительныеПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		ТекстПредупреждения = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек!';
									|en = 'The Cleverence server is currently unavailable for saving settings!';
									|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад!'; es = '¡El servidor Cleverence no está disponible para guardar la configuración en este momento!'; ka = 'Cleverence სერვერი ამჟამად მიუწვდომელია პარამეტრების შესანახად!'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес!'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor!'; tr = 'Şu anda, ayarlarınızı kaydetmek için Cleverence sunucusu kullanılamıyor!'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань!'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas!'");
		ПоказатьПредупреждение(, ТекстПредупреждения,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	ОповещениеПослеОтветаНаВопрос = Новый ОписаниеОповещения("ВосстановитьЗначенияПоУмолчаниюЗавершение", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Вы уверены, что хотите сбросить значения глобальных параметров?';
							|en = 'Are you sure you want to reset the values of the global parameters?';
							|be = 'Вы ўпэўненыя, што хочаце скінуць значэння глабальных параметраў?'; es = '¿Estás seguro de que quieres restablecer los valores de los parámetros globales?'; ka = 'დარწმუნებული ხართ, რომ გსურთ გლობალური პარამეტრების ღირებულებების გადატვირთვა?'; kk = 'Сіз жаһандық параметрлердің мәндерін қалпына келтіргіңіз келетініне сенімдісіз бе?'; ro = 'Sunteți sigur că doriți să resetați parametrii globali?'; tr = 'Global parametrelerin değerlerini sıfırlamak istediğinizden emin misiniz?'; uk = 'Ви впевнені, що хочете скинути значення глобальних параметрів?'; uz = 'Global parametr qiymatlarini tiklashni xohlayotganingizga aminmisiz?'");
	Если ЗначениеЗаполнено(ID_Узла) Тогда		
		ПоказатьВопрос(ОповещениеПослеОтветаНаВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе		
		ЕстьУзлы = Ложь;
		ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
		Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ЕстьУзлы = Истина;
				Прервать;			
			КонецЦикла;
		КонецЕсли;
	
		Если ЕстьУзлы Тогда
			СписокКнопок = Новый СписокЗначений;
			Текст = НСтр("ru = 'Да (для текущего торгового объекта)';
							|en = 'Yes (for the current shopping facility)'; be = 'Так (для бягучага гандлёвага аб''екта)'; es = 'Sí (para el objeto comercial actual)'; ka = 'დიახ (მიმდინარე სავაჭრო ობიექტისთვის)'; kk = 'Иә (ағымдағы сауда нысаны үшін)'; ro = 'Da (pentru actualul centru comercial)'; tr = 'Evet (mevcut ticaret tesisi için)'; uk = 'Так (для поточного торгового об''єкта)'; uz = 'Ha (hozirgi savdo ob''ekti uchun)'");
			СписокКнопок.Добавить("ДляТекущегоУзла", 		Текст);
			Текст = НСтр("ru = 'Да (для всех торговых объектов)';
							|en = 'Yes (for all retail locations)'; be = 'Так (для ўсіх гандлёвых аб''ектаў)'; es = 'Sí (para todos los establecimientos comerciales)'; ka = 'დიახ (ყველა საცალო ადგილას)'; kk = 'Иә (барлық сауда нысандары үшін)'; ro = 'Da (pentru toate locațiile de vânzare cu amănuntul)'; tr = 'Evet (tüm ticari tesisler için)'; uk = 'Так (для всіх торгових об''єктів)'; uz = 'Ha (barcha savdo ob''ektlari uchun)'");
			СписокКнопок.Добавить("ДляВсехУзлов", 	 		Текст);
			Текст = НСтр("ru = 'Отмена';
							|en = 'Cancel'; be = 'Адмена'; es = 'Cancelación'; ka = 'გაუქმება'; kk = 'Бас тарту'; ro = 'Anulează'; tr = 'İptal'; uk = 'Скасування'; uz = 'Bekor qilish'");
			СписокКнопок.Добавить(КодВозвратаДиалога.Нет,	Текст);
		Иначе
			СписокКнопок = РежимДиалогаВопрос.ДаНет;
		КонецЕсли;
			
		ПоказатьВопрос(ОповещениеПослеОтветаНаВопрос, ТекстВопроса, СписокКнопок,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗначенияПоУмолчаниюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;	
	КонецЕсли;
	
	ГлобальныеПараметры_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_ПоУмолчанию");
	Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) ИЛИ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		ГлобальныеПараметры_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_ПоУмолчанию");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) ИЛИ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		ГлобальныеПараметры_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) ИЛИ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		ТекстПредупреждения = НСтр("ru = 'Не удалось получить значения глобальных параметров по умолчанию!';
									|en = 'Couldn''t get the default global parameter values!';
									|be = 'Не атрымалася атрымаць значэння глабальных параметраў па змаўчанні!'; es = '¡No se pudieron obtener los valores predeterminados de los parámetros globales!'; ka = 'ვერ მიიღეთ ნაგულისხმევი გლობალური პარამეტრის მნიშვნელობები!'; kk = 'Әдепкі жаһандық параметрлердің мәндерін алу мүмкін болмады!'; ro = 'Nu am putut obține valorile implicite ale parametrilor globali!'; tr = 'Global parametrelerin varsayılan değerleri alınamadı!'; uk = 'Не вдалося отримати значення глобальних параметрів за замовчуванням!'; uz = 'Global parametrlarning standart qiymatlarini olish mumkin emas!'");
		ПоказатьПредупреждение(, ТекстПредупреждения,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;		
	КонецЕсли;

	Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
		Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;			
		КонецЕсли;
		
		НайденныеСтроки = ГлобальныеПараметры.НайтиСтроки(Новый Структура("ID_Параметра", СтрокаПараметра.ID_Параметра));
		Если НайденныеСтроки.Количество() Тогда
			Для каждого НайденнаяСтрока ИЗ НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтрокаПараметра);
				ЗаполнитьСправочнуюИнформациюСтрокиПараметров(НайденнаяСтрока);
				
				НайденнаяСтрока.Использование = ?(НЕ ЗначениеЗаполнено(ID_Узла), Истина, СтрокаПараметра.Использование);
				НайденнаяСтрока.Типовой  	  = Истина;
				НайденнаяСтрока.Картинка 	  = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			КонецЦикла;
		Иначе	
			НоваяСтрока = ГлобальныеПараметры.Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПараметра);
			ЗаполнитьСправочнуюИнформациюСтрокиПараметров(НоваяСтрока);
			
			НоваяСтрока.Использование = ?(НЕ ЗначениеЗаполнено(ID_Узла), Истина, СтрокаПараметра.Использование);
			НоваяСтрока.Типовой  	  = Истина;
			НоваяСтрока.Картинка 	  = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
		КонецЕсли;
	КонецЦикла;
	
	СохранитьНастройки();
	
	Если РезультатВопроса = "ДляВсехУзлов" Тогда
		ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
		Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
			Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
                КонецЕсли;
				
				ГлобальныеПараметры_Значения = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения", СтрокаУзла.ID_Узла);
				Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_Значения) ИЛИ ГлобальныеПараметры_Значения = Ложь Тогда
					Продолжить;
                КонецЕсли;

				Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
					Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;			
					КонецЕсли;
					
					НайденнаяСтрока = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденнаяСтрока <> Неопределено Тогда
						ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтрокаПараметра);
						НайденнаяСтрока.Вставить("Типовой", Истина);
					КонецЕсли;
				КонецЦикла;
				
				_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Значения, СтрокаУзла.ID_Узла);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Импорт");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЭкспортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКопированияНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Копирование");
КонецПроцедуры

#КонецОбласти

#Область ОбщиеМеханизмы

&НаКлиенте
Процедура СохранитьНастройки()
		
	МассивПараметров = ПолучитьМассивПараметров(НЕ ЗначениеЗаполнено(ID_Узла)); 
	Если ЗначениеЗаполнено(ID_Узла) Тогда
    	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", 			МассивПараметров, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры_Значения", 			МассивПараметров);
	Иначе
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", 			МассивПараметров.ГлобальныеПараметры_Значения, ID_Узла);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры_Значения", 			МассивПараметров.ГлобальныеПараметры_Значения);
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Пользовательские", 	МассивПараметров.ГлобальныеПараметры_Пользовательские);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры_Пользовательские", 	МассивПараметров.ГлобальныеПараметры_Пользовательские);
		
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	 
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивПараметров(ПолучитьПользовательскиеПараметры = Ложь)

	ГлобальныеПараметры_Значения = Новый Массив;
	ГлобальныеПараметры_Значения.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Типовой, Использование, Наименование, Значение, ID_Параметра, Комментарий"));
	
	ГлобальныеПараметры_Пользовательские = Новый Массив;
	ГлобальныеПараметры_Пользовательские.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Типовой, Использование, Наименование, Значение, ID_Параметра, Комментарий"));
	
	Для Каждого Строка Из ГлобальныеПараметры Цикл
		Параметр = Новый Структура("Типовой, Использование, Наименование, Значение, ID_Параметра, Комментарий", Строка.Типовой, Строка.Использование, Строка.Наименование, Строка.Значение, Строка.ID_Параметра, Строка.Комментарий);
		ГлобальныеПараметры_Значения.Добавить(Параметр);
		
		Если ПолучитьПользовательскиеПараметры
			И НЕ Строка.Типовой Тогда
			ГлобальныеПараметры_Пользовательские.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;
	
	Если ПолучитьПользовательскиеПараметры Тогда
		Возврат Новый Структура("ГлобальныеПараметры_Значения, ГлобальныеПараметры_Пользовательские", ГлобальныеПараметры_Значения, ГлобальныеПараметры_Пользовательские);
	Иначе
		Возврат ГлобальныеПараметры_Значения;		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСправочнуюИнформациюСтрокиПараметров(СтрокаПараметра)

	Если СтрокаПараметра <> Неопределено Тогда
		СтрокаПараметра.Тип = Строка(ТипЗнч(СтрокаПараметра.Значение));
		СтрокаПараметра.ЗначениеПоУмолчанию = СтрокаПараметра.Значение;
		
		СинонимДляЗапроса = СтрокаПараметра.Наименование; 
		СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, " ", "_");
		СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, "(", "");
		СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, ")", "");
		СтрокаПараметра.СинонимДляЗапроса = СинонимДляЗапроса; 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры 

#КонецОбласти

#Область ТолстыйКлиентОбычноеПриложение

&НаКлиенте
Процедура ГлобальныеПараметрыПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	
	СинонимДляЗапроса = Элементы.ГлобальныеПараметры.ТекущиеДанные.Наименование;
	СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, " ", "_");
	СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, "(", "");
	СинонимДляЗапроса = СтрЗаменить(СинонимДляЗапроса, ")", "");
	
	Элементы.ГлобальныеПараметры.ТекущиеДанные.СинонимДляЗапроса = СинонимДляЗапроса;
	
	// Отображение картинки
	ОформлениеСтроки.Ячейки.ГлобальныеПараметрыКартинка.ОтображатьКартинку = Истина;
	ОформлениеСтроки.Ячейки.ГлобальныеПараметрыКартинка.ОтображатьТекст	   = Ложь;
	
	Если ДанныеСтроки.Типовой = Истина Тогда
		ОформлениеСтроки.Ячейки.ГлобальныеПараметрыКартинка.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
	Иначе
		ОформлениеСтроки.Ячейки.ГлобальныеПараметрыКартинка.Картинка = БиблиотекаКартинок.Пользователь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли
