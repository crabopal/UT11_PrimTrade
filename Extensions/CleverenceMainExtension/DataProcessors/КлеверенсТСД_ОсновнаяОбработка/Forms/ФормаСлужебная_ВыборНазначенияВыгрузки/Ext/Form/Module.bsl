/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ПользователиMSАдрес Экспорт, УстройстваMSАдрес Экспорт;
	
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		БЛ = НСтр("ru = 'по внутренней сети';
					|en = 'over the internal network'; be = 'па ўнутранай сеткі'; es = 'en la red interna'; ka = 'შიდა ქსელში'; kk = 'ішкі желі арқылы'; ro = 'prin rețeaua internă'; tr = 'dahili ağ üzerinden'; uk = 'по внутрішній мережі'; uz = 'ichki tarmoq orqali'");
		БИ = НСтр("ru = 'через Интернет';
					|en = 'via the Internet'; be = 'праз Інтэрнэт'; es = 'vía Internet'; ka = 'ინტერნეტის საშუალებით'; kk = 'Интернет арқылы'; ro = 'prin Internet'; tr = 'İnternet üzerinden'; uk = 'через Інтернет'; uz = 'Internet orqali'");
		ЭтаФорма.Элементы.ВыгрузкаНаУстройство.ФорматРедактирования = "БЛ='" + БЛ + "'; БИ='" + БИ + "'";
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии()	
	
	ЗагрузитьДеревоПользователейНаСервере(ЭтаФорма.ПользователиMSАдрес, ЭтаФорма.УстройстваMSАдрес);
	
	УстановитьДоступностьТаблиц();	
	
	// Восстановление изначальных размеров формы, если она была изменена пользователем (программное нажатие Alt+Shift+R)
	Попытка
		WSHShell=Новый COMObject("WScript.Shell");;
		WSHShell.SendKeys("%+(R)"); 	
	Исключение	
	КонецПопытки;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура Выгрузить(Команда)

	Если ВыгрузкаНаУстройство Тогда    		
		
		Если Не ПинКодВведен Тогда
			
			ФормированиеТаблицыУстройствНазначенияВыгрузки(Истина);
			
		Иначе
			
			ЗначениеПинКода = СтрЗаменить(ПинКод, " ", "");	
			
			Если ПустаяСтрока(ЗначениеПинКода) Тогда 
				ТекстПредупреждения = НСтр("ru = 'Заполните пин-код или выберите устройство из списка.';
											|en = 'Fill in the PIN code or select a device from the list.';
											|be = 'Запоўніце пін-код або абярыце прыладу з спісу.'; es = 'Rellene el PIN o seleccione el dispositivo de la lista.'; ka = 'შეავსეთ PIN კოდი ან აირჩიეთ მოწყობილობა სიიდან.'; kk = 'ПИН-кодты толтырыңыз немесе тізімнен құрылғыны таңдаңыз.'; ro = 'Completați codul PIN sau selectați un dispozitiv din listă.'; tr = 'Pın kodunu doldurun veya listeden bir cihaz seçin.'; uk = 'Заповніть PIN-код або виберіть пристрій зі списку.'; uz = 'PIN-kodni to''ldiring yoki ro''yxatdan qurilmani tanlang.'");
				ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
				Возврат;
			ИначеЕсли СтрДлина(ЗначениеПинКода) < 4 Тогда
				ТекстПредупреждения = НСтр("ru = 'Пин-код введен не полностью!';
											|en = 'The PIN code is not fully entered!'; be = 'Пін-код уведзены не цалкам!'; es = '¡El código PIN no está completamente introducido!'; ka = 'PIN კოდი სრულად არ არის შეყვანილი!'; kk = 'PIN коды толық енгізілмеген!'; ro = 'Codul PIN nu este introdus complet!'; tr = 'Pın kodu tam olarak girilmedi!'; uk = 'Пін-код введений не повністю!'; uz = 'PIN-kod to''liq kiritilmagan!'");
				ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
				Возврат;
			Иначе
				СтрЦифр = "0123456789";		
				Для Инд = 1 По СтрДлина(ЗначениеПинКода) Цикл
					ПроверяемыйСимвол = Сред(ЗначениеПинКода, Инд, 1);
					Если _ЛокКонтекст.ЛокЯдро_СтрНайти(СтрЦифр, ПроверяемыйСимвол) = 0 Тогда
						ТекстПредупреждения = НСтр("ru = 'Ошибка: пин-код должен состоять только из цифр!';
													|en = 'Error: The PIN code must consist of numbers only!'; be = 'Памылка: пін-код павінен складацца толькі з лічбаў!'; es = 'Error: ¡el PIN debe consistir solo en números!'; ka = 'შეცდომა: PIN კოდი უნდა შედგებოდეს მხოლოდ ციფრებისგან!'; kk = 'Қате: PIN коды тек сандардан тұруы керек!'; ro = 'Eroare: codul PIN trebuie să conțină numai numere!'; tr = 'Hata: Pın kodu yalnızca rakamlardan oluşmalıdır!'; uk = 'Помилка: PIN-код повинен складатися лише з цифр!'; uz = 'Xato: PIN-kod faqat raqamlardan iborat bo''lishi kerak!'");
						ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
						Возврат;					
					КонецЕсли;				
				КонецЦикла;   		
			КонецЕсли;
			
			Если ЗначениеПинКода = Неопределено Тогда
				ЗначениеПинКода = Ложь;
			КонецЕсли;
			
			НазначенныеУстройства = _ЛокКонтекст.ЛокЯдро_ПолучениеУстройстваПоПинкодуДляВыгрузкиДокумента(ЗначениеПинКода, ТипБазы);
			
			Если НазначенныеУстройства <> Неопределено 
				И ТипЗнч(НазначенныеУстройства) = Тип("Массив")
				И НазначенныеУстройства.Количество() > 0 Тогда
				
				НазначенныеУстройстваАдрес = ПоместитьВоВременноеХранилище(НазначенныеУстройства);	
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
						ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, НазначенныеУстройстваАдрес);					
					КонецЕсли;
				#КонецЕсли
				Закрыть(НазначенныеУстройстваАдрес);	
												
			Иначе
				
				Если НазначенныеУстройства = Неопределено Тогда
					СообщениеПользователю = НСтр("ru = 'Введен некорректный пин-код!';
													|en = 'Incorrect PIN code has been entered!'; be = 'Уведзены некарэктны пін-код!'; es = '¡Código PIN incorrecto introducido!'; ka = 'არასწორი PIN კოდი შევიდა!'; kk = 'Қате пин-код енгізілді!'; ro = 'Codul PIN incorect a fost introdus!'; tr = 'Yanlış bir pın kodu girildi!'; uk = 'Введено некоректний пін-код!'; uz = 'Noto''g''ri PIN kod kiritildi!'");
				Иначе
					СообщениеПользователю = НСтр("ru = 'Устройство по пин-коду не найдено!';
													|en = 'The PIN code device was not found!'; be = 'Прылада па пін-коду не знойдзена!'; es = 'Dispositivo por PIN no encontrado!'; ka = 'პინ კოდის მოწყობილობა ვერ მოიძებნა!'; kk = 'Пин-код бойынша құрылғы табылмады!'; ro = 'Dispozitivul cu cod PIN nu a fost găsit!'; tr = 'Pın koduna göre cihaz bulunamadı!'; uk = 'Пристрій по пін-коду не знайдено!'; uz = 'PIN-kod qurilmasi topilmadi!'");
				КонецЕсли;
				
				ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), СообщениеПользователю); 
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;

	Иначе
		
		МассивПользователейMS = Новый Массив;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			СформироватьМассивПользователейMS(ПользователиMS.Строки, МассивПользователейMS);			
			Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, МассивПользователейMS);
			КонецЕсли;
		#Иначе
			СформироватьМассивПользователейMS(ПользователиMS.ПолучитьЭлементы(), МассивПользователейMS);			
		#КонецЕсли
		
		Закрыть(МассивПользователейMS);                                                                 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаНаУстройствоПриИзменении(Элемент)

	УстановитьДоступностьТаблиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсе(Команда)
	
	СтрокиИсключения = Новый Массив;
	СтрокиИсключения.Добавить("Выгружать всем");
	СтрокиИсключения.Добавить("Спрашивать при выгрузке");	
	
	ИзменитьФлажки(Истина, Неопределено, СтрокиИсключения);	
	РазвернутьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВыделение(Команда)
	
	ИзменитьФлажки(Ложь);	
	РазвернутьДерево();
		
КонецПроцедуры 

&НаКлиенте
Процедура ПинКодИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	ОбработкаВводаТекстаПинКода(Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПинКодОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)
	
	ОбработкаВводаТекстаПинКода(Текст);
	
КонецПроцедуры    

&НаКлиенте
Процедура ОбработкаВводаТекстаПинКода(Текст)

	Если СтрДлина(СокрЛП(Текст)) = 4 Тогда                       				
		#Если Не ТолстыйКлиентОбычноеПриложение Тогда		
			ТекущийЭлемент 							= Элементы.ФормаЗагрузить;					
		#КонецЕсли
		Элементы.ТаблицаУстройстваMS.Доступность 	= Ложь;		
		ПинКодВведен 								= Истина;
	Иначе
		Элементы.ТаблицаУстройстваMS.Доступность 	= Истина;		
		ПинКодВведен 								= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУстройстваMSВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
    ФормированиеТаблицыУстройствНазначенияВыгрузки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПользователиMSВыгружатьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПользователиMS.ТекущиеДанные;		
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 	
	
	Если ТекДанные.Выгружать Тогда		
		
		Если Найти(ВРег(СокрЛП("Выгружать всем")), ВРег(СокрЛП(ТекДанные.ИдГруппыПользователя))) > 0 Тогда			
			СтрокиИсключения = Новый Массив;
			СтрокиИсключения.Добавить(ТекДанные.ИдГруппыПользователя);		
			СтрокиДляИзменения = Неопределено;
		Иначе
			СтрокиДляИзменения = Новый Массив;
			СтрокиДляИзменения.Добавить("Выгружать всем");			
			СтрокиИсключения = Неопределено;
		КонецЕсли;			
		
		ИзменитьФлажки(Ложь, СтрокиДляИзменения, СтрокиИсключения);			
		РазвернутьДерево();		  
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьДеревоПользователейНаСервере(ПользователиMSАдрес, УстройстваMSАдрес)
	
	ДеревоПользователейMS 	= ПолучитьИзВременногоХранилища(ПользователиMSАдрес);	
	ДеревоУстройствMS 		= ПолучитьИзВременногоХранилища(УстройстваMSАдрес);	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		УстройстваMS 	= ДеревоУстройствMS;
		ПользователиMS 	= ДеревоПользователейMS;		
	#Иначе  
		ЗначениеВРеквизитФормы(ДеревоПользователейMS, 	"ПользователиMS");
		ЗначениеВРеквизитФормы(ДеревоУстройствMS, 		"УстройстваMS");		
	#КонецЕсли
    
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьКВыгрузкеСтрокуДереваПользователейПоЗначению(СписокЭлементов, МассивЗначений, Счетчик)
	
	Для Каждого СтрокаПользователь Из СписокЭлементов Цикл  
		Для Каждого Значение Из МассивЗначений Цикл
			Если СтрокаПользователь.ИдГруппыПользователя = Значение Тогда
				СтрокаПользователь.Выгружать = Истина;     
				Счетчик = Счетчик - 1;
				Продолжить;  			
			КонецЕсли;
		КонецЦикла;                   
		Если Счетчик = 0 Тогда
			Прервать;
		КонецЕсли;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ОтметитьКВыгрузкеСтрокуДереваПользователейПоЗначению(СтрокаПользователь.Строки, МассивЗначений, Счетчик);
		#Иначе
			ОтметитьКВыгрузкеСтрокуДереваПользователейПоЗначению(СтрокаПользователь.ПолучитьЭлементы(), МассивЗначений, Счетчик);
		#КонецЕсли		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьТаблиц()
	
	ВыборНазначенияВыгрузкиНаСервер = (НазначитьПользователю = "Спрашивать при выгрузке" 
		Или НазначитьПользователю = "Конкретному устройству" Или ПустаяСтрока(НазначитьПользователю));	
		
	Элементы.ГруппаПользователиMS.Видимость 			= Не ВыгрузкаНаУстройство;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НадписьПользователям.Видимость			= Не ВыгрузкаНаУстройство;
		Элементы.ПользователиMSКоманднаяПанель.Видимость= Не ВыгрузкаНаУстройство;              
		Элементы.ПользователиMS.Видимость	 			= Не ВыгрузкаНаУстройство;	
		
		Элементы.НадписьНаУстройство.Видимость 			= ВыгрузкаНаУстройство;
		Элементы.НадписьПинКод.Видимость 				= ВыгрузкаНаУстройство;
		Элементы.ПинКод.Видимость 						= ВыгрузкаНаУстройство;
		Элементы.ТаблицаУстройстваMS.Видимость 			= ВыгрузкаНаУстройство;
	#КонецЕсли
	Элементы.ТаблицаУстройстваMS.Доступность 			= СтрДлина(СокрЛП(ПинКод)) <> 4;	
	Элементы.ПользователиMS.ТолькоПросмотр 				= Не ВыборНазначенияВыгрузкиНаСервер;	
	Элементы.ПользователиMSКоманднаяПанель.Доступность	= ВыборНазначенияВыгрузкиНаСервер;	
	
	Элементы.УстройстваMS.Видимость 					= ВыгрузкаНаУстройство;
	
	Если Не ВыборНазначенияВыгрузкиНаСервер Тогда   
		
		НазначенныеПользователи = _ЛокКонтекст.ЛокЯдро_СтрРазделить(НазначитьПользователю, "|", Ложь);
		Счетчик 				= НазначенныеПользователи.Количество();
	    
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ОтметитьКВыгрузкеСтрокуДереваПользователейПоЗначению(ПользователиMS.Строки, НазначенныеПользователи, Счетчик);		
		#Иначе
			ОтметитьКВыгрузкеСтрокуДереваПользователейПоЗначению(ПользователиMS.ПолучитьЭлементы(), НазначенныеПользователи, Счетчик);		
		#КонецЕсли
	КонецЕсли;		
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПользователиMS.РежимВыделения 		= ?(ОдиночныйРежимВыделения, РежимВыделенияТабличногоПоля.Одиночный, РежимВыделенияТабличногоПоля.Множественный);
		Элементы.ТаблицаУстройстваMS.РежимВыделения = РежимВыделенияТабличногоПоля.Одиночный;
	#Иначе
		Элементы.ПользователиMS.РежимВыделения 		= ?(ОдиночныйРежимВыделения, РежимВыделенияТаблицы.Одиночный, РежимВыделенияТаблицы.Множественный);
		Элементы.ТаблицаУстройстваMS.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
	#КонецЕсли
	
	РазвернутьДерево();
	
	Если НесколькоДокументов Тогда                                                                       
		СтрокаПользователям = НСтр("ru = 'Выберите пользователя или группу пользователей, кому будут выгружены документы.';
									|en = 'Select the user or group of users to whom the documents will be uploaded.';
