&НаКлиенте
Процедура ИспользоватьТиповыеНастройкиПриИзменении(Элемент)
	
	// Текущие настройки из формы
	СтруктураНастроекФормы = ПолучитьСтруктуруНастройкиБизнесПроцесса();
	
	// Текущие пользовательские настройки
	ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
	ЗаполнитьЗначенияСвойств(ПользовательскиеНастройки, СтруктураНастроекФормы);
	
	Если ИспользоватьТиповыеНастройки Тогда
		
		// ИспользоватьТиповыеНастройки было выключено, значит сейчас в форме пользовательские настройки
		// 	получаем ПереопределяемыеНастройки, чтобы не потерять.
		РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(СтруктураНастроекТиповая, СтруктураНастроекФормы);
		ПереопределяемыеНастройки = РезультатСравнения.ИзмененныеЗначения;
		
		// Восстанавливаем типовые настройки
		ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(СтруктураНастроекТиповая);
		
	Иначе
		
		// ИспользоватьТиповыеНастройки было включено, значит сейчас в форме типовой БП.
		// Объединяем ПереопределяемыеНастройки с текущими настройками, так мы получим собранный пользовательский БП.
		Если ПереопределяемыеНастройки <> Неопределено И ЗначениеЗаполнено(ПереопределяемыеНастройки) Тогда
			ПолноеЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ОбъединитьСтруктуруНастроек(СтруктураНастроекФормы, ПереопределяемыеНастройки);
		Иначе
			ПолноеЗначениеНастройки = СтруктураНастроекФормы;
		КонецЕсли;
		ПереопределяемыеНастройки = Неопределено;
		
	КонецЕсли;
	
	// Восстанавливаем ПользовательскиеНастройки (узловые), т.к они не зависят от ИспользоватьТиповыеНастройки
	ЗаполнитьЗначенияСвойств(ПолноеЗначениеНастройки, ПользовательскиеНастройки);
	
	Если ПолноеЗначениеНастройки.Свойство("ПереопределяемыеНастройки") Тогда
		ПолноеЗначениеНастройки.Удалить("ПереопределяемыеНастройки");
	КонецЕсли;
			
	// Собранную структуру переносим в форму
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПолноеЗначениеНастройки);
	#Если ВебКлиент Тогда
		// В веб-клиенте через ЗаполнитьЗначенияСвойств не заполняются значения экспортных переменных модуля формы. Заполним их
		Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиПолей") Тогда
			НастройкаВыгрузкиПолей = ПолноеЗначениеНастройки.НастройкаВыгрузкиПолей;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("НастройкаВыгрузкиТЧ") Тогда
			НастройкаВыгрузкиТЧ = ПолноеЗначениеНастройки.НастройкаВыгрузкиТЧ;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиПолей") Тогда
			НастройкаЗагрузкиПолей = ПолноеЗначениеНастройки.НастройкаЗагрузкиПолей;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("НастройкаЗагрузкиТЧ") Тогда
			НастройкаЗагрузкиТЧ = ПолноеЗначениеНастройки.НастройкаЗагрузкиТЧ;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("СвязиТабличныхЧастей") Тогда
			СвязиТабличныхЧастей = ПолноеЗначениеНастройки.СвязиТабличныхЧастей;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("НастройкаПредставленийРеквизитовДокумента") Тогда
			НастройкаПредставленийРеквизитовДокумента = ПолноеЗначениеНастройки.НастройкаПредставленийРеквизитовДокумента;	
		КонецЕсли;
		Если ПолноеЗначениеНастройки.Свойство("НастройкаПоследовательностиБПМассивСтруктур") Тогда
			НастройкаПоследовательностиБПМассивСтруктур = ПолноеЗначениеНастройки.НастройкаПоследовательностиБПМассивСтруктур;	
		КонецЕсли;
	#КонецЕсли
	
	ЭтоТиповойБизнесПроцесс = Истина;
	Модифицированность = Истина;
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПоследовательностиБизнесПроцессовНажатие(Элемент)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СледующиеБизнесПроцессы = ПолучитьФорму("ОФ_ФормаНастройки_ПоследовательностьБизнесПроцессов", ЭтаФорма);
	#Иначе	
		ФормаНастройки_СледующиеБизнесПроцессы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПоследовательностьБизнесПроцессов", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_СледующиеБизнесПроцессы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_СледующиеБизнесПроцессы._ЛокКонтекст = _ЛокКонтекст;
	
	ФормаНастройки_СледующиеБизнесПроцессы.НазваниеБизнесПроцесса = Название;
	ФормаНастройки_СледующиеБизнесПроцессы.ID_БизнесПроцесса = ID_БизнесПроцесса;
	ФормаНастройки_СледующиеБизнесПроцессы.ДокументОснование = ТипИсходногоДокумента1С;
	Если ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ДокументОснование_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С].Синоним;
	КонецЕсли;
	
	ФормаНастройки_СледующиеБизнесПроцессы.РезультирующийДокумент = ТипРезультирующегоДокумента1С;
	Если ЗначениеЗаполнено(ТипРезультирующегоДокумента1С) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.РезультирующийДокумент_Синоним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипРезультирующегоДокумента1С].Синоним;
	КонецЕсли;
	
	ФормаНастройки_СледующиеБизнесПроцессы.ТипДокументаMS = ТипДокументаMS;
	Если ЗначениеЗаполнено(ТипДокументаMS) Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ТипДокументаMS_Синоним = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Синоним;
	КонецЕсли;
	ФормаНастройки_СледующиеБизнесПроцессы.ЗагружатьВТотЖе = ЗагружатьВТотЖе;
	ФормаНастройки_СледующиеБизнесПроцессы.ПрерыватьПриКритическойОшибке = ПрерыватьПоследовательностьПриКритическойОшибке;
	ФормаНастройки_СледующиеБизнесПроцессы.НастройкаПоследовательностиБПМассивСтруктур = НастройкаПоследовательностиБПМассивСтруктур;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_СледующиеБизнесПроцессыЗакрытие",ЭтаФорма);
	ФормаНастройки_СледующиеБизнесПроцессы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_СледующиеБизнесПроцессы.ОткрытьМодально();
	#Иначе
		ФормаНастройки_СледующиеБизнесПроцессы.Открыть();
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура СброситьПользовательскуюНастройкуНажатие(Элемент)
	
	ИмяНастройки = СтрЗаменить(Элемент.Имя, "Сбросить", "");
	
	пЗаголовок = НСтр("ru = 'Восстановить значение настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Значение настройки будет сброшено к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение", ЭтаФорма, ИмяНастройки);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

