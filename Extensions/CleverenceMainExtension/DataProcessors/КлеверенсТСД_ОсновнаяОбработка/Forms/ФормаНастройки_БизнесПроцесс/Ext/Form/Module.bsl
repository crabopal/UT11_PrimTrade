&НаКлиенте 
Процедура ОбновитьВсеДанныеЭлементовФормы()
	
	УстановитьЦветаЭлементов();
	УстановитьЗначенияРеквизитов();
	УстановитьДоступностьЭлементов();
	УстановитьВидимостьКнопокСбросить();
	
КонецПроцедуры

&НаКлиенте 
Процедура УстановитьЦветаЭлементов()
	
	ЭтоОграниченнаяНастройка = (ЭтоТиповойБизнесПроцесс И ИспользоватьТиповыеНастройки)
		ИЛИ ЗначениеЗаполнено(ID_Узла);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.Используется.ЦветТекста = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#Иначе	
		Элементы.Используется.ЦветТекстаЗаголовка = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#КонецЕсли
	
	ЗаполненИсходныйДокумент1С = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.НастройкаОтбора_Интерактивный.ЦветТекста = ?(ЗаполненИсходныйДокумент1С,
		?(ЕстьНастройкаОтбора_Интерактивный, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
	Элементы.НастройкаОтбора_Онлайн.ЦветТекста = ?(ЗаполненИсходныйДокумент1С,
		?(ЕстьНастройкаОтбора_Онлайн, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		Элементы.НастройкаОтбораУзел_Интерактивный.ЦветТекста = Элементы.НастройкаОтбора_Интерактивный.ЦветТекста;
		Элементы.НастройкаОтбораУзел_Онлайн.ЦветТекста = Элементы.НастройкаОтбора_Онлайн.ЦветТекста;
	#КонецЕсли
		
	Элементы.НастроитьРеквизитыШапкиВыгрузка.ЦветТекста = ?(ЗаполненИсходныйДокумент1С
		И НЕ ЭтоОграниченнаяНастройка, ?(ЗначениеЗаполнено(НастройкаВыгрузкиПолей)
		И НастройкаВыгрузкиПолей.Количество() > 1, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыШапкиЗагрузка.ЦветТекста = ?(ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		И НЕ ЭтоОграниченнаяНастройка, ?(ЗначениеЗаполнено(НастройкаЗагрузкиПолей)
		И НастройкаЗагрузкиПолей.Количество() > 1, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыТабличнойЧастиВыгрузка.ЦветТекста = ?(ЗаполненИсходныйДокумент1С
		И НЕ ЭтоОграниченнаяНастройка, ?(ЗначениеЗаполнено(НастройкаВыгрузкиТЧ)
		И НастройкаВыгрузкиТЧ.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыТабличнойЧастиЗагрузка.ЦветТекста = ?(ЗначениеЗаполнено(ТипРезультирующегоДокумента1С)
		И НЕ ЭтоОграниченнаяНастройка, ?(ЗначениеЗаполнено(НастройкаЗагрузкиТЧ)
		И НастройкаЗагрузкиТЧ.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастроитьРеквизитыПредставленияШапки.ЦветТекста = ?(ЗаполненИсходныйДокумент1С, 
		?(ЗначениеЗаполнено(НастройкаПредставленийРеквизитовДокумента)
		И НастройкаПредставленийРеквизитовДокумента.Количество() > 0, WebЦвета.Зеленый, WebЦвета.Красный), WebЦвета.Серый);
		
	Элементы.НастройкаПоследовательностиБизнесПроцессовГиперссылка.ЦветТекста = ?(ЗначениеЗаполнено(НастройкаПоследовательностиБПМассивСтруктур)
		И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур), WebЦвета.Зеленый, WebЦвета.Красный);
		
	Элементы.ТипРезультирующегоДокумента1С_Шаблон.ЦветТекста = WebЦвета.СветлоСерый;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияРеквизитов()
	
	Если НЕ ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		ЗагружатьВТотЖе = Ложь;		
		КонтрольКоличества = Ложь;
	КонецЕсли;
	
	Если ЗагружатьВТотЖе Тогда
		ТипРезультирующегоДокумента1С = ТипИсходногоДокумента1С;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ОсновныеДействия.Кнопки.ФормаУдалитьПользовательскиеНастройки.Доступность = ПользовательскаяНастройка = Истина;
	#Иначе
		Элементы.ФормаУдалитьПользовательскиеНастройки.Видимость = ПользовательскаяНастройка = Истина;
	#КонецЕсли
	
	ЭтоОграниченнаяНастройка = (ЭтоТиповойБизнесПроцесс И ИспользоватьТиповыеНастройки)
		ИЛИ ЗначениеЗаполнено(ID_Узла);
		
	// Настройка шапки
	Элементы.ЗагружатьВТотЖе.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		и не ЭтоТиповойБизнесПроцесс;
	Элементы.ТипРезультирующегоДокумента1С.Доступность = НЕ ЗагружатьВТотЖе;

	Элементы.НастройкаОтбора_Интерактивный.Доступность 				= ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	Элементы.НастройкаОтбора_Онлайн.Доступность 					= ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.НастроитьРеквизитыПредставленияШапки.Доступность 		= ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	Элементы.НадписьРеквизитыПредставленияШапки.Доступность 		= ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	// Поля выгрузка
	ДоступнаНастройкаПолей = ЗначениеЗаполнено(ТипИсходногоДокумента1С) И ЗначениеЗаполнено(ТипДокументаMS) И НЕ ЭтоОграниченнаяНастройка;
	
	Элементы.НастроитьРеквизитыШапкиВыгрузка.Доступность 			= ДоступнаНастройкаПолей;
	Элементы.НадписьРеквизитыШапкиИз1С.Доступность 					= ДоступнаНастройкаПолей;
	Элементы.НастроитьРеквизитыТабличнойЧастиВыгрузка.Доступность 	= ДоступнаНастройкаПолей;
	Элементы.НадписьРеквизитыТЧИз1С.Доступность 					= ДоступнаНастройкаПолей;
		
	// Поля загрузка
	ДоступнаНастройкаПолей = ЗначениеЗаполнено(ТипРезультирующегоДокумента1С) И ЗначениеЗаполнено(ТипДокументаMS) И НЕ ЭтоОграниченнаяНастройка;
	
	Элементы.НастроитьРеквизитыШапкиЗагрузка.Доступность 			= ДоступнаНастройкаПолей;
	Элементы.НадписьРеквизитыШапкиИзMS.Доступность 					= ДоступнаНастройкаПолей;
	Элементы.НастроитьРеквизитыТабличнойЧастиЗагрузка.Доступность 	= ДоступнаНастройкаПолей;
	Элементы.НадписьРеквизитыТЧИзMS.Доступность 					= ДоступнаНастройкаПолей;
	
	// Прочие настройки
	Если ЭтоТиповойБизнесПроцесс Тогда
		Для Каждого Настройка Из СписокНередактируемыхУзловихНастроек Цикл
			Попытка
				Элементы[Настройка.Значение].Доступность = Ложь;	
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьДоступностьКонтроляКоличества();
	
	Элементы.НазначитьПользователю.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С);
	
	Элементы.СоздаватьНовыйДокументПриЗагрузке.Доступность = НЕ ЗагружатьВТотЖе;
	Если ЗагружатьВТотЖе Тогда
		СоздаватьНовыйДокументПриЗагрузке = Ложь;	
	КонецЕсли;
	
	НесколькоЭлементов = СтрЧислоВхождений(НазначитьПользователю,"|")> 0;
	Элементы.КопияДокументаДляКаждогоПользователя.Доступность = ?(НазначитьПользователю = "Спрашивать при выгрузке" ИЛИ НесколькоЭлементов, Истина, Ложь);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ГруппаДвижениеДокументовВерх.Доступность = Ложь;
			Элементы.ГруппаДвижениеДокументовНиз.Доступность = Ложь;
			
			Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Доступность = Ложь;
			Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Доступность = Ложь;
			Элементы.НастроитьРеквизитыПредставленияШапки.Доступность = Ложь;
			Элементы.ОсновныеДействия.Кнопки.ФормаСкопировать.Доступность = Ложь;
		КонецЕсли;
		
		Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.ТекущаяСтраница = ?(ВыполнитьТолькоПроизвольныйКодВыгрузка,
																	Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.Страницы.ОбработчикВыгрузкиДокумента,
																	Элементы.ПанельНастройкиВыгрузкиДокументаИз1С.Страницы.СтраницаНастройкиПолей);
																	
		Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.ТекущаяСтраница = ?(ВыполнитьТолькоПроизвольныйКод,
																	Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.Страницы.СтраницаОбработчикЗагрузкиДокумента,
																	Элементы.ПанельНастройкиЗагрузкиДокументаИзMS.Страницы.СтраницаНастройкиПолей);
	#Иначе
		Элементы.ПодсказкаИспользоватьТиповыеНастройки.Видимость = ЭтоТиповойБизнесПроцесс И ИспользоватьТиповыеНастройки И НЕ ЗначениеЗаполнено(ID_Узла);
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			Элементы.ГруппаДвижениеДокументов.Видимость = Ложь;
			Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Видимость = Ложь;
			Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Видимость = Ложь;
			Элементы.ГруппаИспользоватьТиповыеНастройки.Видимость = Ложь;
			Элементы.Группа3.Видимость = Ложь;
			Элементы.ФормаСкопировать.Видимость = Ложь;
			
			Элементы.ГруппаНастройкиОтборовУзел.Видимость = Истина;
		Иначе
			Элементы.ГруппаНастройкиОтборовУзел.Видимость = Ложь;
			Элементы.ГруппаИспользоватьТиповыеНастройки.Видимость = ЭтоТиповойБизнесПроцесс;
		КонецЕсли;	
		
		Элементы.ГруппаНастройкиПолейВыгрузки.Видимость = НЕ ВыполнитьТолькоПроизвольныйКодВыгрузка;
		Элементы.ГруппаОбработчикаВыгрузки.Видимость = ВыполнитьТолькоПроизвольныйКодВыгрузка;
		Элементы.ГруппаНастройкиПолейЗагрузки.Видимость = НЕ ВыполнитьТолькоПроизвольныйКод;
		Элементы.ГруппаОбработчикаЗагрузки.Видимость = ВыполнитьТолькоПроизвольныйКод;
	#КонецЕсли
	
	Элементы.ПроизвольныйКодВыгрузкиДокумента.Доступность 	= ТипОбработчикаВыгрузки = 0;
	Элементы.ОбработчикВыгрузкиДокумента.Доступность 		= ТипОбработчикаВыгрузки = 1;	
	
	Элементы.ПроизвольныйКодЗагрузкиДокумента.Доступность 	= ТипОбработчикаЗагрузки = 0;
	Элементы.ОбработчикЗагрузкиДокумента.Доступность 		= ТипОбработчикаЗагрузки = 1;	
	
	Элементы.ЗаписыватьДокументПослеЗагрузки.Доступность 	= ?(ЗначениеЗаполнено(НастройкаПоследовательностиБПМассивСтруктур)
		И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур), Ложь, Истина);
		
	Элементы.ТипРезультирующегоДокумента1С.Видимость 		= НЕ ВыполнитьТолькоПроизвольныйКод;
	Элементы.ТипРезультирующегоДокумента1С_Шаблон.Видимость = ВыполнитьТолькоПроизвольныйКод;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКонтроляКоличества()
	
	ЗаполненаПроизвольнаяВыгрузка = ЗначениеЗаполнено(ПроизвольныйКодВыгрузкиДокумента) 
		Или ЗначениеЗаполнено(ОбработчикВыгрузкиДокумента);	                               
	ИспользуетсяПроизвольнаяВыгрузка = ВыполнитьТолькоПроизвольныйКодВыгрузка И ЗаполненаПроизвольнаяВыгрузка;
	Элементы.КонтрольКоличества.Доступность = ЗначениеЗаполнено(ТипИсходногоДокумента1С) Или ИспользуетсяПроизвольнаяВыгрузка;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопокСбросить()
	
	УстановитьВидимостьКнопкиСбросить("НастройкаВыгрузкиПолей");
	УстановитьВидимостьКнопкиСбросить("НастройкаВыгрузкиТЧ");
	УстановитьВидимостьКнопкиСбросить("НастройкаЗагрузкиПолей");
	УстановитьВидимостьКнопкиСбросить("НастройкаЗагрузкиТЧ");
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидимостьКнопкиСбросить(ИмяНастройки)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	ЭлементКнопки = Элементы.Найти(ИмяНастройки + "Сбросить");
	Если ЭлементКнопки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементКнопки.Видимость = Ложь;
	
	Если ЭтоТиповойБизнесПроцесс Тогда
		
		ТиповыеНастройки = ПолучитьСвязанныеИменаНастроек(ИмяНастройки);
		ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
		
		ТекущиеНастройки = ПолучитьСвязанныеИменаНастроек(ИмяНастройки);
		
		Если ИспользоватьТиповыеНастройки Тогда
			// Если используются типовые настройки, то актуальные ПереопределяемыеНастройки лежат в реквизите формы
			Если ПереопределяемыеНастройки <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеНастройки, ПереопределяемыеНастройки);
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(ТекущиеНастройки, ЭтаФорма);
		КонецЕсли;
		
		РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(ТиповыеНастройки, ТекущиеНастройки);
		ЭлементКнопки.Видимость = РезультатСравнения.Изменено;
		
		ЭлементКнопки.Доступность = ЭтоТиповойБизнесПроцесс И НЕ ИспользоватьТиповыеНастройки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "СохраненаНастройкаВыгрузкиПолей" Тогда
	
		ТЗ = ПолучитьИзВременногоХранилища(Параметр.АдресНастройки);
		
		НастройкаВыгрузкиПолейАдрес = ПоместитьВоВременноеХранилище(ТЗ);
	
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура СохранитьНастройку(ЗакрытьПослеСохранения = Ложь, РезультатРедактированияПослеСохранения = Неопределено)

    Если Используется Тогда
		СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
		
		ЕстьДокументMS = ЗначениеЗаполнено(ТипДокументаMS)
			И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
			И СтруктураМетаданных.Свойство("ДокументыMS")
			И СтруктураМетаданных.ДокументыMS.Свойство(ТипДокументаMS);
			
		Если ЕстьДокументMS Тогда
			СохранитьНастройкуЗавершение();
			Если ЗакрытьПослеСохранения Тогда
				Если НЕ РезультатРедактированияПослеСохранения = Неопределено Тогда
					РезультатРедактирования = РезультатРедактированияПослеСохранения;
				КонецЕсли;
				пРазрешитьЗакрытие = Истина;
				Закрыть(РезультатРедактирования);
			КонецЕсли;
		Иначе	
			ТекстВопроса = НСтр("ru = 'Документ Клеверенс не указан или отсутствует в метаданных. Продолжить?';
									|en = 'The Cleverence document is not specified or is missing from the metadata. Continue?';
									|be = 'Дакумент Cleverence не пазначаны або адсутнічае ў метададзеных. Працягнуць?'; es = 'El documento Cleverence no se especifica o no se encuentra en los metadatos. ¿Continuar?'; ka = 'კლევერენციის დოკუმენტი არ არის მითითებული ან არ არის მითითებული მეტამონაცემებში. გაგრძელება?'; kk = 'Cleverence құжаты метадеректерде көрсетілмеген немесе жоқ. Жалғастыру?'; ro = 'Documentul Cleverence nu este specificat sau lipsește din metadate. Continuați?'; tr = 'Cleverence belgesi meta verilerde belirtilmemiş veya eksiktir. Devam etmek mi?'; uk = 'Документ Cleverence не вказаний або відсутній у метаданих. Продовжити?'; uz = 'Cleverence hujjati metama''lumotlarda ko''rsatilmagan yoki yo''q. Davom etasizmi?'");
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ЗакрытьПослеСохранения",  ЗакрытьПослеСохранения);
			ДопПараметры.Вставить("РезультатРедактирования", РезультатРедактированияПослеСохранения);
			ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьНастройкуПослеОтветаНаВопрос", ЭтаФорма, ДопПараметры);
						
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		КонецЕсли;
		
	Иначе
		СохранитьНастройкуЗавершение();
		Если ЗакрытьПослеСохранения Тогда
			Если НЕ РезультатРедактированияПослеСохранения = Неопределено Тогда
				РезультатРедактирования = РезультатРедактированияПослеСохранения;
			КонецЕсли;
			пРазрешитьЗакрытие = Истина;
			Закрыть(РезультатРедактирования);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруНастройкиБизнесПроцесса()
	
	СтруктураНастройки = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов();
	СтруктураНастройки.ID_БизнесПроцесса								= ID_БизнесПроцесса;
	СтруктураНастройки.Используется										= Используется;
	СтруктураНастройки.ЭтоТиповойБизнесПроцесс							= ЭтоТиповойБизнесПроцесс;
	СтруктураНастройки.ИспользоватьТиповыеНастройки						= ИспользоватьТиповыеНастройки;
	СтруктураНастройки.Название											= Название;
	СтруктураНастройки.ТипИсходногоДокумента1С							= ТипИсходногоДокумента1С;
	СтруктураНастройки.ТипРезультирующегоДокумента1С					= ТипРезультирующегоДокумента1С;
	СтруктураНастройки.ТипДокументаMS									= ТипДокументаMS;
	СтруктураНастройки.ЗагружатьВТотЖе									= ЗагружатьВТотЖе;
	СтруктураНастройки.КоллективнаяРабота								= КоллективнаяРабота;
	СтруктураНастройки.КонтрольКоличества								= КонтрольКоличества;
	СтруктураНастройки.СоздаватьНовыйДокументПриЗагрузке				= СоздаватьНовыйДокументПриЗагрузке;
	СтруктураНастройки.ПроводитьДокументПослеЗагрузки					= ПроводитьДокументПослеЗагрузки;
	СтруктураНастройки.НастройкаВыгрузкиПолей							= НастройкаВыгрузкиПолей;
	СтруктураНастройки.НастройкаВыгрузкиТЧ								= НастройкаВыгрузкиТЧ;
	СтруктураНастройки.ВидОбработчика_ПередВыгрузкойДокумента			= ВидОбработчика_ПередВыгрузкойДокумента;
	СтруктураНастройки.ВидОбработчика_ПослеВыгрузкиДокумента			= ВидОбработчика_ПослеВыгрузкиДокумента;
	СтруктураНастройки.ВидОбработчика_ПослеОтправкиДокумента			= ВидОбработчика_ПослеОтправкиДокумента;
	СтруктураНастройки.Обработчик_ПередВыгрузкойДокумента				= Обработчик_ПередВыгрузкойДокумента;
	СтруктураНастройки.Обработчик_ПослеВыгрузкиДокумента				= Обработчик_ПослеВыгрузкиДокумента;
	СтруктураНастройки.Обработчик_ПослеОтправкиДокумента				= Обработчик_ПослеОтправкиДокумента;
	СтруктураНастройки.НастройкаЗагрузкиПолей							= НастройкаЗагрузкиПолей;
	СтруктураНастройки.НастройкаЗагрузкиТЧ								= НастройкаЗагрузкиТЧ;
	СтруктураНастройки.ВидОбработчика_ПередЗаполнениемДокумента			= ВидОбработчика_ПередЗаполнениемДокумента;
	СтруктураНастройки.ВидОбработчика_ПослеЗаполненияДокумента			= ВидОбработчика_ПослеЗаполненияДокумента;
	СтруктураНастройки.ВидОбработчика_ПослеОткрытияФормыДокумента		= ВидОбработчика_ПослеОткрытияФормыДокумента;
	СтруктураНастройки.Обработчик_ПередЗаполнениемДокумента				= Обработчик_ПередЗаполнениемДокумента;
	СтруктураНастройки.Обработчик_ПослеЗаполненияДокумента				= Обработчик_ПослеЗаполненияДокумента;
	СтруктураНастройки.Обработчик_ПослеОткрытияФормыДокумента			= Обработчик_ПослеОткрытияФормыДокумента;
	СтруктураНастройки.Комментарий										= Комментарий;
	СтруктураНастройки.НазначитьПользователю							= НазначитьПользователю;
	СтруктураНастройки.СпособНазначения									= СпособНазначения;
	СтруктураНастройки.ЗаписыватьДокументПослеЗагрузки					= ЗаписыватьДокументПослеЗагрузки;
	СтруктураНастройки.СвязиТабличныхЧастей								= СвязиТабличныхЧастей;
	СтруктураНастройки.КопияДокументаДляКаждогоПользователя				= КопияДокументаДляКаждогоПользователя;
	СтруктураНастройки.ВыполнитьТолькоПроизвольныйКод					= ВыполнитьТолькоПроизвольныйКод;
	СтруктураНастройки.ВыполнитьТолькоПроизвольныйКодВыгрузка			= ВыполнитьТолькоПроизвольныйКодВыгрузка;
	СтруктураНастройки.ОбработчикВыгрузкиДокумента						= ОбработчикВыгрузкиДокумента;
	СтруктураНастройки.НастройкаПредставленийРеквизитовДокумента		= НастройкаПредставленийРеквизитовДокумента;
	СтруктураНастройки.ЗаменитьПредставлениеДокументаПриВыгрузке		= ЗаменитьПредставлениеДокументаПриВыгрузке;
	СтруктураНастройки.НеРазбиватьОбъединенныйДокументПриЗагрузке		= НеРазбиватьОбъединенныйДокументПриЗагрузке;
	СтруктураНастройки.ID_ПроизвольногоКода_Выгрузка_Документ			= ID_ПроизвольногоКода_Выгрузка_Документ;
	СтруктураНастройки.ID_ПроизвольногоКода_Загрузка_Документ			= ID_ПроизвольногоКода_Загрузка_Документ;
	СтруктураНастройки.ТипОбработчикаВыгрузки							= ТипОбработчикаВыгрузки;
	СтруктураНастройки.ТипОбработчикаЗагрузки							= ТипОбработчикаЗагрузки;
	СтруктураНастройки.НастройкаПоследовательностиБПМассивСтруктур		= НастройкаПоследовательностиБПМассивСтруктур;
	СтруктураНастройки.ПрерыватьПоследовательностьПриКритическойОшибке	= ПрерыватьПоследовательностьПриКритическойОшибке;
	Возврат СтруктураНастройки;
	
КонецФункции 

&НаКлиенте
Процедура СохранитьНастройкуЗавершение()
	
	УбратьПредставлениеНазначитьПользователю();
	
	Если ВыполнитьТолькоПроизвольныйКод Тогда
		ТипРезультирующегоДокумента1С = "";
		ТипРезультирующегоДокумента1С_Синоним = "";
	КонецЕсли;
	
	СтруктураНастройки = ПолучитьСтруктуруНастройкиБизнесПроцесса();
	
	Если ЗначениеЗаполнено(ID_Узла) Тогда // Пользовательские настройки узла
		
		ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
		ЗаполнитьЗначенияСвойств(ПользовательскиеНастройки, СтруктураНастройки);
		
	ИначеЕсли ЭтоТиповойБизнесПроцесс Тогда // Переопределение типовых настроек БП
		
		ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
		ЗаполнитьЗначенияСвойств(ПользовательскиеНастройки, СтруктураНастройки);
		ПользовательскиеНастройки.ПереопределяемыеНастройки = Неопределено;
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если ИспользоватьТиповыеНастройки Тогда
				// Если используются типовые настройки, то актуальные ПереопределяемыеНастройки лежат в реквизите формы
				// Записываем сохраненные ПереопределяемыеНастройки, чтобы не потерять изменения.
				ПользовательскиеНастройки.ПереопределяемыеНастройки = ПереопределяемыеНастройки;
			Иначе
				// Получаем ПереопределяемыеНастройки сравнением настроек из формы с типовыми настройками
				
				// Заранее мы не знаем какие настройки доступны для переопределения, считаем что все настройки можно менять.
				РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(СтруктураНастроекТиповая, СтруктураНастройки);
				ИзмененныеНастройки = РезультатСравнения.ИзмененныеЗначения;
				
				// Сохраняем только измененные значения.
				// Сохраняем в отдельном ключе, чтобы в массиве структур НастройкиБизнесПроцессов_ПользовательскиеНастройки не плодить колонки
				ПользовательскиеНастройки.ПереопределяемыеНастройки = ИзмененныеНастройки;
			КонецЕсли;
			
			// Удаляем дубли настроек, которые хранятся в ПользовательскиеНастройки.
			Если ПользовательскиеНастройки.ПереопределяемыеНастройки <> Неопределено Тогда
				
				Для каждого КлючЗначение Из ПользовательскиеНастройки Цикл
					Если ПользовательскиеНастройки.ПереопределяемыеНастройки.Свойство(КлючЗначение.Ключ) Тогда
						ПользовательскиеНастройки.ПереопределяемыеНастройки.Удалить(КлючЗначение.Ключ);
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ ПользовательскиеНастройки.ПереопределяемыеНастройки.Количество() Тогда
					ПользовательскиеНастройки.ПереопределяемыеНастройки = Неопределено;
				КонецЕсли;
				
			КонецЕсли;
		#КонецЕсли
	
	Иначе // Пользовательский БП
		ПользовательскиеНастройки = Неопределено;
	КонецЕсли;
	
	Если ПользовательскиеНастройки <> Неопределено Тогда
		
		ПользовательскаяНастройка = Истина;
		
		Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", Отбор, ПользовательскиеНастройки, ID_Узла, Истина);
		
		Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда // Существуют пользовательские настройки, которые настраиваются только в главном узле и действуют для всех остальных
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
		КонецЕсли;
		
	Иначе
		
		Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		Если ЭтоБылТиповойБизнесПроцесс Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиБизнесПроцессов_ПоУмолчанию", Отбор, СтруктураНастройки,, Истина);
		Иначе
			_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиБизнесПроцессов_Пользовательские", Отбор, СтруктураНастройки,, Истина);
			_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");	
		КонецЕсли;
		
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);
	ВыгрузитьБизнесПроцессы();
	
	Если ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		// Сохраняем настройки отборов:
		//	- для новых бизнес-процессов
		//	- при изменении названия/типа исходного документа
		//
		//	1. Если это новый бизнес-процесс или исходного документа не было, сохраняем отборы для главного узла.
		//  2. Если изменился тип исходного документа, удаляем существующие отборы для всех узлов и сохраняем новые отборы для главного узла.
		//  3. Если изменилось только название бизнес-процесса, пересохраняем существующие отборы для всех узлов с новым названием.
		//
		ИзменилсяТипИсходногоДокумента 	 = НЕ СокрЛП(ТипИсходногоДокумента1С) = СокрЛП(Пред_ТипИсходногоДокумента1С);
		ИзменилосьНазваниеБизнесПроцесса = НЕ СокрЛП(Название) = СокрЛП(Пред_Название);
		
		Если ЭтоНовыйБизнесПроцесс
			ИЛИ НЕ ЗначениеЗаполнено(Пред_ТипИсходногоДокумента1С) Тогда
			СохранитьНастройкиОтборов();
		ИначеЕсли ИзменилсяТипИсходногоДокумента  Тогда
			_ЛокКонтекст.ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса);
			
			СохранитьНастройкиОтборов();
		ИначеЕсли ИзменилосьНазваниеБизнесПроцесса Тогда
			_ЛокКонтекст.ЛокЯдро_ИзменитьОтборыБизнесПроцессов(ID_БизнесПроцесса, Новый Структура("Название", Название));
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Пред_ТипИсходногоДокумента1С) Тогда
			// Если убрали исходный документ, удаляем настройки отборов для всех узлов
			_ЛокКонтекст.ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса);
		КонецЕсли;
	КонецЕсли;
		
	Пред_Название				 = Название;
	Пред_ТипИсходногоДокумента1С = ТипИсходногоДокумента1С;	
		
	РезультатРедактирования = ID_БизнесПроцесса;
	ЭтоНовыйБизнесПроцесс = Ложь;
	Модифицированность  = Ложь;
	
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьБизнесПроцессы()
		
	ВладелецФормы.ВыгрузитьБизнесПроцессыВБазуSMARTS("");	

КонецПроцедуры

&НаКлиенте 
Процедура ОбновитьСпискиПроизвольныхКодов()
	
	СписокПроизвольныхКодов_Выгрузка_Документ.Очистить();
	Отбор = Новый Структура("Направление,ТипОбъекта","Выгрузка","Документ");
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды",Отбор);		
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;			
			СписокПроизвольныхКодов_Выгрузка_Документ.Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	СписокПроизвольныхКодов_Загрузка_Документ.Очистить();
	Отбор = Новый Структура("Направление,ТипОбъекта","Загрузка","Документ");
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды",Отбор);		
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;			
			СписокПроизвольныхКодов_Загрузка_Документ.Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаименованияПроизвольныхКодов()
	
	Если ЗначениеЗаполнено(ID_ПроизвольногоКода_Выгрузка_Документ) Тогда
		ЭлементСписка = СписокПроизвольныхКодов_Выгрузка_Документ.НайтиПоЗначению(ID_ПроизвольногоКода_Выгрузка_Документ);
		Если ЭлементСписка <> Неопределено Тогда
			ПроизвольныйКодВыгрузкиДокумента = ЭлементСписка.Представление;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ID_ПроизвольногоКода_Загрузка_Документ) Тогда
		ЭлементСписка = СписокПроизвольныхКодов_Загрузка_Документ.НайтиПоЗначению(ID_ПроизвольногоКода_Загрузка_Документ);
		Если ЭлементСписка <> Неопределено Тогда
			ПроизвольныйКодЗагрузкиДокумента = ЭлементСписка.Представление;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьНастройкиОтборов()
	
	ЕстьНастройкаОтбора_Интерактивный = Ложь;
	ЕстьНастройкаОтбора_Онлайн = Ложь;
	
	Если (ЭтоНовыйБизнесПроцесс 
		И НЕ ЗначениеЗаполнено(Пред_ID_БизнесПроцесса))
		ИЛИ НЕ ЗначениеЗаполнено(ТипИсходногоДокумента1С) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		Если ЭтоТекущийУзел Тогда
			НастройкиОтборовДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
		Иначе
			НастройкиОтборовДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_Узла);
		КонецЕсли;
		
		Если ЭтоНовыйБизнесПроцесс И ЗначениеЗаполнено(Пред_ID_БизнесПроцесса) Тогда
			// Поиск настроек отборов при копировании для БП основания
			СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", Пред_ID_БизнесПроцесса);
		Иначе
			СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
		КонецЕсли;
		
		НайденныеОтборы = Неопределено;
		Если ЗначениеЗаполнено(НастройкиОтборовДокументов) И НЕ НастройкиОтборовДокументов = Ложь Тогда
			НайденныеОтборы = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборовДокументов, СтруктураОтбора);
		КонецЕсли;
		
		Если НайденныеОтборы = Неопределено Тогда
			// Для торгового объекта пробуем найти настройку главного узла (при отсутствии своей)
			Если НЕ ЭтоТекущийУзел И ЗначениеЗаполнено(ID_Узла) Тогда
				НастройкиГлавногоУзла = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, "");
					
				НайденныеОтборы = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиГлавногоУзла, СтруктураОтбора);
			КонецЕсли;
		КонецЕсли;
				
		Если НЕ НайденныеОтборы = Неопределено Тогда
			НастройкаОтбора = НайденныеОтборы[0];
				
			НоваяСтрока = НастройкиОтборов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НастройкаОтбора);
			НоваяСтрока.РежимОбмена = РежимОбмена;
			НоваяСтрока.Название = Название;
			
			// Заменяем ID_БизнесПроцесса так-как эти отборы от БП основания
			Если ЭтоНовыйБизнесПроцесс И ЗначениеЗаполнено(Пред_ID_БизнесПроцесса) Тогда
				НоваяСтрока.ID_БизнесПроцесса = ID_БизнесПроцесса;
			КонецЕсли;
			
			ЭтаФорма["ЕстьНастройкаОтбора_" + РежимОбмена] = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтбора(РежимОбмена)

	НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
	Если НайденныеСтроки.Количество() Тогда
		СтрокаНастройки = НайденныеСтроки[0];
	Иначе
		НастройкаБП = Новый Структура();
		НастройкаБП.Вставить("ТипИсходногоДокумента1С", ТипИсходногоДокумента1С);
		НастройкаБП.Вставить("ID_БизнесПроцесса",		ID_БизнесПроцесса);
		НастройкаБП.Вставить("Название",				Название);		
		СтрокаНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
		
		Если СтрокаНастройки = Неопределено Тогда
			ТекстПредупреждения = НСтр("ru = 'Тип исходного документа ""%1"" отсутствует в конфигурации 1С';
										|en = 'The source document type ""%1"" is missing in the 1C configuration';
										|be = 'Тып зыходнага дакумента"" %1 "" адсутнічае ў канфігурацыі 1С'; es = 'El tipo de documento de origen ""%1"" no está presente en la configuración 1C'; ka = 'წყარო დოკუმენტის ტიპი ""%1 "" აკლია 1C კონფიგურაციაში'; kk = '""%1 "" Бастапқы құжатының түрі 1С конфигурациясында жоқ'; ro = 'Tipul de document sursă"" %1 "" lipsește în configurația 1C'; tr = '1C yapılandırmasında orijinal belge türü ""%1"" eksik'; uk = 'Тип вихідного документа ""%1 "" відсутній в конфігурації 1С'; uz = '""%1"" asl hujjat turi 1C konfiguratsiyasida mavjud emas'");
			ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(ТипИсходногоДокумента1С));
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#Иначе
				Сообщить(ТекстПредупреждения); 
			#КонецЕсли
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ОтборДокументов = ПолучитьФорму("ОФ_ФормаНастройки_ОтборДокументов", ЭтаФорма);
	#Иначе
		ФормаНастройки_ОтборДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборДокументов",, ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ОтборДокументов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ОтборДокументов.ID_Узла						= ID_Узла;
	ФормаНастройки_ОтборДокументов.НаименованиеУзла 			= НаименованиеУзла;
	ФормаНастройки_ОтборДокументов.ID_БизнесПроцесса 			= СтрокаНастройки.ID_БизнесПроцесса;
	ФормаНастройки_ОтборДокументов.НаименованиеБП 				= СтрокаНастройки.Название;
	ФормаНастройки_ОтборДокументов.ТипДокумента1С 				= СтрокаНастройки.ТипИсходногоДокумента1С;
	ФормаНастройки_ОтборДокументов.Используется 				= СтрокаНастройки.Используется;
	ФормаНастройки_ОтборДокументов.ТипОбмена					= РежимОбмена;
	ФормаНастройки_ОтборДокументов.НастройкаКомпоновщикаСтрокой = СтрокаНастройки.НастройкаКомпоновщикаСтрокой;		
	ФормаНастройки_ОтборДокументов.ВариантОтбора 				= ?(СтрокаНастройки.ВариантОтбора = "", "Только конструктор", СтрокаНастройки.ВариантОтбора);
	ФормаНастройки_ОтборДокументов.ID_ПроизвольногоОтбора		= СтрокаНастройки.ID_ПроизвольногоОтбора;
	ФормаНастройки_ОтборДокументов._ЛокКонтекст 				= _ЛокКонтекст;
	
	ДопПараметры = Новый Структура("РежимОбмена", РежимОбмена);
	ОП = Новый ОписаниеОповещения("ФормаНастройки_ОтборДокументовЗакрытие", ЭтаФорма, ДопПараметры);
	ФормаНастройки_ОтборДокументов.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ОтборДокументов.ОткрытьМодально();
	#Иначе
		ФормаНастройки_ОтборДокументов.Открыть();
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиОтборов()

	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			СтрокаНастройки = НайденныеСтроки[0];
			
			ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + РежимОбмена];
	
			СтруктураНастройки = Новый Структура;
			Для каждого КИЗ ИЗ ШаблонНастройки Цикл
				СтруктураНастройки.Вставить(КИЗ.Ключ);
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(СтруктураНастройки, СтрокаНастройки);
		Иначе
			НастройкаБП = Новый Структура();
			НастройкаБП.Вставить("ТипИсходногоДокумента1С", ТипИсходногоДокумента1С);
			НастройкаБП.Вставить("ID_БизнесПроцесса",		ID_БизнесПроцесса);
			НастройкаБП.Вставить("Название",				Название);		
			СтруктураНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
			
			Если СтруктураНастройки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена);
	КонецЦикла;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена)
	
	// Обновляем название БП
	СтруктураНастройки.Название = Название;
	
    // Сохраняем настройку отбора в базу SMARTS и для текущего узла - в кэш (сохранение в кэш происходит в методе ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS)
	Отбор = Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса);
	_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиОтборовУзлов_" + РежимОбмена, Отбор, СтруктураНастройки, ID_Узла);	
	
КонецПроцедуры

&НаКлиенте
Процедура УбратьПредставлениеНазначитьПользователю()
	Если НЕ ЗначениеЗаполнено(НазначитьПользователю) Тогда
		Возврат
	КонецЕсли;
	
	СтрокаДляПреобразования = НазначитьПользователю;
	Массив = _ЛокКонтекст.ЛокЯдро_СтрРазделить(СтрокаДляПреобразования, "|", Ложь);
	НазначитьПользователюВосстановленный = "";
	
	Для Каждого СтрМассива из Массив Цикл
		РазделеннаяСтрока =  _ЛокКонтекст.ЛокЯдро_СтрРазделить(СтрМассива, "(", Ложь);
		ИД = РазделеннаяСтрока[РазделеннаяСтрока.Количество()-1];
		ИД = СтрЗаменить(ИД, ")","");
		НазначитьПользователюВосстановленный = НазначитьПользователюВосстановленный + ИД + "|";	
	КонецЦикла;
	ПоследнийСимвол = Прав(НазначитьПользователюВосстановленный,1);
	Если ПоследнийСимвол = "|" Тогда
	НазначитьПользователюВосстановленный = Лев(НазначитьПользователюВосстановленный,СтрДлина(НазначитьПользователюВосстановленный)-1);
	КонецЕсли;
	НазначитьПользователю = НазначитьПользователюВосстановленный;
КонецПроцедуры

&НаСервере
Функция ПолучитьПользователейМС(ХранилищеПользователей)
	
	ПользователиМС = ПолучитьИзВременногоХранилища(ХранилищеПользователей);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МодульОбработки = ОбработкаОбъект;
	#Иначе
		МодульОбработки = РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
	МассивПользователей = МодульОбработки.ГлЯдро_СтрРазделить(НазначитьПользователю,"|", Ложь); 
	КолВоВМассиве = МассивПользователей.Количество();
	СтрокаНазначения = "";
	СЧ = 0;
	Для Каждого СтрМассив из МассивПользователей Цикл
		НайденнаяСтрокаДЗ = ПользователиМС.Строки.Найти(СтрМассив,,Истина);
		Если НайденнаяСтрокаДЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаНазначения = СтрокаНазначения + НайденнаяСтрокаДЗ.ГруппаПользователь + "(" + СтрМассив + ")"; 
		СЧ = СЧ+1;
		Если СЧ <> КолВоВМассиве Тогда
			СтрокаНазначения = СтрокаНазначения + "|";
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаНазначения;
КонецФункции

&НаКлиенте
Процедура ОтразитьПредставлениеНазначитьПользователю()
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(НазначитьПользователю, "Конкретному устройству") <> 0 Тогда
		Возврат
	КонецЕсли; 
	СтрокаНазначитьПользователю = ПолучитьПользователейМС(_ЛокКонтекст.СтруктураМетаданных.ПользователиMS); 
	НазначитьПользователю = СтрокаНазначитьПользователю;
КонецПроцедуры

&НаКлиенте
Функция ЕстьВключеннаяПоследовательностьБП(МассивСтруктур)
	Результат = Ложь;
	Для Каждого СтруктураНастройки Из МассивСтруктур Цикл
		Если СтруктураНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;     
		КонецЕсли;
		Если СтруктураНастройки.Использование Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УдалитьПользовательскиеНастройкиЗавершение()
	
	СтруктураНастроекБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;

	ПользовательскаяНастройка = Ложь;
	Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Массив") Тогда
		Индекс = 0;
		Для каждого Настройка из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если Настройка.Свойство("ID_БизнесПроцесса") и Настройка.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Удалить(Индекс);		
			КонецЕсли;
			Индекс=Индекс+1;
		КонецЦикла;
		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
			_ЛокКонтекст.ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 						

		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", 	 СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
		_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла, Ложь);	
	КонецЕсли;
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Для каждого НастройкаБП из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Свойство("ID_БизнесПроцесса") И НастройкаБП.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкаБП);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Ложь;
	Элементы.Используется.Заголовок = ?(Используется, 
		НСтр("ru = 'Включено';
				|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'"), 
		НСтр("ru = 'Отключено';
				|en = 'Disabled'; be = 'Адключаны'; es = 'Desconectado'; ka = 'გამორთულია'; kk = 'Ажыратылған'; ro = 'Dezactivat'; tr = 'Devre dışı bırakıldı'; uk = 'Відключений'; uz = 'O''chirilgan'")
	);
	ВыгрузитьБизнесПроцессы();
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСвязанныеИменаНастроек(ИмяНастройки)
	
	СвязанныеНастройки = Новый Структура;
	
	Если ИмяНастройки = "НастройкаВыгрузкиПолей" Тогда
		
		СвязанныеНастройки.Вставить("НастройкаВыгрузкиПолей");
		СвязанныеНастройки.Вставить("ВидОбработчика_ПередВыгрузкойДокумента");
		СвязанныеНастройки.Вставить("ВидОбработчика_ПослеВыгрузкиДокумента");
		СвязанныеНастройки.Вставить("ВидОбработчика_ПослеОтправкиДокумента");
		
		СвязанныеНастройки.Вставить("Обработчик_ПередВыгрузкойДокумента");
		СвязанныеНастройки.Вставить("Обработчик_ПослеВыгрузкиДокумента");
		СвязанныеНастройки.Вставить("Обработчик_ПослеОтправкиДокумента");
		СвязанныеНастройки.Вставить("ЗаменитьПредставлениеДокументаПриВыгрузке");
		
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиТЧ" Тогда
		
		СвязанныеНастройки.Вставить("НастройкаВыгрузкиТЧ");
		СвязанныеНастройки.Вставить("СвязиТабличныхЧастей");
		
	ИначеЕсли ИмяНастройки = "НастройкаЗагрузкиПолей" Тогда
		
		СвязанныеНастройки.Вставить("НастройкаЗагрузкиПолей");
		
		СвязанныеНастройки.Вставить("ВидОбработчика_ПередЗаполнениемДокумента");
		СвязанныеНастройки.Вставить("ВидОбработчика_ПослеЗаполненияДокумента");
		СвязанныеНастройки.Вставить("ВидОбработчика_ПослеОткрытияФормыДокумента");
		
		СвязанныеНастройки.Вставить("Обработчик_ПередЗаполнениемДокумента");
		СвязанныеНастройки.Вставить("Обработчик_ПослеЗаполненияДокумента");
		СвязанныеНастройки.Вставить("Обработчик_ПослеОткрытияФормыДокумента");
		
	ИначеЕсли ИмяНастройки = "НастройкаЗагрузкиТЧ" Тогда
		
		СвязанныеНастройки.Вставить("НастройкаЗагрузкиТЧ");
		
	КонецЕсли;
	
	Возврат СвязанныеНастройки;
	
КонецФункции

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура СкопироватьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		РезультатРедактированияПослеСохранения = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		СохранитьНастройку(Истина, РезультатРедактированияПослеСохранения);
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		РезультатРедактирования = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		Закрыть(РезультатРедактирования);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПредставленияРеквизитовДокументаЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаПредставленийРеквизитовДокумента   = РезультатРедактирования.ТаблицаНастроек;
		ЗаменитьПредставлениеДокументаПриВыгрузке = РезультатРедактирования.ЗаменитьПредставлениеДокументаПриВыгрузке;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С);
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS);
		Модифицированность = Истина;
		УстановитьЦветаЭлементов();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПравилаЗагрузкиТЧЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаЗагрузкиТЧ = РезультатРедактирования;
		ТекущееСоответствиеТаблицПравилОбмена.Вставить("Загрузка1С", ТипРезультирующегоДокумента1С);
