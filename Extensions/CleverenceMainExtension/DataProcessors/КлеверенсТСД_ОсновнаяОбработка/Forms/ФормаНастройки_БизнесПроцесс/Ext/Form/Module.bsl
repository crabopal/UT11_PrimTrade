&НаКлиенте
Процедура ФормаНастройки_СледующиеБизнесПроцессыЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	Если РезультатРедактирования <> Неопределено Тогда
		НастройкаПоследовательностиБПМассивСтруктур 	= РезультатРедактирования.НастройкаПоследовательностиБПМассивСтруктур;
		ПрерыватьПоследовательностьПриКритическойОшибке = РезультатРедактирования.ПрерыватьПоследовательностьПриКритическойОшибке;
		Модифицированность = Истина;
		УстановитьЦветаЭлементов();
		
		Если ЗаписыватьДокументПослеЗагрузки <> "Всегда" 
			И ЕстьВключеннаяПоследовательностьБП(НастройкаПоследовательностиБПМассивСтруктур) Тогда
			ЗаписыватьДокументПослеЗагрузки = "Всегда";
			Сообщение = НСтр("ru = 'При настроенной последовательности результирующий документ должен быть всегда записан. Настройка изменена';
								|en = 'With the sequence configured, the resulting document should always be written. The setting has been changed';
								|be = 'Пры наладжанай паслядоўнасці выніковы дакумент павінен быць заўсёды запісаны. Налада зменена'; es = 'Con la secuencia configurada, el documento resultante siempre debe escribirse. Configuración modificada'; ka = 'კონფიგურირებული თანმიმდევრობით, მიღებული დოკუმენტი ყოველთვის უნდა დაიწეროს. პარამეტრი შეიცვალა'; kk = 'Реттілік реттелген кезде алынған құжат әрқашан жазылуы керек. Параметр өзгертілді'; ro = 'Cu secvența configurată, documentul rezultat trebuie întotdeauna scris. Setarea a fost modificată'; tr = 'Sıra ayarlandığında, ortaya çıkan belge her zaman yazılmalıdır. Ayar değiştirildi'; uk = 'При налаштованої послідовності результуючий документ повинен бути завжди записаний. Налаштування змінено'; uz = 'Tuzilgan ketma-ketlik bilan, natijada olingan hujjat har doim yozilishi kerak. Sozlama o''zgartirildi'");
			Сообщить(Сообщение); 
		КонецЕсли;
		
		УстановитьДоступностьЭлементов();
		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ОтборДокументовЗакрытие(РезультатНастройки, ДопПараметры) Экспорт

	Если ЗначениеЗаполнено(РезультатНастройки) Тогда
		РежимОбмена = ДопПараметры.РежимОбмена;
		
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			СтрокаНастройки = НайденныеСтроки[0];
		Иначе
			СтрокаНастройки = НастройкиОтборов.Добавить();
			
			СтрокаНастройки.ID_БизнесПроцесса				= ID_БизнесПроцесса;
			СтрокаНастройки.Название						= Название;
			СтрокаНастройки.ТипИсходногоДокумента1С 		= ТипИсходногоДокумента1С;
			СтрокаНастройки.ТипИсходногоДокумента1С_Синоним	= _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С].Синоним;
			СтрокаНастройки.РежимОбмена						= РежимОбмена;
		КонецЕсли;
		
		СтрокаНастройки.НастройкаКомпоновщикаСтрокой	= РезультатНастройки.НастройкаКомпоновщикаСтрокой;
		СтрокаНастройки.Используется 					= РезультатНастройки.Используется;
		СтрокаНастройки.ВариантОтбора 					= РезультатНастройки.ВариантОтбора;
		СтрокаНастройки.ID_ПроизвольногоОтбора 			= РезультатНастройки.ID_ПроизвольногоОтбора;
		
		// Если бизнес-процесс не новый, отборы нужно сохранять сразу, а не при сохранении бизнес-процесса (сохранения бизнес-процесса может и не быть)
		Если НЕ ЭтоНовыйБизнесПроцесс Тогда
			ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + РежимОбмена];
	
			СтруктураНастройки = Новый Структура;
			Для каждого КИЗ ИЗ ШаблонНастройки Цикл
				СтруктураНастройки.Вставить(КИЗ.Ключ);
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(СтруктураНастройки, СтрокаНастройки);
			
			СохранитьНастройкуОтбора(СтруктураНастройки, РежимОбмена);
		КонецЕсли;
		
		ЭтаФорма["ЕстьНастройкаОтбора_" + РежимОбмена] = Истина;
		
		УстановитьЦветаЭлементов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНастройкуЗавершение();
		
		Если ДополнительныеПараметры.ЗакрытьПослеСохранения Тогда
			Если НЕ ДополнительныеПараметры.РезультатРедактирования = Неопределено Тогда
				РезультатРедактирования = ДополнительныеПараметры.РезультатРедактирования;
			КонецЕсли;
			Закрыть(РезультатРедактирования);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользовательскиеНастройкиПослеОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УдалитьПользовательскиеНастройкиЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение(Результат, ИмяНастройки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТиповыеНастройки = ПолучитьСвязанныеИменаНастроек(ИмяНастройки);	
		Если ТиповыеНастройки.Количество() Тогда
			
			ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ТиповыеНастройки);
			
			УстановитьВидимостьКнопкиСбросить(ИмяНастройки);
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросИспользоватьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Модифицированность = Истина;
		ИспользоватьТиповыеНастройки = Ложь;
		СохранитьНастройку();
		
	КонецЕсли;
	
КонецПроцедуры 

