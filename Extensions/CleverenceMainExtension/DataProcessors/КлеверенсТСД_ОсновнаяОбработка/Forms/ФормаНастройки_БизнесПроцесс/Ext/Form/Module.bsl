/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
Перем РезультатРедактирования;

&НаКлиенте 
Перем ТекущееСоответствиеТаблицПравилОбмена;

&НаКлиенте
Перем ПредыдущееЗначение;

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем НастройкаВыгрузкиПолей Экспорт,
	НастройкаВыгрузкиТЧ Экспорт,
	НастройкаЗагрузкиПолей Экспорт,
	НастройкаЗагрузкиТЧ Экспорт,
	ПолноеЗначениеНастройки Экспорт,
	СвязиТабличныхЧастей Экспорт,
	НастройкаПредставленийРеквизитовДокумента Экспорт,
	НастройкаПоследовательностиБПМассивСтруктур Экспорт,
	пРазрешитьЗакрытие;

#Область ОбработчикиСобытийФормы 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПереопределяемыеНастройки = Неопределено;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИспользоватьТиповыеНастройки = ЭтоТиповойБизнесПроцесс;
		СтруктураНастроекТиповая = Новый Структура;
		ПриСозданииНаСервере(Отказ,Истина);
	#Иначе
		Если ЭтоТиповойБизнесПроцесс Тогда
			НБП_ПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
			НБП_ПоУмолчанию = НБП_ПоУмолчанию.НастройкиБизнесПроцессов;
			СтруктураНастроекТиповая = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НБП_ПоУмолчанию, "ID_БизнесПроцесса", ID_БизнесПроцесса);
			
			Если ИспользоватьТиповыеНастройки Тогда
				// Включено использование типовых настроек. 
				// Получаем ПереопределяемыеНастройки из сохраненных настроек, чтобы не потерять изменения,	т.к в общей структуре настроек их нет.
				СтруктураНастроекБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
				НБП_ПользовательскиеНастройки = СтруктураНастроекБизнесПроцессов.НастройкиБизнесПроцессов;
				СохраненныеПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НБП_ПользовательскиеНастройки, "ID_БизнесПроцесса", ID_БизнесПроцесса);
				
				Если СохраненныеПользовательскиеНастройки <> Неопределено
					И СохраненныеПользовательскиеНастройки.Свойство("ПереопределяемыеНастройки") Тогда	
					ПереопределяемыеНастройки = СохраненныеПользовательскиеНастройки.ПереопределяемыеНастройки;	
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			СтруктураНастроекТиповая = Новый Структура;
		КонецЕсли;
	#КонецЕсли
	
	ЭтоБылТиповойБизнесПроцесс = ЭтоТиповойБизнесПроцесс;	
	
	СписокНередактируемыхУзловихНастроек.Добавить("Название");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипИсходногоДокумента1С");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипДокументаMS");
	СписокНередактируемыхУзловихНастроек.Добавить("ЗагружатьВТотЖе");
	СписокНередактируемыхУзловихНастроек.Добавить("ТипРезультирующегоДокумента1С");
	СписокНередактируемыхУзловихНастроек.Добавить("ВыполнитьТолькоПроизвольныйКод");
	СписокНередактируемыхУзловихНастроек.Добавить("ВыполнитьТолькоПроизвольныйКодВыгрузка");
	СписокНередактируемыхУзловихНастроек.Добавить("ОбработчикВыгрузкиДокумента");
	
	Если ЭтоНовыйБизнесПроцесс Тогда
		Пред_ID_БизнесПроцесса = ID_БизнесПроцесса;
		ID_БизнесПроцесса = _ЛокКонтекст.ЛокЯдро_ПолучитьНовыйID("BP");
		Модифицированность = Истина;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.Документы1С Цикл
		Элементы.ТипИсходногоДокумента1С.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
		Элементы.ТипРезультирующегоДокумента1С.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
	КонецЦикла;
	Элементы.ТипИсходногоДокумента1С.СписокВыбора.СортироватьПоПредставлению();
	Элементы.ТипРезультирующегоДокумента1С.СписокВыбора.СортироватьПоПредставлению();
	
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.ДокументыMS Цикл
		Элементы.ТипДокументаMS.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
	КонецЦикла;
	Элементы.ТипДокументаMS.СписокВыбора.СортироватьПоПредставлению();	;	
	
	Элементы.Используется.Заголовок = ?(Используется, 
			НСтр("ru = 'Включено';
					|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'"), 
			НСтр("ru = 'Отключено';
					|en = 'Disabled'; be = 'Адключаны'; es = 'Desconectado'; ka = 'გამორთულია'; kk = 'Ажыратылған'; ro = 'Dezactivat'; tr = 'Devre dışı bırakıldı'; uk = 'Відключений'; uz = 'O''chirilgan'")
	);
	ЭтоТиповойБизнесПроцессПриИзменении("");
	
	Если ЭтоТиповойБизнесПроцесс Тогда
		Элементы.ДекорацияПредупреждение.Заголовок = НСтр("ru = 'ВНИМАНИЕ! Это типовой бизнес процесс, и его редактирование ограничено. Вы можете создать полную копию этого бизнес процесса.';
															|en = 'Attention! This is a typical business process, and its editing is limited. You can create a complete copy of this business process.';
															|be = 'УВАГА! Гэта тыпавы бізнес працэс, і яго рэдагаванне абмежавана. Вы можаце стварыць поўную копію гэтага бізнес працэсу.'; es = '¡Atención! Este es un proceso comercial típico y su edición es limitada. Puede crear una copia completa de este proceso de negocio.'; ka = 'ყურადღება! ეს არის ტიპიური ბიზნეს პროცესი და მისი რედაქტირება შეზღუდულია. თქვენ შეგიძლიათ შექმნათ ამ ბიზნეს პროცესის სრული ასლი.'; kk = 'Назар аударыңыз! Бұл типтік бизнес процесс және оны редакциялау шектеулі. Сіз бұл бизнес процесінің толық көшірмесін жасай аласыз.'; ro = 'Atenție! Acesta este un proces tipic de afaceri, iar editarea acestuia este limitată. Puteți crea o copie completă a acestui proces de afaceri.'; tr = 'Dikkat! Bu tipik bir iş sürecidir ve düzenlemesi sınırlıdır. Bu iş sürecinin tam bir kopyasını oluşturabilirsiniz.'; uk = 'Увага! Це типовий бізнес процес, і його редагування обмежене. Ви можете створити повну копію цього бізнес процесу.'; uz = 'Diqqat! Bu odatiy biznes jarayoni va uni tahrirlash cheklangan. Siz ushbu biznes jarayonining to''liq nusxasini yaratishingiz mumkin.'");
	ИначеЕсли ЗначениеЗаполнено(ID_Узла) Тогда
		ТекстЗаголовка = НСтр("ru = 'ВНИМАНИЕ! Редактирование настроек для торгового объекта %1, и его редактирование ограничено.';
								|en = 'Attention! Editing the settings for the shopping facility is %1, and its editing is limited.';
								|be = 'УВАГА! Рэдагаванне налад для гандлёвага аб''екта %1, і яго рэдагаванне абмежавана.'; es = '¡Atención! Editar la configuración de un objeto comercial %1 y su edición está limitada.'; ka = 'ყურადღება! სავაჭრო ობიექტის პარამეტრების რედაქტირება %1-ია და მისი რედაქტირება შეზღუდულია.'; kk = 'Назар аударыңыз! %1 сауда объектісі үшін Параметрлерді өңдеу және оны өңдеу шектеулі.'; ro = 'Atenție! Editarea setărilor pentru unitatea de cumpărături este %1, iar editarea acesteia este limitată.'; tr = 'Dikkat! İşlem nesnesinin ayarlarını düzenlemek %1''dir ve düzenleme sınırlıdır.'; uk = 'Увага! Редагування налаштувань для торгового об''єкта %1, і його редагування обмежено.'; uz = 'Diqqat! Savdo ob''ektining sozlamalarini tahrirlash %1 va uni tahrirlash cheklangan.'");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, НаименованиеУзла);
		Элементы.ДекорацияПредупреждение.Заголовок = ТекстЗаголовка;
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(0,150,70);
		#Иначе
			Элементы.ДекорацияПредупреждение.Видимость = Ложь;
		#КонецЕсли
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		НастройкаОтбора_Интерактивный = НСтр("ru = 'Ручной обмен';
												|en = 'Manual exchange'; be = 'Ручной абмен'; es = 'Intercambio manual'; ka = 'სახელმძღვანელო გაცვლა'; kk = 'Қолмен алмасу'; ro = 'Schimb Manual'; tr = 'Manuel değişim'; uk = 'Ручний обмін'; uz = 'Qo''lda almashish'");
		НастройкаОтбора_Онлайн		  = НСтр("ru = 'Онлайн-обмен';
												|en = 'Online exchange'; be = 'Онлайн-абмен'; es = 'Intercambio en línea'; ka = 'ონლაინ გაცვლა'; kk = 'Онлайн алмасу'; ro = 'Schimb Online'; tr = 'Çevrimiçi değişim'; uk = 'Інтернет-обмін'; uz = 'Onlayn almashish'");
	#КонецЕсли
	
	Пред_Название				 = Название;
	Пред_ТипИсходногоДокумента1С = ТипИсходногоДокумента1С;
	
	РезультатРедактирования = "";
	
	ТекущееСоответствиеТаблицПравилОбмена = Новый Структура;
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("Выгрузка1С", ТипИсходногоДокумента1С); 
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("Загрузка1С", ТипРезультирующегоДокумента1С); 
	ТекущееСоответствиеТаблицПравилОбмена.Вставить("ЗагрузкаВыгрузкаMS", ТипДокументаMS); 
	
	ТипРезультирующегоДокумента1С_Шаблон = "Не используется";
	
	ОбновитьСпискиПроизвольныхКодов();
	ЗаполнитьНаименованияПроизвольныхКодов();
	ЗаполнитьНастройкиОтборов();
	
	ОбновитьВсеДанныеЭлементовФормы();
	
	ОтразитьПредставлениеНазначитьПользователю();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоТиповойБизнесПроцесс = Параметры.Свойство("ЭтоТиповойБизнесПроцесс") И Параметры.ЭтоТиповойБизнесПроцесс;
	ЭтоУзловыеНастройки 	= Параметры.Свойство("ID_Узла") И ЗначениеЗаполнено(Параметры.ID_Узла);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаДвижениеДокументовВерх.Доступность = НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаДвижениеДокументовНиз.Доступность = НЕ ЭтоУзловыеНастройки;
		
		Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Доступность =	НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Доступность =	НЕ ЭтоУзловыеНастройки;
		Элементы.НастроитьРеквизитыПредставленияШапки.Доступность = НЕ ЭтоУзловыеНастройки;
		Элементы.ОсновныеДействия.Кнопки.ФормаСкопировать.Доступность = НЕ ЭтоУзловыеНастройки;
		Если ЭтоУзловыеНастройки ИЛИ ЭтоТиповойБизнесПроцесс Тогда
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(255,0,0);
		Иначе
			Элементы.ДекорацияПредупреждение.ЦветТекста = Новый Цвет(0,150,70);
			Элементы.ДекорацияПредупреждение.Заголовок = НСтр("ru = 'Используйте бизнес процессы для настройки обмена документами в которых описаны правила выгрузки и загрузки документов. Список бизнес процессов общий для всех торговых объектов.';
																|en = 'Use business processes to set up document exchange, which describes the rules for uploading and uploading documents. The list of business processes is common to all retail facilities.';
																|be = 'Выкарыстоўвайце бізнес працэсы для налады абмену дакументамі у якіх апісаны правілы выгрузкі і загрузкі дакументаў. Спіс бізнес працэсаў агульны для ўсіх гандлёвых аб''ектаў.'; es = 'Utilice los procesos de negocio para configurar el intercambio de documentos que describen las reglas de carga y descarga de documentos. La lista de procesos de negocio es común a todos los objetos comerciales.'; ka = 'გამოიყენეთ ბიზნეს პროცესები დოკუმენტების გაცვლის დასაყენებლად, რომელიც აღწერს დოკუმენტების ატვირთვისა და ატვირთვის წესებს. ბიზნეს პროცესების ჩამონათვალი საერთოა ყველა საცალო ობიექტისთვის.'; kk = 'Құжаттарды жүктеу және жүктеу ережелерін сипаттайтын құжаттармен алмасуды конфигурациялау үшін бизнес-процестерді қолданыңыз. Бизнес-процестердің тізімі барлық сауда объектілеріне ортақ.'; ro = 'Utilizați procesele de afaceri pentru a configura schimbul de documente, care descrie regulile pentru încărcarea și încărcarea documentelor. Lista proceselor de afaceri este comună tuturor facilităților de vânzare cu amănuntul.'; tr = 'Belgelerin yüklenmesi ve yüklenmesi için kuralları açıklayan belge alışverişini yapılandırmak için iş süreçlerini kullanın. İş süreçlerinin listesi tüm ticari nesneler için ortaktır.'; uk = 'Використовуйте бізнес процеси для налаштування обміну документами в яких описані правила вивантаження і завантаження документів. Список бізнес процесів загальний для всіх торгових об''єктів.'; uz = 'Hujjatlarni yuklash va yuklash qoidalarini tavsiflovchi hujjatlar almashinuvini sozlash uchun biznes jarayonlaridan foydalaning. Barcha savdo ob''ektlari uchun umumiy bo''lgan biznes-jarayonlar ro''yxati.'");
		КонецЕсли;
	#Иначе
		КлючСохраненияПоложенияОкна = Новый УникальныйИдентификатор; // восстанавливает положение формы:

		Элементы.ГруппаДвижениеДокументов.Видимость 			= НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиВыгрузкиДокументаИз1С.Видимость = НЕ ЭтоУзловыеНастройки;
		Элементы.ГруппаНастройкиЗагрузкиДокументаИзMS.Видимость = НЕ ЭтоУзловыеНастройки;
		Элементы.Группа3.Видимость 								= Ложь; // Устаревшая настройка, скроем навсегда
		Элементы.ФормаСкопировать.Видимость 					= НЕ ЭтоУзловыеНастройки;
		Элементы.ДекорацияПредупреждение.Видимость 				= ЭтоУзловыеНастройки ИЛИ ЭтоТиповойБизнесПроцесс;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("СохранитьВнесенныеИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СохраненаНастройкаВыгрузкиПолей" Тогда
	
		ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр, Источник);
	
	КонецЕсли; 

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНастройку();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	СохранитьНастройку(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПользовательскиеНастройки(Команда)

	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки бизнес-процесса будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("УдалитьПользовательскиеНастройкиПослеОтветаНаВопрос", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);	
	
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("СкопироватьЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		РезультатРедактирования = Новый Структура("ID_РедактируемогоБП,Копирование",ID_БизнесПроцесса,Истина);
		Закрыть(РезультатРедактирования);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НастроитьРеквизитыТабличнойЧастиВыгрузкаНажатие(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПравилаВыгрузкиТЧ = ПолучитьФорму("ОФ_ФормаНастройки_ПравилаВыгрузкиТЧ",ЭтаФорма);
	#Иначе
		ФормаНастройки_ПравилаВыгрузкиТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПравилаВыгрузкиТЧ", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ПравилаВыгрузкиТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ПравилаВыгрузкиТЧ._ЛокКонтекст = _ЛокКонтекст;
	ФормаНастройки_ПравилаВыгрузкиТЧ.СтруктураДокумента1С = ?(ТипИсходногоДокумента1С = "",Новый Структура(),_ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипИсходногоДокумента1С]);
	ФормаНастройки_ПравилаВыгрузкиТЧ.СтруктураДокументаMS = ?(ТипДокументаMS = "",Новый Структура(),_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS]);
	ФормаНастройки_ПравилаВыгрузкиТЧ.ТипДокумента1С = ТипИсходногоДокумента1С;
	ФормаНастройки_ПравилаВыгрузкиТЧ.ТипДокументаMS = ТипДокументаMS;
	
	ФормаНастройки_ПравилаВыгрузкиТЧ.ЭтоТиповаяНастройка				= ЭтоТиповойБизнесПроцесс;
	ФормаНастройки_ПравилаВыгрузкиТЧ.ТаблицаРеквизитовДополнительная 	= _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(НастройкаВыгрузкиПолей);
	ФормаНастройки_ПравилаВыгрузкиТЧ.ТабличныеЧасти 					= _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(НастройкаВыгрузкиТЧ);
	ФормаНастройки_ПравилаВыгрузкиТЧ.СвязиТабличныхЧастей 				= _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СвязиТабличныхЧастей);
	
	пСтруктураНастроекТиповая = Новый Структура;
	пСтруктураНастроекТиповая.Вставить("СвязиТабличныхЧастей");
	пСтруктураНастроекТиповая.Вставить("НастройкаВыгрузкиТЧ");
	пСтруктураНастроекТиповая.Вставить("НастройкаВыгрузкиПолей");
	ЗаполнитьЗначенияСвойств(пСтруктураНастроекТиповая, СтруктураНастроекТиповая);
	ФормаНастройки_ПравилаВыгрузкиТЧ.СтруктураНастроекТиповая 			= пСтруктураНастроекТиповая;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_ПравилаВыгрузкиТЧЗакрытие",ЭтаФорма);
	ФормаНастройки_ПравилаВыгрузкиТЧ.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПравилаВыгрузкиТЧ.ОткрытьМодально();
	#Иначе
		ФормаНастройки_ПравилаВыгрузкиТЧ.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьПользователюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	InternetGateOption 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("InternetGateOption");
	флЛегкоеОблако 		= InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE";

	ПредоставлятьВыборСпособаНазначения = Ложь;
	ПараметрыПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	Если ПараметрыПодключения <> Неопределено Тогда
		Если ТипЗнч(ПараметрыПодключения) = Тип("Структура") И ПараметрыПодключения.Свойство("ИдПриложения") И ПараметрыПодключения.Свойство("ИдОсновногоПриложения") Тогда
			ТипУстановленногоПродукта = _ЛокКонтекст.ЛокЯдро_ПолучитьТипУстановленногоПродукта(ПараметрыПодключения.ИдПриложения, ПараметрыПодключения.ИдОсновногоПриложения);
			ПредоставлятьВыборСпособаНазначения = (ТипУстановленногоПродукта = "МДЛП" Или флЛегкоеОблако = Истина);
		КонецЕсли;
	КонецЕсли;
	
	СпособНазначения = "Пользователям";
	
	Если ПредоставлятьВыборСпособаНазначения Тогда
		СписокВыбора = Новый СписокЗначений();
		СписокВыбора.Добавить("Пользователям", "Пользователям, группе пользователей");
		СписокВыбора.Добавить("Устройству", "Конкретному устройству");
		
		ВыбранноеЗначение = СписокВыбора.ВыбратьЭлемент("Укажите способ назначения", СписокВыбора[0]);
		Если ВыбранноеЗначение <> Неопределено Тогда
			СпособНазначения = ВыбранноеЗначение.Значение;	
		Иначе
			СпособНазначения = "";
		КонецЕсли;
	КонецЕсли;
	
	Если СпособНазначения = "Пользователям" Тогда 
		ПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;		
	Иначе
		Если СпособНазначения = "Устройству" Тогда
			НазначитьПользователю = "Конкретному устройству";		         
		КонецЕсли;
		Возврат;
	КонецЕсли;    	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы",ЭтаФорма);
	#Иначе	
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	УбратьПредставлениеНазначитьПользователю();
	ФормаСлужебная_ВыборПользователяИлиГруппы.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборПользователяИлиГруппы._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ТекущиеПользователи = НазначитьПользователю;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = ПользователиMS;
	ФормаСлужебная_ВыборПользователяИлиГруппы.СпособНазначения = СпособНазначения;
	
	Если флЛегкоеОблако <> Истина И СпособНазначения = "Устройству" Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = НСтр("ru = 'Клеверенс: Выбор устройства';
																	|en = 'Cleverence: Device Selection'; be = 'Cleverence: Выбар прылады'; es = 'Cleverence: Selección de dispositivos'; ka = 'Cleverence: მოწყობილობის შერჩევა'; kk = 'Cleverence: құрылғыны таңдау'; ro = 'Cleverence: Selectarea Dispozitivului'; tr = 'Cleverence: Cihaz seçimi'; uk = 'Cleverence: вибір пристрою'; uz = 'Cleverence: qurilmani tanlash'");
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMS"].Колонки["ПользователиMSГруппаПользователь"].ТекстШапки = НСтр("ru = 'Устройство';
																																				|en = 'Device'; be = 'Прыстасаванне'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");	
		#Иначе
			ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("ru = 'Устройство';
																														|en = 'Device'; be = 'Прыстасаванне'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		#КонецЕсли
	КонецЕсли;     
	
	ОП = Новый ОписаниеОповещения("Служебная_ВыборПользователяИлиГруппыЗакрытие",ЭтаФорма);
	ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();	
	
КонецПроцедуры

&НаКлиенте 
Процедура ИспользуетсяПриИзменении(Элемент)
	Модифицированность = Истина;
	УстановитьЦветаЭлементов();
	Элемент.Заголовок = ?(Используется, 
		НСтр("ru = 'Включено';
				|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'"), 
		НСтр("ru = 'Отключено';
				|en = 'Disabled'; be = 'Адключаны'; es = 'Desconectado'; ka = 'გამორთულია'; kk = 'Ажыратылған'; ro = 'Dezactivat'; tr = 'Devre dışı bırakıldı'; uk = 'Відключений'; uz = 'O''chirilgan'")
	);
КонецПроцедуры

&НаКлиенте
Процедура НазваниеПриИзменении(Элемент)
	
	// Если изменилось название бизнес-процесса, нужно изменить название сохраненных отборов
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		НайденныеСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("РежимОбмена", РежимОбмена));
		Если НайденныеСтроки.Количество() Тогда
			НайденныеСтроки[0].Название = Название;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ТипИсходногоДокумента1СПриИзменении(Элемент)
	
	Модифицированность = Истина;	
	
	// При изменении типа исходного документа настройки отборов становятся неактуальными
	ЕстьНастройкаОтбора_Интерактивный = Ложь;
	ЕстьНастройкаОтбора_Онлайн		  = Ложь;
	НастройкиОтборов.Очистить();
	
	// Если существуют сохраненные настройки отборов для выбранного типа исходного документа, восстановим их
	Если ЗначениеЗаполнено(ТипИсходногоДокумента1С)
		И СокрЛП(ТипИсходногоДокумента1С) = СокрЛП(Пред_ТипИсходногоДокумента1С) Тогда
		ЗаполнитьНастройкиОтборов();
	КонецЕсли;
	
	ОбновитьВсеДанныеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте 
Процедура ТипИсходногоДокумента1СОчистка(Элемент, СтандартнаяОбработка)
	
	Модифицированность = Истина;	
	
	УстановитьЗначенияРеквизитов();
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

