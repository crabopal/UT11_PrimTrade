&НаСервереБезКонтекста
Функция ПолучитьВладельцаХарактеристик(Номенклатура)

	Владелец = Неопределено;
		
	// Если признак использования характеристик зашит в номенклатуре
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ИспользованиеХарактеристик") <> Неопределено 
		И Метаданные.Перечисления.Найти("ВариантыИспользованияХарактеристикНоменклатуры") <> Неопределено Тогда	
		
		Если Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры") Тогда
			Владелец = Номенклатура.ВидНоменклатуры;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры") Тогда
			Владелец = Номенклатура;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры") Тогда
			Владелец = Номенклатура.ВладелецХарактеристик;
		ИначеЕсли Номенклатура.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать") Тогда
			Владелец = Неопределено;		
		Иначе		
			Владелец = Неопределено;		
		КонецЕсли;			
		
	// Если признак использования характеристик зашит в виде номенклатуры
	ИначеЕсли Метаданные.Справочники.ВидыНоменклатуры.Реквизиты.Найти("ИспользованиеХарактеристик") <> Неопределено 
		И Метаданные.Перечисления.Найти("ВариантыВеденияДополнительныхДанныхПоНоменклатуре") <> Неопределено Тогда	
		
		Если Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.ОбщиеДляВидаНоменклатуры") Тогда
			Владелец = Номенклатура.ВидНоменклатуры;	
		ИначеЕсли Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.ИндивидуальныеДляНоменклатуры") Тогда
			Владелец = Номенклатура;	
		ИначеЕсли Номенклатура.ВидНоменклатуры.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.НеИспользовать") Тогда
			Владелец = Неопределено;	
		Иначе
			Владелец = Неопределено;	
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Владелец;
	
КонецФункции

// Получает структуру имен колонок таблицы
//
// Возвращаемое значение:
//   Стуктура   - структура имен колонок таблицы
//
Функция ПолучитьСтруктуруИменКолонокТаблицы()

	СтруктураИменКолонок = Новый Структура;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТаблицаЗначений = ТаблицаНовыеШтрихкоды;
	#Иначе
		ТаблицаЗначений = ТаблицаНовыеШтрихкоды.Выгрузить();
	#КонецЕсли
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		СтруктураИменКолонок.Вставить(Колонка.Имя);	
	КонецЦикла;

	Возврат СтруктураИменКолонок;
	
КонецФункции

&НаКлиенте
Функция ТекстИзменениеДанных()
	Возврат НСтр("ru = 'Изменение данных';
					|en = 'Changing data'; be = 'Змена дадзеных'; es = 'Modificación de datos'; ka = 'მონაცემების შეცვლა'; kk = 'Деректерді өзгерту'; ro = 'Schimbarea datelor'; tr = 'Verileri değiştirme'; uk = 'Зміна даних'; uz = 'Ma''lumotlarni o''zgartirish'");
КонецФункции

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Процедура ОФ_ДействиеНачалоВыбораЗначения(Элемент, СтандартнаяОбработка)
		
		ТекущиеДанные = Элементы.ТаблицаНовыеШтрихкоды.ТекущиеДанные;
		ИмяКолонки = Элементы.ТаблицаНовыеШтрихкоды.ТекущаяКолонка.Имя;
		ТекущееЗначение = ТекущиеДанные[ИмяКолонки];
		
		//получить владельцев
		попытка
			СтандартнаяОбработка = НЕ ЕстьВладельцыОбъекта(ТекущееЗначение);		
		Исключение
		КонецПопытки;
		
		//отбор в поле по владельцу
		Если НЕ СтандартнаяОбработка Тогда
			Попытка
				ИзмерениеНоменклатуры = СтруктураХраненияШК.ШК_ИзмерениеНоменклатуры;
				Номенклатура = ТекущиеДанные[ИзмерениеНоменклатуры];
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					ПараметрыФормы = Новый Структура;
					Отбор = Новый Структура;
					ПараметрыФормы.Вставить("Отбор", Отбор);				
					Если ИмяКолонки = "Характеристика" Тогда
						Владелец = ПолучитьВладельцаХарактеристик(Номенклатура);					
						Если ЗначениеЗаполнено(Владелец) Тогда
							Отбор.Вставить("Владелец", Владелец);					
						Иначе
							ПараметрыФормы.Вставить("Номенклатура", Номенклатура);					
						КонецЕсли;	
					ИначеЕсли ИмяКолонки = СтруктураХраненияШК.ШК_ИзмерениеУпаковки Тогда
						СправочникУпаковки 		= Метаданные.НайтиПоТипу(ТипЗнч(ТекущееЗначение));
						СправочникНоменклатура 	= Метаданные.НайтиПоТипу(ТипЗнч(Номенклатура));
						Если СправочникУпаковки <> Неопределено
							И СправочникНоменклатура <> Неопределено
							И Метаданные.Справочники.Содержит(СправочникУпаковки)
							И СправочникУпаковки.Владельцы.Содержит(СправочникНоменклатура) Тогда
							Отбор.Вставить("Владелец", Номенклатура);
						КонецЕсли;	
					ИначеЕсли ИмяКолонки = "Упаковка" Тогда
						ПараметрыФормы.Вставить("Номенклатура", Номенклатура);										
					КонецЕсли;	
					//ДополнительныеПараметры = Новый Структура;
					//ДополнительныеПараметры.Вставить("ИмяСправочника", ИмяКолонки);
					//ОповещениеПослеВыбораЗначения = Новый ОписаниеОповещения("ОповещениеПослеВыбораЗначения", ЭтаФорма, ДополнительныеПараметры);
					//ФормаВыбора = ОткрытьФорму(ИмяТаблицыПоСсылке(ТекущееЗначение) + ".ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , ОповещениеПослеВыбораЗначения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
					ФормаВыбора = ПолучитьФорму(ИмяТаблицыПоСсылке(ТекущееЗначение) + ".ФормаВыбора", ПараметрыФормы, ЭтаФорма);
					ВыбранноеЗначение = ФормаВыбора.ОткрытьМодально();
					Если ВыбранноеЗначение <> Неопределено Тогда
						ТекущиеДанные[ИмяКолонки] = ВыбранноеЗначение;
					КонецЕсли;	
				Иначе
					ТекстПредупреждения = НСтр("ru = 'Не выбрана номенклатура!';
												|en = 'The nomenclature is not selected!'; be = 'Не абраная наменклатура!'; es = '¡Nomenclatura no seleccionada!'; ka = 'ნომენკლატურა არ არის შერჩეული!'; kk = 'Номенклатура таңдалмаған!'; ro = 'Nomenclatura nu este selectată!'; tr = 'İsimlendirme seçilmedi!'; uk = 'Не обрана номенклатура!'; uz = 'Nomenklatura tanlanmagan!'");
					ПоказатьПредупреждение(, ТекстПредупреждения, 10, ТекстИзменениеДанных()); 
				КонецЕсли;
			Исключение
				Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); 
			КонецПопытки;
		КонецЕсли;
		
	КонецПроцедуры
	
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли