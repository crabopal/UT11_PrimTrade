/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаСервере
Перем _ГлКонтекст;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УдалятьИзИсточника = Истина;
	
	// Заполняем таблицу соответствия ключей по умолчанию
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "НастройкиБизнесПроцессов_ПоУмолчанию";
	НоваяСтрока.ИмяПользовательской = "НастройкиБизнесПроцессов_Пользовательские";
	
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "НастройкиОтборовУзлов_ПоУмолчанию_Онлайн";
	НоваяСтрока.ИмяПользовательской = "НастройкиОтборовУзлов_Онлайн";
	
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "НастройкиОтборовУзлов_ПоУмолчанию_Интерактивный";
	НоваяСтрока.ИмяПользовательской = "НастройкиОтборовУзлов_Интерактивный";
	
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "ПроизвольныеОтборыДокументов";
	НоваяСтрока.ИмяПользовательской = "ПроизвольныеОтборыДокументов";
	
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "ГлобальныеПараметры_ПоУмолчанию";
	НоваяСтрока.ИмяПользовательской = "ГлобальныеПараметры_Пользовательские";
	
	НоваяСтрока = ИменаНастроек.Добавить();
	НоваяСтрока.Использовать 		= Ложь;
	НоваяСтрока.ИмяТиповой 			= "ПроизвольныеКоды_ПоУмолчанию";
	НоваяСтрока.ИмяПользовательской = "ПроизвольныеКоды_Пользовательские";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПереносНастроекВПользовательские(Команда)
	
	ОчиститьСообщения();
	ПереносНастроек_Начало("ВПользовательские");
	
КонецПроцедуры

&НаКлиенте
Процедура ПереносНастроекВТиповые(Команда)
	
	ОчиститьСообщения();
	ПереносНастроек_Начало("ВТиповые");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФайлыНастроек(Команда)
	
	ОчиститьСообщения();
	АнализXML_ПроверитьCustomSettingsDflt();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьCustomSettingsDflt(Команда)
	
	ОчиститьСообщения();
	ОбновлениеXML_ОбновитьCustomSettingsDflt();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для каждого СтрокаСписка Из ИменаНастроек Цикл
		СтрокаСписка.Использовать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для каждого СтрокаСписка Из ИменаНастроек Цикл
		СтрокаСписка.Использовать = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьCustomSettingsНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	
	ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим); 
	ДиалогОткрытия.Каталог = ""; 
	ДиалогОткрытия.МножественныйВыбор = Ложь; 
	ДиалогОткрытия.Заголовок = "Типовой файл CustomSettings.xml";
	ДиалогОткрытия.Фильтр = "CustomSettings.xml|*.xml";
	
	ОП = Новый ОписаниеОповещения("ВыборПутьCustomSettingsЗавершение", ЭтаФорма);
	ДиалогОткрытия.Показать(ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьCustomSettingsDfltНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	
	ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим); 
	ДиалогОткрытия.Каталог = ""; 
	ДиалогОткрытия.МножественныйВыбор = Ложь; 
	ДиалогОткрытия.Заголовок = "Типовой файл CustomSettings.dflt.xml";
	ДиалогОткрытия.Фильтр = "CustomSettings.dflt.xml|*.xml";
	
	ОП = Новый ОписаниеОповещения("ВыборПутьCustomSettingsDfltЗавершение", ЭтаФорма);
	ДиалогОткрытия.Показать(ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	
	ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим); 
	ДиалогОткрытия.Каталог = ""; 
	ДиалогОткрытия.МножественныйВыбор = Ложь; 
	ДиалогОткрытия.Заголовок = "Каталог файлов настроек";
	
	ОП = Новый ОписаниеОповещения("ВыборКаталогФайловЗавершение", ЭтаФорма);
	ДиалогОткрытия.Показать(ОП);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы



#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьГлЯдро()
	
	Если _ГлКонтекст = Неопределено Тогда
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			_ГлКонтекст = ОбработкаОбъект;
		#Иначе
			_ГлКонтекст = РеквизитФормыВЗначение("Объект");
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

// Перенос типовых и пользовательских настроек между default_customsettings и customsettings
#Область ПереносНастроек_CustomSettings

&НаКлиенте
Процедура ПереносНастроек_Начало(Направление)
	
	Если НЕ ЗначениеЗаполнено(ПутьCustomSettings) Тогда
		Сообщить("Не выбран файл CustomSettings.xml");	
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПутьCustomSettingsDflt) Тогда
		Сообщить("Не выбран файл CustomSettings.dflt.xml");	
		Возврат;
	КонецЕсли;
	Если ПутьCustomSettings = ПутьCustomSettingsDflt Тогда
		Сообщить("Выбран один и тот же файл в CustomSettings.xml и CustomSettings.dflt.xml");	
		Возврат;
	КонецЕсли;
	
	ТиповаяСтруктура = Новый Структура;
	ПользовательскаяСтруктура = Новый Структура;
	
	Для каждого СтрокаНастройки Из ИменаНастроек Цикл
		
		Если СтрокаНастройки.Использовать Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ИмяТиповой) Тогда
				Сообщить("В таблице не указано имя типовой настройки");	
				Возврат;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаНастройки.ИмяПользовательской) Тогда
				Сообщить("В таблице не указано имя пользовательской настройки");	
				Возврат;
			КонецЕсли;
			
			Попытка
				ТиповаяСтруктура.Вставить(СокрЛП(СтрокаНастройки.ИмяТиповой));
			Исключение
				Сообщить("Ошибка в имени типовой настройки: " + СтрокаНастройки.ИмяТиповой);	
				Возврат;
			КонецПопытки;
			
			Попытка
				ПользовательскаяСтруктура.Вставить(СокрЛП(СтрокаНастройки.ИмяПользовательской));
			Исключение
				Сообщить("Ошибка в имени пользовательской настройки: " + СтрокаНастройки.ИмяПользовательской);	
				Возврат;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ТиповаяСтруктура.Количество() Тогда
		Сообщить("Нет выбранных имён настроек для переноса");
		Возврат;
	КонецЕсли;
	
	Если Направление = "ВТиповые" Тогда
		пЗаголовок = "Перенести выбранные настройки в файл типовых настроек?";
		пСообщение = "Выбранные имена настроек будут перенесены в файл типовых настроек, если настройка присутсвует. Настройки станут типовыми.";
	Иначе
		пЗаголовок = "Перенести выбранные настройки в файл пользовательских настроек?";
		пСообщение = "Выбранные имена настроек будут перенесены в файл пользовательских настроек, если настройка присутсвует. Настройки станут пользовательскими.";
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ПереносНастроек_ВопросПеренестиНастройкиЗавершение",  ЭтаФорма, Направление);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПереносНастроек_ВопросПеренестиНастройкиЗавершение(Результат, Направление) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПередаваемыеФайлы = Новый Массив;
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьCustomSettings));
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьCustomSettingsDflt));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Направление", Направление);
		ДополнительныеПараметры.Вставить("ПутьCustomSettings", ПутьCustomSettings);
		ДополнительныеПараметры.Вставить("ПутьCustomSettingsDflt", ПутьCustomSettingsDflt);
		
		ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ПереносНастроек_ПослеПомещенияФайловНаСервер", ЭтаФорма, ДополнительныеПараметры);
		
		ПараметрыПомещения = Новый Структура;
		ПараметрыПомещения.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Идентификатор = Новый УникальныйИдентификатор();
		#Иначе
			Идентификатор = ЭтаФорма.УникальныйИдентификатор;
		#КонецЕсли
		
		_ЛокКонтекст.ЛокЯдро_РаботаСФайлами_ПоместитьФайлыНаСервер(ПередаваемыеФайлы, Идентификатор, ПараметрыПомещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереносНастроек_ПослеПомещенияФайловНаСервер(ПереданныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПереданныеФайлы = Неопределено 
		ИЛИ ПереданныеФайлы.Количество() = 0 Тогда
		Сообщить("Не удалось поместить файлы на сервер");
		Возврат;
	КонецЕсли;
	
	АдресCustomSettings = Неопределено;
	АдресCustomSettingsDflt = Неопределено;
	
	Для каждого ПереданныйФайл Из ПереданныеФайлы Цикл
		Если ДополнительныеПараметры.ПутьCustomSettings = ПереданныйФайл.ПолноеИмя Тогда
			АдресCustomSettings = ПереданныйФайл.Хранение;
		ИначеЕсли ДополнительныеПараметры.ПутьCustomSettingsDflt = ПереданныйФайл.ПолноеИмя Тогда
			АдресCustomSettingsDflt = ПереданныйФайл.Хранение;
		КонецЕсли;
	КонецЦикла;
	
	Результат = ПереносНастроек_ОбработатьФайлыНаСервере(АдресCustomSettings, АдресCustomSettingsDflt, ДополнительныеПараметры.Направление);
	
	Если Результат.Изменен
		И ЭтоАдресВременногоХранилища(Результат.АдресФайла) Тогда
		
		ПередаваемыеФайлы = Новый Массив;
		
		Если УдалятьИзИсточника Тогда
			ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьCustomSettings, АдресCustomSettings));
			ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьCustomSettingsDflt, АдресCustomSettingsDflt));
		Иначе
			
			Если Результат.АдресФайла <> АдресCustomSettings И ЭтоАдресВременногоХранилища(АдресCustomSettings) Тогда
				УдалитьИзВременногоХранилища(АдресCustomSettings);
			КонецЕсли;
			Если Результат.АдресФайла <> АдресCustomSettingsDflt И ЭтоАдресВременногоХранилища(АдресCustomSettingsDflt) Тогда
				УдалитьИзВременногоХранилища(АдресCustomSettingsDflt);
			КонецЕсли;
			
			ПолноеИмя = ?(ДополнительныеПараметры.Направление = "ВТиповые", ПутьCustomSettingsDflt, ПутьCustomSettings);
			ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмя, Результат.АдресФайла));
			
		КонецЕсли;
		
		ОП = Новый ОписаниеОповещения("ПереносНастроек_Завершение", ЭтаФорма, ДополнительныеПараметры);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОповещениеОбработкиЗавершения", ОП);
		
		_ЛокКонтекст.ЛокЯдро_РаботаСФайлами_ПолучитьФайлыССервера(ПередаваемыеФайлы, ДополнительныеПараметры);
		
	Иначе
		Если ЭтоАдресВременногоХранилища(АдресCustomSettings) Тогда
			УдалитьИзВременногоХранилища(АдресCustomSettings);
		КонецЕсли;
		Если ЭтоАдресВременногоХранилища(АдресCustomSettingsDflt) Тогда
			УдалитьИзВременногоХранилища(АдресCustomSettingsDflt);
		КонецЕсли;
		Сообщить("В файле нет изменений");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПереносНастроек_ОбработатьФайлыНаСервере(АдресCustomSettings, АдресCustomSettingsDflt, Направление)
	
	ИнициализироватьГлЯдро();
	
	Результат = Новый Структура("Изменен, АдресФайла", Ложь);
	
	// === Чтение настроек из файла ===
	ПрочитатьНастройки = Новый Структура;
	СоответствиеНастроек = Новый Структура;
	
	ТиповаяСтруктура = Новый Структура;
	ПользовательскаяСтруктура = Новый Структура;
	
	Для каждого СтрокаНастройки Из ИменаНастроек Цикл
		Если СтрокаНастройки.Использовать Тогда
			ТиповаяСтруктура.Вставить(СокрЛП(СтрокаНастройки.ИмяТиповой), СокрЛП(СтрокаНастройки.ИмяПользовательской));
			ПользовательскаяСтруктура.Вставить(СокрЛП(СтрокаНастройки.ИмяПользовательской), СокрЛП(СтрокаНастройки.ИмяТиповой));
			
			Если Направление = "ВТиповые" Тогда
				ПрочитатьНастройки.Вставить(СокрЛП(СтрокаНастройки.ИмяПользовательской));
				СоответствиеНастроек.Вставить(СокрЛП(СтрокаНастройки.ИмяПользовательской), СокрЛП(СтрокаНастройки.ИмяТиповой));
			Иначе
				ПрочитатьНастройки.Вставить(СокрЛП(СтрокаНастройки.ИмяТиповой));
				СоответствиеНастроек.Вставить(СокрЛП(СтрокаНастройки.ИмяТиповой), СокрЛП(СтрокаНастройки.ИмяПользовательской));
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Направление = "ВТиповые" Тогда 
		// Читаем пользовательские настройки
		_ГлКонтекст.ГлЯдро_ПрочитатьНастройкиИзФайлаCustomSettings(АдресCustomSettings, ПрочитатьНастройки);
	Иначе
		// Читаем типовые настройки
		_ГлКонтекст.ГлЯдро_ПрочитатьНастройкиИзФайлаCustomSettings(АдресCustomSettingsDflt, ПрочитатьНастройки);	
	КонецЕсли;
	
	// =================================
	
	// Проверяем заполненность настроек
	СтруктураИсточника = Новый Структура;
	Для каждого КлючЗначение Из ПрочитатьНастройки Цикл
		
		Если КлючЗначение.Значение = Неопределено Тогда
			Сообщить("Не найдено значение настройки: " + КлючЗначение.Ключ);
			
		ИначеЕсли (КлючЗначение.Ключ = "НастройкиБизнесПроцессов_Пользовательские"
				ИЛИ КлючЗначение.Ключ = "НастройкиБизнесПроцессов_ПоУмолчанию")
			И (ТипЗнч(КлючЗначение.Значение) <> Тип("Структура")
				ИЛИ ТипЗнч(КлючЗначение.Значение.НастройкиБизнесПроцессов) <> Тип("Массив")) Тогда
			
			Сообщить("Бизнес-процессы отсутствуют или не соответствуют формату.");
			
		Иначе
			СтруктураИсточника.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СтруктураИсточника.Количество() Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураПриемника = Новый Структура;
	УдаляемыеНастройки = Новый Массив;
	
	// === Обработка настроек файла ===
	
	Если Направление = "ВТиповые" Тогда
		
		// Перевод бизнес-процессов в типовые
		КлючБизнесПроцессов = "НастройкиБизнесПроцессов_Пользовательские";
		СтруктураБизнесПроцессов = Неопределено;
		Если СтруктураИсточника.Свойство(КлючБизнесПроцессов, СтруктураБизнесПроцессов)
			И ТипЗнч(СтруктураБизнесПроцессов) = Тип("Структура") Тогда
			
			НастройкиБизнесПроцессов = _ГлКонтекст.ГлЯдро_ПреобразоватьБизнесПроцессыВТиповые(СтруктураБизнесПроцессов.НастройкиБизнесПроцессов);
			СтруктураИсточника[КлючБизнесПроцессов].Вставить("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов);
			
			// Удаляем ВерсияОбработкиНастроек, чтобы при инициализации прошло обновление
			УдаляемыеНастройки.Добавить("ВерсияОбработкиНастроек");
			
		КонецЕсли;
		
	Иначе
		
		// Перевод бизнес-процессов в пользовательские
		КлючБизнесПроцессов = "НастройкиБизнесПроцессов_ПоУмолчанию";
		СтруктураБизнесПроцессов = Неопределено;
		Если СтруктураИсточника.Свойство(КлючБизнесПроцессов, СтруктураБизнесПроцессов)
			И ТипЗнч(СтруктураБизнесПроцессов) = Тип("Структура") Тогда
			
			НастройкиБизнесПроцессов = _ГлКонтекст.ГлЯдро_ПреобразоватьБизнесПроцессыВПользовательские(СтруктураБизнесПроцессов.НастройкиБизнесПроцессов);
			СтруктураИсточника[КлючБизнесПроцессов].Вставить("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов);
			
			// Заменяем версию ВерсияОбработкиНастроек, чтобы при инициализации прошло обновление
			ВерсияНастроек = _ГлКонтекст.ГлЯдро_КонвертироватьВерсиюВЧисло(СтруктураБизнесПроцессов.ВерсияНастроек);
			СтруктураПриемника.Вставить("ВерсияОбработкиНастроек", ВерсияНастроек);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	// =================================
	
	
	// Записываем результаты редактирования в xml
	Для каждого КлючЗначение Из СтруктураИсточника Цикл
		ИмяКлючаПриемника = СоответствиеНастроек[КлючЗначение.Ключ];
		СтруктураПриемника.Вставить(ИмяКлючаПриемника, КлючЗначение.Значение);
		УдаляемыеНастройки.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Если Направление = "ВТиповые" Тогда 
		
		Если УдалятьИзИсточника Тогда
			// Удаляем настройки из источника
			Результат = _ГлКонтекст.ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресCustomSettings, Новый Структура, УдаляемыеНастройки);
		КонецЕсли;
		
		// Запись в типовые
		Результат = _ГлКонтекст.ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресCustomSettingsDflt, СтруктураПриемника);
	Иначе
		
		Если УдалятьИзИсточника Тогда
			// Удаляем настройки из источника
			Результат = _ГлКонтекст.ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресCustomSettingsDflt, Новый Структура, УдаляемыеНастройки);
		КонецЕсли;
		
		// Запись в пользовательские
		Результат = _ГлКонтекст.ГлЯдро_ЗаписатьНастройкиВФайлCustomSettings(АдресCustomSettings, СтруктураПриемника);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ПереносНастроек_Завершение(ПереданныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПереданныеФайлы = Неопределено 
		ИЛИ ПереданныеФайлы.Количество() = 0 Тогда
		Сообщить("Не удалось получить файлы с сервера.");
		Возврат;
	КонецЕсли;
	
	Для каждого ОписаниеПереданногоФайла Из ПереданныеФайлы Цикл
		Если ЭтоАдресВременногоХранилища(ОписаниеПереданногоФайла.Хранение) Тогда
			УдалитьИзВременногоХранилища(ОписаниеПереданногоФайла.Хранение);
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("Настройки успешно перенесены");
	
КонецПроцедуры

#КонецОбласти

// Служебный метод для проверки файлов CustomSettingsDflt
&НаКлиенте
Процедура АнализXML_ПроверитьCustomSettingsDflt()
	
	Если ПустаяСтрока(КаталогФайлов) Тогда
		Сообщить("Не выбран каталог файлов");
		Возврат;
	КонецЕсли;
	
	МассивФайлов = НайтиФайлы(КаталогФайлов, "*.xml?");
	
	ПередаваемыеФайлы = Новый Массив;
	Для каждого Файл Из МассивФайлов Цикл
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя));
	КонецЦикла;
	
	Если НЕ ПередаваемыеФайлы.Количество() Тогда
		Сообщить("В каталоге: " + КаталогФайлов + " не найдены файлы .xml для проверки");
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Идентификатор = Новый УникальныйИдентификатор();
	#Иначе
		Идентификатор = ЭтаФорма.УникальныйИдентификатор;
	#КонецЕсли
	
	_ЛокКонтекст.ЛокЯдро_АнализXML_ПроверитьCustomSettingsDflt(ПередаваемыеФайлы, Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеXML_ОбновитьCustomSettingsDflt()
	
	Если НЕ ЗначениеЗаполнено(ПутьCustomSettingsDflt) Тогда
		Сообщить("Не выбран файл CustomSettings.dflt.xml");	
		Возврат;
	КонецЕсли;
	
	ПередаваемыеФайлы = Новый Массив;
	ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьCustomSettingsDflt));
	
	ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ОбновлениеXML_ОбновитьCustomSettingsDfltЗавершение", ЭтаФорма);
	
	ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Идентификатор = Новый УникальныйИдентификатор();
	#Иначе
		Идентификатор = ЭтаФорма.УникальныйИдентификатор;
	#КонецЕсли
	
	_ЛокКонтекст.ЛокЯдро_ОбновлениеXML_ОбновитьCustomSettingsDflt(ПередаваемыеФайлы, Идентификатор, ПараметрыОбновления);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновлениеXML_ОбновитьCustomSettingsDfltЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		Сообщить("Файл настрок обновлен");
	Иначе
		Сообщить("Не удалось обновить файл настроек");
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ВыборПутьCustomSettingsЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Количество() Тогда
		ПутьCustomSettings = Результат[0];
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыборПутьCustomSettingsDfltЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Количество() Тогда
		ПутьCustomSettingsDflt = Результат[0];
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыборКаталогФайловЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Количество() Тогда
		КаталогФайлов = Результат[0];
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элементы = ЭлементыФормы;
	Объект = ЭтаФорма;
#КонецЕсли