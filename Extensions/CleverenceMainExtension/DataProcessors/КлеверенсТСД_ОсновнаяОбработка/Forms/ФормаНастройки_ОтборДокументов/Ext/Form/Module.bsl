/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СхемаСКД = _ЛокКонтекст.ЛокЯдро_ПолучитьКомпоновкуСКДДляОтбораДокументов1С(ТипДокумента1С, ID_Узла);
	ИнициализироватьКомпоновщикаИзВременногоХранилища(СхемаСКД);
	
	НастройкиКомпоновки = Неопределено;
	Если ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
		НастройкиКомпоновки = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(СтрЗаменить(НастройкаКомпоновщикаСтрокой, Символы.ВК, ""));
	КонецЕсли; 	
	
	Если НастройкиКомпоновки <> Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(НастройкиКомпоновки);
	Иначе
		//ПараметрГлубина = Компоновщик.Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ГлубинаОтбора")).
		Для Каждого ЭлПараметр из Компоновщик.Настройки.ПараметрыДанных.Элементы Цикл
			Если ЭлПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ГлубинаОтбора") Тогда
				ЭлПараметр.Использование = Истина;
				ЭлПараметр.ПредставлениеПользовательскойНастройки = "Глубина отбора (количество в днях)";
				ЭлПараметр.Значение = 10;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// В список глобальных первым выведем пользователя ТСД
	Если ТипОбмена = "Онлайн" Тогда
		СтрокаПараметра = ЗначенияОбщихПараметров.Добавить();
		СтрокаПараметра.Наименование = "Пользователь ТСД";
		СтрокаПараметра.Значение = "Сопоставьте этот параметр с полем шапки документа 1С, с ответственным, который должен получить этот документ для обработки на ТСД, для отбора по пользователю ТСД.";
	КонецЕсли;
	
	ТаблицаПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла);
	Если ТипЗнч(ТаблицаПараметров) = Тип("Массив") Тогда
		Для Каждого СтрокаПараметра Из ТаблицаПараметров Цикл
			Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ЗначенияОбщихПараметров.Добавить(), СтрокаПараметра);
		КонецЦикла;
	КонецЕсли;
	
	ОбработкаИзмененияФлагаИспользуется();
	
	Элементы.ВариантОтбора.СписокВыбора.Очистить();
	Элементы.ВариантОтбора.СписокВыбора.Добавить("Только конструктор", 	"Только конструктор");
	Элементы.ВариантОтбора.СписокВыбора.Добавить("Только запрос", 		"Только запрос");
	Элементы.ВариантОтбора.СписокВыбора.Добавить("Конструктор и запрос", 	"Конструктор и запрос");	
	
	
	УстановитьВидимостьДоступностьЭлементов();
	
	ОбновитьСписокПроизвольныхОтборовДокументов();
	
	УстановитьНаименованиеПроизвольногоОтбора();
	
	УстановитьПодсказкуВариантОтбора();
	
	ID_ПроизвольногоОтбораИзНастройки 	= ID_ПроизвольногоОтбора;	
	ВариантОтбораИзНастройки 			= ВариантОтбора;  
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикаИзВременногоХранилища(АдресСхемыСКД)
	
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));		
	//СхемаСКД = ПолучитьИзВременногоХранилища(АдресСхемыСКД);
	//Компоновщик.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияФлагаИспользуется()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.Используется.ЦветТекста = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#Иначе
		Элементы.Используется.ЦветТекстаЗаголовка = ?(Используется, WebЦвета.Зеленый, WebЦвета.Красный);
	#КонецЕсли
	
	Элементы.Используется.Заголовок = ?(Используется, 
		НСтр("ru = 'Включено';
				|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'"), 
		НСтр("ru = 'Отключено';
				|en = 'Disabled'; be = 'Адключаны'; es = 'Desconectado'; ka = 'გამორთულია'; kk = 'Ажыратылған'; ro = 'Dezactivat'; tr = 'Devre dışı bırakıldı'; uk = 'Відключений'; uz = 'O''chirilgan'")
	);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементов()

	Элементы.НаименованиеПроизвольногоОтбора.Доступность		= (Найти(ВРег(СокрЛП(ВариантОтбора)), ВРег(СокрЛП("Запрос"))) > 0);		
	
	Элементы.КомпоновщикНастройкиПараметрыДанных.Доступность 	= (Найти(ВРег(СокрЛП(ВариантОтбора)), ВРег(СокрЛП("Конструктор"))) > 0);
	Элементы.КомпоновщикНастройкиОтбор.Доступность 			= (Найти(ВРег(СокрЛП(ВариантОтбора)), ВРег(СокрЛП("Конструктор"))) > 0);
	Элементы.ЗначенияОбщихПараметров.Доступность 				= (Найти(ВРег(СокрЛП(ВариантОтбора)), ВРег(СокрЛП("Конструктор"))) > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПроизвольныхОтборовДокументов()
	
	СписокПроизвольныхОтборовДокументов.Очистить();
	
	ТаблицаПроизвольныхОтборовДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеОтборыДокументов");
	Если ТаблицаПроизвольныхОтборовДокументов <> Ложь И ТипЗнч(ТаблицаПроизвольныхОтборовДокументов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхОтборовДокументов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СписокПроизвольныхОтборовДокументов.Добавить(СтрокаТЗ.ID_ПроизвольногоОтбора, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаименованиеПроизвольногоОтбора()

	НайденныйЭлементСписка = СписокПроизвольныхОтборовДокументов.НайтиПоЗначению(ID_ПроизвольногоОтбора);
	Если НайденныйЭлементСписка <> Неопределено Тогда
		НаименованиеПроизвольногоОтбора = НайденныйЭлементСписка.Представление;
	Иначе	
		НаименованиеПроизвольногоОтбора = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказкуВариантОтбора()

	ТекстПодсказки = "";
	
	Если ВариантОтбора = "Только конструктор" Тогда	
		ТекстПодсказки = НСтр("ru = 'В отбор попадут документы, удовлетворяющие заданным параметрам компоновщика (см. Обязательные параметры и Параметры отбора).';
								|en = 'Documents that meet the specified linker parameters will be selected (see Required Parameters and Selection Parameters).';
								|be = 'У адбор трапяць дакументы, якія задавальняюць зададзеным параметрах кампаноўніка (гл.абавязковыя параметры і Параметры адбору).'; es = 'La selección incluirá documentos que cumplan con los parámetros especificados del enlazador (consulte parámetros Obligatorios y parámetros de selección).'; ka = 'შეირჩევა დოკუმენტები, რომლებიც აკმაყოფილებენ ლინკერის მითითებულ პარამეტრებს (იხილეთ საჭირო პარამეტრები და შერჩევის პარამეტრები).'; kk = 'Сілтеменің берілген параметрлерін қанағаттандыратын құжаттар таңдалады (міндетті параметрлер мен таңдау параметрлерін қараңыз).'; ro = 'Documentele care îndeplinesc parametrii de linker specificați vor fi selectate (consultați parametrii necesari și parametrii de selecție).'; tr = 'Bağlayıcının belirtilen parametrelerini karşılayan belgeler seçime girecektir (bkz. Zorunlu parametreler ve Seçim Parametreleri).'; uk = 'У відбір потраплять документи, що задовольняють заданим параметрам компонувальника (див.Обов''язкові параметри і параметри відбору).'; uz = 'Tanlovga bog''lovchining belgilangan parametrlarini qondiradigan hujjatlar kiradi (majburiy parametrlar va tanlov parametrlariga qarang).'");
	ИначеЕсли ВариантОтбора = "Только запрос" Тогда		
		ТекстПодсказки = НСтр("ru = 'В отбор попадут документы, являющиеся результатом выполнения запроса (см. Свой запрос).';
								|en = 'The documents resulting from the execution of the request will be selected (see your request).';
								|be = 'У адбор трапяць дакументы, якія з''яўляюцца вынікам выканання запыту (гл.'; es = 'Se seleccionarán los documentos que resulten de la ejecución de la consulta (consulte su consulta).'; ka = 'შეირჩევა მოთხოვნის შესრულების შედეგად მიღებული დოკუმენტები (იხილეთ თქვენი მოთხოვნა).'; kk = 'Сұрауды орындау нәтижесі болып табылатын құжаттар іріктеуге түседі (сұрауыңызды қараңыз).'; ro = 'Documentele rezultate din executarea cererii vor fi selectate (consultați solicitarea Dvs.).'; tr = 'İsteğin yürütülmesinin sonucu olan belgeler seçime girecektir (isteğinize bakın).'; uk = 'У відбір потраплять документи, які є результатом виконання запиту (Див.свій запит).'; uz = 'So''rov natijasi bo''lgan hujjatlar tanlovga kiradi (so''rovingizga qarang).'");
	ИначеЕсли ВариантОтбора = "Конструктор и запрос" Тогда		
		ТекстПодсказки = НСтр("ru = 'В отбор попадут документы, удовлетворяющие по крайней мере одному из вариантов отбора: ""Только конструктор"" или ""Только запрос"".';
								|en = 'The selection process will include documents that satisfy at least one of the selection options: ""Designer only"" or ""Request only"".';
								|be = 'У адбор трапяць дакументы, якія задавальняюць па меншай меры аднаму з варыянтаў адбору: ""толькі канструктар"" або ""толькі запыт"".'; es = 'La selección incluirá documentos que satisfagan al menos una de las opciones de selección: ""solo diseñador"" o ""solo solicitud"".'; ka = 'შერჩევის პროცესი მოიცავს დოკუმენტებს, რომლებიც აკმაყოფილებენ შერჩევის მინიმუმ ერთ ვარიანტს: ""მხოლოდ დიზაინერი"" ან ""მხოლოდ მოთხოვნა"".'; kk = 'Іріктеуге іріктеу нұсқаларының кем дегенде біреуін қанағаттандыратын құжаттар кіреді: ""тек конструктор"" немесе ""тек сұрау"".'; ro = 'Procesul de selecție va include documente care satisfac cel puțin una dintre opțiunile de selecție: ""numai Designer"" sau ""numai cerere"".'; tr = 'Seçim seçeneklerinden en az birini karşılayan belgeler seçime girecektir: ""Yalnızca Tasarımcı"" veya ""Yalnızca talep"".'; uk = 'У відбір потраплять документи, що задовольняють принаймні одному з варіантів відбору: ""тільки конструктор"" або ""тільки запит"".'; uz = 'Tanlovga tanlovning kamida bitta variantini qondiradigan hujjatlar kiradi:"" faqat konstruktor ""yoki""faqat so''rov"".'");
	КонецЕсли;
	
	Элементы.ДекорацияВариантОтбора.Заголовок = ТекстПодсказки;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуетсяПриИзменении(Элемент)
	ОбработкаИзмененияФлагаИспользуется();
КонецПроцедуры


&НаКлиенте
Процедура ВариантОтбораПриИзменении(Элемент)
	УстановитьВидимостьДоступностьЭлементов();
	УстановитьПодсказкуВариантОтбора();
КонецПроцедуры


&НаКлиенте
Процедура НаименованиеПроизвольногоОтбораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ПроизвольныеОтборыДокументов = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеОтборыДокументов", ЭтаФорма);
	#Иначе
		ФормаСписка_ПроизвольныеОтборыДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеОтборыДокументов", , ЭтаФорма, ЭтаФорма);
		ФормаСписка_ПроизвольныеОтборыДокументов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаСписка_ПроизвольныеОтборыДокументов._ЛокКонтекст = _ЛокКонтекст;
	ФормаСписка_ПроизвольныеОтборыДокументов.ID_ПроизвольногоОтбора = ID_ПроизвольногоОтбора;
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеОтборыДокументовЗакрытие",ЭтаФорма);
	ФормаСписка_ПроизвольныеОтборыДокументов.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_ПроизвольныеОтборыДокументов.ОткрытьМодально();
	#Иначе
		ФормаСписка_ПроизвольныеОтборыДокументов.Открыть();	
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеОтборыДокументовЗакрытие(РезультатРедактирования,ПредыдущееЗначение) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ID_ПроизвольногоОтбора 						= РезультатРедактирования;				
	КонецЕсли;					
	
	ОбновитьСписокПроизвольныхОтборовДокументов();
	
	УстановитьНаименованиеПроизвольногоОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПроизвольногоОтбораОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройку(Команда)
	СтруктураВозврата = СохранитьНастройкуСервер();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,СтруктураВозврата);
		КонецЕсли;
	#КонецЕсли
	Закрыть(СтруктураВозврата);
КонецПроцедуры

&НаСервере
Функция СохранитьНастройкуСервер()
	СтруктураВозврата = Новый Структура;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Компоновщик.ПолучитьНастройки(), НазначениеТипаXML.Явное);
	НастройкаКомпоновщикаСтрокой = ЗаписьXML.Закрыть();
	
	СтруктураВозврата.Вставить("НастройкаКомпоновщикаСтрокой", 	НастройкаКомпоновщикаСтрокой);
	СтруктураВозврата.Вставить("Используется", 					Используется);
	СтруктураВозврата.Вставить("ВариантОтбора", 				ВариантОтбора);
	СтруктураВозврата.Вставить("ID_ПроизвольногоОтбора",		ID_ПроизвольногоОтбора);
	Возврат СтруктураВозврата;	
КонецФункции


&НаКлиенте
Процедура ВыполнитьЗапросНаСервере(ВыполнитьПоДаннымФормы = Ложь)
	
	ТаблицаДокументовКонструктора 			= Неопределено;
	ТаблицаДокументовПроизвольногоЗапроса 	= Неопределено;
	
	Если ВыполнитьПоДаннымФормы Тогда
		ВариантОтбораДляЗапроса = ВариантОтбора;
	Иначе	
		ВариантОтбораДляЗапроса = ВариантОтбораИзНастройки;
	КонецЕсли;	
	
	Если ВРег(СокрЛП(ВариантОтбораДляЗапроса)) = ВРег(СокрЛП("Только конструктор")) Тогда		
		
		ТаблицаДокументовКонструктора = ВыполнитьЗапросКонструктора(ВыполнитьПоДаннымФормы);		
		
	ИначеЕсли ВРег(СокрЛП(ВариантОтбораДляЗапроса)) = ВРег(СокрЛП("Только запрос")) Тогда	
		
		ТаблицаДокументовПроизвольногоЗапроса = ВыполнитьЗапросПроизвольногоОтбора(ВыполнитьПоДаннымФормы);		
		
	ИначеЕсли ВРег(СокрЛП(ВариантОтбораДляЗапроса)) = ВРег(СокрЛП("Конструктор и запрос")) Тогда		
		
		ТаблицаДокументовКонструктора 			= ВыполнитьЗапросКонструктора(ВыполнитьПоДаннымФормы);				
		ТаблицаДокументовПроизвольногоЗапроса 	= ВыполнитьЗапросПроизвольногоОтбора(ВыполнитьПоДаннымФормы);	
						
	Иначе
		Возврат;
	КонецЕсли;	
	
	РезультатЗапроса.Очистить();
	
	Если ТипЗнч(ТаблицаДокументовКонструктора) = Тип("Массив") Тогда
		Для каждого Строка Из ТаблицаДокументовКонструктора Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(РезультатЗапроса.Добавить(), Строка);					
		КонецЦикла; 
	КонецЕсли;	
	
	Если ТипЗнч(ТаблицаДокументовПроизвольногоЗапроса) = Тип("Массив") Тогда
		Для каждого Строка Из ТаблицаДокументовПроизвольногоЗапроса Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(РезультатЗапроса.Добавить(), Строка);					
		КонецЦикла; 
	КонецЕсли;		
	
	КоличествоДокументов = РезультатЗапроса.Количество();
		
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьЗапросПоДаннымФормы(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭтаФорма.Панель.Страницы.ГруппаНастройкиОтбора.Видимость = Ложь;
		ЭтаФорма.Панель.Страницы.ГруппаРезультатаЗапроса.Видимость = Истина;
	#Иначе
		Элементы.ГруппаГлавная.Видимость = Ложь;
		Элементы.ФормаСохранитьНастройку.Видимость = Ложь;
		Элементы.ВыполнитьЗапрос.Видимость = Ложь;
		
		Элементы.ФормаВернутьсяКНастройкам.Видимость = Истина;
		Элементы.ГруппаРезультат.Видимость = Истина;
	#КонецЕсли
	ВыполнитьЗапросНаСервере(Истина);
КонецПроцедуры


&НаКлиенте
Процедура ВернутьсяКНастройкам(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭтаФорма.Панель.Страницы.ГруппаНастройкиОтбора.Видимость = Истина;
		ЭтаФорма.Панель.Страницы.ГруппаРезультатаЗапроса.Видимость = Ложь;
	#Иначе
		Элементы.ГруппаГлавная.Видимость = Истина;
		Элементы.ФормаСохранитьНастройку.Видимость = Истина;
		Элементы.ВыполнитьЗапрос.Видимость = Истина;
		
		Элементы.ФормаВернутьсяКНастройкам.Видимость = Ложь;
		Элементы.ГруппаРезультат.Видимость = Ложь;
