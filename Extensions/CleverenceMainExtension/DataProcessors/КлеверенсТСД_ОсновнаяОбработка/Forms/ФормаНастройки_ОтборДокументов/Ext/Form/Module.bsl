КонецПроцедуры

&НаКлиенте
Функция ВыполнитьЗапросКонструктора(ВыполнитьПоДаннымФормы = Ложь)

	Если ВыполнитьПоДаннымФормы Тогда	
		НастройкиКомпоновщикаСтр = ПолучитьНастройкиКомпоновщикаСтрокой(Компоновщик);						
	Иначе					
		Если НастройкаКомпоновщикаСтрокой <> "" Тогда
			НастройкиКомпоновщикаСтр = НастройкаКомпоновщикаСтрокой;
		Иначе
			Сообщение = НСтр("ru = 'Для данного отбора нет сохраненных настроек.';
								|en = 'There are no saved settings for this selection.'; be = 'Для дадзенага адбору няма захаваных налад.'; es = 'No hay configuraciones guardadas para esta selección.'; ka = 'ამ არჩევანისთვის არ არის შენახული პარამეტრები.'; kk = 'Бұл таңдау үшін сақталған параметрлер жоқ.'; ro = 'Nu există setări salvate pentru această selecție.'; tr = 'Bu seçim için kaydedilmiş ayar yoktur.'; uk = 'Для даного відбору немає збережених налаштувань.'; uz = 'Ushbu tanlov uchun saqlangan Sozlamalar mavjud emas.'");
			Сообщить(Сообщение); 
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ВыключитьПараметрыВремениИсполненияВНастройке(НастройкиКомпоновщикаСтр);
	
	ЗаполнитьПараметрыЗапроса(НастройкиКомпоновщикаСтр);
	Возврат _ЛокКонтекст.ЛокЯдро_ПолучитьДокументыПоЗапросуСКД(НастройкиКомпоновщикаСтр, ТипДокумента1С, НаименованиеБП);	

КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыЗапроса(НастройкиКомпоновщикаСтр)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(НастройкиКомпоновщикаСтр);		
	Попытка
		НастройкиКомпоновщика = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		НастройкиКомпоновщика = ЗначениеИзСтрокиВнутр(НастройкиКомпоновщикаСтр);
	КонецПопытки;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		пПараметрыЗапроса = ПараметрыЗапроса;
	#Иначе
		пПараметрыЗапроса = РеквизитФормыВЗначение("ПараметрыЗапроса");
	#КонецЕсли
	
	пПараметрыЗапроса.Очистить();
	Для Каждого Параметр ИЗ НастройкиКомпоновщика.ПараметрыДанных.Элементы Цикл
		Если Параметр.Использование Тогда
			НС = пПараметрыЗапроса.Добавить();
			НС.Имя = Параметр.Параметр;
			НС.Значение = Параметр.Значение;
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ПараметрыЗапроса = пПараметрыЗапроса;
	#Иначе
		ЗначениеВРеквизитФормы(пПараметрыЗапроса,"ПараметрыЗапроса");
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиКомпоновщикаСтрокой(Компоновщик)
	
	НастройкиКомпоновки = Компоновщик.ПолучитьНастройки();
	
	МассивИсключаемых = Новый Массив;
	МассивИсключаемых.Добавить(Новый ПолеКомпоновкиДанных("ПараметрыДанных.ИдПользователяТСД"));
	МассивИсключаемых.Добавить(Новый ПолеКомпоновкиДанных("ПараметрыДанных.ПользовательТСД"));
	МассивИсключаемых.Добавить(Новый ПолеКомпоновкиДанных("DataParameters.ИдПользователяТСД"));
	МассивИсключаемых.Добавить(Новый ПолеКомпоновкиДанных("DataParameters.ПользовательТСД"));
	
	Для каждого ЭлементОтбора Из НастройкиКомпоновки.Отбор.Элементы Цикл
		Если МассивИсключаемых.Найти(ЭлементОтбора.ЛевоеЗначение) <> Неопределено
			ИЛИ МассивИсключаемых.Найти(ЭлементОтбора.ПравоеЗначение) <> Неопределено Тогда
			ЭлементОтбора.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки, НазначениеТипаXML.Явное);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросПроизвольногоОтбора(ВыполнитьПоДаннымФормы = Ложь)

	Если ВыполнитьПоДаннымФормы Тогда				
		ID_ПроизвольногоОтбораДляЗапроса = ID_ПроизвольногоОтбора;
	Иначе		
		ID_ПроизвольногоОтбораДляЗапроса = ID_ПроизвольногоОтбораИзНастройки;
	КонецЕсли;
	
	НастройкиКомпоновщикаСтр = Неопределено;
	Если ВыполнитьПоДаннымФормы Тогда	
		НастройкиКомпоновщикаСтр = ПолучитьНастройкиКомпоновщикаСтрокой(Компоновщик);						
	Иначе					
		Если НастройкаКомпоновщикаСтрокой <> "" Тогда
			НастройкиКомпоновщикаСтр = НастройкаКомпоновщикаСтрокой;
		КонецЕсли;
	КонецЕсли;
	
	ВыключитьПараметрыВремениИсполненияВНастройке(НастройкиКомпоновщикаСтр);
	
	Возврат _ЛокКонтекст.ЛокЯдро_ПолучитьДокументыПоПроизвольномуОтбору(ID_ПроизвольногоОтбораДляЗапроса, НастройкиКомпоновщикаСтр, ID_Узла);

КонецФункции

&НаСервереБезКонтекста
Процедура ВыключитьПараметрыВремениИсполненияВНастройке(НастройкиКомпоновщикаСтр)
	
	// десериализуем
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(НастройкиКомпоновщикаСтр);		
	Попытка
		НастройкиКомпоновщика = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		НастройкиКомпоновщика = ЗначениеИзСтрокиВнутр(НастройкиКомпоновщикаСтр);
	КонецПопытки;
	
	// выключаем параметр
	Для Каждого ЗначениеПараметра ИЗ НастройкиКомпоновщика.ПараметрыДанных.Элементы Цикл
		Если ЗначениеПараметра.Параметр = Новый ПараметрКомпоновкиДанных("ПользовательТСД") 
			или ЗначениеПараметра.Параметр = Новый ПараметрКомпоновкиДанных("ИдПользователяТСД") Тогда
			ЗначениеПараметра.Использование = Ложь;		
		КонецЕсли;
	КонецЦикла;
	
	// выключаем отбор
	ВыключитьОтборПоПараметруВремениИсполнения(НастройкиКомпоновщика.Отбор);
	
	// сериализуем
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновщика, НазначениеТипаXML.Явное);
	
	НастройкиКомпоновщикаСтр = ЗаписьXML.Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыключитьОтборПоПараметруВремениИсполнения(Отбор)
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если ЭлементОтбора.Использование Тогда
			Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				ВыключитьОтборПоПараметруВремениИсполнения(ЭлементОтбора);
			Иначе
				ПолеПользовательСКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ПользовательТСД");
				ПолеИдПользователяСКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ИдПользователяТСД");
				Если ЭлементОтбора.ЛевоеЗначение = ПолеПользовательСКД или ЭлементОтбора.ПравоеЗначение = ПолеПользовательСКД
					или ЭлементОтбора.ЛевоеЗначение = ПолеИдПользователяСКД или ЭлементОтбора.ПравоеЗначение = ПолеИдПользователяСКД Тогда
					ЭлементОтбора.Использование = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапросПоНастройкам(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЭтаФорма.Панель.Страницы.ГруппаНастройкиОтбора.Видимость = Ложь;
		ЭтаФорма.Панель.Страницы.ГруппаРезультатаЗапроса.Видимость = Истина;
	#Иначе
		Элементы.ГруппаГлавная.Видимость = Ложь;
		Элементы.ФормаСохранитьНастройку.Видимость = Ложь;
		Элементы.ВыполнитьЗапрос.Видимость = Ложь;
		
		Элементы.ФормаВернутьсяКНастройкам.Видимость = Истина;
		Элементы.ГруппаРезультат.Видимость = Истина;
	#КонецЕсли
	ВыполнитьЗапросНаСервере(Ложь);
КонецПроцедуры

