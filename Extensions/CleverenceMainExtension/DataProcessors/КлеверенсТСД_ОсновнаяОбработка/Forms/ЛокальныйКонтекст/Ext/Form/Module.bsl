		пСообщение = НСтр("ru = 'Выбрана строка подключения: %1';
							|en = 'Connection string selected: %1'; be = 'Абраная радок падлучэння: %1'; es = 'Cadena de conexión seleccionada: %1'; ka = 'კავშირი სიმებიანი შერჩეული: %1'; kk = 'Байланыс жолы таңдалды: %1'; ro = 'Șirul de conexiune selectat: %1'; tr = 'Bağlantı dizesi seçildi: %1'; uk = 'Вибрано рядок підключення: %1'; uz = 'Tanlangan ulanish liniyasi: %1'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СокрЛП(СтруктураПодключения.СтрокаПодключенияСМАРТС));
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		
		ЛокЯдро_НастройкаПодключения_ПослеВыбораСтроки(Истина, ПараметрыВыполнения);
		
	Иначе
		// Продолжаем обход строк подключения
		ПараметрыВыбораСтроки.ИндексСтрокиПодключения = ПараметрыВыбораСтроки.ИндексСтрокиПодключения + 1;
		ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключенияСПроверкой(ПараметрыВыбораСтроки, ПараметрыВыполнения);
	КонецЕсли;

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ПослеВыбораСтроки(ПодключениеДоступно, ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ПослеВыбораСтроки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПодключениеДоступно,ПараметрыВыполнения",
		ПодключениеДоступно, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыБазыMS = Неопределено;
	Если ПодключениеДоступно Тогда
		ПараметрыБазыMS = ЛокЯдро_ПолучитьОписаниеБазыSMARTS(ПараметрыВыполнения.СтруктураПодключения.РасположениеКомпоненты, "Временная", "REST_API");
	КонецЕсли;
	
	ПараметрыВыполнения.Вставить("ПодключениеДоступно",  ПодключениеДоступно);
	ПараметрыВыполнения.Вставить("ПараметрыБазыMS",  ПараметрыБазыMS);
	
	Если ПараметрыВыполнения.РежимВыполнения = "ПроверкаСоединения" Тогда
		
		ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);
		
	ИначеЕсли ПараметрыВыполнения.РежимВыполнения = "НастройкаПодключения" Тогда
		
		Если НЕ ПодключениеДоступно
			ИЛИ ПараметрыБазыMS = Неопределено Тогда
			
			ПараметрыВыполнения.Вставить("ПодключениеДоступно", Ложь);
			ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);	
			Сообщение = НСтр("ru = 'С выбранной базой отсутствует соединение.';
								|en = 'There is no connection to the selected database.'; be = 'З абранай базай адсутнічае злучэнне.'; es = 'No hay conexión con la base seleccionada.'; ka = 'არ არსებობს კავშირი შერჩეულ მონაცემთა ბაზასთან.'; kk = 'Таңдалған негізде байланыс жоқ.'; ro = 'Nu există nicio conexiune la baza de date selectată.'; tr = 'Seçilen tabana bağlantı yok.'; uk = 'З обраної базою відсутнє з''єднання.'; uz = 'Tanlangan bazaga ulanish yo''q.'");
			Сообщить(Сообщение);
			
		Иначе	
			ЛокЯдро_НастройкаПодключения_СохранитьНастройкиПодключения(ПараметрыВыполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_СохранитьНастройкиПодключения(ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_СохранитьНастройкиПодключения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыБазыMS 			= ПараметрыВыполнения.ПараметрыБазыMS;
	ТипБазы 					= ПараметрыВыполнения.ТипБазы;
	ДополнительныеПараметры 	= ПараметрыВыполнения.ДополнительныеПараметры;
	
	СтруктураПодключения 		= ПараметрыВыполнения.СтруктураПодключения;
	РасположениеКомпоненты		= СтруктураПодключения.РасположениеКомпоненты;
	ТипИнтерфейса				= СтруктураПодключения.ТипИнтерфейса;
	РежимВыбораБазы				= СтруктураПодключения.РежимВыбораБазы;
	
	// Запоминаем, что выполнена авторизация по темпуид
	Если ПараметрыБазыMS.АвторизацияВключена = Истина Тогда
		Если ЛокЯдро_СтрНайти(ПараметрыБазыMS["СтрокаПодключения"], "tempuid") Тогда
			ПараметрыБазыMS.Вставить("АвторизацияТип", "tempuid")
		Иначе
			ПараметрыБазыMS.Вставить("АвторизацияТип", "login")
		КонецЕсли;
	КонецЕсли;
	
	// Очищаем из сохраняемой строки подключения дополнительные параметры, введенные в поле ввода
	РедактируемыеПоля = Новый Массив;
	РедактируемыеПоля.Добавить("СтрокаПодключения");
	РедактируемыеПоля.Добавить("СтрокаПодключенияСМАРТС");
	Для каждого РедактируемоеПоле ИЗ РедактируемыеПоля Цикл
		ПозицияСтрокиПоиска = ЛокЯдро_СтрНайти(ПараметрыБазыMS[РедактируемоеПоле], "?");
		Если ПозицияСтрокиПоиска Тогда
			ПараметрыБазыMS[РедактируемоеПоле] = Лев(ПараметрыБазыMS[РедактируемоеПоле], ПозицияСтрокиПоиска - 1);
		КонецЕсли;
	КонецЦикла;
	
	// Подключение
	
	пСообщение = НСтр("ru = 'Выполнено подключение по строке: %1';
						|en = 'Connection was made using the line: %1'; be = 'Выканана падключэнне па радку: %1'; es = 'Conectado por línea: %1'; ka = 'კავშირი გაკეთდა ხაზის გამოყენებით: %1'; kk = '%1 жолы бойынша қосылу орындалды'; ro = 'Conexiunea a fost făcută folosind linia: %1'; tr = 'Satıra göre bağlantı tamamlandı: %1'; uk = 'Виконано підключення по рядку: %1'; uz = 'Chiziq ulanishi amalga oshirildi: %1'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СокрЛП(ПараметрыБазыMS.СтрокаПодключенияСМАРТС));
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
	
	Если ТипБазы = "Основная" Тогда
		
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"НачалоВыполненияПроцедурыЗапускаОбработки", 
			, 
			"ЗапускОсновнойОбработки");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		// Запрещаем фоновые на время подключения
		Если ДоступноВыполнениеВФоне Тогда
			ДоступноВыполнениеВФоне = Ложь;
			КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", Ложь);
			ПараметрыВыполнения.Вставить("ПроверитьДоступностьВыполненияВФоне", Истина);
		КонецЕсли;
		
		ЛокЯдро_ОчиститьКэшируемыеНастройки(ПараметрыБазыMS.IdBaseSMARTS);
		
		ДопПараметрыСохраненияПодключения = Неопределено;
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("ЗаменитьИдБазы")
			И ЗначениеЗаполнено(ДополнительныеПараметры.ЗаменитьИдБазы) Тогда
			ДопПараметрыСохраненияПодключения = Новый Структура("ЗаменитьИдБазы", ДополнительныеПараметры.ЗаменитьИдБазы);
		КонецЕсли;
		
		ПараметрыПодключенияMS = ПараметрыБазыMS;
		ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыБазыMS, ДопПараметрыСохраненияПодключения);
		
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РасположениеКомпоненты",	РасположениеКомпоненты);
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_РежимВыбораБазы",			РежимВыбораБазы);
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ТипИнтерфейса",				ТипИнтерфейса);
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ID_ТекущейБазы",			ПараметрыБазыMS.IdBaseSMARTS);
		
		КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты",				РасположениеКомпоненты);
		КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса",						ТипИнтерфейса);
		КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS",				ПараметрыБазыMS);
		КомЯдро_СохранитьЗначениеПеременной("ID_ТекущейБазы",			  			ПараметрыБазыMS.IdBaseSMARTS);
		
		ОП = Новый ОписаниеОповещения("ЛокЯдро_НастройкаПодключения_ИнициализацияПослеПодключения", ЭтаФорма, ПараметрыВыполнения);
		ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ПараметрыБазыMS, Истина, "Основная", РасположениеКомпоненты, Истина, Истина, ОП);
		
	ИначеЕсли ТипБазы = "Частная" Тогда
		
		ПараметрыЧастнойБазы = Новый Структура;
		ПараметрыЧастнойБазы.Вставить("ЧастнаяБазаMS", 				ПараметрыБазыMS);
		ПараметрыЧастнойБазы.Вставить("РасположениеКомпонентыЧБ", 	РасположениеКомпоненты);
		ПараметрыЧастнойБазы.Вставить("РежимВыбораБазыЧБ", 			РежимВыбораБазы);
		ПараметрыЧастнойБазы.Вставить("НаименованиеЧБ", 			ПараметрыБазыMS.Имя);
		ПараметрыЧастнойБазы.Вставить("ТипИнтерфейсаЧБ", 			ТипИнтерфейса);
		
		ПараметрыВыполнения.Вставить("ПараметрыЧастнойБазы", ПараметрыЧастнойБазы);
		ПараметрыВыполнения.Вставить("ПодключениеДоступно",  Истина);
		
		ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ИнициализацияПослеПодключения(ПодключениеДоступно, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ИнициализацияПослеПодключения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПодключениеДоступно,ПараметрыВыполнения",
		ПодключениеДоступно, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если НЕ ПодключениеДоступно Тогда
		Сообщение = НСтр("ru = 'С выбранной базой отсутствует соединение.';
							|en = 'There is no connection to the selected database.'; be = 'З абранай базай адсутнічае злучэнне.'; es = 'No hay conexión con la base seleccionada.'; ka = 'არ არსებობს კავშირი შერჩეულ მონაცემთა ბაზასთან.'; kk = 'Таңдалған негізде байланыс жоқ.'; ro = 'Nu există nicio conexiune la baza de date selectată.'; tr = 'Seçilen tabana bağlantı yok.'; uk = 'З обраної базою відсутнє з''єднання.'; uz = 'Tanlangan bazaga ulanish yo''q.'");
		Сообщить(Сообщение); 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		ПараметрыВыполнения.Вставить("ПодключениеДоступно",  Ложь);
		ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
		
	ПараметрыБазыMS 		= ПараметрыВыполнения.ПараметрыБазыMS;
	СтруктураПодключения 	= ПараметрыВыполнения.СтруктураПодключения;
	РасположениеКомпоненты 	= СтруктураПодключения.РасположениеКомпоненты;
	
	// Если в параметрах подключения заполнено ИмяИнтеграционнойОбработки,
	//  значит подключаемся к уже инициализированной базе SMARTS и должны проверить,
	//  не изменились ли типовые значения после инициализации CustomSettings.dflt.
	
	ТекущееИмяИнтеграционнойОбработки = Неопределено;
	ПараметрыБазыMS.Свойство("ИмяИнтеграционнойОбработки", ТекущееИмяИнтеграционнойОбработки);
	
	ПодключениеКИнициализированнойБазе = ЗначениеЗаполнено(ТекущееИмяИнтеграционнойОбработки);
	
	СтароеИмяИнтеграционнойОбработки_ПоУмолчанию = Неопределено;
	
	Если ПодключениеКИнициализированнойБазе Тогда
		СтароеИмяИнтеграционнойОбработки_ПоУмолчанию = ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
	КонецЕсли;
	
	// Инициализация нового типового файла CustomSettings.dflt
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Start'; be = 'Пачатак'; es = 'Inicio'; ka = 'დაწყება'; kk = 'Бастау'; ro = 'Începeți'; tr = 'Başlangıç'; uk = 'Початок'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию", "Информация", пСообщение);
	ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(ПараметрыБазыMS);
	пСообщение = НСтр("ru = 'Конец';
						|en = 'End'; be = 'Канец'; es = 'Extremo'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșit'; tr = 'Son'; uk = 'Кінець'; uz = 'Tugatish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию", "Информация", пСообщение, НачалоСобытия);
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	
	// CustomSettings.dflt мог быть заменен при инициализации, поэтому получаем параметры подключени ИО по умолчанию повторно.
	
	СтруктураНастроек = Новый Структура("ИмяИнтеграционнойОбработкиКонфигурации1С, ПутьИнтеграционнойОбработкиКонфигурации1С");
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек);
	
	НовоеИмяИнтеграционнойОбработки_ПоУмолчанию 	= СтруктураНастроек.ИмяИнтеграционнойОбработкиКонфигурации1С;
	НовыйПутьИнтеграционнойОбработки_ПоУмолчанию 	= СтруктураНастроек.ПутьИнтеграционнойОбработкиКонфигурации1С;
	
	// +++ Пересохранение настроек ИО
	Если ПодключениеКИнициализированнойБазе Тогда
		
		// База инициализирована:
		// - Возможно пользователь сначала подключился из УТ 11.4, а теперь из УНФ 3.0.
		//		Нам нужно переписать настройки ИО, что бы ОО могла запуститься без ошибок.
		// - Если конфигурация не была изменена, то настройки ИО будут восстановлены из пользовательских.
		
		Если НЕ ЗначениеЗаполнено(СтароеИмяИнтеграционнойОбработки_ПоУмолчанию)
			ИЛИ СтароеИмяИнтеграционнойОбработки_ПоУмолчанию <> НовоеИмяИнтеграционнойОбработки_ПоУмолчанию Тогда
			
			// Пересохраним новые настройки ИО несмотря на то, что мы потеряем пользовательские настройки ИО.
			ТипОбработки 					= "ФайлНаДиске";
			ИмяИнтеграционнойОбработки 		= НовоеИмяИнтеграционнойОбработки_ПоУмолчанию;
			ПутьИнтеграционнойОбработки 	= НовыйПутьИнтеграционнойОбработки_ПоУмолчанию;
			
		Иначе
			
			// Восстанавливаем сохраненные настройки.
			ТипОбработки 					= ПараметрыБазыMS.ТипОбработки;
			ИмяИнтеграционнойОбработки 		= ПараметрыБазыMS.ИмяИнтеграционнойОбработки;
			ПутьИнтеграционнойОбработки 	= ПараметрыБазыMS.ПутьИнтеграционнойОбработки;
			
		КонецЕсли;
		
	Иначе
		// Новая, чистая база SMARTS
		ТипОбработки 					= "ФайлНаДиске";
		ИмяИнтеграционнойОбработки 		= НовоеИмяИнтеграционнойОбработки_ПоУмолчанию;
		ПутьИнтеграционнойОбработки 	= НовыйПутьИнтеграционнойОбработки_ПоУмолчанию;
	КонецЕсли;
	
	ПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
	ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
	ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
	
	// Замена настроек в хранилище 1С
	ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
	КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
	
	Если ТипОбработки = "СправочникСсылка" Тогда
		ПутьИО = ЛокЯдро_ЗначениеВСтрокуXML(ПутьИнтеграционнойОбработки);
	Иначе
		ПутьИО = ПутьИнтеграционнойОбработки;
	КонецЕсли;
	
	// Замена настроек в базе Клеверенс
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки",							   ТипОбработки);
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ПутьИО);
	// ----
	
	
	// Подключаем ИО
	ПараметрыОбработки = Новый Структура;
	ТипОбработки = ?(НЕ ПараметрыПодключенияMS.Свойство("ТипОбработки") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыПодключенияMS.ТипОбработки), "ФайлНаДиске", ПараметрыПодключенияMS.ТипОбработки);
	ПараметрыОбработки.Вставить("ТипОбработки", 			   ТипОбработки);
	ПараметрыОбработки.Вставить("ИмяИнтеграционнойОбработки",  ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки);
	ПараметрыОбработки.Вставить("ПутьИнтеграционнойОбработки", ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки);
	ЛокЯдро_ПодключитьИнтеграционнуюОбработкуПриОткрытии(, ПараметрыОбработки);
	
	ПараметрыВыполнения.ПараметрыБазыMS = ПараметрыПодключенияMS;
	
	// Инициализация
	ОП = Новый ОписаниеОповещения("ЛокЯдро_НастройкаПодключения_ЗавершениеИнициализации", ЭтаФорма, ПараметрыВыполнения);
	Если РасположениеКомпоненты = "НаСервере"
		И ДоступноВыполнениеВФоне Тогда
		ЛокЯдро_Инициализация(ПараметрыПодключенияMS, ОП);
	Иначе
		ЛокЯдро_Инициализация(ПараметрыПодключенияMS);
		ВыполнитьОбработкуОповещения(ОП);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ЗавершениеИнициализации(Результат, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ЗавершениеИнициализации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыполнения",
		Результат, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Результат = "ОшибкаИнициализации" Тогда
		Сообщение = НСтр("ru = 'Ошибка инициализации базы Клеверенс.';
							|en = 'Error initializing the Cleverence database.'; be = 'Памылка ініцыялізацыі базы Cleverence.'; es = 'Error de inicialización de base Cleverence.'; ka = 'შეცდომა Cleverence მონაცემთა ბაზის ინიციალიზაცია.'; kk = 'Cleverence базасын инициализациялау қатесі.'; ro = 'Eroare la inițializarea bazei de date Cleverence.'; tr = 'Cleverence tabanı başlatma hatası.'; uk = 'Помилка ініціалізації бази Cleverence.'; uz = 'Cleverence ma''lumotlar bazasini ishga tushirishda xatolik yuz berdi.'");
		Сообщить(Сообщение); 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыБазыMS = ПараметрыВыполнения.ПараметрыБазыMS;
	ПараметрыПодключенияMS = ПараметрыБазыMS;
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПараметрыПодключенияMS", ПараметрыБазыMS);
	
	НастройкиКСохранению = Новый Структура;
	Если ПараметрыБазыMS.Свойство("База1ССтрокаСоединенияHTTP") Тогда
		НастройкиКСохранению.Вставить("ServiceHTTPAddress", ПараметрыБазыMS.База1ССтрокаСоединенияHTTP);
	КонецЕсли;
	Если ПараметрыБазыMS.Свойство("База1ССтрокаСоединенияWeb") Тогда
		НастройкиКСохранению.Вставить("AddressWebService", ПараметрыБазыMS.База1ССтрокаСоединенияWeb);
	КонецЕсли;
	Если ПараметрыБазыMS.Свойство("База1ССтрокаСоединенияКлиент") Тогда
		НастройкиКСохранению.Вставить("OneCBaseAddress", ПараметрыБазыMS.База1ССтрокаСоединенияКлиент);
	КонецЕсли;
	
	СвойстваКонфигурации = ЛокЯдро_ПолучитьСвойстваКонфигурации1С();
	НастройкиКСохранению.Вставить("ПодключеннаяБазаИмяКонфигурации1С",		СвойстваКонфигурации.Имя);
	НастройкиКСохранению.Вставить("ПодключеннаяБазаСинонимКонфигурации1С",	СвойстваКонфигурации.Синоним); 
	НастройкиКСохранению.Вставить("ПодключеннаяБазаВерсияПлатформы1С",		СвойстваКонфигурации.ВерсияПриложения);
	НастройкиКСохранению.Вставить("ПодключеннаяБазаВерсияКонфигурации1С",	СвойстваКонфигурации.Версия);
	НастройкиКСохранению.Вставить("Ид",										ПараметрыБазыMS.Ид);
	НастройкиКСохранению.Вставить("ИдПриложения",							ПараметрыБазыMS.ИдПриложения);
	НастройкиКСохранению.Вставить("УровеньПриложения",						ПараметрыБазыMS.УровеньПриложения);
	НастройкиКСохранению.Вставить("ИдОсновногоПриложения",					ПараметрыБазыMS.ИдОсновногоПриложения);
	
	ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению);
	
	ЛокЯдро_ОбновитьПараметрыПодключения1С(Истина, РасположениеКомпоненты);
	
	// Попытка на случай, если окно настроек подключения открыто не из главной формы
	Попытка			
		ВладелецФормы.ID_ТекущейБазы = ПараметрыБазыMS.Ид;
	Исключение
	КонецПопытки;
	
	// Обновление компонентов
	ЛокЯдро_НастройкаПодключения_ОбновитьКомпоненты(ПараметрыВыполнения);

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ОбновитьКомпоненты(ПараметрыВыполнения)
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_НастройкаПодключения_ВыгрузитьПервичныеДанные", ЭтаФорма, ПараметрыВыполнения);
	
	ПараметрыОбновленияКомпонентов = Новый Структура;
	ПараметрыОбновленияКомпонентов.Вставить("ОписаниеОповещения", ОП);
	Если ПараметрыВыполнения.СпособЗапуска = "ФормаНастройкиПодключения" Тогда
		ПараметрыОбновленияКомпонентов.Вставить("ПроверятьВерсииПриПервомЗапуске", Истина);
	КонецЕсли;
	
	ПараметрыОбновления = ЛокЯдро_ОбновлениеКомпонент_СтруктураПараметровВызова();
	ПараметрыОбновления.ОповещениеОбработкиЗавершения = ОП;
	
	ЛокЯдро_ОбновлениеКомпонент_ОбновитьПриПервомПодключении(ПараметрыОбновления);
		
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ВыгрузитьПервичныеДанные(Результат, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ВыгрузитьПервичныеДанные";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыполнения",
		Результат, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Выгрузка БП
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузитьБизнесПроцессы", "Информация", пСообщение, НачалоСобытия);
	ЛокЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS();
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузитьБизнесПроцессы", "Информация", пСообщение, НачалоСобытия);
	
	// Выгрузка ячеек
	Если ИнтеграционнаяОбработкаПодключена Тогда
		СписокИспользуемыхСправочников = ЛокЯдро_ПолучитьСписокИспользуемыхСправочников();
		Если СписокИспользуемыхСправочников <> Неопределено
			И СписокИспользуемыхСправочников.НайтиПоЗначению("Ячейки") <> Неопределено Тогда
				
			пСообщение = НСтр("ru = 'Начало';
								|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS", "Информация", пСообщение, НачалоСобытия);
			ПараметрыВыгрузки = ЛокЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника("Ячейки");
			ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS("Ячейки",,,ПараметрыВыгрузки);				
			пСообщение = НСтр("ru = 'Конец';
								|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS", "Информация", пСообщение, НачалоСобытия);
				
		КонецЕсли;
	КонецЕсли;
	
	// Завершение
	Оповестить("УстановленыНастройкиПодключения",,ЭтаФорма);	
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		"БезОшибок", 
		"", 
		"ПодключениеКБазеSMARTS");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	Если СтруктураМетаданных.isDemo Тогда 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"ДемоРежим", 
					"", 
					"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	КонецЕсли;
	
	ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_Завершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПараметрыВыполнения.Свойство("ПроверитьДоступностьВыполненияВФоне") Тогда
		// Восстанавливаем признак доступности фоновых после инициализации
		ДоступноВыполнениеВФоне = ЛокЯдро_ДоступноВыполнениеВФоне();
		КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", ДоступноВыполнениеВФоне);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеОбработкиЗавершения, ПараметрыВыполнения);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_ЧтениеНастроек

// Получает из компоненты SMARTS список всех подключенных баз
// 
// Параметры:
// 	РежимПоиска - Строка - указывается сторона, где установлена компонента для работы с базой Клеверенс
// 	Полное - Строка - флаг возврата для каждой базы из списка полного (Истина) либо краткого (Ложь) описания
// 	
// Возвращаемое значение:
// 	Неопределено, Массив из Структура - Если нет подключения к компоненте, то вернется Неопределено. 
//										Если подключение есть, то вернется массив со списком баз и описанием структуры массива.
&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокБазНаСервереSMARTS(РежимПоиска = "",Полное = Истина) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСписокБазНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимПоиска,Полное",
		РежимПоиска, Полное);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если РежимПоиска = "" Тогда
		РежимПоиска = РасположениеКомпоненты;
	КонецЕсли;
	
	Если РежимПоиска = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСписокБазНаСервереSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("Полное",Полное));
		СписокБаз = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	Иначе
		СписокБаз = КомЯдро_ПолучитьСписокБазНаСервереSMARTS(Полное);	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокБаз);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СписокБаз;
	
КонецФункции

// Получает значение настройки Клеверенс из кэша
// 
// Параметры:
// 	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
// 	ВернутьМассивСтруктур - Булево - определяет, будет возвращено значение табличной настройки в виде массива структур (Истина) или таблицы значений (Ложь)
// 	ВернутьАдресХранилища - Булево - если Истина, то результат будет помещен во временное хранилище
// 
// Возвращаемое значение:
// 	Неопределено, Массив из Структура, Булево, Строка - значение настройки в выбранном формате
&НаКлиенте 
Функция ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(КлючНастройки,ВернутьМассивСтруктур = Ложь, ВернутьАдресХранилища = Ложь, ЗначениеПоУмолчанию = Ложь) Экспорт
	
	ЗначениеНастройки = ЗначениеПоУмолчанию;
	
	Если ТипЗнч(ЭтаФорма.ТекущиеНастройкиMS) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденноеЗначение = Неопределено;
	Если ТекущиеНастройкиMS.Свойство(КлючНастройки, НайденноеЗначение) Тогда
		ЗначениеНастройки = НайденноеЗначение;
	КонецЕсли;
	
	Если ВернутьМассивСтруктур
		И НЕ (ТипЗнч(ЗначениеНастройки) = Тип("Массив") И ЗначениеНастройки.Количество() > 0 
		И ТипЗнч(ЗначениеНастройки[0]) = Тип("Структура") 
		И (НЕ ЗначениеНастройки[0].Свойство("ЭтоТаблицаЗначений") ИЛИ ЗначениеНастройки[0].ЭтоТаблицаЗначений = Истина)) Тогда
	   
		ЗначениеНастройки = ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ЗначениеНастройки);
	
	КонецЕсли; 
	
	Если ВернутьАдресХранилища Тогда
	
		ЗначениеНастройки = ПоместитьВоВременноеХранилище(ЗначениеНастройки,Новый УникальныйИдентификатор());
	
	КонецЕсли; 
	
	Возврат ЗначениеНастройки;
	
КонецФункции

// Получает из кэша значение табличной настройки Клеверенс или значение ее отдельной колонки с возможностью выполнения отбора
//
// Параметры:
//	КлючТаблицы	- Строка - имя табличной настройки Клеверенс, из которой необходимо получить данные
//  Отбор - Структура - в качестве ключей содержит имена колонок табличной настройки Клеверенс, в качестве
//						значений - значения соответствующих колонок, по которым необходимо выполнить отбор
//  ИмяКолонки - Строка - имя колонки табличной настройки Клеверенс, значение которой необходимо вернуть
//
// Возвращаемое значение:
//	- ТаблицаЗначений - если значение полученной настройки хранится в кэше в виде таблицы значений
//	- Массив из Структура - если значение полученной настройки хранится в кэше в виде массива структур
//	- Произвольный - если запрошено значение одной колонки
//  - Неопределено - если значение настройки получить не удалось
&НаКлиенте 
Функция ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS(КлючТаблицы, Отбор, ИмяКолонки = "") Экспорт

	Результат = Неопределено;
	
	ТаблицаНастроек = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(КлючТаблицы,Истина);
	РезультатОтбора = Новый Массив;
	СтруктураТЗ = Неопределено;
	Если ТипЗнч(ТаблицаНастроек) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из ТаблицаНастроек Цикл
			Если ЭлементМассива.Свойство("КолонкиТаблицыЗначений") Тогда
				СтруктураТЗ = ЭлементМассива;
				Продолжить;
			КонецЕсли;
			Подходит = Истина;
			Для Каждого ЭлементОтбора из Отбор Цикл
				Если ТипЗнч(ЭлементОтбора.Значение) = Тип("Массив") Тогда
					ПодходящийОтбор = ЭлементМассива.Свойство(ЭлементОтбора.Ключ) И ЭлементОтбора.Значение.Найти(ЭлементМассива[ЭлементОтбора.Ключ]) <> Неопределено;
				Иначе
					ПодходящийОтбор = ЭлементМассива.Свойство(ЭлементОтбора.Ключ) И ЭлементМассива[ЭлементОтбора.Ключ] = ЭлементОтбора.Значение;
				КонецЕсли;
				
				Если НЕ ПодходящийОтбор Тогда
					Подходит = Ложь;
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			Если Подходит Тогда
				РезультатОтбора.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
		Если РезультатОтбора.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(ИмяКолонки) Тогда
				Результат = ?(РезультатОтбора.Количество() = 1, РезультатОтбора[0][ИмяКолонки], "");
			Иначе
				Если СтруктураТЗ <> Неопределено Тогда
					РезультатОтбора.Вставить(0,СтруктураТЗ);
				КонецЕсли;
				Результат = РезультатОтбора;
			КонецЕсли;
		КонецЕсли
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Вызывает функцию получения настроек на сервере Клеверенс и конвертации сериализуемых настроек
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо получить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//
// Возвращаемое значение:
//	Структура - ключами являются имена настроек Клеверенс, переданные в параметре СтруктураНастроек, 
//				значениями - соответствующие значения полученных настроек
&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	пКатегорииНастроекMS = Неопределено;
	Если ДополнительныеПараметры <> Неопределено Тогда
		ДополнительныеПараметры.Свойство("КатегорииНастроекMS", пКатегорииНастроекMS);
	КонецЕсли;
	
	Если пКатегорииНастроекMS = Неопределено Тогда
		пКатегорииНастроекMS = КатегорииНастроекMS;
		Если пКатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
			Если КатегорииНастроекMS = Неопределено Тогда
				КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
			КонецЕсли;
			пКатегорииНастроекMS = КатегорииНастроекMS;
		КонецЕсли;
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("СтруктураНастроек", 	СтруктураНастроек);
		ПараметрыМетода.Вставить("КатегорииНастроекMS",	пКатегорииНастроекMS);
		ПараметрыМетода.Вставить("ID_Узла", 		  	ID_Узла);
		ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьНастройкиНаСервереSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		СтруктураНастроек = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		СтруктураНастроек = ЛокЯдро_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, пКатегорииНастроекMS, ID_Узла,, ДополнительныеПараметры);
	КонецЕсли;

	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции

// Вызывает функцию получения настройки из базы Клеверенс по ключу
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
//	ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//
// Возвращаемое значение:
//	Произвольный - значение настройки Клеверенс, переданной в параметре КлючНастройки
&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS(КлючНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, Ложь);
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
	
	Возврат СтруктураНастроек[КлючНастройки];
	
КонецФункции

// Получает значение табличной настройки из базы Клеверенс или значение ее отдельной колонки с возможностью выполнения отбора
//
// Параметры:
//	КлючТаблицы	- Строка - имя табличной настройки Клеверенс, из которой необходимо получить данные
//  Отбор - Структура - в качестве ключей содержит имена колонок табличной настройки Клеверенс, в качестве
//						значений - значения соответствующих колонок, по которым необходимо выполнить отбор
// 	ID_Узла - Строка - идентификатор узла получаемой настройки
//  ИмяКолонки - Строка - имя колонки табличной настройки Клеверенс, значение которой необходимо вернуть
//
// Возвращаемое значение:
//	- ТаблицаЗначений - если значение полученной настройки хранится в виде таблицы значений
//	- Массив из Структура - если значение полученной настройки хранится в виде массива структур
//	- Произвольный - если запрошено значение одной колонки
//  - Неопределено - если значение настройки получить не удалось
&НаКлиенте
Функция ЛокЯдро_ПолучитьЗначениеТабличнойНастройкиНаСервереSMARTS(КлючТаблицы, Отбор, ID_Узла = "", ИмяКолонки = "") Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьЗначениеТабличнойНастройкиНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"КлючТаблицы,Отбор,ID_Узла,ИмяКолонки",
		КлючТаблицы, Отбор, ID_Узла, ИмяКолонки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Результат = Неопределено;
	
	ТаблицаНастроек = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS(КлючТаблицы, ID_Узла);
	
	Если НЕ ТаблицаНастроек = Ложь И ТипЗнч(ТаблицаНастроек) = Тип("Массив") Тогда
		РезультатОтбора = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ТаблицаНастроек,Отбор);
		Если РезультатОтбора <> Неопределено И РезультатОтбора.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(ИмяКолонки) Тогда
				Результат = ?(РезультатОтбора.Количество() = 1, РезультатОтбора[0][ИмяКолонки], "");
			Иначе
				Результат = РезультатОтбора;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Вызывает метод из модуля обработки для получения настройки из хранилища общих настроек
//
// Параметры:
//	КлючДляПолучения - Строка - имя настройки, которую необходимо получить	
//	ПолучитьПользовательскуюИОбщуюНастройку - определяет, нужно ли получить пользовательскую и общую настройку (Истина) или одну из них (Ложь)
//
// Возвращаемое значение:
//	- Структура - содержит:
//		* ПользовательскаяНастройка - Произвольный - значение пользовательской настройки
//      * ОбщаяНастройка - Произвольный - значение общей настройки
//	- Произвольный - значение пользовательской или - при отсутствии пользовательской - общей настройки
&НаКлиенте
Функция ЛокЯдро_ПолучитьДанныеИзХранилища1С(КлючДляПолучения, ПолучитьПользовательскуюИОбщуюНастройку = Ложь) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьДанныеИзХранилища1С");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
	СтруктураВызова.ПараметрыМетода.Вставить("КлючДляПолучения", КлючДляПолучения);
	СтруктураВызова.ПараметрыМетода.Вставить("ПолучитьПользовательскуюИОбщуюНастройку", ПолучитьПользовательскуюИОбщуюНастройку);
	
	Данные1С = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	Возврат Данные1С; 	
	
КонецФункции

// Получает ПараметрыПодключенияMS для переданного ИД базы или текущей базы
//
// Параметры:
//  ИдентификаторБазыMS - Строка - Необязательный. Ид базы для которой необходимо получить параметры. Если Неопределено, то получает для текущей из Cleverence_ID_ТекущейБазы
//  ДополнительныеПараметры - Произвольный
// 
&НаКлиенте
Функция ЛокЯдро_ПолучитьПараметрыПодключенияMS(ИдентификаторБазыMS = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьПараметрыПодключенияMS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
	СтруктураВызова.ПараметрыМетода.Вставить("ИдентификаторБазыMS", ИдентификаторБазыMS);
	СтруктураВызова.ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ПараметрыПодключенияMS = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат ПараметрыПодключенияMS; 	

КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПараметрыПодключенныхБазMS(ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьПараметрыПодключенныхБазMS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
	СтруктураВызова.ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ПодключенныеБазыMS = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	Возврат ПодключенныеБазыMS; 	
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_УдалитьБазуИзСпискаПодключенныхБазMS(ИдентификаторБазыMS, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "УдалитьБазуИзСпискаПодключенныхБазMS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ПараметрыПодключенияMS, ДополнительныеПараметры", ИдентификаторБазыMS, ДополнительныеПараметры));
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);	
	
КонецПроцедуры

// Вызывает метод из модуля обработки для получения значений глобальных параметров для текущего узла в сессии Клеверенс
//
// Параметры:
//	ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//	ПолучатьНеиспользуемые - Булево - определяет, нужно ли заменять неиспользуемые параметры узлов соответствующими параметрами главного узла
//		(не нужно заменять при открытии формы списка глобальных параметров и формы узла для корректного отображения, в остальных случаях - нужно)
//
// Возвращаемое значение:
//	Массив из Структура - содержит:	
//		* ID_Параметра - Строка
//		* Наименование - Строка
//		* Значение - Произвольный
//      * Комментарий - Строка
//      * Использование - Булево
//      * Тип - Строка
//      * ЗначениеПоУмолчанию - Произвольный
&НаКлиенте
Функция ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла = "", ПолучатьНеиспользуемые = Ложь) Экспорт
	
	ОбщиеПараметры = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры");
	
	Если ID_Узла = ""
		И ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура")
		И ДанныеТекущегоУзла.ID_Узла <> "" Тогда
		ID_Узла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	ЧастныеПараметры = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения", ID_Узла);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ОбщиеПараметры", 	 		ОбщиеПараметры);
	ПараметрыМетода.Вставить("ЧастныеПараметры", 		ЧастныеПараметры);
	ПараметрыМетода.Вставить("ID_Узла", 		 		ID_Узла);
	ПараметрыМетода.Вставить("ПолучатьНеиспользуемые", 	ПолучатьНеиспользуемые);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьЗначенияГлобальныхПараметров");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	ТаблицаПараметров = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат ТаблицаПараметров;
		
КонецФункции

&НаКлиенте
Функция ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(Массив,КлючПоиска,Значене) Экспорт
	Для Каждого ЭлементМассива Из Массив Цикл
		Если ЭлементМассива.Свойство(КлючПоиска) И ЭлементМассива[КлючПоиска] = Значене Тогда
			Возврат ЭлементМассива;	
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ЛокЯдро_НайтиПоЗначениюВСтруктуре(СтруктураПоиска, ЗначениеПоиска)
	
	Результат = Новый Массив;
	
	Для Каждого ЭлементСтруктуры Из СтруктураПоиска Цикл
		Если ЭлементСтруктуры.Значение = ЗначениеПоиска Тогда
			Результат.Добавить(ЭлементСтруктуры);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_УдалитьПоЗначениюИзМассиваСтруктур(Массив, КлючПоиска, Значение) Экспорт
	
	Индекс = Массив.ВГраница();
	Пока Индекс >= 0 Цикл
		ЭлементМассива = Массив.Получить(Индекс);
		Если ЭлементМассива.Свойство(КлючПоиска) И ЭлементМассива[КлючПоиска] = Значение Тогда
			Массив.Удалить(Индекс);	
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

// Удаляет значения текущих настроек в базе Клеверенс для возможности получения значений по умолчанию
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо получить	
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//
// Возвращаемое значение:
//	Структура - структура настроек с заполненными значениями по умолчанию
&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек, ID_Узла = "") Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла",
		СтруктураНастроек, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
		СтруктураВызова.ПараметрыМетода.Вставить("СтруктураНастроек", СтруктураНастроек);
		СтруктураВызова.ПараметрыМетода.Вставить("ID_Узла", 		  ID_Узла);
		СтруктураНастроек = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		ЛокЯдро_УдалитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_Узла);
		СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек);
		
		//Выполним обновление - Начало
		ВерсияОбработки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");
		ВерсияОбработкиКлеверенсТСД = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиКлеверенсТСД");
		
		Если ТипЗнч(ВерсияОбработки) = Тип("Строка") Тогда
			ВерсияОбработки = ЛокЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработки);
		ИначеЕсли ТипЗнч(ВерсияОбработки) <> Тип("Число") Тогда
			ВерсияОбработки = Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ВерсияОбработкиКлеверенсТСД) = Тип("Строка") Тогда
			ВерсияОбработкиКлеверенсТСД = ЛокЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработкиКлеверенсТСД);
		ИначеЕсли ТипЗнч(ВерсияОбработкиКлеверенсТСД) <> Тип("Число") Тогда
			ВерсияОбработкиКлеверенсТСД = Неопределено;
		КонецЕсли;
		
		// Метод может быть вызван до инициализации для получения простых настроек, реструктуризация которых не требуется
		ПроверятьВерсиюОбработки = ВерсияОбработки <> Неопределено
			И ВерсияОбработкиКлеверенсТСД <> Неопределено;
		
		Если ПроверятьВерсиюОбработки И ВерсияОбработки > ВерсияОбработкиКлеверенсТСД Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек, СтруктураНастроек", ВерсияОбработкиКлеверенсТСД, СтруктураНастроек));
			
			СтруктураНастроек = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		КонецЕсли;
		//Выполним обновление - Конец
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции	

// Удаляет текущее значение настройки Клеверенс для возможности получения значения по умолчанию
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, которую необходимо получить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
//
// Возвращаемое значение:
//	Произвольный - значение настройки Клеверенс, переданной в параметре КлючНастройки
&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS(КлючНастройки, ID_Узла = "") Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки);
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек, ID_Узла);	
	
	Возврат СтруктураНастроек[КлючНастройки];
	
КонецФункции	

&НаКлиенте
Функция ЛокЯдро_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, пКатегорииНастроекMS, ID_Узла = "", ТипБазы = "Основная", ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ЗаполнитьНастройкиSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,пКатегорииНастроекMS,ID_Узла,ТипБазы,ДополнительныеПараметры",
		СтруктураНастроек, пКатегорииНастроекMS, ID_Узла, ТипБазы, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пДополнительныеПараметры 	= ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеКэшировать 				= пДополнительныеПараметры.Свойство("НеКэшировать") И пДополнительныеПараметры.НеКэшировать;
	НеПроверятьАктуальность 	= пДополнительныеПараметры.Свойство("НеПроверятьАктуальность") И пДополнительныеПараметры.НеПроверятьАктуальность;
	НеИспользоватьАтрибуты		= пДополнительныеПараметры.Свойство("НеИспользоватьАтрибуты") И пДополнительныеПараметры.НеИспользоватьАтрибуты;
	
	СериализуемыеНастройки = Неопределено;
	пДополнительныеПараметры.Свойство("СериализуемыеНастройки", СериализуемыеНастройки);
	
	пСообщение = НСтр("ru = 'Начало, Получение настроек на сервере SMARTS';
						|en = 'Getting started, Getting settings on the Cleverence server'; be = 'Пачатак, атрыманне налад на сэрвэры Cleverence'; es = 'Inicio, Obtener la configuración en el servidor Cleverence'; ka = 'მიღება დაიწყო, მიღების პარამეტრების Cleverence სერვერზე'; kk = 'Бастау, Cleverence серверінде параметрлерді алу'; ro = 'Noțiuni de bază, obținerea setărilor pe serverul Cleverence'; tr = 'Başlangıç, Cleverence sunucusunda ayarları alma'; uk = 'Початок, отримання налаштувань на сервері Cleverence'; uz = 'Ishni boshlash, Cleverence serverida sozlamalarni olish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	Если пКатегорииНастроекMS = Неопределено Тогда
		пКатегорииНастроекMS = КатегорииНастроекMS;
		Если пКатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
			Если КатегорииНастроекMS = Неопределено Тогда
				КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
			КонецЕсли;
			пКатегорииНастроекMS = КатегорииНастроекMS;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем значения кэшируемых настроек, которые не нужно запрашивать и конвертировать
	Если НеПроверятьАктуальность Тогда
		АктуальныеНастройки = Новый Структура;
	Иначе
		АктуальныеНастройки = ЛокЯдро_ПроверитьАктуальностьКэшируемыхНастроек(СтруктураНастроек, ID_Узла);
	КонецЕсли;
	Для каждого АктуальнаяНастройка ИЗ АктуальныеНастройки Цикл	
		СтруктураНастроек.Удалить(АктуальнаяНастройка.Ключ);
	КонецЦикла;
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
	Если ТипИнтерфейса = "REST_API" Тогда
		ПараметрыЗаполненияНастроек = Новый Структура;
		ПараметрыЗаполненияНастроек.Вставить("НеИспользоватьАтрибуты",	НеИспользоватьАтрибуты);
		
		Если пДополнительныеПараметры.Свойство("АтрибутыНастроекMS") Тогда
			ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS", пДополнительныеПараметры.АтрибутыНастроекMS);
		КонецЕсли;
		
		СтруктураНастроек = REST_API_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, пКатегорииНастроекMS, ID_Узла, ПараметрыЗаполненияНастроек);
	Иначе
		СтруктураНастроек = КомЯдро_ЗаполнитьНастройкиSMARTS(СтруктураНастроек, пКатегорииНастроекMS, ID_Узла, ТипБазы);
	КонецЕсли;
	СтруктураНастроек = ЛокЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, "ИзСтроки", СериализуемыеНастройки);
	
	// Кэшируем полученные из базы настройки
	Если НЕ НеКэшировать Тогда
		ЛокЯдро_СохранитьЗначенияКэшируемыхНастроек(СтруктураНастроек, ID_Узла);
	КонецЕсли;

	// Дополняем возвращаемую структуру актуальными кэшируемыми настройками
	Для каждого АктуальнаяНастройка ИЗ АктуальныеНастройки Цикл	
		СтруктураНастроек.Вставить(АктуальнаяНастройка.Ключ, АктуальнаяНастройка.Значение);
	КонецЦикла;
	
	пСообщение = НСтр("ru = 'Конец, Получение настроек на сервере SMARTS';
						|en = 'Finally, Getting the settings on the Cleverence server'; be = 'Канец, атрыманне налад на сэрвэры Cleverence'; es = 'Fin, Obtener la configuración en el servidor Cleverence'; ka = 'და ბოლოს, მიღების პარამეტრების Cleverence სერვერზე'; kk = 'Аяқтау, Cleverence серверінде параметрлерді алу'; ro = 'În cele din urmă, obținerea setărilor pe serverul Cleverence'; tr = 'Son, Cleverence sunucusunda ayarları alma'; uk = 'Кінець, отримання налаштувань на сервері Cleverence'; uz = 'Tugatish, cleverence serverida sozlamalarni olish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураНастроек;
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновитьМетаданныеТаблицMS(ТипБазы = "Основная") Экспорт

	ИмяСобытия = "ЛокЯдро_ОбновитьМетаданныеТаблицMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы",
		ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если ВебКлиент Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ОбновитьМетаданныеТаблицMS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ТипБазы", ТипБазы));
		Таблицы = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	#Иначе
		ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
		Если ТипИнтерфейса = "REST_API" Тогда
			Таблицы = REST_API_ОбновитьМетаданныеТаблицMS(ТипБазы);
		Иначе
			Таблицы = КомЯдро_ОбновитьМетаданныеТаблицMS(ТипБазы);
		КонецЕсли;
	#КонецЕсли
	
	Если Таблицы <> Неопределено
		И ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		И СтруктураМетаданных.Свойство("Tables") Тогда
		СтруктураМетаданных.Вставить("Tables", Таблицы);	
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеМетаданныхДокументов1С(ИспользоватьХранилищеНастроек = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	ВыполнятьВФоне = ДоступноВыполнениеВФоне;
	
	Документы1С = ЛокЯдро_ОбновитьМетаданныеДокументов1С(ИспользоватьХранилищеНастроек, ВыполнятьВФоне, ДополнительныеПараметры);

	// Если недоступно выполнение в фоне, вызываем метод напрямую
	Если Не ВыполнятьВФоне Тогда
		СтруктураРезультата = Новый Структура("Документы1С", Документы1С);
		
		ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеЗавершение(СтруктураРезультата, Неопределено);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ОбновитьМетаданныеДокументов1С(ИспользоватьХранилищеНастроек = Истина, ВыполнятьВФоне = Ложь, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьМетаданныеДокументов1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИспользоватьХранилищеНастроек,ВыполнятьВФоне,ДополнительныеПараметры",
		ИспользоватьХранилищеНастроек, ВыполнятьВФоне, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыМетода = Новый Структура("ИспользоватьХранилищеНастроек", ИспользоватьХранилищеНастроек);
	
	Если Не ВыполнятьВФоне Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ОбновитьМетаданныеДокументов1С");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Результат = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
		
	Иначе
		ПараметрыФЗ = Новый Структура;
		ПараметрыФЗ.Вставить("ИмяМетода", 		"ГлЯдро_ОбновитьМетаданныеДокументов1СВФоне");
		ПараметрыФЗ.Вставить("ПараметрыМетода", ПараметрыМетода);		
		ПараметрыФЗ.Вставить("НаименованиеФЗ",	НСтр("ru = 'Обновление метаданных документов 1С';
														|en = 'Updating metadata of 1C documents'; be = 'Абнаўленне метададзеных дакументаў 1С'; es = 'Actualización de metadatos de documentos 1C'; ka = '1c დოკუმენტების მეტამონაცემების განახლება'; kk = 'Құжаттардың метадеректерін жаңарту 1С'; ro = 'Actualizarea metadatelor documentelor 1C'; tr = '1C belgelerinin meta verilerini güncelleme'; uk = 'Оновлення метаданих документів 1С'; uz = '1C hujjat metama''lumotlarini yangilash'"));
		ПараметрыФЗ.Вставить("ТекстСообщения", 	НСтр("ru = 'Обновление метаданных документов 1С';
														|en = 'Updating metadata of 1C documents'; be = 'Абнаўленне метададзеных дакументаў 1С'; es = 'Actualización de metadatos de documentos 1C'; ka = '1c დოკუმენტების მეტამონაცემების განახლება'; kk = 'Құжаттардың метадеректерін жаңарту 1С'; ro = 'Actualizarea metadatelor documentelor 1C'; tr = '1C belgelerinin meta verilerini güncelleme'; uk = 'Оновлення метаданих документів 1С'; uz = '1C hujjat metama''lumotlarini yangilash'"));
		
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("ВыводитьОкноОжидания")
			И ДополнительныеПараметры.ВыводитьОкноОжидания = Ложь Тогда
			
			ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 	Ложь);
			ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 	Ложь);
			
		КонецЕсли;
		
		ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеЗавершение", ЭтаФорма);
		ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеОшибка", ЭтаФорма);

		ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Перем ОбновлятьЛокальныйКэш;
	
	ИмяСобытия = "ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
	Иначе
		СтруктураРезультата	= Результат;
	КонецЕсли;
	
	Если НЕ ТипЗнч(СтруктураРезультата) = Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Ошибка при обновлении метаданных 1С!';
							|en = 'Error updating 1C metadata!'; be = 'Памылка пры абнаўленні метададзеных 1С!'; es = 'Error al actualizar los metadatos 1C!'; ka = 'შეცდომა განახლება 1c მეტამონაცემები!'; kk = '1С метадеректерін жаңарту кезінде қате!'; ro = 'Eroare la actualizarea metadatelor 1C!'; tr = '1C meta verilerini güncellerken hata oluştu!'; uk = 'Помилка при оновленні метаданих 1С!'; uz = '1C metama''lumotlarini yangilashda xato!'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока);
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	// Обновление локального кэша
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") Тогда
		Документы1С = СтруктураРезультата.Документы1С;
		Если ТипЗнч(Документы1С) = Тип("Структура") Тогда
			СтруктураМетаданных.Вставить("Документы1С", Документы1С);
				
			КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных", СтруктураМетаданных);
		КонецЕсли;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Метаданные 1С успешно обновлены.';
						|en = 'The 1C metadata has been successfully updated.'; be = 'Метададзеныя 1С паспяхова абноўлены.'; es = 'Los metadatos 1C se han actualizado con éxito.'; ka = '1c მეტამონაცემები წარმატებით განახლდა.'; kk = '1С метадеректері сәтті жаңартылды.'; ro = 'Metadatele 1C au fost actualizate cu succes.'; tr = '1C meta verileri başarıyla güncellendi.'; uk = 'Метадані 1С успішно оновлені.'; uz = '1C metadata muvaffaqiyatli yangilandi.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеОшибка(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьМетаданныеДокументов1СВФонеОшибка";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТекстОшибки = Результат;
	
	// <Лог>
	ЯзСтрока = "ru = 'Ошибка при обновлении метаданных 1С в фоне по причине:%1%2';
							|en = 'Error updating 1C metadata in the background due to: %1%2';
							|be = 'Памылка пры абнаўленні метададзеных 1С ў фоне па прычыне:%1% 2'; es = 'Error al actualizar los metadatos 1C en el fondo por:%1% 2'; ka = 'შეცდომა 1c მეტამონაცემების განახლებისას ფონზე გამო: %1% 2'; kk = '1С метадеректерін фонда жаңарту кезінде қате:%1% 2'; ro = 'Eroare la actualizarea metadatelor 1C în fundal din cauza: %1% 2'; tr = 'Arka planda 1C meta verilerini güncellerken bir nedenden dolayı hata oluştu:%1% 2'; uk = 'Помилка при оновленні метаданих 1С в тлі з причини:%1%2'; uz = '1C metama''lumotlarini fonda yangilashda xato:%1%2'";
	ТекстСообщения = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), Символы.ПС, ТекстОшибки);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТекстОшибки",
		ТекстОшибки);
	ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока, логКонтекст);
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ОбновитьМетаданныеДокументовMS(ИспользоватьХранилищеНастроек = Истина, ОбновлятьКэш = Ложь) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьМетаданныеДокументовMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИспользоватьХранилищеНастроек,ОбновлятьКэш",
		ИспользоватьХранилищеНастроек, ОбновлятьКэш);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ОбновитьМетаданныеДокументовMS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИспользоватьХранилищеНастроек", ИспользоватьХранилищеНастроек));
		
		пСтруктураМетаданных = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);	
	Иначе
		ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
		Если ЕстьЧастнаяБаза = Истина Тогда
			ТипБазы = "Частная";
	    Иначе
			ТипБазы = "Основная";
		КонецЕсли;
		
		ИдентификаторБазыMS = "";
		ВерсияМетаданныхMS  = "";
		
		ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
		Если ТипИнтерфейса = "REST_API"	Тогда
			Если ПараметрыПодключенияMS = Неопределено Тогда
				ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
			КонецЕсли;
			Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
				ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
				ВерсияМетаданныхMS =  ?(ПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS"), ПараметрыПодключенияMS.ВерсияКонфигурацииSMARTS, "");
			КонецЕсли;
		Иначе
			Если ТипБазы = "Частная" Тогда
				СтруктураПодключенияMS = COMЧастнойБазыMS;
			Иначе
				СтруктураПодключенияMS = COMБазыMS;
			КонецЕсли;
		    ИдентификаторБазыMS = СтруктураПодключенияMS.StorageConnector.CurrentAppSettings.ServerAppInstanceId;
			ВерсияМетаданныхMS  = СтруктураПодключенияMS.StorageConnector.GetEnvironment().Version;
			ВерсияМетаданныхMS 	= Формат(ВерсияМетаданныхMS, "ЧГ=0");
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ВерсияМетаданныхMS) Тогда
			ИспользоватьХранилищеНастроек = Ложь;	
		КонецЕсли;
		
		// Добавляем внутреннюю версию для обеспечения обратной совместимости.
		// При запуске старой версии ОО метаданные будут пересозданы,
		// 	а при возврате к новой версии — получены повторно.
		ВерсияAPI = REST_API_ПолучитьВерсиюAPI();
		ВерсияМетаданныхMSКэша = ВерсияМетаданныхMS;
		Если ВерсияAPI >= 2 Тогда
			ВерсияМетаданныхMSКэша = ВерсияМетаданныхMSКэша + "_2000000001";
		КонецЕсли;
		
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
		
		ИмяПеременнойВерсия 	= "Cleverence_ВерсияМетаданныхMS_" 	  + ИдентификаторБазыMS;
		ИмяПеременнойНастройки 	= "Cleverence_СтруктураМетаданныхMS_" + ИдентификаторБазыMS;
		
		Если ИспользоватьХранилищеНастроек Тогда
			СохраненнаяВерсияМетаданныхMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойВерсия);
			Если НЕ ЗначениеЗаполнено(СохраненнаяВерсияМетаданныхMS)
				ИЛИ СокрЛП(СохраненнаяВерсияМетаданныхMS) <> СокрЛП(ВерсияМетаданныхMSКэша) Тогда
				ИспользоватьХранилищеНастроек = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ИспользоватьХранилищеНастроек Тогда
			Если ТипИнтерфейса = "REST_API" Тогда
				пСтруктураМетаданных = REST_API_ПолучитьМетаданныеMSИзХранилища1С(ТипБазы, ИмяПеременнойНастройки);
			Иначе
				пСтруктураМетаданных = КомЯдро_ПолучитьМетаданныеMSИзХранилища1С(ТипБазы, ИмяПеременнойНастройки);
			КонецЕсли;
			
			Если пСтруктураМетаданных <> Неопределено Тогда
				КомЯдро_СохранитьЗначениеПеременной("ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS", Ложь);
				
				Если НЕ пСтруктураМетаданных.Свойство("ВыгружаемыеПоляЯчеекMS") Тогда
					пСтруктураМетаданных.Вставить("ВыгружаемыеПоляЯчеекMS", ЛокЯдро_ПолучитьМассивВыгружаемыхПолейЯчеекMS());
				КонецЕсли;
				
				Если НЕ пСтруктураМетаданных.Свойство("ЯзыкПлатформыMS") Тогда
					пСтруктураМетаданных.Вставить("ЯзыкПлатформыMS", ЛокЯдро_ЯзыкПлатформыMSПоСтруктуреБазы(ТипБазы));
				КонецЕсли;
				
				// <Лог>
				логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", пСтруктураМетаданных);
				ЛогЗавершитьСобытие(логСобытие, логКонтекст);
				// </Лог>
				
				Возврат пСтруктураМетаданных;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипИнтерфейса = "REST_API" Тогда
			пСтруктураМетаданных = REST_API_ПолучитьМетаданныеДокументовMS(ТипБазы, ИмяПеременнойНастройки);
		Иначе
			пСтруктураМетаданных = КомЯдро_ПолучитьМетаданныеДокументовMS(ТипБазы, ИмяПеременнойНастройки);
		КонецЕсли;
		
		ЛокЯдро_СохранитьДанныеВХранилище1С(ИмяПеременнойВерсия, ВерсияМетаданныхMSКэша);
    КонецЕсли;
	
	Если ОбновлятьКэш
		И пСтруктураМетаданных <> Неопределено Тогда
		СтруктураМетаданных.Вставить("ДокументыMS",					  			пСтруктураМетаданных.ДокументыMS);
		СтруктураМетаданных.Вставить("ПользователиMS",				  			пСтруктураМетаданных.ПользователиMS);
		СтруктураМетаданных.Вставить("УстройстваMS",				  			пСтруктураМетаданных.УстройстваMS);
		СтруктураМетаданных.Вставить("Tables",						 			пСтруктураМетаданных.Tables);
		СтруктураМетаданных.Вставить("UniПолейНоменклатуры", 		  			пСтруктураМетаданных.UniПолейНоменклатуры);
		СтруктураМетаданных.Вставить("ВыгружаемыеПоляНоменклатурыMS", 			пСтруктураМетаданных.ВыгружаемыеПоляНоменклатурыMS);
		СтруктураМетаданных.Вставить("ВыгружаемыеПоляЯчеекMS", 		  			пСтруктураМетаданных.ВыгружаемыеПоляЯчеекMS);
		СтруктураМетаданных.Вставить("ПлатформаПоддерживаетSupportUntilDate", 	пСтруктураМетаданных.ПлатформаПоддерживаетSupportUntilDate);
		СтруктураМетаданных.Вставить("ЯзыкПлатформыMS", 		  				пСтруктураМетаданных.ЯзыкПлатформыMS);
		
		КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных", СтруктураМетаданных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", пСтруктураМетаданных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат пСтруктураМетаданных;
	
КонецФункции

