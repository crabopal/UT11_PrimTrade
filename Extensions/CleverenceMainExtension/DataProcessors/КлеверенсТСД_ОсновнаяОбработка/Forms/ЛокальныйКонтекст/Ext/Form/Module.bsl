	// </Лог>
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);                              
	
	КоллекцияШаблонов = Новый Массив;
	// Добавление новых шаблонов
	Для Каждого Шаблон из ТаблицаШаблонов Цикл
		ЦелаяЧасть = Шаблон.ЦелаяЧасть - СтрДлина(Шаблон.Префикс);
		Если Шаблон.ПрефиксВключенВКод Тогда			
			КоллекцияШаблонов.Добавить("{Barcode:@" + Шаблон.Префикс + "[0-9]{" + Шаблон.ДлинаКодаВесовогоТовара + "}}{Quantity:" + ЦелаяЧасть + "." + Шаблон.ДробнаяЧасть + "}{OneC:1}");
		Иначе
			КоллекцияШаблонов.Добавить(Шаблон.Префикс + "{Barcode:" + Шаблон.ДлинаКодаВесовогоТовара + "}{Quantity:" + ЦелаяЧасть + "." + Шаблон.ДробнаяЧасть + "}{OneC:1}");
		КонецЕсли;
	КонецЦикла;	
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI();
	
	ОтправляемыеДанные = Новый Соответствие;
	ОтправляемыеДанные.Вставить("commonTemplates", КоллекцияШаблонов);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"PATCH");
	СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "ProductSchema('1')", "InventorySchema"));
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета);
	КонецЕсли;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция REST_API_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла)

	ИмяСобытия = "REST_API_ЗагрузитьФайлИзБазыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS,ПараметрыФайла",
		ПараметрыПодключенияMS, ПараметрыФайла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	АдресДвоичныхДанных = Неопределено;
	
	ПутьКФайлу	  = ПараметрыФайла.ПутьКФайлу;
	ИмяФайла	  = ПараметрыФайла.ИмяФайла;
	СтрокаЗапроса = ПутьКФайлу + ИмяФайла;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод",					"GET");
	СтруктураЗапроса.Вставить("Метод",						СтрокаЗапроса);
	СтруктураЗапроса.Вставить("ТипЗапроса",					"ПоУмолчанию");
	СтруктураЗапроса.Вставить("ВерсияAPI",				 	"");
	СтруктураЗапроса.Вставить("ВернутьДвоичныеДанные",	 	Истина);
	СтруктураЗапроса.Вставить("УровеньЖурналаПриОшибке",	"Информация");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(ПараметрыПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
	Если СтруктураОтвета.КодСостояния = 200 Тогда
		АдресДвоичныхДанных = СтруктураОтвета.ОтветСервера;
	Иначе
		ПараметрыЗаписи = Новый Структура("УровеньЖурнала", "Информация");
		
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресДвоичныхДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат АдресДвоичныхДанных;
	
КонецФункции

