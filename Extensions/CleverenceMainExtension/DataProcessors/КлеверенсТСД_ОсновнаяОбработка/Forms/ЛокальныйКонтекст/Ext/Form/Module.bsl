&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокПолейШаблона(СтруктураПараметров) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСписокПолейШаблона";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("СтруктураПараметров", СтруктураПараметров);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьСписокПолейШаблона");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	СписокПолейШаблона = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);	
	
	//Может вернуться неопределено в случае, если нет интеграционной обработки
	//Попробуем получить ИО снова
	Если СписокПолейШаблона = Неопределено Тогда
		Если РасположениеКомпоненты = Неопределено Тогда
			РасположениеКомпоненты = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		КонецЕсли;
		ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты);
		СписокПолейШаблона = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокПолейШаблона);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СписокПолейШаблона;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_НапечататьЭтикетки(СтруктураПараметров) Экспорт

	ИмяСобытия = "ЛокЯдро_НапечататьЭтикетки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров",
		СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ИмяТаблицы 		= СтруктураПараметров.ИмяТаблицы;
	ID_Узла			= СтруктураПараметров.ID_Узла;
	ТаблицаВыборки 	= СтруктураПараметров.ТаблицаВыборки;
	
	// Получение настроек
	
	НастройкиПечатиЭтикеток = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиПечатиЭтикеток", Истина);
	Если НастройкиПечатиЭтикеток = Неопределено Тогда
		СтруктураНастроек = ЛокЯдро_ПолучитьЗначениеТабличнойНастройкиНаСервереSMARTS("НастройкиПечатиЭтикеток", Новый Структура("ИмяТаблицы", ИмяТаблицы));
	Иначе
		СтруктураНастроек = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиПечатиЭтикеток, Новый Структура("ИмяТаблицы", ИмяТаблицы));
	КонецЕсли;
	
	Если СтруктураНастроек = Неопределено Тогда
		ТекстПредупреждения = НСтр("ru = 'Не найдены настройки печати этикеток для таблицы [%1]!';
									|en = 'Label printing settings for the [%1] table were not found!';
									|be = 'Не знойдзены налады друку этыкетак для табліцы [%1]!'; es = '¡No se encontró ninguna configuración de impresión de etiquetas para la tabla [%1]!'; ka = 'Label ბეჭდვის პარამეტრების მაგიდა [%1] არ იქნა ნაპოვნი!'; kk = '[%1] кестесі үшін жапсырманы басып шығару параметрлері табылмады!'; ro = 'Setările de imprimare a etichetelor pentru tabelul [%1] nu au fost găsite!'; tr = '[%1] tablosu için etiket yazdırma ayarları bulunamadı!'; uk = 'Не знайдено налаштувань друку етикеток для таблиці [%1]!'; uz = 'Jadval uchun yorliqlarni chop etish sozlamalari topilmadi [%1]!'");
		ТекстПредупреждения = ЛокЯдро_СтрШаблон(ТекстПредупреждения, ИмяТаблицы);
		ПоказатьПредупреждение(, ТекстПредупреждения, , ЛокЯдро_ТекстВнимание()); 
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	Иначе
		ШаблонЭтикетки 	= ?(СтруктураНастроек[0].Свойство("ШаблонЭтикетки"), 				СтруктураНастроек[0].ШаблонЭтикетки, 				Неопределено);
		ВстроенныйМакет = ?(СтруктураНастроек[0].Свойство("ВстроенныйМакет"), 				СтруктураНастроек[0].ВстроенныйМакет, 				Ложь);
		НастройкиПечати = ?(СтруктураНастроек[0].Свойство("НастройкаПечатиМассивСтруктур"), СтруктураНастроек[0].НастройкаПечатиМассивСтруктур, Неопределено);
		
		Если НЕ ЗначениеЗаполнено(ШаблонЭтикетки) Тогда
			ТекстПредупреждения = НСтр("ru = 'В настройках печати для таблицы [%1] не выбран шаблон этикетки!';
										|en = 'The label template is not selected in the printing settings for the [%1] table!';
										|be = 'У наладах друку для табліцы [%1] не абраны шаблон этыкеткі!'; es = '¡La plantilla de etiqueta no está seleccionada en la configuración de impresión de la tabla [%1]!'; ka = 'ეტიკეტის შაბლონი არ არის შერჩეული [%1] ცხრილის ბეჭდვის პარამეტრებში!'; kk = '[%1] кестесі үшін басып шығару параметрлерінде жапсырма үлгісі таңдалмаған!'; ro = 'Șablonul de etichetă nu este selectat în setările de imprimare pentru tabelul [%1]!'; tr = '[%1] tablosunun yazdırma ayarlarında etiket şablonu seçilmedi!'; uk = 'У налаштуваннях друку для таблиці [%1] не вибрано шаблон етикетки!'; uz = 'Jadval uchun chop etish sozlamalarida [%1] yorliq shabloni tanlanmagan!'");
			ТекстПредупреждения = ЛокЯдро_СтрШаблон(ТекстПредупреждения, ИмяТаблицы);
			ПоказатьПредупреждение(, ТекстПредупреждения, , ЛокЯдро_ТекстВнимание()); 
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		Если НастройкиПечати = Неопределено ИЛИ ТипЗнч(НастройкиПечати) <> Тип("Массив") Тогда
			ТекстПредупреждения = НСтр("ru = 'Не найдены настройки печати этикеток для таблицы [%1]!';
										|en = 'Label printing settings for the [%1] table were not found!';
										|be = 'Не знойдзены налады друку этыкетак для табліцы [%1]!'; es = '¡No se encontró ninguna configuración de impresión de etiquetas para la tabla [%1]!'; ka = 'Label ბეჭდვის პარამეტრების მაგიდა [%1] არ იქნა ნაპოვნი!'; kk = '[%1] кестесі үшін жапсырманы басып шығару параметрлері табылмады!'; ro = 'Setările de imprimare a etichetelor pentru tabelul [%1] nu au fost găsite!'; tr = '[%1] tablosu için etiket yazdırma ayarları bulunamadı!'; uk = 'Не знайдено налаштувань друку етикеток для таблиці [%1]!'; uz = 'Jadval uchun yorliqlarni chop etish sozlamalari topilmadi [%1]!'");
			ТекстПредупреждения = ЛокЯдро_СтрШаблон(ТекстПредупреждения, ИмяТаблицы);
			ПоказатьПредупреждение(, ТекстПредупреждения, , ЛокЯдро_ТекстВнимание()); 
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	// Формирование данных для печати
	
	ЕстьГлобальныеПараметры = ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(НастройкиПечати, "ТипИсточника", "ГлобальныйПараметр") <> Неопределено;
	Если ЕстьГлобальныеПараметры Тогда	
		ГлобальныеПараметры = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла);
	КонецЕсли;
		
	ЕстьПроизвольныеКоды = ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(НастройкиПечати, "ТипИсточника", "ПроизвольныйКод") <> Неопределено;
	Если ЕстьПроизвольныеКоды Тогда	
		ПроизвольныеКоды = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Новый Структура("Направление,ТипОбъекта", "Настройка", "ПечатьЭтикеток"));
	КонецЕсли;
		
	МассивДанных = Новый Массив;
	
	Для каждого СтрокаТаблицы ИЗ ТаблицаВыборки Цикл
		Если СтрокаТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураДанных = Новый Структура;		
		
		Для каждого ТекСтрока ИЗ НастройкиПечати Цикл
			Если ТекСтрока.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекСтрока.Выгружать
				ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.ИмяПриемника) Тогда
				Продолжить;				
			КонецЕсли;
			
			ЗначениеПоля = Неопределено;			
			
			Если ТекСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
				НайденныйГП = ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(ГлобальныеПараметры, "ID_Параметра", ТекСтрока.ИмяИсточника);
				Если НайденныйГП <> Неопределено Тогда
					ЗначениеПоля = НайденныйГП.Значение;	
				КонецЕсли;
			ИначеЕсли ТекСтрока.ТипИсточника = "ПроизвольныйКод" Тогда				
				НайденныйПК = ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(ПроизвольныеКоды, "ID_ПроизвольногоКода", ТекСтрока.ИмяИсточника);
				Если НайденныйПК <> Неопределено Тогда
					СтруктураПеременных = Новый Структура;
					СтруктураПеременных.Вставить("СтрокаДанныхДляВыгрузки", СтрокаТаблицы);  
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("ТекстПроизвольногоКода", 	НайденныйПК.ТекстПроизвольногоКода);
					СтруктураПараметров.Вставить("СтруктураПеременных", 	СтруктураПеременных);
					СтруктураПараметров.Вставить("ID_ПроизвольногоКода", 	НайденныйПК.ID_ПроизвольногоКода);
					СтруктураПараметров.Вставить("ИмяПроизвольногоКода", 	НайденныйПК.Наименование);
					
					РезультатВыполненияКода = ЛокЯдро_ВыполнитьПроизвольныйКодНаСервере(СтруктураПараметров);
					Если РезультатВыполненияКода.Статус Тогда
						ЗначениеПоля = РезультатВыполненияКода.Данные;	
					Иначе
						СообщениеОбОшибках = НСтр("ru = 'Не удалось выполнить произвольный код [%1]';
													|en = 'Arbitrary code could not be executed [%1]'; be = 'Не атрымалася выканаць адвольны код [%1]'; es = 'No se pudo ejecutar código arbitrario [%1]'; ka = 'თვითნებური კოდი ვერ შესრულდება [%1]'; kk = 'Ерікті кодты орындау мүмкін болмады [%1]'; ro = 'Codul arbitrar nu a putut fi executat [%1]'; tr = 'Rastgele kod yürütülemedi [%1]'; uk = 'Не вдалося виконати довільний код [%1]'; uz = 'Ixtiyoriy kodni bajarib bo''lmadi [%1]'");
						СообщениеОбОшибках = ЛокЯдро_СтрШаблон(СообщениеОбОшибках, НайденныйПК.Наименование);
						Сообщить(СообщениеОбОшибках); 
					КонецЕсли;
				КонецЕсли;			
			ИначеЕсли ТекСтрока.ТипИсточника = "Реквизит1С"	Тогда
				ЗначениеИсточника = Неопределено;
				Если ЗначениеЗаполнено(ТекСтрока.ИмяИсточника) И СтрокаТаблицы.Свойство(ТекСтрока.ИмяИсточника, ЗначениеИсточника) Тогда
					ЗначениеПоля = ЗначениеИсточника;
				КонецЕсли;
			Иначе	
				ЗначениеПоля = ТекСтрока.ЗначениеИсточника;				
			КонецЕсли;
			
			КлючСтруктуры = ТекСтрока.ИмяПриемника;
			Пока Найти(КлючСтруктуры, ".") Цикл
				КлючСтруктуры = СтрЗаменить(КлючСтруктуры, ".", "_СимволТочки_");				
			КонецЦикла;
			
			СтруктураДанных.Вставить(КлючСтруктуры, ЗначениеПоля); 					
			
		КонецЦикла;
			
		Если СтруктураДанных.Количество() Тогда
			МассивДанных.Добавить(СтруктураДанных);
		КонецЕсли;

	КонецЦикла;
	
	// Вывод на печать
	
	Если ВстроенныйМакет Тогда
		ШаблонЭтикетки = ЛокЯдро_ПолучитьМакетОбработки("Этикетка" + СокрЛП(ШаблонЭтикетки));		
	КонецЕсли;	
	СтруктураШаблона = ЛокЯдро_ПодготовитьСтруктуруМакетаШаблона(ШаблонЭтикетки, ИмяТаблицы);
	
	ТабличныйДокумент = ЛокЯдро_СформироватьПечатнуюФормуЭтикетки(Новый Структура("СтруктураШаблона, ДанныеДляПечати", СтруктураШаблона, МассивДанных));
		
	ДокументНапечатан = Ложь;
	
	// Проверка существования модуля УправлениеПечатьюКлиент
	МодульПечатиСуществует = ЛокЯдро_ВычислитьВБезопасномРежиме("Метаданные.ОбщиеМодули.Найти(""УправлениеПечатьюКлиент"") <> Неопределено");
	Если НЕ МодульПечатиСуществует Тогда
		УправлениеПечатьюКлиент = Неопределено;
	КонецЕсли;
	
	Если МодульПечатиСуществует Тогда
		Попытка
			КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПроизвольнаяЭтикетка");
			КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент;
				
			УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
			ДокументНапечатан = Истина;
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			пСообщение = НСтр("ru = 'Не удалось добавить документ в коллекцию: %1';
								|en = 'Couldn''t add document to collection: %1'; be = 'Не атрымалася дадаць дакумент у калекцыю: %1'; es = 'No se pudo agregar el documento a la colección: %1'; ka = 'ვერ დაამატე დოკუმენტი კოლექციაში: %1'; kk = 'Жинаққа құжат қосу мүмкін болмады: %1'; ro = 'Nu s-a putut adăuga documentul la colecție: %1'; tr = 'Koleksiyona belge eklenemedi: %1'; uk = 'Не вдалося додати документ до колекції: %1'; uz = 'Hujjatni to''plamga qo''shib bo''lmadi: %1'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТекстОшибки);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_НапечататьЭтикетки", "Предупреждение", пСообщение);
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ ДокументНапечатан Тогда
		ТабличныйДокумент.ОтображатьСетку = Ложь;
		ТабличныйДокумент.Показать("Печать этикеток для таблицы " + СокрЛП(ИмяТаблицы));		
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПодготовитьСтруктуруМакетаШаблона(ШаблонЭтикетки, ИмяТаблицы)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ШаблонЭтикетки",  ШаблонЭтикетки);
	СтруктураПараметров.Вставить("ИмяТаблицы",		ИмяТаблицы);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("СтруктураПараметров", СтруктураПараметров);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ПодготовитьСтруктуруМакетаШаблона");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	СтруктураШаблона = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);	
	
	Возврат СтруктураШаблона;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_СформироватьПечатнуюФормуЭтикетки(СтруктураПараметров) Экспорт

	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("СтруктураПараметров", СтруктураПараметров);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"СформироватьПечатнуюФормуЭтикетки");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	ТабличныйДокумент = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);	
	
	Возврат ТабличныйДокумент;		
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПозицииПараметровШаблона(ТекстЯчейки) Экспорт
	
	Массив = Новый Массив;
	
	Начало = -1;
	Конец  = -1;
	СчетчикСкобокОткрывающих = 0;
	СчетчикСкобокЗакрывающих = 0;
	
	Для Индекс = 1 По СтрДлина(ТекстЯчейки) Цикл
		Символ = Сред(ТекстЯчейки, Индекс, 1);
		Если Символ = "[" Тогда
			СчетчикСкобокОткрывающих = СчетчикСкобокОткрывающих + 1;
			Если СчетчикСкобокОткрывающих = 1 Тогда
				Начало = Индекс;
			КонецЕсли;
		ИначеЕсли Символ = "]" Тогда
			СчетчикСкобокЗакрывающих = СчетчикСкобокЗакрывающих + 1;
			Если СчетчикСкобокЗакрывающих = СчетчикСкобокОткрывающих Тогда
				Конец = Индекс;
				
				Массив.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
				
				Начало = -1;
				Конец  = -1;
				СчетчикСкобокОткрывающих = 0;
				СчетчикСкобокЗакрывающих = 0;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

#КонецОбласти

#Область ЛокальныйКонтекст_ФоновыеЗадания

&НаКлиенте
Процедура ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ = Неопределено, ОписаниеОповещенияОшибкиФЗ = Неопределено)

	ИмяСобытия = "ЛокЯдро_НачатьВыполнениеФоновогоЗадания";
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ПараметрыФЗ,ОписаниеОповещенияЗавершенияФЗ,ОписаниеОповещенияОшибкиФЗ",
			ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
		логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
		// </Лог>
		
		Попытка
			
			Если ПараметрыФЗ.Свойство("ПараметрыМетода") И
				ТипЗнч(ПараметрыФЗ.ПараметрыМетода) = Тип("Структура") И
				ПараметрыФЗ.ПараметрыМетода.Свойство("АдресаПеременных") Тогда
				
				// ФЗ выполняется в другом сеансе, поэтому данные добавленные в кэш в ФЗ не будут сохранены
				// Чтобы данные сохранились, добавим в АдресаПеременных пустые значения всех настроек, которые могут быть добавлены в кэш
				// В методе сохранения настроек в кэш будем анализировать, если это фоновое задание, то будем сохранять данные иначе. См. КомЯдро_СохранитьЗначениеПеременной()	
				КоличествоПеременныхСохраняемыхВКэш = 40;
				МассивАдресовПустыхЗначений = Новый Массив();
				Для Счетчик = 1 По КоличествоПеременныхСохраняемыхВКэш Цикл
					ЗначениеМассива = ПоместитьВоВременноеХранилище("", АдресаПеременных.ИдентификаторФормы);
					МассивАдресовПустыхЗначений.Добавить(ЗначениеМассива);
				КонецЦикла;
				ПараметрыФЗ.ПараметрыМетода.Вставить("МассивАдресовПустыхЗначений", МассивАдресовПустыхЗначений);
				
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ПараметрыФЗ", 					ПараметрыФЗ);
			ДополнительныеПараметры.Вставить("ОписаниеОповещенияЗавершенияФЗ", 	ОписаниеОповещенияЗавершенияФЗ);
			ДополнительныеПараметры.Вставить("ОписаниеОповещенияОшибкиФЗ", 		ОписаниеОповещенияОшибкиФЗ);
			#Если ВебКлиент Тогда
				ДополнительныеПараметры.Вставить("УстановитьЕслиНеПодключено", Истина);
				ДополнительныеПараметры.Вставить("ВыборЗавершение", Новый ОписаниеОповещения("ЛокЯдро_ПоместитьФайлВнешнейОбработки", ЭтаФорма));
				
				ЛокЯдро_ПередПодключениемРасширенияРаботыСФайлами(ДополнительныеПараметры);
			#Иначе
				ЛокЯдро_ПоместитьФайлВнешнейОбработки(ДополнительныеПараметры);
			#КонецЕсли
			
		Исключение
			
			ИнфоОшибка = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибка);
			
			Если ТипЗнч(ОписаниеОповещенияОшибкиФЗ) = Тип("ОписаниеОповещения") Тогда
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияОшибкиФЗ, ТекстОшибки);
			Иначе
				
				// <Лог>
				ЯзСтрока = "ru = 'Ошибка выполнения фонового задания';
							|en = 'Background task execution error'; be = 'Памылка выканання фонавага задання'; es = 'Error de trabajo en segundo plano'; ka = 'ფონის დავალების შესრულების შეცდომა'; kk = 'Фондық тапсырманы орындау қатесі'; ro = 'Eroare de execuție a sarcinii de fundal'; tr = 'Arka plan işi yürütülürken hata oluştu'; uk = 'Помилка виконання фонового завдання'; uz = 'Fon vazifasini bajarishda xato'";
				ТекстСообщения = НСтр(ЯзСтрока);
				ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока,, ИнфоОшибка);
				// </Лог>
				
				ТекстСообщения = ТекстСообщения + ":" + Символы.ПС + ТекстОшибки;
				Сообщить(ТекстСообщения);
				
			КонецЕсли;
			
		КонецПопытки;
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_НачатьВыполнениеФоновогоЗаданияПродолжение(ДополнительныеПараметры)
	
	ИмяСобытия = "ЛокЯдро_НачатьВыполнениеФоновогоЗаданияПродолжение";
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		ПараметрыФЗ 					= ДополнительныеПараметры.ПараметрыФЗ;
		ОписаниеОповещенияЗавершенияФЗ 	= ДополнительныеПараметры.ОписаниеОповещенияЗавершенияФЗ;
		ОписаниеОповещенияОшибкиФЗ 		= ДополнительныеПараметры.ОписаниеОповещенияОшибкиФЗ;
		
		// Заготовка для вывода собственного прогресс бара
		// ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("<ОповещениеОПрогрессеВыполнения>", ЭтотОбъект);
		
		ПараметрыЗапускаФЗ = Новый Структура("НаименованиеФЗ, ИмяМетода, ПараметрыМетода");
		ЗаполнитьЗначенияСвойств(ПараметрыЗапускаФЗ, ПараметрыФЗ);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"НаименованиеФЗ,ИмяМетода,ПараметрыМетода,ОписаниеОповещенияЗавершенияФЗ,ОписаниеОповещенияОшибкиФЗ",
			ПараметрыЗапускаФЗ.НаименованиеФЗ, ПараметрыЗапускаФЗ.ИмяМетода, ПараметрыЗапускаФЗ.ПараметрыМетода, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
		логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
		
		КэшЛогирования = Неопределено;
		АдресЛогБуфераФЗ = Неопределено;
		Если ТипЗнч(ПараметрыЗапускаФЗ.ПараметрыМетода) = Тип("Структура") И
			ПараметрыЗапускаФЗ.ПараметрыМетода.Свойство("АдресаПеременных") Тогда
			КэшЛогирования = ЛокЯдро_Логирование_ПеренестиКэшЛогированияНаСервер(ПараметрыЗапускаФЗ.ПараметрыМетода.АдресаПеременных, Истина);
			
			Если КэшЛогирования <> Неопределено
				И КэшЛогирования.Свойство("АдресЛогБуфераФЗ") Тогда
				АдресЛогБуфераФЗ = КэшЛогирования.АдресЛогБуфераФЗ;
			КонецЕсли;
		КонецЕсли;
		// </Лог>
		
		НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ДлительнаяОперация = ЛокЯдро_НачатьВыполнениеФоновогоЗаданияНаСервере(ПараметрыЗапускаФЗ, КэшЛогирования);
		
		ДлительностьЗапуска = ТекущаяУниверсальнаяДатаВМиллисекундах() -НачалоЗамера;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ИдентификаторЗадания,ДлительностьЗапуска",
			ДлительнаяОперация.ИдентификаторЗадания, ДлительностьЗапуска);
			
		пШаблон = "Идентификатор фонового задания: %1";
		пСообщение = ЛокЯдро_СтрШаблон(пШаблон, ДлительнаяОперация.ИдентификаторЗадания);
		ЛогИнфо(логСобытие, пСообщение, пШаблон, логКонтекст);
		// </Лог>
		
		Если ЛокЯдро_ОбщийМодульСуществует("ДлительныеОперацииКлиент") Тогда
			
			МодульДлительныеОперацииКлиент = ЛокЯдро_ОбщийМодуль("ДлительныеОперацииКлиент");
			ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
			
			Если ПараметрыФЗ.Свойство("ФормаВладелец") И ПараметрыОжидания.Свойство("ФормаВладелец") Тогда
				ПараметрыОжидания.ФормаВладелец = ПараметрыФЗ.ФормаВладелец;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ТекстСообщения") И ПараметрыОжидания.Свойство("ТекстСообщения") Тогда
				ПараметрыОжидания.ТекстСообщения = ПараметрыФЗ.ТекстСообщения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("Заголовок") И ПараметрыОжидания.Свойство("Заголовок") Тогда
				ПараметрыОжидания.Заголовок = ПараметрыФЗ.Заголовок;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("НомерПопытки") И ПараметрыОжидания.Свойство("НомерПопытки") Тогда
				ПараметрыОжидания.НомерПопытки = ПараметрыФЗ.НомерПопытки;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьОкноОжидания") И ПараметрыОжидания.Свойство("ВыводитьОкноОжидания") Тогда
				ПараметрыОжидания.ВыводитьОкноОжидания = ПараметрыФЗ.ВыводитьОкноОжидания;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("РежимОткрытияОкнаОжидания") И ПараметрыОжидания.Свойство("РежимОткрытияОкнаОжидания") Тогда
				ПараметрыОжидания.РежимОткрытияОкнаОжидания = ПараметрыФЗ.РежимОткрытияОкнаОжидания;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьПрогрессВыполнения") И ПараметрыОжидания.Свойство("ВыводитьПрогрессВыполнения") Тогда
				ПараметрыОжидания.ВыводитьПрогрессВыполнения = ПараметрыФЗ.ВыводитьПрогрессВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ОповещениеОПрогрессеВыполнения") И ПараметрыОжидания.Свойство("ОповещениеОПрогрессеВыполнения") Тогда
				ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ПараметрыФЗ.ОповещениеОПрогрессеВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьСообщения") И ПараметрыОжидания.Свойство("ВыводитьСообщения") Тогда
				ПараметрыОжидания.ВыводитьСообщения = ПараметрыФЗ.ВыводитьСообщения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ЗаголовокКнопкиОтмена") И ПараметрыОжидания.Свойство("ЗаголовокКнопкиОтмена") Тогда
				ПараметрыОжидания.ЗаголовокКнопкиОтмена = ПараметрыФЗ.ЗаголовокКнопкиОтмена;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ИнтервалПроверкиВыполнения") И ПараметрыОжидания.Свойство("Интервал") Тогда
				ПараметрыОжидания.Интервал = ПараметрыФЗ.ИнтервалПроверкиВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("Интервал") И ПараметрыОжидания.Свойство("Интервал") Тогда
				ПараметрыОжидания.Интервал = ПараметрыФЗ.Интервал;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ПолучатьРезультат") И ПараметрыОжидания.Свойство("ПолучатьРезультат") Тогда
				ПараметрыОжидания.ПолучатьРезультат = ПараметрыФЗ.ПолучатьРезультат;
			КонецЕсли;
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ОписаниеОповещенияЗавершенияФЗ", ОписаниеОповещенияЗавершенияФЗ);
			ДопПараметры.Вставить("ОписаниеОповещенияОшибкиФЗ", ОписаниеОповещенияОшибкиФЗ);
			ДопПараметры.Вставить("АдресЛогБуфераФЗ", АдресЛогБуфераФЗ);
			
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ЛокЯдро_ВыполнитьПроцедуруФоновоВыполнено", ЭтаФорма, ДопПараметры);
			МодульДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
			
		ИначеЕсли ЛокЯдро_ОбщийМодульСуществует("TimeConsumingOperationsClient") Тогда
			
			МодульДлительныеОперацииКлиент = ЛокЯдро_ОбщийМодуль("TimeConsumingOperationsClient");
			ПараметрыОжидания = МодульДлительныеОперацииКлиент.IdleParameters(Неопределено);
			
			Если ПараметрыФЗ.Свойство("ФормаВладелец") И ПараметрыОжидания.Свойство("OwnerForm") Тогда
				ПараметрыОжидания.OwnerForm = ПараметрыФЗ.ФормаВладелец;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ТекстСообщения") И ПараметрыОжидания.Свойство("MessageText") Тогда
				ПараметрыОжидания.MessageText = ПараметрыФЗ.ТекстСообщения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("Заголовок") И ПараметрыОжидания.Свойство("Title") Тогда
				ПараметрыОжидания.Title = ПараметрыФЗ.Заголовок;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("НомерПопытки") И ПараметрыОжидания.Свойство("AttemptNumber") Тогда
				ПараметрыОжидания.AttemptNumber = ПараметрыФЗ.НомерПопытки;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьОкноОжидания") И ПараметрыОжидания.Свойство("OutputIdleWindow") Тогда
				ПараметрыОжидания.OutputIdleWindow = ПараметрыФЗ.ВыводитьОкноОжидания;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("РежимОткрытияОкнаОжидания") И ПараметрыОжидания.Свойство("OpeningModeForWaitDialog") Тогда
				ПараметрыОжидания.OpeningModeForWaitDialog = ПараметрыФЗ.РежимОткрытияОкнаОжидания;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьПрогрессВыполнения") И ПараметрыОжидания.Свойство("OutputProgressBar") Тогда
				ПараметрыОжидания.OutputProgressBar = ПараметрыФЗ.ВыводитьПрогрессВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ОповещениеОПрогрессеВыполнения") И ПараметрыОжидания.Свойство("ExecutionProgressNotification") Тогда
				ПараметрыОжидания.ExecutionProgressNotification = ПараметрыФЗ.ОповещениеОПрогрессеВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ВыводитьСообщения") И ПараметрыОжидания.Свойство("OutputMessages") Тогда
				ПараметрыОжидания.OutputMessages = ПараметрыФЗ.ВыводитьСообщения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ЗаголовокКнопкиОтмена") И ПараметрыОжидания.Свойство("CancelButtonTitle") Тогда
				ПараметрыОжидания.CancelButtonTitle = ПараметрыФЗ.ЗаголовокКнопкиОтмена;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ИнтервалПроверкиВыполнения") И ПараметрыОжидания.Свойство("Interval") Тогда
				ПараметрыОжидания.Interval = ПараметрыФЗ.ИнтервалПроверкиВыполнения;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("Интервал") И ПараметрыОжидания.Свойство("Interval") Тогда
				ПараметрыОжидания.Interval = ПараметрыФЗ.Интервал;
			КонецЕсли;
			
			Если ПараметрыФЗ.Свойство("ПолучатьРезультат") И ПараметрыОжидания.Свойство("MustReceiveResult") Тогда
				ПараметрыОжидания.MustReceiveResult = ПараметрыФЗ.ПолучатьРезультат;
			КонецЕсли;
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ОписаниеОповещенияЗавершенияФЗ", ОписаниеОповещенияЗавершенияФЗ);
			ДопПараметры.Вставить("ОписаниеОповещенияОшибкиФЗ", ОписаниеОповещенияОшибкиФЗ);
			ДопПараметры.Вставить("АдресЛогБуфераФЗ", АдресЛогБуфераФЗ);
			
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ЛокЯдро_ВыполнитьПроцедуруФоновоВыполнено", ЭтаФорма, ДопПараметры);
			
			Попытка
				МодульДлительныеОперацииКлиент.WaitForCompletion(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
			Исключение
				МодульДлительныеОперацииКлиент.WaitCompletion(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания); // ERP WE
			КонецПопытки;
			
		КонецЕсли;
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
	#КонецЕсли
	
КонецПроцедуры

// Запускает метод обработки в фоновом задании через ДлительныеОперации или
// TimeConsumingOperations. Переупаковывает АдресаПеременных в структуру
// ЗначенияПеременных (ФЗ выполняется в отдельном сеансе и адреса временного
// хранилища там недоступны). Для связи серверного потока ФЗ с родительским
// клиентским потоком передаёт кэш логирования в ЗначенияПеременных.
//
// Параметры:
//  ПараметрыФЗ    - Структура - параметры запуска фонового задания, возможные свойства:
//   * ПараметрыМетода - Структура - параметры метода, должны содержать АдресаПеременных.
//   * ИмяМетода       - Строка - имя выполняемого метода модуля объекта.
//   * НаименованиеФЗ  - Строка - наименование фонового задания.
//  КэшЛогирования - Структура - см. ЛокЯдро_Логирование_ПеренестиКэшЛогированияНаСервер.
//                 - Неопределено - кэш логирования не передаётся.
//
// Возвращаемое значение:
//  Структура - результат запуска фонового задания, см. ДлительныеОперации.ВыполнитьВФоне
//              или TimeConsumingOperations.ExecuteInBackground.
//
&НаСервере
Функция ЛокЯдро_НачатьВыполнениеФоновогоЗаданияНаСервере(ПараметрыФЗ, КэшЛогирования = Неопределено)

	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
				
		ЭтоВнешняяОбработка = ЛокЯдро_ЭтоВнешняяОбработка();
		ИмяОбработки = ?(ЭтоВнешняяОбработка, ХранениеФайлаОбработки, ИмяОбъекта);
		
		ПараметрыМетода = ПараметрыФЗ.ПараметрыМетода;
		Если ТипЗнч(ПараметрыМетода) = Тип("Структура") И
			ПараметрыМетода.Свойство("АдресаПеременных") Тогда
			// Скопируем в новую структуру, чтобы не возращать на клиент значения, которые там не доступны
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "СкопироватьСтруктуру");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("СтруктураИсточник", ПараметрыМетода));
			
			КопияПараметрыМетода = ПолучитьИзВременногоХранилища(Транзит_ВызватьГлобальныйМетодНаСервере(ПоместитьВоВременноеХранилище(СтруктураВызова)));
			
			пАдресаПеременных = КопияПараметрыМетода.АдресаПеременных;

			// ФЗ запускается в другом сеансе, поэтому значения переменных из АдресаПеременных не будут там доступны
			// Создадим новую структуру, в которой будут не адреса во врем хранилище, а сами значения
			ЗначенияПеременных = Новый Структура;
			Для Каждого ЭлементАдресовПеременных Из пАдресаПеременных Цикл
				
				КлючЭлемента = ЭлементАдресовПеременных.Ключ;
				
				// TODO. Реализовать универсально. Параметры ФЗ не поддерживают сериализацию
				Если КлючЭлемента = "ИнтеграционнаяОбработка" Тогда
					
					Значение = ПолучитьИзВременногоХранилища(ЭлементАдресовПеременных.Значение);
					КопияЗначение = Неопределено;
					
					Если ТипЗнч(Значение) = Тип("Структура") И
						Значение.Свойство("ИнтеграционнаяОбработка") Тогда
						
						// Скопируем структуру, т.к. будет удалять из нее элементы
						СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("СтруктураИсточник", Значение));
						
						КопияЗначение = ПолучитьИзВременногоХранилища(Транзит_ВызватьГлобальныйМетодНаСервере(ПоместитьВоВременноеХранилище(СтруктураВызова)));

						// Удалим ключ ИнтеграционнаяОбработка, т.к. в нем может содержаться значение типа ВнешняяОбработкаОбъект,
						// которое не сериализуется, и поэтому не может быть передано в качестве параметра в фон задание
						// В фон задании ИО будет подключаться из значения ИнтеграционнаяОбработкаДвоичныеДанные
						КопияЗначение.Удалить("ИнтеграционнаяОбработка");
					КонецЕсли;
					
					АдресЗначенияПеременной = ?(ЗначениеЗаполнено(КопияЗначение), КопияЗначение, Значение);
										
				ИначеЕсли КлючЭлемента = "COMЧастнойБазыMS" Или
					КлючЭлемента = "COMВременнойБазыMS" Или
					КлючЭлемента = "COMБазыMS" Тогда
					// Удаляем данные ключи, т.к. в них могут содержаться несериализуемые значения
					АдресЗначенияПеременной = Неопределено;
				ИначеЕсли КлючЭлемента = "КОМсоздан" Тогда
					АдресЗначенияПеременной = Ложь;	
				Иначе
					АдресЗначенияПеременной = ЭлементАдресовПеременных.Значение;
				КонецЕсли;		

				ЗначенияПеременных.Вставить(КлючЭлемента, 
					?(ЭтоАдресВременногоХранилища(АдресЗначенияПеременной), ПолучитьИзВременногоХранилища(АдресЗначенияПеременной), АдресЗначенияПеременной));
			КонецЦикла;
			
			// <Лог>
			Если КэшЛогирования <> Неопределено Тогда
				Для Каждого КлючЗначение Из КэшЛогирования Цикл
					ЗначенияПеременных.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЦикла;
			КонецЕсли;
			// </Лог>
			
			ЗначенияПеременных.Вставить("ЭтоФоновоеЗадание", Истина);
			КопияПараметрыМетода.Вставить("ЗначенияПеременных", ЗначенияПеременных);

			ПараметрыМетода = КопияПараметрыМетода;
		КонецЕсли;
		
		Если ЛокЯдро_ОбщийМодульСуществует("ДлительныеОперации") Тогда
			
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("ИмяОбработки",					ИмяОбработки);
			ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", 	ОбъектСсылка);
			ПараметрыЗадания.Вставить("ИмяМетода",						ПараметрыФЗ.ИмяМетода);
			ПараметрыЗадания.Вставить("ПараметрыВыполнения",			ПараметрыМетода);
			ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка",			ЭтоВнешняяОбработка);
			
			МодульДлительныеОперации = ЛокЯдро_ОбщийМодульНаСервере("ДлительныеОперации");
			
			ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
			ПараметрыВыполнения.НаименованиеФоновогоЗадания = ПараметрыФЗ.НаименованиеФЗ;
			
			Если ПараметрыВыполнения.Свойство("ЗапуститьВФоне") Тогда
				// Принудительный запуск ФЗ в файловых базах
				ПараметрыВыполнения.ЗапуститьВФоне = Истина;
			КонецЕсли;
			
			ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки"; // Выполняем процедуру из модуля объекта
			Возврат МодульДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
			
		ИначеЕсли ЛокЯдро_ОбщийМодульСуществует("TimeConsumingOperations") Тогда
			
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("DataProcessorName",					ИмяОбработки);
			ПараметрыЗадания.Вставить("AdditionalDataProcessorRef", 	ОбъектСсылка);
			ПараметрыЗадания.Вставить("MethodName",						ПараметрыФЗ.ИмяМетода);
			ПараметрыЗадания.Вставить("ExecutionParameters",			ПараметрыМетода);
			ПараметрыЗадания.Вставить("IsExternalDataProcessor",			ЭтоВнешняяОбработка);
			
			МодульДлительныеОперации = ЛокЯдро_ОбщийМодульНаСервере("TimeConsumingOperations");
			
			ПараметрыВыполнения = МодульДлительныеОперации.BackgroundExecutionParameters(УникальныйИдентификатор);
			ПараметрыВыполнения.BackgroundJobDescription = ПараметрыФЗ.НаименованиеФЗ;
			
			Если ПараметрыВыполнения.Свойство("RunInBackground") Тогда
				// Принудительный запуск ФЗ в файловых базах
				ПараметрыВыполнения.RunInBackground = Истина;
			КонецЕсли;
			
			ВыполняемыйМетод = "TimeConsumingOperations.RunDataProcessorObjectModuleProcedure"; // Выполняем процедуру из модуля объекта
			Возврат МодульДлительныеОперации.ExecuteInBackground(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
			
		КонецЕсли;
		
	#КонецЕсли

КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыполнитьПроцедуруФоновоВыполнено(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьПроцедуруФоновоВыполнено";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
		
	ТекстОшибки = "";
	Выполнено = Ложь;
	
    Если Результат = Неопределено Тогда
        ТекстОшибки = "Не удалось получить результат выполнения фонового задания";
	ИначеЕсли Результат.Свойство("Статус") Тогда
		
		// Вывод накопленных сообщений из фонового задания
		Если Результат.Свойство("Сообщения")
			И ТипЗнч(Результат.Сообщения) = Тип("ФиксированныйМассив") Тогда
			
			Для каждого СообщениеПользователю Из Результат.Сообщения Цикл
				Если ТипЗнч(СообщениеПользователю) = Тип("СообщениеПользователю") Тогда
					СообщениеПользователю.Сообщить();
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если Результат.Статус = "Ошибка" Тогда
        	ТекстОшибки = Результат.ПодробноеПредставлениеОшибки;
	    ИначеЕсли Результат.Статус = "Выполнено" Тогда
			
			Выполнено = Истина;
			АдресРезультата = Результат.АдресРезультата;
			
		КонецЕсли;
		
	ИначеЕсли Результат.Свойство("Status") Тогда
		
		// Вывод накопленных сообщений из фонового задания
		Если Результат.Свойство("Messages")
			И ТипЗнч(Результат.Messages) = Тип("ФиксированныйМассив") Тогда
			
			Для каждого СообщениеПользователю Из Результат.Messages Цикл
				Если ТипЗнч(СообщениеПользователю) = Тип("СообщениеПользователю") Тогда
					СообщениеПользователю.Сообщить();
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если Результат.Status = "Error" Тогда
        	ТекстОшибки = "";
			Если Результат.Свойство("DetailedErrorPresentation") Тогда
        		ТекстОшибки = Результат.DetailedErrorPresentation;
			ИначеЕсли Результат.Свойство("DetailErrorDescription") Тогда
				ТекстОшибки = Результат.DetailErrorDescription;
			КонецЕсли;
	    ИначеЕсли Результат.Status = "Completed"
			ИЛИ Результат.Status = "Completed2" Тогда
			
			Выполнено = Истина;
			АдресРезультата = Результат.ResultAddress;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Восстановление записей лога фонового задания. 
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("АдресЛогБуфераФЗ") Тогда
		Логирование_ОбработатьЗавершениеФЗ(ТекстОшибки, ДополнительныеПараметры.АдресЛогБуфераФЗ);
	КонецЕсли;
	
	Если Выполнено Тогда
		Попытка
			Если ДополнительныеПараметры.ОписаниеОповещенияЗавершенияФЗ <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещенияЗавершенияФЗ, АдресРезультата);
			КонецЕсли;
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		КонецПопытки;
	КонецЕсли;
	
	// Удалим из кэша признак, что выполнялось фоновое задание
	Если АдресаПеременных.Свойство("ЭтоФоновоеЗадание") Тогда
		АдресаПеременных.Удалить("ЭтоФоновоеЗадание");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Если ДополнительныеПараметры.Свойство("ОписаниеОповещенияОшибкиФЗ") И
			ТипЗнч(ДополнительныеПараметры.ОписаниеОповещенияОшибкиФЗ) = Тип("ОписаниеОповещения") Тогда
			// Если есть описание оповещения обработки ошибки фз, то выполняем его
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещенияОшибкиФЗ, ТекстОшибки);
		Иначе
			// <Лог>
			ЯзСтрока = "ru = 'Ошибка выполнения фонового задания';
						|en = 'Background task execution error'; be = 'Памылка выканання фонавага задання'; es = 'Error de trabajo en segundo plano'; ka = 'ფონის დავალების შესრულების შეცდომა'; kk = 'Фондық тапсырманы орындау қатесі'; ro = 'Eroare de execuție a sarcinii de fundal'; tr = 'Arka plan işi yürütülürken hata oluştu'; uk = 'Помилка виконання фонового завдання'; uz = 'Fon vazifasini bajarishda xato'";
			ТекстСообщения = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока,, ТекстОшибки);
			// </Лог>
			
			ТекстСообщения = ТекстСообщения + ":" + Символы.ПС + ТекстОшибки;
			Сообщить(ТекстСообщения);
			
		КонецЕсли;
	КонецЕсли;		

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбработатьОшибкиПолученияДанныхДляИнициализацииВФоне(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбработатьОшибкиПолученияДанныхДляИнициализацииВФоне";
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТекстОшибки = Результат; 
	ТекстФоновыеЗаданияОтключены = НСтр("ru = 'Фоновые задания отключены.';
											|en = 'Background jobs are disabled.'; be = 'Фонавыя заданні адключаныя.'; es = 'Los trabajos en segundo plano están deshabilitados.'; ka = 'ფონური სამუშაოები გამორთულია.'; kk = 'Фондық тапсырмалар өшірілген.'; ro = 'Locurile de muncă de fundal sunt dezactivate.'; tr = 'Arka plan görevleri devre dışı bırakıldı.'; uk = 'Фонові завдання відключені.'; uz = 'Fon vazifalari o''chirilgan.'");
	ТекстПопробуйтеПовторить = НСтр("ru = 'Попробуйте повторить операцию.';
										|en = 'Try to repeat the operation.'; be = 'Паспрабуйце паўтарыць аперацыю.'; es = 'Intente repetir la operación.'; ka = 'შეეცადეთ გაიმეოროთ ოპერაცია.'; kk = 'Әрекетті қайталап көріңіз.'; ro = 'Încercați să repetați operația.'; tr = 'İşlemi tekrarlamaya çalışın.'; uk = 'Спробуйте повторити операцію.'; uz = 'Operatsiyani takrorlashga harakat qiling.'");
	ТекстОшибкаИнициализации = НСтр("ru = 'Ошибка инициализации в фоне по причине: %';
										|en = 'Initialization error in the background due to: %'; be = 'Памылка ініцыялізацыі ў фоне па прычыне: %'; es = 'Error de inicialización en el fondo debido a: %'; ka = 'ინიციალიზაციის შეცდომა ფონზე იმის გამო, რომ: %'; kk = 'Себеп бойынша фонда инициализация қатесі: %'; ro = 'Eroare de inițializare în fundal din cauza: %'; tr = 'Arka planda bir nedenden dolayı başlatma hatası: %'; uk = 'Помилка ініціалізації в тлі з причини: %'; uz = 'Bir sababga ko''ra fonda ishga tushirish xatosi: %'");
	ТекстОшибкаИнициализации = ТекстОшибкаИнициализации + + Символы.ПС + ТекстОшибки;
	ТекстСообщения = ТекстФоновыеЗаданияОтключены + ТекстПопробуйтеПовторить + Символы.ПС + ТекстОшибкаИнициализации;
	
	ДоступноВыполнениеВФоне = Ложь;
	КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", ДоступноВыполнениеВФоне);
	
	Сообщить(ТекстСообщения);
	
	// <Лог>
	ЛогОшибка(логСобытие, ТекстСообщения);
	// </Лог>
	
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		"ОшибкиФоновойИнициализации", 
		"", 
		ИмяСобытия);
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицыВФоне(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицыВФоне";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТекстОшибки = Символы.ПС + Результат;
	ИмяТаблицы 	= ДополнительныеПараметры.ИмяТаблицы;
	
	ЭлементСписка = СписокТаблицВыгружаемыхВФоне.НайтиПоЗначению(ИмяТаблицы);
	Если ЭлементСписка <> Неопределено Тогда
		СписокТаблицВыгружаемыхВФоне.Удалить(ЭлементСписка);
	КонецЕсли;
	
	ЯзСтрока = "ru = 'Ошибка выгрузки таблицы [%1] в фоне по причине: %2';
				|en = 'Error uploading the table [%1] in the background due to: %2';
				|be = 'Памылка выгрузкі табліцы [%1] у фоне па прычыне: %2'; es = 'Error al cargar la tabla [%1] en el fondo debido a: %2'; ka = 'შეცდომა ატვირთვა მაგიდა [%1] ფონზე გამო: %2'; kk = 'Кестені жүктеу қатесі [%1] себеппен: %2'; ro = 'Eroare la încărcarea tabelului [%1] în fundal din cauza: %2'; tr = 'Tabloyu [%1] arka planda şu nedenden dolayı boşaltma hatası: %2'; uk = 'Помилка вивантаження таблиці [%1] в тлі з причини: %2'; uz = 'Jadvalni yuklash xatosi [%1] fonda: %2'";
	ТекстСообщения = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяТаблицы, ТекстОшибки);

	Сообщить(ТекстСообщения);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы",
		ИмяТаблицы);
	ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока, логКонтекст, ТекстОшибки);
	
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицВФоне(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицВФоне";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТекстОшибки = Символы.ПС + Результат;
	
	СписокТаблицВыгружаемыхВФоне.Очистить();
	
	ЯзСтрока = "ru = 'Ошибка выгрузки таблиц в фоне по причине: %1';
				|en = 'Error uploading tables in the background due to: %1'; be = 'Памылка выгрузкі табліц у фоне па прычыне: %1'; es = 'Error al cargar tablas en el fondo por: %1'; ka = 'შეცდომა ატვირთვა მაგიდები ფონზე გამო: %1'; kk = 'Фонда кестелерді жүктеу қатесі: % 1'; ro = 'Eroare la încărcarea tabelelor în fundal din cauza: %1'; tr = 'Arka planda tabloların yüklenmesinde bir nedenden dolayı hata oluştu: %1'; uk = 'Помилка вивантаження таблиць в тлі з причини: %1'; uz = 'Fonda jadvallarni yuklashda xatolik: %1'";
	ТекстСообщения = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), ТекстОшибки);

	Сообщить(ТекстСообщения);
	// <Лог>
	ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока,, ТекстОшибки);
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СписокТаблицВыгружаемыхВФоне.Очистить();
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
		
		ВремМассивСтрок = Новый Массив;
		
		ТекстВыгружено = НСтр("ru = 'Выгружено';
								|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'");
		ТекстОшибка = НСтр("ru = 'Ошибка';
							|en = 'Mistake'; be = 'Памылка'; es = 'Error'; ka = 'შეცდომა'; kk = 'Қате'; ro = 'Greșeală'; tr = 'Hata'; uk = 'Помилка'; uz = 'Xato'");
		ТекстНеВыгружено = НСтр("ru = 'Не выгружено (пустой справочник)';
									|en = 'Not uploaded (empty directory)'; be = 'Не выгружана (пусты даведнік)'; es = 'No descargado (directorio vacío)'; ka = 'არ არის ატვირთული (ცარიელი დირექტორია)'; kk = 'Жүктелмеген (бос анықтамалық)'; ro = 'Nu este încărcat (director gol)'; tr = 'Yüklenmemiş (boş referans)'; uk = 'Не вивантажено (порожній довідник)'; uz = 'Yuklanmagan (bo''sh katalog)'");	
		
		Для каждого ЭлементРезультата Из СтруктураРезультата Цикл
			
			ИмяТаблицыПредставление = Неопределено;
			Если Не ЭлементРезультата.Свойство("ИмяТаблицыПредставление", ИмяТаблицыПредставление) Тогда
				ИмяТаблицыПредставление = ЭлементРезультата.ИмяСправочника;
			КонецЕсли;
				
			ВремМассивСтрок.Добавить(Символы.ПС + ИмяТаблицыПредставление + " - ");
			Если ЭлементРезультата.Результат.Статус = Истина Тогда
				СтрокаСтатуса = Новый ФорматированнаяСтрока(ТекстВыгружено,, WebЦвета.Зеленый);
			ИначеЕсли  ЭлементРезультата.Результат.Статус = Ложь И Лев(ЭлементРезультата.Результат.Сообщение,31) = "Не выгружено (пустой справочник" Тогда
				 СтрокаСтатуса = Новый ФорматированнаяСтрока(ТекстНеВыгружено,, WebЦвета.ОранжевоКрасный);
			Иначе
				СтрокаСтатуса = Новый ФорматированнаяСтрока(ТекстОшибка, Новый Шрифт(,, Истина), WebЦвета.Красный);
			КонецЕсли;
				
			ВремМассивСтрок.Добавить(СтрокаСтатуса);
						
		КонецЦикла;
		
		ТекстПодробности = НСтр("ru = 'Подробности смотрите в';
									|en = 'For more information, see'; be = 'Падрабязнасці глядзіце ў'; es = 'Ver detalles en'; ka = 'დამატებითი ინფორმაციისთვის იხილეთ'; kk = 'Толығырақ мына жерден қараңыз'; ro = 'Pentru mai multe informații, a se vedea'; tr = 'Ayrıntılar için şuraya bakın:'; uk = 'Подробиці дивіться в'; uz = 'Tafsilotlar uchun qarang'");
		ТекстПодробностиВЖР = НСтр("ru = 'журнале регистрации';
									|en = 'the registration log'; be = 'журнале рэгістрацыі'; es = 'registro'; ka = 'სარეგისტრაციო ჟურნალი'; kk = 'тіркеу журналы'; ro = 'Jurnalul de înregistrare'; tr = 'kayıt defterine'; uk = 'журналі реєстрації'; uz = 'ro''yxatga olish jurnali'");
		ВремМассивСтрок.Добавить(Символы.ПС + Символы.ПС + ТекстПодробности + " ");
		
		Если ЛокЯдро_ПроверкаСуществованияОбработкиЖурналРегистрации() Тогда
			СсылкаЖР = "e1cib/app/Обработка.ЖурналРегистрации";
			ВремМассивСтрок.Добавить(Новый ФорматированнаяСтрока(ТекстПодробностиВЖР,,,, СсылкаЖР));
		Иначе
			ВремМассивСтрок.Добавить(ТекстПодробностиВЖР);
		КонецЕсли;		
		
		РезультатСообщение = Новый ФорматированнаяСтрока(ВремМассивСтрок);
		
		АвтотестКлеверенс = ДополнительныеПараметры.АвтотестКлеверенс;
		
		// Предупреждение блокирует клиент и не дает принудительно закрыть после завершения выгрузки
		Если АвтотестКлеверенс Тогда
			Сообщить(Строка(РезультатСообщение)); 
		Иначе
			ТекстЗаголовка = НСтр("ru = 'Результат выгрузки';
									|en = 'The result of the upload'; be = 'Вынік выгрузкі'; es = 'Resultado de la descarga'; ka = 'ატვირთვის შედეგი'; kk = 'Түсіру нәтижесі'; ro = 'Rezultatul încărcării'; tr = 'Boşaltma sonucu'; uk = 'Результат вивантаження'; uz = 'Tushirish natijasi'");
			ПоказатьПредупреждение(, РезультатСообщение,, ТекстЗаголовка); 
		КонецЕсли;
		
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЛокЯдро_ПроверкаСуществованияОбработкиЖурналРегистрации()
	
	Возврат Метаданные.Обработки.Найти("ЖурналРегистрации") <> Неопределено;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне(ИмяТаблицы = Неопределено) Экспорт
	
	ЗапущенаВыгрузкаТаблицыВФоне = Ложь;
	
	Если ИмяТаблицы = Неопределено Тогда
		// Проверяем, что запущена выгрузка любой таблицы
		ЗапущенаВыгрузкаТаблицыВФоне = СписокТаблицВыгружаемыхВФоне.Количество() > 0;
	Иначе
		ЗапущенаВыгрузкаТаблицыВФоне = СписокТаблицВыгружаемыхВФоне.НайтиПоЗначению(ИмяТаблицы) <> Неопределено;
	КонецЕсли;
	
	Возврат ЗапущенаВыгрузкаТаблицыВФоне;

КонецФункции

&НаКлиенте
Процедура ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФоне(ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФоне";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДоступнаПроверкаОшибок = РасположениеКомпоненты = "НаСервере";
	
	Если ДоступнаПроверкаОшибок Тогда
		
		ПроверяемыеПрава = Новый Структура("АдминистрированиеДанных, ЖурналРегистрации");
		ЛокЯдро_ПроверитьПраваДоступа(ПроверяемыеПрава);
		
		ДоступнаПроверкаОшибок = ПроверяемыеПрава.АдминистрированиеДанных = Истина ИЛИ ПроверяемыеПрава.ЖурналРегистрации = Истина;
		
	КонецЕсли;
	
	Если НЕ ДоступнаПроверкаОшибок Тогда
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_НеЗапрашиватьОтправкуОшибокНаСерверКачества") = Истина
		ИЛИ ЛокЯдро_СерверКачества_ПроверитьДоступностьСервера() = Ложь Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДатаСледующегоОбращения = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_ДатаСледующегоОбращения");
	ОтложитьПроверкуНаДату 	= ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_ОтложитьПроверкуНаДату");
	
	ДатаТекущейПроверки = НачалоДня(ТекущаяДата());
	
	НеДоступноВыполнение = (ТипЗнч(ДатаСледующегоОбращения) = Тип("Дата") И ДатаСледующегоОбращения > ДатаТекущейПроверки)
								ИЛИ (ТипЗнч(ОтложитьПроверкуНаДату) = Тип("Дата") И ОтложитьПроверкуНаДату > ДатаТекущейПроверки);
	Если НеДоступноВыполнение Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;

	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ГлубинаОтбора", 3);
	ПараметрыМетода.Вставить("СрокДоСледующейПроверки", 7);
	ПараметрыМетода.Вставить("ДатаТекущейПроверки", ДатаТекущейПроверки);
	ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);

	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ИмяМетода", 				"ГлЯдро_СерверКачества_НачатьПроверкуОшибок");
	ПараметрыФЗ.Вставить("ПараметрыМетода", 		ПараметрыМетода);		
	ПараметрыФЗ.Вставить("НаименованиеФЗ",			"Проверка ошибок ТСД");
	ПараметрыФЗ.Вставить("ТекстСообщения", 			"Проверка ошибок ТСД");
	ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 	Ложь);
	ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 	Ложь);
	ПараметрыФЗ.Вставить("ЗапускВФоне", 			Истина);
	
	ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеЗавершение", ЭтаФорма, ДополнительныеПараметры);
	ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеОшибка", 	ЭтаФорма, ДополнительныеПараметры);

	ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
		
		Если СтруктураРезультата.ЕстьОшибки Тогда
			ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибках(СтруктураРезультата);
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Проверка ошибок в фоне успешно выполнена.';
							|en = 'Background error checking has been completed successfully.'; be = 'Праверка памылак у фоне паспяхова выканана.'; es = 'La comprobación de errores en segundo plano se realizó correctamente.'; ka = 'ფონის შეცდომის შემოწმება წარმატებით დასრულდა.'; kk = 'Фонда қателерді тексеру сәтті аяқталды.'; ro = 'Verificarea erorilor de fundal a fost finalizată cu succes.'; tr = 'Arka plandaki hataları kontrol etmek başarıyla gerçekleştirildi.'; uk = 'Перевірка помилок в тлі успішно виконана.'; uz = 'Orqa fonda xatolarni tekshirish muvaffaqiyatli yakunlandi.'");
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеОшибка(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФонеОшибка";
	
	ТекстОшибки = Результат;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	
	
	// <Лог>
	ЯзСтрока = "ru = 'Ошибка проверки ошибок в фоне по причине:%1%2';
							|en = 'Background error checking error due to: %1%2'; be = 'Памылка праверкі памылак у фоне па прычыне:%1% 2'; es = 'Error de comprobación de errores de fondo debido a:%1% 2'; ka = 'ფონის შეცდომის შემოწმების შეცდომა გამო: %1% 2'; kk = 'Фондағы қателерді тексеру қатесі:%1% 2'; ro = 'Eroare de fundal eroare de verificare din cauza: %1% 2'; tr = 'Arka planda bir nedenden dolayı hata kontrolü hatası:%1%2'; uk = 'Помилка перевірки помилок в тлі з причини:%1%2'; uz = 'Fonda xatolarni tekshirish xatosi:%1%2'";
	ТекстСообщения = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), Символы.ПС, ТекстОшибки);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТекстОшибки",
		ТекстОшибки);
	ЛогОшибка(логСобытие, ТекстСообщения, ЯзСтрока, логКонтекст);
	
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибках(ПараметрыПроверки) Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда      
		ФормаСлужебная_ОтправитьОтчетОбОшибках = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСлужебная_ОтправитьОтчетОбОшибках",ЭтаФорма);
	#Иначе
		ФормаСлужебная_ОтправитьОтчетОбОшибках = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ОтправитьОтчетОбОшибках", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ОтправитьОтчетОбОшибках.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибкахЗавершение", ЭтаФорма, ПараметрыПроверки);
	
	ФормаСлужебная_ОтправитьОтчетОбОшибках.ЗакрыватьПриЗакрытииВладельца 		= Истина;
	ФормаСлужебная_ОтправитьОтчетОбОшибках._ЛокКонтекст 						= ЭтаФорма;
	ФормаСлужебная_ОтправитьОтчетОбОшибках.ОписаниеОповещенияОЗакрытии 			= ОписаниеОповещения;
	ФормаСлужебная_ОтправитьОтчетОбОшибках.ДопПараметры 						= ПараметрыПроверки;
	ФормаСлужебная_ОтправитьОтчетОбОшибках.ГлубинаОтбораОшибок					= ПараметрыПроверки.ГлубинаОтбора;
	ФормаСлужебная_ОтправитьОтчетОбОшибках.РучноеФормирование					= ПараметрыПроверки.Свойство("РучноеФормирование") И ПараметрыПроверки.РучноеФормирование;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ОтправитьОтчетОбОшибках.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ОтправитьОтчетОбОшибках.Открыть();
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибкахЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибкахЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("РезультатВопроса") Тогда
		
		РезультатВопроса = Результат.РезультатВопроса;
		
		Если РезультатВопроса = "Отложить" Тогда
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("SD_ОтложитьПроверкуНаДату", ДополнительныеПараметры.ДатаТекущейПроверки + 86400*Результат.СрокДоСледующейПроверки);
			пСообщение = НСтр("ru = 'Проверка ошибок отложена на: %1 дней';
								|en = 'Error checking postponed for: %1 days'; be = 'Праверка памылак адкладзеная на: %1 дзён'; es = 'Comprobación de errores retrasada en: %1 días'; ka = 'შეცდომის შემოწმება გადაიდო: %1 დღე'; kk = 'Қателерді тексеру кейінге қалдырылды: % 1 күн'; ro = 'Verificarea erorilor amânată pentru: %1 zile'; tr = 'Hata kontrolü şu tarihe ertelendi: %1 gün'; uk = 'Перевірка помилок відкладена на: %1 днів'; uz = 'Xato tekshirilmoqda: %1 kun'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, Результат.СрокДоСледующейПроверки);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		ИначеЕсли РезультатВопроса = "БольшеНеСпрашивать" Тогда
			ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_НеЗапрашиватьОтправкуОшибокНаСерверКачества", Истина);
			пСообщение = НСтр("ru = 'Отключение запроса на проверку ошибок для сервера качества.';
								|en = 'Disabling the error checking request for the quality server.';
								|be = 'Адключэнне запыту на праверку памылак для сервера якасці.'; es = 'Deshabilitar la solicitud de comprobación de errores para el servidor de calidad.'; ka = 'გამორთვა შეცდომა შემოწმების მოთხოვნა ხარისხის სერვერზე.'; kk = 'Сапа сервері үшін қателерді тексеру сұрауын өшіру.'; ro = 'Dezactivarea cererii de verificare a erorilor pentru serverul de calitate.'; tr = 'Kalite sunucusu için hata denetimi isteğini devre dışı bırakma.'; uk = 'Відключення запиту на перевірку помилок для сервера якості.'; uz = 'Sifat serveri uchun xatolarni tekshirish so''rovini o''chirib qo''yish.'");
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Функция ЛокЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер(ДанныеОбращения, РучноеФормирование = Ложь) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеОбращения,РучноеФормирование",
		ДанныеОбращения, РучноеФормирование);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСистемнуюИнформациюДляШапкиЛога");	
	СисИнфо = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	ДанныеОбращения.Вставить("ШапкаЛога", СисИнфо.ШапкаЛога);
	
	ПараметрыМетода = Новый Структура("ДанныеОбращения", ДанныеОбращения);
	
	ИмяМетода = ?(РучноеФормирование, "СерверКачества_РучноеФормированиеОтчетаОбОшибках", "СерверКачества_ОтправитьОтчетОбОшибкахНаСервер");
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 			"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		ИмяМетода);
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	СтруктураРезультата = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);
	
	Если СтруктураРезультата.ОтчетОтправлен Тогда
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_SD_ДатаСледующегоОбращения", ДанныеОбращения.ДатаТекущейПроверки + 86400*ДанныеОбращения.СрокДоСледующейПроверки);	
		ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_SD_НомерПоследнегоОбращения", СтруктураРезультата.НомерОбращения);	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураРезультата);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_СерверКачества_ПроверитьДоступностьСервера() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 			"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"СерверКачества_ПроверитьДоступностьСервера");
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);
	
КонецФункции

