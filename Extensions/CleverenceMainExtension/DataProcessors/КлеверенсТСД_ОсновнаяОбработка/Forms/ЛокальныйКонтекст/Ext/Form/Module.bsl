// Последняя стабильная версия совместимости.
// В расширении без постфикса всегда самая последняя версия совместимости.
// Если не удалось загрузить последнюю версию, то загрузим предпосленюю стабильную.
&НаКлиенте
Функция ЛокЯдро_ПолучитьСтабильныйПостфиксРасширения(ТипРасширения)

	ПараметрыМетода = Новый Структура("ТипРасширения", ТипРасширения);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСтабильныйПостфиксРасширения");
	
	ПостфиксРасширенияMain = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	Возврат ПостфиксРасширенияMain;
	
КонецФункции

// Вызывает процедуру авторизации в базе Клеверенс и возвращает токен авторизации
//
// Параметры:
//	СтруктураПодключения:
//		- Строка - строка подключения к базе Клеверенс
//		- Структура - структура подключения к базе Клеверенс
//	Логин 	- Строка - логин авторизации
//	Пароль 	- Строка - пароль авторизации
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//	ТипИнтерфейса - Строка - "REST_API", "COM"
//
// Возвращаемое значение:
//	Структура:
//		* АвторизацияТокен 		 - access-token авторизации, если тип интерфейса REST_API
//		* АвторизацияРефрешТокен - refresh-token авторизации, если тип интерфейса REST_API
//	Строка						 - access-token авторизации, если тип интерфейса COM
//	Ложь						 - авторизоваться не удалось
&НаКлиенте
Функция ЛокЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы = Неопределено, ТипИнтерфейса = Неопределено, Компонента = Неопределено, ОбновитьНастройкиВКэше = Истина) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьТокенSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Логин,Пароль,ТипБазы,ТипИнтерфейса,Компонента,ОбновитьНастройкиВКэше",
		СтруктураПодключения, Логин, Пароль, ТипБазы, ТипИнтерфейса, Компонента, ОбновитьНастройкиВКэше);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Компонента = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("СтруктураПодключения", 	СтруктураПодключения);
		ПараметрыМетода.Вставить("Логин",					Логин);
		ПараметрыМетода.Вставить("Пароль", 					Пароль);
		ПараметрыМетода.Вставить("ТипБазы", 				ТипБазы);
		ПараметрыМетода.Вставить("ТипИнтерфейса", 			ТипИнтерфейса);
		ПараметрыМетода.Вставить("ОбновитьНастройкиВКэше", 	ОбновитьНастройкиВКэше);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьТокенSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Результат = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Результат;
	Иначе
		Если ТипИнтерфейса = "REST_API" Тогда
			Результат = REST_API_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы, ОбновитьНастройкиВКэше);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат Результат;
		Иначе
			Результат = КомЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, Логин, Пароль, ТипБазы);
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, ТокеныАвторизации, ТипБазы = Неопределено, ТипИнтерфейса = Неопределено,
	ОбновитьНастройкиВХранилище = Истина, REST_API_session = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьТокеныВПараметрахПодключения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключения,ТокеныАвторизации,ТипБазы,ТипИнтерфейса,ОбновитьНастройкиВХранилище,REST_API_session",
		СтрокаПодключения, ТокеныАвторизации, ТипБазы, ТипИнтерфейса, ОбновитьНастройкиВХранилище, REST_API_session);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Access_token  = ТокеныАвторизации.Access_token;
	Refresh_token = ТокеныАвторизации.Refresh_token;

	// 1. Хранилище настроек пользователя Cleverence_ПараметрыПодключенияMS и локальный кэш ПараметрыПодключенияMS
	
	Если ОбновитьНастройкиВХранилище Тогда
		ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
		Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
			ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") И ПараметрыПодключенияMS.Свойство("СтрокаПодключения")
			И ЛокЯдро_СтрокиПодключенияСовпадают(ПараметрыПодключенияMS.СтрокаПодключения, СтрокаПодключения) Тогда
				
			ПараметрыПодключенияMS.Вставить("АвторизацияТокен", 	  Access_token);
			ПараметрыПодключенияMS.Вставить("АвторизацияРефрешТокен", Refresh_token);
			
			ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
		КонецЕсли;
	КонецЕсли;
	
	// 2. Локальный кэш СтруктураПодключенияБазыMS
	
	Если ТипИнтерфейса = Неопределено Тогда
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
	КонецЕсли;
		
	Если ТипИнтерфейса = Неопределено Тогда
		ТипИнтерфейса = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	КонецЕсли;
	
	Если ТипБазы = Неопределено Тогда
		ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
		
		ТипБазы = ?(ЕстьЧастнаяБаза = Истина, "Частная", "Основная");	
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда
		КлючПеременной = "REST_API_" + КлючПеременной;
	КонецЕсли;
		
	СтруктураПодключенияБазыMS = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
		
	Если ТипЗнч(СтруктураПодключенияБазыMS) = Тип("Структура") И СтруктураПодключенияБазыMS.Свойство("СтрокаПодключения")
		И ЛокЯдро_СтрокиПодключенияСовпадают(СтруктураПодключенияБазыMS.СтрокаПодключения, СтрокаПодключения) Тогда
		СтруктураПодключенияБазыMS.Вставить("АвторизацияТокен", 	  Access_token);
		СтруктураПодключенияБазыMS.Вставить("АвторизацияРефрешТокен", Refresh_token);
		
		КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, СтруктураПодключенияБазыMS);
	КонецЕсли;
	
	// 3. Локальный кэш API_session_[База Клеверенс]
	СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
		
	КлючПеременной = "API_session_" + REST_API_ПолучитьКлючURL(СтруктураURI);
	
	Если REST_API_session = Неопределено Тогда
		REST_API_session = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
	КонецЕсли;
		
	Если ТипЗнч(REST_API_session) = Тип("Соответствие") Тогда
		REST_API_session.Вставить("access_token",  Access_token);
		REST_API_session.Вставить("refresh_token", Refresh_token);
			
		КомЯдро_СохранитьЗначениеПеременной(КлючПеременной, REST_API_session);
	КонецЕсли;
	
	// <Лог>
	ЯзСтрока = "ru = 'Токены авторизации обновлены в параметрах подключения.
					|Строка подключения: %1
					|Тип базы: %2
					|Access_token: %3
					|Refresh_token: %4'";
	пСообщение = НСтр(ЯзСтрока);
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтрокаПодключения, ТипБазы, Access_token, Refresh_token);
	
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключения,ТокеныАвторизации,ТипБазы,ТипИнтерфейса,REST_API_session",
		СтрокаПодключения, ТокеныАвторизации, ТипБазы, ТипИнтерфейса, REST_API_session);
	ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
	// </Лог>

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПроверитьЛицензииУстройств(СтруктураМетаданных)
		
	ИмяСобытия = "ЛокЯдро_ПроверитьЛицензииУстройств";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураМетаданных",
		СтруктураМетаданных);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураМетаданных.Вставить("isDemo", 		Ложь); // По умолчанию отключим демо режим
	СтруктураМетаданных.Вставить("LightDemo", 	Ложь); 
	СтруктураМетаданных.Вставить("HardDemo", 	Ложь); 
	
	МассивУстройств = СтруктураМетаданных.УстройстваMS;
	Если Не ТипЗнч(МассивУстройств) = Тип("Массив") Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПлатформаПоддерживаетSupportUntilDate = СтруктураМетаданных.Свойство("ПлатформаПоддерживаетSupportUntilDate") И СтруктураМетаданных.ПлатформаПоддерживаетSupportUntilDate;
	СоответствиеУстройствДатам = Новый Соответствие;	
	МассивПроверяемыхУстройств = Новый Массив;
	
	ДатаТекущая = ТекущаяДата();
	Для Каждого Устройство Из МассивУстройств Цикл
		
		deviceId = Устройство.deviceId;
		Если deviceId = ""
			ИЛИ ВРЕГ(Лев(deviceId,4))= "WIN-" Тогда
			Продолжить;
		КонецЕсли;
		
		// Если не заполнено lastInfoTime, значит лицензия есть, но устройство еще не заходило
		Если НЕ ЗначениеЗаполнено(Устройство.lastInfoTime) Тогда
			Продолжить;
		КонецЕсли;
		
		// Не проверяем устройства, которые были в сети более 14 дней назад
		Попытка
			РазницаДатЧислом = ДатаТекущая - Устройство.lastInfoTime;			
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось вычислить последнее время подключения устройства с ID %1.';
								|en = 'Couldn''t calculate the last connection time of the device with ID %1. Error';
								|be = 'Не ўдалося вылічыць апошні час падлучэння прылады з ID % 1. Памылка'; es = 'No se pudo calcular la Última vez que se conectó el dispositivo con ID % 1. Error'; ka = 'ვერ გამოვთვალოთ მოწყობილობის ბოლო კავშირის დრო ID %1-ით. შეცდომა'; kk = 'Id %1 құрылғысының соңғы қосылу уақытын есептеу мүмкін болмады. Қате'; ro = 'Nu s-a putut calcula ultima dată de conectare a dispozitivului cu ID %1. Eroare'; tr = 'Cihazın kimliği %1 olan son bağlantı süresini hesaplayamadım. Hata'; uk = 'Не вдалося обчислити останнім часом підключення пристрою з ID %1. Помилка'; uz = 'Qurilmaning ID %1 bilan oxirgi ulanish vaqtini hisoblab bo''lmadi. Xato'";
			ТекстОшибки = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), deviceId);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"deviceId",
				deviceId);
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст, ИнфоОшибка);
			// </Лог>
			Продолжить;
		КонецПопытки;
		
		Если РазницаДатЧислом > 3600*24*14 Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ПлатформаПоддерживаетSupportUntilDate Тогда 		
			СоответствиеУстройствДатам.Вставить(deviceId,Новый Структура("supportAppId, supportDate", Устройство.supportAppId, Устройство.supportDate));
		Иначе
			МассивПроверяемыхУстройств.Добавить(Устройство);
		КонецЕсли;
	КонецЦикла;
		
	Если ПлатформаПоддерживаетSupportUntilDate Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьДатуОбработки");		
		ДатаОбработки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);	
	Иначе
		СтруктураДанных = ЛокЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий(МассивПроверяемыхУстройств);
		ДатаОбработки 	= СтруктураДанных.ДатаОбработки;
		СоответствиеУстройствДатам 	= СтруктураДанных.СоответствиеУстройствДатам;
	КонецЕсли;
			
	isDemo = Ложь;
		
	ТекстДляЖР = "";
	КоличествоДействующихЛицензий  = 0;
	КоличествоИстекшихЛицензий     = 0;
	Для каждого Устройство Из МассивУстройств Цикл
		ТекущаяИнформация = СоответствиеУстройствДатам.Получить(Устройство.deviceId);
		Если ЗначениеЗаполнено(ТекущаяИнформация) Тогда
			ЗаполнитьЗначенияСвойств(Устройство,ТекущаяИнформация);
			Если ЗначениеЗаполнено(ТекущаяИнформация.supportDate) 
				И ТекущаяИнформация.supportDate < ДатаОбработки Тогда
				Устройство.isDemo = Истина;
				isDemo = Истина;
				КоличествоИстекшихЛицензий = КоличествоИстекшихЛицензий + 1;								
			Иначе
				КоличествоДействующихЛицензий  = КоличествоДействующихЛицензий + 1;
			КонецЕсли;			
		КонецЕсли;
		
		ТекстДляЖР = ТекстДляЖР+"deviceId:"+Устройство.deviceId
								+"; demo:"+?(Устройство.isDemo,"true","false")
								+"; lastInfoTime:"+Формат(Устройство.lastInfoTime, "ДЛФ=Д")
								+"; supportDate:"+Формат(Устройство.supportDate, "ДЛФ=Д")
								+"; supportAppId:"+Устройство.supportAppId+Символы.ПС;
	КонецЦикла;
		
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстДляЖР);							
	
	LightDemo = Ложь;
	HardDemo = Ложь;
	Если isDemo Тогда
		Если КоличествоДействующихЛицензий > 0 Тогда 
			LightDemo = Истина;
		ИначеЕсли КоличествоИстекшихЛицензий > 0 Тогда
			HardDemo = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураМетаданных.Вставить("isDemo",    isDemo);
	СтруктураМетаданных.Вставить("LightDemo", LightDemo);
	СтруктураМетаданных.Вставить("HardDemo",  HardDemo);	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий(МассивУстройств)
	
	ИмяСобытия = "ЛокЯдро_ПолучитьДатыПоддержкиУстройствНаСервереЛицензий";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивУстройств",
		МассивУстройств);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьДатыПоддержкиУстройствНаСервереЛицензий");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("МассивУстройств, ВернутьТекстЗапроса", Новый Массив, Истина));	
	СтруктураДанных = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	ДатаОбработки 				= СтруктураДанных.ДатаОбработки;	
	ТекстЗапроса 				= СтруктураДанных.ТекстЗапроса;
	СохраненныеДанныеОЛицензиях = СтруктураДанных.СохраненныеДанныеОЛицензиях;
	ДатаПоследнейПроверки 		= СтруктураДанных.ДатаПоследнейПроверки;
	
	Если ДатаПоследнейПроверки = Неопределено Тогда
		ДатаПоследнейПроверки = Дата(1,1,1);
	КонецЕсли;
	#Область НесовместимыйКодFresh
	ОбращатьсяКСерверуЛицензий = (ТекущаяДата() - ДатаПоследнейПроверки) > 3600*24;
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//ОбращатьсяКСерверуЛицензий = Ложь;
	#КонецОбласти //СовместимыйКодFresh
	
	СоответствиеУстройствДатам = Новый Соответствие;
	
	ДатаСравнения = ТекущаяДата();	
	СтрокаИдентификаторов = "";
	
	Для Каждого Устройство Из МассивУстройств Цикл
		
		deviceId = Устройство.deviceId;		
		СохраненнаяИнформация = СохраненныеДанныеОЛицензиях.Получить(deviceId);
		
		Если ОбращатьсяКСерверуЛицензий Тогда 
			Если ЗначениеЗаполнено(СохраненнаяИнформация) 
				И СохраненнаяИнформация.supportDate > ДатаОбработки Тогда
				СоответствиеУстройствДатам.Вставить(deviceId,СохраненнаяИнформация);
			Иначе 			
				СтрокаИдентификаторов = СтрокаИдентификаторов + ?(СтрокаИдентификаторов = "","",Символы.ПС)+"<string>"+deviceId+"</string>";			
				СоответствиеУстройствДатам.Вставить(deviceId,Новый Структура("supportAppId, supportDate","",Дата(1,1,1)));
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СохраненнаяИнформация) Тогда
				СоответствиеУстройствДатам.Вставить(deviceId,СохраненнаяИнформация);
			КонецЕсли;			
		КонецЕсли;		
	КонецЦикла;
	
	#Область НесовместимыйКодFresh
	Если ЗначениеЗаполнено(СтрокаИдентификаторов) Тогда 
			
		ОтправляемыеДанные = ТекстЗапроса;
		ОтправляемыеДанные = СтрЗаменить(ОтправляемыеДанные,"%DEVICEIDS%", СтрокаИдентификаторов);
		
		Соединение = Новый HTTPСоединение(
		          "license.cleverence.ru" // сервер (хост)
		        , 8090 // порт, по умолчанию
		        , // СтруктураURI.Логин, // пользователь для доступа к серверу (если он есть)
		        , // СтруктураURI.Пароль, // пароль для доступа к серверу (если он есть)
		        , // здесь указывается прокси, если он есть
		        , 60 // таймаут в секундах, 0 или пусто - не устанавливать
		        ,  // защищенное соединение, если используется https
		    );
			
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Content-Type", "application/soap+xml");
		Заголовки.Вставить("charset", "utf-8");
		Заголовки.Вставить("SOAPAction", "http://tempuri.org/GetActualLicenseState");
		
		Запрос = Новый HTTPЗапрос("/LicenseService.asmx",Заголовки);
		Запрос.УстановитьТелоИзСтроки(ОтправляемыеДанные);
		
		ОтветПолучен = Ложь;
		Попытка
			ОтветHTTP = Соединение.ВызватьHTTPМетод("POST", Запрос);
			ОтветПолучен = Истина;
		Исключение
			
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось получить информацию о лицензиях подключенных устройств.';
						|en = 'Information about the licenses of the connected devices could not be obtained. Error: %1';
						|be = 'Не ўдалося атрымаць інфармацыю аб ліцэнзіях падлучаных прылад. Памылка: %1'; es = 'No se pudo obtener información sobre las licencias de los dispositivos conectados. Error: %1'; ka = 'დაკავშირებული მოწყობილობების ლიცენზიების შესახებ ინფორმაცია ვერ იქნა მიღებული. შეცდომა: %1'; kk = 'Қосылған құрылғылардың лицензиялары туралы ақпарат алу мүмкін болмады. Қате: %1'; ro = 'Informațiile despre licențele dispozitivelor conectate nu au putut fi obținute. Eroare: %1'; tr = 'Bağlı cihazların lisansları hakkında bilgi alınamadı. Hata: %1'; uk = 'Не вдалося отримати інформацію про ліцензії підключених пристроїв. Помилка: %1'; uz = 'Ulangan qurilmalarning litsenziyalari haqida ma''lumot olishning iloji bo''lmadi. Xato: %1'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка);
			// </Лог>
			
			ТекстОшибки = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), ПодробноеПредставлениеОшибки(ИнфоОшибка));
			Сообщить(ТекстОшибки);
			
		КонецПопытки;
		
		Если ОтветПолучен Тогда
			Попытка
				ОтветСервера = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.Системная);
			
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.УстановитьСтроку(ОтветСервера);
				
				// Чтение XML для Web подключения
				SimpleActivationCodeInfo = Новый Массив;
				ЧтениеМассива = Ложь;
				ЭлементСписка = Неопределено;
				ИмяПараметра = "";
				Пока ЧтениеXML.Прочитать() Цикл  // Линейное чтение XML
					
					ИмяОбъекта = ЧтениеXML.Имя;
					Если ИмяОбъекта <> "SimpleActivationCodeInfo" И НЕ ЧтениеМассива Тогда
						Продолжить;
					КонецЕсли;
					ЧтениеМассива = Истина;
					ТипУзла = Строка(ЧтениеXML.ТипУзла);
					
					//Определяем начало элемента
					Если ТипУзла = "Начало элемента" Тогда 
						Если ИмяПараметра = "SimpleActivationCodeInfo" Тогда
							ЭлементСписка = Новый Структура;
						КонецЕсли;
						ИмяПараметра = ИмяОбъекта;
						
						// Записываем значение параметра
					ИначеЕсли ТипУзла = "Текст" И ЭлементСписка <> Неопределено Тогда
						ЭлементСписка.Вставить(ИмяПараметра, ЧтениеXML.Значение);
						
						// Заносим структуру в массив устройств
					ИначеЕсли ТипУзла = "Конец элемента" И ИмяОбъекта = "SimpleActivationCodeInfo" Тогда
						Если ЭлементСписка <> Неопределено Тогда
							SimpleActivationCodeInfo.Добавить(ЭлементСписка);
						КонецЕсли;
						ИмяПараметра = "";
						ЭлементСписка = Неопределено;
					КонецЕсли;
					
				КонецЦикла;
				
				Попытка 
					КоличествоЛицензий  = SimpleActivationCodeInfo.Количество();
				Исключение
					массивИнформаций = Новый Массив;
					массивИнформаций.Добавить(SimpleActivationCodeInfo);
					SimpleActivationCodeInfo = массивИнформаций;
				КонецПопытки;	
				
				Для Каждого LicenseInfo Из SimpleActivationCodeInfo Цикл
					
					Если Не ЗначениеЗаполнено(LicenseInfo.SupportDate) Тогда
						Продолжить;
					КонецЕсли;
					DeviceId = LicenseInfo.DeviceId;
					ДатаПоддержки = Дата(СтрЗаменить(Лев(LicenseInfo.SupportDate,10),"-", ""));
					
					ТекущаяИнформация = СоответствиеУстройствДатам.Получить(LicenseInfo.DeviceId);
					Если ТекущаяИнформация = Неопределено 
						Или ТекущаяИнформация.supportDate < ДатаПоддержки Тогда				
						СоответствиеУстройствДатам.Вставить(DeviceId,Новый Структура("supportAppId, supportDate",LicenseInfo.AppId,ДатаПоддержки));
						СохраненныеДанныеОЛицензиях.Вставить(DeviceId,Новый Структура("supportAppId, supportDate",LicenseInfo.AppId,ДатаПоддержки));
					КонецЕсли;		
				КонецЦикла;
								
				ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДанныеУстройствMS", СохраненныеДанныеОЛицензиях);
				ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаЗапросаЛицензий", ТекущаяДата());
			Исключение
				// <Лог>
				ИнфоОшибка = ИнформацияОбОшибке();
				ЯзСтрока = "ru = 'Не удалось разобрать ответ от сервера лицензий.';
									|en = 'The response from the license server could not be parsed. Error';
									|be = 'Не ўдалося разабраць адказ ад сервера ліцэнзій. Памылка'; es = 'No se pudo analizar la respuesta del servidor de licencias. Error'; ka = 'სალიცენზიო სერვერიდან პასუხი ვერ გაიაზრა. შეცდომა'; kk = 'Лицензия серверінен жауапты талдау мүмкін болмады. Қате'; ro = 'Răspunsul de la serverul de licență nu a putut fi analizat. Eroare'; tr = 'Lisans sunucusundan gelen yanıtı ayrıştıramadım. Hata:% 1'; uk = 'Не вдалося розібрати відповідь від сервера ліцензій. Помилка'; uz = 'Litsenziya serveridan javobni ajratib bo''lmadi. Xato'";
				ТекстОшибки = НСтр(ЯзСтрока);
				
				ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка);
				// </Лог>
				
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	Результат = Новый Структура("СоответствиеУстройствДатам,ДатаОбработки",СоответствиеУстройствДатам,ДатаОбработки);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ПроверитьДемоРежим(Оповещение, ПараметрыПроверки = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПроверитьДемоРежим";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Оповещение,ПараметрыПроверки",
		Оповещение, ПараметрыПроверки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если СтруктураМетаданных.Свойство("isDemo") И СтруктураМетаданных.isDemo Тогда		
		
		ТекстПредупреждения = ЛокЯдро_ТекстДемо(ПараметрыПроверки);
		
		//Если в тексте предупреждения вернулась пустая строка, значит устройство не в демо режиме
		Если ТекстПредупреждения = "" Тогда
			ВыполнитьОбработкуОповещения(Оповещение);
		Иначе
			ДопПараметры = Новый Структура("Оповещение",Оповещение);
			ОповещениеПродолжение = Новый ОписаниеОповещения("ЛокЯдро_ПроверитьДемоРежимПродолжитьПослеПредупреждения", ЭтаФорма,ДопПараметры);
			ПоказатьПредупреждение(ОповещениеПродолжение, ТекстПредупреждения,, ЛокЯдро_ТекстВнимание());
		КонецЕсли;		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;		
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

