&НаСервере
Процедура ЛокЯдро_ЗаполнитьСсылкуНаОбъект()
	
	// Получение версии запущенной обработки
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьИнформациюОВнешнейОбработке");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("КлючИнформации", "Версия"));
	
	ПередаваемыеПараметры = Транзит_ПоместитьЗначениеВХранилищеНаСервере(СтруктураВызова);
	
	АдресРезультата = Транзит_ВызватьГлобальныйМетодНаСервере(ПередаваемыеПараметры);
	ВерсияОО = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	// Поиск осуществляется по части версии, т.к. в справочнике реквизит Версия заполнен по маске х.х.х.х
	// Выбираем самую позднюю обработку с подходящей версией
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ИмяСправочника.Ссылка) КАК Ссылка
	|ИЗ
	|	Справочник.ИмяСправочника КАК ИмяСправочника
	|ГДЕ
	|	&Версия ПОДОБНО ""%"" + ИмяСправочника.ИмяВерсия + ""%""
	|	И (ИмяСправочника.Наименование ПОДОБНО ""%Клеверенс%""
	|		ИЛИ ИмяСправочника.Наименование ПОДОБНО ""%Cleverence%"")";
	
	ИмяВерсия = "Версия";
	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		Если ЛокЯдро_ЭтоENGКонфигурация() Тогда
			ИмяВерсия = "Version";
			ИмяСправочника = "AdditionalReportsAndDataProcessors";
		Иначе
			ИмяСправочника = "ДополнительныеОтчетыИОбработки";
		КонецЕсли;
	#Иначе
		ИмяСправочника = "ВнешниеОбработки";
	#КонецЕсли
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВерсия", ИмяВерсия);
	
	Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
	Запрос.УстановитьПараметр("Версия", 		ВерсияОО);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектСсылка = Выборка.Ссылка;
	КонецЕсли;
		
КонецПроцедуры

// Возвращает структуру описания устройства МС.
// 
// Параметры:
//	deviceId - Строка - Ид устройства
//	deviceName - Строка - Имя устройства
//	lastInfoTime - Строка - Время последнего обмена устройства с сервером
//	pincode - Строка - пинкод, используется только для "легкого облака"
//
// Возвращаемое значение:
//	Структура - с заполненными или пустыми полями:
//		* deviceId - Строка - Ид устройства
//		* deviceName - Строка - Имя устройства
//		* deviceDescription - Строка - Описание устройства
//		* pincode - Строка - пинкод
//		* lastInfoTime - ДатаВремя - Время последнего обмена устройства с сервером
//		* supportDate - ДатаВремя - Дата окончания подписки на обновления
//		* isDemo - Булево - Демо режим для устройства
&НаКлиенте
Функция ЛокЯдро_СтруктураОписанияУстройстваSMARTS(deviceId = "", deviceName = "", lastInfoTime = '00010101',supportDate = '00010101', pincode ="") Экспорт
	
	deviceDescription = ?(НЕ ЗначениеЗаполнено(deviceName), deviceId, deviceName + ", (" + deviceId + ")");
	СтруктураОписания =  Новый Структура("deviceId,deviceName,deviceDescription,pincode,lastInfoTime,supportDate,supportAppId,isDemo", deviceId, deviceName, deviceDescription,pincode,lastInfoTime,supportDate,"",Ложь);

	Возврат СтруктураОписания;
КонецФункции

