									|en = 'The user ""%1"" has not been uploaded to the Cleverence database. The user with this password already exists.';
									|be = 'Карыстальнік ""%1"" ня выгружаны ў базу Cleverence. Карыстальнік з такім паролем ўжо існуе.'; es = 'El usuario ""%1 "" no se ha descargado en la base de Cleverence. El usuario con esta contraseña ya existe.'; ka = 'მომხმარებელი ""%1 "" არ არის ატვირთული Cleverence მონაცემთა ბაზაში. მომხმარებელი ამ პაროლით უკვე არსებობს.'; kk = '""%1 "" пайдаланушысы Cleverence базасына түсірілмеген. Мұндай құпия сөзі бар пайдаланушы қазірдің өзінде бар.'; ro = 'Utilizatorul ""%1 "" nu a fost încărcat în baza de date Cleverence. Utilizatorul cu această parolă există deja.'; tr = '""%1"" kullanıcısı Cleverence veritabanına yüklenmedi. Böyle bir şifreye sahip bir kullanıcı zaten var.'; uk = 'Користувач ""%1 "" не вивантажений в базу Cleverence. Користувач з таким паролем вже існує.'; uz = '""%1 "" foydalanuvchisi Cleverence bazasiga yuklanmagan. Bunday parolga ega foydalanuvchi allaqachon mavjud.'");
				Сообщение = ЛокЯдро_СтрШаблон(Сообщение, Строка(CurrentUser.Name));
				Сообщить(Сообщение); 
		    	Ответ.Результат =  Ложь;						
			КонецЕсли;	
		КонецЕсли;
		
