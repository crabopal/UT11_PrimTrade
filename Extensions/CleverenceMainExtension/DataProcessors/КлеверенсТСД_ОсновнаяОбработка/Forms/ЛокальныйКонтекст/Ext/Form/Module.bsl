	Попытка
		Результат = Метаданные.ОбщиеМодули.Найти("StandardSubsystemsServer") <> Неопределено;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ЛокальныйКонтекст_СправочникиИТаблицы

// Вызывает функции преобразования данных выгружаемой таблицы и выгрузки подготовленной таблицы на сервер Клеверенс 
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	ТаблицаДляВыгрузкиАдрес - ТаблицаЗначений, Массив из Структура, Структура - данные выгружаемой таблицы
//	ТипБазы - Строка - "Частная", "Временная", "Основная"
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы		
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицы, ТаблицаДляВыгрузкиАдрес, ТипБазы = "Основная") Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТаблицаДляВыгрузкиАдрес,ТипБазы",
		ИмяТаблицы, ТаблицаДляВыгрузкиАдрес, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Проверка на существование таблицы в конфигурации Клеверенс
	Если Не (ИмяТаблицы = "Ячейки" Или ИмяТаблицы = "Номенклатура") 
		И СтруктураМетаданных.Свойство("Tables") Тогда
		
		ТаблицыMS = СтруктураМетаданных.Tables;
		Если ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, ИмяТаблицы) = Неопределено Тогда
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова.Вставить("ИмяМетода", "ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы", ИмяТаблицы));
		СтруктураВызова.ПараметрыМетода.Вставить("ТаблицаДляВыгрузки", ТаблицаДляВыгрузкиАдрес);
		СтруктураВызова.ПараметрыМетода.Вставить("ТипБазы", ТипБазы);
		РезультатВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	Иначе
		СтруктураВызова.Вставить("ИмяМетода", "СформироватьМассивыДляВыгрузкиТаблиц");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы,ТаблицаДляВыгрузки,ТипБазы", ИмяТаблицы, ТаблицаДляВыгрузкиАдрес, ТипБазы));
		
		ПереписыватьНоменклатуруПриВыгрузке = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке");		
		ДанныеДляВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		
		Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
			ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
			ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
		Иначе
			ПараметрыВыгрузки = ЛокЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника(ИмяТаблицы, "Интерактивный");
			ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;
		КонецЕсли;		
		
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
		Если ТипИнтерфейса = "REST_API" Тогда
			РезультатВыгрузки = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой);		
		Иначе
			РезультатВыгрузки = КомЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ТипБазы, ИмяТаблицы, ДанныеДляВыгрузки, ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;		
	КонецЕсли;
	
	Сообщить(РезультатВыгрузки.Сообщение); 
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает функцию выгрузки таблицы на сервер Клеверенс для всех справочников, участвующих в интеграции
&НаКлиенте
Функция ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузкиСправочников,ДополнительныеПараметры",
		ПараметрыВыгрузкиСправочников, ДополнительныеПараметры);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыВыполнения = Новый Структура("ПараметрыВыгрузкиСправочников",ПараметрыВыгрузкиСправочников);
	Если ДополнительныеПараметры <> Неопределено Тогда
		ПараметрыВыполнения.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSПродолжение", ЭтаФорма, ПараметрыВыполнения);
	
	ПараметрыПроверки = Новый Структура("Событие", "ВыгрузкаСправочника");
	
	ЛокЯдро_ПроверитьДемоРежим(Оповещение, ПараметрыПроверки);	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSВФоне(ПараметрыВыгрузкиСправочников, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSВФоне";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузкиСправочников,ДополнительныеПараметры",
		ПараметрыВыгрузкиСправочников, ДополнительныеПараметры);
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузкаСправочников.Начало","Информация", пСообщение);
	
	ЗапущенаВыгрузкаТаблицыВФоне = ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне();
	Если ЗапущенаВыгрузкаТаблицыВФоне Тогда
		Сообщение = НСтр("ru = 'Таблицы уже выгружаются в фоне';
							|en = 'The tables are already being uploaded in the background'; be = 'Табліцы ўжо выгружаюцца ў фоне'; es = 'Las tablas ya están descargadas en el fondo'; ka = 'მაგიდები უკვე ატვირთულია ფონზე'; kk = 'Кестелер қазірдің өзінде фонда түсіріліп жатыр'; ro = 'Tabelele sunt deja încărcate în fundal'; tr = 'Tablolar zaten arka planda kaldırılıyor'; uk = 'Таблиці вже вивантажуються в тлі'; uz = 'Jadvallar allaqachon fonda Yuklanmoqda'");
		Сообщить(Сообщение); 
		Возврат Неопределено;
	КонецЕсли;
	
	//защита от параллельного запуска
	Для каждого ПараметрыВыгрузкиСправочника Из ПараметрыВыгрузкиСправочников Цикл
		Если СписокТаблицВыгружаемыхВФоне.НайтиПоЗначению(ПараметрыВыгрузкиСправочника.ИмяСправочника) = Неопределено Тогда
			СписокТаблицВыгружаемыхВФоне.Добавить(ПараметрыВыгрузкиСправочника.ИмяСправочника);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ПараметрыВыгрузкиСправочников", ПараметрыВыгрузкиСправочников);	
	ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);

	АвтотестКлеверенс = КомЯдро_ПолучитьЗначениеПеременной("Автотест");
	Если АвтотестКлеверенс = Неопределено Тогда
		АвтотестКлеверенс = Ложь;
	КонецЕсли;
	
	ПараметрыМетода.Вставить("Автотест", АвтотестКлеверенс);
	
	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ИмяМетода", 				"ГлЯдро_ВыгрузитьТаблицыНаСерверSMARTS");
	ПараметрыФЗ.Вставить("ПараметрыМетода", 		ПараметрыМетода);		
	ПараметрыФЗ.Вставить("НаименованиеФЗ",			НСтр("ru = 'Выгрузка справочников';
															|en = 'Uploading directories'; be = 'Выгрузка даведнікаў'; es = 'Descarga de manuales'; ka = 'დირექტორიების ატვირთვა'; kk = 'Анықтамалықтарды түсіру'; ro = 'Încărcarea directoarelor'; tr = 'Referans kitaplarının boşaltılması'; uk = 'Вивантаження довідників'; uz = 'Kataloglarni yuklash'"));
	ПараметрыФЗ.Вставить("ТекстСообщения", 			ПараметрыФЗ.НаименованиеФЗ);
	ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 	Истина);
	ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 	Истина);
	ПараметрыФЗ.Вставить("ИнтервалПроверкиВыполнения", 	1);
	ПараметрыФЗ.Вставить("ЗапускВФоне", 			Истина);	
	
	пДополнительныеПараметры = Новый Структура;
	пДополнительныеПараметры.Вставить("НачалоВыгрузки", 	НачалоВыгрузки);
	пДополнительныеПараметры.Вставить("АвтотестКлеверенс", АвтотестКлеверенс);
	пДополнительныеПараметры.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSЗавершение", ЭтаФорма, пДополнительныеПараметры);
	ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицВФоне", ЭтаФорма, пДополнительныеПараметры);
	
	ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSНеВФоне(ПараметрыВыгрузкиСправочников, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSНеВФоне";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузкиСправочников,ДополнительныеПараметры",
		ПараметрыВыгрузкиСправочников, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузкаСправочников.Начало","Информация", пСообщение);
	
	ЗапущенаВыгрузкаТаблицыВФоне = ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне();
	Если ЗапущенаВыгрузкаТаблицыВФоне Тогда
		Сообщение = НСтр("ru = 'Таблицы уже выгружаются в фоне';
							|en = 'The tables are already being uploaded in the background'; be = 'Табліцы ўжо выгружаюцца ў фоне'; es = 'Las tablas ya están descargadas en el fondo'; ka = 'მაგიდები უკვე ატვირთულია ფონზე'; kk = 'Кестелер қазірдің өзінде фонда түсіріліп жатыр'; ro = 'Tabelele sunt deja încărcate în fundal'; tr = 'Tablolar zaten arka planda kaldırılıyor'; uk = 'Таблиці вже вивантажуються в тлі'; uz = 'Jadvallar allaqachon fonda Yuklanmoqda'");
		Сообщить(Сообщение); 
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеНСИ = ЛокЯдро_ПолучитьМетаданныеНСИ();		
	
	АвтотестКлеверенс = КомЯдро_ПолучитьЗначениеПеременной("Автотест");
	Если АвтотестКлеверенс = Неопределено Тогда
		АвтотестКлеверенс = Ложь;
	КонецЕсли;
	
	// В Автотесте принудительно выгружаем справочники два раза: 1 раз всегда с перезаписью, второй раз с дозаписью. 
	КоличествоВыгрузок = 1;
	Если АвтотестКлеверенс Тогда
		КоличествоВыгрузок = 2;
	КонецЕсли;
	
	НастройкаКомпоновщикаСтрокой = "";
	
	НомерВыгрузки = 1;
	Пока НомерВыгрузки <= КоличествоВыгрузок Цикл
		Для Каждого ПараметрыВыгрузкиСправочника ИЗ ПараметрыВыгрузкиСправочников Цикл
			
			СправочникИмя 		= ПараметрыВыгрузкиСправочника.ИмяСправочника;
			ПараметрыВыгрузки 	= ПараметрыВыгрузкиСправочника.ПараметрыВыгрузки;
			
			Если НЕ ТипЗнч(ПараметрыВыгрузки) = Тип("Структура")
				ИЛИ НЕ ПараметрыВыгрузки.Свойство("НастройкаКомпоновщикаСтрокой", НастройкаКомпоновщикаСтрокой) Тогда
				НастройкаКомпоновщикаСтрокой = "";	
			КонецЕсли;
			
			Если АвтотестКлеверенс Тогда
				ПараметрыВыгрузки.ОчищатьПередВыгрузкой = ?(НомерВыгрузки = 1, Истина, Ложь);
			КонецЕсли;
			
			СтруктураСпособаВыгрузки = ЛокЯдро_ОпределитьСпособВыгрузкиСправочника(СправочникИмя, ПараметрыВыгрузки, МетаданныеНСИ);
			
			Если СтруктураСпособаВыгрузки.ВыгрузитьСправочник Тогда
				Если СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки <> Неопределено Тогда
					ПараметрыВыгрузки.Вставить("ПараметрыПорционнойВыгрузки", СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки);
					НастройкиКомпоновщика = "";
					Если НЕ ПустаяСтрока(НастройкаКомпоновщикаСтрокой) Тогда
						НастройкиКомпоновщика = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
					КонецЕсли;
					ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями(СправочникИмя, НастройкиКомпоновщика,, ПараметрыВыгрузки, ДополнительныеПараметры);
				Иначе
					ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS(СправочникИмя, НастройкаКомпоновщикаСтрокой,, ПараметрыВыгрузки, ДополнительныеПараметры);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		НомерВыгрузки = НомерВыгрузки + 1;
	КонецЦикла;	
	
КонецФункции

// Последовательно вызывает функции получения данных таблицы и выгрузки полученных данных на сервер Клеверенс
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//  НастройкаКомпоновщикаСтрокой - Строка - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//											обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ПараметрыВыгрузки - Структура - параметры выгрузки справочника
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, НастройкаКомпоновщикаСтрокой = "", ПараметрыКомпоновщика = Ложь, ПараметрыВыгрузки = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкаКомпоновщикаСтрокой,ПараметрыКомпоновщика,ПараметрыВыгрузки,ДополнительныеПараметры",
		ИмяТаблицы, НастройкаКомпоновщикаСтрокой, ПараметрыКомпоновщика, ПараметрыВыгрузки, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ЗапущенаВыгрузкаТаблицыВФоне = ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне(ИмяТаблицы);
	Если ЗапущенаВыгрузкаТаблицыВФоне Тогда
		Сообщение = НСтр("ru = 'Таблица [%1] уже выгружается в фоне';
							|en = 'The table [%1] is already being uploaded in the background'; be = 'Табліца [%1] ужо выгружаецца ў фоне'; es = 'La tabla [%1] ya se está descargando en el fondo'; ka = 'ცხრილი [%1] უკვე ატვირთულია ფონზე'; kk = 'Кесте [%1] қазірдің өзінде фонда түсіріліп жатыр'; ro = 'Tabelul [%1] este deja încărcat în fundal'; tr = 'Tablo [%1] zaten arka planda kaldırılıyor'; uk = 'Таблиця [%1] вже вивантажується в тлі'; uz = 'Jadval [%1] allaqachon orqa fonda Yuklanmoqda'");
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		Сообщить(Сообщение); 
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	НачалоВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'ИмяТаблицы=%1';
						|en = 'Table Name= %1'; be = 'Імятабліцы=%1'; es = 'Nombretabla = %1'; ka = 'ცხრილის სახელი= %1'; kk = 'Кесте атауы=%1'; ro = 'Numele Tabelului = %1'; tr = 'Tablo adı=%1'; uk = 'Імятабліци=%1'; uz = 'Jadvallar = %1'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузкаСправочника.Начало","Информация", пСообщение);	
	
	ВыполняетсяВФоне = ДоступноВыполнениеВФоне;
	
	// Если включено фоновое выполенние, то надо обязательно проверить не пропала ли из кэша переменная ИнтеграционнаяОбработка.ИнтеграционнаяОбработкаДвоичныеДанные
	// В случае обнуления кэша обработку надо переподключить.
	Если ВыполняетсяВФоне = Истина Тогда
		//СтруктураИО = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработка");
		Если ЛокЯдро_ПроверитьСуществованиеИнтеграционнаяОбработкаДвоичныеДанные() = Ложь Тогда
				РезультатПодключенияИО = ЛокЯдро_ПодключитьИнтеграционнуюОбработку();
				Если РезультатПодключенияИО = Ложь Тогда 
					ВыполняетсяВФоне = Ложь;
					ДоступноВыполнениеВФоне = Ложь;
				КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	Если НастройкаКомпоновщикаСтрокой = "" Тогда
		НастройкаКомпоновщикаСтрокой = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "НастройкаКомпоновщикаСтрокой");
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ОчищатьПередВыгрузкой") Тогда
		ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;		
	Иначе
		ОчищатьСправочникПередВыгрузкой = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "ОчищатьПередВыгрузкой");
    КонецЕсли;	
		
	Если ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
		НастройкиКомпоновщика = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
	КонецЕслИ;
	
	Если ПараметрыКомпоновщика = Ложь Тогда
		ПараметрыКомпоновщика = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ТипБазы") Тогда
		ТипБазы = ПараметрыВыгрузки.ТипБазы;
	Иначе		
		ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	КонецЕсли;
	
	ПереписыватьНоменклатуруПриВыгрузке 	= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке");		
	РаботаБезАлкоголя 						= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя");
	
	Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
		ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
		ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
	ИначеЕсли ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
		НастройкиОбменаСправочников_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников_ПоУмолчанию");
			
		НастройкиПоУмолчанию = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(
			НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", ИмяТаблицы);
		Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
			НастройкиПоУмолчанию.Свойство("ОчищатьПередВыгрузкой", ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;
		
		Если ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
			ОчищатьСправочникПередВыгрузкой = ?(ПереписыватьНоменклатуруПриВыгрузке = Неопределено, Ложь, ПереписыватьНоменклатуруПриВыгрузке);
		КонецЕсли;
	КонецЕсли;
		
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы", ИмяТаблицы));
	СтруктураВызова.ПараметрыМетода.Вставить("НастройкиКомпоновщика", НастройкиКомпоновщика);
	СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыКомпоновщика", ПараметрыКомпоновщика);
		
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова.Вставить("ИмяМетода", "ВыгрузитьТаблицуНаСерверSMARTS");
		СтруктураВызова.ПараметрыМетода.Вставить("ТипБазы", ТипБазы);
		СтруктураВызова.ПараметрыМетода.Вставить("ОчищатьСправочникПередВыгрузкой", 	ОчищатьСправочникПередВыгрузкой);		
		СтруктураВызова.ПараметрыМетода.Вставить("РаботаБезАлкоголя", 					РаботаБезАлкоголя);
		СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыВыгрузки", 					ПараметрыВыгрузки);
		
		Если Не ВыполняетсяВФоне Тогда
			РезультатВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
			ПодробноеСообщение = РезультатВыгрузки.Сообщение;
		Иначе
			ВыполняетсяВФоне = Истина;
			
			СтруктураВызова.ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);
			
			ТекстСообщения = НСтр("ru = 'Выгрузка таблицы [%1] в фоне'");
			ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ИмяТаблицы);
						
			ПараметрыФЗ = Новый Структура;
			ПараметрыФЗ.Вставить("ИмяМетода", 				"ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФоне");
			ПараметрыФЗ.Вставить("ПараметрыМетода", 		СтруктураВызова.ПараметрыМетода);		
			ПараметрыФЗ.Вставить("НаименованиеФЗ",			ТекстСообщения);
			ПараметрыФЗ.Вставить("ТекстСообщения", 			ТекстСообщения);
			ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 	Ложь);
						
			пДополнительныеПараметры = Новый Структура;
			пДополнительныеПараметры.Вставить("ИмяТаблицы", 		ИмяТаблицы);
			пДополнительныеПараметры.Вставить("НачалоВыгрузки", 	НачалоВыгрузки);
			пДополнительныеПараметры.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
			ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФонеЗавершение", ЭтаФорма, пДополнительныеПараметры);
			ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицыВФоне", ЭтаФорма, пДополнительныеПараметры);
			
			Сообщить(ТекстСообщения); 
			СписокТаблицВыгружаемыхВФоне.Добавить(ИмяТаблицы);
			
			ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
		КонецЕсли;
	Иначе
		ВыполняетсяВФоне = Ложь;
		
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивыТаблицыДляВыгрузкиНаСерверSMARTS");
		СтруктураВызова.ПараметрыМетода.Вставить("РаботаБезАлкоголя", 	РаботаБезАлкоголя);
		СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыВыгрузки", 	ПараметрыВыгрузки);
		СтруктураВызова.ПараметрыМетода.Вставить("ТипБазы", 			ТипБазы);
		
		// *****************************************************************************************************************************
		
		НачалоПолученияДанныхИз1С 		= ТекущаяДата();
		
		ДанныеДляВыгрузки 				= Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);			
		
		Если (ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив") и ДанныеДляВыгрузки.Количество() = 0) ИЛИ (ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура") и ДанныеДляВыгрузки.МассивыСтрок.Количество() = 0) Тогда
			Сообщение = НСтр("ru = 'Не выгружено (пустой справочник[%1])';
								|en = 'Not uploaded (empty directory[%1])'; be = 'Ня выгружана (пусты даведнік [%1])'; es = 'No descargado (referencia vacía[%1])'; ka = 'არ არის ატვირთული (ცარიელი დირექტორია[%1])'; kk = 'Жүктелмеген (бос анықтамалық[%1])'; ro = 'Nu este încărcat (director gol[%1])'; tr = 'Yüklenmemiş (boş dizin[%1])'; uk = 'Не вивантажено (порожній довідник[%1])'; uz = 'Yuklanmagan (bo''sh katalog[%1])'");	
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
			Сообщить(Сообщение);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		Если ДанныеДляВыгрузки = Неопределено Тогда
			Сообщение = НСтр("ru = 'Не удалось получить данные для выгрузки таблицы [%1]. Подробности смотрите в журнале регистрации';
								|en = 'Couldn''t get the data to upload the table [%1]. See the registration log for details';
								|be = 'Не атрымалася атрымаць дадзеныя для выгрузкі табліцы [%1]. Падрабязнасці глядзіце ў часопісе рэгістрацыі'; es = 'No se pudieron recuperar los datos para la descarga de la tabla [%1]. Consulte el registro para más detalles'; ka = 'ვერ მოხერხდა მონაცემების ატვირთვა ცხრილში [%1]. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალი'; kk = 'Кестені жүктеу үшін деректерді алу мүмкін болмады [%1]. Мәліметтерді тіркеу журналынан қараңыз'; ro = 'Nu s-au putut obține datele pentru a încărca tabelul [%1]. Consultați jurnalul de înregistrare pentru detalii'; tr = '[%1] tablosunu boşaltmak için veri alınamadı. Ayrıntılar için kayıt defterine bakın'; uk = 'Не вдалося отримати дані для вивантаження таблиці [%1]. Подробиці дивіться в журналі реєстрації'; uz = 'Jadvalni yuklash uchun ma''lumotlar olinmadi [%1]. Tafsilotlar uchun jurnalga qarang'");
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
			Сообщить(Сообщение); 
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		ОкончаниеПолученияДанныхИз1С 	= ТекущаяДата();
		ВремяПолученияДанныхИз1С 		= ОкончаниеПолученияДанныхИз1С - НачалоПолученияДанныхИз1С;
		
		// *****************************************************************************************************************************
		
		НачалоВыгрузкиДанныхНаСерверSMARTS = ТекущаяДата();
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы); 
		Если ТипИнтерфейса = "REST_API" Тогда
			РезультатВыгрузки = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой);
		Иначе
			РезультатВыгрузки = КомЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ТипБазы, ИмяТаблицы, ДанныеДляВыгрузки, ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;
		
		ОкончаниеВыгрузкиДанныхНаСерверSMARTS 	= ТекущаяДата();
		ВремяВыгрузкиДанныхНаСерверSMARTS		= ОкончаниеВыгрузкиДанныхНаСерверSMARTS - НачалоВыгрузкиДанныхНаСерверSMARTS;
		
		ОбщееВремяВыгрузки						= ВремяПолученияДанныхИз1С + ВремяВыгрузкиДанныхНаСерверSMARTS; 
		
		// *****************************************************************************************************************************
		
		ПодробноеСообщение = РезультатВыгрузки.Сообщение;
		
		// Если выгрузка прошла успешно, добавляем в сообщение дополнительную информацию о выгрузке
		Если РезультатВыгрузки.Статус Тогда									
			
			ПредставлениеВремени1С 		= ЛокЯдро_ПредставлениеВремени(ВремяПолученияДанныхИз1С);
			ПредставлениеВремениMS 		= ЛокЯдро_ПредставлениеВремени(ВремяВыгрузкиДанныхНаСерверSMARTS);
			ПредставлениеВремениОбщее 	= ЛокЯдро_ПредставлениеВремени(ОбщееВремяВыгрузки);			
			
			ПодробноеСообщение = ЛокЯдро_СформироватьПодробноеСообщениеОВыгрузкеТаблицы(ПодробноеСообщение, ПредставлениеВремениОбщее, ПредставлениеВремени1С, ПредставлениеВремениMS);
			
		КонецЕсли;			
		
	КонецЕсли;		
	
	Если Не ВыполняетсяВФоне Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РезультатВыгрузки", 	РезультатВыгрузки);
		СтруктураПараметров.Вставить("ПодробноеСообщение", 	ПодробноеСообщение);
		СтруктураПараметров.Вставить("ИмяТаблицы", 			ИмяТаблицы);
		СтруктураПараметров.Вставить("НачалоВыгрузки", 		НачалоВыгрузки);
		
		ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSЗавершение(СтруктураПараметров);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Выгружает на сервер Клеверенс данные таблицы порциями. Работает только для справочника "Номенклатура"
// Некорректен с точки зрения инкапсуляции - в одном методе смешался функционал получения данных из базы 1С и функционал выгрузки данных в Клеверенс
// Это вынужденная реализация, потому что методы "TerminalConnector.НачатьВыгрузкуТоваров()" и "TerminalConnector.ЗавершитьВыгрузкуТоваров()"
// можно вызывать только по 1 разу во время всего процесса выгрузки справочника номенклатуры
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ПараметрыВыгрузки - Структура - параметры выгрузки справочника
//
// Возвращаемое значение:
//	Структура - содержит:
//		* Статус - Булево - признак успешности выгрузки таблицы
//		* Сообщение - Строка - информационное сообщение о результате выгрузки таблицы
&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями(ИмяТаблицы, НастройкиКомпоновщика = "", ПараметрыКомпоновщика = Ложь, ПараметрыВыгрузки = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциями";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,ПараметрыВыгрузки,ДополнительныеПараметры",
		ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ПараметрыВыгрузки, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыПорционнойВыгрузки = Неопределено;
	ПараметрыВыгрузки.Свойство("ПараметрыПорционнойВыгрузки", ПараметрыПорционнойВыгрузки);
	
	Если ПараметрыПорционнойВыгрузки = Неопределено Тогда
		СтруктураСпособаВыгрузки = ЛокЯдро_ОпределитьСпособВыгрузкиСправочника(ИмяТаблицы, ПараметрыВыгрузки);
		ПараметрыПорционнойВыгрузки = СтруктураСпособаВыгрузки.ПараметрыПорционнойВыгрузки;
		ПараметрыВыгрузки.Вставить("РазмерПорции", СтруктураСпособаВыгрузки.РазмерПорции);
		ПараметрыВыгрузки.Вставить("ПараметрыПорционнойВыгрузки", ПараметрыПорционнойВыгрузки);
	КонецЕсли;
	
	Если ПараметрыПорционнойВыгрузки = Неопределено Тогда
		ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ,, ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	Иначе
		РазмерПорции = ПараметрыПорционнойВыгрузки.РазмерПорции;
	КонецЕсли;
	
	ЗапущенаВыгрузкаТаблицыВФоне = ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне(ИмяТаблицы);
	Если ЗапущенаВыгрузкаТаблицыВФоне Тогда
		Сообщение = НСтр("ru = 'Таблица [%1] уже выгружается в фоне';
							|en = 'The table [%1] is already being uploaded in the background'; be = 'Табліца [%1] ужо выгружаецца ў фоне'; es = 'La tabla [%1] ya se está descargando en el fondo'; ka = 'ცხრილი [%1] უკვე ატვირთულია ფონზე'; kk = 'Кесте [%1] қазірдің өзінде фонда түсіріліп жатыр'; ro = 'Tabelul [%1] este deja încărcat în fundal'; tr = 'Tablo [%1] zaten arka planda kaldırılıyor'; uk = 'Таблиця [%1] вже вивантажується в тлі'; uz = 'Jadval [%1] allaqachon orqa fonda Yuklanmoqda'");
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		Сообщить(Сообщение); 
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	Если НастройкиКомпоновщика = "" Тогда
		НастройкаКомпоновщикаСтрокой = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "НастройкаКомпоновщикаСтрокой");
		Если ЗначениеЗаполнено(НастройкаКомпоновщикаСтрокой) Тогда
			НастройкиКомпоновщика = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаКомпоновщикаСтрокой);
		КонецЕслИ;
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ОчищатьПередВыгрузкой") Тогда
		ОчищатьСправочникПередВыгрузкой = ПараметрыВыгрузки.ОчищатьПередВыгрузкой;		
	Иначе
		ОчищатьСправочникПередВыгрузкой = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиОбменаСправочников", Отбор, "ОчищатьПередВыгрузкой");
	КонецЕсли;
	
	ПереписыватьНоменклатуруПриВыгрузке = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПереписыватьНоменклатуруПриВыгрузке");
	РаботаБезАлкоголя 					= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя");
	
	Если ИмяТаблицы = "Узлы" ИЛИ ИмяТаблицы = "Nodes"
		ИЛИ ИмяТаблицы = "БизнесПроцессы" ИЛИ ИмяТаблицы = "BusinessProcesses" Тогда
		ОчищатьСправочникПередВыгрузкой = Истина; // Эти таблицы всегда очищаются принудительно
	ИначеЕсли ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
		НастройкиОбменаСправочников_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников_ПоУмолчанию");
			
		НастройкиПоУмолчанию = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(
			НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", ИмяТаблицы);
		Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
			НастройкиПоУмолчанию.Свойство("ОчищатьПередВыгрузкой", ОчищатьСправочникПередВыгрузкой);
		КонецЕсли;
		
		Если ОчищатьСправочникПередВыгрузкой = Неопределено Тогда
			ОчищатьСправочникПередВыгрузкой = ?(ПереписыватьНоменклатуруПриВыгрузке = Неопределено, Ложь, ПереписыватьНоменклатуруПриВыгрузке);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыКомпоновщика = Ложь Тогда
		ПараметрыКомпоновщика = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	КонецЕсли;
	
	Если РазмерПорции = Ложь ИЛИ НЕ ЗначениеЗаполнено(РазмерПорции) Тогда
		РазмерПорции = 1000;
	КонецЕсли;
	
	Если ПараметрыВыгрузки <> Неопределено И ПараметрыВыгрузки.Свойство("ТипБазы") Тогда
		ТипБазы = ПараметрыВыгрузки.ТипБазы;
	Иначе		
		ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	КонецЕсли;
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы", ИмяТаблицы));
	СтруктураВызова.ПараметрыМетода.Вставить("НастройкиКомпоновщика", НастройкиКомпоновщика);
	СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыКомпоновщика", ПараметрыКомпоновщика);
	СтруктураВызова.ПараметрыМетода.Вставить("ТипБазы", ТипБазы);	
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова.ПараметрыМетода.Вставить("ОчищатьСправочникПередВыгрузкой",		ОчищатьСправочникПередВыгрузкой);
		СтруктураВызова.ПараметрыМетода.Вставить("РазмерПорции", 			РазмерПорции);
		СтруктураВызова.ПараметрыМетода.Вставить("РаботаБезАлкоголя", 					РаботаБезАлкоголя);
		СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыВыгрузки", 					ПараметрыВыгрузки);
		СтруктураВызова.Вставить("ИмяМетода", "ВыгрузитьТаблицуНаСерверSMARTSПорциями");
		
		Если Не ДоступноВыполнениеВФоне Тогда	
			РезультатВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
			Сообщить(РезультатВыгрузки.Сообщение); 
		Иначе
			СтруктураВызова.ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);
			
			ТекстСообщения = НСтр("ru = 'Начало выгрузки таблицы [%1] порциями в фоне';
									|en = 'The beginning of unloading the table [%1] in portions in the background'; be = 'Пачатак выгрузкі табліцы [%1] порцыямі ў фоне'; es = 'Inicio de la descarga de la tabla [%1] por lotes en el fondo'; ka = 'დასაწყისში გადმოტვირთვის მაგიდა [%1] ნაწილი ფონზე'; kk = 'Кестені жүктеуді бастау [%1] фонда'; ro = 'Începutul descărcării tabelului [%1] în porțiuni în fundal'; tr = 'Tabloyu [%1] arka planda porsiyonlar halinde boşaltmaya başlama'; uk = 'Початок вивантаження таблиці [%1] порціями в тлі'; uz = 'Jadvalni [%1] fonda qismlarga tushirishni boshlash'");
			ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ИмяТаблицы);
			
			ПараметрыФЗ = Новый Структура;
			ПараметрыФЗ.Вставить("ИмяМетода", 				"ГлЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциямиВФоне");
			ПараметрыФЗ.Вставить("ПараметрыМетода", 		СтруктураВызова.ПараметрыМетода);		
			ПараметрыФЗ.Вставить("НаименованиеФЗ",			ТекстСообщения);
			ПараметрыФЗ.Вставить("ТекстСообщения", 			ТекстСообщения);
			ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 	Ложь);
			
			пДополнительныеПараметры = Новый Структура;
			пДополнительныеПараметры.Вставить("ИмяТаблицы", 		ИмяТаблицы);
			пДополнительныеПараметры.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
			ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциямиВФонеЗавершение", ЭтаФорма, пДополнительныеПараметры);
			ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_ОбработатьОшибкиВыгрузкиТаблицыВФоне", ЭтаФорма, пДополнительныеПараметры);
			
			Сообщить(ТекстСообщения); 
			СписокТаблицВыгружаемыхВФоне.Добавить(ИмяТаблицы);
			
			ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);

		КонецЕсли;
	Иначе									
	
		РезультатВыгрузки = Новый Структура;
		Сообщение = НСтр("ru = 'Начало выгрузки таблицы [%1] порциями';
							|en = 'The beginning of unloading the table [%1] in portions'; be = 'Пачатак выгрузкі табліцы [%1] порцыямі'; es = 'Inicio de la descarga de la tabla [%1] en porciones'; ka = 'ცხრილის გადმოტვირთვის დასაწყისი [%1] ნაწილებად'; kk = 'Кестені жүктеуді бастау [%1] бөліктерде'; ro = 'Începutul descărcării tabelului [%1] în porțiuni'; tr = 'Tabloyu [%1] porsiyonlar halinde boşaltmaya başlama'; uk = 'Початок вивантаження таблиці [%1] порціями'; uz = 'Jadvalni [%1] qismlarga tushirishni boshlash'");
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы);
		РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
		РезультатВыгрузки.Вставить("Статус"		, Истина);	
		Сообщить(Сообщение); 
		
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы); 
		ЭтоREST_API = ТипИнтерфейса = "REST_API";
		
		Если Не ЭтоREST_API Тогда
			Если НЕ КомЯдро_ПодключитьсяКСерверуSMARTS(Ложь,ТипБазы) Тогда		
				
				Сообщение = НСтр("ru = 'База Клеверенс недоступна!';
									|en = 'The Cleverence database is unavailable!'; be = 'База Cleverence недаступная!'; es = 'Base Cleverence no disponible!'; ka = 'Cleverence მონაცემთა ბაზა მიუწვდომელია!'; kk = 'Cleverence базасы қол жетімді емес!'; ro = 'Baza de date Cleverence nu este disponibilă!'; tr = 'Cleverence üssü kullanılamıyor!'; uk = 'База Cleverence недоступна!'; uz = 'Cleverence bazasi mavjud emas!'");
				РезультатВыгрузки.Вставить("Статус"		, Ложь);				
				РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
				Сообщить(Сообщение); 
				
				// <Лог>
				ЛогЗавершитьСобытие(логСобытие);
				// </Лог>
				
				Возврат;		
				
			КонецЕсли;
		КонецЕсли;
		
		МассивСсылокОтбора = ЛокЯдро_ПолучитьМассивСсылокСправочников(ПараметрыПорционнойВыгрузки.ИменаСправочников);
		
		КоличествоСтрок 					= МассивСсылокОтбора.Количество();
		КоличествоПорций 					= (КоличествоСтрок - КоличествоСтрок % РазмерПорции) / РазмерПорции + ?(КоличествоСтрок % РазмерПорции <> 0, 1, 0);							
		
		ВсегоСтрок 							= 0;
		ОтборПоМассивуСсылок 				= Новый Массив;
		НачатаВыгрузкаТаблицы 				= Ложь;
		ВремяПолученияДанныхИз1С			= 0;
		ВремяВыгрузкиДанныхНаСерверSMARTS 	= 0;		
		СоответствиеРазличныхТоваров		= Новый Соответствие;
		ИндексИдТовара						= -1;	
		КоличествоРазличныхТоваров		= 0;
		
		СтруктураВызова.ПараметрыМетода.Вставить("ОтборПоНоменклатуре", ОтборПоМассивуСсылок);
		СтруктураВызова.ПараметрыМетода.Вставить("РаботаБезАлкоголя", 	РаботаБезАлкоголя);
		СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыВыгрузки", 	ПараметрыВыгрузки);
		СтруктураВызова.ПараметрыМетода.Вставить("ID_БазыSMARTS", 		"");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьПорциюДанныхДляВыгрузки");
		
		Для НомерПорции = 1 По КоличествоПорций Цикл				
			
			НачалоВыгрузкиПорции 		= ТекущаяДата();
			НачалоПолученияДанныхИз1С 	= ТекущаяДата();
			
			ОтборПоМассивуСсылок.Очистить();
			
			Для Сч = 1 По РазмерПорции Цикл
				
				ИндексСтроки = (НомерПорции - 1) * РазмерПорции + Сч - 1;
				
				Если ИндексСтроки > КоличествоСтрок - 1 Тогда
					Прервать;
				КонецЕсли;	
				
				ОтборПоМассивуСсылок.Добавить(МассивСсылокОтбора[ИндексСтроки]);
				
			КонецЦикла;							
			
			ДанныеДляВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);			
			
			Если ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив") Тогда
				сткДанныеДляВыгрузки = Новый Структура;
				сткДанныеДляВыгрузки.Вставить("МассивыСтрок", ДанныеДляВыгрузки);
				ДанныеДляВыгрузки = сткДанныеДляВыгрузки;
			КонецЕсли;
			ДанныеДляВыгрузки.Вставить("ВыгрузкаБлоками", Истина);
			
			Если ИмяТаблицы = "Номенклатура" Тогда
				МассивНоменклатурыПорции =  ДанныеДляВыгрузки.МассивыСтрок;
			КонецЕсли;
			
			ОкончаниеПолученияДанныхИз1С 	= ТекущаяДата();
			ВремяПолученияДанныхИз1С 		= ВремяПолученияДанныхИз1С + (ОкончаниеПолученияДанныхИз1С - НачалоПолученияДанныхИз1С);			
			
			НачалоВыгрузкиДанныхНаСерверSMARTS = ТекущаяДата();
			
			КоличествоСтрокВПорции = ДанныеДляВыгрузки.МассивыСтрок.Количество();			
			
			// Если данных в порции нет, то и выгружать нечего
			Если КоличествоСтрокВПорции = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Для того чтобы искать индекс только один раз, а не на каждой итерации
			Если ИмяТаблицы = "Номенклатура" И ИндексИдТовара = -1 Тогда
				ИндексИдТовара = ЛокЯдро_НайтиИндексИдТовараВМассивеИмен(ДанныеДляВыгрузки.МассивИмен);
			КонецЕсли;	
			
			// Если выгружается первая порция (до этого не было порций с данными), содержащая ненулевое количество строк, то используем флаг из настроек, иначе - дописываем номенклатуру
			ОчищатьСправочникПередВыгрузкой = ?(ВсегоСтрок = 0 И КоличествоСтрокВПорции > 0, ОчищатьСправочникПередВыгрузкой, Ложь);
			
			Если ЭтоREST_API Тогда
				РезультатВыгрузкиПорции = REST_API_ВыгрузитьТаблицуНаСерверSMARTS(ИмяТаблицы, ДанныеДляВыгрузки, ТипБазы, ОчищатьСправочникПередВыгрузкой);
				
				Если Не РезультатВыгрузкиПорции.Статус Тогда
					Сообщить(РезультатВыгрузкиПорции.Сообщение); 
					РезультатВыгрузки.Вставить("Сообщение", РезультатВыгрузкиПорции.Сообщение);
					РезультатВыгрузки.Вставить("Статус", Ложь);					
					Прервать;
				Иначе
					Если РезультатВыгрузки.Статус И ИмяТаблицы = "Номенклатура" Тогда
						КоличествоРазличныхТоваров = КоличествоРазличныхТоваров + ДанныеДляВыгрузки.КоличествоТоваров;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				
				// При получении из 1С первой непустой порции данных вызываем соответствующий метод для начала выгрузки таблицы
				Если НЕ НачатаВыгрузкаТаблицы Тогда
					
					Если ТипБазы = "Частная" Тогда
						СтруктураПодключенияMS = COMЧастнойБазыMS;
					Иначе
						СтруктураПодключенияMS = COMБазыMS;
					КонецЕсли;
					
					Если ИмяТаблицы = "Номенклатура" Тогда
						СтруктураПодключенияMS.TerminalConnector.ПерезаписыватьНоменклатуру(ОчищатьСправочникПередВыгрузкой);
						РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.НачатьВыгрузкуТоваров(ДанныеДляВыгрузки.МассивИмен);
					Иначе
						РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.НачатьВыгрузкуТаблицы(ИмяТаблицы, ДанныеДляВыгрузки.МассивИмен, Истина);
					КонецЕсли;
					
					Если НЕ РезультатПопытки Тогда
						
						ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы);
						Сообщение = НСтр("ru = 'Таблица [%1] не выгружается!';
											|en = 'Table [%1] is not being uploaded!'; be = 'Табліца [%1] не выгружаецца!'; es = '¡La tabla [%1] no se descarga!'; ka = 'ცხრილი [%1] არ იტვირთება!'; kk = 'Кесте [%1] түсірілмейді!'; ro = 'Tabelul [%1] nu este încărcat!'; tr = 'Tablo [%1] boşaltılmıyor!'; uk = 'Таблиця [%1] не вивантажується!'; uz = 'Jadval [%1] tushirilmaydi!'");
						Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
						РезультатВыгрузки.Вставить("Статус"		, Ложь);				
						РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
						Сообщить(Сообщение); 					
						
						// <Лог>
						ЛогЗавершитьСобытие(логСобытие);
						// </Лог>
						
						Возврат;
						
					Иначе
						НачатаВыгрузкаТаблицы = РезультатПопытки; 
					КонецЕсли;		
					
				КонецЕсли;
				
				Если РезультатВыгрузки.Статус Тогда
					
					Для Каждого МассивСтрокиВыгрузки из ДанныеДляВыгрузки.МассивыСтрок Цикл
						
						Если ИмяТаблицы = "Номенклатура" Тогда
							РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ДобавитьВВыгрузкуТоваров(МассивСтрокиВыгрузки);
							// Подсчет количества различных товаров в выгрузке
							Если ИндексИдТовара <> -1 Тогда
								СоответствиеРазличныхТоваров.Вставить(МассивСтрокиВыгрузки[ИндексИдТовара]);
							КонецЕсли;						
						Иначе
							РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ДобавитьВВыгрузкуТаблицы(МассивСтрокиВыгрузки);
						КонецЕсли;
						
						Если НЕ РезультатПопытки Тогда
							
							ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы);		
							Сообщение = НСтр("ru = 'Ошибка выгрузки таблицы [%1].';
												|en = 'Error unloading the table [%1].'; be = 'Памылка выгрузкі табліцы [%1].'; es = 'Error al cargar la tabla [%1].'; ka = 'შეცდომა გადმოტვირთვის მაგიდა [%1].'; kk = 'Кестені жүктеу қатесі [%1].'; ro = 'Eroare la descărcarea tabelului [%1].'; tr = 'Tablo boşaltma hatası [%1].'; uk = 'Помилка вивантаження таблиці [%1].'; uz = 'Jadvalni yuklash xatosi [%1].'");
							Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
							РезультатВыгрузки.Вставить("Статус"		, Ложь);				
							РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
							Сообщить(Сообщение); 																	
							СтруктураПодключенияMS.TerminalConnector.ПрерватьВыгрузкуТаблицы();			
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;		
			КонецЕсли;
			
			ВсегоСтрок = ВсегоСтрок + КоличествоСтрокВПорции;										

			ОкончаниеВыгрузкиДанныхНаСерверSMARTS 	= ТекущаяДата();
			ВремяВыгрузкиДанныхНаСерверSMARTS		= ВремяВыгрузкиДанныхНаСерверSMARTS + (ОкончаниеВыгрузкиДанныхНаСерверSMARTS - НачалоВыгрузкиДанныхНаСерверSMARTS);			
			
			ОкончаниеВыгрузкиПорции = ТекущаяДата();
			ВремяВыгрузкиПорции		= ОкончаниеВыгрузкиПорции - НачалоВыгрузкиПорции;			
			
			ПредставлениеВремениВыгрузки = ЛокЯдро_ПредставлениеВремени(ВремяВыгрузкиПорции);
			
			Сообщение = НСтр("ru = 'Выгрузка таблицы [%1] порциями. Выгружена порция №%2 из %3, содержащая %4 строк. Всего выгружено %5 строк. Затраченное время: %6';
								|en = 'Unloading the table [%1] in chunks. Uploaded portion #%2 from %3, containing %4 rows. In total, %5 lines were uploaded. Time spent: %6';
								|be = 'Выгрузка табліцы [%1] порцыямі. Выгружаная порцыя №%2 з % 3, якая змяшчае %4 радкоў. Усяго выгружана %5 радкоў. Затрачаны час: %6'; es = 'Descarga la tabla [%1] en porciones. Se descargó la porción no. %2 de %3 que contiene % 4 filas. Total %5 filas descargadas. Tiempo empleado: %6'; ka = 'გადმოტვირთვის მაგიდა [%1] მოცულობით. ატვირთული ნაწილი #%2% 3-დან, რომელიც შეიცავს %4 რიგს. მთლიანობაში, % 5 ხაზი აიტვირთა. დახარჯული დრო: %6'; kk = 'Кестені [%1] бөліктерге түсіру. %4 жолдан тұратын %3-тен №%2 бөлігі түсірілді. Барлығы %5 жол түсірілді. Жұмсалған уақыт: %6'; ro = 'Descărcarea tabelului [%1] în bucăți. Porțiunea încărcată # %2 din %3, conținând %4 rânduri. În total, au fost încărcate %5 linii. Timp petrecut: %6'; tr = 'Tablonun [%1] porsiyonlar halinde boşaltılması. %4 satır içeren%3''ün%2''sinin kısmı boşaltıldı. Toplam %5 satır yüklendi. Harcanan süre: % 6'; uk = 'Вивантаження таблиці [%1] порціями. Вивантажена порція № %2 з %3, що містить %4 рядків. Всього вивантажено %5 рядків. Витрачений час: %6'; uz = 'Jadvalni [%1] qismlarga tushirish. %4 qatorni o''z ichiga olgan %3 ning %2 qismi tushirildi. Hammasi bo''lib, %5 qator tushirildi. Sarflangan vaqt: %6'");
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы, СокрЛП(НомерПорции), СокрЛП(КоличествоПорций), СокрЛП(КоличествоСтрокВПорции), СокрЛП(ВсегоСтрок), ПредставлениеВремениВыгрузки);
			Сообщить(Сообщение); 
			
		КонецЦикла;			
		
		Если РезультатВыгрузки.Статус Тогда
			
			НачалоЗавершенияВыгрузкиНаСерверSMARTS = ТекущаяДата();
			
			Если Не ЭтоREST_API Тогда
				Если ИмяТаблицы = "Номенклатура" Тогда
					РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ЗавершитьВыгрузкуТоваров();	
				Иначе
					РезультатПопытки = СтруктураПодключенияMS.TerminalConnector.ЗавершитьВыгрузкуТаблицы();	
				КонецЕсли;
				
				Если НЕ РезультатПопытки Тогда
					ОписаниеОшибки = КомЯдро_ПолучитьОшибку(ТипБазы);		
					Сообщение = НСтр("ru = 'Не удалось закончить выгрузку таблицы [%1].';
										|en = 'Couldn''t finish unloading the table [%1].'; be = 'Не ўдалося скончыць выгрузку табліцы [%1].'; es = 'No se pudo terminar de descargar la tabla [%1].'; ka = 'ვერ დაასრულა ცხრილის გადმოტვირთვა [%1].'; kk = '[%1] кестесін түсіруді аяқтау мүмкін болмады.'; ro = 'Nu s-a putut termina descărcarea tabelului [%1].'; tr = 'Tabloyu [%1] boşaltmayı bitiremedim.'; uk = 'Не вдалося закінчити вивантаження таблиці [%1].'; uz = 'Jadvalni tushirishni tugata olmadi [%1].'");
					Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы) + Символы.ВК + ОписаниеОшибки;
					РезультатВыгрузки.Вставить("Статус"		, Ложь);				
					РезультатВыгрузки.Вставить("Сообщение"	, Сообщение);
					Сообщить(Сообщение); 
				КонецЕсли;
			Иначе
				РезультатПопытки = Истина;
			КонецЕсли;
			
			Если РезультатПопытки Тогда
				
				ОкончаниеЗавершенияВыгрузкиНаСерверSMARTS 	= ТекущаяДата();
				ВремяЗавершенияВыгрузкиНаСерверSMARTS		= ОкончаниеЗавершенияВыгрузкиНаСерверSMARTS - НачалоЗавершенияВыгрузкиНаСерверSMARTS;
				
				ВремяВыгрузкиДанныхНаСерверSMARTS 			= ВремяВыгрузкиДанныхНаСерверSMARTS + ВремяЗавершенияВыгрузкиНаСерверSMARTS;
				
				ПредставлениеВремениЗавершенияВыгрузкиНаСерверSMARTS = ЛокЯдро_ПредставлениеВремени(ВремяЗавершенияВыгрузкиНаСерверSMARTS);
				
				Сообщение = НСтр("ru = 'Завершение выгрузки таблицы [%1] порциями. Затраченное время: %2';
									|en = 'Completion of unloading the table [%1] in chunks. Time spent: %2';
									|be = 'Завяршэнне выгрузкі табліцы [%1] порцыямі. Затрачаны час: %2'; es = 'Finalización de la descarga de la tabla [%1] en porciones. Tiempo empleado: %2'; ka = 'დასრულების გადმოტვირთვის მაგიდა [%1] მოცულობით. დახარჯული დრო: %2'; kk = 'Кестені түсіруді аяқтау [%1] бөліктерде. Жұмсалған уақыт: %2'; ro = 'Finalizarea descărcării tabelului [%1] în bucăți. Timpul petrecut: %2'; tr = 'Tablonun [%1] toplu olarak boşaltılmasının tamamlanması. Harcanan süre: %2'; uk = 'Завершення вивантаження таблиці [%1] порціями. Витрачений час: %2'; uz = 'Jadvalni [%1] qismlarga bo''lib tushirishni yakunlash. Sarflangan vaqt: %2'");
				Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяТаблицы, ПредставлениеВремениЗавершенияВыгрузкиНаСерверSMARTS);
				Сообщить(Сообщение); 
				
				Если ИмяТаблицы = "Номенклатура" Тогда
					КоличествоТоваровВСообщение = ?(КоличествоРазличныхТоваров = 0, СоответствиеРазличныхТоваров.Количество(), КоличествоРазличныхТоваров);
					ПодробноеСообщение = НСтр("ru = 'Таблица [%1] успешно выгружена порциями по %2 позиций. Выгружено: %3 строк %4 товаров';
												|en = 'Table [%1] was successfully uploaded in portions of %2 items. Uploaded: %3 rows %4 items';
												|be = 'Табліца [%1] паспяхова выгружаная порцыямі па %2 пазіцый. Выгружана: %3 радкоў %4 тавараў'; es = 'La tabla [%1] se descargó correctamente en porciones de %2 posiciones. Descargado: % 3 líneas % 4 productos'; ka = 'ცხრილი [%1] წარმატებით აიტვირთა %2 ნივთების ნაწილში. ატვირთულია: %3 რიგები %4 ელემენტი'; kk = 'Кесте [%1] %2 позиция бойынша бөліктермен сәтті түсірілді. Түсірілді: %3 жол %4 тауар'; ro = 'Tabelul [%1] a fost încărcat cu succes în porțiuni de articole %2. Încărcat: %3 rânduri % 4 articole'; tr = 'Tablo [%1], %2 pozisyondaki porsiyonlar halinde başarıyla boşaltılmıştır. Yüklendi: %3 satır %4 ürün'; uk = 'Таблиця [%1] успішно вивантажена порціями по %2 позицій. Вивантажено: %3 рядків %4 товарів'; uz = 'Jadval [%1] %2 elementlarining qismlariga muvaffaqiyatli Yuklandi. Yukladi: %3 satr %4 mahsulot'");
					ПодробноеСообщение = ЛокЯдро_СтрШаблон(ПодробноеСообщение, ИмяТаблицы, СокрЛП(РазмерПорции),
							Символы.ВК + Символы.Таб + "- " + Формат(ВсегоСтрок, "ЧН=0; ЧГ=3,0"),
							Символы.ВК + Символы.Таб + "- " + Формат(КоличествоТоваровВСообщение, "ЧН=0; ЧГ=3,0"));
				Иначе
					ПодробноеСообщение = НСтр("ru = 'Таблица [%1] успешно выгружена порциями по %2 позиций. Выгружено: %3 строк';
												|en = 'Table [%1] was successfully uploaded in portions of %2 items. Unloaded: %3 rows';
												|be = 'Табліца [%1] паспяхова выгружаная порцыямі па %2 пазіцый. Выгружана: %3 радкоў'; es = 'La tabla [%1] se descargó correctamente en porciones de %2 posiciones. Descargado: % 3 filas'; ka = 'ცხრილი [%1] წარმატებით აიტვირთა %2 ნივთების ნაწილში. გადმოტვირთული: %3 რიგები'; kk = 'Кесте [%1] %2 позиция бойынша бөліктермен сәтті түсірілді. Түсірілді: %3 жол'; ro = 'Tabelul [%1] a fost încărcat cu succes în porțiuni de articole %2. Descărcate: % 3 rânduri'; tr = 'Tablo [%1], %2 pozisyondaki porsiyonlar halinde başarıyla boşaltılmıştır. Yüklendi: %3 satır'; uk = 'Таблиця [%1] успішно вивантажена порціями по %2 позицій. Вивантажено: %3 рядків'; uz = 'Jadval [%1] %2 elementlarining qismlariga muvaffaqiyatli Yuklandi. Yuklangan: %3 qator'");
					ПодробноеСообщение = ЛокЯдро_СтрШаблон(ПодробноеСообщение, ИмяТаблицы, СокрЛП(РазмерПорции),
							Символы.ВК + Символы.Таб + "- " + Формат(ВсегоСтрок, "ЧН=0; ЧГ=3,0"));
				КонецЕсли;																				
				
				ПодробноеСообщение = Символы.ВК + ПодробноеСообщение;
				
				ОбщееВремяВыгрузки 			= ВремяПолученияДанныхИз1С + ВремяВыгрузкиДанныхНаСерверSMARTS; 				
				
				ПредставлениеВремени1С 		= ЛокЯдро_ПредставлениеВремени(ВремяПолученияДанныхИз1С);
				ПредставлениеВремениMS 		= ЛокЯдро_ПредставлениеВремени(ВремяВыгрузкиДанныхНаСерверSMARTS);
				ПредставлениеВремениОбщее 	= ЛокЯдро_ПредставлениеВремени(ОбщееВремяВыгрузки);			
				
				ПодробноеСообщение = ЛокЯдро_СформироватьПодробноеСообщениеОВыгрузкеТаблицы(ПодробноеСообщение, ПредставлениеВремениОбщее, ПредставлениеВремени1С, ПредставлениеВремениMS);				
				
				РезультатВыгрузки.Вставить("Статус"		, Истина);				
				РезультатВыгрузки.Вставить("Сообщение"	, ПодробноеСообщение);
				Сообщить(ПодробноеСообщение); 
			КонецЕсли;
			
		КонецЕсли;	
		
		Если Не ЭтоREST_API Тогда
			СтруктураПодключенияMS.TerminalConnector.ОсвободитьРесурсы();
		КонецЕсли;
		
	КонецЕсли;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивСсылокНоменклатуры()
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивСсылокНоменклатуры");	
	РезультатВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	
	Возврат РезультатВыгрузки;
	
КонецФункции	

// Вызывает функцию очистки таблицы на сервере Клеверенс для всех справочников, участвующих в интеграции
&НаКлиенте
Процедура ЛокЯдро_ОчиститьВсеСправочники() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОчиститьВсеСправочники";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	МетаданныеНСИ = ЛокЯдро_ПолучитьМетаданныеНСИ();
	
	СписокИспользуемыхСправочников = ЛокЯдро_ПолучитьСписокИспользуемыхСправочников();
	
	//Может вернуться неопределено в случае, если нет интеграционной обработки
	//Попробуем получить ИО снова
	Если  МетаданныеНСИ = Неопределено
		ИЛИ СписокИспользуемыхСправочников = Неопределено Тогда
		
		Если РасположениеКомпоненты = Неопределено Тогда
			РасположениеКомпоненты = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		КонецЕсли;
		ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты);
		
		МетаданныеНСИ = ЛокЯдро_ПолучитьМетаданныеНСИ();
		СписокИспользуемыхСправочников = ЛокЯдро_ПолучитьСписокИспользуемыхСправочников();
		Если  МетаданныеНСИ = Неопределено
			ИЛИ СписокИспользуемыхСправочников = Неопределено Тогда
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;		
	
	Для Каждого ИмяСправочника ИЗ СписокИспользуемыхСправочников Цикл	
		ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяСправочника.Значение);	
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает функцию очистки данных из таблицы на сервере Клеверенс
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы	
//
// Возвращаемое значение:
//  Структура - содержит:
//		* Статус - Булево - признак успешности очистки таблицы
//		* Сообщение - Строка - информационное сообщение о результате очистки таблицы
&НаКлиенте
Процедура ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы = "") Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОчиститьТаблицуНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ТипБазы",
		ИмяТаблицы, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоОчистки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'ИмяТаблицы=%1';
						|en = 'Table Name= %1'; be = 'Імятабліцы=%1'; es = 'Nombretabla = %1'; ka = 'ცხრილის სახელი= %1'; kk = 'Кесте атауы=%1'; ro = 'Numele Tabelului = %1'; tr = 'Tablo adı=%1'; uk = 'Імятабліци=%1'; uz = 'Jadvallar = %1'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ОчисткаСправочника.Начало", "Информация", пСообщение);
	
	Если НЕ ЗначениеЗаполнено(ТипБазы) Тогда
		ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ОчиститьТаблицуНаСервереSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы, ТипБазы", ИмяТаблицы, ТипБазы));
		РезультатВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	Иначе
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(?(ЕстьЧастнаяБаза, "Частная", "Основная")); 
		Если ТипИнтерфейса = "REST_API" Тогда
			РезультатВыгрузки = REST_API_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы);
		Иначе
			РезультатВыгрузки = КомЯдро_ОчиститьТаблицуНаСервереSMARTS(ИмяТаблицы, ТипБазы);
		КонецЕсли;
		Сообщить(РезультатВыгрузки.Сообщение); 
	КонецЕсли;		
	
	пСообщение = НСтр("ru = 'ИмяТаблицы=%1';
						|en = 'Table Name= %1'; be = 'Імятабліцы=%1'; es = 'Nombretabla = %1'; ka = 'ცხრილის სახელი= %1'; kk = 'Кесте атауы=%1'; ro = 'Numele Tabelului = %1'; tr = 'Tablo adı=%1'; uk = 'Імятабліци=%1'; uz = 'Jadvallar = %1'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ИмяТаблицы);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ОчисткаСправочника.Конец", "Информация", пСообщение, НачалоОчистки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает из модуля обработки функцию получения схемы компоновки данных, используемой для выгрузки таблицы на сервер Клеверенс.
// Устанавливает параметры полученной схемы компоновки данных.
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы
//	ПараметрыВыгрузки - Структура - параметры выгрузки справочника
//
// Возвращаемое значение:
//	- СхемаКомпоновкиДанных - схема компоновки данных для выгрузки таблицы на сервер Клеверенс
//  - Неопределено - если не удалось получить интеграционную обработку
&НаКлиенте
Функция ЛокЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников(ИмяТаблицы, ПараметрыВыгрузки = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСхемуСКДДляВыгрузкиСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяТаблицы,ПараметрыВыгрузки",
		ИмяТаблицы, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСхемуСКДДляВыгрузкиСправочников");
	ПараметрыКомпоновщика = ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров();
	
	ПараметрыПолученияМакета = Новый Структура;
	ПараметрыПолученияМакета.Вставить("РаботаБезАлкоголя", 	 ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя"));
	ПараметрыПолученияМакета.Вставить("ПараметрыОнлайн", 	 Неопределено);
	ПараметрыПолученияМакета.Вставить("ЯзыкПлатформыMS", 	 ЛокЯдро_ЯзыкПлатформыMS());
	ПараметрыПолученияМакета.Вставить("СтруктураМетаданных", СтруктураМетаданных);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяТаблицы", 				 ИмяТаблицы);
	ПараметрыМетода.Вставить("ПараметрыКомпоновщика", 	 ПараметрыКомпоновщика);
	ПараметрыМетода.Вставить("ПараметрыПолученияМакета", ПараметрыПолученияМакета);	
	ПараметрыМетода.Вставить("ПараметрыВыгрузки", 		 ПараметрыВыгрузки);	
	СтруктураВызова.Вставить("ПараметрыМетода", 		 ПараметрыМетода);
	
	СхемаСКД = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Истина,АдресаПеременных);	
	
	//Может вернуться неопределено в случае, если нет интеграционной обработки
	//Попробуем получить ИО снова
	Если СхемаСКД = Неопределено Тогда
		Если РасположениеКомпоненты = Неопределено Тогда
			РасположениеКомпоненты = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		КонецЕсли;
		ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты);
		СхемаСКД = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Истина);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СхемаСКД);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СхемаСКД;
	
КонецФункции

// Вызывает функцию получения запроса для выгрузки таблицы на сервер Клеверенс, выполняет его и обрабатывает полученную таблицу значений
//
// Параметры:
//	ИмяТаблицы - Строка - имя выгружаемой таблицы	
//  НастройкиКомпоновщика - Неопределено, Булево, НастройкиКомпоновкиДанных - содержит настройки, установленные для схемы компоновки данных, описанной в интеграционной
//															          		  обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//  ПараметрыКомпоновщика - Неопределено, Булево, Массив из Структура - содержит параметры схемы компоновки данных, описанной в интеграционной 
//																		обработке и используемой для получения данных таблицы при выгрузке на сервер Клеверенс
//	ПараметрыВыгрузки - Структура - параметры выгрузки справочника
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит данные таблицы для выгрузки на сервер Клеверенс
&НаКлиенте
Функция ЛокЯдро_ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS(ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ПараметрыВыгрузки = Неопределено) Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьДанныеТаблицыДляВыгрузкиНаСерверSMARTS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяТаблицы,НастройкиКомпоновщика,ПараметрыКомпоновщика,ПараметрыОнлайн", ИмяТаблицы, НастройкиКомпоновщика, ПараметрыКомпоновщика, ""));
	СтруктураВызова.ПараметрыМетода.Вставить("РаботаБезАлкоголя", ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя"));
	СтруктураВызова.ПараметрыМетода.Вставить("ПараметрыВыгрузки", ПараметрыВыгрузки);
	
	ДанныеДляВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,Истина,АдресаПеременных);	
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

// Вызывает из модуля обработки функцию получения списка имен справочников, участвующих в интеграции с Клеверенс
//
// Параметры:
//	АдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных
//
// Возвращаемое значение:
//	СписокЗначений - содержит имена справочников в базе 1С, участвующих в интеграции с Клеверенс
&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокИспользуемыхСправочников() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСписокИспользуемыхСправочников";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСписокИспользуемыхСправочников");	
	СписокИспользуемыхСправочников = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСоответствиеИменТаблицMS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ЯзыкПлатформыMS", ЛокЯдро_ЯзыкПлатформыMS()));
	СоответствиеИменТаблицMS = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Если  РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСписокСправочниковВКонфигурацииSMARTS");				
		СписокСправочниковВКонфигурацииСмартс = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	Иначе
		СписокСправочниковВКонфигурацииСмартс = КомЯдро_ПолучитьСписокСправочниковВКонфигурацииSMARTS();
	КонецЕсли;
	// Отфильтруем из списка отсутствующие справочники
	Если ЗначениеЗаполнено(СписокИспользуемыхСправочников) И СписокИспользуемыхСправочников.Количество() > 0 Тогда
		СправочникиКУдалению = Новый Массив;
		Для Каждого Справочник Из  СписокИспользуемыхСправочников Цикл
			Если Справочник.Значение = "Номенклатура" Тогда
				Продолжить;
			КонецЕсли;
			Если Справочник.Значение ="Ячейки" Тогда
				Если ПараметрыПодключенияMS.Свойство("ТипУстановленногоПродукта") Тогда
					//И ПараметрыПодключенияMS.Свойство("УровеньПриложенияСтрокой") Тогда
					Если (ПараметрыПодключенияMS.ТипУстановленногоПродукта = "Склад"
						ИЛИ ПараметрыПодключенияMS.ТипУстановленногоПродукта = "Не удалось определить...") Тогда
						//И Не ПараметрыПодключенияMS.УровеньПриложенияСтрокой = "Минимум" Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если СоответствиеИменТаблицMS <> Неопределено Тогда
				ТаблицаMS = СоответствиеИменТаблицMS.Получить(Справочник.Значение);
			КонецЕсли;
			
			Если ТаблицаMS = Неопределено Тогда
				ТаблицаMS = Справочник.Значение;
			КонецЕсли;
			
			Если СписокСправочниковВКонфигурацииСмартс.Найти(ТаблицаMS) = Неопределено Тогда
				СправочникиКУдалению.Добавить(Справочник);
			КонецЕсли;
		КонецЦикла;
		Если СправочникиКУдалению.Количество() > 0 Тогда
			Для Каждого ОтсутствующийСправочник Из СправочникиКУдалению Цикл
				СписокИспользуемыхСправочников.Удалить(ОтсутствующийСправочник);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокИспользуемыхСправочников);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СписокИспользуемыхСправочников;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ЯзыкПлатформыMS() Экспорт
	
	Перем ЯзыкПлатформыMS;
	
	ЯзыкПлатформыMS = КомЯдро_ПолучитьЗначениеПеременной("ЯзыкПлатформыMS");
	
	Если ЗначениеЗаполнено(ЯзыкПлатформыMS) Тогда
		Возврат ЯзыкПлатформыMS;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") Тогда
		СтруктураМетаданных.Свойство("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЯзыкПлатформыMS) Тогда
		КомЯдро_СохранитьЗначениеПеременной("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
		
		Возврат ЯзыкПлатформыMS;
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ТипБазы", ?(ЕстьЧастнаяБаза, "Частная", "Основная"));
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ЯзыкПлатформыMSПоСтруктуреБазы");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		ЯзыкПлатформыMS = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		ЯзыкПлатформыMS = ЛокЯдро_ЯзыкПлатформыMSПоСтруктуреБазы();
	КонецЕсли;
	
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура") Тогда
		СтруктураМетаданных.Вставить("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
		
		КомЯдро_СохранитьЗначениеПеременной("СтруктураМетаданных", СтруктураМетаданных);
	КонецЕсли;
	
	Возврат ЯзыкПлатформыMS;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ЯзыкПлатформыMSПоСтруктуреБазы(ТипБазы = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ЯзыкПлатформыMSПоСтруктуреБазы";
	
	Если ТипБазы = Неопределено Тогда
		ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
	
	Если СтруктураПодключения = Неопределено Тогда
		Возврат "RU";
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"DocTypes?$select=uni&$filter=uni eq 'Settings'");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
		
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
	
	Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
		REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета);
		
		DocumentTypes = Неопределено;
	Иначе
		DocumentTypes = СтруктураОтвета.ОтветСервера.Получить("value");
	КонецЕсли;
	
	Если DocumentTypes <> Неопределено И DocumentTypes.Количество() = 1 Тогда
		ЯзыкПлатформыMS = "EN";
	Иначе
		ЯзыкПлатформыMS = "RU";
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ЯзыкПлатформыMS", ЯзыкПлатформыMS);
				
	Возврат ЯзыкПлатформыMS;
	
КонецФункции

&НаСервере
Функция ЛокЯдро_ОбработкаОбъект()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		_ГлКонтекст = ЭтаФорма.ВладелецФормы.Объект;						
	#Иначе
		_ГлКонтекст = РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
	Возврат _ГлКонтекст;
	
КонецФункции

// Возвращает индекс колонки "Product.Id" в массиве имен колонок таблицы, выгружаемой на сервер Клеверенс
//
// Параметры:
//	МассивИмен - Массив из Строка - содержит имена колонок таблицы
//
// Возвращаемое значение:
//	Число - индекс колонки "Product.Id" в массиве имен колонок таблицы
&НаКлиенте
Функция ЛокЯдро_НайтиИндексИдТовараВМассивеИмен(МассивИмен) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода"		, "Функция");
	СтруктураВызова.Вставить("ИмяМетода"		, "НайтиИндексИдТовараВМассивеИмен");	
	СтруктураВызова.Вставить("ПараметрыМетода"	, Новый Структура("МассивИмен", МассивИмен));
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
		
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSЗавершение(СтруктураПараметров, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметров,ДополнительныеПараметры",
		СтруктураПараметров, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	РезультатВыгрузки 	= СтруктураПараметров.РезультатВыгрузки;
	ПодробноеСообщение 	= СтруктураПараметров.ПодробноеСообщение;
	ИмяТаблицы 			= СтруктураПараметров.ИмяТаблицы;
	НачалоВыгрузки 		= СтруктураПараметров.НачалоВыгрузки;
	
	ТипСообщения = ?(РезультатВыгрузки.Статус, "Информация", "Ошибка");
	
	Сообщить(ПодробноеСообщение); 
	
	пСообщение = НСтр("ru = 'ИмяТаблицы=%1. %2';
						|en = 'Table Name=%1. %2'; be = 'ИмяТаблицы=%1. %2'; es = 'Nombretabla = %1. %2'; ka = 'ცხრილის სახელი=%1. %2'; kk = 'Аты-жөні кестелер=%1. %2'; ro = 'Numele Tabelului = %1. %2'; tr = 'Tablo adı=%1. %2'; uk = 'Імятабліци=%1. %2'; uz = 'Jadvallar=%1. %2'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ИмяТаблицы, ПодробноеСообщение);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузкаСправочника.Конец", ТипСообщения, пСообщение, НачалоВыгрузки);	

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSВФонеЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
		ИмяТаблицы 			= ДополнительныеПараметры.ИмяТаблицы;
		
		ЭлементСписка = СписокТаблицВыгружаемыхВФоне.НайтиПоЗначению(ИмяТаблицы);
		Если ЭлементСписка <> Неопределено Тогда
			СписокТаблицВыгружаемыхВФоне.Удалить(ЭлементСписка);
		КонецЕсли;
		
		// Актуализируем кэш, т.к. он мог измениться в сеансе фонового задания
		// TODO. Проверить, надо ли 3-й параметр ЛокЯдро_ДополнитьСтруктуру перевести в Истина 
		ЛокЯдро_ДополнитьСтруктуру(АдресаПеременных, СтруктураРезультата.АдресаПеременных, Ложь); 
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РезультатВыгрузки", 	СтруктураРезультата.РезультатВыгрузки);
		СтруктураПараметров.Вставить("ПодробноеСообщение", 	СтруктураРезультата.РезультатВыгрузки.Сообщение);
		СтруктураПараметров.Вставить("ИмяТаблицы", 			ИмяТаблицы);
		СтруктураПараметров.Вставить("НачалоВыгрузки", 		ДополнительныеПараметры.НачалоВыгрузки);
		
		ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSЗавершение(СтруктураПараметров);
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциямиВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуНаСерверSMARTSПорциямиВФонеЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
		ИмяТаблицы 			= ДополнительныеПараметры.ИмяТаблицы;
		
		ЭлементСписка = СписокТаблицВыгружаемыхВФоне.НайтиПоЗначению(ИмяТаблицы);
		Если ЭлементСписка <> Неопределено Тогда
			СписокТаблицВыгружаемыхВФоне.Удалить(ЭлементСписка);
		КонецЕсли;
		
		// Актуализируем кэш, т.к. он мог измениться в сеансе фонового задания
		// TODO. Проверить, надо ли 3-й параметр ЛокЯдро_ДополнитьСтруктуру перевести в Истина 
		ЛокЯдро_ДополнитьСтруктуру(АдресаПеременных, СтруктураРезультата.АдресаПеременных, Ложь); 
		
		РезультатВыгрузки =	СтруктураРезультата.РезультатВыгрузки;
		Если РезультатВыгрузки.Свойство("Сообщение") Тогда
			Сообщить(РезультатВыгрузки.Сообщение); 
		КонецЕсли;
		
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает функцию выгрузки таблицы на сервер Клеверенс для всех справочников, участвующих в интеграции
&НаКлиенте
Функция ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSПродолжение(Результат = Неопределено, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSПродолжение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыполнения",
		Результат, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыВыгрузкиСправочников = ПараметрыВыполнения.ПараметрыВыгрузкиСправочников;
	ДополнительныеПараметры = Неопределено;
	ПараметрыВыполнения.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	НачалоВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ВыгрузкаСправочников.Начало","Информация", пСообщение);
		
	ВыполняетсяВФоне = ДоступноВыполнениеВФоне;
	
	// Если включено фоновое выполение, то надо обязательно проверить не пропала ли из кэша переменная ИнтеграционнаяОбработка.ИнтеграционнаяОбработкаДвоичныеДанные
	// В случае обнуления кэша обработку надо переподключить.
	Если ВыполняетсяВФоне = Истина Тогда
		Если ЛокЯдро_ПроверитьСуществованиеИнтеграционнаяОбработкаДвоичныеДанные() = Ложь Тогда
				РезультатПодключенияИО = ЛокЯдро_ПодключитьИнтеграционнуюОбработку();
				Если РезультатПодключенияИО = Ложь Тогда 
					ВыполняетсяВФоне = Ложь;
					ДоступноВыполнениеВФоне = Ложь;
				КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыВыгрузкиСправочников = Неопределено Тогда
		
		ПараметрыВыгрузкиСправочников = Новый Массив;
		НастройкиОбменаСправочников = ЛокЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима("Интерактивный", ДанныеТекущегоУзла.ID_Узла);
		Для каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаНастройки.Выгружать = Истина Тогда
				ПараметрыВыгрузкиСправочников.Добавить(Новый Структура("ИмяСправочника, ПараметрыВыгрузки", СтрокаНастройки.ИмяТаблицы, СтрокаНастройки));
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" и ВыполняетсяВФоне Тогда
		ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSВФоне(ПараметрыВыгрузкиСправочников, ДополнительныеПараметры);		
	Иначе		
		ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTSНеВФоне(ПараметрыВыгрузкиСправочников, ДополнительныеПараметры);		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьПараметрыСправочниковДляПорционнойВыгрузки");
	СоответствиеПараметров = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Возврат СоответствиеПараметров;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_НайтиПараметрыСправочникаДляПорционнойВыгрузки(СправочникИмя)
	
	ИмяСобытия = "ЛокЯдро_НайтиПараметрыСправочникаДляПорционнойВыгрузки";
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "НайтиПараметрыСправочникаДляПорционнойВыгрузки");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("СправочникИмя, СоответствиеПараметровПорционнойВыгрузки", СправочникИмя, СоответствиеПараметровПорционнойВыгрузки));
	ПараметрыПорционнойВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Возврат ПараметрыПорционнойВыгрузки;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОпределитьСпособВыгрузкиСправочника(СправочникИмя, ПараметрыВыгрузки, МетаданныеНСИ = Неопределено)
	
	Если СоответствиеПараметровПорционнойВыгрузки = Неопределено Тогда
		СоответствиеПараметровПорционнойВыгрузки = ЛокЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки();
	КонецЕсли;
	
	ПараметрыСпособаВыгрузки = Новый Структура;
	ПараметрыСпособаВыгрузки.Вставить("СправочникИмя", СправочникИмя);
	ПараметрыСпособаВыгрузки.Вставить("ПараметрыВыгрузки", ПараметрыВыгрузки);
	ПараметрыСпособаВыгрузки.Вставить("СоответствиеПараметровПорционнойВыгрузки", СоответствиеПараметровПорционнойВыгрузки);
	ПараметрыСпособаВыгрузки.Вставить("МетаданныеНСИ", МетаданныеНСИ);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОпределитьСпособВыгрузкиСправочника");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ПараметрыСпособаВыгрузки", ПараметрыСпособаВыгрузки));
	СтруктураСпособаВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Возврат СтруктураСпособаВыгрузки;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивСсылокСправочников(ИменаСправочников, ИсключитьГруппы = Ложь)
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивСсылокСправочников");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИменаСправочников, ИсключитьГруппы", ИменаСправочников, ИсключитьГруппы));
	МассивСсылок = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Возврат МассивСсылок;
	
КонецФункции

// Проверяет количество записей таблицы в Mobile SMARTS через GET Tables/{Name}/Count
// При НаСервере вызывает REST API через Транзит, при НаКлиенте — напрямую
&НаКлиенте
Функция ЛокЯдро_ПолучитьКоличествоСтрокТаблицыSMARTS(ИмяТаблицы, ТипБазы = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
	
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ИмяТаблицы", 				ИмяТаблицы);
		ПараметрыМетода.Вставить("ТипБазы", 				ТипБазы);
		ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьКоличествоСтрокТаблицыSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Иначе
	
		Возврат REST_API_ПолучитьКоличествоСтрокТаблицыSMARTS(ИмяТаблицы, ТипБазы, ДополнительныеПараметры);
	
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ЛокальныйКонтекст_Документы

// Вызывает функцию получения таблицы документов из базы Клеверенс
//
// Параметры:
//	ТипБазы 		- Строка 	- "Частная", "Временная", "Основная"
//  РазмерВыборки 	- Число 	- если отличен от нуля, ограничивать выборку этим числом документов
//
// Возвращаемое значение:
//	Массив из Структура - ключами являются имена колонок таблицы документов Клеверенс,
//						  значениями - значения соответствующих реквизитов документов Клеверенс
&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS(ТипБазы = Неопределено, РазмерВыборки = 0, ОтборПоПериоду = Неопределено, ОтборПоУзлу = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТипБазы,РазмерВыборки,ОтборПоПериоду,ОтборПоУзлу",
		ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипБазы = Неопределено Тогда
		ТипБазы = ?(ЕстьЧастнаяБаза,"Частная","Основная");
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСписокДокументовНаСервереSMARTS");		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТипБазы", 		ТипБазы);	
		СтруктураПараметров.Вставить("РазмерВыборки", 	РазмерВыборки);
		СтруктураПараметров.Вставить("ОтборПоПериоду", 	ОтборПоПериоду);
		СтруктураПараметров.Вставить("ОтборПоУзлу",		ОтборПоУзлу);

		СтруктураВызова.Вставить("ПараметрыМетода", СтруктураПараметров);				
		СписокДокументов = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	Иначе
		ПустаяТаблица = ЛокЯдро_ПолучитьПустуюТаблицуДокументовSMARTS();
	
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
		Если ТипИнтерфейса = "REST_API" Тогда
			СписокДокументов = REST_API_ПолучитьСписокДокументовНаСервереSMARTS(ПустаяТаблица, ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу);
		Иначе
			СписокДокументов = КомЯдро_ПолучитьСписокДокументовНаСервереSMARTS(ПустаяТаблица, ТипБазы, РазмерВыборки, ОтборПоПериоду, ОтборПоУзлу);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокДокументов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СписокДокументов;
	
КонецФункции

#Область ЛокальныйКонтекст_ВозвратДокументаВРаботу

// Возвращает параметры возврата SMARTS-документа в работу.
//
// Возвращаемое значение:
//  Структура - параметры вызова, возможные свойства:
//   * ИдДокумента                   - Строка - идентификатор документа SMARTS.
//   * ШапкаДокумента                - Структура - шапка документа SMARTS.
//                                   - Неопределено - шапка документа не передана.
//   * ТипБазы                       - Строка - тип базы SMARTS.
//                                   - Неопределено - тип базы определяется автоматически.
//   * НазначениеДокумента           - Строка - назначение документа.
//                                   - Неопределено - документ выгружается всем.
//   * ТребуетсяВыборНазначения      - Булево - Истина, если требуется выбор назначения.
//   * ОповещениеОбработкиЗавершения - ОписаниеОповещения - обработчик результата возврата.
//
&НаКлиенте
Функция ЛокЯдро_ВозвратДокументаВРаботу_СтруктураПараметровВызова() Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("ИдДокумента", 				"");
	ПараметрыВызова.Вставить("ШапкаДокумента", 				Неопределено);
	ПараметрыВызова.Вставить("ТипБазы", 					Неопределено);
	ПараметрыВызова.Вставить("НазначениеДокумента", 		Неопределено);
	ПараметрыВызова.Вставить("ТребуетсяВыборНазначения", 	Ложь);
	ПараметрыВызова.Вставить("ОповещениеОбработкиЗавершения");
	
	Возврат ПараметрыВызова;
	
КонецФункции

// Проверяет возможность возврата SMARTS-документа в работу и запрашивает подтверждение пользователя.
//
// Параметры:
//  ПараметрыВозврата - Структура - параметры возврата, возможные свойства:
//   * ИдДокумента                   - Строка - идентификатор документа SMARTS.
//   * ШапкаДокумента                - Структура - шапка документа SMARTS.
//                                   - Неопределено - шапка документа не передана.
//   * ТипБазы                       - Строка - тип базы SMARTS.
//                                   - Неопределено - тип базы определяется автоматически.
//   * ОповещениеОбработкиЗавершения - ОписаниеОповещения - обработчик результата возврата.
//
&НаКлиенте
Процедура ЛокЯдро_ВозвратДокументаВРаботу_Начало(ПараметрыВозврата) Экспорт
	
	Если ПараметрыВозврата.ОповещениеОбработкиЗавершения = Неопределено Тогда
		ТекстОшибки = "ЛокЯдро_ВозвратДокументаВРаботу_Начало: Параметр ""ОповещениеОбработкиЗавершения"" обязателен для заполнения.";
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если ПараметрыВозврата.ШапкаДокумента <> Неопределено
		И ПараметрыВозврата.ШапкаДокумента.Свойство("СозданНаТСД")
		И ПараметрыВозврата.ШапкаДокумента.СозданНаТСД Тогда
		пСообщение = НСтр("ru = 'Документ, созданный на ТСД, нельзя вернуть в работу.'");
		Сообщить(пСообщение);
		Возврат;
	КонецЕсли;
	
	ДокументЗавершен = Ложь;
	Если ПараметрыВозврата.ШапкаДокумента <> Неопределено
		И ПараметрыВозврата.ШапкаДокумента.Свойство("Завершен") Тогда
		ДокументЗавершен = ПараметрыВозврата.ШапкаДокумента.Завершен;
	КонецЕсли;
	
	ДокументВРаботе = Ложь;
	Если ПараметрыВозврата.ШапкаДокумента <> Неопределено
		И ПараметрыВозврата.ШапкаДокумента.Свойство("ВОбработке") Тогда
		ДокументВРаботе = ПараметрыВозврата.ШапкаДокумента.ВОбработке;
	КонецЕсли;
	
	Если НЕ (ДокументЗавершен ИЛИ ДокументВРаботе) Тогда
		пСообщение = НСтр("ru = 'Документ уже находится в статусе «Выгружен».'");
		Сообщить(пСообщение);
		Возврат;
	КонецЕсли;
	
	пЗаголовок = НСтр("ru = 'Вернуть документ в работу на ТСД?'");
	ТекстВопроса = НСтр("ru = 'Документ будет возвращён в статус «Выгружен» и станет доступен на ТСД для взятия в работу.
								|Уже отсканированные строки товаров не будут очищены.'");
	
	ОП = Новый ОписаниеОповещения(
		"ЛокЯдро_ВозвратДокументаВРаботу_ВопросЗавершение",
		ЭтаФорма,
		ПараметрыВозврата);
	ПоказатьВопрос(ОП, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

// Обрабатывает ответ пользователя на вопрос о возврате SMARTS-документа в работу.
//
// Параметры:
//  Результат - КодВозвратаДиалога - результат ответа пользователя.
//  ПараметрыВозврата - Структура - параметры возврата, возможные свойства:
//   * ИдДокумента                   - Строка - идентификатор документа SMARTS.
//   * ШапкаДокумента                - Структура - шапка документа SMARTS.
//                                   - Неопределено - шапка документа не передана.
//   * ТипБазы                       - Строка - тип базы SMARTS.
//                                   - Неопределено - тип базы определяется автоматически.
//   * ОповещениеОбработкиЗавершения - ОписаниеОповещения - обработчик результата возврата.
//
&НаКлиенте
Процедура ЛокЯдро_ВозвратДокументаВРаботу_ВопросЗавершение(Результат, ПараметрыВозврата) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыНазначения 						= ЛокЯдро_ВозвратДокументаВРаботу_ПодготовитьНазначение(ПараметрыВозврата.ШапкаДокумента);
	ПараметрыВозврата.НазначениеДокумента 		= ПараметрыНазначения.НазначениеДокумента;
	ПараметрыВозврата.ТребуетсяВыборНазначения 	= ПараметрыНазначения.ТребуетсяВыборНазначения;
	
	Если ПараметрыНазначения.ТребуетсяВыборНазначения Тогда
		ОП = Новый ОписаниеОповещения(
			"ЛокЯдро_ВозвратДокументаВРаботу_ВыборНазначенияЗавершение",
			ЭтаФорма,
			ПараметрыВозврата);
		ЛокЯдро_ВозвратДокументаВРаботу_ОткрытьВыборНазначения(ПараметрыНазначения, ОП);
	Иначе
		ЛокЯдро_ВозвратДокументаВРаботу_ВыборНазначенияЗавершение(Неопределено, ПараметрыВозврата);
	КонецЕсли;
	
КонецПроцедуры

// Завершает выбор назначения и выполняет возврат SMARTS-документа в работу.
//
// Параметры:
//  РезультатВыбора - Массив - выбранные пользователи или устройства.
//                  - Неопределено - выбор назначения не выполнялся.
//  ПараметрыВозврата - Структура - параметры возврата, возможные свойства:
//   * ИдДокумента                   - Строка - идентификатор документа SMARTS.
//   * ТипБазы                       - Строка - тип базы SMARTS.
//                                   - Неопределено - тип базы определяется автоматически.
//   * НазначениеДокумента           - Строка - назначение документа.
//                                   - Неопределено - документ выгружается всем.
//   * ТребуетсяВыборНазначения      - Булево - Истина, если требуется выбор назначения.
//   * ОповещениеОбработкиЗавершения - ОписаниеОповещения - обработчик результата возврата.
//
&НаКлиенте
Процедура ЛокЯдро_ВозвратДокументаВРаботу_ВыборНазначенияЗавершение(РезультатВыбора, ПараметрыВозврата) Экспорт
	
	НазначениеДокумента = ПараметрыВозврата.НазначениеДокумента;
	
	Если ПараметрыВозврата.ТребуетсяВыборНазначения Тогда
		Если РезультатВыбора = Неопределено
			ИЛИ ТипЗнч(РезультатВыбора) <> Тип("Массив")
			ИЛИ РезультатВыбора.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если РезультатВыбора[0].Ид = "Выгружать всем" Тогда
			НазначениеДокумента = Неопределено;
		Иначе
			НазначениеДокумента = "";
			Для Каждого ВыбранноеНазначение Из РезультатВыбора Цикл
				Если НЕ ПустаяСтрока(НазначениеДокумента) Тогда
					НазначениеДокумента = НазначениеДокумента + "|";
				КонецЕсли;
				НазначениеДокумента = НазначениеДокумента + ВыбранноеНазначение.Ид;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ДокументВозвращен = ЛокЯдро_ВозвратДокументаВРаботу_ВернутьВРаботу(
		ПараметрыВозврата.ИдДокумента,
		ПараметрыВозврата.ТипБазы,
		НазначениеДокумента);
		
	ЛокЯдро_ВозвратДокументаВРаботу_Завершение(ДокументВозвращен, ПараметрыВозврата);
	
КонецПроцедуры

// Подготавливает параметры назначения документа при возврате SMARTS-документа в работу.
//
// Параметры:
//  ШапкаДокумента - Структура, Неопределено - шапка документа SMARTS.
//
// Возвращаемое значение:
//  Структура - параметры назначения, возможные свойства:
//   * ТребуетсяВыборНазначения - Булево - Истина, если пользователь должен выбрать назначение.
//   * НазначениеДокумента      - Строка, Неопределено - назначение без интерактивного выбора.
//   * СпособНазначения         - Строка - способ назначения из настройки бизнес-процесса.
//   * НазначенияMS             - Произвольный - доступные назначения для формы выбора.
//   * Заголовок                - Строка - заголовок формы выбора.
//
&НаКлиенте
Функция ЛокЯдро_ВозвратДокументаВРаботу_ПодготовитьНазначение(ШапкаДокумента)
	
	ПараметрыНазначения = Новый Структура;
	ПараметрыНазначения.Вставить("ТребуетсяВыборНазначения", 	Ложь);
	ПараметрыНазначения.Вставить("НазначениеДокумента", 		Неопределено);
	ПараметрыНазначения.Вставить("СпособНазначения", 			"");
	ПараметрыНазначения.Вставить("НазначенияMS", 				Неопределено);
	ПараметрыНазначения.Вставить("Заголовок", 					"");
	
	Возврат ПараметрыНазначения; // Временно отключено из-за ид пользователя в ид документа
	
	Если ШапкаДокумента = Неопределено
		ИЛИ НЕ ШапкаДокумента.Свойство("НастройкаБизнесПроцесса") Тогда
		Возврат ПараметрыНазначения;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов", Истина);
	Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") И НастройкаБП.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ НастройкаБП.Используется
			ИЛИ НастройкаБП.ID_БизнесПроцесса <> ШапкаДокумента.НастройкаБизнесПроцесса Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкаБП.НазначитьПользователю = "Спрашивать при выгрузке" Тогда
			СпособНазначения = ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
			ИмяДокумента = "";
			Если ШапкаДокумента.Свойство("Имя") Тогда
				ИмяДокумента = ШапкаДокумента.Имя;
			КонецЕсли;
			
			Если СпособНазначения = "Устройству" Тогда
				НазначенияMS 	= ЛокЯдро_ПолучитьМобильныеУстройстваSMARTS();
				НазначенияMS 	= ЛокЯдро_ПодготовитьДеревоУстройствНаСервере(НазначенияMS);
				ТекстЗаголовка 	= НСтр("ru = 'Выберите устройство для документа %1'");
			Иначе
				НазначенияMS = ЛокЯдро_ПодготовитьДеревоПользователейНаСервере(СтруктураМетаданных.ПользователиMS);
				ТекстЗаголовка = НСтр("ru = 'Выберите пользователя для документа %1'");
			КонецЕсли;
			
			ПараметрыНазначения.ТребуетсяВыборНазначения 	= Истина;
			ПараметрыНазначения.СпособНазначения 			= СпособНазначения;
			ПараметрыНазначения.НазначенияMS 				= НазначенияMS;
			ПараметрыНазначения.Заголовок 					= ЛокЯдро_СтрШаблон(ТекстЗаголовка, ИмяДокумента);
		Иначе
			Если НастройкаБП.НазначитьПользователю <> "Выгружать всем" Тогда
				ПараметрыНазначения.НазначениеДокумента = НастройкаБП.НазначитьПользователю;
			КонецЕсли;
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
	Возврат ПараметрыНазначения;
	
КонецФункции

// Открывает форму выбора назначения для возврата документа в работу.
//
// Параметры:
//  ПараметрыНазначения - Структура - параметры выбора, см. ЛокЯдро_ВозвратДокументаВРаботу_ПодготовитьНазначение.
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - обработчик результата выбора.
//
&НаКлиенте
Процедура ЛокЯдро_ВозвратДокументаВРаботу_ОткрытьВыборНазначения(ПараметрыНазначения, ОписаниеОповещенияОЗакрытии)
	
	ФормаВыбора = ЛокЯдро_ПолучитьФорму(
		"ФормаСлужебная_ВыборПользователяИлиГруппы",
		ЭтаФорма,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	ФормаВыбора.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаВыбора._ЛокКонтекст 					= ЭтаФорма;
	ФормаВыбора.Заголовок 						= ПараметрыНазначения.Заголовок;
	ФормаВыбора.ПользователиMSАдрес 			= ПараметрыНазначения.НазначенияMS;
	ФормаВыбора.ОдиночныйРежимВыделения 		= Истина;
	ФормаВыбора.СпособНазначения 				= ПараметрыНазначения.СпособНазначения;
	ФормаВыбора.ОписаниеОповещенияОЗакрытии 	= ОписаниеОповещенияОЗакрытии;
	
	Если ПараметрыНазначения.СпособНазначения = "Устройству" Тогда
		ТекстЗаголовкаГруппы = НСтр("ru = 'Устройство';
										|en = 'Device'; be = 'Прыстасаванне'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		ФормаВыбора.Элементы["ПользователиMSГруппаПользователь"].Заголовок = ТекстЗаголовкаГруппы;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаВыбора.ОткрытьМодально();
	#Иначе
		ФормаВыбора.Открыть();
	#КонецЕсли
	
КонецПроцедуры

// Возвращает SMARTS-документ в работу.
//
// Параметры:
//  ИдДокумента - Строка - идентификатор документа SMARTS.
//  ТипБазы - Строка, Неопределено - тип базы SMARTS.
//  НазначениеДокумента - Строка, Неопределено - назначение документа.
//
// Возвращаемое значение:
//  Булево - Истина, если шапка документа обновлена.
//
&НаКлиенте
Функция ЛокЯдро_ВозвратДокументаВРаботу_ВернутьВРаботу(ИдДокумента, ТипБазы = Неопределено, НазначениеДокумента = Неопределено)
	
	Если ТипБазы = Неопределено Тогда
		ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ИдДокумента", 		ИдДокумента);
		ПараметрыМетода.Вставить("ТипБазы", 			ТипБазы);
		ПараметрыМетода.Вставить("НазначениеДокумента", НазначениеДокумента);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ВозвратДокументаВРаботу_ВернутьВРаботу");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	КонецЕсли;
	
	ПоляШапки = Новый Соответствие;
	ПоляШапки.Вставить("finished", Ложь);
	ПоляШапки.Вставить("inProcess", Ложь);
	
	Если ЗначениеЗаполнено(НазначениеДокумента) Тогда
		ПоляШапки.Вставить("appointment", НазначениеДокумента);
	КонецЕсли;
	
	Возврат REST_API_ОбновитьШапкуДокументаSMARTS(ИдДокумента, ТипБазы, ПоляШапки);
	
КонецФункции

// Передает результат возврата SMARTS-документа обработчику завершения.
//
// Параметры:
//  ДокументВозвращен - Булево - Истина, если шапка документа обновлена.
//  ПараметрыВозврата - Структура - параметры возврата, возможные свойства:
//   * ОповещениеОбработкиЗавершения - ОписаниеОповещения - обработчик результата возврата.
//
&НаКлиенте
Процедура ЛокЯдро_ВозвратДокументаВРаботу_Завершение(ДокументВозвращен, ПараметрыВозврата)
	
	Если ДокументВозвращен Тогда
		пСообщение = НСтр("ru = 'Документ успешно возвращён в работу.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВозврата.ОповещениеОбработкиЗавершения, ДокументВозвращен);
	
КонецПроцедуры

#КонецОбласти // ЛокальныйКонтекст_ВозвратДокументаВРаботу

#Область ЛокальныйКонтекст_ВыгрузкаДокументов

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьИзОкнаОбмена(СтрокиДокументовТЗ, СписокИдДокументовMS, ПараметрыВызова) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьИзОкнаОбмена";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокиДокументовТЗ,СписокИдДокументовMS,ПараметрыВызова",
		СтрокиДокументовТЗ, СписокИдДокументовMS, ПараметрыВызова);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ОбработатьНаСервере = Ложь;
	ПерваяНастройкаБП = "";
	СтрокиДокументов1С = Новый Массив;
	Для каждого СтрокаТЗ Из СтрокиДокументовТЗ Цикл
		СтрокаДокумента = ЛокЯдро_ВыгрузкаДокументов_СтруктураСтрокиДокумента1С();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаТЗ);
		Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Ссылка_GUID)  Тогда
			ОбработатьНаСервере = Истина;
		КонецЕсли;
		СтрокиДокументов1С.Добавить(СтрокаДокумента);
	КонецЦикла;
	
	ИдДокументовMS = Новый Массив;
	Для каждого ЭлементСписка Из СписокИдДокументовMS Цикл
		ИдДокумента = ЭлементСписка.Значение;
		ПоложениеРазделителя = Найти(ИдДокумента,"#");
		Если ПоложениеРазделителя > 0 Тогда
			ИдДокумента = Лев(ИдДокумента, ПоложениеРазделителя - 1);
		КонецЕсли;
		ИдДокументовMS.Добавить(ИдДокумента);
	КонецЦикла;
	
	ПараметрыВыгрузки = ЛокЯдро_ВыгрузкаДокументов_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, ПараметрыВызова);
	ПараметрыВыгрузки.СтрокиДокументов1С = СтрокиДокументов1С;
	ПараметрыВыгрузки.ИдДокументовMS = ИдДокументовMS;
	
	Если ОбработатьНаСервере Тогда
		локПараметрыВыгрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыВыгрузки);
		локПараметрыВыгрузки.Удалить("ОповещениеОбработкиЗавершения");
		локПараметрыВыгрузки.Удалить("ОповещениеОбработкиОшибки");
		локПараметрыВыгрузки.Удалить("Форма");
		ЛокЯдро_ВыгрузкаДокументов_ОбработатьПараметрыВыгрузкиНаСервере(локПараметрыВыгрузки);
		ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, локПараметрыВыгрузки);
	КонецЕсли;
	
	ЛокЯдро_ВыгрузкаДокументов_Начало(ПараметрыВыгрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьПоМассивуДокументов(МассивДокументов, ПараметрыВызова) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьПоМассивуДокументов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивДокументов,ПараметрыВызова",
		МассивДокументов, ПараметрыВызова);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыВыгрузки = ЛокЯдро_ВыгрузкаДокументов_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, ПараметрыВызова);
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	Для каждого ДокументКВыгрузке Из МассивДокументов Цикл
		СтрокаДокумента = ЛокЯдро_ВыгрузкаДокументов_СтруктураСтрокиДокумента1С();
		СтрокаДокумента.Ссылка = ДокументКВыгрузке;
		СтрокиДокументов1С.Добавить(СтрокаДокумента);
	КонецЦикла;
		
	локПараметрыВыгрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыВыгрузки);
	локПараметрыВыгрузки.Удалить("ОповещениеОбработкиЗавершения");
	локПараметрыВыгрузки.Удалить("ОповещениеОбработкиОшибки");
	локПараметрыВыгрузки.Удалить("Форма");
	ЛокЯдро_ВыгрузкаДокументов_ОбработатьПараметрыВыгрузкиНаСервере(локПараметрыВыгрузки);
	ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, локПараметрыВыгрузки);
	
	ЛокЯдро_ВыгрузкаДокументов_Начало(ПараметрыВыгрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЛокЯдро_ВыгрузкаДокументов_ОбработатьПараметрыВыгрузкиНаСервере(ПараметрыВыгрузки)
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	
	Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
		Если ПустаяСтрока(СтрокаДокумента.Ссылка_GUID) Тогда
			СтрокаДокумента.Ссылка_GUID = XMLСтрока(СтрокаДокумента.Ссылка);
		КонецЕсли;
		Если ПустаяСтрока(СтрокаДокумента.ТипДокумента1С) Тогда
			СтрокаДокумента.ТипДокумента1С = СтрокаДокумента.Ссылка.Метаданные().Имя;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ВыгрузкаДокументов_СтруктураПараметровВызова() Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("СтрокиДокументов1С", Новый Массив);
	ПараметрыВызова.Вставить("ИдДокументовMS");
	ПараметрыВызова.Вставить("ID_Узла", "");
	ПараметрыВызова.Вставить("ВыгрузитьВОдин", Ложь);
	ПараметрыВызова.Вставить("ОповещениеОбработкиЗавершения"); // Обязательно для заполнения иначе ГлавнаяФорма может удалиться
	ПараметрыВызова.Вставить("ОповещениеОбработкиОшибки");
	ПараметрыВызова.Вставить("Форма");
	
	Возврат ПараметрыВызова;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВыгрузкаДокументов_СтруктураСтрокиДокумента1С()
	
	СтрокаДокумента = Новый Структура;
	СтрокаДокумента.Вставить("Ссылка");
	СтрокаДокумента.Вставить("Ссылка_GUID", "");
	СтрокаДокумента.Вставить("ТипДокумента1С", "");
	СтрокаДокумента.Вставить("НастройкаБизнесПроцесса", "");
	СтрокаДокумента.Вставить("НазначенныеПользователи");
	Возврат СтрокаДокумента;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_Начало(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_Начало";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	
	Если ПараметрыВыгрузки.ОповещениеОбработкиЗавершения = Неопределено Тогда
		ВызватьИсключение "ЛокЯдро_ВыгрузкаДокументов_Начало: Параметр ""ОповещениеОбработкиЗавершения"" обязателен для заполнения.";
	КонецЕсли;
	
	Если НЕ СтрокиДокументов1С.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для выгрузки.';
							|en = 'There are no selected documents to upload.'; be = 'Няма вылучаных дакументаў для выгрузкі.'; es = 'No hay documentos seleccionados para descargar.'; ka = 'ატვირთვის არჩეული დოკუმენტები არ არის.'; kk = 'Жүктеу үшін таңдалған құжаттар жоқ.'; ro = 'Nu există documente selectate de încărcat.'; tr = 'Yüklenecek seçili belge yok.'; uk = 'Немає обраних документів для вивантаження.'; uz = 'Yuklash uchun tanlangan hujjatlar yo''q.'");
		ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыВыгрузки.Свойство("ИдДокументовMS") ИЛИ ПараметрыВыгрузки.ИдДокументовMS = Неопределено Тогда
		
		ИдДокументовMS = Новый Массив;
		ДокументыMS = ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS();
		
		Для Каждого СтрокаТЗ Из ДокументыMS Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ИдДокумента = СтрокаТЗ.Ид;
			ПоложениеРазделителя = Найти(ИдДокумента,"#");
			Если ПоложениеРазделителя > 0 Тогда
				ИдДокумента = Лев(ИдДокумента, ПоложениеРазделителя - 1);
			КонецЕсли;
			ИдДокументовMS.Добавить(ИдДокумента);
		КонецЦикла;
		ПараметрыВыгрузки.Вставить("ИдДокументовMS", ИдДокументовMS);
		
	КонецЕсли;
	
	ЛокЯдро_ВыгрузкаДокументов_ПроверкаНаТСД(ПараметрыВыгрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ПроверкаНаТСД(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ПроверкаНаТСД";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	ИдДокументовMS = ПараметрыВыгрузки.ИдДокументовMS;
	
	ТекстВопроса = "";     
	ИсключаемыеДокументы = Новый Массив;
	
	ПерваяСтрока = Истина;
	Для Каждого ДокументСтрока Из СтрокиДокументов1С Цикл
		Если ИдДокументовMS.Найти(ДокументСтрока.Ссылка_GUID) <> Неопределено Тогда
			ТекстВопроса = ТекстВопроса + ?(ПерваяСтрока,"","," + Символы.ПС) + """" + Строка(ДокументСтрока.Ссылка) + """";
			ИсключаемыеДокументы.Добавить(ДокументСтрока);
			ПерваяСтрока = Ложь;	
		КонецЕсли;
	КонецЦикла;
	
	Если ТекстВопроса <> "" Тогда
		ПараметрыВыгрузки.Вставить("ИсключаемыеДокументы", ИсключаемыеДокументы);
		
		ШаблонВопроса = НСтр("ru = 'Документы: %1 Уже были выгружены на ТСД. Повторить выгрузку?';
								|en = 'Documents: %1 have already been uploaded to a Mobile device. Repeat the upload?';
								|be = 'Дакументы: %1 ўжо былі выгружаны на мабільную прыладу. Паўтарыць выгрузку?'; es = 'Documentos: %1 Ya se ha descargado en el dispositivo Móvil. ¿Volver a descargar?'; ka = 'დოკუმენტები: %1 უკვე ატვირთულია მობილურ მოწყობილობაზე. გაიმეორეთ ატვირთვა?'; kk = 'Құжаттар: %1 мобильді құрылғыға түсірілді. Жүктеуді қайталау керек пе?'; ro = 'Documente: %1 au fost deja încărcate pe un dispozitiv mobil. Repetați încărcarea?'; tr = 'Belgeler: % 1 Zaten Mobil cihaza yüklendi. Boşaltmayı tekrarlamak mı?'; uk = 'Документи: %1 вже були вивантажені на мобільний пристрій. Повторити вивантаження?'; uz = 'Hujjatlar: %1 allaqachon mobil qurilmaga tushirilgan. Yuklashni takrorlaysizmi?'");
		ТекстВопроса = ЛокЯдро_СтрШаблон(ШаблонВопроса, Символы.ПС + ТекстВопроса + "." + Символы.ПС);
		ОповещениеВопросПовторВыгрузки = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузкаДокументов_ВопросПовторнойВыгрузкиЗавершение", ЭтаФорма, ПараметрыВыгрузки);
		ПоказатьВопрос(ОповещениеВопросПовторВыгрузки, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЛокЯдро_ТекстВнимание()); 	
	Иначе
		ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьБизнесПроцессы(ПараметрыВыгрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВопросПовторнойВыгрузкиЗавершение(РезультатВопроса, ПараметрыВыгрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВопросПовторнойВыгрузкиЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВопроса,ПараметрыВыгрузки",
		РезультатВопроса, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПараметрыВыгрузки.Удалить("ИсключаемыеДокументы");
	Иначе
		НовыеСтрокиДокументов1С = Новый Массив;
		Для каждого СтрокаДокумента Из ПараметрыВыгрузки.СтрокиДокументов1С Цикл
			Если ПараметрыВыгрузки.ИсключаемыеДокументы.Найти(СтрокаДокумента) = Неопределено Тогда
				НовыеСтрокиДокументов1С.Добавить(СтрокаДокумента);
			КонецЕсли;
		КонецЦикла;
		ПараметрыВыгрузки.Вставить("СтрокиДокументов1С", НовыеСтрокиДокументов1С);
	КонецЕсли;	
	
	ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьБизнесПроцессы(ПараметрыВыгрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьБизнесПроцессы(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьБизнесПроцессы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыВыгрузки.Удалить("ИдДокументовMS");
	
	СтрокиДокументов1С 	= ПараметрыВыгрузки.СтрокиДокументов1С;
	ВыгрузитьВОдин		= ПараметрыВыгрузки.ВыгрузитьВОдин;
	ID_Узла 			= ПараметрыВыгрузки.ID_Узла;
	
	Если НЕ СтрокиДокументов1С.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для выгрузки.';
