// В MS склады были удалены с версии платформы MS 4
&НаКлиенте
Функция ЛокЯдро_ПроверитьИспользованиеСкладовSMARTS() Экспорт
	
	Результат = Истина;
	ВерсияПлатформы = 4;
	Если ПараметрыПодключенияMS <> Неопределено 
		И ПараметрыПодключенияMS.Свойство("ВерсияПлатформыSMARTS") Тогда
		
		ЧастиВерсии = ЛокЯдро_СтрРазделить(ПараметрыПодключенияMS.ВерсияПлатформыSMARTS, ".");
		Попытка
			Если ЧастиВерсии.Количество() 
				И Число(ЧастиВерсии[0]) >= ВерсияПлатформы Тогда
				Результат = Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

