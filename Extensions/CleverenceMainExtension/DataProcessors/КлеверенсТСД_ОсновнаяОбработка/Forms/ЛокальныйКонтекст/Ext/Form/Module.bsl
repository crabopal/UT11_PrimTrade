Процедура ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиПодключения() Экспорт

	ИмяСобытия = "ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиПодключения";

	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", ЛокЯдро_СтрШаблон("Начало открытия формы %1",
		СтрЗаменить(ИмяСобытия, "ЛокЯдро_ПроверитьОткрытиеФорм_", "")));
	
	ВремяНачалаПроверкиФормы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	////////////////////////////////////////////////////////////////////
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСлужебная_НастройкиПодключения",ЭтаФорма);
	#Иначе
		СтруктураПараметров = Новый Структура;
		ЭтоВебКлиент = Ложь;
		#Если ВебКлиент Тогда
			ЭтоВебКлиент = Истина;
		#КонецЕсли
        СтруктураПараметров.Вставить("ЭтоВебКлиент", ЭтоВебКлиент);

		ФормаНастройкиПодключения = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_НастройкиПодключения", СтруктураПараметров, ЭтаФорма, ЭтаФорма);
		ФормаНастройкиПодключения.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ФормаНастройкиПодключения.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне;
	#КонецЕсли
	
	СтруктураПараметров = Новый Структура("ПараметрыПодключения, Компонента, ТипИнтерфейса, РежимВыбораБазы");
	
	Если ЕстьЧастнаяБаза Тогда
		// Получаем настройки подключения частной базы из соответствующей переменной
		СтруктураПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("СтруктураПодключенияЧастнойБазыMS");
		Если СтруктураПодключенияMS <> Неопределено Тогда
			СтруктураПараметров.ПараметрыПодключения = СтруктураПодключенияMS.ОписаниеБазы;
		Иначе
			СтруктураПараметров.ПараметрыПодключения = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		КонецЕсли;		
	Иначе
		СтруктураПараметров.ПараметрыПодключения	= ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		СтруктураПараметров.Компонента				= ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		СтруктураПараметров.ТипИнтерфейса			= ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		СтруктураПараметров.РежимВыбораБазы			= ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РежимВыбораБазы");
	КонецЕсли;
	
	ID_ТекущейБазы = ПараметрыПодключенияMS.ИД;
	
	ФормаНастройкиПодключения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройкиПодключения._ЛокКонтекст 					= ЭтаФорма;
	ФормаНастройкиПодключения.ТипБазы						= ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	ФормаНастройкиПодключения.ПараметрыПодключения			= СтруктураПараметров.ПараметрыПодключения;
	ФормаНастройкиПодключения.Компонента					= СтруктураПараметров.Компонента;
	ФормаНастройкиПодключения.ТипИнтерфейса					= СтруктураПараметров.ТипИнтерфейса;
