&НаКлиенте
Процедура ЛокЯдро_ОбновлениеXML_ОбновитьCustomSettingsDflt(ПередаваемыеФайлы, ИдентификаторФормы, ПараметрыОбновления) Экспорт
	
	ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ЛокЯдро_ОбновлениеXML_ПослеПомещенияФайлаНаСервер", ЭтаФорма, ПараметрыОбновления);
	
	ПараметрыПомещения = Новый Структура;
	ПараметрыПомещения.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
	ЛокЯдро_РаботаСФайлами_ПоместитьФайлыНаСервер(ПередаваемыеФайлы, ИдентификаторФормы, ПараметрыПомещения);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеXML_ПослеПомещенияФайлаНаСервер(ПереданныеФайлы, ПараметрыОбновления) Экспорт
	
	Если ПереданныеФайлы = Неопределено 
		ИЛИ ПереданныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПереданныйФайл = ПереданныеФайлы[0];
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("АдресФайла", ПереданныйФайл.Хранение);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ОбновлениеXML_ОбновитьCustomSettingsDflt");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Результат = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь);
	
	ПараметрыОбновления.Вставить("РезультатОбновления", Результат);
	ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ЛокЯдро_ОбновлениеXML_Завершение", ЭтаФорма, ПараметрыОбновления);
	
	Если ПереданныйФайл.Хранение <> Результат.АдресФайла Тогда
		// Удаляем исходный файл из хранилища, если вдруг адрес поменялся
		Если ЭтоАдресВременногоХранилища(ПереданныйФайл.Хранение) Тогда
			УдалитьИзВременногоХранилища(ПереданныйФайл.Хранение);
		КонецЕсли;
	КонецЕсли;
	
	// Если файл изменен, то получаем его с сервера и сохраняем локально
	Если Результат.Изменен
		И ЭтоАдресВременногоХранилища(Результат.АдресФайла) Тогда
		
		ПередаваемыеФайлы = Новый Массив;
		ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПереданныйФайл.ПолноеИмя, Результат.АдресФайла));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
		
		ЛокЯдро_РаботаСФайлами_ПолучитьФайлыССервера(ПередаваемыеФайлы, ДополнительныеПараметры);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеОбработкиЗавершения, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеXML_Завершение(ПолученныеФайлы, ПараметрыОбновления) Экспорт
	
	// Удаляем файл из хранилища
	Если ЭтоАдресВременногоХранилища(ПараметрыОбновления.РезультатОбновления.АдресФайла) Тогда
		УдалитьИзВременногоХранилища(ПараметрыОбновления.РезультатОбновления.АдресФайла);
	КонецЕсли;
	
	Если ПолученныеФайлы <> Неопределено
		И ПолученныеФайлы.Количество() Тогда
		ПолученныйФайл = ПолученныеФайлы[0];
		Если ЭтоАдресВременногоХранилища(ПолученныйФайл.Хранение) Тогда
			УдалитьИзВременногоХранилища(ПолученныйФайл.Хранение);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыОбновления.Свойство("ОповещениеОбработкиЗавершения") Тогда
		Если ПолученныеФайлы = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ПараметрыОбновления.ОповещениеОбработкиЗавершения, Ложь);
		Иначе
			ВыполнитьОбработкуОповещения(ПараметрыОбновления.ОповещениеОбработкиЗавершения, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_АнализXML_ПроверитьCustomSettingsDflt(ПередаваемыеФайлы, ИдентификаторФормы) Экспорт
	
	ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ЛокЯдро_АнализXML_ПослеПомещенияФайловНаСервер", ЭтаФорма);
	
	ПараметрыПомещения = Новый Структура;
	ПараметрыПомещения.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
	ЛокЯдро_РаботаСФайлами_ПоместитьФайлыНаСервер(ПередаваемыеФайлы, ИдентификаторФормы, ПараметрыПомещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_АнализXML_ПослеПомещенияФайловНаСервер(ПереданныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПереданныеФайлы = Неопределено 
		ИЛИ ПереданныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ПереданныеФайлы", ПереданныеФайлы);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Процедура");
	СтруктураВызова.Вставить("ИмяМетода", 		"АнализXML_ПроверитьCustomSettingsDflt");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь);
	
	Для каждого ОписаниеФайла Из ПереданныеФайлы Цикл
		
		Если ЭтоАдресВременногоХранилища(ОписаниеФайла.Хранение) Тогда
			УдалитьИзВременногоХранилища(ОписаниеФайла.Хранение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Логирование

// Открывает поток логирования. Поток является корневым элементом иерархии логов.
// Вложенные потоки запрещены. Состояние хранится в клиентских переменных формы.
//
// Параметры:
//  ИмяПотока - Строка - идентификатор потока, отображаемый в логах.
//  Модуль    - Произвольный - источник вызова. Если не указан, используется ЭтаФорма.
//
// Возвращаемое значение:
//  Структура - открытый поток (Ид, ИдРодителя, Имя, ВремяНачала, Модуль).
//  Неопределено - логирование отключено или поток уже открыт.
//
&НаКлиенте
Функция ЛогОткрытьПоток(ИмяПотока, Модуль = Неопределено) Экспорт
	
	Если НЕ Логирование_ИспользоватьЛогирование() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Логирование_ПотокОткрыт() Тогда
		// Запрещаем открытие второго/вложенного потока
		// Вложенность потоков доступна только для ФЗ
		Возврат Неопределено;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// TODO: Сделать получение имени формы в ОФ
		Если Модуль = Неопределено Тогда
			ИмяМодуля = ЭтаФорма.Заголовок;
		Иначе
			ИмяМодуля = Модуль.Заголовок;
		КонецЕсли;
	#Иначе
		Если Модуль = Неопределено Тогда
			ИмяМодуля = ЭтаФорма.ИмяФормы;
		Иначе
			ИмяМодуля = Модуль.ИмяФормы;
		КонецЕсли;
	#КонецЕсли
	
	Попытка
		
		ИдПотока = Строка(Новый УникальныйИдентификатор);
		
		Поток = Новый Структура;
		Поток.Вставить("Ид", ИдПотока);
		Поток.Вставить("ИдРодителя");
		Поток.Вставить("Имя", 					ИмяПотока);
		Поток.Вставить("ВремяНачала", 			ТекущаяУниверсальнаяДатаВМиллисекундах());
		Поток.Вставить("Модуль", 				ИмяМодуля);
		Поток.Вставить("КонтекстСеансаКлиент", 	Логирование_ПолучитьКонтекстСеанса());
		Поток.Вставить("КонтекстСеансаСервер");
		
		КэшЛогБуферЗаписейКлиент = Новый Массив;
		КэшЛогСтекСобытий = Новый Массив;
		КэшЛогРежимОтладкиES = Неопределено;
		КэшЛогОжидаетПервоеСобытие = Истина;
		
		КомЯдро_СохранитьЗначениеПеременной("ЛогПоток", Поток);
		КомЯдро_СохранитьЗначениеПеременной("ЛогБуферЗаписейСервер", Новый Массив);
		КомЯдро_СохранитьЗначениеПеременной("ЛогСтекСобытий", Новый Массив);
		КомЯдро_СохранитьЗначениеПеременной("ЛогБылиОшибки", Ложь);
		
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "flow_started";
		ЗаписьЛога.ИдРодителя 	= Неопределено;
		ЗаписьЛога.ИдСобытия 	= ИдПотока;
		ЗаписьЛога.Модуль 		= Поток.Модуль;
		ЗаписьЛога.Длительность = Неопределено;
		ЗаписьЛога.Уровень 		= "Информация";
		ЗаписьЛога.Сообщение 	= ИмяПотока;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога);
		
		КэшЛогПотокОткрыт = Истина;
		
		ПодключитьОбработчикОжидания("Логирование_ПроверитьНезавершенныйПоток", 0.1, Истина);
		
		Возврат Поток;
		
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогОткрытьПоток", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Закрывает поток логирования и выполняет flush буфера записей.
// Сбрасывает клиентский кэш буфера, стека событий и состояние потока.
//
// Параметры:
//  логПоток - Структура - поток, полученный из ЛогОткрытьПоток.
//
&НаКлиенте
Процедура ЛогЗакрытьПоток(логПоток, ПринудительноеЗакрытие = Ложь) Экспорт
	
	// Защита от закрытия чужого потока
	Если логПоток = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поток = Логирование_ПолучитьПоток();
	Если Поток = Неопределено
		ИЛИ логПоток.Ид <> Поток.Ид Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "flow_finished";
		ЗаписьЛога.ИдРодителя 	= Поток.ИдРодителя;
		ЗаписьЛога.ИдСобытия 	= Поток.Ид;
		ЗаписьЛога.Модуль 		= Поток.Модуль;
		ЗаписьЛога.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() -Поток.ВремяНачала;
		
		Если ПринудительноеЗакрытие Тогда
			ЗаписьЛога.Уровень = "Ошибка";
			ЗаписьЛога.Сообщение = Поток.Имя + " [ПринудительноеЗакрытие]";
		Иначе
			ЗаписьЛога.Уровень = "Информация";
			ЗаписьЛога.Сообщение = Поток.Имя;
		КонецЕсли;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога);
		
		КэшЛогПотокОткрыт = Ложь;
		КэшЛогОжидаетПервоеСобытие = Ложь;
		
		КомЯдро_СохранитьЗначениеПеременной("ЛогПоток", Неопределено);
		КомЯдро_СохранитьЗначениеПеременной("ЛогПотокФЗ", Неопределено);
		
		ЛокЯдро_Логирование_ЗаписатьБуферЗаписей(логПоток);
		
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗакрытьПоток", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	КэшЛогПотокОткрыт = Ложь;
	ОтключитьОбработчикОжидания("Логирование_ПроверитьНезавершенныйПоток");
	
	Попытка
		КэшЛогБуферЗаписейКлиент = Новый Массив;
		КэшЛогСтекСобытий = Новый Массив;
		
		КомЯдро_СохранитьЗначениеПеременной("ЛогПоток", Неопределено);
		КомЯдро_СохранитьЗначениеПеременной("ЛогПотокФЗ", Неопределено);
		КомЯдро_СохранитьЗначениеПеременной("ЛогБылиОшибки", Неопределено);
		КомЯдро_СохранитьЗначениеПеременной("ЛогБуферЗаписейСервер", Новый Массив);
		КомЯдро_СохранитьЗначениеПеременной("ЛогСтекСобытий", Новый Массив);
	Исключение
	КонецПопытки;
		
КонецПроцедуры

// Начинает событие внутри открытого потока логирования. В режиме ТолькоОшибки первое событие потока
// материализуется и добавляется в стек сразу, остальные события - только при записи ошибки.
//
// Параметры:
//  ИмяСобытия - Строка - наименование события.
//  Контекст   - Произвольный - контекстные данные события.
//  Модуль     - Произвольный - источник вызова. Если не указан, используется ЭтаФорма.
//
// Возвращаемое значение:
//  Структура - событие (Ид, Имя, ИдРодителя, ВремяНачала, Модуль, Материализовано).
//  Неопределено - поток не открыт.
//
&НаКлиенте
Функция ЛогНачатьСобытие(ИмяСобытия, Контекст = Неопределено, Модуль = Неопределено) Экспорт
	
	Попытка
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			// TODO: Сделать получение имени формы в ОФ
			Если Модуль = Неопределено Тогда
				ИмяМодуля = ЭтаФорма.Заголовок;
			Иначе
				ИмяМодуля = Модуль.Заголовок;
			КонецЕсли;
		#Иначе
			Если Модуль = Неопределено Тогда
				ИмяМодуля = ЭтаФорма.ИмяФормы;
			Иначе
				ИмяМодуля = Модуль.ИмяФормы;
			КонецЕсли;
		#КонецЕсли
		
		Событие = Новый Структура;
		Событие.Вставить("Имя", 		ИмяСобытия);
		Событие.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
		Событие.Вставить("ПотокОткрыт", Ложь);
		Событие.Вставить("Модуль", 		ИмяМодуля);
		
		Если НЕ Логирование_ПотокОткрыт() Тогда
			Возврат Событие;
		КонецЕсли;
		
		Событие.Вставить("Ид", Строка(Новый УникальныйИдентификатор));
		
		ИдРодителя = Логирование_ПолучитьПоследнееСобытиеСтека();
		Событие.Вставить("ИдРодителя", ИдРодителя);
		Событие.Вставить("ПотокОткрыт", Истина);
		Событие.Вставить("Контекст", Контекст);
		Событие.Вставить("Материализовано", Ложь);
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES();
		Если РежимОтладки = "ТолькоОшибки" Тогда
			
			Если КэшЛогОжидаетПервоеСобытие = Истина Тогда
				// Материализуем первое событие потока для контекста входных параметров
				Логирование_ЗаписатьНачалоСобытия(Событие);
				КэшЛогОжидаетПервоеСобытие = Ложь;
			КонецЕсли;
			
			Возврат Событие;
		КонецЕсли;
		
		Логирование_ЗаписатьНачалоСобытия(Событие);
		
		Возврат Событие;
	
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогНачатьСобытие", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Завершает ранее начатое событие. Записывает длительность выполнения
// и удаляет событие из стека вместе со всеми незакрытыми дочерними.
//
// Параметры:
//  Событие  - Структура - событие, полученное из ЛогНачатьСобытие.
//  Контекст - Произвольный - контекстные данные завершения.
//
&НаКлиенте
Процедура ЛогЗавершитьСобытие(Событие, Контекст = Неопределено) Экспорт
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если НЕ Событие.ПотокОткрыт Тогда
			Возврат;
		КонецЕсли;
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES();
		Если РежимОтладки = "ТолькоОшибки" И НЕ Событие.Материализовано Тогда
			Возврат;
		КонецЕсли;
		
		// Пишем длительность выполнения в лог начала события
		ЗаписьЛога 				= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 	= "event_finished";
		ЗаписьЛога.ИдРодителя 	= Событие.ИдРодителя;
		ЗаписьЛога.ИдСобытия 	= Событие.Ид;
		ЗаписьЛога.Модуль 		= Событие.Модуль;
		ЗаписьЛога.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() -Событие.ВремяНачала;
		ЗаписьЛога.Уровень 		= "Информация";
		ЗаписьЛога.Сообщение 	= Событие.Имя;
		
		Если Контекст <> Неопределено Тогда
			ЗаписьЛога.Вставить("Контекст", Контекст);
		КонецЕсли;
		
		Логирование_ЗаписатьЛог(ЗаписьЛога);
		
		// Удаление из стека
		ЛогСтекСобытий = КэшЛогСтекСобытий;
		
		Инд = ЛогСтекСобытий.ВГраница();
		Пока Инд >= 0 Цикл
		
			Если ЛогСтекСобытий[Инд] = Событие.Ид Тогда
				ЛогСтекСобытий.Удалить(Инд);
				Прервать;
			Иначе
				ЛогСтекСобытий.Удалить(Инд);
			КонецЕсли;
			
			Инд = Инд - 1;
		
		КонецЦикла;
		
		КэшЛогСтекСобытий = ЛогСтекСобытий;
	
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗавершитьСобытие", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Записывает информационное сообщение в лог текущего события.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛогИнфо(Событие, Сообщение, СообщениеШаблон, Контекст = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЛогЗаписать("Информация", Событие, Сообщение, СообщениеШаблон, Контекст,, ДополнительныеПараметры);
	
КонецПроцедуры

// Записывает предупреждение в лог текущего события.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛогПредупреждение(Событие, Сообщение, СообщениеШаблон, Контекст = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЛогЗаписать("Предупреждение", Событие, Сообщение, СообщениеШаблон, Контекст,, ДополнительныеПараметры);
	
КонецПроцедуры

// Записывает ошибку в лог текущего события. При наличии информации об ошибке
// формирует структуру с описанием, модулем, строкой, причиной и стеком вызовов.
//
// Параметры:
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ИнформацияОбОшибке     - ИнформацияОбОшибке, Строка - детали ошибки.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛогОшибка(Событие, Сообщение = "", СообщениеШаблон = "", Контекст = Неопределено, ИнформацияОбОшибке = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЛогЗаписать("Ошибка", Событие, Сообщение, СообщениеШаблон, Контекст, ИнформацияОбОшибке, ДополнительныеПараметры);
	
КонецПроцедуры

// Записывает сообщение указанного уровня в лог текущего события. Извлекает русскоязычный
// текст из многоязычной строки, формирует структуру ошибки для уровня "Ошибка".
//
// Параметры:
//  Уровень                - Строка - уровень записи: "Информация", "Предупреждение", "Ошибка".
//  Событие                - Структура - текущее событие из ЛогНачатьСобытие.
//  Сообщение              - Строка - текст сообщения.
//  СообщениеШаблон        - Строка - шаблон сообщения с локализацией (НСтр).
//  Контекст               - Произвольный - контекстные данные.
//  ИнформацияОбОшибке     - ИнформацияОбОшибке, Строка - детали ошибки для уровня "Ошибка".
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛогЗаписать(Уровень, Событие, Сообщение, Знач СообщениеШаблон, Контекст = Неопределено, ИнформацияОбОшибке = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ИнфоДиагностика = Новый Соответствие;
		Если Событие.ПотокОткрыт Тогда
			ИнфоДиагностика.Вставить("Ид события", Событие.Ид);
		КонецЕсли;
		ИнфоДиагностика.Вставить("Событие", Событие.Имя);
		ИнфоДиагностика.Вставить("Модуль", Событие.Модуль);
		
		ДопПараметрыЖР = Новый Структура;
		ДопПараметрыЖР.Вставить("ИнфоДиагностика", ИнфоДиагностика);
		
		// Запись в ЖР
		Если Уровень = "Ошибка" И ИнформацияОбОшибке <> Неопределено Тогда
			
			Если ТипЗнч(ИнформацияОбОшибке) = Тип("Строка") Тогда
				ТекстОшибкиЖР = ИнформацияОбОшибке;
			Иначе
				ТекстОшибкиЖР = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			КонецЕсли;
			
			СообщениеЖР = НСтр("ru = 'Ошибка:'");
			СообщениеЖР = СокрЛП(Сообщение + Символы.ПС + СообщениеЖР + Символы.ПС + ТекстОшибкиЖР);
			
		Иначе
			СообщениеЖР = Сообщение;
		КонецЕсли;
		
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(Событие.Имя, Уровень, СообщениеЖР, Событие.ВремяНачала, ДопПараметрыЖР);
		
		Если НЕ Событие.ПотокОткрыт Тогда
			Возврат;
		КонецЕсли;
		
		РежимОтладки = Логирование_ПолучитьРежимОтладкиES();
		Если РежимОтладки = "ТолькоОшибки" Тогда
			Если Уровень <> "Ошибка" Тогда
				Возврат;
			КонецЕсли;
			Логирование_ЗаписатьНачалоСобытия(Событие);
		КонецЕсли;
		
		// Проверяем, что текст с локализацией и логируем только на RU
		пСообщениеШаблон = ВРег(СтрЗаменить(СообщениеШаблон, " ", ""));
		Если Найти(пСообщениеШаблон, "RU=") > 0 Тогда
			СообщениеШаблон = НСтр(СообщениеШаблон, "ru");
		КонецЕсли;
		
		ЗаписьЛога 					= Логирование_НоваяЗапись();
		ЗаписьЛога.ТипСобытия 		= "step";
		ЗаписьЛога.ИдРодителя 		= Событие.ИдРодителя;
		ЗаписьЛога.ИдСобытия 		= Событие.Ид;
		ЗаписьЛога.Модуль 			= Событие.Модуль;
		ЗаписьЛога.Уровень 			= Уровень;
		ЗаписьЛога.Сообщение 		= Сообщение;
		ЗаписьЛога.СообщениеШаблон 	= СообщениеШаблон;
		ЗаписьЛога.Контекст 		= Контекст;
		
		Если Уровень = "Ошибка" Тогда
			
			КомЯдро_СохранитьЗначениеПеременной("ЛогБылиОшибки", Истина);
			
			Если ИнформацияОбОшибке <> Неопределено Тогда
				
				СтруктураОшибки = Новый Структура("message, module, line, source_line, cause, stack_trace");
				
				Если ТипЗнч(ИнформацияОбОшибке) = Тип("Строка") Тогда
					СтруктураОшибки.message = ИнформацияОбОшибке;
				Иначе
					СтруктураОшибки.message 	= ИнформацияОбОшибке.Описание;
					СтруктураОшибки.module 		= ИнформацияОбОшибке.ИмяМодуля;
					СтруктураОшибки.line 		= ИнформацияОбОшибке.НомерСтроки;
					СтруктураОшибки.source_line = ИнформацияОбОшибке.ИсходнаяСтрока;
					СтруктураОшибки.stack_trace = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
					
					Если ИнформацияОбОшибке.Причина <> Неопределено Тогда
						СтруктураОшибки.Вставить("cause", ИнформацияОбОшибке.Причина.Описание);
					КонецЕсли;
					
				КонецЕсли;
				
				ЗаписьЛога.Ошибка = СтруктураОшибки;
				
				Если ПустаяСтрока(ЗаписьЛога.Сообщение)
					И ЗначениеЗаполнено(СтруктураОшибки.message) Тогда
					ЗаписьЛога.Сообщение = СокрЛП(СтруктураОшибки.message);
				КонецЕсли;
				
				Если ПустаяСтрока(ЗаписьЛога.СообщениеШаблон)
					И ЗначениеЗаполнено(ЗаписьЛога.Сообщение) Тогда
					ЗаписьЛога.СообщениеШаблон = ЗаписьЛога.Сообщение;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЛогАктуализироватьСтекСобытий(Событие);
		Логирование_ЗаписатьЛог(ЗаписьЛога);
		
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.ЛогЗаписать", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Формирует аргументы контекста метода для записи в лог.
//
// Параметры:
//  ИмяСобытия             - Строка - имя события для особой обработки контекста.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//  ИменаПараметров        - Строка - имена параметров через запятую для сопоставления с Парам1..Парам9.
//  Парам1                 - Произвольный - значение параметра контекста.
//  Парам2..Парам9         - Произвольный - дополнительные значения параметров контекста.
//
// Возвращаемое значение:
//  Структура, Неопределено - аргументы ЛогОписатьКонтекст для отложенного формирования контекста.
//
&НаКлиенте
Функция ЛогОписатьКонтекст(ИмяСобытия, ДополнительныеПараметры = Неопределено,
	ИменаПараметров = "",
	Парам1,
	Парам2 = Неопределено,
	Парам3 = Неопределено,
	Парам4 = Неопределено,
	Парам5 = Неопределено,
	Парам6 = Неопределено,
	Парам7 = Неопределено,
	Парам8 = Неопределено,
	Парам9 = Неопределено,
	Парам10 = Неопределено,
	Парам11 = Неопределено,
	Парам12 = Неопределено,
	Парам13 = Неопределено,
	Парам14 = Неопределено,
	Парам15 = Неопределено,
	Парам16 = Неопределено,
	Парам17 = Неопределено,
	Парам18 = Неопределено,
	Парам19 = Неопределено,
	Парам20 = Неопределено) Экспорт
	
	Если КэшЛогПотокОткрыт = Ложь Тогда
		// TODO: Временное решение, т.к КэшЛогПотокОткрыт может быть не инициализирована.
		Возврат Неопределено;		
	КонецЕсли;
	
	Попытка
	
		ПараметрыКонтекста = Новый Массив;
		ПараметрыКонтекста.Добавить(Парам1);
		ПараметрыКонтекста.Добавить(Парам2);
		ПараметрыКонтекста.Добавить(Парам3);
		ПараметрыКонтекста.Добавить(Парам4);
		ПараметрыКонтекста.Добавить(Парам5);
		ПараметрыКонтекста.Добавить(Парам6);
		ПараметрыКонтекста.Добавить(Парам7);
		ПараметрыКонтекста.Добавить(Парам8);
		ПараметрыКонтекста.Добавить(Парам9);
		ПараметрыКонтекста.Добавить(Парам10);
		ПараметрыКонтекста.Добавить(Парам11);
		ПараметрыКонтекста.Добавить(Парам12);
		ПараметрыКонтекста.Добавить(Парам13);
		ПараметрыКонтекста.Добавить(Парам14);
		ПараметрыКонтекста.Добавить(Парам15);
		ПараметрыКонтекста.Добавить(Парам16);
		ПараметрыКонтекста.Добавить(Парам17);
		ПараметрыКонтекста.Добавить(Парам18);
		ПараметрыКонтекста.Добавить(Парам19);
		ПараметрыКонтекста.Добавить(Парам20);
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяСобытия", 				ИмяСобытия);
		Результат.Вставить("ДополнительныеПараметры", 	ДополнительныеПараметры);
		Результат.Вставить("ИменаПараметров", 			ИменаПараметров);
		Результат.Вставить("ПараметрыКонтекста", 		ПараметрыКонтекста);
		
		Возврат Результат;
	
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Актуализирует стек событий, удаляя незакрытые дочерние события.
// Если текущее событие не на вершине стека, все записи до него удаляются.
//
// Параметры:
//  Событие - Структура - текущее событие.
//
&НаКлиенте
Процедура ЛогАктуализироватьСтекСобытий(Событие)
	
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Событие.ПотокОткрыт Тогда
		Возврат;
	КонецЕсли;
	
	ЛогСтекСобытий = КэшЛогСтекСобытий;
	
	Если ЛогСтекСобытий.Количество() Тогда
		ПоследнийСтек = ЛогСтекСобытий[ЛогСтекСобытий.ВГраница()];
	КонецЕсли;
	
	Если ПоследнийСтек <> Событие.Ид Тогда
		
		Инд = ЛогСтекСобытий.ВГраница();
		Пока Инд >= 0 Цикл
			
			Если ЛогСтекСобытий[Инд] = Событие.Ид Тогда
				Прервать;
			Иначе
				ЛогСтекСобытий.Удалить(Инд);
			КонецЕсли;
			
			Инд = Инд - 1;
			
		КонецЦикла;
		
		Если ЛогСтекСобытий.Количество() = 0 Тогда
			ЛогСтекСобытий.Добавить(Событие.Ид);
		КонецЕсли;
		
		КэшЛогСтекСобытий = ЛогСтекСобытий;
		
	КонецЕсли;
	
КонецПроцедуры 

#Область Логирование_СлужебныйПрограммныйИнтерфейс

// Собирает кэш логирования для передачи в серверный транзит: структуру с
// идентификатором родительского события из клиентского стека. Серверные события,
// порождённые вызовом, будут привязаны к этому родителю.
//
// Параметры:
//  пАдресаПеременных - Структура - см. КомЯдро_СоздатьСтруктуруАдресаПеременных.
//  ЭтоФЗ             - Булево - Истина при подготовке вызова фонового задания: дополнительно
//                                резервируется адрес временного хранилища под буфер логов ФЗ.
//
// Возвращаемое значение:
//  Структура - кэш логирования, возможные свойства:
//   * ЛогСтекСобытий   - Массив - стек из одного элемента — идентификатора родительского события.
//   * АдресЛогБуфераФЗ - Строка - адрес временного хранилища со структурой состояния логирования
//                                 фонового задания (только при ЭтоФЗ = Истина).
//  Неопределено - синхронный режим и поток логирования не открыт, адреса переменных не переданы
//                 или стек пуст. В режиме ЭтоФЗ всегда возвращает структуру хотя бы
//                 с АдресЛогБуфераФЗ.
//
&НаКлиенте
Функция ЛокЯдро_Логирование_ПеренестиКэшЛогированияНаСервер(пАдресаПеременных, ЭтоФЗ = Ложь)
	
	ИмяСобытия = "ЛокЯдро_Логирование_ПеренестиКэшЛогированияНаСервер";
	
	КэшЛогирования = Неопределено;
	
	Если пАдресаПеременных <> Неопределено
		И Логирование_ПотокОткрыт() Тогда
		
		ИдРодителя = Логирование_ПолучитьПоследнееСобытиеСтека();
		Если ИдРодителя <> Неопределено Тогда
			ЛогСтекСобытийСервер = Новый Массив;
			ЛогСтекСобытийСервер.Добавить(ИдРодителя);
			КэшЛогирования = Новый Структура("ЛогСтекСобытий", ЛогСтекСобытийСервер);
		КонецЕсли;
		
	КонецЕсли;
	
	// TODO: Найти способ сохранять накопленные логи при падении ФЗ без замедления выполнения.
	// Механизм временно отключён: постоянная перезапись значения во временном хранилище
	// вызывает синхронизацию клиент-сервер и заметно замедляет ФЗ с большим количеством логов.
	ЭтоФЗ = Ложь;
	Если ЭтоФЗ Тогда
		Если КэшЛогирования = Неопределено Тогда
			КэшЛогирования = Новый Структура;
		КонецЕсли;
		
		// Резерв адреса временного хранилища под структуру состояния логирования фонового задания.	
		АдресЛогБуфераФЗ = ПоместитьВоВременноеХранилище(Неопределено, АдресаПеременных.ИдентификаторФормы);
		КэшЛогирования.Вставить("АдресЛогБуфераФЗ", АдресЛогБуфераФЗ);
		
	КонецЕсли;
	
	Возврат КэшЛогирования;
	
КонецФункции

// Запускает в фоновом задании пересылку накопленных лог-сообщений в Elasticsearch.
// Срабатывает только при активном режиме "НакапливатьSMARTS_ПриОткрытии"
// и доступности фоновых заданий.
//
&НаКлиенте
Процедура ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФоне() Экспорт
	
	Если НЕ ДоступноВыполнениеВФоне Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы");
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;
	
	Режим = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ЛогРежимОтправкиES_" + ИдентификаторБазыMS);
	
	Если Режим <> "НакапливатьSMARTS_ПриОткрытии" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);
	
	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ИмяМетода", 					"ГлЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearch");
	ПараметрыФЗ.Вставить("ПараметрыМетода", 			ПараметрыМетода);
	ПараметрыФЗ.Вставить("НаименованиеФЗ", 				"Клеверенс: Переслать накопленные логи в Elasticsearch");
	ПараметрыФЗ.Вставить("ТекстСообщения", 				"Клеверенс: Переслать накопленные логи в Elasticsearch");
	ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 		Ложь);
	ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 	Ложь);
	ПараметрыФЗ.Вставить("ЗапускВФоне", 				Истина);
	
	ОписаниеОповещенияЗавершенияФЗ = Новый ОписаниеОповещения("ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеЗавершение", ЭтаФорма);
	ОписаниеОповещенияОшибкиФЗ = Новый ОписаниеОповещения("ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеОшибка", ЭтаФорма);
	
	ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
	
КонецПроцедуры

// Обработчик успешного завершения фонового задания пересылки лог-сообщений в Elasticsearch.
//
// Параметры:
//  Результат               - Произвольный - результат фонового задания.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеЗавершение";
	
	пСообщение = НСтр("ru = 'Проверка ошибок в фоне успешно выполнена.';
						|en = 'Background error checking has been completed successfully.'; be = 'Праверка памылак у фоне паспяхова выканана.'; es = 'La comprobación de errores en segundo plano se realizó correctamente.'; ka = 'ფონის შეცდომის შემოწმება წარმატებით დასრულდა.'; kk = 'Фонда қателерді тексеру сәтті аяқталды.'; ro = 'Verificarea erorilor de fundal a fost finalizată cu succes.'; tr = 'Arka plandaki hataları kontrol etmek başarıyla gerçekleştirildi.'; uk = 'Перевірка помилок в тлі успішно виконана.'; uz = 'Orqa fonda xatolarni tekshirish muvaffaqiyatli yakunlandi.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Информация", пСообщение);
	
КонецПроцедуры

// Обработчик ошибки фонового задания пересылки лог-сообщений в Elasticsearch.
//
// Параметры:
//  Результат               - Строка - текст ошибки.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
&НаКлиенте
Процедура ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеОшибка(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФонеОшибка";
	
	ТекстОшибки = Результат;
	
	ТекстСообщения = НСтр("ru = 'Ошибка отправки логов из SMARTS в Elasticsearch:%1%2'");
	ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, Символы.ПС, ТекстОшибки);
	
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", ТекстСообщения);
	
КонецПроцедуры

// Устанавливает клиентский режим отправки лог-сообщений в Elasticsearch в "Прямой".
//
&НаКлиенте
Процедура ЛокЯдро_Логирование_ОпределитьРежимОтправкиES()
	
	// Если на клиенте, то только прямые вызовы
	Если РасположениеКомпоненты = "НаКлиенте" Тогда
		НовыйРежим = "Прямой";
	КонецЕсли;
	НовыйРежим = "Прямой";
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы");
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;
	
	КлючРежима = "Cleverence_ЛогРежимОтправкиES_" + ИдентификаторБазыMS;
	Режим = ЛокЯдро_ПолучитьДанныеИзХранилища1С(КлючРежима);
	Если Режим <> НовыйРежим Тогда
		ЛокЯдро_СохранитьДанныеВХранилище1С(КлючРежима, НовыйРежим);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Логирование_СлужебныеПроцедурыИФункции

// Обработчик ожидания: автоматически закрывает поток логирования, если по завершении
// клиентского вызова он не был закрыт явным вызовом ЛогЗакрытьПоток.
//
&НаКлиенте
Процедура Логирование_ПроверитьНезавершенныйПоток()
	
	Попытка
		
		ТекущийПоток = Логирование_ПолучитьПоток();
		Если ТекущийПоток <> Неопределено Тогда
			Логирование_ПринудительноЗакрытьПоток(ТекущийПоток);
		КонецЕсли;
		
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование.Логирование_ПроверитьНезавершенныйПоток", "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Принудительно закрывает поток логирования. Событие flow_finished записывается
// с уровнем "Ошибка" и маркером [ПринудительноеЗакрытие].
//
// Параметры:
//  логПоток - Структура - поток, полученный из ЛогОткрытьПоток.
//
&НаКлиенте
Процедура Логирование_ПринудительноЗакрытьПоток(логПоток)
	
	ЛогЗакрытьПоток(логПоток, Истина);
	
КонецПроцедуры

// Определяет, включено ли логирование для текущего сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если логирование включено.
//
&НаКлиенте
Функция Логирование_ИспользоватьЛогирование()
	
	РежимОтладки = Логирование_ПолучитьРежимОтладкиES();
	Возврат РежимОтладки <> "Выключено";
	
КонецФункции

// Возвращает текущий режим отладки ES-логирования.
// Значения:
// 		- Выключено
// 		- ВсяИнформация
// 		- ТолькоОшибки
// При отсутствии настройки — "ТолькоОшибки".
//
// Возвращаемое значение:
//  Строка - "ВсяИнформация", "ТолькоОшибки" или "Выключено".
//
&НаКлиенте
Функция Логирование_ПолучитьРежимОтладкиES() Экспорт
	
	Режим = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ЛогРежимОтладкиES");
	
	Если Режим = Неопределено ИЛИ Режим = Ложь Тогда
		Возврат "ТолькоОшибки";
	КонецЕсли;
	
	Возврат Режим;
	
КонецФункции

// Возвращает текущий активный поток логирования из серверных переменных.
//
// Возвращаемое значение:
//  Структура - текущий поток (Ид, ИдРодителя, Имя, ВремяНачала, Модуль).
//  Неопределено - поток не открыт.
//
&НаКлиенте
Функция Логирование_ПолучитьПоток()
	
	Возврат КомЯдро_ПолучитьЗначениеПеременной("ЛогПоток");
	
КонецФункции

// Проверяет, открыт ли поток логирования. Результат кэшируется
// в переменной формы КэшЛогПотокОткрыт.
//
// Возвращаемое значение:
//  Булево - Истина, если поток открыт и логирование включено.
//
&НаКлиенте
Функция Логирование_ПотокОткрыт()
	
	Если КэшЛогПотокОткрыт = Неопределено Тогда
		ЛогПоток = Логирование_ПолучитьПоток();
		КэшЛогПотокОткрыт = ЛогПоток <> Неопределено;
	КонецЕсли;
	
	Возврат КэшЛогПотокОткрыт = Истина;
	
КонецФункции

// Создаёт пустую структуру лог-записи с заполненными timestamp и uid.
// Директива устанавливается в "НаКлиенте" (в отличие от серверной версии).
//
// Возвращаемое значение:
//  Структура - заготовка лог-записи с ключами: timestamp, uid, ТипСобытия,
//              ИдРодителя, ИдСобытия, Модуль, Длительность, Уровень, Сообщение,
//              СообщениеШаблон, Контекст, Ошибка, Директива.
//
&НаКлиенте
Функция Логирование_НоваяЗапись()
	
	Поля = "timestamp,
		|uid,
		|ТипСобытия,
		|ИдРодителя,
		|ИдСобытия,
		|Модуль,
		|Длительность,
		|Уровень,
		|Сообщение,
		|СообщениеШаблон,
		|Контекст,
		|Ошибка,
		|Директива,
		|ИмяПриложения,
		|ИмяКомпьютера,
		|НачалоСеанса,
		|НомерСеанса,
		|НомерСоединения,
		|Пользователь,
		|ФоновоеЗадание,
		|ДоступныеПрава";
	
	НоваяЗапись = Новый Структура(Поля);
	НоваяЗапись.timestamp 	= ЛокЯдро_ПолучитьTimestamp();
	НоваяЗапись.uid 		= Строка(Новый УникальныйИдентификатор);
	НоваяЗапись.Директива 	= "НаКлиенте";
	
	Возврат НоваяЗапись;
	
КонецФункции

&НаКлиенте
Функция Логирование_ПолучитьКонтекстСеанса()
	
	КонтекстСеанса = Новый Структура;
	
	#Область НесовместимыйКодFresh
	#Если Не ВебКлиент Тогда
	КонтекстСеанса.Вставить("ИмяКомпьютера", ИмяКомпьютера());
	#КонецЕсли
	#КонецОбласти //НесовместимыйКодFresh
	
	Возврат КонтекстСеанса;
	
КонецФункции

// Триггерит серверное восстановление записей лога фонового задания. Извлекает
// буфер из временного хранилища и передаёт его серверу через транзит-мост вместе
// с текстом ошибки. Серверный метод дописывает Error-запись и отправляет накопленные
// записи в Elasticsearch. При пустом или уже очищенном буфере выходит без вызова сервера.
//
// Параметры:
//  РезультатФЗ      - Строка - подробное представление ошибки выполнения фонового задания.
//                              Пустая строка — ФЗ завершилось штатно.
//  АдресЛогБуфераФЗ - Строка - адрес временного хранилища со структурой состояния
//                              логирования фонового задания.
//
&НаКлиенте
Процедура Логирование_ОбработатьЗавершениеФЗ(РезультатФЗ, АдресЛогБуфераФЗ)
	
	ИмяСобытия = "Логирование_ОбработатьЗавершениеФЗ";
	
	Попытка
		
		Если НЕ ЗначениеЗаполнено(АдресЛогБуфераФЗ)
			ИЛИ НЕ ЭтоАдресВременногоХранилища(АдресЛогБуфераФЗ) Тогда
			// Адрес не зарезервирован — фоновое задание запущено в обход общей точки входа,
			// либо точка входа не дополнена резервированием.
			Возврат;
		КонецЕсли;
		
		СтруктураЛогаФЗ = ПолучитьИзВременногоХранилища(АдресЛогБуфераФЗ);
		Если СтруктураЛогаФЗ = Неопределено Тогда
			// Адрес уже недействителен (клиент перезапустился или штатная очистка успела отработать) —
			// записи лога утрачены.
			Возврат;
		КонецЕсли;
		
		Поток = СтруктураЛогаФЗ.ЛогПотокФЗ;
		БуферЗаписейСервер = СтруктураЛогаФЗ.ЛогБуферЗаписейСервер;
		
		Если Поток = Неопределено
			ИЛИ БуферЗаписейСервер.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("РезультатФЗ", РезультатФЗ);
		ПараметрыМетода.Вставить("СтруктураЛогаФЗ", СтруктураЛогаФЗ);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"Логирование_ВосстановитьБуферЗаписейФЗ");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Ложь, АдресаПеременных);
		
		// УдалитьИзВременногоХранилища идемпотентна: при штатном завершении задания сервер уже
		// удалил запись через ЛогЗакрытьПоток — повторный вызов безопасен.
		Если ЭтоАдресВременногоХранилища(АдресЛогБуфераФЗ) Тогда
			УдалитьИзВременногоХранилища(АдресЛогБуфераФЗ);
		КонецЕсли;
		
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование." + ИмяСобытия, "Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Записывает начало события в буфер логов.
//
// Параметры:
//  Событие - Структура - текущее событие из ЛогНачатьСобытие.
//
&НаКлиенте
Процедура Логирование_ЗаписатьНачалоСобытия(Событие)
	
	Если Событие = Неопределено
		ИЛИ НЕ Событие.ПотокОткрыт
		ИЛИ Событие.Материализовано Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЛога 				= Логирование_НоваяЗапись();
	ЗаписьЛога.ТипСобытия 	= "event_started";
	ЗаписьЛога.ИдРодителя 	= Событие.ИдРодителя;
	ЗаписьЛога.ИдСобытия 	= Событие.Ид;
	ЗаписьЛога.Модуль 		= Событие.Модуль;
	ЗаписьЛога.Длительность = Неопределено;
	ЗаписьЛога.Уровень 		= "Информация";
	ЗаписьЛога.Сообщение 	= Событие.Имя;
	
	Если Событие.Контекст <> Неопределено Тогда
		ЗаписьЛога.Вставить("Контекст", Событие.Контекст);
	КонецЕсли;
	
	Логирование_ЗаписатьЛог(ЗаписьЛога);
	КэшЛогСтекСобытий.Добавить(Событие.Ид);
	
	Событие.Материализовано = Истина;
	
КонецПроцедуры

// Формирует описание контекста из аргументов ЛогОписатьКонтекст.
//
// Параметры:
//  Контекст - Структура - аргументы ЛогОписатьКонтекст.
//
// Возвращаемое значение:
//  Соответствие - описание параметров в формате Ключ - Значение.
//
&НаКлиенте
Функция Логирование_ПолучитьОписаниеКонтекста(Контекст)
	
	ПараметрыКонтекста = Контекст.ПараметрыКонтекста;
	
	Если Контекст.ИменаПараметров = "" Тогда
		Имена = Новый Массив;
		Имена.Добавить("result");
	Иначе
		Имена = ЛокЯдро_СтрРазделить(Контекст.ИменаПараметров, ",");
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Для Инд = 0 По Имена.ВГраница() Цикл
		Значение = ПараметрыКонтекста[Инд];
		СтруктураПараметров.Вставить(СокрЛП(Имена[Инд]), Значение);
	КонецЦикла;
	
	Возврат Логирование_ПолучитьОписаниеПараметров(СтруктураПараметров);
	
КонецФункции

// Добавляет лог-запись в клиентский кэш буфера (КэшЛогБуферЗаписейКлиент).
// Если шаблон сообщения не заполнен, копирует текст сообщения.
// Перед добавлением сокращает контекст записи для безопасного переноса на сервер.
//
// Параметры:
//  ЗаписьЛога - Структура - лог-запись, см. Логирование_НоваяЗапись.
//
&НаКлиенте
Процедура Логирование_ЗаписатьЛог(ЗаписьЛога)
	
	Буфер = КэшЛогБуферЗаписейКлиент;
	
	Если Буфер = Неопределено Тогда
		Буфер = Новый Массив;
	КонецЕсли;
	
	Если ЗаписьЛога.СообщениеШаблон = Неопределено Тогда
		ЗаписьЛога.СообщениеШаблон = ЗаписьЛога.Сообщение;
	КонецЕсли;
	
	Если ЗаписьЛога.Контекст <> Неопределено Тогда
		ЗаписьЛога.Контекст = Логирование_ПолучитьОписаниеКонтекста(ЗаписьЛога.Контекст);
	КонецЕсли;
	
	Буфер.Добавить(ЗаписьЛога);
	КэшЛогБуферЗаписейКлиент = Буфер;
	
КонецПроцедуры

// Возвращает идентификатор последнего события из клиентского стека.
// Используется для определения родительского события.
//
// Возвращаемое значение:
//  Строка - идентификатор события с вершины стека.
//  Неопределено - стек пуст.
//
&НаКлиенте
Функция Логирование_ПолучитьПоследнееСобытиеСтека()
	
	ЛогСтекСобытий = КэшЛогСтекСобытий;
	
	Если ЛогСтекСобытий.Количество() Тогда
		Возврат ЛогСтекСобытий[ЛогСтекСобытий.ВГраница()];
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции 

// Рекурсивно преобразует структуру параметров в описание для лога.
// Маскирует секретные ключи, ограничивает глубину рекурсии и длину строк.
//
// Параметры:
//  СтруктураПараметров    - Структура, Соответствие - исходные параметры.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры.
//
// Возвращаемое значение:
//  Соответствие - описание параметров в формате Ключ - Значение.
//
&НаКлиенте
Функция Логирование_ПолучитьОписаниеПараметров(СтруктураПараметров, ДополнительныеПараметры = Неопределено)
	
	МаксЧислоСтрок = 10; // Ограничение количества строк в значение с типом Строка. 0 = без ограничений
	
	ОграничитьРекурсию = ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("ОграничитьРекурсию");
	
	СекретныеКлючи = Логирование_ПолучитьСекретныеКлючи();
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из СтруктураПараметров Цикл
	
		Ключ = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;
		ТипЗначения = ТипЗнч(Значение);
		
		Если СекретныеКлючи.Получить(НРег(Ключ)) <> Неопределено Тогда
		
			// Секретные ключи не пишем в логи, только проверяем заполненность
			Попытка
				Заполнено = ЗначениеЗаполнено(Значение);
			Исключение
				Заполнено = Истина;
			КонецПопытки;
			
			Если Заполнено Тогда
				Результат.Вставить(Ключ, "secret_filled");
			Иначе
				Результат.Вставить(Ключ, "secret_null");
			КонецЕсли;
			
		ИначеЕсли Значение = Неопределено Тогда
		
			Результат.Вставить(Ключ, Неопределено);
			
		ИначеЕсли ТипЗначения = Тип("Булево")
			ИЛИ ТипЗначения = Тип("Число") Тогда
			
			Результат.Вставить(Ключ, Значение);
			
		ИначеЕсли ТипЗначения = Тип("Дата") Тогда
			
			Результат.Вставить(Ключ, Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss; ДП=0001-01-01T00:00:00"));
			
		ИначеЕсли ТипЗначения = Тип("Структура")
			ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
			ИЛИ ТипЗначения = Тип("Соответствие")
			ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
			
			Если ОграничитьРекурсию
				ИЛИ Значение.Количество() = 0 Тогда
				
				Результат.Вставить(Ключ, Строка(Значение) + "(" + Значение.Количество() + ")");
			
			Иначе
			
				пДополнительныеПараметры = Новый Структура;
				
				// Получаем максимум второй уровень для ограничения размера
				// Пропускаем первое ограничение, если пришел result
				Если Ключ <> "function_result" Тогда
					пДополнительныеПараметры.Вставить("ОграничитьРекурсию", Истина);
				КонецЕсли;
				
				Результат.Вставить(Ключ, Логирование_ПолучитьОписаниеПараметров(Значение, пДополнительныеПараметры));
			
			КонецЕсли;
		
		ИначеЕсли ТипЗначения = Тип("Массив")
			ИЛИ ТипЗначения = Тип("ФиксированныйМассив")
			ИЛИ ТипЗначения = Тип("СписокЗначений") Тогда
			
			Результат.Вставить(Ключ, Строка(Значение) + "(" + Значение.Количество() + ")");
			
		ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		
			Значение = СокрЛП(Значение);
			ЧислоСтрок = СтрЧислоСтрок(Значение);
			
			Если МаксЧислоСтрок > 0
				И ЧислоСтрок > МаксЧислоСтрок Тогда
				
				НовоеЗначение = СтрПолучитьСтроку(Значение, 1);
				Для Х = 2 По МаксЧислоСтрок Цикл
					НовоеЗначение = НовоеЗначение + Символы.ПС + СтрПолучитьСтроку(Значение, Х);
				КонецЦикла;
				
				Если ЧислоСтрок > МаксЧислоСтрок + 1 Тогда
					Пропущено 	  = ЧислоСтрок - МаксЧислоСтрок - 1;
					НовоеЗначение = НовоеЗначение + Символы.ПС + ЛокЯдро_СтрШаблон("... Пропущено %1 строк ...", Пропущено);
					НовоеЗначение = НовоеЗначение + Символы.ПС + СтрПолучитьСтроку(Значение, ЧислоСтрок);
				КонецЕсли;
				
				Значение = НовоеЗначение;
			
			КонецЕсли;
			
			Результат.Вставить(Ключ, Значение);
		
		Иначе
		
			Результат.Вставить(Ключ, Строка(Значение));
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие секретных ключей, значения которых
// маскируются при записи в лог.
//
// Возвращаемое значение:
//  Соответствие - ключи в нижнем регистре, значения Истина.
//
&НаКлиенте
Функция Логирование_ПолучитьСекретныеКлючи()
	
	СекретныеКлючи = Новый Соответствие;
	
	// Вставить имена секретных ключей в формате НРег()
	// !! Значение Истина заполнять обязательно !!
	
	СекретныеКлючи.Вставить("auth_access_token",  Истина);
	СекретныеКлючи.Вставить("auth_refresh_token", Истина);
	СекретныеКлючи.Вставить("access_token", 	  Истина);
	СекретныеКлючи.Вставить("refresh_token", 	  Истина);
	
	Возврат СекретныеКлючи;
	
КонецФункции

// Выгружает буфер лог-записей с клиента. Учитывает РасположениеКомпоненты:
// НаСервере — делегирует серверному ГлЯдро_Логирование_ЗаписатьБуферЗаписей через Транзит;
// НаКлиенте — подготавливает ES-документы на сервере и отправляет в Elasticsearch с клиента.
//
// Параметры:
//  Поток - Структура - см. ЛогОткрытьПоток.
//
&НаКлиенте
Процедура ЛокЯдро_Логирование_ЗаписатьБуферЗаписей(Поток)
	
	РежимОтладки = Логирование_ПолучитьРежимОтладкиES();
	
	Если РежимОтладки = "ТолькоОшибки" Тогда
		
		БылиОшибки = КомЯдро_ПолучитьЗначениеПеременной("ЛогБылиОшибки");
		Если БылиОшибки <> Истина Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		
		ПараметрыМетода = Новый Структура("Поток, ЛогБуферЗаписейКлиент", Поток, КэшЛогБуферЗаписейКлиент);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Процедура");
		СтруктураВызова.Вставить("ИмяМетода", "Логирование_ЗаписатьБуферЗаписей");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
	Иначе
		
		ПараметрыМетода = Новый Структура("Поток, ЛогБуферЗаписейКлиент", Поток, КэшЛогБуферЗаписейКлиент);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "Логирование_ПодготовитьДокументыES");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		ДокументыES = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		// Если подключение с клиента, то сразу отправляем в Elasticsearch
		Логирование_ОтправитьВElasticsearch(ДокументыES);
		
	КонецЕсли;
	
КонецПроцедуры

// Отправляет массив ES-документов напрямую в Elasticsearch через Bulk API с клиента.
// Формирует NDJSON-тело и выполняет POST на endpoint Cleverence.
//
// Параметры:
//  ДокументыES - Массив - массив Соответствий с ES-документами.
//
&НаКлиенте
Процедура Логирование_ОтправитьВElasticsearch(ДокументыES)
	
	#Область НесовместимыйКодFresh
	#Если Не ВебКлиент Тогда
	Результат = Истина;
	
	Если ДокументыES.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия 				= "Логирование_ОтправитьВElasticsearch";
	ВсегоДокументов 		= ДокументыES.Количество();
	ОтправленоДокументов 	= 0;
	
	Попытка
		
		СтрокаДействия = "{""create"":{}}";
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/x-ndjson");
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 				"POST");
		СтруктураЗапроса.Вставить("ВернутьСтруктуру", 		Истина);
		СтруктураЗапроса.Вставить("Заголовки", 				Заголовки);
		СтруктураЗапроса.Вставить("СжиматьJSON", 			Ложь);
		СтруктураЗапроса.Вставить("Метод", 					"maindataprocessors/_bulk");
		СтруктураЗапроса.Вставить("ЗапросКВнешнемуРесурсу", Истина);
		СтруктураЗапроса.Вставить("ТипЗапроса", 			"ОтправитьЛогиВElasticsearch");
		
		СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки("https://elstc.cleverence.ru/send_webpanel_logs");
		
		// По замерам на 8k-16k лог-записей пакет 10000 быстрее меньших bulk-пакетов.
		РазмерПакета = 10000;
		ЭлементовПакета = 0;
		
		ЗаписьNDJSON = Новый ЗаписьJSON;
		ЗаписьNDJSON.УстановитьСтроку();
		
		Для Каждого ДокументES Из ДокументыES Цикл
			
			ЗаписьJSON = Новый ЗаписьJSON;
			ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
			ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
			ЗаписатьJSON(ЗаписьJSON, ДокументES);
			СтрокаДокумента = ЗаписьJSON.Закрыть();
			
			ЗаписьNDJSON.ЗаписатьБезОбработки(СтрокаДействия + Символы.ПС);
			ЗаписьNDJSON.ЗаписатьБезОбработки(СтрокаДокумента + Символы.ПС);
			
			ЭлементовПакета = ЭлементовПакета + 1;
			
			Если ЭлементовПакета >= РазмерПакета Тогда
				
				ТелоNDJSON = ЗаписьNDJSON.Закрыть();
				
				СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ТелоNDJSON);
				
				Если НЕ СтруктураОтвета.Статус Тогда
					Результат = Ложь;
					Прервать;
				КонецЕсли;
				
				ОтправленоДокументов = ОтправленоДокументов + РазмерПакета;
				ЭлементовПакета = 0;
				
				ЗаписьNDJSON = Новый ЗаписьJSON;
				ЗаписьNDJSON.УстановитьСтроку();
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Остаток — только если предыдущие пакеты успешны
		Если Результат И ЭлементовПакета > 0 Тогда
			
			ТелоNDJSON = ЗаписьNDJSON.Закрыть();
			
			СтруктураОтвета = REST_API_ВыполнитьHTTPЗапрос(СтруктураURI, СтруктураЗапроса, ТелоNDJSON);
			
			Если СтруктураОтвета.Статус Тогда
				ОтправленоДокументов = ОтправленоДокументов + ЭлементовПакета;
			Иначе
				Результат = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		пОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = ЛокЯдро_СтрШаблон("Ошибка отправки логов в Elasticsearch: %1", пОписаниеОшибки);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("Логирование." + ИмяСобытия, "Ошибка", пСообщение);
		Результат = Ложь;
		
	КонецПопытки;
	
	Если НЕ Результат Тогда
		ПотеряноДокументов = ВсегоДокументов - ОтправленоДокументов;
		пСообщение = ЛокЯдро_СтрШаблон(
			"Не удалось отправить логи в Elasticsearch. Потеряно документов: %1 из %2",
			ПотеряноДокументов, ВсегоДокументов);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(
			"Логирование." + ИмяСобытия, "Предупреждение", пСообщение);
	КонецЕсли;
	#КонецЕсли
	#КонецОбласти //НесовместимыйКодFresh
	
КонецПроцедуры

#КонецОбласти

