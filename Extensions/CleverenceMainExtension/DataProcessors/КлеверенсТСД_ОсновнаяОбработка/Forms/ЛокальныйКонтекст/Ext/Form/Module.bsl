Функция REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Завершение(СтруктураПараметровМетода)
	
	ИмяСобытия = "REST_API_ВыгрузкаТаблицыНаСерверSMARTS_Завершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПараметровМетода",
		СтруктураПараметровМетода);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ИмяТаблицы 				= СтруктураПараметровМетода.ИмяТаблицы;
	СтруктураПодключенияMS 	= СтруктураПараметровМетода.СтруктураПодключенияMS;
	ВерсияAPI 				= СтруктураПараметровМетода.ВерсияAPI;
	
	СчетчикПовторений = 500;
	
	Пока СчетчикПовторений Цикл
	
		Если ИмяТаблицы = "Номенклатура" Тогда
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
			СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Products/EndUploadProducts", "Inventory/EndUploadInventory"));
			СтруктураЗапроса.Вставить("ТипЗапроса", "КонецВыгрузкиТаблицы");
			РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса,, АдресаПеременных);
			
		ИначеЕсли ИмяТаблицы = "Ячейки" Тогда	
			ВызываемыйМетод = СтруктураПараметровМетода.ВызываемыйМетод;
			
			ОтправляемыеДанные = Новый Соответствие;
			Если ВерсияAPI = 1 Тогда
				ОтправляемыеДанные.Вставить("warehouseId", "1");
			КонецЕсли;
			
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("HTTPМетод", 	"POST");
			СтруктураЗапроса.Вставить("Метод", 		?(ВерсияAPI = 1, "Cells/End" + ВызываемыйМетод, "Locations/End" + ВызываемыйМетод));
			СтруктураЗапроса.Вставить("ТипЗапроса", "КонецВыгрузкиТаблицы");
			РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
				
		Иначе
			ИмяТаблицыENG 	= СтруктураПараметровМетода.ИмяТаблицыENG;
			ВызываемыйМетод = СтруктураПараметровМетода.ВызываемыйМетод;
			РезультатОтвет = REST_API_ВыполнитьМетод(СтруктураПодключенияMS,Новый Структура("HTTPМетод,Метод,ТипЗапроса","POST","Tables/"+ИмяТаблицыENG+"/End"+ВызываемыйМетод,"КонецВыгрузкиТаблицы"),,АдресаПеременных);
		КонецЕсли;
		
	    // Завершение выгрузки таблицы упало по таймауту
		Ошибка504 = ТипЗнч(РезультатОтвет) = Тип("Структура")
				И РезультатОтвет.Свойство("КодСостояния")
				И РезультатОтвет.КодСостояния = 504;
		Если Ошибка504 Тогда
			СчетчикПовторений = СчетчикПовторений - 1;
		Иначе
			СчетчикПовторений = 0;
		КонецЕсли;		
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатОтвет);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатОтвет;
	
КонецФункции

