&НаКлиенте
Процедура ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов(КлючНастройки) Экспорт

	// Если изменились настройки пользовательских бизнес-процессов, нужно будет пересобрать общую структуру для всех узлов
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки(КлючНастройки, Неопределено, "");
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			Конецесли;
			ЛокЯдро_СохранитьЗначениеКэшируемойНастройки(КлючНастройки, Неопределено, СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОбновитьПараметрыПодключения1С(ПервыйЗапуск = Ложь, Компонента = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ОбновитьПараметрыПодключения1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПервыйЗапуск,Компонента",
		ПервыйЗапуск, Компонента);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если НЕ Компонента = Неопределено Тогда
		РасположениеКомпоненты = Компонента;
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПервыйЗапуск", ПервыйЗапуск);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Процедура");
		СтруктураВызова.Вставить("ИмяМетода", 		"ОбновитьПараметрыПодключения1С");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		ЗаполнитьКлюч = Истина;
		
		Если НЕ ПервыйЗапуск Тогда
			База1СПодключенаДата = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("База1СПодключенаДата");
	    	ЗаполнитьКлюч = НЕ ЗначениеЗаполнено(База1СПодключенаДата) ИЛИ База1СПодключенаДата = Ложь;
		КонецЕсли;
		
		Если ЗаполнитьКлюч Тогда
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("База1СПодключенаДата", ТекущаяДата());
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСистемнуюИнформацию1СВБазеMS()
	
	ИмяСобытия = "ОбновитьСистемнуюИнформацию1СВБазеMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	СисИнфо = Новый СистемнаяИнформация;
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	пСтруктураНастроек = Новый Структура;
	пСтруктураНастроек.Вставить("PlatformVersion1C", СокрЛП(СисИнфо.ВерсияПриложения));
	пСтруктураНастроек.Вставить("ServerName1C", 	 НСтр(СтрокаСоединения, "Srvr"));
	пСтруктураНастроек.Вставить("DatabaseName1C", 	 НСтр(СтрокаСоединения, "Ref"));
	пСтруктураНастроек.Вставить("DatabasePath1C", 	 НСтр(СтрокаСоединения, "File"));
	пСтруктураНастроек.Вставить("WebDatabasePath1C", НСтр(СтрокаСоединения, "ws"));
	
	#Если НЕ ВебКлиент Тогда
	пСтруктураНастроек.Вставить("PlatformFolderPath1C", СокрЛП(КаталогПрограммы()));
	#КонецЕсли
	
	ИзмененияВНастройках = Новый Структура;
	
	Для каждого Настройка ИЗ пСтруктураНастроек Цикл
		ЗначениеНастройки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(Настройка.Ключ);
		
		//Если ЗначениеНастройки = Неопределено Тогда
		//	ЗначениеНастройки = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS(Настройка.Ключ);
		//КонецЕсли;
		
		Если НЕ ЗначениеНастройки = Настройка.Значение Тогда
			ИзмененияВНастройках.Вставить(Настройка.Ключ, Настройка.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Если ИзмененияВНастройках.Количество() Тогда
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(ИзмененияВНастройках);
		ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(ИзмененияВНастройках);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПроверитьСохраненнуюСтрокуПодключения1С()
	
	База1ССтрокаСоединенияКлиент = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ServiceHTTPAddress");
	Результат = ЗначениеЗаполнено(База1ССтрокаСоединенияКлиент) И База1ССтрокаСоединенияКлиент <> Ложь;
		
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьВерсиюКонфигурацииSMARTS() Экспорт

	ИмяСобытия = "ЛокЯдро_ПолучитьВерсиюКонфигурацииSMARTS";
	
	ВерсияКонфигурацииSMARTS = 0;
		
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();	
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииSMARTS);
	КонецЕсли;
	
	Попытка
		ВерсияКонфигурацииSMARTS = Число(ВерсияКонфигурацииSMARTS);
	Исключение
		ВерсияКонфигурацииSMARTS = 0;
	КонецПопытки;	
	
	Возврат ВерсияКонфигурацииSMARTS;	
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВерсияAPIПоДаннымБазыSMARTS(ВерсияПлатформыSMARTS = Неопределено)

	ИмяСобытия = "ЛокЯдро_ВерсияAPIПоДаннымБазыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияПлатформыSMARTS",
		ВерсияПлатформыSMARTS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ВерсияПлатформыSMARTS = Неопределено Тогда
		
		Если ПараметрыПодключенияMS = Неопределено Тогда
			ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		КонецЕсли;
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
			ПараметрыПодключенияMS.Свойство("ВерсияПлатформыSMARTS", ВерсияПлатформыSMARTS);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВерсияПлатформыSMARTS = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	Версия_REST_API = 1;
	
	ЧастиВерсии = ЛокЯдро_СтрРазделить(ВерсияПлатформыSMARTS, ".");
	
	Попытка
		Если Число(ЧастиВерсии[0]) >= 4 Тогда
			Версия_REST_API = 2;
		КонецЕсли;
	Исключение
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Версия_REST_API);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Версия_REST_API;
	
КонецФункции

// Возвращаемое значение:
//   Структура:
//		- Ключ - ключ настройки
//		- Значение - значение по умолчанию
//
&НаКлиенте
Функция ЛокЯдро_СтруктураКонтролируемыхНастроек()

    КонтролируемыеНастройки = Новый Структура;
	КонтролируемыеНастройки.Вставить("РаботаБезАлкоголя", Ложь);
	
	Возврат КонтролируемыеНастройки;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ПроверитьЗначенияТекущихНастроек(ИзмененияВНастройках)
	
	Если ИзмененияВНастройках = Неопределено Тогда
		ИзмененияВНастройках = Новый Структура;
	КонецЕсли;
	
	КонтролируемыеНастройки = ЛокЯдро_СтруктураКонтролируемыхНастроек();
	Для каждого Настройка ИЗ КонтролируемыеНастройки Цикл
		ЗначениеНастройки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(Настройка.Ключ);
		
		Если ЗначениеНастройки = Неопределено Тогда // При необходимости можно предусмотреть проверку на разные значения, а не только Неопределено
			ИзмененияВНастройках.Вставить(Настройка.Ключ, Настройка.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьИдентификаторыНастроекMS()
	
	ИмяСобытия = "ЛокЯдро_ПолучитьИдентификаторыНастроекMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы");
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ИдентификаторыНастроекMS = КомЯдро_ПолучитьЗначениеПеременной(КлючНастройки);
	Если ИдентификаторыНастроекMS = Неопределено Тогда
		ИдентификаторыНастроекMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С(КлючНастройки);
		
		Если НЕ ИдентификаторыНастроекMS = Неопределено Тогда
			КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, ИдентификаторыНастроекMS);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ИдентификаторыНастроекMS);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ИдентификаторыНастроекMS;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьИдентификаторНастройкиНаСервереSMARTS(КлючНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураИдентификаторов = Новый Структура(КлючНастройки, Неопределено);
	СтруктураИдентификаторов = ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураИдентификаторов, ID_Узла, ДополнительныеПараметры);
	
	Возврат СтруктураИдентификаторов[КлючНастройки];
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроек, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало, Получение uid настроек на сервере SMARTS';
						|en = 'Getting started, Getting the uid settings on the Cleverence server'; be = 'Пачатак, атрыманне UID налад на сэрвэры Cleverence'; es = 'Inicio, Obtener la configuración uid en el servidor Cleverence'; ka = 'მიღება დაიწყო, მიღების uid პარამეტრების Cleverence სერვერზე'; kk = 'Бастау, Cleverence серверінде uid параметрлерін алу'; ro = 'Noțiuni de bază, obținerea setărilor uid pe serverul Cleverence'; tr = 'Başlangıç, Cleverence sunucusundaki ayarların uıd''sini alma'; uk = 'Початок, отримання UID налаштувань на сервері Cleverence'; uz = 'Boshlash, Cleverence serverida uid sozlamalarini olish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	СтруктураИдентификаторов = Новый Структура;

	пДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	НеПроверятьАктуальность = пДополнительныеПараметры.Свойство("НеПроверятьАктуальность") И пДополнительныеПараметры.НеПроверятьАктуальность;
	НеИспользоватьАтрибуты	= пДополнительныеПараметры.Свойство("НеИспользоватьАтрибуты") И пДополнительныеПараметры.НеИспользоватьАтрибуты;
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	
	// Проверяем сохраненные идентификаторы настроек MS
	ИдентификаторыНастроекMS = ЛокЯдро_ПолучитьИдентификаторыНастроекMS();
	
	Если ИдентификаторыНастроекMS = Неопределено ИЛИ НеПроверятьАктуальность Тогда
		НастройкиКПолучению = ЛокЯдро_СкопироватьСтруктуру(СтруктураНастроек);
	Иначе
		НастройкиКПолучению = Новый Структура;
		Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
			ИтоговыйКлючНастройки = СтрокаНастройки.Ключ;
			Если НЕ УзловыеНастройки.Найти(СтрокаНастройки.Ключ) = Неопределено Тогда
				ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
			КонецЕсли;
			
			ИдентификаторНастройки = Неопределено;
			Если НЕ ИдентификаторыНастроекMS.Свойство(ИтоговыйКлючНастройки, ИдентификаторНастройки)
				ИЛИ ИдентификаторНастройки = Неопределено Тогда
				НастройкиКПолучению.Вставить(СтрокаНастройки.Ключ);
			КонецЕсли;
			
			СтруктураИдентификаторов.Вставить(ИтоговыйКлючНастройки, ИдентификаторНастройки);
		КонецЦикла;
	КонецЕсли;
	
	// Получаем настройки MS для сохранения недостающих идентификаторов
	Если НастройкиКПолучению.Количество() Тогда
		ПараметрыПолученияНастроек = Новый Структура;
		ПараметрыПолученияНастроек.Вставить("НеКэшировать", 			Истина);
		ПараметрыПолученияНастроек.Вставить("НеПроверятьАктуальность", 	Истина);
		ПараметрыПолученияНастроек.Вставить("НеИспользоватьАтрибуты", 	НеИспользоватьАтрибуты);
		
		Если пДополнительныеПараметры.Свойство("АтрибутыНастроекMS") Тогда
			ПараметрыПолученияНастроек.Вставить("АтрибутыНастроекMS", пДополнительныеПараметры.АтрибутыНастроекMS);
		КонецЕсли;
		
		ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению, ID_Узла, ПараметрыПолученияНастроек);
		ИдентификаторыНастроекMS = ЛокЯдро_ПолучитьИдентификаторыНастроекMS();
		
		Если ИдентификаторыНастроекMS = Неопределено Тогда
			ИдентификаторыНастроекMS = Новый Структура;
		КонецЕсли;
		
		Для каждого СтрокаНастройки ИЗ НастройкиКПолучению Цикл
			ИтоговыйКлючНастройки = СтрокаНастройки.Ключ;
			Если НЕ УзловыеНастройки.Найти(СтрокаНастройки.Ключ) = Неопределено Тогда
				ИтоговыйКлючНастройки = ИтоговыйКлючНастройки + ?(ID_Узла = "", "", "_" + ID_Узла);
			КонецЕсли;
			
			ИдентификаторНастройки = Неопределено;
			СтруктураИдентификаторов.Вставить(ИтоговыйКлючНастройки, ?(ИдентификаторыНастроекMS.Свойство(ИтоговыйКлючНастройки, ИдентификаторНастройки),
				ИдентификаторНастройки, Неопределено));
		КонецЦикла;
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец, Получение uid настроек на сервере SMARTS';
						|en = 'Finally, Getting the uid settings on the Cleverence server'; be = 'Канец, атрыманне UID налад на сэрвэры Cleverence'; es = 'Fin, Obtener la configuración uid en el servidor Cleverence'; ka = 'და ბოლოს, მიღების uid პარამეტრების Cleverence სერვერზე'; kk = 'Соңы, Cleverence серверінде uid параметрлерін алу'; ro = 'În cele din urmă, obținerea setărilor uid pe serverul Cleverence'; tr = 'Son, Cleverence sunucusundaki ayarların uıd''sini alma'; uk = 'Кінець, отримання UID налаштувань на сервері Cleverence'; uz = 'Tugatish, Cleverence serverida uid sozlamalarini olish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураИдентификаторов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураИдентификаторов;
	
КонецФункции

// Функция - Формирует структуру с описанием таблицы значений. Заполняет имена колонок из СтруктураСтрокаКолонок
//
// Параметры:
//  СтруктураСтрокаКолонок	 - Структура	 - Структура, Строка, Массив
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтруктураСтрокаКолонок) Экспорт
	
	КолонкиТаблицыЗначений = "";
	Если ТипЗнч(СтруктураСтрокаКолонок) = Тип("Строка") Тогда
		КолонкиТаблицыЗначений = СтрЗаменить(СтруктураСтрокаКолонок, " ", "");
	ИначеЕсли ТипЗнч(СтруктураСтрокаКолонок) = Тип("Структура") Тогда
		
		Для каждого КлючЗначение Из СтруктураСтрокаКолонок Цикл
			КолонкиТаблицыЗначений = КолонкиТаблицыЗначений + КлючЗначение.Ключ + ",";
		КонецЦикла;
		Если КолонкиТаблицыЗначений <> "" Тогда
			КолонкиТаблицыЗначений = Лев(КолонкиТаблицыЗначений, СтрДлина(КолонкиТаблицыЗначений) - 1);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СтруктураСтрокаКолонок) = Тип("Массив") Тогда
		КолонкиТаблицыЗначений = ЛокЯдро_СтрСоединить(СтруктураСтрокаКолонок, ",");
	КонецЕсли;
	
	Описание = Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, КолонкиТаблицыЗначений);
	Возврат Описание;
		
КонецФункции 

&НаКлиенте
Функция ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки) Экспорт
	
	// При изменении актуализировать в ЛокЯдро и ГлЯдро
	//	ГлЯдро_ПолучитьКлючиУникальностиТабличныхНастроек
	//	ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек
	
	КлючиОтбора = "";
	Если ИмяНастройки = "Узлы" Тогда
		КлючиОтбора = "ID_Узла";
		
	ИначеЕсли ИмяНастройки = "НастройкиБизнесПроцессов_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки = "НастройкиБизнесПроцессов_Пользовательские" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки =  "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_Пользовательские" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки =  "ГлобальныеПараметры_Значения" Тогда
		КлючиОтбора = "ID_Параметра";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеОтборыДокументов" Тогда
		КлючиОтбора = "ID_ПроизвольногоОтбора";
		
	ИначеЕсли ИмяНастройки = "НастройкиОбменаСправочников" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Онлайн" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Интерактивный" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовСправочников_Автообмен" Тогда
		КлючиОтбора = "ИмяТаблицы";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды_ПоУмолчанию" Тогда
		КлючиОтбора = "ID_ПроизвольногоКода";
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды_Пользовательские" Тогда
		КлючиОтбора = "ID_ПроизвольногоКода";
		
	ИначеЕсли ИмяНастройки = "Пользователи" Тогда
		КлючиОтбора = "Ид";
		
	ИначеЕсли ИмяНастройки = "ГруппыПользователей" Тогда
		КлючиОтбора = "Ид";
		
	ИначеЕсли ИмяНастройки = "ПользователиТСД" Тогда
		КлючиОтбора = "ID_Пользователя";
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Онлайн" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Интерактивный" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкиОтборовУзлов_Автообмен" Тогда
		КлючиОтбора = "ID_БизнесПроцесса";	
		
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиПолей" ИЛИ ИмяНастройки = "НастройкаЗагрузкиПолей" Тогда
		КлючиОтбора = "ИмяПриемника";
		
	ИначеЕсли ИмяНастройки = "ТабличнаяЧастьДокумента1С" Тогда
		КлючиОтбора = "ИмяПриемника";
		
	ИначеЕсли ИмяНастройки = "ТабличнаяЧастьДокументаMS" Тогда
		КлючиОтбора = "ИмяПриемника";	
		
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиТЧ" ИЛИ ИмяНастройки = "НастройкаЗагрузкиТЧ" Тогда
		КлючиОтбора = "ТабличнаяЧастьДокументаMS,НастройкаТЧСтрокой";
		
	ИначеЕсли ИмяНастройки = "СвязиТабличныхЧастей" Тогда
		КлючиОтбора = "ГлавнаяТаблица,ПодчиненнаяТаблица,ПолеГлавнойТаблицы";
		
	КонецЕсли;
	
	Возврат КлючиОтбора;
	
КонецФункции 

&НаКлиенте
Функция ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников() Экспорт
	
	// При изменении актуализировать в ЛокЯдро и ГлЯдро
	//	ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников
	//	ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников
	
	СтрокаНастройки = Новый Структура();
	СтрокаНастройки.Вставить("Выгружать",							Ложь);
