&НаКлиенте
Процедура ЛокЯдро_МетаданныеРеквизитовКВнутреннимИдентификаторам(СписокРеквизитов, СоответствияИмен)
	
	Для каждого Реквизит Из СписокРеквизитов Цикл
		ИмяПоля = Строка(Реквизит.Значение);
		ВнутренийИдентификатор = СоответствияИмен.Получить(ИмяПоля);
		Если ВнутренийИдентификатор <> Неопределено Тогда
			Реквизит.Значение = ВнутренийИдентификатор;
		КонецЕсли;
		Реквизит.Вставить("Имя", ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЛокЯдро_СтрокаИзBase64(Знач ЗначениеНастройкиBase64) Экспорт
	
	Попытка
		// Метод ПолучитьСтрокуИзДвоичныхДанных доступен, начиная с версии 8.3.10; используем Вычислить для поддержания работоспособности формы на старых платформах
		ЗначениеНастройки = ЛокЯдро_ВычислитьВБезопасномРежиме("ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Параметры.ЗначениеНастройкиBase64))",
			Новый Структура("ЗначениеНастройкиBase64", ЗначениеНастройкиBase64));
	Исключение
		ЗначениеНастройки = Неопределено;
	КонецПопытки;	
	
	Возврат ЗначениеНастройки;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ДвоичныеДанныеИзBase64Url(Знач СтрокаBase64) Экспорт

	Пока СтрДлина(СтрокаBase64) % 4 <> 0 Цикл
        СтрокаBase64 = СтрокаBase64 + "=";
    КонецЦикла;
    
    СтрокаBase64 = СтрЗаменить(СтрокаBase64, "-", "+");
    СтрокаBase64 = СтрЗаменить(СтрокаBase64, "_", "/");
    
    Возврат Base64Значение(СтрокаBase64);

КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьИмяФормы(Форма) Экспорт
	
	МассивПодстрок = ЛокЯдро_СтрРазделить(Форма.ИмяФормы, ".");
	Возврат МассивПодстрок[МассивПодстрок.ВГраница()];
	
КонецФункции 

&НаКлиенте
Функция ЛокЯдро_ПолучитьФорму(ИмяФормы, пВладелецФормы, РежимОткрытияОкна = Неопределено, ПараметрыФормы = Неопределено,  Уникальность = Ложь, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		пПараметрыФормы = Новый Структура;
	Иначе
		пПараметрыФормы = ЛокЯдро_СкопироватьСтруктуру(ПараметрыФормы);
	КонецЕсли;
	
	КартинкаПодсказкаИконка = ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("ПодсказкаИконка", Истина);
	пПараметрыФормы.Вставить("КартинкаПодсказкаИконка", КартинкаПодсказкаИконка);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаРезультат = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_" + ИмяФормы, пВладелецФормы, Уникальность);
	#Иначе
		ФормаРезультат = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма." + ИмяФормы, пПараметрыФормы, пВладелецФормы, Уникальность);
		
		Если РежимОткрытияОкна <> Неопределено Тогда
			ФормаРезультат.РежимОткрытияОкна = РежимОткрытияОкна;
		КонецЕсли;
		
	#КонецЕсли
	
	Возврат ФормаРезультат;
	
КонецФункции 

// Выводит сообщение пользователю в форму назначения
&НаКлиенте
Процедура ЛокЯдро_СообщениеПользователю(ТекстСообщения, ФормаНазначения = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если ФормаНазначения <> Неопределено Тогда
			Сообщение.ИдентификаторНазначения = ФормаНазначения.УникальныйИдентификатор;
		КонецЕсли;
	#КонецЕсли
	
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьTimestamp()
	
	пМсUTC 			 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пДата 			 = Дата("00010101") + Цел(пМсUTC / 1000);
	пМиллисекунды 	 = пМсUTC % 1000;
	пМиллисекундыСтр = Прав("000" + Формат(пМиллисекунды, "ЧГ="), 3);
	
	пДатаСтр = Формат(пДата, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Возврат пДатаСтр + "." + пМиллисекундыСтр + "Z";
	
КонецФункции

