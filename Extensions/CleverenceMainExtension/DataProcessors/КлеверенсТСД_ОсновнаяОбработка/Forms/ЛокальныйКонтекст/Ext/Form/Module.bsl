&НаКлиенте
Функция ЛокЯдро_ЗашифроватьZIP(ИсходнаяСтрока, ТипТекстовогоФайла, УдалитьФайлы = Ложь, ИмяПомещаемогоФайла = "") Экспорт
	
	#Если ВебКлиент Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ИсходнаяСтрока", 		ИсходнаяСтрока);
		ПараметрыМетода.Вставить("ТипТекстовогоФайла", 	ТипТекстовогоФайла);
		ПараметрыМетода.Вставить("УдалитьФайлы", 		УдалитьФайлы);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ЗашифроватьZIP");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
					 
		Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	#Иначе
		ИмяТекстовогоФайла = ПолучитьИмяВременногоФайла(ТипТекстовогоФайла);
		
		ЗаписьТекста = Новый ЗаписьТекста(ИмяТекстовогоФайла,"UTF-8",,,Символы.ПС);
		ЗаписьТекста.Записать(ИсходнаяСтрока);
		ЗаписьТекста.Закрыть();
		
		Если ИмяПомещаемогоФайла <> "" Тогда
			НовоеИмяФайла = ЛокЯдро_ИзвлечьПутьИзИмениФайла(ИмяТекстовогоФайла) + "\" + ИмяПомещаемогоФайла + "." + ТипТекстовогоФайла;
			ПереместитьФайл(ИмяТекстовогоФайла, НовоеИмяФайла);
			ИмяТекстовогоФайла = НовоеИмяФайла;
		КонецЕсли;
		
		ИмяЗипФайла = ПолучитьИмяВременногоФайла("zip");
		
		Сжатие = Новый ЗаписьZipФайла(ИмяЗипФайла,,,, УровеньСжатияZIP.Максимальный);
		Сжатие.Добавить(ИмяТекстовогоФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
		Сжатие.Записать();
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяТекстовогоФайла", ИмяТекстовогоФайла);
		Результат.Вставить("ИмяЗипФайла", ИмяЗипФайла);
		Результат.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ИмяЗипФайла));
		
		Если УдалитьФайлы Тогда
			УдалитьФайлы(ИмяТекстовогоФайла);
			УдалитьФайлы(ИмяЗипФайла);
		КонецЕсли;
		
		Возврат Результат;
	#КонецЕсли
	
КонецФункции 

