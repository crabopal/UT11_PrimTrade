		СоответствиеПродуктов.Вставить(ИдПродукта.Ключ, Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "Магазин", ИдПродукта.Значение));
	КонецЦикла;
		
	НаборИдСклад = ЛокЯдро_ПолучитьИдСклада();
	Для каждого ИдПродукта ИЗ НаборИдСклад Цикл
		СоответствиеПродуктов.Вставить(ИдПродукта.Ключ, Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "Склад", ИдПродукта.Значение));
	КонецЦикла;
	
	НаборИдПрайсчекер = ЛокЯдро_ПолучитьИдПрайсчекера();
	Для каждого ИдПродукта ИЗ НаборИдПрайсчекер Цикл
		СоответствиеПродуктов.Вставить(ИдПродукта.Ключ, Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "Прайсчекер", ИдПродукта.Значение));
