			НедопустимыйСимвол 	= Сред(СтрокаXML, ПозицияСимвола, 1);
			СтрокаXML 			= СтрЗаменить(СтрокаXML, НедопустимыйСимвол, "");
			ПозицияСимвола 		= НайтиНедопустимыеСимволыXML(СтрокаXML);
		КонецЦикла;
	#КонецЕсли		

	Возврат СтрокаXML;
	
КонецФункции

