// Вызывает метод из модуля обработки для получения структур настроек при выполнении инициализации
// 
// Параметры:
// 	ЗаполнятьДанные - Булево - флаг, указывающий, нужно ли получить и заполнить значения глобальных переменных на стороне сервера в модуле обработки.
//							   Если Истина, то значения будут получены и заполнены на стороне модуля обработки
//	ВыполнятьВФоне - Булево - признак необходимо получения данных инициализации в фоне
//	ОписаниеОповещенияРодительскойФормы - ОписаниеОповещения - описания оповещения метода родительской формы, который необходимо выполнить после инициализации
// 		  
// Возвращаемое значение:
// 	Структура - ДанныеДляИнициализации  
&НаКлиенте
Функция ЛокЯдро_ПолучитьДанныеДляИнициализации(ЗаполнятьДанные = Истина, ВыполнятьВФоне = Ложь, ОписаниеОповещенияРодительскойФормы = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ПолучитьДанныеДляИнициализации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЗаполнятьДанные,ВыполнятьВФоне,ОписаниеОповещенияРодительскойФормы",
		ЗаполнятьДанные, ВыполнятьВФоне, ОписаниеОповещенияРодительскойФормы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыМетода = Новый Структура("ЗаполнятьДанные", ЗаполнятьДанные);
	
	Если Не ВыполнятьВФоне Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьДанныеДляИнициализации");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Результат = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Результат;
	Иначе
		
		ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);

		ПараметрыФЗ = Новый Структура;
		ПараметрыФЗ.Вставить("ИмяМетода", 		"ГлЯдро_ПолучитьДанныеДляИнициализацииВФоне");
		ПараметрыФЗ.Вставить("ПараметрыМетода", ПараметрыМетода);		
		ПараметрыФЗ.Вставить("НаименованиеФЗ",	НСтр("ru = 'Получение данных для инициализации на сервере';
														|en = 'Getting initialization data on the server'; be = 'Атрыманне дадзеных для ініцыялізацыі на сэрвэры'; es = 'Obtención de datos para inicializar en el servidor'; ka = 'სერვერზე ინიციალიზაციის მონაცემების მიღება'; kk = 'Серверде инициализациялау үшін деректерді алу'; ro = 'Obținerea datelor de inițializare pe server'; tr = 'Sunucuda başlatma için veri alma'; uk = 'Отримання даних для ініціалізації на сервері'; uz = 'Serverda ishga tushirish uchun ma''lumotlarni olish'"));
		ПараметрыФЗ.Вставить("ТекстСообщения", 	НСтр("ru = 'Получение данных для инициализации';
														|en = 'Getting initialization data'; be = 'Атрыманне дадзеных для ініцыялізацыі'; es = 'Obtención de datos para la inicialización'; ka = 'ინიციალიზაციის მონაცემების მიღება'; kk = 'Инициализация үшін деректерді алу'; ro = 'Obținerea datelor de inițializare'; tr = 'Başlatma için veri alma'; uk = 'Отримання даних для ініціалізації'; uz = 'Ishga tushirish uchun ma''lumotlarni olish'"));
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ОписаниеОповещенияРодительскойФормы", ОписаниеОповещенияРодительскойФормы);
		
		ОписаниеОповещенияЗавершенияФЗ 	= Новый ОписаниеОповещения("ЛокЯдро_ПолучитьДанныеДляИнициализацииВФонеЗавершение", ЭтаФорма, ДопПараметры);
		ОписаниеОповещенияОшибкиФЗ 		= Новый ОписаниеОповещения("ЛокЯдро_ОбработатьОшибкиПолученияДанныхДляИнициализацииВФоне", ЭтаФорма);

		ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОписаниеОповещенияЗавершенияФЗ, ОписаниеОповещенияОшибкиФЗ);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьКатегорииНастроекMS() Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьКатегорииНастроекMS");
		
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьАтрибутыНастроекMS(ВерсияСтруктуры = Неопределено, ПоУмолчанию = Ложь)

	ИмяСобытия = "ЛокЯдро_ПолучитьАтрибутыНастроекMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияСтруктуры,ПоУмолчанию",
		ВерсияСтруктуры, ПоУмолчанию);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если НЕ ВерсияСтруктуры = Неопределено Тогда
		Результат = ЛокЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктуры);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Результат;
	КонецЕсли;
	
	СуффиксКлюча = ?(ПоУмолчанию, "ПоУмолчанию", "Пользовательские");
	
	СоответствиеАтрибутов = КомЯдро_ПолучитьЗначениеПеременной("СоответствиеАтрибутов_" + СуффиксКлюча);
	
	Если НЕ СоответствиеАтрибутов = Неопределено
		И НЕ СоответствиеАтрибутов = Ложь Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеАтрибутов);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат СоответствиеАтрибутов;
	КонецЕсли;
	
	ВерсияСтруктуры = КомЯдро_ПолучитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_" + СуффиксКлюча);
	
	Если ВерсияСтруктуры = Неопределено
		ИЛИ ВерсияСтруктуры = Ложь Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	СоответствиеАтрибутов = ЛокЯдро_СобратьСтруктуруАтрибутов(ВерсияСтруктуры);
	
	КомЯдро_СохранитьЗначениеПеременной("СоответствиеАтрибутов_" + СуффиксКлюча, СоответствиеАтрибутов);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СоответствиеАтрибутов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СоответствиеАтрибутов;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_СобратьСтруктуруАтрибутов(Знач ВерсияСтруктуры)

	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ВерсияСтруктуры",	ВерсияСтруктуры);
			
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "СобратьСтруктуруАтрибутов");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПустуюСтруктуруНастроекSMARTS(СериализуемыеНастройки) Экспорт
	
    СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьПустуюСтруктуруНастроекSMARTS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("СериализуемыеНастройки", СериализуемыеНастройки));
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
КонецФункции

// Получает структуру с данными узла из массива со списком узлов и сохраняет ее в кэш
// 
// Параметры:
// 	ID_Узла - Строка - Идентификатор узла
&НаКлиенте
Процедура ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_Узла = "") Экспорт
	
	ИмяСобытия = "ЛокЯдро_УстановитьДанныеТекущегоУзла";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Узла",
		ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДанныеУзла = Неопределено;
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		ДанныеУзла = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы,"ID_Узла",ID_Узла);
	КонецЕсли;
		
	Если ТипЗнч(ДанныеУзла) = Тип("Структура") Тогда
		ДанныеТекущегоУзла.Вставить("ID_Узла",       ДанныеУзла.ID_Узла);
		ДанныеТекущегоУзла.Вставить("Наименование",  ДанныеУзла.Наименование);
		ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS", ДанныеУзла.ЧастнаяБазаMS);
		ЕстьЧастнаяБаза = ДанныеУзла.ИспользоватьЧастнуюБазу;
		Если ТипЗнч(ДанныеУзла.ЧастнаяБазаMS) = Тип("Структура")
			И ЕстьЧастнаяБаза = Истина Тогда
			ОП = Новый ОписаниеОповещения("ЛокЯдро_ИнициализацияПодключениеЧастнойБазыЗавершение",ЭтаФорма,Новый Структура("ЧастнаяБазаMS",ДанныеУзла.ЧастнаяБазаMS));					
			ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ДанныеУзла.ЧастнаяБазаMS,Ложь,"Частная",?(ДанныеУзла.Свойство("РасположениеКомпонентыЧБ"),ДанныеУзла.РасположениеКомпонентыЧБ,Неопределено),Истина,Истина,ОП)
		КонецЕсли;
	Иначе
		ДанныеТекущегоУзла.Вставить("ID_Узла",       "");
		ДанныеТекущегоУзла.Вставить("Наименование",  "");
		ДанныеТекущегоУзла.Вставить("ЧастнаяБазаMS", "");
		ЕстьЧастнаяБаза = Ложь;
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ЕстьЧастнаяБаза", ЕстьЧастнаяБаза);
	ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ID_ТекущегоУзла_"+ПараметрыПодключенияMS.Ид, ДанныеТекущегоУзла.ID_Узла);
	
	// закачиваем в кэш узловые настройки
	СтруктураНастроек = Новый Структура;
	Для Каждого ИмяНастройки Из КатегорииНастроекMS.УзловыеНастройки Цикл
		СтруктураНастроек.Вставить(ИмяНастройки, Ложь);
	КонецЦикла;
	
	// Данные настройки будут получены дальше через ГлЯдро_ПолучитьНастройкиОтборовСправочников
	СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Онлайн");
	СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Интерактивный");
	СтруктураНастроек.Удалить("НастройкиОтборовСправочников_Автообмен");
	
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, ID_Узла);
	
	НастройкиОтборовСправочников = ЛокЯдро_ПолучитьНастройкиОтборовСправочников(ID_Узла);
	Для каждого КлючЗначение Из НастройкиОтборовСправочников Цикл
		СтруктураНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	КомЯдро_СохранитьЗначениеПеременной("ДанныеТекущегоУзла",ДанныеТекущегоУзла);
	ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
	
	ЛокЯдро_СобратьОбщуюСтруктуруОтборов("Интерактивный", ID_Узла);
	ЛокЯдро_СобратьОбщуюСтруктуруОтборов("Онлайн", ID_Узла);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПодключитьИнтеграционнуюОбработкуПриОткрытии(СерверДоступен = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПодключитьИнтеграционнуюОбработкуПриОткрытии";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СерверДоступен,ДополнительныеПараметры",
		СерверДоступен, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// Обновляем отображение главной формы
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		"НачалоПодключенияИнтеграционнойОбработкиСообщениеБезопасности", 
		"", 
		"ПодключениеИО");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	// Подключаем ИО из сохраненных настроек
	РезультатПодключенияИнтеграционнойОбработки = ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты, ДополнительныеПараметры);
	
	// Переподключаем ИО на другой тип обработки
	ТипОбработки = ?(ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") И ПараметрыПодключенияMS.Свойство("ТипОбработки"), ПараметрыПодключенияMS.ТипОбработки, "");
	
	Если СерверДоступен = Истина
		И ТипОбработки <> "Встроенная" Тогда
		ПодключитьИОРасширения = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПодключитьИОРасширения");
		Если ПодключитьИОРасширения = Истина Тогда
			Если ТипОбработки = "Встроенная" Тогда
				// Если уже используется встроенная обработка, переключаться на нее не нужно
				ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь);
			Иначе
				СтруктураИменРасширений = ЛокЯдро_ПолучитьСтруктуруИменРасширений();
				
				ИнформацияОбИнтеграционномРасширении = ЛокЯдро_ПроверитьНаличиеРасширения(СтруктураИменРасширений.ИнтеграционноеРасширение);
				Если ИнформацияОбИнтеграционномРасширении.Активно Тогда
					ИмяИнтеграционнойОбработки = ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
					Если Найти(ИмяИнтеграционнойОбработки, ".epf") > 0 Тогда
						ИмяИнтеграционнойОбработки = СтрЗаменить(ИмяИнтеграционнойОбработки, ".epf", "");
					КонецЕсли;
					
					Если ЛокЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + ИмяИнтеграционнойОбработки) Тогда			
						РезультатПодключенияИнтеграционнойОбработки = ЛокЯдро_ПереключитьИнтеграционнуюОбработку(РасположениеКомпоненты,
							"Встроенная",
						    ИмяИнтеграционнойОбработки,
							ИмяИнтеграционнойОбработки);
						
						Если РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
							ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Ложь);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//Данный код выполняется после инициализации, т.к. необходима установленная связь с базой Клеверенс, чтобы изменить настройки базы Клеверенс
	Если СерверДоступен = Истина
		И НЕ РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
		
		Если ТипОбработки = "СправочникСсылка" Тогда
			
			//Имя и путь интеграционной обрабокти по умолчанию
			ТипОбработки 					= "ФайлНаДиске";
			ИмяИнтеграционнойОбработки 		= ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
			ПутьИнтеграционнойОбработки 	= ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С");
			
			ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
			
			//Замена настроек в хранилище 1с
			ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", 		ПараметрыПодключенияMS);
			ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ID_ТекущейБазы", 	ПараметрыПодключенияMS.IdBaseSMARTS);
			КомЯдро_СохранитьЗначениеПеременной("ID_ТекущейБазы", 				ПараметрыПодключенияMS.IdBaseSMARTS);
			
			//Замена настроек в базе Клеверенс
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ПутьИнтеграционнойОбработки);
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки);
			
			//Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
			ЛокЯдро_УдалитьНастройкуВБазеSMARTS("ВерсияОбработки_ИнтеграционнаяОбработка");
			
			Сообщение = НСтр("ru = 'Тип интеграционной обработки заменен на: ""Файл на диске""';
								|en = 'The type of integration processing has been replaced with: ""File on disk""';
								|be = 'Тып інтэграцыйнай апрацоўкі заменены на: ""Файл на дыску""'; es = 'El tipo de procesamiento de integración ha sido reemplazado por: ""Archivo en disco""'; ka = 'ინტეგრაციის დამუშავების ტიპი შეიცვალა: ""ფაილი დისკზე""'; kk = 'Интеграциялық өңдеу түрі ауыстырылды: ""дискідегі Файл""'; ro = 'Tipul de procesare a integrării a fost înlocuit cu: ""fișier pe disc""'; tr = 'Entegrasyon işleme türü şu şekilde değiştirilir: ""Diskteki dosya""'; uk = 'Тип інтеграційної обробки замінено на: ""файл на диску""'; uz = 'Integratsiyani qayta ishlash turi quyidagilar bilan almashtirildi:""diskdagi fayl""'");
			Сообщить(Сообщение);
			
		ИначеЕсли ТипОбработки <> "Встроенная" Тогда
			
			// Если интеграционная обработка не подключена, и тип обработки <> "Встроенная", то пытаемся заменить обработку на встроенную в конфигурацию ИО
			// Данный функционал в первую очеред необходим для работы во fresh, т.к. там нет доступа к файлу, а ИО встроена в расширение
			
			// Имя и путь интеграционной обработки по умолчанию
			ИмяИнтеграционнойОбработки = ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С");
			Если Найти(ИмяИнтеграционнойОбработки, ".epf") > 0 Тогда
				ИмяИнтеграционнойОбработки = СтрЗаменить(ИмяИнтеграционнойОбработки, ".epf", "");
			КонецЕсли;
			
			Если ЛокЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + ИмяИнтеграционнойОбработки) Тогда
				
				// Пытаемся подключить встроенную ИО
				ТипОбработки = "Встроенная";		
				
				ТестовыеПараметрыПодключенияMS = ЛокЯдро_СкопироватьСтруктуру(ПараметрыПодключенияMS);
				ТестовыеПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
				ТестовыеПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
				ТестовыеПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
				
				РезультатПодключенияИнтеграционнойОбработки = ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты, ТестовыеПараметрыПодключенияMS);
				
				Если РезультатПодключенияИнтеграционнойОбработки Тогда
					
					Если ПараметрыПодключенияMS.ТипОбработки = "ФайлНаДиске" Тогда
						// Очищаем двоичные данные ИО, которые возможно остались.
						ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS, Неопределено);
					КонецЕсли;
					
					// Сохранение настроек
					ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
					ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
					ПараметрыПодключенияMS.Вставить("ТипОбработки", ТипОбработки);
					
					// Замена настроек в хранилище 1с
					ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
					КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
					
					// Замена настроек в базе Клеверенс
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ИмяИнтеграционнойОбработки);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки);
					
					// Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
					ЛокЯдро_УдалитьНастройкуВБазеSMARTS("ВерсияОбработки_ИнтеграционнаяОбработка");
					
					Сообщение = НСтр("ru = 'Тип интеграционной обработки заменен на: ""Встроенная""';
										|en = 'The type of integration processing has been changed to: ""Embedded""';
										|be = 'Тып інтэграцыйнай апрацоўкі заменены на: ""Убудаваная""'; es = 'El tipo de procesamiento de integración ha sido reemplazado por: ""Integrado""'; ka = 'ინტეგრაციის დამუშავების ტიპი შეიცვალა:""ჩადგმული""'; kk = 'Интеграциялық өңдеу түрі ауыстырылды: ""кірістірілген""'; ro = 'Tipul de procesare a integrării a fost schimbat în: ""Embedded""'; tr = 'Entegrasyon işleme türü şu şekilde değiştirilir: ""Yerleşik""'; uk = 'Тип інтеграційної обробки замінений на:""вбудована""'; uz = 'Integratsiyani qayta ishlash turi quyidagilar bilan almashtirildi:""o''rnatilgan""'");
					Сообщить(Сообщение);
				КонецЕсли;				
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Оповестить("ПослеПодключенияИнтеграционнойОбработки",,ЭтаФорма);
	
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Подключает интеграционную обработку по указанному в настройках пути к файлу. 
// Если расположение компоненты "НаКлиенте", то полученный файл обработки методом "НачатьПомещениеФайла" передается на сервер 
// 
// Параметры:
// 	РасположениеКомпоненты - Строка - указывается сторона, где установлена компонента для работы с базой Клеверенс
// 	ПараметрыОбработки - Структура - cодержит:
//		* ИмяИнтеграционнойОбработки - Строка
//		* ПутьИнтеграционнойОбработки - Строка
// 
// Возвращаемое значение:
// 	Булево, Строка - описание ошибки или Истина в случае успешного подключения
&НаКлиенте
Функция ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты = "НаСервере", ПараметрыОбработки = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПодключитьИнтеграционнуюОбработку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РасположениеКомпоненты,ПараметрыОбработки",
		РасположениеКомпоненты, ПараметрыОбработки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(_ИнтеграционнаяОбработкаАдрес) Тогда
		УдалитьИзВременногоХранилища(_ИнтеграционнаяОбработкаАдрес);
		_ИнтеграционнаяОбработкаАдрес = Неопределено;
	КонецЕсли;
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	РабочийКаталог = ПараметрыПодключенияMS.РабочийКаталог;
	Если ПараметрыОбработки = Неопределено Тогда
		ИмяИнтеграционнойОбработки 	= ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
		ПутьИнтеграционнойОбработки = ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки;
		ТипОбработки				= ?(НЕ ПараметрыПодключенияMS.Свойство("ТипОбработки") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыПодключенияMS.ТипОбработки),
			"ФайлНаДиске",
			ПараметрыПодключенияMS.ТипОбработки);
	Иначе
		ПараметрыОбработки.Вставить("РабочийКаталог", РабочийКаталог);
		ИмяИнтеграционнойОбработки 	= ПараметрыОбработки.ИмяИнтеграционнойОбработки;
		ПутьИнтеграционнойОбработки = ПараметрыОбработки.ПутьИнтеграционнойОбработки;
		ТипОбработки				= ПараметрыОбработки.ТипОбработки;
	КонецЕсли;
	
	ИмяИнтеграционнойОбработки 	= ?(ЗначениеЗаполнено(ИмяИнтеграционнойОбработки), ИмяИнтеграционнойОбработки, "");
	ПутьИнтеграционнойОбработки = ?(ЗначениеЗаполнено(ПутьИнтеграционнойОбработки), ПутьИнтеграционнойОбработки, "");
	
	ПутьОсновнойОбработки = "";
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ПутьОсновнойОбработки = ИспользуемоеИмяФайла;	
	#КонецЕсли
	
	мАдресХранилища 							= Неопределено;
	ПолныйПутьКИнтеграционнойОбработке 			= "";
	
	// Во фреше все обработки имеют префикс Клеверенс_
	// Так-как в CustomSettings.dflt имя ИО прописано без префикса, то ищем обработку с префиксом и переподключаем на неё.
	
	#Область СовместимыйКодFresh
	//Если ЛокЯдро_СтрНайти(ИмяИнтеграционнойОбработки, "Клеверенс_") = 0 Тогда
	//	НовоеИмя = "Клеверенс_" + ИмяИнтеграционнойОбработки;
	//	НовоеИмя = СтрЗаменить(НовоеИмя, ".epf", "");
	//	Если ЛокЯдро_ПроверитьОбъектМетаданныхСуществует("Обработка." + НовоеИмя) Тогда
	//		Возврат ЛокЯдро_ПереключитьИнтеграционнуюОбработку(РасположениеКомпоненты, "Встроенная", НовоеИмя, НовоеИмя);
	//	КонецЕсли;
	//КонецЕсли;
	#КонецОбласти //СовместимыйКодFresh
	
	Если ТипОбработки = "ФайлНаДиске" Тогда
		
		#Область НесовместимыйКодFresh
		РазделительПути = ПолучитьРазделительПути();
			
		ДополнитьРазделительПути = ?(Прав(ПутьИнтеграционнойОбработки, 1) = РазделительПути, "", РазделительПути);
		ДополнитьРасширениеФайла = ?(Прав(ИмяИнтеграционнойОбработки, 4) = ".epf", "", ".epf");
			
		СохраненныйПутьИнтеграционнойОбработки = ПутьИнтеграционнойОбработки + ДополнитьРазделительПути
			+ ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
			
		// Сначала пробуем получить интеграционную обработку из файла, указанного в настройках (Путь+Имя)
		ПолныйПутьКИнтеграционнойОбработке = СохраненныйПутьИнтеграционнойОбработки;
		
		ФайлИнтеграционнойОбработкиСуществует = Ложь;
		
		#Если ВебКлиент Тогда
			Сообщение = НСтр("ru = 'Для работы в веб-клиенте подключите интеграционную обработку из справочника дополнительных отчетов и обработок или встроенную.';
								|en = 'To work in the web client, enable integration processing from the directory of additional reports and treatments, or embedded.';
								|be = 'Для працы ў вэб-кліенце падключыце інтэграцыйную апрацоўку з даведніка дадатковых справаздач і апрацовак або убудаваную.'; es = 'Para trabajar en el cliente web, conecte el procesamiento de integración del directorio de informes y tratamientos adicionales o el procesamiento integrado.'; ka = 'ვებ კლიენტში მუშაობისთვის, დამატებითი ანგარიშებისა და მკურნალობის დირექტორიიდან ინტეგრაციის დამუშავების ჩართვა, ან ჩანერგილი.'; kk = 'Веб-клиентте жұмыс істеу үшін интеграциялық өңдеуді қосымша есептер мен өңдеулер каталогынан немесе ендірілгеннен қосыңыз.'; ro = 'Pentru a lucra în clientul web, activați procesarea integrării din Directorul de rapoarte și tratamente suplimentare sau încorporate.'; tr = 'Bir web istemcisinde çalışmak için, ek raporlar ve işlemler dizininden veya yerleşik işlemeden entegrasyon işlemlerini bağlayın.'; uk = 'Для роботи в веб-клієнті підключіть інтеграційну обробку з довідника додаткових звітів і обробок або вбудовану.'; uz = 'Veb-mijozda ishlash uchun qo''shimcha hisobotlar va ishlov berish katalogidan yoki o''rnatilgan integratsiyani qayta ishlashni ulang.'");
			Сообщить(Сообщение); 
				
			стрРезультат = НСтр("ru = 'Файл интеграционной обработки по пути ""%1"" не найден.';
									|en = 'The integration processing file on the path ""%1"" was not found.';
									|be = 'Файл інтэграцыйнай апрацоўкі па шляху ""%1 "" Не знойдзены.'; es = 'No se encontró el archivo de integración en la ruta ""%1"".'; ka = 'ინტეგრაციის დამუშავების ფაილი გზაზე ""%1 "" ვერ იქნა ნაპოვნი.'; kk = '""%1 "" жолы бойынша интеграциялық өңдеу файлы табылмады.'; ro = 'Fișierul de procesare a integrării pe calea ""%1 "" nu a fost găsit.'; tr = '""%1"" yolundaki entegrasyon işleme dosyası bulunamadı.'; uk = 'Файл інтеграційної обробки на шляху ""%1 "" не знайдено.'; uz = '""%1 "" yo''lida integratsiyani qayta ishlash fayli topilmadi.'");
			стрРезультат = ЛокЯдро_СтрШаблон(стрРезультат, Строка(ПолныйПутьКИнтеграционнойОбработке));
	
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", стрРезультат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат стрРезультат;
		#КонецЕсли
		
		// 1) Подключение по сохраненным данным
		Если ПутьИнтеграционнойОбработки = "REST_API" Тогда
			// ИО подключена из файла, загруженного по REST API. 
			// Получаем сохранённые двоичные данные.
			ИнтеграционнаяОбработкаДвоичныеДанные = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS);
			Если ИнтеграционнаяОбработкаДвоичныеДанные <> Неопределено Тогда
				мАдресХранилища = ПоместитьВоВременноеХранилище(ИнтеграционнаяОбработкаДвоичныеДанные, Новый УникальныйИдентификатор());
				ФайлИнтеграционнойОбработкиСуществует = Истина;
				ПолныйПутьКИнтеграционнойОбработке = "REST_API" + ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
			КонецЕсли;
			
		Иначе
			// Сохраненный путь ИО
			ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
			ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
				И ФайлИнтеграционнойОбработки.Расширение = ".epf";
		КонецЕсли;
		
		// Ищем типовой файл, если не удалось получить интеграционную обработку из сохранённых данных
		
		// 2) Подключение из файла полученного по REST_API.
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(ИмяИнтеграционнойОбработки) Тогда
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("ПутьКФайлу", "DataProcessors\Integrations\");
			ПараметрыФайла.Вставить("ИмяФайла",   ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла);
			
			мАдресХранилища = ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла);
			
			Если мАдресХранилища <> Неопределено
				И ЭтоАдресВременногоХранилища(мАдресХранилища) Тогда
				
				ФайлИнтеграционнойОбработкиСуществует = Истина;
				ПолныйПутьКИнтеграционнойОбработке = "REST_API" + ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
						
				// Сохраняем двоичные данные для повторного использования
				ИнтеграционнаяОбработкаДвоичныеДанные = ПолучитьИзВременногоХранилища(мАдресХранилища);
				ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS, ИнтеграционнаяОбработкаДвоичныеДанные);		
						
			КонецЕсли;
			
		КонецЕсли;
		
		// 3) Подключение из рабочего каталога базы Mobile SMARTS (РабочийКаталог+Путь+Имя)
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(РабочийКаталог) Тогда
			РабочийКаталог = Строка(РабочийКаталог);
					
			// Если в ПутьИнтеграционнойОбработки указан абсолютный путь (упрощенная проверка для Windows), вариант (РабочийКаталог+Путь+Имя) не имеет смысла
			УказанАбсолютныйПуть = НЕ ЛокЯдро_СтрНайти(ПутьИнтеграционнойОбработки, ":" + РазделительПути) = 0;
				
			Если НЕ УказанАбсолютныйПуть Тогда
				ДополнитьРазделительРабочийКаталог
					= ?(Прав(РабочийКаталог, 1) = РазделительПути, "", РазделительПути);
				ПутьИнтеграционнойОбработки = ?(Лев(ПутьИнтеграционнойОбработки, 1) = РазделительПути,
					Сред(ПутьИнтеграционнойОбработки, 2),
					ПутьИнтеграционнойОбработки);
				
				ПолныйПутьКИнтеграционнойОбработке = РабочийКаталог	+ ДополнитьРазделительРабочийКаталог
					+ ПутьИнтеграционнойОбработки + ДополнитьРазделительПути
					+ ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
					
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			КонецЕсли;
		КонецЕсли;
		
		// 4) Подключение по относительному пути из каталога файла основной обработки
		Если НЕ ФайлИнтеграционнойОбработкиСуществует
			И ЗначениеЗаполнено(ПутьОсновнойОбработки) Тогда
				
			ПутьИнтеграционнойОбработки = ЛокЯдро_ПолучитьПутьИнтеграционнойОбработки(ПутьОсновнойОбработки);
			Если НЕ ПустаяСтрока(ПутьИнтеграционнойОбработки) Тогда
				ПолныйПутьКИнтеграционнойОбработке = ПутьИнтеграционнойОбработки
					+ ИмяИнтеграционнойОбработки + ДополнитьРасширениеФайла;
				ФайлИнтеграционнойОбработки = Новый Файл(ПолныйПутьКИнтеграционнойОбработке);
						
				ФайлИнтеграционнойОбработкиСуществует = ФайлИнтеграционнойОбработки.Существует()
					И ФайлИнтеграционнойОбработки.Расширение = ".epf";
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ФайлИнтеграционнойОбработкиСуществует Тогда
			
			Результат = "Файл интеграционной обработки по пути """
				+ СохраненныйПутьИнтеграционнойОбработки + """ не найден.";
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат Результат;
		ИначеЕсли НЕ ПолныйПутьКИнтеграционнойОбработке = СохраненныйПутьИнтеграционнойОбработки Тогда
			// Пересохраним полный путь в параметрах подключения
			ПутьИнтеграционнойОбработки = СтрЗаменить(СтрЗаменить(ПолныйПутьКИнтеграционнойОбработке, Строка(ИмяИнтеграционнойОбработки), ""), ".epf", "");
				
			ПараметрыПодключенияMS.Вставить("ТипОбработки",				   ТипОбработки);
			ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
				
			// Замена настроек в хранилище 1С
			ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", 			 ПараметрыПодключенияMS);
									
			// Замена настроек в базе Клеверенс
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки",							   ТипОбработки);
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ПутьИнтеграционнойОбработки);
		КонецЕсли;
		
		Если мАдресХранилища = Неопределено Тогда
			мАдресХранилища = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолныйПутьКИнтеграционнойОбработке), Новый УникальныйИдентификатор());
		КонецЕсли;
			
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("мАдресХранилища",			мАдресХранилища);
		ПараметрыМетода.Вставить("ПутьКФайлу",				ПолныйПутьКИнтеграционнойОбработке);
		ПараметрыМетода.Вставить("ПараметрыПодключенияMS",	ПараметрыПодключенияMS);
		ПараметрыМетода.Вставить("ТипОбработки", 			ТипОбработки);
		ЛокЯдро_ПодключитьИнтеграционнуюОбработкуСервер(Истина, Ложь,, ПараметрыМетода);
		#КонецОбласти //НесовместимыйКодFresh
	ИначеЕсли ТипОбработки = "СправочникСсылка" ИЛИ ТипОбработки = "Встроенная" Тогда
		Если ЗначениеЗаполнено(ПутьИнтеграционнойОбработки) Тогда
			ПараметрыМетода = Новый Структура("мАдресХранилища", мАдресХранилища);
			ПараметрыМетода.Вставить("ПутьКФайлу", ПолныйПутьКИнтеграционнойОбработке);
			Если ПараметрыОбработки = Неопределено Тогда
				ПараметрыМетода.Вставить("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
			Иначе
				ПараметрыМетода.Вставить("ПараметрыПодключенияMS", ПараметрыОбработки);
			КонецЕсли;
			ПараметрыМетода.Вставить("ТипОбработки", ТипОбработки);
			ЛокЯдро_ПодключитьИнтеграционнуюОбработкуСервер(Истина, Ложь, , ПараметрыМетода);
		КонецЕсли;	
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ИнтеграционнаяОбработкаПодключена);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ИнтеграционнаяОбработкаПодключена;
	
КонецФункции

// Вызывает из модуля обработки метод подключения интеграционной обработки. 
// Т.к. на стороне клиента нет возможности хранить переменную с типом ВнешняяОбработкаОбъект, 
// то помещаем обработку в структуру и кладем во временное хранилище 
// 
// Параметры:
//	Результат - Булево - Ложь - в параметре <Интерактивно> установлен интерактивный режим (Истина) и пользователь отказался от выполнения операции в диалоге выбора файла
//	мАдресХранилища - Строка - расположение нового файла
//	ВыбранноеИмяФайла - Строка - через этот параметр возвращается путь к файлу, указанный в диалоге выбора файла. 
//								 Для неинтерактивного режима выбранное имя файла соответствует начальному имени файла. 
//								 В режиме запуска "Веб-клиент" значение параметра зависит от типа браузера.
//								 Для Mozilla Firefox 3 в параметре возвращается только имя файла без пути.
//								 Для Microsoft Internet Explorer возвращаемое значение зависит от настройки текущей зоны.
//								 Подробности: http://msdn.microsoft.com/en-us/library/ms535128(VS.85).aspx
//	ПараметрыМетода - Неопределено, Структура - содержит:
//		* мАдресХранилища - Неопределено, Строка - расположение нового файла
//		* ПутьКФайлу - Строка - путь к исходному файлу
//		* ПараметрыПодключенияMS - Структура - структура настроек подключения к базе Клеверенс
&НаКлиенте
Процедура ЛокЯдро_ПодключитьИнтеграционнуюОбработкуСервер(Результат,мАдресХранилища,ВыбранноеИмяФайла,ПараметрыМетода=Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПодключитьИнтеграционнуюОбработкуСервер";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,мАдресХранилища,ВыбранноеИмяФайла,ПараметрыМетода",
		Результат, мАдресХранилища, ВыбранноеИмяФайла, ПараметрыМетода);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПодключитьИнтеграционнуюОбработку");
	СтруктураВызова.Вставить("ПараметрыМетода",ПараметрыМетода);
	
	Если ПараметрыМетода.мАдресХранилища = Неопределено Тогда
		ПараметрыМетода.мАдресХранилища = мАдресХранилища;
	КонецЕсли;
	
	АдресСтруктуры = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Если ЭтоАдресВременногоХранилища(АдресСтруктуры) Тогда
		_ИнтеграционнаяОбработкаАдрес=АдресСтруктуры;
		ЛокЯдро_ПолучитьЗначенияПеременныхИО(АдресСтруктуры);
	Иначе
		СтруктураОбработки = Новый Структура();
		СтруктураОбработки.Вставить("Обработка",Неопределено);
		СтруктураОбработки.Вставить("Подключена",Ложь);
		СтруктураОбработки.Вставить("ПутьКФайлу","");	
		ИнтеграционнаяОбработкаПодключена = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяИнтеграционнойОбработки) И ИнтеграционнаяОбработкаПодключена = Истина Тогда
		Попытка
			ФормаИнтеграционнойОбработки = ЛокЯдро_ПолучитьФормуИнтеграционнойОбработки(ТипОбработки, ИмяИнтеграционнойОбработки);
		Исключение
			
			// <Лог>
			ИнфоОшибка 	= ИнформацияОбОшибке();
			ЯзСтрока 	= "ru = 'Не удалось получить форму интеграционной обработки'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка);
			// </Лог>
			
			Если ЭтоАдресВременногоХранилища(_ИнтеграционнаяОбработкаАдрес) Тогда
				УдалитьИзВременногоХранилища(_ИнтеграционнаяОбработкаАдрес);
				_ИнтеграционнаяОбработкаАдрес = Неопределено;
			КонецЕсли;
			ИнтеграционнаяОбработкаПодключена = Ложь;
			
		КонецПопытки;
	КонецЕсли;
	
	тРасположениеКомпоненты = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты"); // т.к. вызывается до инициализации
	Если ИнтеграционнаяОбработкаПодключена Тогда
		СоответствиеПараметровПорционнойВыгрузки = ЛокЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки();
		
		Если тРасположениеКомпоненты = "НаКлиенте" Тогда
			ЛокЯдро_ОбновитьФункциональныеПараметры1СВБазеMS();
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Выполняет переподключение интеграционной обработки по переданным параметрам
&НаКлиенте
Функция ЛокЯдро_ПереключитьИнтеграционнуюОбработку(РасположениеКомпоненты, ТипОбработки, ИмяИнтеграционнойОбработки, ПутьИнтеграционнойОбработки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПереключитьИнтеграционнуюОбработку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РасположениеКомпоненты,ТипОбработки,ИмяИнтеграционнойОбработки,ПутьИнтеграционнойОбработки",
		РасположениеКомпоненты, ТипОбработки, ИмяИнтеграционнойОбработки, ПутьИнтеграционнойОбработки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();		
	КонецЕсли;
	
    ТестовыеПараметрыПодключенияMS = ЛокЯдро_СкопироватьСтруктуру(ПараметрыПодключенияMS);
	ТестовыеПараметрыПодключенияMS.Вставить("ТипОбработки", 			   ТипОбработки);
	ТестовыеПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
	ТестовыеПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
						
	РезультатПодключенияИнтеграционнойОбработки = ЛокЯдро_ПодключитьИнтеграционнуюОбработку(РасположениеКомпоненты, ТестовыеПараметрыПодключенияMS);

	Если РезультатПодключенияИнтеграционнойОбработки = Истина Тогда
		
		// Сразу пытаемся поменять тип обработки и проверяем, удалось ли это сделать
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", ТипОбработки);
		Если ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ТипОбработки") = ТипОбработки Тогда
			
			Если ПараметрыПодключенияMS.ТипОбработки = "ФайлНаДиске" Тогда
				// Очищаем двоичные данные ИО, которые возможно остались.
				ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнтеграционнаяОбработкаДвоичныеДанные_" + ПараметрыПодключенияMS.IdBaseSMARTS, Неопределено);
			КонецЕсли;
			
			// Сохранение настроек
			ПараметрыПодключенияMS.Вставить("ТипОбработки",				   ТипОбработки);
			ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  ИмяИнтеграционнойОбработки);
			ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
			
			// Замена настроек в хранилище 1с
			ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
			КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", 			 ПараметрыПодключенияMS);
								
			// Замена настроек в базе Клеверенс
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С",  ИмяИнтеграционнойОбработки);
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", ПутьИнтеграционнойОбработки);
								
			// Удаление настройки версии интеграционной обработки, т.к. версия хранится только для тип обработки = "СправочникСсылка"
			ЛокЯдро_УдалитьНастройкуВБазеSMARTS("ВерсияОбработки_ИнтеграционнаяОбработка");
								
			Сообщение = НСтр("ru = 'Тип интеграционной обработки заменен на: ""Встроенная""';
								|en = 'The type of integration processing has been changed to: ""Embedded""';
								|be = 'Тып інтэграцыйнай апрацоўкі заменены на: ""Убудаваная""'; es = 'El tipo de procesamiento de integración ha sido reemplazado por: ""Integrado""'; ka = 'ინტეგრაციის დამუშავების ტიპი შეიცვალა:""ჩადგმული""'; kk = 'Интеграциялық өңдеу түрі ауыстырылды: ""кірістірілген""'; ro = 'Tipul de procesare a integrării a fost schimbat în: ""Embedded""'; tr = 'Entegrasyon işleme türü şu şekilde değiştirilir: ""Yerleşik""'; uk = 'Тип інтеграційної обробки замінений на:""вбудована""'; uz = 'Integratsiyani qayta ishlash turi quyidagilar bilan almashtirildi:""o''rnatilgan""'");
			Сообщить(Сообщение);			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПодключенияИнтеграционнойОбработки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатПодключенияИнтеграционнойОбработки;
	
КонецФункции	

&НаКлиенте
Функция ЛокЯдро_ПроверитьСуществованиеИнтеграционнаяОбработкаДвоичныеДанные() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПроверитьСуществованиеИнтеграционнаяОбработкаДвоичныеДанные");	
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(пПараметрыПодключенияMS = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыПодключенияMS",
		пПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>

	ВерсияAPI = REST_API_ПолучитьВерсиюAPI();
	Если ВерсияAPI < 2 Тогда
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		Возврат;
	КонецЕсли;

	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПараметрыПодключенияMS", пПараметрыПодключенияMS);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Процедура");
		СтруктураВызова.Вставить("ИмяМетода", 		"ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		Если пПараметрыПодключенияMS = Неопределено Тогда
			пПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		КонецЕсли;
		
		АдресДвоичныхДанных = ЛокЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию(пПараметрыПодключенияMS);
			
		Если АдресДвоичныхДанных = Неопределено Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось загрузить файл 1CConfigs.xml для определения настроек по умолчанию'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока);
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("АдресДвоичныхДанных", АдресДвоичныхДанных);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ИнициализацияНастроек_ОпределитьНастройкиПоУмолчанию");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		НастройкиПоУмолчаниюСтруктура = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		Если НастройкиПоУмолчаниюСтруктура = Неопределено Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось определить настройки по умолчанию из файла 1CConfigs.xml'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока);
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод",	"POST");
		СтруктураЗапроса.Вставить("Метод",		"api/internal/CustomSettings/ApplyDefaultFile");
		СтруктураЗапроса.Вставить("ТипЗапроса",	"ПоУмолчанию");
		СтруктураЗапроса.Вставить("ВерсияAPI",	"");
		
		ОтправляемыеДанные = Новый Соответствие;
		ОтправляемыеДанные.Вставить("relativePath", НастройкиПоУмолчаниюСтруктура.НастройкиПуть + "\" + НастройкиПоУмолчаниюСтруктура.НастройкиИмя);
		ОтправляемыеДанные.Вставить("destinationFileName", "CustomSettings.dflt.xml");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(пПараметрыПодключенияMS, СтруктураЗапроса, ОтправляемыеДанные, АдресаПеременных);
		
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) Тогда
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		ЛокЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS(пПараметрыПодключенияMS);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию(пПараметрыПодключенияMS)

	ИмяСобытия = "ЛокЯдро_ИнициализацияНастроек_ЗагрузитьФайлНастроекПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыПодключенияMS",
		пПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("ПутьКФайлу", "DataProcessors/");
	ПараметрыФайла.Вставить("ИмяФайла",	  "1CConfigs.xml");
	
	АдресДвоичныхДанных = ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS(пПараметрыПодключенияMS, ПараметрыФайла);
	
	Если НЕ ЭтоАдресВременногоХранилища(АдресДвоичныхДанных) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресДвоичныхДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат АдресДвоичныхДанных;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ИнициализацияНастроек_ИзмениласьВерсияКонфигурацииSMARTS(пПараметрыПодключенияMS = Неопределено) Экспорт

	Перем ИдентификаторБазыMS, ВерсияКонфигурацииMS;
	
	ИмяСобытия = "ЛокЯдро_ИнициализацияНастроек_ИзмениласьВерсияКонфигурацииSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыПодключенияMS",
		пПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ЗначениеПоУмолчанию = Ложь;
	
	Если пПараметрыПодключенияMS = Неопределено Тогда
		пПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	Если НЕ ТипЗнч(пПараметрыПодключенияMS) = Тип("Структура") Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначениеПоУмолчанию);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	пПараметрыПодключенияMS.Свойство("Ид", ИдентификаторБазыMS);
	пПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииMS);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS)
		ИЛИ НЕ ЗначениеЗаполнено(ВерсияКонфигурацииMS) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначениеПоУмолчанию);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ИмяПеременнойВерсия = "Cleverence_ИнициализацияНастроек_ВерсияКонфигурацииMS_" + ИдентификаторБазыMS;
	
	СохраненнаяВерсияКонфигурацииMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С(ИмяПеременнойВерсия);
	Если НЕ ЗначениеЗаполнено(СохраненнаяВерсияКонфигурацииMS)
		ИЛИ НЕ СокрЛП(СохраненнаяВерсияКонфигурацииMS) = СокрЛП(ВерсияКонфигурацииMS) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Истина;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначениеПоУмолчанию);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS(пПараметрыПодключенияMS)

	Перем ИдентификаторБазыMS, ВерсияКонфигурацииMS;
	
	ИмяСобытия = "ЛокЯдро_ИнициализацияНастроек_СохранитьВерсиюКонфигурацииSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыПодключенияMS",
		пПараметрыПодключенияMS);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если НЕ ТипЗнч(пПараметрыПодключенияMS) = Тип("Структура") Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось сохранить версию конфигурации SMARTS: переданные параметры подключения MS не являются структурой'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока);
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	пПараметрыПодключенияMS.Свойство("Ид", ИдентификаторБазыMS);
	пПараметрыПодключенияMS.Свойство("ВерсияКонфигурацииSMARTS", ВерсияКонфигурацииMS);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазыMS)
		ИЛИ НЕ ЗначениеЗаполнено(ВерсияКонфигурацииMS) Тогда
		// <Лог>
		ЯзСтрока = "ru = 'Не удалось сохранить версию конфигурации SMARTS: не заполнены идентификатор базы MS или версия конфигурации MS'";
		ТекстОшибки = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока);
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS);
	
	ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ИнициализацияНастроек_ВерсияКонфигурацииMS_" + ИдентификаторБазыMS, ВерсияКонфигурацииMS);
	ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаАктуальностиНастроек_" + ИдентификаторБазыMS, ТекущаяДата());
	
	пСообщение = НСтр("ru = 'Сброшена дата актуальности настроек, постфикс базы: %1';
						|en = 'The date of the current settings has been reset, the database postfix is %1';
						|be = 'Скінутая дата актуальнасці налад, постфикс базы: %1'; es = 'Se ha restablecido la fecha de actualización de la configuración, postfix base: %1'; ka = 'მიმდინარე პარამეტრების თარიღი გადატვირთულია, მონაცემთა ბაზის postfix არის %1'; kk = 'Параметрлердің жаңартылған күні, базаның постфиксі қалпына келтірілді: %1'; ro = 'Data setărilor curente a fost resetată, baza de date postfix este %1'; tr = 'Ayarların güncel olduğu tarih sıfırlandı, taban sonrası düzeltme: % 1'; uk = 'Скинута дата актуальності налаштувань, постфікс бази: %1'; uz = 'Sozlamalar yangilangan sana, postfiks bazasi: %1'");
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ?(ИдентификаторБазыMS = "", "<нет>", ИдентификаторБазыMS));
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS,ПараметрыФайла",
		ПараметрыПодключенияMS, ПараметрыФайла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(?(ЕстьЧастнаяБаза, "Частная", "Основная"));
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПараметрыПодключенияMS", 	ПараметрыПодключенияMS);
		ПараметрыМетода.Вставить("ПараметрыФайла", 			ПараметрыФайла);
		ПараметрыМетода.Вставить("ТипИнтерфейса",			ТипИнтерфейса);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ЗагрузитьФайлИзБазыSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		АдресДвоичныхДанных = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		Если ТипИнтерфейса = "REST_API" Тогда
			АдресДвоичныхДанных = REST_API_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла);
		Иначе
			АдресДвоичныхДанных = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", АдресДвоичныхДанных);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат АдресДвоичныхДанных;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьРабочийКаталогОсновнойОбработки(ПутьОсновнойОбработки)

	КаталогОсновнойОбработки = "";
	
	РазделительПути = ПолучитьРазделительПути();
	
	ПозицияРазделителя = ЛокЯдро_СтрНайти(ПутьОсновнойОбработки, РазделительПути, "СКонца");
	Если ПозицияРазделителя Тогда
		КаталогОсновнойОбработки = Лев(ПутьОсновнойОбработки, ПозицияРазделителя - 1);
	КонецЕсли;	
	
	Возврат КаталогОсновнойОбработки;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПутьИнтеграционнойОбработки(ПутьОсновнойОбработки)

	РазделительПути = ПолучитьРазделительПути();
	
	ПутьИнтеграционнойОбработки = ЛокЯдро_ПолучитьРабочийКаталогОсновнойОбработки(ПутьОсновнойОбработки)
		 + РазделительПути
		 + "Integrations"
		 + РазделительПути;
	
	Возврат ПутьИнтеграционнойОбработки;
	
КонецФункции

&НаСервере
Процедура ЛокЯдро_ПолучитьЗначенияПеременныхИО(АдресСтруктуры) 

	СтруктураОбработки = ПолучитьИзВременногоХранилища(АдресСтруктуры);
	ИнтеграционнаяОбработкаПодключена = СтруктураОбработки.Свойство("Подключена") И СтруктураОбработки.Подключена;
	ИмяИнтеграционнойОбработки = СтруктураОбработки.ИмяОбработки;
	
КонецПроцедуры
	
// Выполняет обновление структуры настроек бизнес-процессов
//
// Возвращаемое значение:
//	Булево - флаг успешности выполнения операции
&НаКлиенте
Функция ЛокЯдро_ПроверитьОбновлениеТиповыхБизнесПроцессов(пСтруктураНастроек) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПроверитьОбновлениеТиповыхБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураНастроек = Новый Структура("ВерсияНастроек,ВерсияНастроек_ПоУмолчанию", Неопределено, Неопределено);
	СтруктураНастроек_Пользовательские 	= Новый Структура;
	СтруктураНастроек_ПоУмолчанию 		= Новый Структура;
	
	ВерсияНастроек_ПоУмолчанию 				= Ложь;
	НастройкиБизнесПроцессов_ПоУмолчанию 	= Ложь;
	
	ЗначениеКлюча_НастройкиПоУмолчанию = пСтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию;
	Если ЗначениеЗаполнено(ЗначениеКлюча_НастройкиПоУмолчанию) И ЗначениеКлюча_НастройкиПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(ЗначениеКлюча_НастройкиПоУмолчанию) = Тип("Строка") Тогда
			ЗначениеКлюча_НастройкиПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(ЗначениеКлюча_НастройкиПоУмолчанию);		
		КонецЕсли;
	    Если ТипЗнч(ЗначениеКлюча_НастройкиПоУмолчанию) = Тип("Структура") Тогда
			Если ЗначениеКлюча_НастройкиПоУмолчанию.Свойство("ВерсияНастроек") Тогда
				ВерсияНастроек_ПоУмолчанию = ЗначениеКлюча_НастройкиПоУмолчанию.ВерсияНастроек;
			КонецЕсли;
			Если ЗначениеКлюча_НастройкиПоУмолчанию.Свойство("НастройкиБизнесПроцессов") Тогда
				НастройкиБизнесПроцессов_ПоУмолчанию = ЗначениеКлюча_НастройкиПоУмолчанию.НастройкиБизнесПроцессов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ВерсияНастроек_Пользовательские 			= Ложь;
	НастройкиБизнесПроцессов_Пользовательские 	= Ложь;
	
	ЗначениеКлюча_НастройкиПользовательские = пСтруктураНастроек.НастройкиБизнесПроцессов_Пользовательские;
	Если ЗначениеЗаполнено(ЗначениеКлюча_НастройкиПользовательские) И ЗначениеКлюча_НастройкиПользовательские <> Ложь Тогда
		Если ТипЗнч(ЗначениеКлюча_НастройкиПользовательские) = Тип("Строка") Тогда
			ЗначениеКлюча_НастройкиПользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(ЗначениеКлюча_НастройкиПользовательские);		
		КонецЕсли;
		Если ТипЗнч(ЗначениеКлюча_НастройкиПользовательские) = Тип("Структура") Тогда
			Если ЗначениеКлюча_НастройкиПользовательские.Свойство("ВерсияНастроек") Тогда
				ВерсияНастроек_Пользовательские = ЗначениеКлюча_НастройкиПользовательские.ВерсияНастроек;
			КонецЕсли;
			Если ЗначениеКлюча_НастройкиПользовательские.Свойство("НастройкиБизнесПроцессов") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ЗначениеКлюча_НастройкиПользовательские.НастройкиБизнесПроцессов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем версии пользовательских настроек из настроек БП (если настройки сохранены в новом формате), либо по старому ключу, все это реализовано в соответствующих методах
	СтруктураНастроек_ПоУмолчанию.Вставить("НастройкиБизнесПроцессов", 		НастройкиБизнесПроцессов_ПоУмолчанию);
	СтруктураНастроек_Пользовательские.Вставить("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов_Пользовательские);

	СтруктураНастроек.ВерсияНастроек			 = ВерсияНастроек_Пользовательские;
	СтруктураНастроек.ВерсияНастроек_ПоУмолчанию = ВерсияНастроек_ПоУмолчанию;		
		
	НужноОбновить = Ложь;
	Если Не ЗначениеЗаполнено(СтруктураНастроек.ВерсияНастроек) ИЛИ СтруктураНастроек.ВерсияНастроек = Ложь Тогда
		НужноОбновить = Истина;
	ИначеЕсли ТипЗнч(СтруктураНастроек.ВерсияНастроек) = Тип("Строка") И ТипЗнч(СтруктураНастроек.ВерсияНастроек_ПоУмолчанию) = Тип("Строка") Тогда		
		ВерсияНастроекСтр = СтруктураНастроек.ВерсияНастроек;
		ВерсияНастроек_ПоУмолчаниюСтр = СтруктураНастроек.ВерсияНастроек_ПоУмолчанию;
		Пока Истина Цикл
			Если СтрДлина(ВерсияНастроек_ПоУмолчаниюСтр) = 0 Тогда
				Прервать;
			КонецЕсли;
			Если СтрДлина(ВерсияНастроекСтр) = 0 Тогда
				НужноОбновить = Истина;
				Прервать;
			КонецЕсли;
			
			Инд = Найти(ВерсияНастроек_ПоУмолчаниюСтр,".");
			Если Инд = 0 Тогда				
				ВерсияПоУмолчанию = ВерсияНастроек_ПоУмолчаниюСтр;
				ВерсияНастроек_ПоУмолчаниюСтр = "";
			Иначе
				ВерсияПоУмолчанию = Лев(ВерсияНастроек_ПоУмолчаниюСтр,Инд-1);
				ВерсияНастроек_ПоУмолчаниюСтр = Прав(ВерсияНастроек_ПоУмолчаниюСтр,СтрДлина(ВерсияНастроек_ПоУмолчаниюСтр)-Инд);
			КонецЕсли;
			
			Попытка
				ВерсияПоУмолчанию = Число(ВерсияПоУмолчанию);	
			Исключение
				Прервать;
			КонецПопытки;
			
			Инд = Найти(ВерсияНастроекСтр,".");
			Если Инд = 0 Тогда				
				ТекВерсия = ВерсияНастроекСтр;
				ВерсияНастроекСтр = "";
			Иначе
				ТекВерсия = Лев(ВерсияНастроекСтр,Инд-1);
				ВерсияНастроекСтр = Прав(ВерсияНастроекСтр,СтрДлина(ВерсияНастроекСтр)-Инд);
			КонецЕсли;
			
			Попытка
				ТекВерсия = Число(ТекВерсия);	
			Исключение
				НужноОбновить = Истина;
				Прервать;
			КонецПопытки;
			
			Если ВерсияПоУмолчанию > ТекВерсия Тогда
				НужноОбновить = Истина;
				Прервать;	
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ НужноОбновить Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;	
	КонецЕсли;
	
	НастройкиБизнесПроцессовПоУмолчанию = СтруктураНастроек_ПоУмолчанию.НастройкиБизнесПроцессов;
	Если НастройкиБизнесПроцессовПоУмолчанию <> Неопределено и НастройкиБизнесПроцессовПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессовПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессовПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессовПоУмолчанию,Истина);
		КонецЕсли;
		
		СтруктураНастроекБизнесПроцессов_ПоУмолчанию = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессовПоУмолчанию, 
				ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		                                                                		
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПоУмолчанию", СтруктураНастроекБизнесПроцессов_ПоУмолчанию);
	
	КонецЕсли; 
		
	Если СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов = Ложь Тогда	
		НастройкиБизнесПроцессовСтарые = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");	
		Если НастройкиБизнесПроцессовСтарые <> Неопределено и НастройкиБизнесПроцессовСтарые <> Ложь Тогда
			НастройкиБизнесПроцессов_Пользовательские = НастройкиБизнесПроцессовСтарые;
			СтруктураНастроекБизнесПроцессов_Пользовательские = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_Пользовательские, 
				ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
			ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
			ЛокЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("НастройкиБизнесПроцессов",Ложь), Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	НужноСохранить=Ложь;
	
	НастройкиБизнесПроцессов_Пользовательские = СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов;
	Если НастройкиБизнесПроцессов_Пользовательские <> Неопределено И НастройкиБизнесПроцессов_Пользовательские <> Ложь Тогда		
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские,Истина);
		КонецЕсли;
		Икс = НастройкиБизнесПроцессов_Пользовательские.Количество();
		Пока Икс > 0 Цикл
			Икс = Икс - 1;
			НастройкаБП = НастройкиБизнесПроцессов_Пользовательские[Икс];
			Если НастройкаБП.Свойство("ID_БизнесПроцесса") Тогда
				ID = НастройкаБП.ID_БизнесПроцесса;
			ИначеЕсли НастройкаБП.Свойство("IDБизнесПроцесса") Тогда
				ID = НастройкаБП.IDБизнесПроцесса;
			Иначе
				ID = Неопределено;
			КонецЕсли;
			Если ID <> Неопределено Тогда
				Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиБизнесПроцессовПоУмолчанию,"ID_БизнесПроцесса",ID,Истина);
				Если Индекс <> Неопределено Тогда
					НастройкиБизнесПроцессов_Пользовательские.Удалить(Икс);
					НужноСохранить=Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ОбновитьСтруктуруНастроекБизнесПроцессов(НастройкиБизнесПроцессов_Пользовательские, НужноСохранить);
	КонецЕсли;	
	
	Если НужноСохранить Тогда
		СтруктураНастроекБизнесПроцессов_Пользовательские = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_Пользовательские, 
			ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки()); 		
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", 	СтруктураНастроекБизнесПроцессов_Пользовательские);	
	КонецЕсли;
	
	ПроизвольныеКоды_ПоУмолчанию = ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("ПроизвольныеКоды_ПоУмолчанию");
	Если ПроизвольныеКоды_ПоУмолчанию <> Неопределено и ПроизвольныеКоды_ПоУмолчанию <> Ложь Тогда
		Если ТипЗнч(ПроизвольныеКоды_ПоУмолчанию) = Тип("Строка") Тогда
			ПроизвольныеКоды_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_ПоУмолчанию,Истина);
		КонецЕсли;
		
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию", ПроизвольныеКоды_ПоУмолчанию);
	КонецЕсли;
	
	ПроизвольныеКоды_Пользовательские = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские");
	НужноСохранить=Ложь;
	Если ПроизвольныеКоды_Пользовательские <> Неопределено и ПроизвольныеКоды_Пользовательские <> Ложь Тогда
		Если ТипЗнч(ПроизвольныеКоды_Пользовательские) = Тип("Строка") Тогда
			ПроизвольныеКоды_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(ПроизвольныеКоды_Пользовательские,Истина);
		КонецЕсли;
		Икс = ПроизвольныеКоды_Пользовательские.Количество();
		Пока Икс > 0 Цикл
			Икс = Икс - 1;
			СтрокаПК = ПроизвольныеКоды_Пользовательские[Икс];
			Если СтрокаПК.Свойство("ID_ПроизвольногоКода") Тогда
				Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПроизвольныеКоды_ПоУмолчанию,"ID_ПроизвольногоКода",СтрокаПК.ID_ПроизвольногоКода,Истина);
				Если Индекс <> Неопределено Тогда
					ПроизвольныеКоды_Пользовательские.Удалить(Икс);
					НужноСохранить=Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;		
		
		НоваяНастройка = Новый Массив;
		НоваяНастройка.Добавить(Новый Структура("КолонкиТаблицыЗначений,ЭтоТаблицаЗначений","Наименование,Описание,ТекстПроизвольногоКода,ID_ПроизвольногоКода,Направление,ТипОбъекта",Истина));
		
		Для Каждого ПроизвольныйКод из ПроизвольныеКоды_Пользовательские Цикл
			Если ПроизвольныйКод.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ПроизвольныйКод.Свойство("ID_Кода") Тогда
				НовыйПроизвольныйКод = Новый Структура();
				НовыйПроизвольныйКод.Вставить("Наименование",			ПроизвольныйКод.Наименование);
				НовыйПроизвольныйКод.Вставить("Описание",				"");
				НовыйПроизвольныйКод.Вставить("ТекстПроизвольногоКода",	ПроизвольныйКод.ТекстКода);
				НовыйПроизвольныйКод.Вставить("ID_ПроизвольногоКода",	ПроизвольныйКод.ID_Кода);
				НовыйПроизвольныйКод.Вставить("Направление",			ПроизвольныйКод.Направление);
				НовыйПроизвольныйКод.Вставить("ТипОбъекта",				ПроизвольныйКод.ТипОбъекта);		
				НоваяНастройка.Добавить(НовыйПроизвольныйКод);
				НужноСохранить = Истина;
			ИначеЕсли ПроизвольныйКод.Свойство("ID_ПроизвольногоКода") Тогда
				НоваяНастройка.Добавить(ПроизвольныйКод);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	Если НужноСохранить Тогда
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", НоваяНастройка);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", НоваяНастройка);	
	КонецЕсли;	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновитьПереопределяемыеНастройкиБизнесПроцессов(ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьПереопределяемыеНастройкиБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	#КонецЕсли
	
	Изменено = Ложь;
	
	ID_ТекущегоУзла = "";
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла");
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 		= ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	НастройкиБизнесПроцессов_ПоУмолчанию 				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	
	Если ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = ЛокЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS("");
	Иначе
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	КонецЕсли;
	
	НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	
	// Типовые настройки БП
	ТиповыеБизнесПроцессыПоID = Новый Соответствие;
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);		
		КонецЕсли;		
		
		Для Каждого НастройкаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если НЕ НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				ТиповыеБизнесПроцессыПоID.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Пользовательские настройки главного узла
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел);		
		КонецЕсли;		
		
		Изменено = Ложь;
		НовыеПользовательскиеНастройки = Новый Массив;
		
		Для Каждого ПользовательскаяНастройка Из НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел Цикл
			Если ПользовательскаяНастройка.Свойство("ЭтоТаблицаЗначений") Тогда
				НовыеПользовательскиеНастройки.Добавить(ПользовательскаяНастройка);
				Продолжить;
			КонецЕсли;
			
			НастройкаБП = ТиповыеБизнесПроцессыПоID.Получить(ПользовательскаяНастройка.ID_БизнесПроцесса);
			Если НастройкаБП <> Неопределено Тогда
				
				Если ПользовательскаяНастройка.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(ПользовательскаяНастройка.ПереопределяемыеНастройки) Тогда
					
					ПереопределяемыеНастройки = ЛокЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(НастройкаБП, ПользовательскаяНастройка.ПереопределяемыеНастройки);
					
					Если НЕ ПереопределяемыеНастройки = Неопределено Тогда
						ПользовательскаяНастройка.ПереопределяемыеНастройки = ПереопределяемыеНастройки;
						Изменено = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
				НовыеПользовательскиеНастройки.Добавить(ПользовательскаяНастройка);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Изменено Тогда
			
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НовыеПользовательскиеНастройки,);
			Если НЕ ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
				ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НовыеПользовательскиеНастройки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Обновляет переопределяемые настройки бизнес-процессов после обновления типовых настроек.
// - Отключает новое типовое поле, если уже есть пользовательсоке
// - Удаляет отключенные типовые поля, если они были удалены в типовых настройках
// - Удаляет переопределенную настройку, если в массиве больше нет изменений
&НаКлиенте
Функция ЛокЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(НастройкиТиповые, НастройкиПользовательские, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьСтруктуруПереопределяемыхНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкиТиповые,НастройкиПользовательские,ДополнительныеПараметры",
		НастройкиТиповые, НастройкиПользовательские, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Изменено = Ложь;
	ОбновленнаяСтруктура = Новый Структура;
	
	Для каждого КлючЗначение Из НастройкиПользовательские Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеПользв = КлючЗначение.Значение;
		
		ЗначениеТиповой = Неопределено;
		НастройкиТиповые.Свойство(ИмяНастройки, ЗначениеТиповой);
		
		ТипЗнчПользв = ТипЗнч(ЗначениеПользв);
		ТипЗнчТиповой = ТипЗнч(ЗначениеТиповой);
		
		Если ТипЗнчПользв = Тип("Массив") Тогда
			ЗначениеПользв = ЛокЯдро_СкопироватьМассив(ЗначениеПользв);
		ИначеЕсли ТипЗнчПользв = Тип("Структура") Тогда
			ЗначениеПользв = ЛокЯдро_СкопироватьСтруктуру(ЗначениеПользв);
		КонецЕсли;
		
		Если ТипЗнчТиповой = Тип("Массив") Тогда
			ЗначениеТиповой = ЛокЯдро_СкопироватьМассив(ЗначениеТиповой);
		ИначеЕсли ТипЗнчТиповой = Тип("Структура") Тогда
			ЗначениеТиповой = ЛокЯдро_СкопироватьСтруктуру(ЗначениеТиповой);
		КонецЕсли;
		
		Если ЗначениеТиповой = Неопределено Тогда
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Продолжить;
		ИначеЕсли ТипЗнчПользв <> ТипЗнчТиповой Тогда
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчПользв = Тип("Массив") Тогда
			
			// Для возможности объединить массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			ИзмененныйМассив = Новый Массив;
			МассивИзменен = Ложь;
			
			// Проверяем наличие пользовательских элементов в типовых
			Для каждого ЭлементПользв Из ЗначениеПользв Цикл
				
				Если ЭлементПользв.Свойство("ЭтоТаблицаЗначений") Тогда
					ИзмененныйМассив.Добавить(ЭлементПользв);
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементПользв);
				
				ЭлементТиповой = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеТиповой, Отбор, Истина);
				Если ЭлементТиповой <> Неопределено Тогда
					
					Если ЭлементПользв.Свойство("Типовой") И ЭлементПользв.Типовой = Ложь Тогда
						
						// Пользовательский элемент, который есть в типовых.		
						Если (ЭлементПользв.Свойство("Выгружать") И ЭлементПользв.Выгружать = Истина)
							ИЛИ (ЭлементПользв.Свойство("Загружать") И ЭлементПользв.Загружать = Истина) Тогда
							
							// Это включённое пользовательское поле. Проверяем, что типовое поле отключено,
							// 	так как в типовых настройках могло появиться поле, которое уже настроено у пользователя.
							
							Отключено = Ложь;
							
							// Проверяем, что для пользовательского поля есть отключенное типовое поле
							ЭлементыПользв = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПользв, Отбор, Ложь);
							Если ЭлементыПользв <> Неопределено И ЭлементыПользв.Количество() > 0 Тогда
								Для каждого СтрокаПоля Из ЭлементыПользв Цикл
									
									Если НЕ СтрокаПоля.Свойство("Типовой") 
										ИЛИ НЕ СтрокаПоля.Типовой = Ложь Тогда
										Отключено = Истина;
										Прервать;
									КонецЕсли;
									
								КонецЦикла;
							КонецЕсли;
							
							Если НЕ Отключено Тогда
								// Не нашли отключённое поле - значит, оно новое,
								// 	и нужно отключить типовое поле, чтобы работала настройка пользователя.
								НовоеПоле = Новый Структура(КлючиУникальности);
								ЗаполнитьЗначенияСвойств(НовоеПоле, ЭлементПользв);
								Если ЭлементПользв.Свойство("Выгружать") Тогда
									НовоеПоле.Вставить("Выгружать", Ложь);
								Иначе
									НовоеПоле.Вставить("Загружать", Ложь);
								КонецЕсли;
								ЗначениеПользв.Добавить(НовоеПоле);
								МассивИзменен = Истина; // Изменено т.к добавили новое поле в пользв настройки
							КонецЕсли;
							
						КонецЕсли;
						
						ИзмененныйМассив.Добавить(ЭлементПользв);
						
					Иначе
						// Переопределенный типовой элемент
						
						пОбновленнаяСтруктура = ЛокЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(ЭлементТиповой, ЭлементПользв);
						Если пОбновленнаяСтруктура = Неопределено Тогда	
							ИзмененныйМассив.Добавить(ЭлементПользв); // Изменений нет
								
						Иначе
							
							// Если вернулся результат, значит структура была изменена
							Если пОбновленнаяСтруктура.Количество() = ЭлементПользв.Количество() Тогда
								// Количество ключей совпадает, значит массив внутри не был удален, если он есть
								ИзмененныйМассив.Добавить(пОбновленнаяСтруктура);
								МассивИзменен = Истина; 
							Иначе
								
								// Массив внутри пОбновленнаяСтруктура был удален.
								// Проверяем, если внутри пОбновленнаяСтруктура содержатся другие ключи помимо КлючиУникальности, 
								//	то оставим этот элемент, иначе удалим, т.к он теперь пустой.
								СтруктураКлючей = Новый Структура(КлючиУникальности);
								Для каждого КлючЗначение Из пОбновленнаяСтруктура Цикл
									Если НЕ СтруктураКлючей.Свойство(КлючЗначение.Ключ) Тогда
										ИзмененныйМассив.Добавить(пОбновленнаяСтруктура);
										Прервать;
									КонецЕсли;
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					Если ЭлементПользв.Свойство("Типовой") И ЭлементПользв.Типовой = Ложь Тогда
						// Пользовательский элемент, которого нет в типовых
						ИзмененныйМассив.Добавить(ЭлементПользв);
					Иначе
						// Типовой элемент, который был удален из типовых настроек. 
						// Удалим его из пользовательских настроек.
						МассивИзменен = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ИзмененныйМассив.Количество() > 1
				ИЛИ (ИзмененныйМассив.Количество() = 1 
					И НЕ ИзмененныйМассив[0].Свойство("ЭтоТаблицаЗначений")) Тогда
				
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, ИзмененныйМассив);
				
				Если МассивИзменен Тогда
					Изменено = Истина;
				КонецЕсли;
				
			Иначе
				
				// Если массив оказался пустым, то удаляем ключ из настроек.
				// Возможно пользователь отключил поле, которое было удалено в типовых настройках.
				Изменено = Истина;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнчПользв = Тип("Структура") Тогда
			
			пОбъединеннаяСтруктура = ЛокЯдро_ОбновитьСтруктуруПереопределяемыхНастроек(ЗначениеТиповой, ЗначениеПользв);
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
			
			Если пОбновленнаяСтруктура = Неопределено Тогда	
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
			Иначе
				ОбновленнаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
				Изменено = Истина; // Если вернулся результат, значит структура была изменена
			КонецЕсли;
			
		Иначе
			ОбновленнаяСтруктура.Вставить(ИмяНастройки, ЗначениеПользв);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Изменено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ОбновленнаяСтруктура);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат ОбновленнаяСтруктура; // Структура изменена
	Иначе 
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено; // Структура не была изменена
	КонецЕсли;
	
КонецФункции

&НаКлиенте 
Процедура ЛокЯдро_ОбъединитьПроизвольныеКоды()
	
	ИмяСобытия = "ЛокЯдро_ОбъединитьПроизвольныеКоды";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	ПроизвольныеКоды_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию");
	ПроизвольныеКоды_Пользовательские = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские"); 
	
	Если (НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь И ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию))
		ИЛИ (НЕ ПроизвольныеКоды_Пользовательские = Ложь И ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские)) Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура("ПроизвольныеКоды_Выгрузка_ШапкаДокумента,ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента,ПроизвольныеКоды_Загрузка_ШапкаДокумента,ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента",Неопределено,Неопределено);
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек);		
		
	ПроизвольныеКоды_Пользовательские = Новый Массив;
	ПроизвольныеКоды_Пользовательские.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Наименование,Описание,ТекстПроизвольногоКода,ID_ПроизвольногоКода,Направление,ТипОбъекта"));
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента = ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента, Истина);		
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ШапкаДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Выгрузка");
				ПК.Вставить("ТипОбъекта","Шапка");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента = ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента, Истина);		
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Выгрузка_ТабличнаяЧастьДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Выгрузка");
				ПК.Вставить("ТипОбъекта","ТабличнаяЧасть");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента = ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента, Истина);		
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Загрузка_ШапкаДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Загрузка");
				ПК.Вставить("ТипОбъекта","Шапка");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента)
		И НЕ СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента = Ложь Тогда
		Если ТипЗнч(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента) = Тип("Строка") Тогда
			СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента = ЛокЯдро_ЗначениеИзСтрокиXML(СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента, Истина);		
		КонецЕсли;
		Для каждого ПК Из СтруктураНастроек.ПроизвольныеКоды_Загрузка_ТабличнаяЧастьДокумента Цикл
			Если НЕ ПК.Свойство("ЭтоТаблицаЗначений") Тогда
				ПК.Вставить("Направление","Загрузка");
				ПК.Вставить("ТипОбъекта","ТабличнаяЧасть");
				ПроизвольныеКоды_Пользовательские.Добавить(ПК);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПроизвольныеКоды_Пользовательские.Количество() > 0 Тогда
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Собирает общую структуру настроек бизнес-процессов и помещает ее в кэш
&НаКлиенте
Процедура ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_Узла = "", ИспользоватьХранилищеНастроек = Истина) Экспорт	
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ID_Узла, ИспользоватьХранилищеНастроек);
	
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов);
	
КонецПроцедуры

// Получаем общую структуру настроек бизнес-процессов по узлу
&НаКлиенте
Функция ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ID_Узла = "", ИспользоватьХранилищеНастроек = Истина) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Узла,ИспользоватьХранилищеНастроек",
		ID_Узла, ИспользоватьХранилищеНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;
	КонецЕсли;

	Если ИспользоватьХранилищеНастроек Тогда
		НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", ID_Узла);
		Если ЗначениеЗаполнено(НастройкиБизнесПроцессов) И НЕ НастройкиБизнесПроцессов = Ложь Тогда
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиБизнесПроцессов);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат НастройкиБизнесПроцессов;
		КонецЕсли;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = Новый Массив();
	ИндексыНастройкиБизнесПроцессов = Новый Соответствие;
	
	Если ID_ТекущегоУзла = ID_Узла Тогда
		// В функцию передан Ид текущего узла, значения настроек БП содержатся в кэше
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	Иначе
		// Настроек БП нет в кэше, получаем их для переданного Ид узла из базы Клеверенс                                                        		
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки	= ЛокЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла);
	КонецЕсли;
	
	// НастройкиБизнесПроцессов_ПоУмолчанию и СтруктураНастроекБизнесПроцессов_Пользовательские не отличаются для разных узлов
	СтруктураНастроекБизнесПроцессов_ПоУмолчанию 		= ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	СтруктураНастроекБизнесПроцессов_Пользовательские 	= ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();
	
	НастройкиБизнесПроцессов_ПоУмолчанию				= СтруктураНастроекБизнесПроцессов_ПоУмолчанию.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_Пользовательские 			= СтруктураНастроекБизнесПроцессов_Пользовательские.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_ПользовательскиеНастройки 	= СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
	
	ИдТиповыхБП = Новый Массив();
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию, Истина);		
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл			
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Истина);
				НастройкиБизнесПроцессов.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
				ИндексыНастройкиБизнесПроцессов.Вставить(СтрокаБП.ID_БизнесПроцесса, НастройкиБизнесПроцессов.ВГраница());
				ИдТиповыхБП.Добавить(СтрокаБП.ID_БизнесПроцесса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские, Истина);		
		КонецЕсли;
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
			Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда			
				СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Ложь);
				Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
					НастройкиБизнесПроцессов.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
					ИндексыНастройкиБизнесПроцессов.Вставить(СтрокаБП.ID_БизнесПроцесса, НастройкиБизнесПроцессов.ВГраница());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоГлавныйУзел = НЕ ЗначениеЗаполнено(ID_Узла);
	
	// Переопределение пользовательских настроек главного узла
	Если НЕ ЭтоГлавныйУзел Тогда
		СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ЛокЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS("");
		НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел.НастройкиБизнесПроцессов; 
	Иначе
		НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = НастройкиБизнесПроцессов_ПользовательскиеНастройки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) И НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел, Истина);
		КонецЕсли;
		
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки_ГлавныйУзел Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Индекс = ИндексыНастройкиБизнесПроцессов.Получить(СтрокаБП.ID_БизнесПроцесса);
			Если Индекс <> Неопределено Тогда
				
				// Переключатель для отключения пользовательских настроек для ТП
				#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
					Если СтрокаБП.Свойство("ИспользоватьТиповыеНастройки") И СтрокаБП.ИспользоватьТиповыеНастройки = Истина Тогда
						НастройкиБизнесПроцессов[Индекс].Вставить("ИспользоватьТиповыеНастройки", Истина);
						
					ИначеЕсли СтрокаБП.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(СтрокаБП.ПереопределяемыеНастройки) Тогда
						НастройкиБизнесПроцессов[Индекс] = ЛокЯдро_ОбъединитьСтруктуруНастроек(НастройкиБизнесПроцессов[Индекс], СтрокаБП.ПереопределяемыеНастройки);
						
					КонецЕсли;
				#Иначе
					НастройкиБизнесПроцессов[Индекс].Вставить("ИспользоватьТиповыеНастройки", Истина);
				#КонецЕсли
				
				Если НастройкиБизнесПроцессов[Индекс].Свойство("ПереопределяемыеНастройки") Тогда
					НастройкиБизнесПроцессов[Индекс].Удалить("ПереопределяемыеНастройки");
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НастройкиБизнесПроцессов[Индекс], СтрокаБП);
				
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Переопределение пользовательских настроек пользовательских узлов
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	ПользовательскиеНастройкиГлавногоУзла = КатегорииНастроекMS.ПользовательскиеНастройкиГлавногоУзла;
	
	Если НЕ ЭтоГлавныйУзел И ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПользовательскиеНастройки) И НЕ (НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Истина);		
		КонецЕсли;
		
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Индекс = ИндексыНастройкиБизнесПроцессов.Получить(СтрокаБП.ID_БизнесПроцесса);
			Если Индекс <> Неопределено Тогда
				
				Для Каждого КлючИЗначение Из СтрокаБП Цикл
					Если ПользовательскиеНастройкиГлавногоУзла.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НастройкиБизнесПроцессов[Индекс].Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЦикла;
				
				НастройкиБизнесПроцессов[Индекс].Вставить("ПользовательскаяНастройка", Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Обновляем значения кэшируемых настроек
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", НастройкиБизнесПроцессов, ID_Узла);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиБизнесПроцессов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат НастройкиБизнесПроцессов;
	
КонецФункции

// Собирает общую структуру произвольных кодов и помещает ее в кэш
&НаКлиенте
Процедура ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(ИспользоватьХранилищеНастроек = Истина) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИспользоватьХранилищеНастроек",
		ИспользоватьХранилищеНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ИспользоватьХранилищеНастроек Тогда
		ПроизвольныеКоды = ЛокЯдро_ПолучитьЗначениеКэшируемойНастройки("ПроизвольныеКоды", "");
		Если ЗначениеЗаполнено(ПроизвольныеКоды) И НЕ ПроизвольныеКоды = Ложь Тогда
			ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды", ПроизвольныеКоды);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПроизвольныеКоды = Новый Массив();
	ПроизвольныеКоды_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию");
	ПроизвольныеКоды_Пользовательские = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские");	
	
	Если ЗначениеЗаполнено(ПроизвольныеКоды_ПоУмолчанию) И НЕ ПроизвольныеКоды_ПоУмолчанию = Ложь Тогда
		Для Каждого СтрокаПК Из ПроизвольныеКоды_ПоУмолчанию Цикл    
			Если НЕ СтрокаПК.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаПК.Вставить("ЭтоТиповой",Истина);
				ПроизвольныеКоды.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПК));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПроизвольныеКоды_Пользовательские) И НЕ ПроизвольныеКоды_Пользовательские = Ложь Тогда
		Для Каждого СтрокаПК Из ПроизвольныеКоды_Пользовательские Цикл
			Если НЕ СтрокаПК.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаПК.Вставить("ЭтоТиповой",Ложь);
				ПроизвольныеКоды.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПК));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды", ПроизвольныеКоды);
	
	// Обновляем значения кэшируемых настроек
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды", 					ПроизвольныеКоды, 					"");
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды_ПоУмолчанию", 		ПроизвольныеКоды_ПоУмолчанию, 		"");
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ПроизвольныеКоды_Пользовательские", 	ПроизвольныеКоды_Пользовательские, 	"");
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров(ИспользоватьХранилищеНастроек = Истина) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СобратьОбщуюСтруктуруГлобальныхПараметров";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИспользоватьХранилищеНастроек",
		ИспользоватьХранилищеНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ИспользоватьХранилищеНастроек Тогда
		ГлобальныеПараметры = ЛокЯдро_ПолучитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", "");
		Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
			ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры", ГлобальныеПараметры);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ГлобальныеПараметры = Новый Массив();
	ГлобальныеПараметры_ПоУмолчанию 	 = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_ПоУмолчанию");
	ГлобальныеПараметры_Пользовательские = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_Пользовательские");	
	
	Если НЕ ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) ИЛИ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		ГлобальныеПараметры_ПоУмолчанию = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
		Для каждого СтрокаГП ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
			Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
				СтрокаГП.Вставить("Типовой", Истина);
				ГлобальныеПараметры.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаГП));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь Тогда
		Для каждого СтрокаГП ИЗ ГлобальныеПараметры_Пользовательские Цикл
			Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
				НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаГП.ID_Параметра);
				Если НайденныйПараметр <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаГП.Вставить("Типовой", Ложь);
				ГлобальныеПараметры.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаГП));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ГлобальныеПараметры", ГлобальныеПараметры);
	
	// Обновляем значения кэшируемых настроек
	ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", ГлобальныеПараметры, "");
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Дополняет настройки торговых объектов настройками главного узла
&НаКлиенте
Процедура ЛокЯдро_СобратьОбщуюСтруктуруОтборов(РежимОбмена, ID_Узла = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СобратьОбщуюСтруктуруОтборов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ID_Узла",
		РежимОбмена, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ID_Узла = Неопределено Тогда
		ID_Узла = "";
		Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
			ID_Узла = ДанныеТекущегоУзла.ID_Узла;
		КонецЕсли;
	КонецЕсли;
	
	НастройкиОтборов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
	
	// Настройки главного узла - при их отсутствии - получаем из настроек по умолчанию (с сохранением в базу и кеш)
	Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда
		Если НЕ ЗначениеЗаполнено(НастройкиОтборов)	ИЛИ НастройкиОтборов = Ложь Тогда
			// На всякий случай дополнительно проверим наличие настроек в базе, а не только в кэше, чтобы ничего не потерять
			НастройкиОтборов = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_Узла);
			
			Если НЕ ЗначениеЗаполнено(НастройкиОтборов) ИЛИ НастройкиОтборов = Ложь Тогда
				НастройкиОтборов_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_ПоУмолчанию_" + РежимОбмена);
				Если ЗначениеЗаполнено(НастройкиОтборов_ПоУмолчанию) И НЕ НастройкиОтборов_ПоУмолчанию = Ложь Тогда
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов_ПоУмолчанию, ID_Узла);
					ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов_ПоУмолчанию);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	// Настройки торгового объекта - при их отсутствии - получаем из настроек главного узла (с сохранением в кеш)
	Иначе
		НастройкиОтборов_ГлавныйУзел = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, "");
		Если НЕ ЗначениеЗаполнено(НастройкиОтборов_ГлавныйУзел) ИЛИ НастройкиОтборов_ГлавныйУзел = Ложь Тогда
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НастройкиОтборов) И НЕ НастройкиОтборов = Ложь Тогда
			Для каждого СтрокаНастройки ИЗ НастройкиОтборов_ГлавныйУзел Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
								
				СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				МассивСтрок = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборов, СтруктураОтбора);
				Если МассивСтрок = Неопределено Тогда
					НастройкиОтборов.Добавить(СтрокаНастройки);
				КонецЕсли;
			КонецЦикла;
		Иначе
			НастройкиОтборов = НастройкиОтборов_ГлавныйУзел;
		КонецЕсли;
		
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СобратьНастройкиОбменаСправочников(ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_СобратьНастройкиОбменаСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НастройкаИзменена = Ложь;
	
	НастройкиКПолучению = Новый Структура("НастройкиОбменаСправочников, НастройкиОбменаСправочников_ПоУмолчанию");
	ЗначенияНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
	
	НастройкиОбменаСправочников_Пользовательские = ЗначенияНастроек.НастройкиОбменаСправочников;
	НастройкиОбменаСправочников_ПоУмолчанию = ЗначенияНастроек.НастройкиОбменаСправочников_ПоУмолчанию;
	
	НастройкиОбменаСправочников = Новый Массив;
	КолонкиТаблицы = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
	НастройкиОбменаСправочников.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	
	СписокИспользуемыхСправочников = ЛокЯдро_ПолучитьСписокИспользуемыхСправочников();
	
	СписокСохраненныхИмен = Новый СписокЗначений;
	СписокСтрокКУдалению = Новый СписокЗначений;
	Если НЕ НастройкиОбменаСправочников_Пользовательские = Ложь И ЗначениеЗаполнено(НастройкиОбменаСправочников_Пользовательские) Тогда
		Для Каждого СтрокаНастройки Из НастройкиОбменаСправочников_Пользовательские Цикл
			Если СтрокаНастройки.Свойство("КолонкиТаблицыЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			
			// Определение признака Типовой для совместимости со старыми настройками
			Если НЕ СтрокаНастройки.Свойство("Типовой") Тогда
				НоваяСтрока.Типовой = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы) <> Неопределено;
				НастройкаИзменена = Истина;
			КонецЕсли;
			
			// Временное решение для совместимости с сохраненными настройками от старых версий
			// в настройки сохранялся СписокЗначений, в новой версии разделил на ИмяТаблицы и ИмяТаблицыПредставление для возможности сохранения в файл
			Если ТипЗнч(СтрокаНастройки.ИмяТаблицы) = Тип("ЭлементСпискаЗначений") Тогда
				НоваяСтрока.ИмяТаблицы = СтрокаНастройки.ИмяТаблицы.Значение;
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы.Значение);
			Иначе
				СписокСохраненныхИмен.Добавить(СтрокаНастройки.ИмяТаблицы);
			КонецЕсли;
			// конец
			
			// в интеграционной обработке прописывается использование справочника в зависимости от значения констант в 1С
			// проверяем, если что-то отключили, то удалим такие типовые строки
			ЭлементСписка = СписокИспользуемыхСправочников.НайтиПоЗначению(НоваяСтрока.ИмяТаблицы);
			Если ЭлементСписка <> Неопределено Тогда
				НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			ИначеЕсли НЕ НоваяСтрока.Типовой Тогда
				НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			Иначе
				НастройкаИзменена = Истина;
			КонецЕсли;
				
		КонецЦикла;
	КонецЕсли;
	
	НастройкиКПолучению = Новый Структура;
	// Устарело. Получаем ключи Выгружать_Сразу для совместимости
	// Выгрузку новых справочников добавлять в НастройкиБизнесПроцессов_ПоУмолчанию
	СоответствиеКлючейВыгружатьСразу = ЛокЯдро_СоответствиеСправочниковКлючамВыгружатьСразу();
	Для каждого КлючЗначение Из СоответствиеКлючейВыгружатьСразу Цикл
		НастройкиКПолучению.Вставить(КлючЗначение.Значение);
	КонецЦикла;
	// --- 
	
	СправочникиВыгружатьПоУмолчанию = Неопределено;
	
	СтруктураМетаданных = КомЯдро_ПолучитьЗначениеПеременной("СтруктураМетаданных");
	ИменаТаблицSMARTS = Новый Массив; // Проверяем наличие таблицы в MS
	Для каждого СтрокаТаблицы Из СтруктураМетаданных.Tables Цикл
		ИменаТаблицSMARTS.Добавить(СтрокаТаблицы.Представление);
	КонецЦикла;
	ИменаТаблицSMARTS.Добавить("Номенклатура");
	ИменаТаблицSMARTS.Добавить("Ячейки");
	
	Для Каждого ИмяСправочника ИЗ СписокИспользуемыхСправочников Цикл
		Если СписокСохраненныхИмен.НайтиПоЗначению(ИмяСправочника.Значение) = Неопределено 
			И ИменаТаблицSMARTS.Найти(ИмяСправочника.Значение) <> Неопределено Тогда
			
			СправочникИмя = ИмяСправочника.Значение;
			
			НоваяСтрока = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			
			НастройкиПоУмолчанию = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОбменаСправочников_ПоУмолчанию, "ИмяТаблицы", СправочникИмя);
			Если НЕ НастройкиПоУмолчанию = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НастройкиПоУмолчанию);
			КонецЕсли;
			
			Если НастройкиПоУмолчанию = Неопределено ИЛИ НЕ НастройкиПоУмолчанию.Свойство("Выгружать") Тогда
				// +++ Устарело
				// настройки для каждого справочника лежат в отдельных ключах, поэтому проверяем так
				// Выгрузку новых справочников добавлять в НастройкиБизнесПроцессов_ПоУмолчанию
				Если СправочникиВыгружатьПоУмолчанию = Неопределено Тогда
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("НеПроверятьАктуальность", Истина);
					СправочникиВыгружатьПоУмолчанию = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,, ДополнительныеПараметры);
				КонецЕсли;
				
				ИмяКлючаВыгружатьСразу = СоответствиеКлючейВыгружатьСразу.Получить(ИмяСправочника.Значение);
				Если ИмяКлючаВыгружатьСразу <> Неопределено Тогда
					НоваяСтрока.Выгружать = СправочникиВыгружатьПоУмолчанию[ИмяКлючаВыгружатьСразу] = Истина;
				КонецЕсли;
				// --- 
			КонецЕсли;
			
			НоваяСтрока.ИмяТаблицы 				= СправочникИмя;
			НоваяСтрока.ИмяТаблицыПредставление = ИмяСправочника.Представление;
			НоваяСтрока.Типовой 				= Истина;
			
			НастройкиОбменаСправочников.Добавить(НоваяСтрока);
			НастройкаИзменена = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкаИзменена Тогда
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОбменаСправочников", НастройкиОбменаСправочников);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОбменаСправочников", НастройкиОбменаСправочников);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает из модуля обработки функцию получения информации совместимости интеграционной обработки
//
// Возвращаемое значение:
//	- Структура - содержит:	
//		* ВерсияИнтеграции - Строка
//		* ВерсияAPI - Строка
//		* ПоддерживаемаяКонфигурацияМассивИмен - Массив из Строка
//		* ПоддерживаемаяКонфигурацияСиноним - Строка
//		* флСоответствуетКонфигурации - Булево
//		* ПоддерживаемыеВерсииКонфигурации - Строка
//		* флСоответствуетВерсии - Булево
//		* ПутьКФайлу - Строка
//		* КонфигурацияПоМетаданным - Структура, Неопределено - результат определения конфигурации по метаданным,
//		  заполняется если ИО не соответствует конфигурации
//	- Неопределено - если информацию совместимости получить не удалось
&НаКлиенте
Функция ЛокЯдро_ПолучитьИнформациюСовместимости() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьИнформациюСовместимости");
	ИнформацияСовместимости = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	Возврат ИнформацияСовместимости
	
КонецФункции

// Вызывает функцию проверки соединения с базой Клеверенс.
// Если требуется авторизация, открывает форму авторизации ФормаСлужебная_АвторизацииSMARTS (ОФ_ФормаСлужебная_АвторизацииSMARTS)
//
// Параметры:
// 	СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//  Переподключиться - Булево - определяет необходимость явного переподключения к базе Клеверенс
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
// 	Компонента - Строка - указывается сторона, где установлена компонента для работы с базой Клеверенс
// 	СохранятьАвторизацию - Булево - флаг необходимости сохранять данные авторизации
//  Интерактивно - Булево - флаг работы в интерактивном режиме
//  ОписаниеОповещения - ОписаниеОповещения - описание оповещения, обработку которого необходимо выполнить при закрытии формы авторизации
//
// Возвращаемое значение:
// 	- Структура - если требуется авторизация в интерактивном режиме - содержит:
//  	* Статус - Строка
//      * СтрокаПодключения - Строка
//      * ИмяБазы - Строка
//      * Логин - Строка
//      * ТипБазы - Строка
//      * ДопПараметры - Структура - содержит:
// 			** СтрокаПодключения - Строка
//          ** ТипБазы - Строка
//          ** СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//          ** СохранятьАвторизацию - Булево
//          ** ИмяБазы - Строка
// 			** Логин - Строка
// 	- Булево - результат проверки соединения с сервером Клеверенс
&НаКлиенте
Функция ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения = Неопределено, Переподключиться = Ложь, ТипБазы = "Основная", Компонента = Неопределено, СохранятьАвторизацию = Ложь, Интерактивно = Истина, ОписаниеОповещения = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПроверитьСоединениеССерверомSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Переподключиться,ТипБазы,Компонента,СохранятьАвторизацию,Интерактивно,ОписаниеОповещения",
		СтруктураПодключения, Переподключиться, ТипБазы, Компонента, СохранятьАвторизацию, Интерактивно, ОписаниеОповещения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеСБазойSMARTS", "Информация", пСообщение, НачалоСобытия);
	РезультатПроверки = ЛокЯдро_ПроверитьСоединениеСБазойSMARTS(СтруктураПодключения, Переподключиться, ТипБазы, Компонента, СохранятьАвторизацию, Интерактивно);
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеСБазойSMARTS", "Информация", пСообщение, НачалоСобытия);
	
	Если РезультатПроверки = Истина Тогда
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Истина;
	ИначеЕсли ТипЗнч(РезультатПроверки) = Тип("Строка") Тогда
		Оповестить("ОшибкаАвторизацииПоTempUid", РезультатПроверки);
		
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	ИначеЕсли ТипЗнч(РезультатПроверки) = Тип("Структура") Тогда
	
		АвтотестКлеверенс = КомЯдро_ПолучитьЗначениеПеременной("Автотест");
		Если АвтотестКлеверенс = Истина Тогда
			
			Если ОписаниеОповещения <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
			КонецЕсли;
			
			// <Лог>
			ЯзСтрока = "ru = 'Требуется авторизация, но автотест не может открыть форму авторизации'";
			пСообщение = НСтр(ЯзСтрока);
			ЛогОшибка(логСобытие, пСообщение, ЯзСтрока);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат Ложь;
		КонецЕсли;
		
		ДопПараметры = РезультатПроверки.ДопПараметры;
		
		Оповестить("ОшибкаАвторизацииБезTempUid", ДопПараметры);
		
		Если ТипЗнч(СтруктураПодключения) = Тип("Структура")
			И СтруктураПодключения.Свойство("ТипИнтерфейса")
			И ЗначениеЗаполнено(СтруктураПодключения.ТипИнтерфейса) Тогда
			ТипИнтерфейса = СтруктураПодключения.ТипИнтерфейса;
		Иначе
			ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_АвторизацииSMARTS = ЭтаФорма.ВладелецФормы.Объект.ПолучитьФорму("ОФ_ФормаСлужебная_АвторизацииSMARTS", ЭтаФорма);
		#Иначе
			ФормаСлужебная_АвторизацииSMARTS = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_АвторизацииSMARTS", , ЭтаФорма, ЭтаФорма);
			ФормаСлужебная_АвторизацииSMARTS.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаСлужебная_АвторизацииSMARTS.ЗакрыватьПриЗакрытииВладельца = Истина;
		ФормаСлужебная_АвторизацииSMARTS._ЛокКонтекст 				   = ЭтаФорма;
		ФормаСлужебная_АвторизацииSMARTS.Компонента 				   = Компонента;
		ФормаСлужебная_АвторизацииSMARTS.СтрокаПодключения 			   = ДопПараметры.СтрокаПодключения;
		ФормаСлужебная_АвторизацииSMARTS.ИмяБазы 					   = РезультатПроверки.ИмяБазы;
		ФормаСлужебная_АвторизацииSMARTS.ОписаниеОповещенияОЗакрытии   = ОписаниеОповещения;
		ФормаСлужебная_АвторизацииSMARTS.ВидимостьКнопкиЗапомнить 	   = Истина;
		ФормаСлужебная_АвторизацииSMARTS.ТипБазы 					   = ТипБазы;
		ФормаСлужебная_АвторизацииSMARTS.ТипИнтерфейса 				   = ТипИнтерфейса;
		ФормаСлужебная_АвторизацииSMARTS.ДопПараметры 				   = ДопПараметры;
		ФормаСлужебная_АвторизацииSMARTS.ТекстОшибки 				   = РезультатПроверки.ТекстОшибки;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСлужебная_АвторизацииSMARTS.ОткрытьМодально();
		#Иначе
			ФормаСлужебная_АвторизацииSMARTS.Открыть();
		#КонецЕсли
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	Иначе
		Если ОписаниеОповещения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Вызывает функцию проверки соединения с сервером Клеверенс, при успешном выполнении проверки - с подключенной базой Клеверенс.
//
// Параметры:
//	СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//  Переподключиться - Булево - определяет необходимость явного переподключения к базе Клеверенс
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
//	Компонента - Строка - указывается сторона, где установлена компонента для работы с базой Клеверенс
//	СохранятьАвторизацию - Булево - флаг необходимости сохранять данные авторизации
//  Интерактивно - Булево - флаг работы в интерактивном режиме
//  ОписаниеОповещения - ОписаниеОповещения - описание оповещения, обработку которого необходимо выполнить при закрытии формы авторизации
//	ТипИнтерфейса - Строка - тип используемого интерфейса. Например, REST_API или COM
//	НеПроверятьАвторизацию - Булево - признак необходимости проверки авторизации
//
// Возвращаемое значение:
//	- Структура - если требуется авторизация в интерактивном режиме - содержит:
//  	* Статус - Строка	
//      * СтрокаПодключения - Строка
//      * ИмяБазы - Строка
//      * Логин - Строка
//      * ТипБазы - Строка
//      * ДопПараметры - Структура - содержит:
//			** СтрокаПодключения - Строка
//          ** ТипБазы - Строка
//          ** СтруктураПодключения - Структура - структура подключения к базе Клеверенс
//          ** СохранятьАвторизацию - Булево
//          ** ИмяБазы - Строка
//			** Логин - Строка
//	- Булево - результат проверки соединения с сервером Клеверенс
&НаКлиенте
Функция ЛокЯдро_ПроверитьСоединениеСБазойSMARTS(СтруктураПодключения = Неопределено, Переподключиться = Ложь,
	ТипБазы = "Основная", Компонента = Неопределено, СохранятьАвторизацию = Ложь, Интерактивно = Истина, 
	ТипИнтерфейса = Неопределено, НеПроверятьАвторизацию = Ложь) Экспорт
		
	ИмяСобытия = "ЛокЯдро_ПроверитьСоединениеСБазойSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Переподключиться,ТипБазы,Компонента,СохранятьАвторизацию,Интерактивно,ТипИнтерфейса,НеПроверятьАвторизацию",
		СтруктураПодключения, Переподключиться, ТипБазы, Компонента, СохранятьАвторизацию, Интерактивно, ТипИнтерфейса, НеПроверятьАвторизацию);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("ТипИнтерфейса")
		И ЗначениеЗаполнено(СтруктураПодключения.ТипИнтерфейса) Тогда
		ТипИнтерфейса = СтруктураПодключения.ТипИнтерфейса;
	ИначеЕсли Не ЗначениеЗаполнено(ТипИнтерфейса) Тогда
		ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
	КонецЕсли;
	
	Если Компонента = Неопределено Тогда
		РасположениеКомпоненты = КомЯдро_ПолучитьЗначениеПеременной("РасположениеКомпоненты");
		Компонента = РасположениеКомпоненты;	
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	Если ТипИнтерфейса = "REST_API" Тогда
		КлючПеременной = "REST_API_" + КлючПеременной;
	КонецЕсли;	
		
	Если СтруктураПодключения = Неопределено ИЛИ СтруктураПодключения = "" Тогда
		СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
		Если НЕ СтруктураПодключения.Свойство("ТипБазы") Тогда
			СтруктураПодключения.Вставить("ТипБазы",ТипБазы);
		КонецЕсли;
	Иначе
		Если НЕ СтруктураПодключения.Свойство("ТипБазы") Тогда
			СтруктураПодключения.Вставить("ТипБазы",ТипБазы);
		КонецЕсли;
		КомЯдро_СохранитьЗначениеПеременной(КлючПеременной,СтруктураПодключения);
	КонецЕсли;
	
	Если Компонента = "НаСервере" Тогда
		КомЯдро_СохранитьЗначениеПеременной("АвторизацияВключенаНаСервере", Ложь);
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("СтруктураПодключения", 	СтруктураПодключения);
		ПараметрыМетода.Вставить("Переподключиться", 		Переподключиться);
		ПараметрыМетода.Вставить("ТипБазы", 				ТипБазы);
		ПараметрыМетода.Вставить("СохранятьАвторизацию", 	СохранятьАвторизацию);
		ПараметрыМетода.Вставить("Интерактивно", 			Интерактивно);
		ПараметрыМетода.Вставить("НеПроверятьАвторизацию", 	НеПроверятьАвторизацию);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПроверитьСоединениеССерверомSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		РезультатПроверки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		АвторизацияВключенаНаСервере = КомЯдро_ПолучитьЗначениеПеременной("АвторизацияВключенаНаСервере");
		Если АвторизацияВключенаНаСервере = Истина Тогда
			// Сохраняем в структуре подключения информацию о том, что в базе включена авторизация
			СтруктураПодключения.Вставить("АвторизацияВключена", Истина);
			
			КомЯдро_СохранитьЗначениеПеременной("АвторизацияВключенаНаСервере", Ложь);
		КонецЕсли;	
	Иначе
		Если ТипИнтерфейса = "REST_API" Тогда
			РезультатПроверки = REST_API_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Интерактивно, НеПроверятьАвторизацию);
		Иначе
			РезультатПроверки = КомЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения, Компонента,Переподключиться,ТипБазы,СохранятьАвторизацию,Интерактивно);
		КонецЕсли;
	КонецЕсли;
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатПроверки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатПроверки;

КонецФункции

// Проверяет доступность онлайн режима
//
// Параметры:
//  СтруктураПодключения 	- Структура, Неопределено  - структура подключения
//	РасположениеКомпоненты 	- Строка - строка расположени компоненты
//
// Возвращаемое значение:
//   Булево   - доступность онлайн режима
//
&НаКлиенте
Функция ЛокЯдро_ПроверитьДоступностьОнлайнРежима(СтруктураПодключения = Неопределено, РасположениеКомпоненты = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПроверитьДоступностьОнлайнРежима";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,РасположениеКомпоненты",
		СтруктураПодключения, РасположениеКомпоненты);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Для ОФ не выполняем проверку доступности, т.к. проверка доступности базы некорректно работает на сервере
		// Например, при прямом подключении базы Клеверенс отображается, что с сервера доступно подключение, хотя это не так из-за особенности работы толстого клиента
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Истина;		
	#КонецЕсли
	
	ТипБазы 				= "Временная"; //Проверяем доступность через временную базу, чтобы настройки подключения не сохранились для основной базы
	Переподключиться 		= Истина;
	СохранятьАвторизацию 	= Ложь;
	Интерактивно 			= Ложь;
	
	ДоступностьОнлайнРежима				= Ложь;
	НеобходимостьПроверкиДоступности 	= Ложь; // Проверять доступность онлайн режима необходимо не во всех случаях, например, если подключение компонента находится на сервере, то не выполняем проверку
	
	Если ТипЗнч(СтруктураПодключения) = Тип("Структура")
		И СтруктураПодключения.Свойство("ТипИнтерфейса")
		И ЗначениеЗаполнено(СтруктураПодключения.ТипИнтерфейса) Тогда
		ТипИнтерфейса = СтруктураПодключения.ТипИнтерфейса;
	Иначе
		ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
	КонецЕсли;
	
	Если РасположениеКомпоненты = Неопределено Тогда
		РасположениеКомпоненты = КомЯдро_ПолучитьЗначениеПеременной("РасположениеКомпоненты");
	КонецЕсли;
		
	ЭтоREST_API = ТипИнтерфейса = "REST_API";	
		
	// Если компонента на сервере, то нет необходимости проверять подключение с сервера, т.к. оно уже выполнено ранее
	Если РасположениеКомпоненты <> "НаСервере" Тогда
		
		Если ЭтоREST_API Тогда
			// Для рест на данный момент нет возможности проверить включен ли онлайн режим, поэтому проверяем доступность базы с сервера в любом случае
			ВключеныСобытияСервера = Истина;
		Иначе
			
			// Вариант при ком соединении
			Если COMБазыMS <> Неопределено 
				И Строка(COMБазыMS.TerminalConnector) = "COMОбъект" Тогда
				
				// Проверка, что включен онлайн режим. Проверям именно на компоненте основной базы, т.к. компонента временной базы может быть не подключена
				Попытка
					СобытияСервера 			= COMБазыMS.TerminalConnector.StorageConnector.GetServerEvents();
					ВключеныСобытияСервера 	= ЗначениеЗаполнено(СобытияСервера.ProductNotFound) Или ЗначениеЗаполнено(СобытияСервера.ProductsNotFound);
				Исключение
					ВключеныСобытияСервера = Ложь;
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВключеныСобытияСервера Тогда
			
			НеобходимостьПроверкиДоступности = Истина;
			
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
				"НачалоПроверкиДоступностиОнлайнРежимаСообщениеБезопасности", 
				"", 
				"ДоступностьОнлайнРежима");
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			
			НеПроверятьАвторизацию = Истина; // Не проверяем авторизацию
			РезультатПроверки = ЛокЯдро_ПроверитьСоединениеСБазойSMARTS(СтруктураПодключения, Переподключиться, ТипБазы, 
				"НаСервере", СохранятьАвторизацию, Интерактивно,, НеПроверятьАвторизацию);
						
			Если РезультатПроверки = Ложь Тогда
				СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"РаботаВОнлайнеНедоступна", 
					СтруктураПодключения, 
					"ДоступностьОнлайнРежима");
				Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			Иначе
				ДоступностьОнлайнРежима = Истина;
				СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"БезОшибок", 
					"", 
					"ДоступностьОнлайнРежима");
				Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;

	// Если нет необходимости проверять доступность базы с сервера, то считаем, что база доступна с сервера
	ДоступностьОнлайнРежима = Не НеобходимостьПроверкиДоступности Или ДоступностьОнлайнРежима;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДоступностьОнлайнРежима);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ДоступностьОнлайнРежима;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПроверитьСовместимостьПлатформы(СтруктураПодключения, Компонента, ОписаниеОповещения = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ПроверитьСовместимостьПлатформы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураПодключения,Компонента,ОписаниеОповещения",
		СтруктураПодключения, Компонента, ОписаниеОповещения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Компонента = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура("СтруктураПодключения", СтруктураПодключения);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода",		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПроверитьСовместимостьПлатформы");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Результат = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	Иначе
		Результат = REST_API_ПроверитьСовместимостьПлатформы(СтруктураПодключения);
	КонецЕсли;
	
	Если НЕ ОписаниеОповещения = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

// Изменяет текущие настройки Клеверенс и сохраняет их в базе Клеверенс
//
// Параметры:
//	ТекущиеНастройкиMS - Структура - изменяемые настройки Клеверенс
//
&НаКлиенте
Процедура ЛокЯдро_ИзменитьТекущиеНастройкиMS(ТекущиеНастройкиMS) Экспорт
		
	OneCProcessingFileName_ПоУмолчанию = "КлеверенсТСД_ОсновнаяОбработка.epf";
	
	Если ТипЗнч(ТекущиеНастройкиMS) = Тип("Структура") Тогда
		Если ТекущиеНастройкиMS.Свойство("OneCProcessingFileName")
			И ТекущиеНастройкиMS.OneCProcessingFileName <> Ложь
			И ТекущиеНастройкиMS.OneCProcessingFileName <> OneCProcessingFileName_ПоУмолчанию Тогда
			
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("OneCProcessingFileName", OneCProcessingFileName_ПоУмолчанию);
			ТекущиеНастройкиMS.OneCProcessingFileName = OneCProcessingFileName_ПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПроверитьНастройкиТаймаутов() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновитьНастройкиТаймаутов");
	ОбновленныеНастройкиТаймаутов = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиТаймаутов",ОбновленныеНастройкиТаймаутов);
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьТаймаутПоТипуМетода(СтруктураЗапроса)
	
	ЗначениеТаймаутаПоУмолчанию = 3;
	
	НастройкиТаймаутов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов");
	Если НастройкиТаймаутов = Неопределено Тогда // Если возвращается Неопределено, значит переменные кэша еще не созданы, возьмем напрямую настройки по умолчанию
		
		Если КэшТаймаутов = Неопределено Тогда 			
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Функция");
			СтруктураВызова.Вставить("ИмяМетода", "ТаймаутыПоУмолчанию");
			НастройкиТаймаутов = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
			
			КэшТаймаутов = НастройкиТаймаутов;
			
		Иначе
			НастройкиТаймаутов = КэшТаймаутов;
		КонецЕсли;
		
	ИначеЕсли НастройкиТаймаутов = Ложь Тогда  // если в кэше нет настроек, то вызовем обновление таймаутов, внутри обновления есть запись в кэш,
		ЛокЯдро_ПроверитьНастройкиТаймаутов(); // поэтому после обновления просто переполучим из него.		
		НастройкиТаймаутов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов");
		
	КонецЕсли;
	
	ТипЗапроса = "ПоУмолчанию";
	Если СтруктураЗапроса.Свойство("ТипЗапроса") // Если в структуре запроса не задан тип запроса, то берем таймаут по умолчанию
		И ЗначениеЗаполнено(СтруктураЗапроса.ТипЗапроса) Тогда
		ТипЗапроса = СтруктураЗапроса.ТипЗапроса;
	КонецЕсли;
	
	СтрокаНастройки = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиТаймаутов,Новый Структура("ТипЗапроса", ТипЗапроса));
	
	Если СтрокаНастройки = Неопределено 
		И ТипЗапроса <> "ПоУмолчанию" Тогда // Названия методов могут меняться со временем, если забыли переименовать и настройка не нашлась, то будем брать значение по умолчанию
		СтрокаНастройки = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиТаймаутов,Новый Структура("ТипЗапроса", "ПоУмолчанию"));
	КонецЕсли;
	
	Если СтрокаНастройки = Неопределено Тогда // Если по какой-то причине строки настройки всё равно нет, то назначим значение таймаута 3
		ЗначениеТаймаута = ЗначениеТаймаутаПоУмолчанию;
	Иначе
		ЗначениеТаймаута = СтрокаНастройки[0].Значение;
	КонецЕсли;
	
	Возврат ЗначениеТаймаута;
КонецФункции

// Выполняет сброс пользовательских настроек к состоянию по умолчанию
//
&НаКлиенте
Процедура ЛокЯдро_СброситьНастройкиПодключеннойБазыНаСтандартные() Экспорт
	
	ИмяСобытия = "ЛокЯдро_СброситьНастройкиПодключеннойБазыНаСтандартные";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	РасположениеКомпоненты = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
	
	Если НЕ ЗначениеЗаполнено(РасположениеКомпоненты) Тогда
		РасположениеКомпоненты = "НаСервере";
	КонецЕсли;
	
	Если РасположениеКомпоненты <> "НаСервере" Тогда		
		
		// Получаем пустую структуру настроек
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
        СтруктураНастроек 	= ЛокЯдро_ПолучитьПустуюСтруктуруНастроекSMARTS(КатегорииНастроекMS.СериализуемыеНастройки);
		
		// Заполняем пустую структуру текущими значениями
		СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек);
		
		// Определяем текущий узел		
		ID_ТекущегоУзла = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущегоУзла_"+ПараметрыПодключенияMS.Ид);
		Если Не ЗначениеЗаполнено(ID_ТекущегоУзла) Тогда
			ID_ТекущегоУзла = "";	
		КонецЕсли;		
		
		// Если он определен, получаем по нему структуру настроек
		ДанныеУзла = Неопределено;
		Если ID_ТекущегоУзла <> "" И ТипЗнч(СтруктураНастроек.Узлы) = Тип("Массив") Тогда
			ДанныеУзла = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроек.Узлы,"ID_Узла",ID_ТекущегоУзла);
			Если ДанныеУзла <> Неопределено Тогда			
				СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, ID_ТекущегоУзла);				
			КонецЕсли;
		КонецЕсли;
		
		// Убираем из структуры параметры, отвечающие за соединение с базой 1С и расширениями (иначе они слетают)
		СтруктураНастроек.Удалить("ПодключеннаяБазаСтрокаСоединения");
		СтруктураНастроек.Удалить("ПодключеннаяБазаИмяКонфигурации1С");
		СтруктураНастроек.Удалить("ПодключеннаяБазаСинонимКонфигурации1С");
		СтруктураНастроек.Удалить("ПодключеннаяБазаВерсияПлатформы1С");
		СтруктураНастроек.Удалить("ПодключеннаяБазаВерсияКонфигурации1С");
		СтруктураНастроек.Удалить("База1СПодключенаДата");
		СтруктураНастроек.Удалить("PlatformVersion1C");
		СтруктураНастроек.Удалить("PlatformFolderPath1C");
		СтруктураНастроек.Удалить("ServerName1C");
		СтруктураНастроек.Удалить("DatabaseName1C");
		СтруктураНастроек.Удалить("DatabasePath1C");
		СтруктураНастроек.Удалить("WebDatabasePath1C");
		СтруктураНастроек.Удалить("OneCProcessingFileName");
				
		СтруктураИменРасширений = ЛокЯдро_ПолучитьСтруктуруИменРасширений();
		Для каждого ЭлементСтруктуры ИЗ СтруктураИменРасширений Цикл
			СтруктураНастроек.Удалить("ВерсияРасширения_" + ЭлементСтруктуры.Значение);
		КонецЦикла;
		
		СтруктураНастроек.Удалить("ИмяРасширенияMain");
		СтруктураНастроек.Удалить("ИмяРасширенияSSL");
				
		// Получаем структуру настроек по умолчанию и записываем ее для дальнейшего использования
		СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиПоУмолчаниюНаСервереSMARTS(СтруктураНастроек, ?(ДанныеУзла = Неопределено, "", ID_ТекущегоУзла)); 
		ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
								
	КонецЕсли;		
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ИнициализацияКомпонентаНаСервере(ОписаниеОповещенияРодительскойФормы)
	
	ИмяСобытия = "ЛокЯдро_ИнициализацияКомпонентаНаСервере";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОписаниеОповещенияРодительскойФормы",
		ОписаниеОповещенияРодительскойФормы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Инициализируем отдельную переменную ВыполняетсяВФоне, 
	// т.к. в процессе выполнения ФЗ при ошибке мы можем поменять значение переменной ДоступноВыполнениеВФоне
	ВыполняетсяВФоне = ДоступноВыполнениеВФоне;
	
	ДанныеДляИнициализации = ЛокЯдро_ПолучитьДанныеДляИнициализации(Истина, ВыполняетсяВФоне, ОписаниеОповещенияРодительскойФормы);

	// Если не доступно выполнение в фоне, вызываем метод напрямую
	Если Не ВыполняетсяВФоне Тогда
		ЛокЯдро_ПолучитьДанныеДляИнициализацииЗавершение(ДанныеДляИнициализации);
	КонецЕсли;	

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПолучитьДанныеДляИнициализацииВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ЛокЯдро_ПолучитьДанныеДляИнициализацииВФонеЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
		ДанныеДляИнициализации = СтруктураРезультата.ДанныеДляИнициализации;
		// Актуализируем кэш, т.к. он мог измениться в сеансе фонового задания
		// TODO. Проверить, надо ли 3-й параметр ЛокЯдро_ДополнитьСтруктуру перевести в Истина 
		ЛокЯдро_ДополнитьСтруктуру(АдресаПеременных, СтруктураРезультата.АдресаПеременных, Истина);
	Иначе
		ДанныеДляИнициализации = Результат;
	КонецЕсли;
	
    ЛокЯдро_ПолучитьДанныеДляИнициализацииЗавершение(ДанныеДляИнициализации, ДополнительныеПараметры);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПолучитьДанныеДляИнициализацииЗавершение(ДанныеДляИнициализации, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ПолучитьДанныеДляИнициализацииЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеДляИнициализации,ДополнительныеПараметры",
		ДанныеДляИнициализации, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДанныеИнициализированы = ТипЗнч(ДанныеДляИнициализации) = Тип("Структура")
		И ДанныеДляИнициализации.Свойство("КатегорииНастроекMS")
		И ДанныеДляИнициализации.Свойство("ТекущиеНастройкиMS")
		И ДанныеДляИнициализации.Свойство("СтруктураМетаданных")
		И ДанныеДляИнициализации.Свойство("ДанныеТекущегоУзла")
		И ДанныеДляИнициализации.Свойство("ПраваПользователя");
		
	Если НЕ ДанныеИнициализированы Тогда
		ОписаниеОповещенияРодительскойФормы = Неопределено;
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ОписаниеОповещенияРодительскойФормы", ОписаниеОповещенияРодительскойФормы)
			И НЕ ОписаниеОповещенияРодительскойФормы = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияРодительскойФормы, "ОшибкаИнициализации");
		КонецЕсли;
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	КатегорииНастроекMS = ДанныеДляИнициализации.КатегорииНастроекMS;
	ТекущиеНастройкиMS  = ДанныеДляИнициализации.ТекущиеНастройкиMS;
	СтруктураМетаданных = ДанныеДляИнициализации.СтруктураМетаданных;
	ДанныеТекущегоУзла  = ДанныеДляИнициализации.ДанныеТекущегоУзла;
	ПраваПользователя 	= ДанныеДляИнициализации.ПраваПользователя;
	
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
	Если ЕстьЧастнаяБаза = Неопределено Тогда
		ЕстьЧастнаяБаза = Ложь;
	КонецЕсли;	
	
	НастройкиИнициализированы = Истина;
	
	ОбновитьСистемнуюИнформацию1СВБазеMS();
	
	Оповестить("УстановленыНастройкиПодключения",,ЭтаФорма);	
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		"БезОшибок", 
		"", 
		"ПодключениеКБазеSMARTS");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	Если СтруктураМетаданных.isDemo Тогда 
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"ДемоРежим", 
					"", 
					"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ОписаниеОповещенияРодительскойФормы = ДополнительныеПараметры.ОписаниеОповещенияРодительскойФормы;
		Если ОписаниеОповещенияРодительскойФормы <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияРодительскойФормы);
		КонецЕсли;
	КонецЕсли;

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПреобразоватьБизнесПроцессыВПользовательские(НастройкиБизнесПроцессов, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПреобразоватьБизнесПроцессыВПользовательские");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("НастройкиБизнесПроцессов, ДополнительныеПараметры", НастройкиБизнесПроцессов, ДополнительныеПараметры));
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
КонецФункции

