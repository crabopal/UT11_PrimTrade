	НаборИдУчет = ЛокЯдро_ПолучитьИдУчета();
	Для каждого ИдПродукта ИЗ НаборИдУчет Цикл
		СоответствиеПродуктов.Вставить(ИдПродукта.Ключ, Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "Учет", ИдПродукта.Значение));
	КонецЦикла;
	
	СоответствиеПродуктов.Вставить("8022B928-C509-4F7A-B119-2F77942FDF63", Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "Курьер", ""));	// Курьер
	СоответствиеПродуктов.Вставить("1DC2DC26-0BEE-4959-98A4-8D70D59C0189", Новый Структура("ТипУстановленногоПродукта, УровеньПриложения", "МДЛП", "")); 	// МДЛП	
	
	ИдПриложения = СтруктураДанныеБазы.ИдПриложения;
	ИдОсновногоПриложения = СтруктураДанныеБазы.ИдОсновногоПриложения;
	
