&НаКлиенте
Функция ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЛевоеЗначение, ПравоеЗначение, КлючОтбора) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьПолноеСоединениеМассивов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЛевоеЗначение,ПравоеЗначение,КлючОтбора",
		ЛевоеЗначение, ПравоеЗначение, КлючОтбора);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(ЛевоеЗначение) = Тип("Массив")
		И ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
		
		МассивРезультат = ЛокЯдро_СкопироватьМассив(ЛевоеЗначение);
		Для каждого СтрокаЗначения Из ПравоеЗначение Цикл
			Если ТипЗнч(СтрокаЗначения) = Тип("Структура") И СтрокаЗначения.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			РезультатПоиска = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(МассивРезультат,КлючОтбора, СтрокаЗначения[КлючОтбора], Истина);
			Если РезультатПоиска = Неопределено Тогда
				МассивРезультат.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаЗначения));
			Иначе
				МассивРезультат[РезультатПоиска] = ЛокЯдро_СкопироватьСтруктуру(СтрокаЗначения);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ЛевоеЗначение) = Тип("Массив") Тогда
		МассивРезультат = ЛокЯдро_СкопироватьМассив(ЛевоеЗначение);
	ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
		МассивРезультат = ЛокЯдро_СкопироватьМассив(ПравоеЗначение);
	Иначе
		МассивРезультат = ЛевоеЗначение;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", МассивРезультат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат МассивРезультат;
	
КонецФункции

// Получает строку подключения clgt из BaseInfo
//
// Параметры:
// 	ТипБазы - Строка - тип базы ("Основная", "Частная", "Временная")
//
// Возвращаемое значение:
// 	Строка - строка подключения clgt или пустая строка если не найдена
&НаКлиенте
Функция ЛокЯдро_ПолучитьСтрокуClgt(ТипБазы)
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
	
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ТипБазы", ТипБазы);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПолучитьСтрокуClgt");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, , АдресаПеременных);
	
	КонецЕсли;
	
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
	
	Если СтруктураПодключения = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
	СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
	СтруктураЗапроса.Вставить("ТипЗапроса", "ПроверкаСоединения");
	
	СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса, , АдресаПеременных);
	
	ОтветСервера = Неопределено;
	
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура")
		ИЛИ НЕ СтруктураОтвета.Свойство("КодСостояния")
		ИЛИ СтруктураОтвета.КодСостояния <> 200
		ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
		
		Возврат "";
	
	КонецЕсли;
	
	Если ТипЗнч(ОтветСервера) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	AllConnectionStrings = ОтветСервера.Получить("allConnectionStrings");
	
	Если AllConnectionStrings = Неопределено Тогда
		AllConnectionStrings = ОтветСервера.Получить("AllConnectionStrings");
	КонецЕсли;
	
	Если ТипЗнч(AllConnectionStrings) = Тип("Массив") Тогда
	
		Для Каждого ЭлементПодключения Из AllConnectionStrings Цикл
		
			Если Найти(ВРег(Строка(ЭлементПодключения)), "//CLGT") > 0 Тогда
				Возврат Строка(ЭлементПодключения);
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_ЗаписьИЧтениеИзФалов

// Вызывает диалог выбора файла для сохранения структуры. Записывает в выбранный файл сериализированные настройки.
// 
// Параметры:
//	СтруктураНастройки - Структура - структура с настройками для сохранения
//	ИмяРаздела - Строка - название раздела настроек
&НаКлиенте
Процедура ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, ИмяРаздела, ЗашифроватьZIP = Ложь) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СохранитьНастройкиВФайл";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастройки,ИмяРаздела,ЗашифроватьZIP",
		СтруктураНастройки, ИмяРаздела, ЗашифроватьZIP);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураНастройки.Вставить("_ИмяРазделаНастройки_", ИмяРаздела);
	
	//TODO: Разобраться в природе возникновения предупреждения об ошибки в 1C EDT
	ТелоФайла = ЛокЯдро_ЗначениеВСтрокуXML(СтруктураНастройки);
	
	Если ЗашифроватьZIP Тогда
		ДанныеСжатия = ЛокЯдро_ЗашифроватьZIP(ТелоФайла, "txt", Истина, ИмяРаздела);
		ТелоФайла = ДанныеСжатия.ДвоичныеДанные;
		Фильтр = "(*.zip)|*.zip";
	Иначе
		Фильтр = "(*.txt)|*.txt";
	КонецЕсли;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.ПолноеИмяФайла = "";
	ДиалогВыбораФайла.Фильтр = Фильтр;
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Сохранить в файл';
										|en = 'Save to a file'; be = 'Захаваць у файл'; es = 'Guardar en un archivo'; ka = 'შენახვა ფაილი'; kk = 'Файлға сақтау'; ro = 'Salvați într-un fișier'; tr = 'Dosyaya kaydet'; uk = 'Зберегти у файл'; uz = 'Faylga saqlash'");
	
	АдресФайла 	= Транзит_ПоместитьЗначениеВХранилищеНаСервере(ТелоФайла);
	ИмяФайла 	= "";
	ДанныеФайла = Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресФайла);
	
	СохраняемыеФайлы = Новый Массив;
	СохраняемыеФайлы.Добавить(ДанныеФайла);
	
	Контекст = Новый Структура();
	Контекст.Вставить("Диалог", 			ДиалогВыбораФайла);
	Контекст.Вставить("Интерактивно", 		Истина);
	Контекст.Вставить("ТекстПредложения", 	"");
	Контекст.Вставить("ПолучаемыеФайлы", 	СохраняемыеФайлы);
	
	ДополнительныеПараметры = Новый Структура;
	
	ДополнительныеПараметры.Вставить("УстановитьЕслиНеПодключено", 	Истина);
	ДополнительныеПараметры.Вставить("ОбработчикЗавершения", 		"ЛокЯдро_СохранитьНастройкиВФайлЗавершение");
	ДополнительныеПараметры.Вставить("Контекст",					Контекст);
	ДополнительныеПараметры.Вставить("ВыборЗавершение", 			Новый ОписаниеОповещения("ЛокЯдро_ПоказатьПолучениеФайлов", ЭтаФорма));
	
	#Если Не ВебКлиент Тогда
		// В мобильном, тонком и толстом клиентах расширение подключено всегда.
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыборЗавершение, ДополнительныеПараметры); 
	#Иначе
		ЛокЯдро_ПередПодключениемРасширенияРаботыСФайлами(ДополнительныеПараметры);
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Продолжение процедуры ЛокЯдро_СохранитьНастройкиВФайл
// 
// Параметры:
//	МассивФайлов - Массив - массив элементов ОписаниеПереданногоФайла 
//	ДополнительныеПараметры - Структура - дополнительные параметры
