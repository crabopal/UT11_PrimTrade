&НаКлиенте
Процедура ЛокЯдро_Автотесты_СохранитьЛогиВКаталогЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКаталога = Результат[0];
	
	ПараметрыВыполненияАвтотестов = ПолучитьПараметрыВыполненияАвтотестов();
	
	СтрокаВыделенияАвтотестов		= ПараметрыВыполненияАвтотестов.СтрокаВыделенияАвтотестов;
	СтруктураВыполненияАвтотестов 	= ПараметрыВыполненияАвтотестов.СтруктураВыполненияАвтотестов;
	
	// Сохранение в папку, выбранную пользователем	
	ИмяФайлаОбщегоЛога = "\Logs_full_";
	ИмяФайлаЛогаОшибок = "\Logs_errors_";
	
	ШапкаПолногоЛогаЗаписана = ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);
	
	// Установка даты, начиная с которой будут получены и выгружены в лог записи ЖР
	ДатаНачалаВыгрузкиЖР = НачалоДня(ТекущаяДата()) - 7 * 24 * 60 * 60; // 7 дней назад
	КомЯдро_СохранитьЗначениеПеременной("ДатаНачалаВыгрузкиЖР", ДатаНачалаВыгрузкиЖР);	
	
	ДанныеДляОтбораЖР = "MobileSMARTSLog";
	Если ШапкаПолногоЛогаЗаписана Тогда
		ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации(ДанныеДляОтбораЖР,, ИмяКаталога);
	КонецЕсли;
	
	// Установка признака выполнения автотестов, чтобы можно было получить записи ЖР только по выполняемым операциям
	КомЯдро_СохранитьЗначениеПеременной("Автотест", Истина);
	ИдАвтотеста = Строка(Новый УникальныйИдентификатор);
	КомЯдро_СохранитьЗначениеПеременной("ИдАвтотеста", ИдАвтотеста);	
	
	ДанныеДляОтбораЖР = ИдАвтотеста;
	
	// Сохранение в папку, выбранную пользователем
	ИмяФайлаОбщегоЛога = "\Autotest1C_logs_full_";
	ИмяФайлаЛогаОшибок = "\Autotest1C_logs_errors_";
	
	ШапкаЛогаЗаписана = ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);
	Если ШапкаЛогаЗаписана Тогда
		Попытка
			ЛокЯдро_Автотесты_ВыполнитьАвтотестыДляТП(ПараметрыВыполненияАвтотестов);
			ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации(ДанныеДляОтбораЖР,, ИмяКаталога);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Сбрасываем признак выполнения автотестов
	КомЯдро_СохранитьЗначениеПеременной("Автотест", Ложь);
	
	Если ШапкаПолногоЛогаЗаписана ИЛИ ШапкаЛогаЗаписана Тогда
		Сообщение = НСтр("ru = 'Выгрузка окончена.';
							|en = 'The upload is finished.'; be = 'Выгрузка скончана.'; es = 'La descarga ha terminado.'; ka = 'ატვირთვა დასრულებულია.'; kk = 'Түсіру аяқталды.'; ro = 'Încărcarea este terminată.'; tr = 'Boşaltma işlemi bitti.'; uk = 'Вивантаження закінчено.'; uz = 'Tushirish tugadi.'");
		Сообщить(Сообщение); 
	Иначе
		Сообщение = НСтр("ru = 'Не удалось выгрузить файлы.';
							|en = 'Couldn''t upload files.'; be = 'Не атрымалася выгрузіць файлы.'; es = 'No se pudieron descargar los archivos.'; ka = 'ფაილების ატვირთვა ვერ მოხერხდა.'; kk = 'Файлдарды жүктеу мүмкін болмады.'; ro = 'Nu am putut încărca fișiere.'; tr = 'Dosyalar yüklenemedi.'; uk = 'Не вдалося вивантажити файли.'; uz = 'Fayllarni yuklab bo''lmadi.'");
		Сообщить(Сообщение); 
	КонецЕсли;
	
КонецПроцедуры 

// Загружаем по одному документу созданному на ТСД
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ЗагрузитьДокументы() Экспорт
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ЗагрузитьДокументы";
	
	// Загружаем документы только созданные на ТСД
	Отбор = Новый Структура("Используется, ТипИсходногоДокумента1С", Истина, "");
	пБизнесПроцессы = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиБизнесПроцессов", Отбор);
	
	Попытка
		ДокументыMS = ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS();
	Исключение
		ТекстОшибки		= НСтр("ru = 'Ошибка получения списка документов SMARTS: %1';
								|en = 'Error in getting the list of Cleverence documents: %1'; be = 'Памылка атрымання спісу дакументаў Cleverence: %1'; es = 'Error al obtener la lista de documentos de Cleverence: %1'; ka = 'შეცდომა კლევერენციის დოკუმენტების ჩამონათვალის მიღებაში: %1'; kk = 'Cleverence құжаттар тізімін алу қатесі: %1'; ro = 'Eroare la obținerea listei documentelor Cleverence: %1'; tr = 'Cleverence belgelerinin listesini alma hatası: %1'; uk = 'Помилка отримання списку документів Cleverence: %1'; uz = 'Cleverence hujjatlari ro''yxatini olishda xato: %1'");
		ТекстОшибки		= ЛокЯдро_СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Для каждого НастройкаБП Из пБизнесПроцессы Цикл
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		БизнесПроцессНаименование = НастройкаБП.Название;
		ТипДокументаMS = НастройкаБП.ТипДокументаMS;
		
		Отбор = Новый Структура("ВыбранныйБПнаТСД", НастройкаБП.ID_БизнесПроцесса);
		СтрокаДокумента = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ДокументыMS, Отбор, Истина);
		
		Если СтрокаДокумента <> Неопределено Тогда
			
			РезультатЗаписи = Неопределено;
			НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
			
			НастройкаБП.Вставить("ЗаписыватьДокументПослеЗагрузки", "Всегда");
			Попытка
				РезультатЗаписи = ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID(СтрокаДокумента.Ид, ТипДокументаMS, НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
			Исключение
				ТекстОшибки = НСтр("ru = 'Ошибка загрузки документа %1 по бизнес-процессу %2: %3';
									|en = 'Document upload error %1 in business process %2: %3';
									|be = 'Памылка загрузкі дакумента %1 па бізнес-працэсу %2: %3'; es = 'Error al cargar el documento %1 en el proceso de negocio %2: %3'; ka = 'დოკუმენტის ატვირთვის შეცდომა % 1 ბიზნეს პროცესში %2: %3'; kk = 'Бизнес-процесс бойынша %1 құжатты жүктеу қатесі %2: %3'; ro = 'Eroare de încărcare a documentelor %1 în procesul de afaceri %2: %3'; tr = 'İş süreci için belge yükleme hatası %1 %2: %3'; uk = 'Помилка завантаження документа % 1 по бізнес-процесу %2: %3'; uz = 'Hujjatni yuklash xatosi %1 biznes jarayoni %2: %3'");
				ТекстОшибки = ЛокЯдро_СтрШаблон(ТекстОшибки, ТипДокументаMS, БизнесПроцессНаименование, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
				Продолжить;
			КонецПопытки;
			
			РезультатЗаписи = ?(РезультатЗаписи = Неопределено, Новый Структура, РезультатЗаписи);
			
			// Логирование
			Если РезультатЗаписи.Свойство("Статус") И РезультатЗаписи.Статус = Истина Тогда
				пСообщение = НСтр("ru = 'Загружен документ %1 по бизнес-процессу %2';
									|en = 'Uploaded a document %1 on the business process %2'; be = 'Загружаны Дакумент %1 па бізнес-працэсу %2'; es = 'Documento %1 del proceso de negocio %2 cargado'; ka = 'ატვირთულია დოკუმენტი % 1 ბიზნეს პროცესზე %2'; kk = 'Жүктелген құжат % 1 бизнес-процесс бойынша %2'; ro = 'Încărcat un document %1 în procesul de afaceri %2'; tr = 'İş süreci için %1 belgesi yüklendi %2'; uk = 'Завантажено документ % 1 по бізнес-процесу %2'; uz = 'Biznes jarayoni %1 hujjati Yuklangan %2'");
				УровеньСтрокой = "Информация";
			Иначе
				пСообщение = НСтр("ru = 'Ошибка загрузки документа %1 по бизнес-процессу %2';
									|en = 'Document upload error %1 in business process %2';
									|be = 'Памылка загрузкі дакумента %1 па бізнес-працэсу %2'; es = 'Error al cargar el documento %1 en el proceso de negocio %2'; ka = 'დოკუმენტის ატვირთვის შეცდომა % 1 ბიზნეს პროცესში %2'; kk = 'Құжатты жүктеу қатесі %1 бизнес-процесс бойынша %2'; ro = 'Eroare de încărcare a documentelor %1 în procesul de afaceri %2'; tr = 'İş sürecine göre %1 belge yükleme hatası %2'; uk = 'Помилка завантаження документа %1 по бізнес-процесу %2'; uz = 'Hujjatni yuklash xatosi %1 biznes jarayoni %2'");
				УровеньСтрокой = "Ошибка";
			КонецЕсли;
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТипДокументаMS, БизнесПроцессНаименование);
			
			// Доп информация
			Если РезультатЗаписи.Свойство("Ссылка") И ЗначениеЗаполнено(РезультатЗаписи.Ссылка) Тогда
				пСообщение = пСообщение + Символы.ПС + "Документ 1С: " + РезультатЗаписи.Ссылка;
			КонецЕсли;
			Если РезультатЗаписи.Свойство("Сообщение") И ЗначениеЗаполнено(РезультатЗаписи.Сообщение) Тогда
				пСообщение = пСообщение + Символы.ПС + "Сообщение: " + РезультатЗаписи.Сообщение;
			КонецЕсли;
			Если РезультатЗаписи.Свойство("ДокументЗаписан") И ЗначениеЗаполнено(РезультатЗаписи.ДокументЗаписан) Тогда
				пСообщение = пСообщение + Символы.ПС + "Документ записан: " + РезультатЗаписи.ДокументЗаписан;
			КонецЕсли;
			Если РезультатЗаписи.Свойство("ДокументПроведен") И ЗначениеЗаполнено(РезультатЗаписи.ДокументПроведен) Тогда
				пСообщение = пСообщение + Символы.ПС + "Документ проведен: " + РезультатЗаписи.ДокументПроведен;
			КонецЕсли;
			
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньСтрокой, пСообщение, НачалоСобытия);
			
		Иначе
			ТекстОшибки = НСтр("ru = 'По бизнес-процессу %1 не было найдено ни одного документа';
								|en = 'No documents were found for the %1 business process';
								|be = 'Па бізнес-працэсу %1 не была знойдзена ніводнага дакумента'; es = 'No se encontró ningún documento en el proceso de negocio %1'; ka = 'არ მოიძებნა დოკუმენტები %1 ბიზნეს პროცესისთვის'; kk = '%1 бизнес процесі бойынша бірде-бір құжат табылған жоқ'; ro = 'Nu au fost găsite documente pentru procesul de afaceri %1'; tr = '%1 iş sürecine göre tek bir belge bulunamadı'; uk = 'По бізнес-процесу %1 не було знайдено жодного документа'; uz = '%1 biznes jarayoni bo''yicha hech qanday hujjat topilmadi'");
			ТекстОшибки = ЛокЯдро_СтрШаблон(ТекстОшибки, БизнесПроцессНаименование);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_Автотесты_ВыполнитьАвтотестыДляТП(ПараметрыВыполненияАвтотестов) Экспорт
	
	ПолныйАвтотест = Ложь;
	СтрокаВыделенияАвтотестов		= ПараметрыВыполненияАвтотестов.СтрокаВыделенияАвтотестов;
	СтруктураВыполненияАвтотестов 	= ПараметрыВыполненияАвтотестов.СтруктураВыполненияАвтотестов;
	
	ВыполнитьОперациюАвтотестовКлеверенс(
		"КлеверенсАвтотесты.ПроверкаПодключенныхРасширенийИПатчей", 
		"КлеверенсАвтотесты.ПроверкаПодключенныхРасширенийИПатчей", 
		СтруктураВыполненияАвтотестов, 
		Ложь, 
		ПолныйАвтотест, 
		СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(
		"КлеверенсАвтотесты.ПроверкаДоступностиРаботыСДокументами1С", 
		"КлеверенсАвтотесты.ПроверкаДоступностиРаботыСДокументами1С", 
		СтруктураВыполненияАвтотестов, 
		Ложь, 
		ПолныйАвтотест, 
		СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(
		"КлеверенсАвтотесты.ПолучитьСписокГлобальныхПеременныхИЗначений", 
		"КлеверенсАвтотесты.ПолучитьСписокГлобальныхПеременныхИЗначений", 
		СтруктураВыполненияАвтотестов, 
		Ложь, 
		ПолныйАвтотест, 
		СтрокаВыделенияАвтотестов);		
	
	ВыполнитьОперациюАвтотестовКлеверенс(
		"КлеверенсАвтотесты.ПолучитьСписокМакетовСКДДляВыгрузкиСправочников", 
		"КлеверенсАвтотесты.ПолучитьСписокМакетовСКДДляВыгрузкиСправочников", 
		СтруктураВыполненияАвтотестов, 
		Ложь, 
		ПолныйАвтотест, 
		СтрокаВыделенияАвтотестов);		
	
	ВыполнитьОперациюАвтотестовКлеверенс(
		"КлеверенсАвтотесты.ДиагностикаБизнесПроцессов",
		"КлеверенсАвтотесты.ДиагностикаБизнесПроцессов",
		СтруктураВыполненияАвтотестов,
		Ложь,
		ПолныйАвтотест,
		СтрокаВыделенияАвтотестов);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_Автотесты_ДиагностикаБизнесПроцессов() Экспорт
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ДиагностикаБизнесПроцессов";
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов();
	
	НастройкиОтборовУзлов_Интерактивный		= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Интерактивный");
	НастройкиОтборовУзлов_Онлайн			= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Онлайн");
	
	СтруктураНастроекПоУмолчанию			= ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	НастройкиБизнесПроцессов_ПоУмолчанию	= Неопределено;
	Если ЗначениеЗаполнено(СтруктураНастроекПоУмолчанию) И СтруктураНастроекПоУмолчанию <> Ложь Тогда
		НастройкиБизнесПроцессов_ПоУмолчанию = СтруктураНастроекПоУмолчанию.НастройкиБизнесПроцессов;
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПользовательскихНастроек					= ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
	НастройкиБизнесПроцессов_ПользовательскиеНастройки	= Неопределено;
	Если ЗначениеЗаполнено(СтруктураПользовательскихНастроек) И СтруктураПользовательскихНастроек <> Ложь Тогда
		НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураПользовательскихНастроек.НастройкиБизнесПроцессов;
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПользовательскиеНастройки = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПользовательскиеНастройки);
		КонецЕсли;
	КонецЕсли;
	
	// Хэштаблицы для O(1) поиска по ID_БизнесПроцесса
	НастройкиОтборовУзлов_ИнтерактивныйПоИД = Новый Соответствие;
	Если ТипЗнч(НастройкиОтборовУзлов_Интерактивный) = Тип("Массив") Тогда
		Для Каждого Элемент Из НастройкиОтборовУзлов_Интерактивный Цикл
		
			Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("ID_БизнесПроцесса") Тогда
				НастройкиОтборовУзлов_ИнтерактивныйПоИД.Вставить(Элемент.ID_БизнесПроцесса, Элемент);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	НастройкиОтборовУзлов_ОнлайнПоИД = Новый Соответствие;
	Если ТипЗнч(НастройкиОтборовУзлов_Онлайн) = Тип("Массив") Тогда
		Для Каждого Элемент Из НастройкиОтборовУзлов_Онлайн Цикл
		
			Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("ID_БизнесПроцесса") Тогда
				НастройкиОтборовУзлов_ОнлайнПоИД.Вставить(Элемент.ID_БизнесПроцесса, Элемент);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	НастройкиБизнесПроцессов_ПоУмолчаниюПоИД = Новый Соответствие;
	Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
		Для Каждого Элемент Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
		
			Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("ID_БизнесПроцесса") Тогда
				НастройкиБизнесПроцессов_ПоУмолчаниюПоИД.Вставить(Элемент.ID_БизнесПроцесса, Элемент);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	НастройкиБизнесПроцессов_ПользовательскиеНастройкиПоИД = Новый Соответствие;
	Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) = Тип("Массив") Тогда
		Для Каждого Элемент Из НастройкиБизнесПроцессов_ПользовательскиеНастройки Цикл
		
			Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("ID_БизнесПроцесса") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройкиПоИД.Вставить(Элемент.ID_БизнесПроцесса, Элемент);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	МассивРезультатов = Новый Массив;
	
	Счетчики = Новый Структура;
	Счетчики.Вставить("ВсегоБП",							0);
	Счетчики.Вставить("ВсегоИспользуемых",					0);
	Счетчики.Вставить("КоличествоОшибок",					0);
	Счетчики.Вставить("КоличествоПредупреждений",			0);
	Счетчики.Вставить("КоличествоПользовательскихБП",		0);
	
	КонтекстПроверки = Новый Структура;
	КонтекстПроверки.Вставить("МассивИменТиповДокументов1С",		Новый Массив);
	КонтекстПроверки.Вставить("МассивИменТиповДокументовMS",		Новый Массив);
	КонтекстПроверки.Вставить("МассивПроверенныхОбработчиков",		Новый Массив);
	КонтекстПроверки.Вставить("МассивСтороннихБП",					Новый Массив);
	КонтекстПроверки.Вставить("Счетчики",							Счетчики);
	
	Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
	
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчики.ВсегоБП = Счетчики.ВсегоБП + 1;
		
		Если НастройкаБП.Используется Тогда
			Счетчики.ВсегоИспользуемых = Счетчики.ВсегоИспользуемых + 1;
		КонецЕсли;
		
		Если НастройкаБП.Свойство("ЭтоТиповойБизнесПроцесс") И НЕ НастройкаБП.ЭтоТиповойБизнесПроцесс Тогда
			Счетчики.КоличествоПользовательскихБП = Счетчики.КоличествоПользовательскихБП + 1;
		КонецЕсли;
		
		пСообщение = "БП: " + НастройкаБП.Название + " (" + НастройкаБП.ID_БизнесПроцесса + "):";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение);
		
		пСообщение = ?(НастройкаБП.Используется, "- Используется", "- Не используется");
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 1);
		
		ОтборИнтерактивный	= НастройкиОтборовУзлов_ИнтерактивныйПоИД.Получить(НастройкаБП.ID_БизнесПроцесса);
		ОтборОнлайн			= НастройкиОтборовУзлов_ОнлайнПоИД.Получить(НастройкаБП.ID_БизнесПроцесса);
		
		ЛокЯдро_ДиагностикаБП_НастройкиОтборов(НастройкаБП, ОтборИнтерактивный, ОтборОнлайн, МассивРезультатов, КонтекстПроверки);
		
		ЛокЯдро_ДиагностикаБП_КорректностьНастроек(НастройкаБП, КонтекстПроверки, МассивРезультатов);
		
		ТиповойБП		= НастройкиБизнесПроцессов_ПоУмолчаниюПоИД.Получить(НастройкаБП.ID_БизнесПроцесса);
		ПользНастройка	= НастройкиБизнесПроцессов_ПользовательскиеНастройкиПоИД.Получить(НастройкаБП.ID_БизнесПроцесса);
		Если ТиповойБП <> Неопределено
			И ПользНастройка <> Неопределено
			И ПользНастройка.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(ПользНастройка.ПереопределяемыеНастройки) Тогда
			
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "Переопределенные настройки:", , 1);
			ЛокЯдро_ДиагностикаБП_ВывестиИзменения(ПользНастройка.ПереопределяемыеНастройки, ТиповойБП, МассивРезультатов, 1);
		
		КонецЕсли;
	
	КонецЦикла;
	
	ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "Сводка:");
	
	пСообщение = "Всего БП: " + Счетчики.ВсегоБП + ", Используется: " + Счетчики.ВсегоИспользуемых;
	ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 1);
	
	пСообщение = "Пользовательских (не типовых): " + Счетчики.КоличествоПользовательскихБП;
	ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 1);
	
	Если Счетчики.КоличествоОшибок > 0 Тогда
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "[x] Ошибок: " + Счетчики.КоличествоОшибок, "Ошибка", 1);
	КонецЕсли;
	
	Если Счетчики.КоличествоПредупреждений > 0 Тогда
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "[!] Предупреждений: " + Счетчики.КоличествоПредупреждений, "Предупреждение", 1);
	КонецЕсли;
	
	Для Каждого Результат Из МассивРезультатов Цикл
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, Результат.Уровень, Результат.Текст);
	КонецЦикла;
	
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("СторонниеБизнесПроцессы", КонтекстПроверки.МассивСтороннихБП);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ДиагностикаБП_НастройкиОтборов(НастройкаБП, ОтборИнтерактивный, ОтборОнлайн, МассивРезультатов, КонтекстПроверки)
	
	ОписанияРежимов = Новый Массив;
	ОписанияРежимов.Добавить(Новый Структура("Настройка, Режим", ОтборИнтерактивный, "Интерактивные"));
	ОписанияРежимов.Добавить(Новый Структура("Настройка, Режим", ОтборОнлайн, "Онлайн"));
	
	Для Каждого ОписаниеРежима Из ОписанияРежимов Цикл
	
		НастройкаОтбора		= ОписаниеРежима.Настройка;
		Режим				= ОписаниеРежима.Режим;
		
		пСообщение = Режим + " настройки отборов:";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 1);
		
		Если НастройкаОтбора = Неопределено Тогда
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "- Отсутствуют", , 2);
			Продолжить;
		КонецЕсли;
		
		НастройкиКомпоновкиСтрокой	= НастройкаОтбора.НастройкаКомпоновщикаСтрокой;
		НастройкиКомпоновки			= ЛокЯдро_ЗначениеИзСтрокиXML(СтрЗаменить(НастройкиКомпоновкиСтрокой, Символы.ВК, ""));
		
		Если НастройкиКомпоновки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементыОтбора = НастройкиКомпоновки.Отбор.Элементы;
		Если НЕ ЭлементыОтбора.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		пСообщение = ?(НастройкаОтбора.Используется, "Включены", "Отключены");
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 2);
		
		Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
			ТекстСобытия = " - """ + ЭлементОтбора.ЛевоеЗначение + """ " + ЭлементОтбора.ВидСравнения + " """ + ЭлементОтбора.ПравоеЗначение + """";
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, ТекстСобытия, , 2);
		
		КонецЦикла;
	
	КонецЦикла;
	
	ОтборВключенИнтерактивный	= ОтборИнтерактивный <> Неопределено И ОтборИнтерактивный.Используется = Истина;
	ОтборВключенОнлайн			= ОтборОнлайн <> Неопределено И ОтборОнлайн.Используется;
	
	Если НастройкаБП.Используется И ОтборВключенИнтерактивный = Ложь И ОтборВключенОнлайн = Ложь Тогда
	
		КонтекстПроверки.Счетчики.КоличествоПредупреждений = КонтекстПроверки.Счетчики.КоличествоПредупреждений + 1;
		
		ТекстКомментария = " [!] Бизнес-процесс используется, но отборы отключены";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, ТекстКомментария, "Предупреждение", 1);
	
	ИначеЕсли НЕ НастройкаБП.Используется И ОтборВключенИнтерактивный = Истина И ОтборВключенОнлайн = Истина Тогда
	
		КонтекстПроверки.Счетчики.КоличествоПредупреждений = КонтекстПроверки.Счетчики.КоличествоПредупреждений + 1;
		
		ТекстКомментария = " [!] Бизнес-процесс не используется, но отборы включены";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, ТекстКомментария, "Предупреждение", 1);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ДиагностикаБП_КорректностьНастроек(НастройкаБП, КонтекстПроверки, МассивРезультатов)
	
	МассивОшибокБП = Новый Массив;
	
	СтрМетаданных = Новый Структура("МетаданныеДокMS, МетаданныеДок1СВыгрузка, МетаданныеДок1СЗагрузка",
		Неопределено, Неопределено, Неопределено);
	
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("ID_БизнесПроцесса",		НастройкаБП.ID_БизнесПроцесса);
	СтруктураПроверки.Вставить("Название",				НастройкаБП.Название);
	СтруктураПроверки.Вставить("ОшибкаБП",				Ложь);
	СтруктураПроверки.Вставить("СтороннийБП",			Ложь);
	СтруктураПроверки.Вставить("ОшибкаМетаданных1С",	Ложь);
	СтруктураПроверки.Вставить("ОшибкиМетаданных1С",	Новый Массив);
	
	ЛокЯдро_ПроверитьКорректностьТипаМетаданных(
		НастройкаБП.ТипДокументаMS,
		"ДокументыMS",
		КонтекстПроверки.МассивИменТиповДокументовMS,
		СтрМетаданных.МетаданныеДокMS,
		СтруктураПроверки,
		МассивОшибокБП);
	
	Если НЕ СтруктураПроверки.СтороннийБП Тогда

		ЛокЯдро_ПроверитьКорректностьТипаМетаданных(
			НастройкаБП.ТипИсходногоДокумента1С,
			"Документы1С",
			КонтекстПроверки.МассивИменТиповДокументов1С,
			СтрМетаданных.МетаданныеДок1СВыгрузка,
			СтруктураПроверки,
			МассивОшибокБП);

		ЛокЯдро_ПроверитьКорректностьТипаМетаданных(
			НастройкаБП.ТипРезультирующегоДокумента1С,
			"Документы1С",
			КонтекстПроверки.МассивИменТиповДокументов1С,
			СтрМетаданных.МетаданныеДок1СЗагрузка,
			СтруктураПроверки,
			МассивОшибокБП);

		Если НЕ СтруктураПроверки.ОшибкаБП
			И НЕ СтруктураПроверки.ОшибкаМетаданных1С Тогда

			ЛокЯдро_ПроверитьДоступностьОбработчиковЗагрузки(
				НастройкаБП, КонтекстПроверки.МассивПроверенныхОбработчиков, СтруктураПроверки, МассивОшибокБП);

			ЛокЯдро_ПроверитьДоступностьИКорректностьПроизвольныхОбработчиков(
				НастройкаБП, СтруктураПроверки, МассивОшибокБП);

			ЛокЯдро_ПроверитьКорректностьНастроекОбработкиПолейИТабличныхЧастей(
				НастройкаБП, СтрМетаданных, СтруктураПроверки, МассивОшибокБП);

		КонецЕсли;

		СтруктураПроверки.Вставить("МассивОшибок", МассивОшибокБП);

	КонецЕсли;
	
	пСообщение = "Метаданные:";
	ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , 1);
	
	Если СтруктураПроверки.ОшибкаБП Тогда
		
		КонтекстПроверки.Счетчики.КоличествоОшибок = КонтекстПроверки.Счетчики.КоличествоОшибок + 1;
		
		МассивОшибок = СтруктураПроверки.МассивОшибок;
		
		пСообщение = "[x] Ошибок " + МассивОшибок.Количество() + ":";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, "Ошибка", 2);
		
		Для Каждого Ошибка Из МассивОшибок Цикл
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "- " + Ошибка, "Ошибка", 3);
		КонецЦикла;
		
	ИначеЕсли СтруктураПроверки.СтороннийБП Тогда
		
		КонтекстПроверки.Счетчики.КоличествоПредупреждений = КонтекстПроверки.Счетчики.КоличествоПредупреждений + 1;
		
		КонтекстПроверки.МассивСтороннихБП.Добавить(СтруктураПроверки.ID_БизнесПроцесса);
		
		пСообщение = "[!] Бизнес-процесс не входит в данный программный продукт. Проверка настроек пропущена.";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, "Предупреждение", 2);
		
	ИначеЕсли СтруктураПроверки.ОшибкаМетаданных1С Тогда
		
		КонтекстПроверки.Счетчики.КоличествоОшибок = КонтекстПроверки.Счетчики.КоличествоОшибок + 1;
		
		пСообщение = "[x] Проверка пропущена по причине:";
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, "Ошибка", 2);
		
		ОшибкиМетаданных1С = СтруктураПроверки.ОшибкиМетаданных1С;
		Для каждого Ошибка ИЗ ОшибкиМетаданных1С Цикл
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "- " + Ошибка, "Ошибка", 3);
		КонецЦикла;
		
	Иначе
		ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, "ОК", , 2);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ДиагностикаБП_ВывестиИзменения(ПользовательскиеНастройки, ТиповыеНастройки, МассивРезультатов, ТекОтступ, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЕстьИзменения = Ложь;
	
	КлючиПропуска = Неопределено;
	Если ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("КлючиПропуска") Тогда
		КлючиПропуска = ДополнительныеПараметры.КлючиПропуска;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ПользовательскиеНастройки Цикл
	
		ИмяНастройки	= КлючЗначение.Ключ;
		ЗначениеПользв	= КлючЗначение.Значение;
		
		Если ИмяНастройки = "Типовой" 
				ИЛИ ИмяНастройки = "ЭтоТаблицаЗначений"
				ИЛИ ЛокЯдро_СтрНайти(ИмяНастройки, "ВидОбработчика_") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если КлючиПропуска <> Неопределено И КлючиПропуска.Получить(ИмяНастройки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеТиповой = Неопределено;
		ТиповыеНастройки.Свойство(ИмяНастройки, ЗначениеТиповой);
		
		ТипЗнчПользв = ТипЗнч(ЗначениеПользв);
		
		Если ЗначениеТиповой = Неопределено Тогда
		
			пСообщение = "[+] новое: " + ИмяНастройки + ": " + Строка(ЗначениеПользв);
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , ТекОтступ + 1);
			ЕстьИзменения = Истина;
		
		ИначеЕсли ТипЗнчПользв = Тип("Массив") Тогда
		
			КлючиУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			
			Если КлючиУникальности = "" ИЛИ ТипЗнч(ЗначениеТиповой) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			
			ЧитаемоеИмя			= ЛокЯдро_ДиагностикаБП_ЧитаемоеИмяНастройки(ИмяНастройки);
			ЭтоНастройкаТЧ		= (ИмяНастройки = "НастройкаВыгрузкиТЧ" ИЛИ ИмяНастройки = "НастройкаЗагрузкиТЧ");
			ЭтоНастройкаПолей	= (ИмяНастройки = "НастройкаВыгрузкиПолей" ИЛИ ИмяНастройки = "НастройкаЗагрузкиПолей" ИЛИ ИмяНастройки = "ТабличнаяЧастьДокумента1С");
			
			Если НЕ ЭтоНастройкаТЧ Тогда
				ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, ЧитаемоеИмя + ":", , ТекОтступ + 1);
			КонецЕсли;
			
			МассивКлючей = ЛокЯдро_СтрРазделить(КлючиУникальности, ",");
			
			КлючиПропускаДляЭлемента = Новый Соответствие;
			Для Каждого ЧастьКлюча Из МассивКлючей Цикл
				КлючиПропускаДляЭлемента.Вставить(СокрЛП(ЧастьКлюча), Истина);
			КонецЦикла;
			
			ДопПараметрыЭлемента = Новый Структура("КлючиПропуска", КлючиПропускаДляЭлемента);
			
			Для Каждого ЭлементПользв Из ЗначениеПользв Цикл
			
				Если ТипЗнч(ЭлементПользв) <> Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЭлементПользв.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ОписаниеЭлемента		= ЛокЯдро_ДиагностикаБП_ОписаниеЭлементаМассива(ИмяНастройки, ЭлементПользв);
				ПользовательскоеПоле	= ЭлементПользв.Свойство("Типовой") И ЭлементПользв.Типовой = Ложь;
				
				Если ПользовательскоеПоле Тогда
					
					Если ЭтоНастройкаПолей Тогда
						
						Если (ЭлементПользв.Свойство("Выгружать") И ЭлементПользв.Выгружать <> Истина)
							ИЛИ (ЭлементПользв.Свойство("Загружать") И ЭлементПользв.Загружать <> Истина) Тогда
							// Пользовательское отключенное поле - пропускаем
							Продолжить;
						КонецЕсли;
						
						ИмяПриемника = "";
						Если ЭлементПользв.Свойство("ИмяПриемника") Тогда
							ИмяПриемника = ЭлементПользв.ИмяПриемника;
						КонецЕсли;
						
						СинонимИсточника = "";
						Если ЭлементПользв.Свойство("СинонимИсточника") Тогда
							СинонимИсточника = ЭлементПользв.СинонимИсточника;
						КонецЕсли;
						
						ИмяИсточника = "";
						Если ЭлементПользв.Свойство("ИмяИсточника") Тогда
							ИмяИсточника = ЭлементПользв.ИмяИсточника;
						КонецЕсли;
						
						Если ЭлементПользв.ТипИсточника = "ГлобальныйПараметр" Тогда
							ИмяИсточника = "ГП " + ИмяИсточника;
						ИначеЕсли ЭлементПользв.ТипИсточника = "ПроизвольныйКод" Тогда
							ИмяИсточника = "ПК " + ИмяИсточника;
						ИначеЕсли ЭлементПользв.ТипИсточника = "ПроизвольноеЗначение" Тогда
							СинонимИсточника = Строка(ЭлементПользв.ЗначениеИсточника);
							ИмяИсточника = Строка(ТипЗнч(ЭлементПользв.ЗначениеИсточника));
						КонецЕсли;
						
						ОписаниеЭлемента = """" + ИмяПриемника + """";
						Если ЗначениеЗаполнено(ИмяИсточника) И ИмяИсточника <> ИмяПриемника Тогда
							ОписаниеЭлемента = ОписаниеЭлемента + ": Источник: """ + СинонимИсточника + """ (" + ИмяИсточника + ")";
						КонецЕсли;
						
					КонецЕсли;
					
					ОтступЭлемента	= ?(ЭтоНастройкаТЧ, ТекОтступ + 1, ТекОтступ + 2);
					пСообщение		= " [+] новое: " + ОписаниеЭлемента;
					ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , ОтступЭлемента);
					ЕстьИзменения = Истина;
				
				Иначе
				
					Отбор = Новый Структура(КлючиУникальности);
					ЗаполнитьЗначенияСвойств(Отбор, ЭлементПользв);
					
					ЭлементыТиповой = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеТиповой, Отбор, Ложь);
					
					Если ЭлементыТиповой <> Неопределено И ЭлементыТиповой.Количество() > 0 Тогда
					
						Для Каждого ЭлементТиповой Из ЭлементыТиповой Цикл
						
							Если ЭтоНастройкаПолей Тогда
							
								Изменения = ЛокЯдро_ДиагностикаБП_ИзмененияПолей(ЭлементПользв, ЭлементТиповой);
								
								Если Изменения.Количество() > 0 Тогда
									пСообщение = " [~] изменено: " + ОписаниеЭлемента + ": " + ЛокЯдро_СтрСоединить(Изменения, ", ");
									ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , ТекОтступ + 2);
									ЕстьИзменения = Истина;
								КонецЕсли;
							
							ИначеЕсли ЭтоНастройкаТЧ Тогда
							
								ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов,
									ОписаниеЭлемента + ":", , ТекОтступ + 1);
								ЛокЯдро_ДиагностикаБП_ВывестиИзменения(ЭлементПользв, ЭлементТиповой,
									МассивРезультатов, ТекОтступ + 1, ДопПараметрыЭлемента);
								ЕстьИзменения = Истина;
							
							Иначе
							
								ЛокЯдро_ДиагностикаБП_ВывестиИзменения(ЭлементПользв, ЭлементТиповой,
									МассивРезультатов, ТекОтступ + 2, ДопПараметрыЭлемента);
							
							КонецЕсли;
						
						КонецЦикла;
					
					Иначе
					
						ОтступЭлемента	= ?(ЭтоНастройкаТЧ, ТекОтступ + 1, ТекОтступ + 2);
						пСообщение		= "[x] Осиротевший ключ: " + ОписаниеЭлемента;
						ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, "Ошибка", ОтступЭлемента);
						ЕстьИзменения = Истина;
					
					КонецЕсли;
				
				КонецЕсли;
			
			КонецЦикла;
		
		ИначеЕсли ТипЗнчПользв = Тип("Структура") Тогда
		
			ЧитаемоеИмя = ЛокЯдро_ДиагностикаБП_ЧитаемоеИмяНастройки(ИмяНастройки);
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, ЧитаемоеИмя + ":", , ТекОтступ + 1);
			ЛокЯдро_ДиагностикаБП_ВывестиИзменения(ЗначениеПользв, ЗначениеТиповой, МассивРезультатов, ТекОтступ + 1);
		
		ИначеЕсли ЗначениеПользв <> ЗначениеТиповой Тогда
		
			пСообщение = " [~] изменено: " + ИмяНастройки + ": """ + Строка(ЗначениеТиповой) + """ -> """ + Строка(ЗначениеПользв) + """";
			ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, пСообщение, , ТекОтступ + 1);
			ЕстьИзменения = Истина;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ЕстьИзменения;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ДиагностикаБП_ОписаниеЭлементаМассива(ИмяНастройки, Элемент)
	
	Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Возврат Строка(Элемент);
	КонецЕсли;
	
	Если ИмяНастройки = "НастройкаВыгрузкиТЧ" ИЛИ ИмяНастройки = "НастройкаЗагрузкиТЧ" Тогда
	
		ИмяТаблицы1С	= "";
		ИмяТаблицыMS	= "";
		
		Если Элемент.Свойство("НастройкаТЧСтрокой") Тогда
			ИмяТаблицы1С = Элемент.НастройкаТЧСтрокой;
		КонецЕсли;
		
		Если Элемент.Свойство("ТабличнаяЧастьДокументаMS") Тогда
			ИмяТаблицыMS = Элемент.ТабличнаяЧастьДокументаMS;
		КонецЕсли;
		
		Если ИмяНастройки = "НастройкаВыгрузкиТЧ" Тогда
			Описание = "Выгрузка ТЧ """ + ИмяТаблицы1С + """ -> """ + ИмяТаблицыMS + """";
		Иначе
			Описание = "Загрузка ТЧ """ + ИмяТаблицыMS + """ -> """ + ИмяТаблицы1С + """";
		КонецЕсли;
		
		Возврат Описание;
	
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиПолей" ИЛИ ИмяНастройки = "НастройкаЗагрузкиПолей" Тогда
	
		ИмяПриемника = "";
		Если Элемент.Свойство("ИмяПриемника") Тогда
			ИмяПриемника = Элемент.ИмяПриемника;
		КонецЕсли;
		
		ИмяИсточника = "";
		Если Элемент.Свойство("ИмяИсточника") Тогда
			ИмяИсточника = Элемент.ИмяИсточника;
		КонецЕсли;
		
		Описание = """" + ИмяПриемника + """";
		Если ЗначениеЗаполнено(ИмяИсточника) И ИмяИсточника <> ИмяПриемника Тогда
			Описание = Описание + ": Источник: """ + ИмяИсточника + """";
		КонецЕсли;
		
		Возврат Описание;
	
	КонецЕсли;
	
	КлючиУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
	
	Если НЕ ЗначениеЗаполнено(КлючиУникальности) Тогда
		Возврат Строка(Элемент);
	КонецЕсли;
	
	МассивКлючей	= ЛокЯдро_СтрРазделить(КлючиУникальности, ",");
	ЧастиОписания	= Новый Массив;
	
	Для Каждого ЧастьКлюча Из МассивКлючей Цикл
	
		Если Элемент.Свойство(СокрЛП(ЧастьКлюча)) Тогда
			ЧастиОписания.Добавить(Строка(Элемент[СокрЛП(ЧастьКлюча)]));
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ЛокЯдро_СтрСоединить(ЧастиОписания, " | ");
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ДиагностикаБП_ЧитаемоеИмяНастройки(ИмяНастройки)
	
	Если ИмяНастройки = "НастройкаВыгрузкиПолей" Тогда
		Возврат "Выгрузка шапки";
	ИначеЕсли ИмяНастройки = "НастройкаЗагрузкиПолей" Тогда
		Возврат "Загрузка шапки";
	ИначеЕсли ИмяНастройки = "НастройкаВыгрузкиТЧ" Тогда
		Возврат "Выгрузка ТЧ";
	ИначеЕсли ИмяНастройки = "НастройкаЗагрузкиТЧ" Тогда
		Возврат "Загрузка ТЧ";
	ИначеЕсли ИмяНастройки = "ТабличнаяЧастьДокумента1С" Тогда
		Возврат "Поля";
	КонецЕсли;
	
	Возврат ИмяНастройки;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ДиагностикаБП_ИзмененияПолей(ЭлементПользв, ЭлементТиповой)
	
	Изменения = Новый Массив;
	
	Для Каждого КЗ Из ЭлементПользв Цикл
	
		Если КЗ.Ключ = "ИмяПриемника" ИЛИ КЗ.Ключ = "Типовой" ИЛИ КЗ.Ключ = "ЭтоТаблицаЗначений" Тогда
			Продолжить;
		КонецЕсли;
		
		СтароеЗначение = Неопределено;
		
		Если ЭлементТиповой.Свойство(КЗ.Ключ, СтароеЗначение) Тогда
		
			Если Строка(КЗ.Значение) <> Строка(СтароеЗначение) Тогда
				Изменения.Добавить(КЗ.Ключ + ": """ + Строка(СтароеЗначение) + """ -> """ + Строка(КЗ.Значение) + """");
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Изменения;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_Автотесты_ДобавитьРезультатДиагностики(МассивРезультатов, Текст, Уровень = "Информация", Отступ = 0)
	
	Если Отступ > 0 Тогда
	
		Префикс = "";
		Для Сч = 1 По Отступ Цикл
			Префикс = Префикс + "    ";
		КонецЦикла;
		Текст = Префикс + Текст;
	
	КонецЕсли;
	
	МассивРезультатов.Добавить(Новый Структура("Текст, Уровень", Текст, Уровень));

КонецПроцедуры

// Автотест настройки подключения по строке CLGT с сервера.
// Получает CLGT-строку из BaseInfo, выполняет проверку подключения с расположением "НаСервере"
// с дополнительной проверкой обновления AccessToken, затем восстанавливает исходные параметры подключения
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_НастройкаПодключения_Clgt()

	ИмяСобытия = "ЛокЯдро_Автотесты_НастройкаПодключения_Clgt";
		
	СтрокаClgt = ЛокЯдро_ПолучитьСтрокуClgt("Основная");
	
	Если НЕ ЗначениеЗаполнено(СтрокаClgt) Тогда
	
		пСообщение = "Clgt строка не найдена в BaseInfo, тест пропущен";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		Возврат;
	
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	пПараметрыПодключенияMS = ЛокЯдро_СкопироватьСтруктуру(ПараметрыПодключенияMS);
	
	пСообщение = "Начало. Проверка настройки подключения clgt %1 – %2";
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, "НаСервере", СтрокаClgt);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПроверитьОбновлениеAccessToken");
	
	ЛокЯдро_Автотесты_ПроверитьНастройкуПодключения(СтрокаClgt, "НаСервере", ДополнительныеПараметры);
	
	// Восстановим локальное подключение для последующих автотестов ЛокЯдро_Автотесты_НастройкаПодключения_*
	ЛокЯдро_СохранитьПараметрыПодключенияMS(пПараметрыПодключенияMS);
	КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", пПараметрыПодключенияMS);
	ПараметрыПодключенияMS = пПараметрыПодключенияMS;
	
КонецПроцедуры

// Автотест настройки подключения с расположением компоненты "НаКлиенте".
// Получает строку подключения из параметров MS и выполняет проверку подключения на клиентской стороне
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_НастройкаПодключения_НаКлиенте()

	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	ЛокЯдро_Автотесты_ПроверитьНастройкуПодключения(ПараметрыПодключенияMS.СтрокаПодключения, "НаКлиенте");
	
КонецПроцедуры 

// Автотест настройки подключения с расположением компоненты "НаСервере".
// Получает строку подключения из параметров MS и выполняет проверку подключения на серверной стороне
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_НастройкаПодключения_НаСервере()

	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	ЛокЯдро_Автотесты_ПроверитьНастройкуПодключения(ПараметрыПодключенияMS.СтрокаПодключения, "НаСервере");
	
КонецПроцедуры

// Выполняет проверку настройки подключения к серверу SMARTS по заданной строке подключения.
// Очищает справочники для проверки выгрузки первичных данных, формирует параметры вызова
// и запускает асинхронную настройку подключения с callback-обработчиком завершения
//
// Параметры:
// 	СтрокаПодключения - Строка - строка подключения к серверу SMARTS
// 	пРасположениеКомпоненты - Строка - расположение компоненты: "НаКлиенте" или "НаСервере"
// 	ДополнительныеПараметры - Структура - дополнительные параметры проверки (например ПроверитьОбновлениеAccessToken)
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьНастройкуПодключения(СтрокаПодключения, пРасположениеКомпоненты, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьНастройкуПодключения";
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = "Начало. Проверка настройки подключения %1 – %2";
	
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, пРасположениеКомпоненты, СтрокаПодключения);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	// Очищаем справочники для возможности проверить выгрузку первичных данных
	ЛокЯдро_ОчиститьВсеСправочники();
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	ДополнительныеПараметры.Вставить("НачалоСобытия", НачалоСобытия);
	
	ПараметрыВыполнения 						= ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
	ПараметрыВыполнения.СтрокаПодключенияСМАРТС = СтрокаПодключения;
	ПараметрыВыполнения.ТипБазы 				= "Основная";
	ПараметрыВыполнения.РасположениеКомпоненты 	= пРасположениеКомпоненты;
	ПараметрыВыполнения.СпособЗапуска 			= "ПоПараметруЗапуска";
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_Автотесты_ПроверитьНастройкуПодключенияЗавершение", ЭтаФорма, ДополнительныеПараметры);
	ПараметрыВыполнения.ОповещениеОбработкиЗавершения = ОП;
	
	ЛокЯдро_НастройкаПодключения_НастроитьПодключение(ПараметрыВыполнения);
	
КонецПроцедуры

// Callback-обработчик завершения асинхронной настройки подключения.
// Логирует результат (успех/ошибка), при успешном подключении запускает следующий автотест:
// проверку обновления AccessToken или проверку первой инициализации
//
// Параметры:
//	ПараметрыВыполнения - Структура - результат настройки подключения (СтрокаПодключенияСМАРТС,
//										РасположениеКомпоненты, ПодключениеДоступно)
//	ДополнительныеПараметры - Структура - контекст вызова (НачалоСобытия, ПроверитьОбновлениеAccessToken)
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьНастройкуПодключенияЗавершение(ПараметрыВыполнения = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьНастройкуПодключенияЗавершение";
	
	Если ПараметрыВыполнения <> Неопределено Тогда
		
		СтрокаПодключения = ПараметрыВыполнения.СтрокаПодключенияСМАРТС;
		пРасположениеКомпоненты = ПараметрыВыполнения.РасположениеКомпоненты;
		
		Если ПараметрыВыполнения.ПодключениеДоступно Тогда
						
			пСообщение = "Конец. Подключение успешно настроено: %1 – %2";
			
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, пРасположениеКомпоненты, СтрокаПодключения);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, ДополнительныеПараметры.НачалоСобытия);
			
			Если ДополнительныеПараметры.Свойство("ПроверитьОбновлениеAccessToken") Тогда
				ЛокЯдро_Автотесты_ПроверитьОбновлениеAccessToken();
			Иначе
				ЛокЯдро_Автотесты_ПроверитьПервуюИнициализацию();
			КонецЕсли;
			
		Иначе
			
			пСообщение = "Конец. Ошибка подключения: %1 – %2";
			
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, пРасположениеКомпоненты, СтрокаПодключения);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение, ДополнительныеПараметры.НачалоСобытия);
			
		КонецЕсли;
		
	Иначе
		пСообщение = "Конец. Не удалось проверить результат настройки подключения.";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение, ДополнительныеПараметры.НачалоСобытия);
	КонецЕсли;
	
КонецПроцедуры

// Автотест первой инициализации после настройки подключения.
// Проверяет подключение интеграционной обработки и выгрузку первичных данных на сервер SMARTS
//
// Параметры:
//	ДополнительныеПараметры - Структура - зарезервировано для расширения
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьПервуюИнициализацию(ДополнительныеПараметры = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьПервуюИнициализацию";
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	пСообщение = "Начало. Проверка настройки подключения %1 – %2";
	
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, РасположениеКомпоненты, ПараметрыПодключенияMS.СтрокаПодключения);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	// 1. Проверка подключения ИО
	ЛокЯдро_Автотесты_ПроверитьПодключениеИО();
	
	// 2. Проверка выгрузки первичных данных
	ЛокЯдро_Автотесты_ПроверитьВыгрузкуПервичныхДанных();
	
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", "Конец", НачалоСобытия);
	
КонецПроцедуры

// Автотест подключения интеграционной обработки (ИО).
// Проверяет, что ИО была успешно подключена после настройки подключения,
// логирует тип, имя и путь интеграционной обработки
//
// Параметры:
//	ДополнительныеПараметры - Структура - зарезервировано для расширения
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьПодключениеИО(ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьПодключениеИО";
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	ТипОбработки 				= Неопределено;
	ИмяИнтеграционнойОбработки 	= Неопределено;
	ПутьИнтеграционнойОбработки = Неопределено;
	
	ПараметрыПодключенияMS.Свойство("ТипОбработки", ТипОбработки);
	ПараметрыПодключенияMS.Свойство("ИмяИнтеграционнойОбработки", ИмяИнтеграционнойОбработки);
	ПараметрыПодключенияMS.Свойство("ПутьИнтеграционнойОбработки", ПутьИнтеграционнойОбработки);
	
	ИнтеграционнаяОбработкаПодключена = КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработкаПодключена") = Истина;
	
	Если ИнтеграционнаяОбработкаПодключена Тогда
		
		пСообщение = "Интеграционная обработка подключена
		| ТипОбработки: %1
		| ИмяИнтеграционнойОбработки: %2
		| ПутьИнтеграционнойОбработки: %3";
		
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТипОбработки, ИмяИнтеграционнойОбработки, ПутьИнтеграционнойОбработки);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	Иначе
		
		пСообщение = "Интеграционная обработка НЕ подключена
		| ТипОбработки: %1
		| ИмяИнтеграционнойОбработки: %2
		| ПутьИнтеграционнойОбработки: %3";
		
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТипОбработки, ИмяИнтеграционнойОбработки, ПутьИнтеграционнойОбработки);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	КонецЕсли;
	
КонецПроцедуры

// Автотест выгрузки первичных данных на сервер SMARTS после настройки подключения.
// Проверяет наличие данных в таблицах БизнесПроцессы и Ячейки на сервере SMARTS
//
// Параметры:
//	ДополнительныеПараметры - Структура - зарезервировано для расширения
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьВыгрузкуПервичныхДанных(ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьВыгрузкуПервичныхДанных";
	
	// БизнесПроцессы
	КоличествоБП = ЛокЯдро_ПолучитьКоличествоСтрокТаблицыSMARTS("БизнесПроцессы");
	Если КоличествоБП = Неопределено ИЛИ КоличествоБП = 0 Тогда
		
		пСообщение = "Таблица БизнесПроцессы не выгружена в SMARTS";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	Иначе
		
		пСообщение = "Таблица БизнесПроцессы выгружен, количество: " + КоличествоБП;
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	КонецЕсли;
	
	// Ячейки
	КоличествоБП = ЛокЯдро_ПолучитьКоличествоСтрокТаблицыSMARTS("Ячейки");
	Если КоличествоБП = Неопределено ИЛИ КоличествоБП = 0 Тогда
		
		пСообщение = "Таблица Ячейки не выгружена в SMARTS";
		// Предупреждение поскольку таблица ячеек может быть пустой в 1С
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		
	Иначе
		
		пСообщение = "Таблица Ячейки выгружен, количество: " + КоличествоБП;
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	КонецЕсли;
	
КонецПроцедуры 

// Автотест обновления OAuth2-токенов (Access и Refresh) при подключении к SMARTS.
// Подменяет текущий AccessToken на невалидный, выполняет подключение к базе SMARTS
// и проверяет, что оба токена были успешно обновлены через механизм refresh
//
&НаКлиенте
Процедура ЛокЯдро_Автотесты_ПроверитьОбновлениеAccessToken()

	ИмяСобытия = "ЛокЯдро_Автотесты_ПроверитьОбновлениеAccessToken";
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
		
	АвторизацияВключена = Ложь;
	
	Если ПараметрыПодключенияMS.Свойство("АвторизацияВключена") Тогда
		АвторизацияВключена = ПараметрыПодключенияMS.АвторизацияВключена;
	КонецЕсли;
	
	Если НЕ АвторизацияВключена = Истина Тогда
	
		пСообщение = "Авторизация отключена, тест пропущен";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		Возврат;
	
	КонецЕсли;
	
	СтарыйAccessToken = Неопределено;
	ПараметрыПодключенияMS.Свойство("АвторизацияТокен", СтарыйAccessToken);
	
	СтарыйRefreshToken = Неопределено;
	ПараметрыПодключенияMS.Свойство("АвторизацияРефрешТокен", СтарыйRefreshToken);
	
	Если НЕ ЗначениеЗаполнено(СтарыйRefreshToken) Тогда
	
		пСообщение = "Refresh-токен не заполнен, тест пропущен";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		Возврат;
	
	КонецЕсли;
	
	СтрокаПодключения = ПараметрыПодключенияMS.СтрокаПодключения;
	
	пСообщение = "Проверка обновления токена
					| Access_token: %1
					| Refresh_token: %2";
	пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтарыйAccessToken, СтарыйRefreshToken);
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	НевалидныйТокен = "invalid_access_token_for_refresh_test";
	ТокеныДляЗамены = Новый Структура("Access_token, Refresh_token", НевалидныйТокен, СтарыйRefreshToken);
	ЛокЯдро_ОбновитьТокеныВПараметрахПодключения(СтрокаПодключения, ТокеныДляЗамены, "Основная", "REST_API");
	
	пСообщение = "Access_token заменён на невалидный, вызываем подключение";
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной("REST_API_СтруктураПодключенияБазыMS");
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
	
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("СтруктураПодключения",   СтруктураПодключения);
		ПараметрыМетода.Вставить("Переподключиться", 	   Ложь);
		ПараметрыМетода.Вставить("ТипБазы", 			   "Основная");
		ПараметрыМетода.Вставить("Интерактивно", 		   Ложь);
		ПараметрыМетода.Вставить("НеПроверятьАвторизацию", Ложь);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", 		"Функция");
		СтруктураВызова.Вставить("ИмяМетода", 		"ПодключитьсяКБазеSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		РезультатПодключения = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, , АдресаПеременных);
	
	Иначе 
	
		РезультатПодключения = REST_API_ПодключитьсяКБазеSMARTS(СтруктураПодключения, Ложь, Ложь);
	
	КонецЕсли;
	
	ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	
	// Проверка АвторизацияТокен
	НовыйAccessToken = Неопределено;
	ПараметрыПодключенияMS.Свойство("АвторизацияТокен", НовыйAccessToken);
	
	Если НовыйAccessToken = НевалидныйТокен ИЛИ НЕ ЗначениеЗаполнено(НовыйAccessToken) Тогда
		
		пСообщение = "Ошибка обновления Access_token";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	ИначеЕсли НовыйAccessToken = СтарыйAccessToken Тогда
		
		пСообщение = "Ошибка обновления Access_token. Старый Access_token совпадает с новым: " + Строка(НовыйAccessToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	Иначе
		
		пСообщение = "Access_token успешно обновлён: %1 
						|Старый токен: %2";
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, НовыйAccessToken, СтарыйAccessToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	КонецЕсли;
	
	// Проверка АвторизацияРефрешТокен
	НовыйRefreshToken = Неопределено;
	ПараметрыПодключенияMS.Свойство("АвторизацияРефрешТокен", НовыйRefreshToken);
	
	Если НЕ ЗначениеЗаполнено(НовыйRefreshToken) Тогда
		
		пСообщение = "Ошибка обновления Refresh_token";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	ИначеЕсли НовыйRefreshToken = СтарыйRefreshToken Тогда
		
		пСообщение = "Ошибка обновления Refresh_token. Старый Refresh_token совпадает с новым: " + Строка(НовыйRefreshToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
		
	Иначе
		
		пСообщение = "Refresh_token успешно обновлён: %1 
						|Старый токен: %2";
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, НовыйRefreshToken, СтарыйRefreshToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	КонецЕсли;
	
	Если РезультатПодключения = Истина Тогда
	
		пСообщение = "Подключение после обновления токена успешно
						| Access_token: %1
						| Refresh_token: %2";
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, НовыйAccessToken, НовыйRefreshToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
	
	Иначе
	
		пСообщение = "Ошибка подключения после обновления токена
						| Access_token: %1
						| Refresh_token: %2";
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, НовыйAccessToken, НовыйRefreshToken);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
	
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ЛокальныйКонтекст_РаботаСФормами

// Централизованная обработка события "ПриОткрытии" для всех форм.
// Выполняет инициализацию общих параметров, настройку элементов формы
//
// Параметры:
//  ФормаИсточник - УправляемаяФорма - Открываемая форма
//  ДополнительныеПараметры - Структура - Параметры открытия формы
//
&НаКлиенте
Процедура ЛокЯдро_ПриОткрытии(ФормаИсточник, ДополнительныеПараметры = Неопределено) Экспорт
	
	
	
КонецПроцедуры

// Обработчик закрытия подсказки
// Подробности: ГлКонтекст.ГлЯдро_Подсказки_ДобавитьПодсказкиНаФорму()
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, содержащая подсказку
//  Элемент - ДекорацияФормы - Элемент кнопки закрытия подсказки
//
&НаКлиенте
Процедура ЛокЯдро_Подсказки_ЗакрытьПодсказку(ФормаИсточник, Элемент) Экспорт
	
	// Получаем имя подсказки из имени элемента
	ИмяЭлемента 		= СтрЗаменить(Элемент.Имя, "_Закрыть", ""); 
	ИмяПодсказки 		= СтрЗаменить(ИмяЭлемента, "Подсказка_", "");
	ИмяФормыИсточник 	= ЛокЯдро_ПолучитьИмяФормы(ФормаИсточник);
	ИмяНастройки 		= ИмяФормыИсточник + "_ГруппаПодсказка_" + ИмяПодсказки;
	
	// Сохраняем настройку о скрытии подсказки
	ЛокЯдро_ЗаписатьПользовательскуюНастройку(ИмяНастройки, Ложь);
	
	// Скрываем группу подсказки
	ИмяГруппыПодсказки = "ГруппаПодсказка_" + ИмяПодсказки;
	ГруппаПодсказки = ФормаИсточник.Элементы.Найти(ИмяГруппыПодсказки);
	Если ГруппаПодсказки <> Неопределено Тогда
