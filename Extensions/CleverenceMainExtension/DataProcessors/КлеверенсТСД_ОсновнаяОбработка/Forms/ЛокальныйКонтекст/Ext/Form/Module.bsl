Функция КомЯдро_ПолучитьСписокРеквизитовСущностиMS(СущностьMS, ДополнительныйСписок = Неопределено)
	
	ИмяСобытия = "КомЯдро_ПолучитьСписокРеквизитовСущностиMS";
	
	СписокРеквизитов = Новый Массив;
	Для Индекс = 0 По СущностьMS.Количество - 1 Цикл
		ДанныеРеквизита = СущностьMS.Элемент(Индекс);
		Если ДанныеРеквизита.ReadOnly Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = ДанныеРеквизита.ИмяПоля;
		uni = ДанныеРеквизита.uni;
		Если ЛокЯдро_ПроверитьПервыйСимволНаЦифру(ИмяПоля) 
			Или ЛокЯдро_ПроверитьПервыйСимволНаЦифру(uni) Тогда
			пСообщение = НСтр("ru = 'Реквизит %1 нельзя использовать в интеграции с 1С. Имя реквизита не должно начинаться с цифры.';
								|en = 'The %1 banking details cannot be used in integration with 1C. The name of the prop must not start with a number.';
								|be = 'Рэквізіт %1 нельга выкарыстоўваць у інтэграцыі з 1С. імя рэквізіту не павінна пачынацца з лічбы.'; es = 'Los apoyos %1 no se pueden usar en la integración con 1C. El nombre de los apoyos no debe comenzar con un número.'; ka = '%1 საბანკო დეტალები არ შეიძლება გამოყენებულ იქნას 1c-თან ინტეგრაციაში. რეკვიზიტის სახელი არ უნდა დაიწყოს ნომრით.'; kk = '%1 деректемесін 1С интеграциясында қолдануға болмайды.'; ro = 'Contul %1 nu poate fi utilizat în integrarea cu 1C. numele contului nu trebuie să înceapă cu o cifră.'; tr = '1C ile entegrasyonda %1 sahne kullanılamaz. Sahne adı bir rakamla başlamamalıdır.'; uk = 'Реквізит %1 не можна використовувати в інтеграції з 1С. Ім''я реквізиту не повинно починатися з цифри.'; uz = '1C bilan integratsiyada %1 rekvizitidan foydalanish mumkin emas.rekvizit nomi raqam bilan boshlanmasligi kerak.'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ИмяПоля);
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", пСообщение);
			Продолжить;
		КонецЕсли;
			
		СписокРеквизитов.Добавить(Новый Структура("Значение,Ключ,Uni",ИмяПоля, ИмяПоля, ЛокЯдро_ПреобразоватьПервыйСимволВНижнийРегистр(uni)));
