// Получает массив структур имен макетов по умолчанию из интеграционной обработки
//
// Параметры:
//  МассивСтруктурИменСправочников 	- Массив - массив структур имен справочников, для которых будут получены макеты ИО
//
// Возвращаемое значение:
//	Массив, содержащий структуры
//   Структура   - содержит:
//		* ИмяСправочника - имя таблицы (справочника)
//		* ИмяМакета - имя макета ИО по умолчанию
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивСтруктурМакетовИОПоУмолчанию(МассивСтруктурИменСправочников) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивСтруктурМакетовИОПоУмолчанию");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("МассивСтруктурИменСправочников", МассивСтруктурИменСправочников));
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
КонецФункции

// Вызывает из модуля обработки функцию получения схемы компоновки данных по тексту запроса
//
// Параметры:
//	ТекстЗапрос - Строка - текст запроса, по которому необходимо построить СКД
//	ТекстКодаПолучениеПараметров - Строка - строка кода, из которой будут получены параметры
//	ТаблицаСопоставленияПолей - Массив - массив строк с сопоставлением реквизит 1с - реквизит Клеверенс
//
// Возвращаемое значение:
//	- СхемаКомпоновкиДанных - схема компоновки данных для выгрузки таблицы на сервер Клеверенс
//  - Неопределено - если не удалось получить интеграционную обработку
&НаКлиенте
Функция ЛокЯдро_ПолучитьСхемуСКДПоТекстуЗапроса(ТекстЗапроса, ТекстКодаПолучениеПараметров, ТаблицаСопоставленияПолей) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСхемуСКДПоТекстуЗапроса");
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ТекстЗапроса", 					ТекстЗапроса);
	ПараметрыМетода.Вставить("ТекстКодаПолучениеПараметров", 	ТекстКодаПолучениеПараметров);
	ПараметрыМетода.Вставить("ТаблицаСопоставленияПолей", 		ТаблицаСопоставленияПолей);	
	СтруктураВызова.Вставить("ПараметрыМетода", 				ПараметрыМетода);
	
	СхемаСКД = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Истина, АдресаПеременных);	
		
	Возврат СхемаСКД;
	
КонецФункции

// Получает настройки отборов справочников по режимам обмена. Режимы обмена: Онлайн, Интерактивный, Автообмен
&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкиОтборовСправочников(ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьНастройкиОтборовСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_Узла,ДополнительныеПараметры",
		ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СериализуемыеНастройки = Новый Массив;
	ЭтоЧастнаяБаза = Ложь;
	
	НастройкиПолучены = Ложь;
	Если НЕ ПустаяСтрока(ID_Узла) Тогда
		
		Отбор = Новый Структура("ID_Узла", ID_Узла);
		ИспользоватьЧастнуюБазу = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("Узлы", Отбор, "ИспользоватьЧастнуюБазу");
		ЭтоЧастнаяБаза = ИспользоватьЧастнуюБазу = Истина;
		
		// Если частная база, то получаем узловое значение
		// Если узел не частная база, то получаем значения главного узла для Интерактивный и Автообмен
		Если НЕ ЭтоЧастнаяБаза Тогда
			
			// В онлайне есть узловые настройки для всех ТО
			НастройкиОтборовСправочников_Онлайн = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовСправочников_Онлайн", ID_Узла);
			
			// В интерактивном и регламентном режиме узловые настройки доступны только для частных баз
			//	поэтому получаем общую настройку главного узла
			
			НастройкиКПолучению = Новый Структура;
			НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Интерактивный");
			НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Автообмен");
			
			ЗначенияНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
			ЗначенияНастроек.Вставить("НастройкиОтборовСправочников_Онлайн", НастройкиОтборовСправочников_Онлайн);
			
			НастройкиПолучены = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Получаем узловые значения
	НастройкиКПолучению = Новый Структура;
	Если НЕ НастройкиПолучены Тогда
		
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Онлайн");
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Интерактивный");
		НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Автообмен");
		
		ЗначенияНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,ID_Узла);
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ID_Узла) Тогда
		
		НастройкиКПолучению = Новый Структура;
		
		// Проверяем заполнение узловых настроек
		Если ЭтоЧастнаяБаза Тогда
			
			Для каждого КлючЗначение Из ЗначенияНастроек Цикл	
				Если КлючЗначение.Значение = Ложь
						ИЛИ НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					НастройкиКПолучению.Вставить(КлючЗначение.Ключ);
				КонецЕсли;	
			КонецЦикла;
			
		Иначе
			Если ЗначенияНастроек.НастройкиОтборовСправочников_Онлайн = Ложь
					ИЛИ НЕ ЗначениеЗаполнено(ЗначенияНастроек.НастройкиОтборовСправочников_Онлайн) Тогда
				НастройкиКПолучению.Вставить("НастройкиОтборовСправочников_Онлайн");
			КонецЕсли;
		КонецЕсли;
		
		// Если узловое значение не заполнено, то получаем значение главного узла
		Если НастройкиКПолучению.Количество() Тогда
			
			пЗначенияНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
			
			Для каждого КлючЗначение Из пЗначенияНастроек Цикл	
				ЗначенияНастроек.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначенияНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ЗначенияНастроек;
	
КонецФункции

// Получает и заполняет структуру параметров выгрузки справочника
//
// Параметры:
//  ИмяТаблицы  - Строка - имя таблицы, для которой необходимо получить сохраненное имя макета ИО
//
// Возвращаемое значение:
//   Структура   - см. ГлЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников()
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника(ИмяТаблицы, РежимОбмена = "Интерактивный") Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьЗаполнитьСтруктуруПараметровВыгрузкиСправочника");
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяТаблицы", 					ИмяТаблицы);
	ПараметрыМетода.Вставить("РежимОбмена", 				РежимОбмена);
	СтруктураВызова.Вставить("ПараметрыМетода", 			ПараметрыМетода);

	ПараметрыВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат ПараметрыВыгрузки;

КонецФункции

// Объединяет основные настройки обмена спарвочников с настройками отборов по режимам
//
// Параметры:
//  РежимОбмена				 - 	Строка - Онлайн, Интерактивный, Автообмен
// 
// Возвращаемое значение:
//   - Массив
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима(РежимОбмена, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ID_Узла,ДополнительныеПараметры",
		РежимОбмена, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСобранныеНастройкиОбменаСправочниковРежима");
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("РежимОбмена", 				РежимОбмена);
		ПараметрыМетода.Вставить("ID_Узла", 					ID_Узла);
		ПараметрыМетода.Вставить("ДополнительныеПараметры", 	ДополнительныеПараметры);
		
		СтруктураВызова.Вставить("ПараметрыМетода", 			ПараметрыМетода);
		СобранныеНастройки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СобранныеНастройки);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат СобранныеНастройки;
		
	Иначе
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
		#КонецЕсли
		
		НастройкиОбменаСправочников = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОбменаСправочников");
		
		ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла");
		
		Если ID_Узла = ДанныеТекущегоУзла.ID_Узла Тогда
			НастройкиОтборовСправочников = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовСправочников_" + РежимОбмена);
		Иначе
			НастройкиОтборовСправочников = ЛокЯдро_ПолучитьНастройкиОтборовСправочников(ID_Узла);
			НастройкиОтборовСправочников = НастройкиОтборовСправочников["НастройкиОтборовСправочников_" + РежимОбмена];
		КонецЕсли;
		
		НастройкиОтборовСправочников = ?(ТипЗнч(НастройкиОтборовСправочников) = Тип("Массив"), НастройкиОтборовСправочников, Неопределено);
		
		СобранныеНастройки = Новый Массив;
		
		Если ТипЗнч(НастройкиОбменаСправочников) = Тип("Массив") Тогда
			
			СтруктураСтроки = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
			СобранныеНастройки.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтруктураСтроки));
			
			КлючУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек("НастройкиОбменаСправочников");
			
			Для каждого СтрокаНастройкиОбмена Из НастройкиОбменаСправочников Цикл
				Если СтрокаНастройкиОбмена.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройкиОбмена.ЭтоТаблицаЗначений Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройкиОбмена);
				
				Если НастройкиОтборовСправочников <> Неопределено Тогда
					
					Отбор = Новый Структура(КлючУникальности);
					ЗаполнитьЗначенияСвойств(Отбор, СтрокаНастройкиОбмена);
					СтрокаНастройкиОтборов = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборовСправочников, Отбор, Истина);
					Если СтрокаНастройкиОтборов <> Неопределено Тогда
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройкиОтборов);
					КонецЕсли;
					
				КонецЕсли;
				
				СобранныеНастройки.Добавить(НоваяСтрока);
				
			КонецЦикла;
			
		КонецЕсли;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СобранныеНастройки);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат СобранныеНастройки;
		
	КонецЕсли;
	
КонецФункции

// Сохраняет настройки отборов справочников в зависимости от режима обмена и использования частой базы
&НаКлиенте
Процедура ЛокЯдро_СохранитьНастройкиОтборовСправочников(РежимОбмена, ЗначениеНастройки, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СохранитьНастройкиОтборовСправочников";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РежимОбмена,ЗначениеНастройки,ID_Узла,ДополнительныеПараметры",
		РежимОбмена, ЗначениеНастройки, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РежимОбмена = "Онлайн"; // В ОФ нет разделения по режимам, используется всегда онлайн
	#КонецЕсли
	
	НастройкиКСохранению = Новый Структура;
	Если ПустаяСтрока(ID_Узла) ИЛИ РежимОбмена = "Онлайн" Тогда
		
		// В онлайне есть узловые настройки для всех ТО
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, ID_Узла);
		
	Иначе
		
		// В интерактивном и регламентном режиме узловые настройки доступны только для частных баз
		// 	если узел является частной базой, то сохраняем в узловую настройку, иначе в главную
		Отбор = Новый Структура("ID_Узла", ID_Узла);
		ИспользоватьЧастнуюБазу = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("Узлы", Отбор, "ИспользоватьЧастнуюБазу");
		ЭтоЧастнаяБаза = ИспользоватьЧастнуюБазу = Истина;
		
		Если ЭтоЧастнаяБаза Тогда
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, ID_Узла);
		Иначе
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовСправочников_" + РежимОбмена, ЗначениеНастройки, "");
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Получает массив имен полей номенклатуры Клеверенс, которые используются при выгрузке номенклатуры из 1с
//
// Возвращаемое значение:
//   Массив   - см. ГлЯдро_ПолучитьМассивВыгружаемыхПолейНоменклатурыMS()
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивВыгружаемыхПолейНоменклатурыMS() Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивВыгружаемыхПолейНоменклатурыMS");

	МассивПолейНоменклатуры = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат МассивПолейНоменклатуры;

КонецФункции

// Получает массив имен полей ячеек Клеверенс, которые используются при выгрузке ячеек из 1с
//
// Возвращаемое значение:
//   Массив   - см. ГлЯдро_ПолучитьМассивВыгружаемыхПолейЯчеекMS()
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивВыгружаемыхПолейЯчеекMS() Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьМассивВыгружаемыхПолейЯчеекMS");

	МассивПолей = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат МассивПолей;

КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВыполнитьПроизвольныйКод(ТекстПроизвольногоКода, СтруктураПеременных, ID_ПроизвольногоКода = Неопределено, ИмяПроизвольногоКода)
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьПроизвольныйКод";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТекстПроизвольногоКода,СтруктураПеременных,ID_ПроизвольногоКода,ИмяПроизвольногоКода",
		ТекстПроизвольногоКода, СтруктураПеременных, ID_ПроизвольногоКода, ИмяПроизвольногоКода);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	РезультатСтатус = Истина;
	ТекстОшибки = "";
	
	ВыполняемыйКод = "";
	Для Каждого ИмяПеременной Из СтруктураПеременных Цикл
		ВыполняемыйКод = ВыполняемыйКод + ИмяПеременной.Ключ + " = СтруктураПеременных." + ИмяПеременной.Ключ + ";" + Символы.ВК;
	КонецЦикла;
	ВыполняемыйКод = ВыполняемыйКод + Символы.ВК + ТекстПроизвольногоКода;
	
	Попытка
		Если ID_ПроизвольногоКода = "" Тогда
			//Сюда вставить текст произвольного кода для его отладки, что бы началась отладка, в условие нужно вставить его ID_ПроизвольногоКода
		Иначе
			СтрокаВызова = ВыполняемыйКод;
			СтрокаВызова = СтрЗаменить(СтрокаВызова, "Результат", "Параметры.Результат");
			СтрокаВызова = СтрЗаменить(СтрокаВызова, "СтруктураПеременных", "Параметры.СтруктураПеременных");
			ПараметрыАлгоритма = Новый Структура;
			ПараметрыАлгоритма.Вставить("ТекстОшибки", 			ТекстОшибки);
			ПараметрыАлгоритма.Вставить("СтруктураПеременных", 	СтруктураПеременных);
			ЛокЯдро_ВыполнитьВБезопасномРежиме(СтрокаВызова, ПараметрыАлгоритма);
			ТекстОшибки = ПараметрыАлгоритма.ТекстОшибки;
		КонецЕсли;
	Исключение
		
		// <Лог>
		ИнфоОшибка = ИнформацияОбОшибке();
		ЯзСтрока = "ru = 'Ошибка выполнения произвольного кода %1';
							|en = 'Arbitrary code execution error %1: %2%3'; be = 'Памылка выканання адвольнага кода %1: %2% 3'; es = 'Error al ejecutar código arbitrario %1: %2% 3'; ka = 'თვითნებური კოდის შესრულების შეცდომა %1: %2% 3'; kk = 'Ерікті кодты орындау қатесі %1: %2%3'; ro = 'Eroare de execuție cod arbitrar %1: %2%3'; tr = 'Rastgele kod yürütme hatası %1: %2%3'; uk = 'Помилка виконання довільного коду %1: %2%3'; uz = 'O''zboshimchalik bilan kodni bajarishda xato %1: %2%3'";
		пСообщение = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяПроизвольногоКода);
		
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
			"ИмяПроизвольногоКода",
			ИмяПроизвольногоКода);
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст, ИнфоОшибка);
		// </Лог>
		РезультатСтатус = Ложь;
	КонецПопытки;	
	
	РезультатВыполненияКода = Новый Структура("Статус, Данные", РезультатСтатус, ТекстОшибки);		
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыполненияКода);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатВыполненияКода;
	
КонецФункции

// Представление имени типа документа Клеверенс с пробелами в виде, доступном для использования в 1С
// Пример: "Документ с некорректным именем" преобразуется в "ДокументСНекорректнымИменем"
//
&НаКлиенте
Функция ЛокЯдро_ПреобразованиеНаименованияДокументаБезПробелов(ИмяДокумента)
	
	МассивЭлементовИмени = ЛокЯдро_РазложитьСтрокуВМассивПодстрок(ИмяДокумента, " ");
	Если МассивЭлементовИмени.Количество() = 1 Тогда
		Возврат ИмяДокумента;
	КонецЕсли;
	
	НовоеНаименование = "";
	
	Для Каждого Слово Из МассивЭлементовИмени Цикл
		ПерваяБуква = Лев(Слово, 1);
		ОстальнаяЧастьСлова = Прав(Слово, СтрДлина(Слово) - 1);
		НовоеНаименование = НовоеНаименование + ВРег(ПерваяБуква) + ОстальнаяЧастьСлова;
	КонецЦикла;
	
	Возврат НовоеНаименование;
	
КонецФункции

// Преобразовывает переданную коллекцию в массив.
//
// Параметры:
//	ИсходныеДанные - Структура, Соответствие - Исходная коллекция
//	ПреобразовыватьКлюч - Булево - определяет что именно надо преобразовывать, ключ или значение.
//
// Возвращаемое значение:
//	Массив - ключи или значения переданной коллекции.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЛокЯдро_ПреобразоватьСоответствиеИлиСтруктуруВМассив(ИсходныеДанные, ПреобразовыватьКлюч = Истина) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого КлючИЗначение Из ИсходныеДанные Цикл
		Результат.Добавить(?(ПреобразовыватьКлюч, КлючИЗначение.Ключ, КлючИЗначение.Значение));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьСоответствиеРеквизитовUniДокументаMS(МетаданныеДокументаMS, РасположениеРеквизита = "ШапкаДокумента")
	
	Возврат ЛокЯдро_ПолучитьСоответствиеРеквизитовMS(МетаданныеДокументаMS, РасположениеРеквизита, "Значение", "uni");
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьСоответствиеРеквизитовMS(МетаданныеДокументаMS, РасположениеРеквизита = "ШапкаДокумента", ЧтоСопоставлять = "Значение", ЧемуСопоствить = "")
	
	Если РасположениеРеквизита = "ШапкаДокумента" Тогда
		
		МассивРеквизитов = МетаданныеДокументаMS.Реквизиты;
		
	// дописать поиск реквизитов ТЧ
	КонецЕсли;

	СоответствиеРеквизитов = ЛокЯдро_ПолучитьСоответствиеРеквизитовПоМассивуРеквизитовMS(МассивРеквизитов, ЧтоСопоставлять, ЧемуСопоствить);
	
	Возврат СоответствиеРеквизитов;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьСоответствиеРеквизитовПоМассивуРеквизитовMS(МассивРеквизитов, ЧтоСопоставлять = "Значение", ЧемуСопоствить = "")
	
	СоответствиеРеквизитов = Новый Структура;
	
	Если ЧемуСопоствить = "" Тогда
		Для каждого СтруктураРеквизита Из МассивРеквизитов Цикл		 
			СоответствиеРеквизитов.Вставить(СтруктураРеквизита[ЧтоСопоставлять], СтруктураРеквизита);
		КонецЦикла;
	Иначе
		Для каждого СтруктураРеквизита Из МассивРеквизитов Цикл		 
			СоответствиеРеквизитов.Вставить(СтруктураРеквизита[ЧтоСопоставлять], СтруктураРеквизита[ЧемуСопоствить]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СоответствиеРеквизитов;
	
КонецФункции

