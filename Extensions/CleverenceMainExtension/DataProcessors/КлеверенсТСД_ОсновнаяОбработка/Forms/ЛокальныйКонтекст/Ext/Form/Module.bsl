// Выполняет запись события в журнал регистрации
//
// Параметры:
//	ИмяСобытия - Строка - имя события	
//  УровеньСтрокой - Строка - уровень события строкой
//  Комментарий - Строка - комментарий
//  НачалоСобытия - Неопределено, Число - универсальная дата начала события в миллисекундах
// @logskip
&НаКлиенте 
Процедура ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, УровеньСтрокой, Комментарий, НачалоСобытия = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	// Режимы отладки:
	// "Полный"
	// "ТолькоОшибки", по умолчанию и если режим не задан, то режим "ТолькоОшибки",
	// "БезОтладки", никакая интформация не пишется в ЖР
	РежимОтладки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РежимОтладки");
	Если РежимОтладки = Неопределено ИЛИ РежимОтладки = Ложь Тогда
		РежимОтладки = КэшРежимОтладки;
	Иначе
		КэшРежимОтладки = РежимОтладки;
	КонецЕсли;
	
	АвтотестКлеверенс = КомЯдро_ПолучитьЗначениеПеременной("Автотест");
	Если АвтотестКлеверенс = Неопределено Тогда
		АвтотестКлеверенс = Ложь;
	КонецЕсли;
	
	Если АвтотестКлеверенс И Ложь //Пока закрою этот кусок. Пригодится когда понадобится дублирование записей в ЖР и в лог не только в автотестах 
		И РасположениеКомпоненты = "НаКлиенте" Тогда
		
		ПутьКОбщемуЛогу = КомЯдро_ПолучитьЗначениеПеременной("ПутьКОбщемуЛогу");
		ПутьКЛогуОшибок = КомЯдро_ПолучитьЗначениеПеременной("ПутьКЛогуОшибок");
		
		Если ПутьКОбщемуЛогу <> Неопределено И ПутьКЛогуОшибок <> Неопределено Тогда
			ЛокЯдро_ДобавитьЗаписьВЛог(ПутьКОбщемуЛогу,ИмяСобытия +". "+Комментарий);
			
			Если УровеньСтрокой = "Ошибка" Тогда
				ЛокЯдро_ДобавитьЗаписьВЛог(ПутьКЛогуОшибок,ИмяСобытия +". "+Комментарий);
			КонецЕсли;
		КонецЕсли
	КонецЕсли;
	
	Если РежимОтладки = Неопределено ИЛИ РежимОтладки = Ложь Тогда
		РежимОтладки = ЛокЯдро_ПолучитьЗначениеКэшируемойНастройки("РежимОтладки", "");
		Если РежимОтладки = Неопределено ИЛИ РежимОтладки = Ложь Тогда
			РежимОтладки = "ВсяИнформация";
		КонецЕсли;
		КэшРежимОтладки = РежимОтладки;
	ИначеЕсли РежимОтладки = "БезОтладки" И Не АвтотестКлеверенс Тогда
		Возврат
	КонецЕсли;
		
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "ЗаписатьСобытиеВЖурналРегистрации");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ИмяСобытия, УровеньСтрокой, Комментарий, НачалоСобытия, АдресаПеременных, ДополнительныеПараметры", ИмяСобытия, УровеньСтрокой, Комментарий, НачалоСобытия,АдресаПеременных, ДополнительныеПараметры));
	
	Если (РежимОтладки = "ТолькоОшибки" И УровеньСтрокой = "Ошибка")
		ИЛИ РежимОтладки = "Полный" 
		ИЛИ РежимОтладки = "ВсяИнформация"
		Или УровеньСтрокой = "Предупреждение"
		ИЛИ АвтотестКлеверенс Тогда	
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	Иначе
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

// Получает список отборов используемых бизнес-процессов и их отборов
//
&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокОтборовБизнесПроцесса(ID_БизнесПроцесса) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьСписокОтборовБизнесПроцесса";
	
	// Проверим интерактивные отборы
	ЛокЯдро_ПолучениеОтборовБизнесПроцесса(ИмяСобытия, ID_БизнесПроцесса);
	
	// Проверим онлайн отборы
	ЛокЯдро_ПолучениеОтборовБизнесПроцесса(ИмяСобытия, ID_БизнесПроцесса, Истина);
		
КонецФункции

// Получает список отборов используемых бизнес-процессов и их отборов
//
&НаКлиенте
Функция ЛокЯдро_ПолучениеОтборовБизнесПроцесса(ИмяСобытия, ID_БизнесПроцесса, Онлайн = Ложь)
	
	ИмяСобытия = "ЛокЯдро_ПолучениеОтборовБизнесПроцесса";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИмяСобытия,ID_БизнесПроцесса,Онлайн",
		ИмяСобытия, ID_БизнесПроцесса, Онлайн);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Получение списка отоборов БП
	Если Онлайн Тогда
		НастройкиОтбораБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Онлайн");
	Иначе
		НастройкиОтбораБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_Интерактивный");
	КонецЕсли;
	
	Если НастройкиОтбораБизнесПроцессов <> Ложь Тогда
		
		НастройкиОтбораБП = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтбораБизнесПроцессов, Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса));
		
		Если ТипЗнч(НастройкиОтбораБП) = Тип("Массив") И НастройкиОтбораБП.Количество() Тогда
			
			НастройкиКомпоновкиСтрокой = НастройкиОтбораБП[0].НастройкаКомпоновщикаСтрокой;
			НастройкиКомпоновки = ЛокЯдро_ЗначениеИзСтрокиXML(СтрЗаменить(НастройкиКомпоновкиСтрокой, Символы.ВК, ""));
			
			Если НастройкиКомпоновки <> Неопределено Тогда
				ЭлементыОтбора = НастройкиКомпоновки.Отбор.Элементы;
				Если ЭлементыОтбора.Количество() Тогда
					Если НастройкиОтбораБП[0].Используется Тогда
						ТекстИспользования = " (включены) ";
					Иначе
						ТекстИспользования = " (не включены) ";
					КонецЕсли;
					
					пСообщение = НСтр("ru = '%1 отборы бизнес-процесса %2:';
										|en = '%1 business process selections %2:'; be = '% 1 адборы бізнес-працэсу %2:'; es = '% 1 selecciones de procesos de negocio %2:'; ka = '%1 ბიზნეს პროცესის არჩევანი %2:'; kk = '% 1 бизнес-процесті іріктеу %2:'; ro = '% 1 Procesul de afaceri selecții %2:'; tr = '%1 iş süreci seçimleri %2:'; uk = '% 1 відбір бізнес-процесів %2:'; uz = '%1 biznes jarayonini tanlash %2:'");
					пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ?(Онлайн, "Онлайн", "Интерактивные"), ТекстИспользования);
					ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
					Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл							
						ТекстСобытия = " - " + ЭлементОтбора.ЛевоеЗначение + " " + ЭлементОтбора.ВидСравнения + " " + ЭлементОтбора.ПравоеЗначение;
						ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстСобытия);									
					КонецЦикла;			
				КонецЕсли;     			
			КонецЕсли;	
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НастройкиОтбораБП[0].Используется);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат НастройкиОтбораБП[0].Используется;
			
		Иначе
			
			пСообщение = НСтр("ru = '%1 отборы бизнес-процесса отсутствуют';
								|en = '%1 there are no business process selections'; be = '% 1 адборы бізнес-працэсу адсутнічаюць'; es = '% 1 no hay selecciones de proceso de negocio'; ka = '%1 არ არსებობს ბიზნეს პროცესის შერჩევა'; kk = '% 1 бизнес-процесті іріктеу жоқ'; ro = '%1 nu există selecții ale proceselor de afaceri'; tr = '%1 iş süreci seçimi yok'; uk = '% 1 відбори бізнес-процесу відсутні'; uz = '%1 biznes jarayonini tanlash yo''q'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ?(Онлайн, "Онлайн", "Интерактивные"));
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);			
			
			// <Лог>
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецФункции

// Проверяет корректность передавамого типа метаданных и записывает результат контроля
//
// Параметры:
//  ТипДокумента		- Строка 	- Имя проверяемого объекта метаданных
//  ТаблицаМетаданных	- Строка 	- Имя свойства гл. переменной СтруктураМетаданных ("Документы1С" или "ДокументыMS")
//  МассивИменТипов		- Массив 	- Массив строковых значений, отражающих имена типов документов
//  СтруктураПроверки	- Структура - Структура проверки текущего бизнес-процесса
//  МассивОшибок		- Массив 	- Массив строковых значений, содержащих описание возникших ошибок
//
&НаКлиенте
Процедура ЛокЯдро_ПроверитьКорректностьТипаМетаданных(ТипДокумента, ТаблицаМетаданных, МассивИменТипов, ТекМетаданные, СтруктураПроверки, МассивОшибок)	
	
	Если ЗначениеЗаполнено(ТипДокумента) И МассивИменТипов.Найти(ТипДокумента) = Неопределено Тогда
		Если Не СтруктураМетаданных[ТаблицаМетаданных].Свойство(ТипДокумента, ТекМетаданные) Тогда
			// Документа нет в метаданных
			СторонаВзаимодействия = Прав(ТаблицаМетаданных, 2);
			Если СторонаВзаимодействия = "MS" Тогда
				СтруктураПроверки.Вставить("СтороннийБП", Истина);
			Иначе
				ТекстОшибки = "Документ " + ТипДокумента + " отсутствует в метаданных " + СторонаВзаимодействия;
				
				СтруктураПроверки.ОшибкаМетаданных1С = Истина;
				СтруктураПроверки.ОшибкиМетаданных1С.Добавить(ТекстОшибки);
				
			КонецЕсли;
		Иначе 			
			МассивИменТипов.Добавить(ТипДокумента);
		КонецЕсли;
	ИначеЕсли МассивИменТипов.Найти(ТипДокумента) <> Неопределено Тогда
		// Документ уже был проверен, но переменная текущих метаданных очищается в каждой итерации обхода БП, поэтому заполним ее
		СтруктураМетаданных[ТаблицаМетаданных].Свойство(ТипДокумента, ТекМетаданные);
	КонецЕсли;	
	
КонецПроцедуры

// Проверяет доступность обработчиков загрузки
//
// Параметры:
//  НастройкаБизнесПроцесса			- Структура 	- Структура свойств текущего бизнес-процесса
//  МассивПроверенныхОбработчиков	- Массив 		- Массив уже проверенных методов интеграционной обработки (вне зависимости от бизнес-процесса)
//  СтруктураПроверки				- Структура 	- Структура проверки текущего бизнес-процесса
//  МассивОшибок					- Массив 		- Массив строковых значений, содержащих описание возникших ошибок
//
&НаКлиенте
Процедура ЛокЯдро_ПроверитьДоступностьОбработчиковЗагрузки(НастройкаБизнесПроцесса, МассивПроверенныхОбработчиков, СтруктураПроверки, МассивОшибок)
	
	ИмяСобытия = "ЛокЯдро_ПроверитьДоступностьОбработчиковЗагрузки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкаБизнесПроцесса,МассивПроверенныхОбработчиков,СтруктураПроверки,МассивОшибок",
		НастройкаБизнесПроцесса, МассивПроверенныхОбработчиков, СтруктураПроверки, МассивОшибок);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	МассивОбработчиков = Новый Массив;
	
	МассивТиповОбработчиков = Новый Массив;
	МассивТиповОбработчиков.Добавить("ПередЗаполнениемДокумента");
	МассивТиповОбработчиков.Добавить("ПослеЗаполненияДокумента");
		
	Для Каждого ТипОбработчика Из МассивТиповОбработчиков Цикл
		
		ВидОбработчика 	= "ВидОбработчика_" + ТипОбработчика;
		Обработчик 		= "Обработчик_" + ТипОбработчика;
		
		Если НастройкаБизнесПроцесса.Свойство(ВидОбработчика) Тогда
			Если НастройкаБизнесПроцесса[ВидОбработчика] = 1
				ИЛИ НастройкаБизнесПроцесса[ВидОбработчика] = 2 Тогда			
				МассивОбработчиков.Добавить(НастройкаБизнесПроцесса[Обработчик]);
			КонецЕсли;
		Иначе
			МассивОбработчиков.Добавить(НастройкаБизнесПроцесса[Обработчик]);
		КонецЕсли; 
		
	КонецЦикла;
	
	// Удаление пустых обработчиков из массива
	ЛокЯдро_УдалитьВсеВхожденияЗначенияИзМассива(МассивОбработчиков, "");
	
	// Проверка серверных обработчиков загрузки
	Если МассивОбработчиков.Количество() <> 0 Тогда			
		ЛокЯдро_ПроверкаДоступностиОбработчиковИнтеграционнойОбработки(МассивОбработчиков, МассивПроверенныхОбработчиков, СтруктураПроверки, МассивОшибок);		
	КонецЕсли;
		
	Если НастройкаБизнесПроцесса.Свойство("Обработчик_ПослеОткрытияФормыДокумента") Тогда
		// Проверка клиентских обработчиков загрузки формы
		РезультатПроверки = ЛокЯдро_ПроверитьДоступностьОбработчикаФормы(НастройкаБизнесПроцесса.Обработчик_ПослеОткрытияФормыДокумента);
		Если Не РезультатПроверки.Статус Тогда
			
			СтруктураПроверки.ОшибкаБП = Истина;
			ТекстОшибки = "Обработчик " + НастройкаБизнесПроцесса.Обработчик_ПослеОткрытияФормыДокумента + " не найден в интеграционной обработке";
			МассивОшибок.Добавить(ТекстОшибки);						
			
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Проверяет доступность и корректность произвольных кодов и обработчиков в общем по документу
//
// Параметры:
//  НастройкаБизнесПроцесса			- Структура 	- Структура свойств текущего бизнес-процесса
//  СтруктураПроверки				- Структура 	- Структура проверки текущего бизнес-процесса
//  МассивОшибок					- Массив 		- Массив строковых значений, содержащих описание возникших ошибок
//
&НаКлиенте
Процедура ЛокЯдро_ПроверитьДоступностьИКорректностьПроизвольныхОбработчиков(НастройкаБизнесПроцесса, СтруктураПроверки, МассивОшибок)
	
	ИмяСобытия = "ЛокЯдро_ПроверитьДоступностьИКорректностьПроизвольныхОбработчиков";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкаБизнесПроцесса,СтруктураПроверки,МассивОшибок",
		НастройкаБизнесПроцесса, СтруктураПроверки, МассивОшибок);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Выгрузка
	Если НастройкаБизнесПроцесса.Свойство("ВыполнитьТолькоПроизвольныйКодВыгрузка") И НастройкаБизнесПроцесса.ВыполнитьТолькоПроизвольныйКодВыгрузка = Истина Тогда
		
		Если НастройкаБизнесПроцесса.ТипОбработчикаВыгрузки = 0 Тогда			
			// Произвольный код
			ЛокЯдро_ПроверкаПроизвольногоКодаОбработкиДокумента(НастройкаБизнесПроцесса.ID_ПроизвольногоКода_Выгрузка_Документ, СтруктураПроверки, МассивОшибок);						
		ИначеЕсли НастройкаБизнесПроцесса.ТипОбработчикаВыгрузки = 1 Тогда                                                                                                  			
			// Обработчик
			ЛокЯдро_ПроверкаПроизвольногоОбработчикаДокумента(НастройкаБизнесПроцесса.ОбработчикВыгрузкиДокумента, СтруктураПроверки, МассивОшибок);			            			
		КонецЕсли;
		
	КонецЕсли;
	
	// Загрузка
	Если НастройкаБизнесПроцесса.Свойство("ВыполнитьТолькоПроизвольныйКод") И НастройкаБизнесПроцесса.ВыполнитьТолькоПроизвольныйКод = Истина Тогда
		
		Если НастройкаБизнесПроцесса.ТипОбработчикаЗагрузки = 0 Тогда			
			// Произвольный код
			ЛокЯдро_ПроверкаПроизвольногоКодаОбработкиДокумента(НастройкаБизнесПроцесса.ID_ПроизвольногоКода_Загрузка_Документ, СтруктураПроверки, МассивОшибок, Истина);						
		ИначеЕсли НастройкаБизнесПроцесса.ТипОбработчикаЗагрузки = 1 Тогда                                                                                                  			
			// Обработчик
			ЛокЯдро_ПроверкаПроизвольногоОбработчикаДокумента(НастройкаБизнесПроцесса.Обработчик_ПередЗаполнениемДокумента, СтруктураПроверки, МассивОшибок, Истина);			            			
		КонецЕсли;
		
	КонецЕсли;
			
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Проверяет доступность и корректность произвольного кода
//
// Параметры:
//  ID_ПроизвольногоКода	- Строка 	- Идентификатор текущего произвольного кода
//  СтруктураПроверки		- Структура - Структура проверки текущего бизнес-процесса
//  МассивОшибок			- Массив 	- Массив строковых значений, содержащих описание возникших ошибок
//	ТекстОбластиПроверки	- Строка	- Текстовое описание текущей области проверки (для сообщения об ошибке)
//
&НаКлиенте
Процедура ЛокЯдро_ПроверкаПроизвольногоКодаОбработкиДокумента(ID_ПроизвольногоКода, СтруктураПроверки, МассивОшибок, Загрузка = Ложь, ТекстОбластиПроверки = "")
	 	
	ИмяСобытия = "ЛокЯдро_ПроверкаПроизвольногоКодаОбработкиДокумента";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_ПроизвольногоКода,СтруктураПроверки,МассивОшибок,Загрузка,ТекстОбластиПроверки",
		ID_ПроизвольногоКода, СтруктураПроверки, МассивОшибок, Загрузка, ТекстОбластиПроверки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураОтбора = Новый Структура("ID_ПроизвольногоКода", ID_ПроизвольногоКода);
	
	ПроизвольныеКоды_ПоУмолчанию 		= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_ПоУмолчанию");
	ПроизвольныеКоды_Пользовательские 	= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские");
	
	ПроизвольныеКоды = Новый Массив;
	Если ПроизвольныеКоды_ПоУмолчанию <> Ложь Тогда
		ЛокЯдро_ДополнитьМассив(ПроизвольныеКоды, ПроизвольныеКоды_ПоУмолчанию);
	КонецЕсли;
	
	Если ПроизвольныеКоды_Пользовательские <> Ложь Тогда
		ЛокЯдро_ДополнитьМассив(ПроизвольныеКоды, ПроизвольныеКоды_Пользовательские);
	КонецЕсли;
	
	МассивПроизвольногоКода = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ПроизвольныеКоды, СтруктураОтбора);
	
	Если МассивПроизвольногоКода <> Неопределено И МассивПроизвольногоКода.Количество() Тогда		
		
		ТекстПК = МассивПроизвольногоКода[0].ТекстПроизвольногоКода;
		ИмяПК	= МассивПроизвольногоКода[0].Наименование;
		
		Если Не ЗначениеЗаполнено(ТекстПК) Тогда					
			СтруктураПроверки.ОшибкаБП = Истина;
			ТекстОшибки = "Не заполнено значение произвольного кода " + ?(Загрузка, "загрузки", "выгрузки") + " <" + ИмяПК + "> ";					
			МассивОшибок.Добавить(ТекстОшибки);					
		Иначе
			// Проверка синтаксиса произвольного кода
			РезультатПроверки = ЛокЯдро_ПроверитьСинтакическоеВыполнениеКода(ТекстПК, ИмяПК, ?(Загрузка, "загрузки", "выгрузки"));							
			Если РезультатПроверки.ЕстьОшибки Тогда
				СтруктураПроверки.ОшибкаБП = Истина;
				ТекстОшибки = РезультатПроверки.ТекстОшибки;				
				МассивОшибок.Добавить(ТекстОшибки);		
			КонецЕсли;
		КонецЕсли;		
		
	Иначе                                  		
		
		СтруктураПроверки.ОшибкаБП = Истина;
		ТекстОшибки = "Не найден произвольный код " + ?(Загрузка, "загрузки ", "выгрузки ") + ТекстОбластиПроверки;				
		МассивОшибок.Добавить(ТекстОшибки);		
		
	КонецЕсли;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Проверяет корректность настроек загрузкивыгрузки полей и ТЧ
//
// Параметры:
//  НастройкаБизнесПроцесса			- Структура 	- Структура свойств текущего бизнес-процесса
//  СтрМетаданных			- Структура - Структура, содержащая структуры метаданных документов данного БП:
//			* МетаданныеДокMS 			- Структура
//			* МетаданныеДок1СЗагрузка 	- Структура
//			* МетаданныеДок1СВыгрузка 	- Структура
//  СтруктураПроверки				- Структура 	- Структура проверки текущего бизнес-процесса
//  МассивОшибок					- Массив 		- Массив строковых значений, содержащих описание возникших ошибок
//
&НаКлиенте
Процедура ЛокЯдро_ПроверитьКорректностьНастроекОбработкиПолейИТабличныхЧастей(НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок)
	
	ИмяСобытия = "ЛокЯдро_ПроверитьКорректностьНастроекОбработкиПолейИТабличныхЧастей";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкаБизнесПроцесса,СтрМетаданных,СтруктураПроверки,МассивОшибок",
		НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Выгрузка
	Если (Не НастройкаБизнесПроцесса.Свойство("ВыполнитьТолькоПроизвольныйКодВыгрузка") Или НастройкаБизнесПроцесса.ВыполнитьТолькоПроизвольныйКодВыгрузка = Ложь)
		И ЗначениеЗаполнено(НастройкаБизнесПроцесса.ТипИсходногоДокумента1С) Тогда                                                    				
		
		СтрДокументов = Новый Структура("МетаданныеИсточника, МетаданныеПриемника", СтрМетаданных.МетаданныеДок1СВыгрузка, СтрМетаданных.МетаданныеДокMS); 
		
		ЛокЯдро_ПроверкаКорректностиНастроекТаблицыПолейДокумента(
			НастройкаБизнесПроцесса.НастройкаВыгрузкиПолей, 
			СтрДокументов,
			СтруктураПроверки, 
			МассивОшибок);
				
		ЛокЯдро_ПроверкаКорректностиНастроекТабличныхЧастейДокумента(НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок);
		
	КонецЕсли;
	
	// Загрузка
	Если Не НастройкаБизнесПроцесса.Свойство("ВыполнитьТолькоПроизвольныйКод") Или НастройкаБизнесПроцесса.ВыполнитьТолькоПроизвольныйКод = Ложь Тогда
		
		СтрДокументов = Новый Структура("МетаданныеИсточника, МетаданныеПриемника", СтрМетаданных.МетаданныеДокMS, СтрМетаданных.МетаданныеДок1СЗагрузка);
		
		ЛокЯдро_ПроверкаКорректностиНастроекТаблицыПолейДокумента(
			НастройкаБизнесПроцесса.НастройкаЗагрузкиПолей,
			СтрДокументов,
			СтруктураПроверки, 
			МассивОшибок,
			Истина);	
		
		ЛокЯдро_ПроверкаКорректностиНастроекТабличныхЧастейДокумента(НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок, Истина);
			
	КонецЕсли;
			
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Проверяет корректность настроек выгрузки/загрузки табличных полей документа бизнес-процесса
//
// Параметры:
//  НастройкиПолей			- Массив 	- Массив соответствий конвертируемых реквизитов
//	СтрДокументов			- Структура - Структура из метаданных источника и приемника данной настройки БП
//  СтруктураПроверки		- Структура - Структура проверки текущего бизнес-процесса
//  МассивОшибок			- Массив 	- Массив строковых значений, содержащих описание возникших ошибок
//  Загрузка				- Булево 	- Признак направления обработчика
//
&НаКлиенте
Процедура ЛокЯдро_ПроверкаКорректностиНастроекТаблицыПолейДокумента(НастройкиПолей, СтрДокументов, СтруктураПроверки, МассивОшибок, Загрузка = Ложь, ОбластьПроверки = "")
	
	ИмяСобытия = "ЛокЯдро_ПроверкаКорректностиНастроекТаблицыПолейДокумента";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкиПолей,СтрДокументов,СтруктураПроверки,МассивОшибок,Загрузка,ОбластьПроверки",
		НастройкиПолей, СтрДокументов, СтруктураПроверки, МассивОшибок, Загрузка, ОбластьПроверки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Загрузка Тогда
		РеквизитИсточника = "РеквизитMS";
		РеквизитПриемника = "Реквизит1С";
	Иначе
		РеквизитИсточника = "Реквизит1С";
		РеквизитПриемника = "РеквизитMS";
	КонецЕсли;
	
	Если ПустаяСтрока(ОбластьПроверки) Тогда
		ТекстОбластиПроверки = "в шапке документа" + ?(Загрузка, " настроек загрузки", " настроек выгрузки");
	Иначе
		ТекстОбластиПроверки = "в ТЧ <" + ОбластьПроверки + "> документа" + ?(Загрузка, " настроек загрузки", " настроек выгрузки");
	КонецЕсли;
	
	Если ТипЗнч(НастройкиПолей) = Тип("Массив") Тогда
		
		Для Каждого НастройкаПолей Из НастройкиПолей Цикл
			
			Если НастройкаПолей.Свойство("ЭтоТаблицаЗначений") И НастройкаПолей.ЭтоТаблицаЗначений Тогда
				Продолжить;
			КонецЕсли;
			
			// Проверка корректности полей источника
			Если НастройкаПолей.ТипИсточника = РеквизитИсточника Тогда					
				Если НастройкаПолей.ТипИсточника = НастройкаПолей.ТипИсточникаСиноним Тогда
					ТекстОшибки = "Некорретное отображение типа источника для строки приемника <" + НастройкаПолей.ИмяПриемника + "> " + ТекстОбластиПроверки +
						". Возможны проблемы при сопоставлении данных";
					СтруктураПроверки.ОшибкаБП = Истина;
					МассивОшибок.Добавить(ТекстОшибки);	
				Иначе
					
					ЛокЯдро_ПроверкаКорректностиПолейНастроекНаПринадлежностьМетаданным(
						СтрДокументов.МетаданныеИсточника,
						РеквизитИсточника,
						НастройкаПолей.ИмяИсточника,
						НастройкаПолей,
						СтруктураПроверки,
						МассивОшибок,
						ТекстОбластиПроверки,
						ОбластьПроверки);		
				КонецЕсли;

			ИначеЕсли НастройкаПолей.ТипИсточника = "ПроизвольныйКод" Тогда                                         										
				// На заполненость и синтаксический контроль
				ID_ПроизвольногоКода = ?(ЗначениеЗаполнено(НастройкаПолей.ЗначениеИсточника), НастройкаПолей.ЗначениеИсточника, НастройкаПолей.ИмяИсточника);				
				ЛокЯдро_ПроверкаПроизвольногоКодаОбработкиДокумента(ID_ПроизвольногоКода, СтруктураПроверки, МассивОшибок, Загрузка, ТекстОбластиПроверки);	
				
			ИначеЕсли НастройкаПолей.ТипИсточника = "ПроизвольноеЗначение" Тогда                                                        					
				// На заполненность значения
				НеЗаполненоИсЗначение 			= Не НастройкаПолей.Свойство("ИсЗначение") Или Не ЗначениеЗаполнено(НастройкаПолей.ИсЗначение);
				НеЗаполненоЗначениеИсточника 	= Не НастройкаПолей.Свойство("ЗначениеИсточника") Или Не ЗначениеЗаполнено(НастройкаПолей.ЗначениеИсточника);				
				Если НеЗаполненоИсЗначение И НеЗаполненоЗначениеИсточника Тогда						
					ТекстОшибки = "Не заполнено произвольное значение для строки приемника <" + НастройкаПолей.ИмяПриемника + "> " + ТекстОбластиПроверки;
					СтруктураПроверки.ОшибкаБП = Истина;
					МассивОшибок.Добавить(ТекстОшибки);							
				КонецЕсли;
				
			ИначеЕсли НастройкаПолей.ТипИсточника = "ГлобальныйПараметр" Тогда                                                         					
				// На заполненность и наличие в базе
				НеЗаполненоИсЗначение 			= Не НастройкаПолей.Свойство("ИсЗначение") Или Не ЗначениеЗаполнено(НастройкаПолей.ИсЗначение);
				НеЗаполненоЗначениеИсточника 	= Не НастройкаПолей.Свойство("ЗначениеИсточника") Или Не ЗначениеЗаполнено(НастройкаПолей.ЗначениеИсточника);				
				Если НеЗаполненоИсЗначение И НеЗаполненоЗначениеИсточника Тогда						
					ТекстОшибки = "Не заполнен глобальный параметр для строки приемника <" + НастройкаПолей.ИмяПриемника + "> " + ТекстОбластиПроверки;
					СтруктураПроверки.ОшибкаБП = Истина;
					МассивОшибок.Добавить(ТекстОшибки);							
				КонецЕсли;
				
			Иначе
				ТекстОшибки = "Указан некорретный тип источника <" + НастройкаПолей.ИмяИсточника + "> " + ТекстОбластиПроверки;
					СтруктураПроверки.ОшибкаБП = Истина;
					МассивОшибок.Добавить(ТекстОшибки);									
			КонецЕсли;
			
			// Проверка наличия полей приемника
			Если НастройкаПолей.ТипПриемника = РеквизитПриемника Тогда
				Если НастройкаПолей.ТипПриемника = НастройкаПолей.ТипПриемникаСиноним Тогда
					ТекстОшибки = "Некорретное отображение типа приемника для строки приемника <" + НастройкаПолей.ИмяПриемника + "> " + ТекстОбластиПроверки +
						". Возможны проблемы при сопоставлении данных";
					СтруктураПроверки.ОшибкаБП = Истина;
					МассивОшибок.Добавить(ТекстОшибки);	
				Иначе				
					ЛокЯдро_ПроверкаКорректностиПолейНастроекНаПринадлежностьМетаданным(
						СтрДокументов.МетаданныеПриемника,
						РеквизитПриемника,
						НастройкаПолей.ИмяПриемника,
						НастройкаПолей,
						СтруктураПроверки,
						МассивОшибок,
						ТекстОбластиПроверки,
						ОбластьПроверки);		
				КонецЕсли;     
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вспомогательная обработка
//
&НаКлиенте
Процедура ЛокЯдро_ПроверкаКорректностиПолейНастроекНаПринадлежностьМетаданным(ТекМетаданные, ТекРеквизит, ИмяРеквизита, НастройкаПолей, СтруктураПроверки, МассивОшибок, ТекстОбластиПроверки, ОбластьПроверки)
	
	КлючСвязиВИмени 	= НастройкаПолей.ИмяИсточника = "КлючСвязи" Или НастройкаПолей.ИмяПриемника = "КлючСвязи";
	КлючСвязиВЗначении 	= НастройкаПолей.Свойство("ИсЗначение") И Найти(НастройкаПолей.ИсЗначение, "Ключ связи") > 0;
	Если КлючСвязиВИмени Или КлючСвязиВЗначении Тогда
		// Ключи связи не являются реквизитами метаданных, пропускаем их
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ОбластьПроверки) Тогда
		МассивРеквизитов = ТекМетаданные.Реквизиты;
	ИначеЕсли ТекРеквизит = "РеквизитMS" Тогда  					
		МассивРеквизитов = ТекМетаданные.РеквизитыТЧ;					
	Иначе 
		МассивРеквизитов = ТекМетаданные.ТабличныеЧасти[ОбластьПроверки].Реквизиты					
	КонецЕсли;	                               				
	
	ЛокЯдро_ПроверитьНаличиеРеквизита(ИмяРеквизита, МассивРеквизитов, СтруктураПроверки, МассивОшибок, ТекстОбластиПроверки, ТекРеквизит);					
	
КонецПроцедуры

// Проверяет корректность настроек выгрузки/загрузки шапки документа бизнес-процесса
//
// Параметры:
//  НастройкаБизнесПроцесса	- Структура - Структура свойств текущего бизнес-процесса
//  СтрМетаданных			- Структура - Структура, содержащая структуры метаданных документов данного БП:
//			* МетаданныеДокMS 			- Структура
//			* МетаданныеДок1СЗагрузка 	- Структура
//			* МетаданныеДок1СВыгрузка 	- Структура
//  СтруктураПроверки		- Структура - Структура проверки текущего бизнес-процесса
//  МассивОшибок			- Массив 	- Массив строковых значений, содержащих описание возникших ошибок
//  Загрузка				- Булево 	- Признак направления обработчика
//
&НаКлиенте
Процедура ЛокЯдро_ПроверкаКорректностиНастроекТабличныхЧастейДокумента(НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок, Загрузка = Ложь)
	
	ИмяСобытия = "ЛокЯдро_ПроверкаКорректностиНастроекТабличныхЧастейДокумента";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкаБизнесПроцесса,СтрМетаданных,СтруктураПроверки,МассивОшибок,Загрузка",
		НастройкаБизнесПроцесса, СтрМетаданных, СтруктураПроверки, МассивОшибок, Загрузка);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Загрузка Тогда
		НастройкиТЧ 		= НастройкаБизнесПроцесса.НастройкаЗагрузкиТЧ;
		Метаданные1С 		= СтрМетаданных.МетаданныеДок1СЗагрузка;
		МетаданныеИсточника = СтрМетаданных.МетаданныеДокMS;		
		МетаданныеПриемника = СтрМетаданных.МетаданныеДок1СЗагрузка;
	Иначе
		НастройкиТЧ 		= НастройкаБизнесПроцесса.НастройкаВыгрузкиТЧ;
		Метаданные1С 		= СтрМетаданных.МетаданныеДок1СВыгрузка;
		МетаданныеИсточника = СтрМетаданных.МетаданныеДок1СВыгрузка;		
		МетаданныеПриемника = СтрМетаданных.МетаданныеДокMS;
	КонецЕсли; 	
	
	Если ТипЗнч(НастройкиТЧ) = Тип("Массив") Тогда
		
		Для Каждого НастройкаТЧ Из НастройкиТЧ Цикл
			
			Если НастройкаТЧ.Свойство("ЭтоТаблицаЗначений") И НастройкаТЧ.ЭтоТаблицаЗначений Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяТабличнойЧасти1С = НастройкаТЧ.НастройкаТЧСтрокой;
			ИмяТабличнойЧастиMS = НастройкаТЧ.ТабличнаяЧастьДокументаMS;
			
			Если Не Загрузка Тогда
				ТекстЗапросаВыгрузкиНаТСД = НастройкаТЧ.ТекстЗапросаВыгрузкиНаТСД;
			КонецЕсли;			
			
			Если Найти(ИмяТабличнойЧасти1С, "Запрос") Тогда
				
				Если Не Загрузка И ЗначениеЗаполнено(ТекстЗапросаВыгрузкиНаТСД) Тогда
					
					ЛокЯдро_ПроверкаКорректностиНастроекЗапросаВыгрузкиТабличнойЧасти(ТекстЗапросаВыгрузкиНаТСД, НастройкаТЧ, Метаданные1С.Имя, СтруктураПроверки, МассивОшибок);
					
				КонецЕсли;	
				
			ИначеЕсли ЗначениеЗаполнено(Метаданные1С) И ЗначениеЗаполнено(ИмяТабличнойЧасти1С) Тогда
				
				МетаданныеТабличнойЧасти1С = Неопределено;
				
				Если Не Метаданные1С.ТабличныеЧасти.Свойство(ИмяТабличнойЧасти1С, МетаданныеТабличнойЧасти1С) Тогда
					
					// Если не найденная ТЧ является программно добавляемой ТЧ для маркировок, то пропускаем, 
					// оборачиваю в попытку на случай отсутствия процедуры в ИО
					Попытка
						
						Результат = ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(Метаданные1С.Имя);	
												
						Если Результат <> Неопределено И Результат[ИмяТабличнойЧасти1С] <> Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						ТекстОшибки = "Не найдена табличная часть <" + ИмяТабличнойЧасти1С + "> документа 1С <" + Метаданные1С.Имя + ">";
						СтруктураПроверки.ОшибкаБП = Истина;
						МассивОшибок.Добавить(ТекстОшибки);
					Исключение
						ТекстОшибки = "Не найдена табличная часть <" + ИмяТабличнойЧасти1С + "> документа 1С <" + Метаданные1С.Имя + ">";
						СтруктураПроверки.ОшибкаБП = Истина;
						МассивОшибок.Добавить(ТекстОшибки);
					КонецПопытки;
					
				Иначе
					// Проверка реквизитов ТЧ
					ТабличнаяЧастьДокумента1С = Неопределено;
					Если НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1С") Тогда
						ТабличнаяЧастьДокумента1С = НастройкаТЧ.ТабличнаяЧастьДокумента1С;
					ИначеЕсли НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						ТабличнаяЧастьДокумента1С = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаТЧ.ТабличнаяЧастьДокумента1ССтрокой, Истина);
					КонецЕсли;					
					
					Если ТабличнаяЧастьДокумента1С <> Неопределено Тогда
						
						СтрДокументов = Новый Структура("МетаданныеИсточника, МетаданныеПриемника", МетаданныеИсточника, МетаданныеПриемника); 
						ЛокЯдро_ПроверкаКорректностиНастроекТаблицыПолейДокумента(ТабличнаяЧастьДокумента1С, СтрДокументов, СтруктураПроверки, МассивОшибок, Загрузка, НастройкаТЧ.НастройкаТЧСтрокой);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;    				
			
		КонецЦикла;
		
	КонецЕсли;

	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаСервере
Процедура ЛокЯдро_ПроверкаКорректностиНастроекЗапросаВыгрузкиТабличнойЧасти(ТекстЗапросаВыгрузкиНаТСД, НастройкаТЧ, ТипДокумента1С, СтруктураПроверки, МассивОшибок)
	
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапросаВыгрузкиНаТСД, "¶", ""));
	Запрос.УстановитьПараметр("Ссылка", Документы[ТипДокумента1С].ПустаяСсылка());
	
	ЕстьОшибки = Ложь;
	
	ПараметрыЗапроса = Новый Структура;
	// Проверяем корректность заполненного кода по параметрам запроса
	Попытка
		Если НастройкаТЧ.Свойство("ТекстКодаПолучениеПараметров") И Не ПустаяСтрока(НастройкаТЧ.ТекстКодаПолучениеПараметров) Тогда
			//Выполнить(СтрЗаменить(НастройкаТЧ.ТекстКодаПолучениеПараметров, "ДокументДляВыгрузки", "Документы[ТипДокумента1С].ПустаяСсылка()"));
			СтрокаВызова = НастройкаТЧ.ТекстКодаПолучениеПараметров;
			СтрокаВызова = СтрЗаменить(СтрокаВызова, "ДокументДляВыгрузки", "Документы[""" + ТипДокумента1С + """].ПустаяСсылка()");
			ПараметрыАлгоритма = Новый Структура;
			ПараметрыАлгоритма.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
			ПараметрыЗапроса = ЛокЯдро_ВыполнитьКодПолученияПараметровЗапроса(СтрокаВызова, ПараметрыАлгоритма);
			Если ПараметрыЗапроса.Количество() Тогда
				Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
					Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);	
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;
	Исключение
		ЕстьОшибки = Истина;
		ТекстОшибки = "Ошибка инициализации параметров запроса для выгрузки табличной части документа 1С" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СтруктураПроверки.ОшибкаБП = Истина;
		МассивОшибок.Добавить(ТекстОшибки);		
	КонецПопытки;
	
	// Если параметры проверены, переходим к проверке корректности заполненного текста запроса, в противном случае смысла нет
	Если Не ЕстьОшибки Тогда	                                                                                             	
		Попытка
			РезультатЗапроса = Запрос.Выполнить();		
		Исключение
			ТекстОшибки = "Ошибка выполнения запроса для выгрузки табличной части документа 1С:" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СтруктураПроверки.ОшибкаБП = Истина;
			МассивОшибок.Добавить(ТекстОшибки);		
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, существует ли объект метаданных
//
// Параметры:
//  ПолноеИмя  - Строка - полное имя объекта метаданных (например, Справочник.Номенклатура, Документ.ПриемНаРаботу.)
//
// Возвращаемое значение:
//   Булево   - признак наличия объекта метаданных
//
&НаКлиенте
Функция ЛокЯдро_ПроверитьОбъектМетаданныхСуществует(ПолноеИмя) Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПроверитьОбъектМетаданныхСуществует");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПолноеИмя", ПолноеИмя);
	СтруктураВызова.Вставить("ПараметрыМетода", СтруктураПараметров);
	
	РезультатПроверки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат РезультатПроверки;

КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ПоместитьФайлВнешнейОбработки(ДополнительныеПараметры, ДопПараметр = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_ПоместитьФайлВнешнейОбработки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры,ДопПараметр",
		ДополнительныеПараметры, ДопПараметр);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ЭтоВнешняяОбработка = ЛокЯдро_ЭтоВнешняяОбработка();
		Если ЭтоВнешняяОбработка Тогда
			ФайлОбработки = Новый Файл(ИспользуемоеИмяФайла);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществования",
				ЭтаФорма, ДополнительныеПараметры);
			ФайлОбработки.НачатьПроверкуСуществования(ОписаниеОповещения);
		Иначе
			ЛокЯдро_НачатьВыполнениеФоновогоЗаданияПродолжение(ДополнительныеПараметры);
		КонецЕсли;
	#КонецЕсли	

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществования(ФайлСуществует, ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществования";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ФайлСуществует,ДополнительныеПараметры",
		ФайлСуществует, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ФайлСуществует И
			Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
			// Если после актуализации ОО основная обработка не отлаживается, то значит, что
			// в процессе актуализации создалась и подключилась идентичная ОО под тем же именем, 
			// поэтому весь код выполняется из обработки из справочника.
			// В этом случае для работы ФЗ необходим заполненный реквизит ОбъектСсылка
			ЛокЯдро_ЗаполнитьСсылкуНаОбъект();	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ХранениеФайлаОбработки) Тогда
			// Значение теряется после 20 минут. Проверка, что файл существует
			ФайлОбработкиНаСервере = Новый Файл(ХранениеФайлаОбработки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществованияНаСервере",
				ЭтаФорма, ДополнительныеПараметры);
			ФайлОбработкиНаСервере.НачатьПроверкуСуществования(ОписаниеОповещения);
		Иначе
			ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществованияНаСервере(Ложь, ДополнительныеПараметры);
		КонецЕсли;
	#КонецЕсли

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществованияНаСервере(ФайлСуществует, ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ЛокЯдро_ПоместитьФайлВнешнейОбработкиПослеПроверкиСуществованияНаСервере";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ФайлСуществует,ДополнительныеПараметры",
		ФайлСуществует, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ФайлСуществует Тогда
			// Очистка пути для последующего перепомещения файла
			ХранениеФайлаОбработки = "";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбъектСсылка) И
			Не ЗначениеЗаполнено(ХранениеФайлаОбработки) Тогда
			
			ПутьВоВременномХранилище = "";
			ОписаниеОповещения = Новый ОписаниеОповещения("ЛокЯдро_ПоместитьФайлВнешнейОбработкиЗавершение", ЭтаФорма, ДополнительныеПараметры);
			НачатьПомещениеФайла(ОписаниеОповещения,,
				ИспользуемоеИмяФайла, Ложь, УникальныйИдентификатор);
		Иначе
			ЛокЯдро_НачатьВыполнениеФоновогоЗаданияПродолжение(ДополнительныеПараметры);	
		КонецЕсли;
	#КонецЕсли

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПоместитьФайлВнешнейОбработкиЗавершение(Результат, АдресФайла, ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	ХранениеФайлаОбработки = ЛокЯдро_КопияФайлаНаСервере(АдресФайла);
	
	ЛокЯдро_НачатьВыполнениеФоновогоЗаданияПродолжение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЛокЯдро_КопияФайлаНаСервере(Хранение)

	Результат = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Хранение);
	ДвоичныеДанные.Записать(Результат);
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЛокЯдро_ЭтоВнешняяОбработка()
	
	ПолноеИмя = "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Попытка
			ПолноеИмя = ЭтаФорма.ОбъектСсылка.Метаданные().ПолноеИмя();
		Исключение
		КонецПопытки;
	#Иначе
		ПолноеИмя = ПолноеИмяОбъекта;
	#КонецЕсли
	
	Если НЕ ПустаяСтрока(ПолноеИмя) Тогда
		ЧастиИмени = ЛокЯдро_СтрРазделитьНаСервере(ПолноеИмя, ".");
		Возврат ВРег(ЧастиИмени[0]) = "ВНЕШНЯЯОБРАБОТКА" или ВРег(ЧастиИмени[0]) = "EXTERNALDATAPROCESSOR";
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЛокЯдро_ПрочитатьТекстФайлаНаСервере(ПутьКФайлу)

	Файл = Новый ЧтениеТекста(ПутьКФайлу);
	Текст = Файл.Прочитать();
	Файл.Закрыть();
	
	Возврат Текст;

КонецФункции

&НаКлиенте
Процедура ЛокЯдро_СкопироватьНастройкиПодключенияДругимПользователям1С(СписокПользователей) Экспорт
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("СписокПользователей", СписокПользователей.Пользователи);
	ПараметрыМетода.Вставить("НаборыТокенов",		ЛокЯдро_ПолучитьТокеныДляДругихПользователей1С(СписокПользователей.Пользователи));
	ПараметрыМетода.Вставить("КопироватьПрава", СписокПользователей.КопироватьПрава);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "СкопироватьНастройкиПодключенияДругимПользователям1С");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьТокеныДляДругихПользователей1С(СписокПользователей, ТипБазы = "Основная")

	ИмяСобытия = "ЛокЯдро_ПолучитьТокеныДляДругихПользователей1С";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СписокПользователей,ТипБазы",
		СписокПользователей, ТипБазы);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// При подключении с сервера токены будут получены на сервере
	Если РасположениеКомпоненты = "НаСервере" Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
	Если ЕстьЧастнаяБаза = Истина Тогда
		ТипБазы = "Частная";
	КонецЕсли;
	
	ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);
	Если НЕ ТипИнтерфейса = "REST_API" Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	ПолучитьНаборыТокенов = ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
		И ПараметрыПодключенияMS.Свойство("АвторизацияВключена")
		И ПараметрыПодключенияMS.АвторизацияВключена = Истина;
		
	Если НЕ ПолучитьНаборыТокенов Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;	
	
	// Получаем настройки подключения (тип интерфейса не проверяем, т.к. при подключении по COM не могла быть выполнена авторизация по темпуид)
	Если ТипБазы = "Частная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияЧастнойБазыMS";
	ИначеЕсли ТипБазы = "Временная" Тогда
		КлючПеременной = "REST_API_СтруктураПодключенияВременнойБазыMS";
	Иначе
		КлючПеременной = "REST_API_СтруктураПодключенияБазыMS";
	КонецЕсли;
	
	СтруктураПодключения = КомЯдро_ПолучитьЗначениеПеременной(КлючПеременной);
	
	Если СтруктураПодключения = Неопределено Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецЕсли;
	
	НаборыТокенов = Новый Соответствие;
	Для каждого Пользователь ИЗ СписокПользователей Цикл
		
		// BaseInfo получаем для каждого пользователя, чтобы был сгенерирован новый темпуид
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("HTTPМетод", 	"GET");
		СтруктураЗапроса.Вставить("Метод", 		"BaseInfo");
		СтруктураЗапроса.Вставить("ТипЗапроса", "ПолучениеМетаданных");
		
		СтруктураОтвета = REST_API_ВыполнитьМетод(СтруктураПодключения, СтруктураЗапроса,, АдресаПеременных);
		
		ОтветСервера = Неопределено;
		Если НЕ REST_API_КодСостоянияУспешно(СтруктураОтвета.КодСостояния) ИЛИ НЕ СтруктураОтвета.Свойство("ОтветСервера", ОтветСервера) Тогда
			ТекстОшибки = НСтр("ru = 'Произошла ошибка при подключении к базе Клеверенс. Подробности см. в журнале регистрации';
								|en = 'An error occurred when connecting to the Cleverence database. For details, see in the registration log';
								|be = 'Адбылася памылка пры падключэнні да базы Cleverence. Падрабязнасці гл. у часопісе рэгістрацыі'; es = 'Se ha producido un error al conectarse a la base de Cleverence. Consulte el registro para obtener más detalles'; ka = 'შეცდომა მოხდა Cleverence მონაცემთა ბაზასთან დაკავშირებისას. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში'; kk = 'Cleverence базасына қосылу кезінде қате пайда болды. Толық ақпаратты тіркеу журналынан қараңыз'; ro = 'A apărut o eroare la conectarea la baza de date Cleverence. Consultați jurnalul de înregistrare pentru detalii'; tr = 'Cleverence veritabanına bağlanırken bir hata oluştu. Ayrıntılar için kayıt defterine bakın'; uk = 'Сталася помилка при підключенні до бази Cleverence. Подробиці див. в журналі реєстрації'; uz = 'Cleverence ma''lumotlar bazasiga ulanishda xato yuz berdi. Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang'");
			
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("ТекстСообщения", ТекстОшибки);
			
			REST_API_ЗаписатьОшибкуВЖурналРегистрации(ИмяСобытия, СтруктураЗапроса, СтруктураОтвета, ПараметрыЗаписи);
			Прервать;
		КонецЕсли;
		
		Темпуид = "";
		
		allConnectionStrings = ОтветСервера.Получить("allConnectionStrings");
		Если ТипЗнч(allConnectionStrings) = Тип("Массив") Тогда
			Для каждого ConnectionString ИЗ allConnectionStrings Цикл
				ПозицияСтрокиПоиска = ЛокЯдро_СтрНайти(ConnectionString, "tempuid=");
				Если ПозицияСтрокиПоиска Тогда
					Темпуид	= Сред(ConnectionString, ПозицияСтрокиПоиска + 8);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ПустаяСтрока(Темпуид) Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось получить tempuid из строки подключения';
								|en = 'Couldn''t get tempuid from connection string'; be = 'Не атрымалася атрымаць tempuid з радка падлучэння'; es = 'No se pudo obtener el tempuid de la cadena de conexión'; ka = 'ვერ tempuid კავშირი სიმებიანი'; kk = 'Қосылу жолынан tempuid алу мүмкін болмады'; ro = 'Nu s-a putut obține tempuid din șirul de conexiune'; tr = 'Bağlantı dizesinden tempuıd alınamadı'; uk = 'Не вдалося отримати tempuid з рядка підключення'; uz = 'Tempuidni ulanish satridan olish mumkin emas'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока);
			// </Лог>
			Прервать;
		КонецЕсли;
		
		ДанныеТокена = ЛокЯдро_ПолучитьТокенSMARTS(СтруктураПодключения, "__tempuid__", Темпуид, ТипБазы, ТипИнтерфейса, РасположениеКомпоненты, Ложь);
		
		Если ТипЗнч(ДанныеТокена) = Тип("Структура") Тогда
			НаборТокенов = Новый Структура;
			НаборТокенов.Вставить("АвторизацияТокен", 		ДанныеТокена.Access_token);
			НаборТокенов.Вставить("АвторизацияРефрешТокен", ДанныеТокена.Refresh_token);
			
			НаборыТокенов.Вставить(Пользователь.Значение, НаборТокенов);
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", НаборыТокенов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат НаборыТокенов;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_СтрокиПодключенияСовпадают(СтрокаПодключения1, СтрокаПодключения2) Экспорт
	
	// Для строк clgt сравниваем только идентификаторы баз Клеверенс, т.к. может быть редирект
	Если ЛокЯдро_СтрНайти(СтрокаПодключения1, "clgt") ИЛИ ЛокЯдро_СтрНайти(СтрокаПодключения2, "clgt") Тогда
		СтруктураURI1 = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения1);
		СтруктураURI2 = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения2);
		
		СтрокиПодключенияСовпадают = СтруктураURI1.ПутьНаСервере = СтруктураURI2.ПутьНаСервере;
	Иначе
		СтрокиПодключенияСовпадают = СтрокаПодключения1 = СтрокаПодключения2;
	КонецЕсли;
	
	Возврат СтрокиПодключенияСовпадают;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновитьФункциональныеПараметры1СВБазеMS() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновитьФункциональныеПараметры1СВБазеMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция"); 
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьФункциональныеПараметры1С");
		
	ФункциональныеПараметры = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		
	Если ФункциональныеПараметры = Неопределено ИЛИ ФункциональныеПараметры.Количество() = 0 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СохраненныеНастройки = ТекущиеНастройкиMS;
	
	пНастройкиИнициализированы = НЕ (СохраненныеНастройки = Неопределено ИЛИ СохраненныеНастройки = Ложь);
	Если НЕ пНастройкиИнициализированы Тогда
		СохраненныеНастройки = ЛокЯдро_СкопироватьСтруктуру(ФункциональныеПараметры);
		Для каждого ФункциональныйПараметр ИЗ СохраненныеНастройки Цикл
			СохраненныеНастройки.Вставить(ФункциональныйПараметр.Ключ, Ложь); // сбрасываем значение на значение по умолчанию
		КонецЦикла;
		СохраненныеНастройки = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СохраненныеНастройки);
		
	КонецЕсли;	
	
	НастройкиКПолучению = Новый Структура;
	Для каждого КЗ Из ФункциональныеПараметры Цикл
		Если НЕ СохраненныеНастройки.Свойство(КЗ.Ключ) Тогда
			НастройкиКПолучению.Вставить(КЗ.Ключ, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкиКПолучению.Количество() > 0 Тогда
		НастройкиКПолучению = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению);
		Для каждого КЗ Из НастройкиКПолучению Цикл
			СохраненныеНастройки.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// удаляем не измененные настройки
	Для каждого КЗ Из ФункциональныеПараметры Цикл
		ТекущееЗначение = Неопределено;
		Если СохраненныеНастройки.Свойство(КЗ.Ключ, ТекущееЗначение) и ТекущееЗначение = КЗ.Значение Тогда
			ФункциональныеПараметры.Удалить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если ФункциональныеПараметры.Количество() > 0 Тогда
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(ФункциональныеПараметры);
		
		Если пНастройкиИнициализированы Тогда
			ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(ФункциональныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS");
		
		РезультатПроверки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		// Актуализация переменной модуля ТекущиеНастройкиMS
		Если ТипЗнч(ТекущиеНастройкиMS) <> Тип("Структура") Тогда
			ТекущиеНастройкиMS = Новый Структура;
		КонецЕсли;
		
		Для каждого ДанныеНастройки ИЗ РезультатПроверки Цикл
			ТекущиеНастройкиMS.Вставить(ДанныеНастройки.Ключ, ДанныеНастройки.Значение);
		КонецЦикла;
		
		Результат = РезультатПроверки.Количество() > 0;
	Иначе
		Результат = ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMSНаКлиенте();
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMSНаКлиенте()

	Перем UnavailableDocuments;
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMSНаКлиенте";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	ДокументыMS = Неопределено;
	Если НЕ ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		ИЛИ НЕ СтруктураМетаданных.Свойство("ДокументыMS", ДокументыMS) Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS", Ложь);
	
	ID_ТекущегоУзла = "";
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		Если ПараметрыПодключенияMS.Свойство("УровеньПриложенияСтрокой") И ПараметрыПодключенияMS.УровеньПриложенияСтрокой = "Минимум" Тогда
			UnavailableDocuments = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("UnavailableDocuments");
		КонецЕсли;
	КонецЕсли;
	
	ПроверятьДостуностьБизнесПроцессов = ТипЗнч(UnavailableDocuments) = Тип("Массив");
	
	ОтключаемыеБизнесПроцессы = Новый Массив;
	ИзмененныеБизнесПроцессы = Новый Массив;
	НедоступныеБизнесПроцессы = Новый Массив;
	
	СтруктураНастроек_ПоУмолчанию 		= ЛокЯдро_ПолучитьИзКэшаСтруктуруНастроекПоУмолчаниюБизнесПроцессов();
	СтруктураНастроек_Пользовательские	= ЛокЯдро_ПолучитьИзКэшаСтруктуруПользовательскихНастроекБизнесПроцессов();
	
	НастройкиБизнесПроцессов_ПоУмолчанию		= СтруктураНастроек_ПоУмолчанию.НастройкиБизнесПроцессов;
	НастройкиБизнесПроцессов_Пользовательские 	= СтруктураНастроек_Пользовательские.НастройкиБизнесПроцессов;
	
	// Настройки _ПоУмолчанию для главного узла
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию);		
		КонецЕсли;		
			
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ОтключитьБизнесПроцесс = Ложь;
			
			Если ЗначениеЗаполнено(СтрокаБП.ТипДокументаMS)
				И НЕ ДокументыMS.Свойство(СтрокаБП.ТипДокументаMS) Тогда
				ОтключитьБизнесПроцесс = Истина;
			КонецЕсли;
			
			Если ПроверятьДостуностьБизнесПроцессов И ЗначениеЗаполнено(СтрокаБП.ТипРезультирующегоДокумента1С) Тогда
				Если НЕ UnavailableDocuments.Найти(СтрокаБП.ТипРезультирующегоДокумента1С) = Неопределено Тогда
					НедоступныеБизнесПроцессы.Добавить(
						СтрокаБП.ID_БизнесПроцесса);
					ОтключитьБизнесПроцесс = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ОтключитьБизнесПроцесс Тогда
				СтруктураБизнесПроцесса = Новый Структура("ID_БизнесПроцесса, Название, Используется, ТипДокументаMS, Типовой");
				ЗаполнитьЗначенияСвойств(СтруктураБизнесПроцесса, СтрокаБП);
				СтруктураБизнесПроцесса.Типовой = Истина;
				
				ОтключаемыеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Настройки _Пользовательские для главного узла
	
	Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
		Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
			НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);		
		КонецЕсли;		
			
		Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
			Если СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаБП.ТипДокументаMS)
				И НЕ ДокументыMS.Свойство(СтрокаБП.ТипДокументаMS) Тогда
				СтруктураБизнесПроцесса = Новый Структура("ID_БизнесПроцесса, Название, Используется, ТипДокументаMS, Типовой");
				ЗаполнитьЗначенияСвойств(СтруктураБизнесПроцесса, СтрокаБП);
				СтруктураБизнесПроцесса.Типовой = Истина;
				
				ОтключаемыеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);
				
				Если СтрокаБП.Используется Тогда
					СтрокаБП.Вставить("Используется", Ложь);
					ИзмененныеБизнесПроцессы.Добавить(СтруктураБизнесПроцесса);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИзмененныеБизнесПроцессы.Количество() Тогда
		СтруктураНастроекБизнесПроцессов_Пользовательские = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
			НастройкиБизнесПроцессов_Пользовательские, 
			ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки());
					
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские, "");
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_Пользовательские", СтруктураНастроекБизнесПроцессов_Пользовательские);
		
		// Если изменились настройки пользовательских бизнес-процессов, нужно будет пересобрать общую структуру для всех узлов
		ЛокЯдро_ОчиститьКэшируемыеНастройкиДляВсехУзлов("НастройкиБизнесПроцессов");
	КонецЕсли;

	Если НЕ ОтключаемыеБизнесПроцессы.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	// Настройки _ПользовательскиеНастройки для главного узла и торговых объектов
	
	МассивУзлов = Новый Массив;
	МассивУзлов.Добавить("");
		
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			МассивУзлов.Добавить(СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;
		
	Для каждого ID_Узла ИЗ МассивУзлов Цикл
		ЭтоТекущийУзел = ID_ТекущегоУзла = ID_Узла;
		Если ЭтоТекущийУзел Тогда
			СтруктураНастроек_ПользовательскиеНастройки	= ЛокЯдро_ПолучитьИзКэшаСтруктуруИзмененныхТиповыхНастроекБизнесПроцессов();
		Иначе
			СтруктураНастроек_ПользовательскиеНастройки	= ЛокЯдро_ПолучитьСтруктуруИзмененныхТиповыхНастроекБизнесПроцессовНаСервереSMARTS(ID_Узла);
		КонецЕсли;
		НастройкиБизнесПроцессов_ПользовательскиеНастройки = СтруктураНастроек_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
				
		Если ТипЗнч(НастройкиБизнесПроцессов_ПользовательскиеНастройки) <> Тип("Массив") ИЛИ НЕ НастройкиБизнесПроцессов_ПользовательскиеНастройки.Количество() Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Массив") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_ПоУмолчанию[0]);
			ИначеЕсли ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Массив") Тогда
				НастройкиБизнесПроцессов_ПользовательскиеНастройки = Новый Массив();
				НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(НастройкиБизнесПроцессов_Пользовательские[0]);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские);		
			КонецЕсли;		
		КонецЕсли;
				
		СохранитьОбщуюНастройку = Ложь;
		
		Для каждого СтрокаБП ИЗ ОтключаемыеБизнесПроцессы Цикл
			Если ID_Узла = "" И НЕ СтрокаБП.Типовой Тогда
				Продолжить;
			КонецЕсли;
					
			БизнесПроцессДоступен = НедоступныеБизнесПроцессы.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено;
			
			СохранитьТекущуюНастройку = Ложь;
				
			СтруктураНастройки = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов_ПользовательскиеНастройки, Новый Структура("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса));
			Если СтруктураНастройки = Неопределено Тогда
				Если СтрокаБП.Используется Тогда
					СтрокаНастройки = Новый Структура;
					СтрокаНастройки.Вставить("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса);
					СтрокаНастройки.Вставить("Используется", 	  Ложь);
					СтрокаНастройки.Вставить("Доступность",		  БизнесПроцессДоступен);
					НастройкиБизнесПроцессов_ПользовательскиеНастройки.Добавить(СтрокаНастройки);
							
					СохранитьТекущуюНастройку = Истина;
				КонецЕсли;
			Иначе	
				СтрокаНастройки = СтруктураНастройки[0];
						
				Если СтрокаНастройки.Свойство("Используется")
					И СтрокаНастройки.Используется Тогда
					СтрокаНастройки.Вставить("Используется", Ложь);
							
					СохранитьТекущуюНастройку = Истина;
				ИначеЕсли СтрокаБП.Используется И НЕ СтрокаНастройки.Свойство("Используется") Тогда
					СтрокаНастройки.Вставить("Используется", Ложь);
								
					СохранитьТекущуюНастройку = Истина;
				КонецЕсли;
				
				Если НЕ БизнесПроцессДоступен Тогда
					Если НЕ СтрокаНастройки.Свойство("Доступность")
						ИЛИ СтрокаНастройки.Доступность Тогда
						СтрокаНастройки.Вставить("Доступность",	БизнесПроцессДоступен);
								
						СохранитьТекущуюНастройку = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
					
			Если СохранитьТекущуюНастройку Тогда
				ИзмененныйБП = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ИзмененныеБизнесПроцессы, Новый Структура("ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса));
				Если ИзмененныйБП = Неопределено Тогда
					ИзмененныеБизнесПроцессы.Добавить(СтрокаБП);
				КонецЕсли;
					
				СохранитьОбщуюНастройку = Истина;
			КонецЕсли;
		КонецЦикла;
				
		Если СохранитьОбщуюНастройку Тогда
			СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(
				НастройкиБизнесПроцессов_ПользовательскиеНастройки, 
				ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки());
								
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки, ID_Узла);
			Если ЭтоТекущийУзел Тогда
				ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтруктураНастроекБизнесПроцессов_ПользовательскиеНастройки);
			КонецЕсли;
				
			ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("НастройкиБизнесПроцессов", Неопределено, ID_Узла);
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого ИзмененныйБП ИЗ ИзмененныеБизнесПроцессы Цикл
		Если НЕ НедоступныеБизнесПроцессы.Найти(ИзмененныйБП.ID_БизнесПроцесса) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'Отключен бизнес-процесс ""%1"" по причине: документ ""%2"" отсутствует в метаданных Клеверенс';
								|en = 'The business process ""%1"" is disabled for the reason: the document ""%2"" is missing from the Cleverence metadata';
								|be = 'Адключаны бізнэс-працэс ""%1 ""па прычыне: дакумент"" %2 "" адсутнічае ў метададзеных Cleverence'; es = 'El proceso de negocio ""%1 "" está deshabilitado porque el documento ""%2 "" no se encuentra en los metadatos de Cleverence'; ka = 'ბიზნეს პროცესი ""%1 "" გამორთულია მიზეზის გამო: დოკუმენტი ""%2"" აკლია კლევერენციის მეტამონაცემებს'; kk = 'Cleverence метадеректерінде ""%1"" бизнес-процесі өшірілді: ""%2 "" құжаты жоқ'; ro = 'Procesul de afaceri ""%1 ""este dezactivat din motivul: documentul"" %2 "" lipsește din metadatele Cleverence'; tr = '""%1"" iş süreci şu nedenle devre dışı bırakıldı: ""%2"" belgesi Cleverence meta verilerinde eksik'; uk = 'Бізнес-процес ""%1 ""вимкнено з причини: документ"" %2 "" відсутній у метаданих Cleverence'; uz = '""%1 "" biznes jarayoni o''chirib qo''yilgan: ""%2"" hujjati Cleverence metama''lumotlarida mavjud emas'");
		ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ИзмененныйБП.Название, ИзмененныйБП.ТипДокументаMS);
			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", ТекстСообщения);
	КонецЦикла;
	
	Если ИзмененныеБизнесПроцессы.Количество() Тогда
		ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов();
		ЛокЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS();
	КонецЕсли;
	
	Результат = ИзмененныеБизнесПроцессы.Количество() > 0;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Результат);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьБизнесПроцессыВБазуSMARTS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда			
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли; 	
		
	ID_ТекущегоУзла = "";
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
		
	ВерсияВыгрузки_6_0 = Истина; // Всегда выгружаем таблицу в новом формате
	
	// Получение настроек бизнес-процессов для узлов
	МассивНастроекБизнесПроцессовПоУзлам = Новый Массив;
	
	МассивУзловЧастныхБаз = Новый Массив;
	
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		// Скопируем массив всех узлов, чтобы при редактировании массива ВсеУзлы не изменять значение в кэше
		ВсеУзлы = ЛокЯдро_СкопироватьМассив(ВсеУзлы);
			
		СтруктураПустогоУзла = Новый Структура;
		СтруктураПустогоУзла.Вставить("ID_Узла", "");
		ВсеУзлы.Добавить(СтруктураПустогоУзла);
			
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
					
			Если СтрокаУзла.Свойство("ID_Узла")
				И СтрокаУзла.ID_Узла <> ID_ТекущегоУзла Тогда
				НастройкиБизнесПроцессовПоУзлу = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(СтрокаУзла.ID_Узла);
					
				МассивНастроекБизнесПроцессовПоУзлам.Добавить(Новый Структура("ID_Узла, НастройкиБизнесПроцессов", СтрокаУзла.ID_Узла, НастройкиБизнесПроцессовПоУзлу));
			КонецЕсли;
			
			Если СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу")
				И СтрокаУзла.ИспользоватьЧастнуюБазу Тогда
				МассивУзловЧастныхБаз.Добавить(СтрокаУзла.ID_Узла);
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
		
	ИмяТаблицыБП = "БизнесПроцессы";
	
	Если ТипЗнч(СтруктураМетаданных) = Тип("Структура")
		И СтруктураМетаданных.Свойство("Tables") Тогда
		Если ЛокЯдро_НайтиВСпискеПоПредставлению(СтруктураМетаданных.Tables, "БизнесПроцессы") <> Неопределено Тогда
			ИмяТаблицыБП = "БизнесПроцессы";
		Иначе
			ИмяТаблицыБП = "BusinessProcesses";		
		КонецЕсли;
	КонецЕсли;
	
	// Выгружаются все бизнес-процессы, которые активны хотя бы для одного узла
	ТаблицаДляВыгрузки = Новый Массив;
	
	Для каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
			
		МассивУзлов = Новый Массив;
		Для каждого СтруктураНастроекБизнесПроцессовПоУзлу ИЗ МассивНастроекБизнесПроцессовПоУзлам Цикл
			НастройкиБизнесПроцессовПоУзлу = СтруктураНастроекБизнесПроцессовПоУзлу.НастройкиБизнесПроцессов;
				
			Если ТипЗнч(НастройкиБизнесПроцессовПоУзлу) = Тип("Массив") Тогда
				СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
					
				НастройкиПоБизнесПроцессуПоУзлу = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессовПоУзлу, СтруктураОтбора);
				Если НастройкиПоБизнесПроцессуПоУзлу <> Неопределено Тогда
					НастройкаПоБизнесПроцессуПоУзлу = НастройкиПоБизнесПроцессуПоУзлу[0];
					Если НастройкаПоБизнесПроцессуПоУзлу.Свойство("Используется") 
						И НастройкаПоБизнесПроцессуПоУзлу.Используется Тогда
						МассивУзлов.Добавить(СтруктураНастроекБизнесПроцессовПоУзлу.ID_Узла);
						Продолжить;
					КонецЕсли;
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНастройки.Используется Тогда
			МассивУзлов.Добавить(ID_ТекущегоУзла);
		КонецЕсли;
				
		Если МассивУзлов.Количество() = 0 Тогда
			// Бизнес-процесс отключен на всех узлах
			Продолжить;
		КонецЕсли;
		
		Если НЕ ВерсияВыгрузки_6_0 Тогда
			// Удаляем идентификатор пустого узла
			ИндексУзла = МассивУзлов.Найти("");
			Если ИндексУзла <> Неопределено Тогда
				МассивУзлов.Удалить(ИндексУзла);
			КонецЕсли;
				
			СтрокаУзел = ЛокЯдро_СтрСоединить(МассивУзлов, ",");
			
			МассивУзлов = Новый Массив;
			МассивУзлов.Добавить(СтрокаУзел);
		КонецЕсли;
		
		Для каждого СтрокаУзел ИЗ МассивУзлов Цикл
			
			Настройка = Новый Структура();
			Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
				Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
				Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Узел",							СтрокаУзел);
			Иначе
				Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Name",							СтрокаНастройки.Название);
				Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
				Настройка.Вставить("Nodes",							СтрокаУзел);
			КонецЕсли;
			ТаблицаДляВыгрузки.Добавить(Настройка);
			
		КонецЦикла; // Для каждого СтрокаУзел ИЗ МассивУзлов
		
	КонецЦикла;
		
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
	Если ЕстьЧастнаяБаза = Истина Тогда
		ТипБазы = "Частная";
	Иначе
		ТипБазы = "Основная";
	КонецЕсли;
		
	ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, ТипБазы);
	
	// Выгрузка бизнес-процессов в частные базы
	Если МассивУзловЧастныхБаз.Количество() > 0 Тогда
		Попытка
			Для Каждого ИдУзла Из МассивУзловЧастныхБаз Цикл
				ЛокЯдро_УстановитьДанныеТекущегоУзла(ИдУзла); 
				ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, "Частная");	
			КонецЦикла;
		Исключение
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Не удалось выгрузить бизнес-процессы в частные базы.';
								|en = 'Failed to upload business processes to private databases. Reason: %1';
								|be = 'Не атрымалася выгрузіць бізнес-працэсы ў прыватныя базы. Прычына: %1'; es = 'No se pudieron descargar los procesos de negocio a bases de datos privadas. Causa: %1'; ka = 'ვერ მოხერხდა ბიზნეს პროცესების ატვირთვა კერძო მონაცემთა ბაზებში. მიზეზი: %1'; kk = 'Бизнес-процестерді жеке базаларға түсіру мүмкін болмады. Себебі: %1'; ro = 'Nu s-a reușit încărcarea proceselor de afaceri în baze de date private. Motiv: %1'; tr = 'İş süreçlerini özel üslere boşaltmak mümkün değildi. Sebep: % 1'; uk = 'Не вдалося вивантажити бізнес-процеси в приватні бази. Причина: %1'; uz = 'Biznes-jarayonlarni xususiy bazalarga tushirib bo''lmadi. Sababi: %1'";
			пСобщение = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, пСобщение, ЯзСтрока,, ИнфоОшибка);
			// </Лог>
		КонецПопытки;
		
		ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзла);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкиБизнесПроцессов,ID_Узла,ДополнительныеПараметры",
		НастройкиБизнесПроцессов, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ВерсияВыгрузки_6_0 = Истина; // Всегда выгружаем таблицу в новом формате
	
	// Получение настроек бизнес-процессов для всех узлов, кроме текущего	
	МассивНастроекБизнесПроцессовПоУзлам = Новый Массив;
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ЗначениеЗаполнено(ID_Узла) И ТипЗнч(ВсеУзлы) <> Тип("Массив") Тогда
		ВсеУзлы = Новый Массив;
	КонецЕсли;
	МассивУзловЧастныхБаз = Новый Массив;
	
	// Содержатся все узлы, кроме пустого, у которого ID_узла = ""
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		//Скопируем массив всех узлов, чтобы при редактировании массива ВсеУзлы не изменять значение в кэше
		ВсеУзлы = ЛокЯдро_СкопироватьМассив(ВсеУзлы);
		// Добавим пустой идентификатор узла, т.к. его нет в массиве "ВсеУзлы"
		СтруктураПустогоУзла = Новый Структура;
		СтруктураПустогоУзла.Вставить("ID_Узла", "");
		ВсеУзлы.Добавить(СтруктураПустогоУзла);
		
		НастройкиБизнесПроцессовПоУзлам = Новый Структура;
		
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") Тогда 
				Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				//Получение настроек бизнес-процессов для всех узлов, кроме текущего, т.к. настройки текущего узла содержатся в реквизите ОтображаемыеНастройкиБизнесПроцессов
				Если СтрокаУзла.Свойство("ID_Узла")
					И СтрокаУзла.ID_Узла <> ID_Узла Тогда
					
					НастройкиБизнесПроцессовПоУзлам.Вставить(?(ЗначениеЗаполнено(СтрокаУзла.ID_Узла), СтрокаУзла.ID_Узла, "ГлавныйУзел"), Неопределено);
					
				КонецЕсли;
				Если СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу")
					И СтрокаУзла.ИспользоватьЧастнуюБазу Тогда
					МассивУзловЧастныхБаз.Добавить(СтрокаУзла.ID_Узла);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЛокЯдро_ПолучитьЗначенияКэшируемойНастройкиПоУзлам("НастройкиБизнесПроцессов", НастройкиБизнесПроцессовПоУзлам, "ID_БизнесПроцесса,Используется");
		
		Для каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессовПоУзлам Цикл
			ОбрабатываемыйУзел = ?(СтрокаНастройки.Ключ = "ГлавныйУзел", "", СтрокаНастройки.Ключ);
			
			НастройкиБизнесПроцессовПоУзлу = СтрокаНастройки.Значение;
			Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессовПоУзлу) Тогда
				НастройкиБизнесПроцессовПоУзлу = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ОбрабатываемыйУзел);
			КонецЕсли;
			
			МассивНастроекБизнесПроцессовПоУзлам.Добавить(Новый Структура("ID_Узла, НастройкиБизнесПроцессов", ОбрабатываемыйУзел, НастройкиБизнесПроцессовПоУзлу));
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицыMS = СтруктураМетаданных.Tables;
	Если ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "БизнесПроцессы") <> Неопределено Тогда
		ИмяТаблицыБП = "БизнесПроцессы";
	Иначе
		ИмяТаблицыБП = "BusinessProcesses";		
	КонецЕсли;
	
	// Выгружаются все строки бизнес-процессов, которые активны хотя бы для одного узла, в таблицу БизнесПроцессы базы смартс.
	ТаблицаДляВыгрузки = Новый Массив;
	Для Каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивУзлов = Новый Массив;
		
		Для Каждого СтруктураНастроекБизнесПроцессовПоУзлу Из МассивНастроекБизнесПроцессовПоУзлам Цикл
			НастройкиБизнесПроцессовПоУзлу = СтруктураНастроекБизнесПроцессовПоУзлу.НастройкиБизнесПроцессов;
			
			Если ТипЗнч(НастройкиБизнесПроцессовПоУзлу) = Тип("Массив") Тогда
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
				
				НастройкиПоБизнесПроцессуПоУзлу = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессовПоУзлу, СтруктураОтбора);
				Если НастройкиПоБизнесПроцессуПоУзлу <> Неопределено Тогда
					НастройкаПоБизнесПроцессуПоУзлу = НастройкиПоБизнесПроцессуПоУзлу[0];
					Если НастройкаПоБизнесПроцессуПоУзлу.Свойство("Используется") 
						И НастройкаПоБизнесПроцессуПоУзлу.Используется Тогда
						МассивУзлов.Добавить(СтруктураНастроекБизнесПроцессовПоУзлу.ID_Узла);
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		БПВключен = СтрокаНастройки.Используется;
		БПВключенДляТекУзла = МассивУзлов.Найти(ID_Узла) <> Неопределено;
		
		Если БПВключен <> БПВключенДляТекУзла Тогда
			Если БПВключенДляТекУзла Тогда
				МассивУзлов.Удалить(МассивУзлов.Найти(ID_Узла));
			Иначе
				МассивУзлов.Добавить(ID_Узла);
			КонецЕсли;
		КонецЕсли;
				
		Если МассивУзлов.Количество() = 0 Тогда
			// Бизнес-процесс отключен на всех узлах. Не выгружаем БП
			Продолжить;
		КонецЕсли;
		
		Если НЕ ВерсияВыгрузки_6_0 Тогда
			// Удаляем идентификатор пустого узла
			ИндексУзла = МассивУзлов.Найти("");
			Если ИндексУзла <> Неопределено Тогда
				МассивУзлов.Удалить(ИндексУзла);
			КонецЕсли;
				
			СтрокаУзел = ЛокЯдро_СтрСоединить(МассивУзлов, ",");
			
			МассивУзлов = Новый Массив;
			МассивУзлов.Добавить(СтрокаУзел);
		КонецЕсли;
		
		Для каждого СтрокаУзел ИЗ МассивУзлов Цикл
		
			Настройка = Новый Структура();
			Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
				Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
				Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Узел",							СтрокаУзел);
			Иначе
				Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
				Настройка.Вставить("Name",							СтрокаНастройки.Название);
				Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
				Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
				Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
				Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
				Настройка.Вставить("Nodes",							СтрокаУзел);
			КонецЕсли;
		    ТаблицаДляВыгрузки.Добавить(Настройка);
			
		КонецЦикла; // Для каждого СтрокаУзел ИЗ МассивУзлов
	КонецЦикла;
	
	ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки);
	
	Если ID_Узла = "" 
		И МассивУзловЧастныхБаз.Количество() > 0 Тогда // Будем выгружать таблицу БП в частные базы только если не выбран никакой ТО, чтоб лишний раз не гонять данные
		Для Каждого ИдУзла Из МассивУзловЧастныхБаз Цикл
			ЛокЯдро_УстановитьДанныеТекущегоУзла(ИдУзла); 
			ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, "Частная");	
		КонецЦикла;
		ЛокЯдро_УстановитьДанныеТекущегоУзла("");
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьТаблицуУзловСобытиеФормы(ТаблицаУзлов, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьТаблицуУзловСобытиеФормы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ТаблицаУзлов,ДополнительныеПараметры",
		ТаблицаУзлов, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ТаблицыMS = СтруктураМетаданных.Tables;
	Если ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "Узлы") <> Неопределено Тогда
		ИмяТаблицыУзлы = "Узлы";
	Иначе
		ИмяТаблицыУзлы = "Nodes";		
	КонецЕсли;
	
	МассивIDЧастныхБаз = Новый Массив;
	СтруктураДляВыгрузки = Новый Структура;
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		
		Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу") И СтрокаУзла.ИспользоватьЧастнуюБазу Тогда
			IDБазыMS = СокрЛП(СтрокаУзла.ЧастнаяБазаMS);
			Если IDБазыMS <> "" И МассивIDЧастныхБаз.Найти(IDБазыMS) = Неопределено Тогда
				МассивIDЧастныхБаз.Добавить(СтрокаУзла.ID_Узла);
			КонецЕсли;
		КонецЕсли;
		
		ПользователиУзла = Новый Массив;
		ТаблицаПользователейТСД = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПользователиТСД", СтрокаУзла.ID_Узла);
		Если ТипЗнч(ТаблицаПользователейТСД) = Тип("Массив") Тогда
			Для Каждого СтрокаНастройки Из ТаблицаПользователейТСД Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ПользователиУзла.Добавить(Новый Структура("Наименование, ID_Пользователя", СтрокаНастройки.Наименование, СтрокаНастройки.ID_Пользователя));
			КонецЦикла;			
		КонецЕсли;
		
		// Если необходимо выгрузить узел всем пользователям, оставляем поле пустым, т.к. в Клеверенс
		//	владелец проверяется на равенство либо ID пользователя, либо ID группы, либо на пустое значение
		Если НЕ ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ПользователиУзла, "ID_Пользователя", "Выгружать всем", Истина) = Неопределено Тогда
			ПользователиУзла.Очистить();		
		КонецЕсли;
		
		// Если пользователи узла не заданы, выгружаем в качестве владельца пустое значение
		Если НЕ ПользователиУзла.Количество() Тогда
			ПользователиУзла.Добавить(Новый Структура("Наименование, ID_Пользователя", "", ""));
		КонецЕсли;
		
		Для каждого Пользователь Из ПользователиУзла Цикл
			
			ПостфиксВладелец = ?(ПустаяСтрока(Пользователь.ID_Пользователя), "", 
				"_" + СтрЗаменить(СтрЗаменить(Пользователь.ID_Пользователя, "-", "_"), " ", "_"));
			
			НоваяСтрока = Новый Структура;
			Если ИмяТаблицыУзлы = "Узлы" Тогда
				НоваяСтрока.Вставить("Ид"					, СтрокаУзла.ID_Узла);
				НоваяСтрока.Вставить("Наименование"			, СтрокаУзла.Наименование);
				НоваяСтрока.Вставить("Код"					, СтрокаУзла.ID_Узла);
				
				НоваяСтрока.Вставить("ШК"					, "");
				НоваяСтрока.Вставить("ЭтоПапка"				, Ложь);
				НоваяСтрока.Вставить("ИдРодителя"			, "");
				НоваяСтрока.Вставить("НаименованиеДляПоиска", НРег(СтрокаУзла.Наименование));
				НоваяСтрока.Вставить("Владелец"				, Пользователь.ID_Пользователя);
				
				СтруктураДляВыгрузки.Вставить("Узел_" + Строка(НоваяСтрока.Ид) + ПостфиксВладелец, НоваяСтрока);
			Иначе
				НоваяСтрока.Вставить("Id"					, СтрокаУзла.ID_Узла);
				НоваяСтрока.Вставить("Name"					, СтрокаУзла.Наименование);
				НоваяСтрока.Вставить("Code"					, СтрокаУзла.ID_Узла);
				
				НоваяСтрока.Вставить("Barcode"				, "");
				НоваяСтрока.Вставить("IsFolder"				, Ложь);
				НоваяСтрока.Вставить("ParentId"				, "");
				НоваяСтрока.Вставить("Search"				, НРег(СтрокаУзла.Наименование));
				НоваяСтрока.Вставить("Owners"				, Пользователь.ID_Пользователя);
				
				СтруктураДляВыгрузки.Вставить("Узел_" + Строка(НоваяСтрока.Id) + ПостфиксВладелец, НоваяСтрока);
			КонецЕсли;
			
		КонецЦикла; // Для каждого Пользователь Из ПользователиУзла
		
	КонецЦикла;
	
	ID_ТекущегоУзлаПредыдущееЗначение = ДанныеТекущегоУзла.ID_Узла;
	
	ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыУзлы, СтруктураДляВыгрузки); // Выгружаем таблицу узлов в основную базу
	
	Для каждого ID_Узла Из МассивIDЧастныхБаз Цикл // Переключаемся на частную базу в цикле и выгружаем таблицу узлов в каждую
		ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_Узла); 
		ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыУзлы, СтруктураДляВыгрузки, "Частная");	
	КонецЦикла;
	
	Если ID_ТекущегоУзлаПредыдущееЗначение <> ДанныеТекущегоУзла.ID_Узла Тогда
		ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзлаПредыдущееЗначение); // возвращаем узел, который был установлен ранее
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Функция ЛокЯдро_ДоступноВыполнениеВФоне() Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Ложь;
	#КонецЕсли
	
	#Если ВебКлиент Тогда
		ЭтоВнешняяОбработка = ЛокЯдро_ЭтоВнешняяОбработка();
		Если ЭтоВнешняяОбработка
			И НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
			// В веб-клиенте в открытой ОО из файла не доступно выполнение в фоне из-за ограничений метода ИспользуемоеИмяФайла,
			// который в веб-клиенте не возвращает полный путь к файлу внешней обработки
			Возврат Ложь;
		КонецЕсли;
	#КонецЕсли
	
	Если Найти(ВРег(ПараметрЗапуска), "НЕЗАПУСКАТЬФОНОВЫЕЗАДАНИЯ") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДоступностьВыполненияВФоне = Ложь;
	
	ВерсияБСП = ЛокЯдро_ПолучитьВерсиюБСП();
	
	// Определяем, что выполнение в фоне доступно, если версия БСП больше 3.0.0.0
	Если ВерсияБСП <> Неопределено Тогда
		РезультатСравнения = ЛокЯдро_СравнитьВерсии(ВерсияБСП, "3.0.0.0");
		
		Если РезультатСравнения > 0 Тогда
			ДоступностьВыполненияВФоне = Истина;		
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДоступностьВыполненияВФоне;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьВерсиюБСП() Экспорт
	
	ВерсияБСП = Неопределено;

	ИмяМодуля = "СтандартныеПодсистемыВызовСервера";

	МодульЕсть = ЛокЯдро_ВычислитьВБезопасномРежиме("Метаданные.ОбщиеМодули.Найти(" + """" + ИмяМодуля + """" + ") <> Неопределено");
	
	Если МодульЕсть Тогда
		Попытка
			ВерсияБСП = ЛокЯдро_ВычислитьВБезопасномРежиме("" + ИмяМодуля + "" + ".ВерсияБиблиотеки()");
		Исключение
		КонецПопытки;
	Иначе
		ИмяМодуля = "StandardSubsystemsServerCall";

		МодульЕсть = ЛокЯдро_ВычислитьВБезопасномРежиме("Метаданные.ОбщиеМодули.Найти(" + """" + ИмяМодуля + """" + ") <> Неопределено");
		
		Если МодульЕсть <> Неопределено Тогда
			Попытка
				ВерсияБСП = ЛокЯдро_ВычислитьВБезопасномРежиме("" + ИмяМодуля + "" + ".LibraryVersion()");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВерсияБСП;
				
КонецФункции

// Рекурсивно сравнивает две структуры настроек и массивы в них.
// Возвращает только отличия, где приоритетными считаются значения из правой структуры. 
// 	Важно. В элементах массивов также возращает только измененные ключи, а не целую строку.
// Сделано для сравнения типовых и пользовательских значений настроек.
//
// Параметры:
//  НастройкиЛево - Структура - Левая структура для сравнения (обычно типовые настройки).
//  НастройкиПраво - Структура - Правая структура для сравнения (обычно пользовательские настройки).
//  ДополнительныеПараметры - Структура - Дополнительные параметры сравнения.
//      * ПропуститьНастройки - Структура - Структура с ключами настроек, которые следует пропустить при сравнении.
//
// Возвращаемое значение:
//   Структура - результат сравнения:
//      * Изменено - Булево - Истина, если найдены отличия.
//      * ИзмененныеЗначения - Структура - Содержит только те ключи и значения, которые отличаются или
//                                        присутствуют только в правой структуре.
//
&НаКлиенте
Функция ЛокЯдро_СравнитьСтруктуруНастроек(НастройкиЛево, НастройкиПраво, ДополнительныеПараметры = Неопределено) Экспорт
	
	РезультатСравнения = Новый Структура("Изменено, ИзмененныеЗначения", Ложь, Новый Структура);
	
	// Имена настроек, которые не нужно сравнивать
	ПропуститьНастройки = Новый Структура;
	Если ДополнительныеПараметры = Неопределено
		ИЛИ НЕ ДополнительныеПараметры.Свойство("ПропуститьНастройки") Тогда
		ПропуститьНастройки.Вставить("ЭтоТиповойБизнесПроцесс");
		ПропуститьНастройки.Вставить("ИспользоватьТиповыеНастройки");
	КонецЕсли;
	
	Для каждого КлючЗначение Из НастройкиЛево Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеЛево = КлючЗначение.Значение;
		
		Если ПропуститьНастройки.Свойство(ИмяНастройки) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПраво = Неопределено;
		НастройкиПраво.Свойство(ИмяНастройки, ЗначениеПраво);
		
		// Если ЗначениеПраво = Неопределено то считаем, что этого ключа нет
		Если ЗначениеПраво = Неопределено
			ИЛИ ЗначениеЛево = ЗначениеПраво Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗнчЛево = ТипЗнч(ЗначениеЛево);
		ТипЗнчПраво = ТипЗнч(ЗначениеПраво);
		
		Если ТипЗнчЛево <> ТипЗнчПраво Тогда
			РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ЗначениеПраво);
			РезультатСравнения.Изменено = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			
			// Сравниваем массивы полным соединением
			
			// Для возможности сравнивать массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			МассивИзменен = Ложь;
			ИзмененныйМассив = Новый Массив;
			ИндексыПроверенныхЭлементов = Новый Массив;
			
			// Сравниваем типовые настройки с пользовательскими
			Для каждого ЭлементЛево Из ЗначениеЛево Цикл
				
				Если ЭлементЛево.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементЛево);
				
				ЭлементыПраво = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПраво, Отбор, Ложь);
				Если ЭлементыПраво <> Неопределено Тогда
					Для каждого ЭлементПраво Из ЭлементыПраво Цикл
						
						// Новые пользовательские строки обязательно должны быть помечены Типовой = Ложь
						// 	проверка сделана на случай, если в типовых настройках появится новое поле, которое уже есть у пользователя.
						Если ЭлементПраво.Свойство("Типовой") И ЭлементПраво.Типовой = Ложь Тогда
							Продолжить;
						КонецЕсли;
						
						// Индекс правого элемента, которые являются типовыми
						ИндексыПроверенныхЭлементов.Добавить(ЗначениеПраво.Найти(ЭлементПраво));
						
						// Рекурсивное сравнение, т.к могут быть вложения как в с НастройкаЗагрузкиТЧ -> ТабличнаяЧастьДокумента1С
						пРезультатСравнения = ЛокЯдро_СравнитьСтруктуруНастроек(ЭлементЛево, ЭлементПраво);
						Если пРезультатСравнения.Изменено Тогда
							
							// Добавляем ключи уникальности, для возможности объединить настройку в будущем
							Для каждого КлючЗначение Из Отбор Цикл
								пРезультатСравнения.ИзмененныеЗначения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
							КонецЦикла;
							
							ИзмененныйМассив.Добавить(пРезультатСравнения.ИзмененныеЗначения);
							МассивИзменен = Истина;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			
			// Вставляем элементы, которые находятся только в ПравоеЗначение (пользовательские настройки)
			Для Индекс = 0 По ЗначениеПраво.ВГраница() Цикл
				
				Если ИндексыПроверенныхЭлементов.Найти(Индекс) <> Неопределено Тогда
					// Элемент является типовым и он уже добавлен в предыдущем цикле
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво = ЗначениеПраво[Индекс];
				
				Если ЭлементПраво.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ИзмененныйМассив.Добавить(ЛокЯдро_СкопироватьСтруктуру(ЭлементПраво));
				МассивИзменен = Истина;
				
			КонецЦикла;
			
			Если МассивИзменен Тогда
				РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ИзмененныйМассив);
				РезультатСравнения.Изменено = Истина;
			КонецЕсли;
			
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			
			пРезультатСравнения = ЛокЯдро_СравнитьСтруктуруНастроек(ЗначениеЛево, ЗначениеПраво);
			Если пРезультатСравнения.Изменено Тогда
				РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, пРезультатСравнения.ИзмененныеЗначения);
				РезультатСравнения.Изменено = Истина;
			КонецЕсли;
			
		Иначе
			РезультатСравнения.ИзмененныеЗначения.Вставить(ИмяНастройки, ЗначениеПраво);
			РезультатСравнения.Изменено = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатСравнения;
	
КонецФункции 

// Рекурсивно объединяет две структуры настроек и массивы в них.
// Для структур выполняется левая связь, для массивов полное.
// Для массивов структур выполняет слияние по уникальным ключам, добавляя поле Типовой.
// Сделано для объединения типовых и пользовательских значений настроек.
//
// Параметры:
//  НастройкиЛево - Структура - Левая структура для объединения (источник, обычно типовые настройки).
//  НастройкиПраво - Структура - Правая структура для объединения (приоритетный источник, обычно пользовательские настройки).
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//   Структура - Объединенная структура настроек.
//
&НаКлиенте
Функция ЛокЯдро_ОбъединитьСтруктуруНастроек(НастройкиЛево, НастройкиПраво, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОбъединеннаяСтруктура = Новый Структура;
	
	Для каждого КлючЗначение Из НастройкиЛево Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ЗначениеЛево = КлючЗначение.Значение;
		
		ЗначениеПраво = Неопределено;
		НастройкиПраво.Свойство(ИмяНастройки, ЗначениеПраво);
		
		ТипЗнчЛево = ТипЗнч(ЗначениеЛево);
		ТипЗнчПраво = ТипЗнч(ЗначениеПраво);
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			ЗначениеЛево = ЛокЯдро_СкопироватьМассив(ЗначениеЛево);
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			ЗначениеЛево = ЛокЯдро_СкопироватьСтруктуру(ЗначениеЛево);
		КонецЕсли;
		
		Если ТипЗнчПраво = Тип("Массив") Тогда
			ЗначениеПраво = ЛокЯдро_СкопироватьМассив(ЗначениеПраво);
		ИначеЕсли ТипЗнчПраво = Тип("Структура") Тогда
			ЗначениеПраво = ЛокЯдро_СкопироватьСтруктуру(ЗначениеПраво);
		КонецЕсли;
		
		Если ЗначениеПраво = Неопределено Тогда
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеЛево);
			Продолжить;
		ИначеЕсли ТипЗнчЛево <> ТипЗнчПраво Тогда
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеПраво);
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнчЛево = Тип("Массив") Тогда
			
			// Для возможности объединить массив, обязательно должны быть заполнены КлючиУникальности для имени настройки
			КлючиУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
			Если КлючиУникальности = "" Тогда
				Продолжить;
			КонецЕсли;
			
			ИзмененныйМассив = Новый Массив;
			ИндексыПроверенныхЭлементов = Новый Массив;
			
			// Сравнение типовых и пользовательских настроек
			Для каждого ЭлементЛево Из ЗначениеЛево Цикл
				
				Если ЭлементЛево.Свойство("ЭтоТаблицаЗначений") Тогда
					ИзмененныйМассив.Добавить(ЭлементЛево);
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура(КлючиУникальности);
				ЗаполнитьЗначенияСвойств(Отбор, ЭлементЛево);
				
				ЕстьТиповоеСовпадение = Ложь;
				ЭлементыПраво = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеПраво, Отбор, Ложь);
				Если ЭлементыПраво <> Неопределено И ЭлементыПраво.Количество() > 0 Тогда
					Для каждого ЭлементПраво Из ЭлементыПраво Цикл
						
						// Новые пользовательские строки обязательно должны быть помечены Типовой = Ложь
						// 	проверка сделана на случай, если в типовых настройках появится новое поле, которое уже есть у пользователя.
						Если ЭлементПраво.Свойство("Типовой") И ЭлементПраво.Типовой = Ложь Тогда
							Продолжить;
						КонецЕсли;
						
						ЕстьТиповоеСовпадение = Истина;
						
						// Индекс правого элемента, которые являются типовыми
						ИндексыПроверенныхЭлементов.Добавить(ЗначениеПраво.Найти(ЭлементПраво));
						
						пОбъединеннаяСтруктура = ЛокЯдро_ОбъединитьСтруктуруНастроек(ЭлементЛево, ЭлементПраво);
						пОбъединеннаяСтруктура.Вставить("Типовой", Истина);
						ИзмененныйМассив.Добавить(пОбъединеннаяСтруктура);
						
					КонецЦикла;
				КонецЕсли;
				
				// Все совпадения — пользовательские (Типовой=Ложь): типовое поле не было объединено.
				// Добавляем его, чтобы оно отображалось в отключённом состоянии рядом с пользовательским дублём.
				Если НЕ ЕстьТиповоеСовпадение Тогда
					ЭлементЛево.Вставить("Типовой", Истина);
					ИзмененныйМассив.Добавить(ЭлементЛево);
				КонецЕсли;
				
			КонецЦикла;
			
			// Вставляем элементы, которые находятся только в ЗначениеПраво (пользовательские настройки)
			Для Индекс = 0 По ЗначениеПраво.ВГраница() Цикл
				
				Если ИндексыПроверенныхЭлементов.Найти(Индекс) <> Неопределено Тогда
					// Элемент является типовым и он уже добавлен в предыдущем цикле
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво = ЗначениеПраво[Индекс];
				
				Если ЭлементПраво.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				// Это типовое поле, которые было удалено из типовых настроек
				Если НЕ ЭлементПраво.Свойство("Типовой") Тогда
					Продолжить;
				КонецЕсли;
				
				ЭлементПраво.Вставить("Типовой", Ложь);
				ИзмененныйМассив.Добавить(ЭлементПраво);
				
			КонецЦикла;
			
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ИзмененныйМассив);
			
		ИначеЕсли ТипЗнчЛево = Тип("Структура") Тогда
			
			пОбъединеннаяСтруктура = ЛокЯдро_ОбъединитьСтруктуруНастроек(ЗначениеЛево, ЗначениеПраво);
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, пОбъединеннаяСтруктура);
			
		Иначе
			ОбъединеннаяСтруктура.Вставить(ИмяНастройки, ЗначениеПраво);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъединеннаяСтруктура;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЛокЯдро_ПроверитьПраваДоступа(ПроверяемыеПрава) Экспорт
	
	Для каждого КлючЗначение Из ПроверяемыеПрава Цикл
		ПроверяемыеПрава[КлючЗначение.Ключ] = ПравоДоступа(КлючЗначение.Ключ, Метаданные);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_Обновление

// Преобразует строковые представления версий настроек в числовые, при необходимости вызывает обновление настроек.
// 
// Параметры:
//	пСтруктураНастроек - Структура - содержит:
//		* ВерсияОбработкиНастроек - Строка - строковое представление версии в формате (1.0.1.1) сохранённых настроек в базе SMARTS 
//		* ВерсияОбработкиКлеверенсТСД - Строка - строковое представление версии в формате (1.0.1.1) значений по умолчанию в базе SMARTS
//	КлючНастройки - Строка, Неопределено - ключ обновляемой настройки
//	ЗначениеНастройки - Структура, Неопределено - структура со значениями настроек для обновления
//
// Возвращаемое значение:
//	Структура - обновленные настройки - содержит:
//		* ИзмененияВКэше - Структура - настройки для сохранения в кэш
//		* ИзменениеВНастройках - Структура - настройки для сохранения в базу SMARTS
&НаКлиенте
Функция ЛокЯдро_ВыполнитьОбновлениеСтруктурыНастроек(пСтруктураНастроек) Экспорт	
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьОбновлениеСтруктурыНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Обновление глобальных параметров
	ОбновлятьГлобальныеПараметры = Истина;

	Если НЕ пСтруктураНастроек.Свойство("ВерсияГлобальныеПараметры") Тогда
		ОбновлятьГлобальныеПараметры = Ложь;
	Иначе
		ВерсияГлобальныхПараметров = пСтруктураНастроек.ВерсияГлобальныеПараметры;
		Если ЗначениеЗаполнено(ВерсияГлобальныхПараметров)
			И НЕ ВерсияГлобальныхПараметров = Ложь
			И ВерсияГлобальныхПараметров >= 1003014000 Тогда
			ОбновлятьГлобальныеПараметры = Ложь;				
		КонецЕсли;
	КонецЕсли;
	
	Если ОбновлятьГлобальныеПараметры Тогда
		ЛокЯдро_ВыполнитьОбновлениеГлобальныхПараметров(пСтруктураНастроек);
	КонецЕсли;
	
	Если КомЯдро_ПолучитьЗначениеПеременной("ИнтеграционнаяОбработкаПодключена") = Истина Тогда
		
		// Обновление настроек обмена справочников
		ВерсияНастройкиОбменаСправочников = 0;
		Если пСтруктураНастроек.Свойство("ВерсияНастройкиОбменаСправочников") Тогда
			Если ЗначениеЗаполнено(пСтруктураНастроек.ВерсияНастройкиОбменаСправочников)
				И НЕ пСтруктураНастроек.ВерсияНастройкиОбменаСправочников = Ложь Тогда
				ВерсияНастройкиОбменаСправочников = пСтруктураНастроек.ВерсияНастройкиОбменаСправочников;
			КонецЕсли;
		КонецЕсли;
			
		Если ВерсияНастройкиОбменаСправочников < 1003025002 Тогда
			Результат = ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2(пСтруктураНастроек);
 		КонецЕсли;
		Если ВерсияНастройкиОбменаСправочников < 2001000005 Тогда
			Результат = ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5(пСтруктураНастроек);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция"); 
	СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеСтруктурыНастроек");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("пСтруктураНастроек", пСтруктураНастроек));
	СтруктураИзменений = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных, 2);	
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураИзменений);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураИзменений;
	
КонецФункции

// Изменение структуры глобальных параметров:
// 	1. ГлобальныеПараметры разделены на ГлобальныеПараметры_ПоУмолчанию и ГлобальныеПараметры_Пользовательские
// 	2. Для хранения параметров главного узла используется настройка ГлобальныеПараметры_Значения вместо ГлобальныеПараметры
// 	3. Настройка ЗначенияПараметровУзлов_[УзелN] переименована в ГлобальныеПараметры_Значения_[УзелN]
&НаКлиенте
Процедура ЛокЯдро_ВыполнитьОбновлениеГлобальныхПараметров(пСтруктураНастроек) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьОбновлениеГлобальныхПараметров";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ID_ТекущегоУзла = "";
	
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") Тогда
		ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;		
	КонецЕсли;
	
	ИзмененияВКэше 		= Новый Структура();
	ИзмененияВСтруктуре = Новый Структура();
	
	ГлобальныеПараметры = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры");
	
	Если ЗначениеЗаполнено(ГлобальныеПараметры) И НЕ ГлобальныеПараметры = Ложь Тогда
		ГлобальныеПараметры_Значения 		 = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения");
	    ГлобальныеПараметры_ПоУмолчанию 	 = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_ПоУмолчанию");
		ГлобальныеПараметры_Пользовательские = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ГлобальныеПараметры_Пользовательские");
		
		ЕстьГлобальныеПараметры_Значения 		 = ЗначениеЗаполнено(ГлобальныеПараметры_Значения) И НЕ ГлобальныеПараметры_Значения = Ложь;
		ЕстьГлобальныеПараметры_ПоУмолчанию 	 = ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь;
		ЕстьГлобальныеПараметры_Пользовательские = ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь;
		
		Если НЕ ЕстьГлобальныеПараметры_Значения Тогда
			ГлобальныеПараметры_Значения = Новый Массив;
			ГлобальныеПараметры_Значения.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
		КонецЕсли;
		
		Если НЕ ЕстьГлобальныеПараметры_Пользовательские Тогда
			ГлобальныеПараметры_Пользовательские = Новый Массив;
			ГлобальныеПараметры_Пользовательские.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
		КонецЕсли;
			
		Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры Цикл	
			Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
						
			// Дополняем ключ ГлобальныеПараметры_Значения значениями ключа ГлобальныеПараметры
			НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", СтрокаПараметра.ID_Параметра);
			Если НайденныйПараметр = Неопределено Тогда
				ГлобальныеПараметры_Значения.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПараметра));	
			КонецЕсли;
						
			// Дополняем ключ ГлобальныеПараметры_Пользовательские по наличию настроек в ключе ГлобальныеПараметры_ПоУмолчанию
			Если ЕстьГлобальныеПараметры_ПоУмолчанию Тогда
				НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаПараметра.ID_Параметра);
				Если НайденныйПараметр <> Неопределено Тогда
					Продолжить;						
				КонецЕсли;
						
				НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Пользовательские, "ID_Параметра", СтрокаПараметра.ID_Параметра);
				Если НайденныйПараметр = Неопределено Тогда
					ГлобальныеПараметры_Пользовательские.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПараметра));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЛокЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("ГлобальныеПараметры"));
		ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", Неопределено, "");
		
		// Если нет ключа ГлобальныеПараметры_ПоУмолчанию, дополняем ключ ГлобальныеПараметры_Пользовательские по наличию настроек в ключе ГлобальныеПараметры 
		Если НЕ ЕстьГлобальныеПараметры_ПоУмолчанию Тогда
            ГлобальныеПараметры_ПоУмолчанию = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры");
			Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
                Для каждого СтрокаПараметра ИЗ ГлобальныеПараметры Цикл	
					Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
				
					НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр <> Неопределено Тогда
						Продолжить;						
					КонецЕсли;
							
					НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Пользовательские, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						ГлобальныеПараметры_Пользовательские.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПараметра));
					КонецЕсли;
				КонецЦикла;
				
				ИзмененияВКэше.Вставить("ГлобальныеПараметры_ПоУмолчанию", ГлобальныеПараметры_ПоУмолчанию);
			КонецЕсли;
			ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("ГлобальныеПараметры", Неопределено, "");
		КонецЕсли;
		
		ИзмененияВСтруктуре.Вставить("ГлобальныеПараметры_Значения", 		 ГлобальныеПараметры_Значения);
		ИзмененияВСтруктуре.Вставить("ГлобальныеПараметры_Пользовательские", ГлобальныеПараметры_Пользовательские);
		
		ИзмененияВКэше.Вставить("ГлобальныеПараметры_Пользовательские", 	 ГлобальныеПараметры_Пользовательские);
		ИзмененияВКэше.Вставить("ГлобальныеПараметры", 						 Неопределено);
		
		Если ID_ТекущегоУзла = "" Тогда
			ИзмененияВКэше.Вставить("ГлобальныеПараметры_Значения", 	 	 ГлобальныеПараметры_Пользовательские);	
		КонецЕсли;
	КонецЕсли;
	
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ID_Узла = СтрокаУзла.ID_Узла;
			
			// ЗначенияПараметровУзлов_[Узел] заменяем на ГлобальныеПараметры_Значения_[Узел]
			ЗначенияПараметровУзлов = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ЗначенияПараметровУзлов", ID_Узла);
			Если ЗначениеЗаполнено(ЗначенияПараметровУзлов) И НЕ ЗначенияПараметровУзлов = Ложь Тогда
				ГлобальныеПараметры_Значения = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ГлобальныеПараметры_Значения", ID_Узла);
			    
				ЕстьГлобальныеПараметры_Значения = ЗначениеЗаполнено(ГлобальныеПараметры_Значения) И НЕ ГлобальныеПараметры_Значения = Ложь;
				Если НЕ ЕстьГлобальныеПараметры_Значения Тогда
					ГлобальныеПараметры_Значения = Новый Массив;
					ГлобальныеПараметры_Значения.Добавить(Новый Структура("ЭтоТаблицаЗначений, КолонкиТаблицыЗначений", Истина, "Использование, Наименование, Значение, ID_Параметра, Комментарий"));
				КонецЕсли;
				
				Для каждого СтрокаПараметра ИЗ ЗначенияПараметровУзлов Цикл	
					Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
								
					// Дополняем ключ ГлобальныеПараметры_Значения_[Узел] значениями ключа ЗначенияПараметровУзлов_[Узел]
					НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", СтрокаПараметра.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						ГлобальныеПараметры_Значения.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаПараметра));	
					КонецЕсли;
				КонецЦикла;
				
				ЛокЯдро_УдалитьНастройкиВБазеSMARTS(Новый Структура("ЗначенияПараметровУзлов"), ID_Узла);
				
				ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Значения, ID_Узла);
				
				Если ID_ТекущегоУзла = ID_Узла Тогда
					ИзмененияВКэше.Вставить("ГлобальныеПараметры_Значения", ГлобальныеПараметры_Пользовательские);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ИзмененияВСтруктуре.Вставить("ВерсияГлобальныеПараметры", 1003014000);
	пСтруктураНастроек.Вставить("ВерсияГлобальныеПараметры", ИзмененияВСтруктуре.ВерсияГлобальныеПараметры);
	
	ЛокЯдро_СохранитьНастройкиВБазеSMARTS(ИзмененияВСтруктуре, ID_ТекущегоУзла);
	ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(ИзмененияВКэше);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Изменение структуры НастройкиОбменаСправочников задача PRODUCTS-17494:
//	Разделить НастройкиОбменаСправочников на 
//		НастройкиОтборовСправочников_Интерактивный 	- оставить разделение по ТО только для частных баз. Хранит настройки СКД и текст получения параметров.
//		НастройкиОтборовСправочников_Автообмен 		- оставить разделение по ТО только для частных баз. Хранит настройки СКД и текст получения параметров.
//		НастройкиОтборовСправочников_Онлайн 			- оставить разделение по ТО для всех. Хранит настройки СКД и текст получения параметров.
//		НастройкиОбменаСправочников 				- основная таблица используется как основной источник настроек и не разделяется по ТО. 
//														Хранит способы выгрузки, тексты запросов, общие настройки для всех режимов выгрузки.
//
&НаКлиенте
Функция ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2(пСтруктураНастроек)
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ЛокЯдро_СобратьНастройкиОбменаСправочников();
	
	ДанныеТекущегоУзла = КомЯдро_ПолучитьЗначениеПеременной("ДанныеТекущегоУзла");
	ID_ТекущегоУзла = ДанныеТекущегоУзла.ID_Узла;
	
	// Получаем настройки по всем узлам.
	НастройкиГлавногоУзла = Новый Структура;
	НастройкиГлавногоУзла.Вставить("НастройкиОбменаСправочников");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Онлайн");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Интерактивный");
	НастройкиГлавногоУзла.Вставить("НастройкиОтборовСправочников_Автообмен");
	
	НастройкиГлавногоУзла = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиГлавногоУзла);
	
	// Формируем новые массивы настроек
	КолонкиТаблицы = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОбменаСправочников) = Тип("Массив") Тогда
		НастройкиОбменаСправочников = НастройкиГлавногоУзла.НастройкиОбменаСправочников;
	Иначе
		НастройкиОбменаСправочников = Новый Массив;
		НастройкиОбменаСправочников.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОбменаСправочников()));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Онлайн) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Онлайн = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Онлайн;
	Иначе
		НастройкиОтборовСправочников_Онлайн = Новый Массив;
		НастройкиОтборовСправочников_Онлайн.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Интерактивный) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Интерактивный = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Интерактивный;
	Иначе
		НастройкиОтборовСправочников_Интерактивный = Новый Массив;
		НастройкиОтборовСправочников_Интерактивный.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	Если ТипЗнч(НастройкиГлавногоУзла.НастройкиОтборовСправочников_Автообмен) = Тип("Массив") Тогда
		НастройкиОтборовСправочников_Автообмен = НастройкиГлавногоУзла.НастройкиОтборовСправочников_Автообмен;
	Иначе
		НастройкиОтборовСправочников_Автообмен = Новый Массив;
		НастройкиОтборовСправочников_Автообмен.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(КолонкиТаблицы));
	КонецЕсли;
	
	НастройкиОбменаСправочников_Узлы 					= Новый Структура;
	НастройкиОтборовСправочников_Онлайн_Узлы 			= Новый Структура;
	НастройкиОтборовСправочников_Интерактивный_Узлы 	= Новый Структура;
	НастройкиОтборовСправочников_Автообмен_Узлы 		= Новый Структура;
	
	// НастройкиОбменаСправочников больше не являются узловыми настройками,
	// 	но чтобы получить узловые значения, временно добавим их в список узловых.
	КатегорииНастроекMS = КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	пКатегорииНастроекMS = ЛокЯдро_СкопироватьСтруктуру(КатегорииНастроекMS);
	пКатегорииНастроекMS.УзловыеНастройки.Добавить("НастройкиОбменаСправочников");
	
	ИдентификаторыУзлов = Новый Структура;
	
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			ID_Узла = "";
			Если СтрокаУзла.Свойство("ID_Узла") Тогда
				ID_Узла = СтрокаУзла.ID_Узла;
			КонецЕсли;
			
			Если ПустаяСтрока(ID_Узла) Тогда
				Продолжить;
			КонецЕсли;
			
			ИспользоватьЧастнуюБазу = СтрокаУзла.Свойство("ИспользоватьЧастнуюБазу") И СтрокаУзла.ИспользоватьЧастнуюБазу = Истина;
			ИдентификаторыУзлов.Вставить(ID_Узла, ИспользоватьЧастнуюБазу);
			
			СтруктураНастроек = Новый Структура;
			СтруктураНастроек.Вставить("НастройкиОбменаСправочников");
			СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Онлайн");
			
			Если ИспользоватьЧастнуюБазу Тогда
				СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Интерактивный");
				СтруктураНастроек.Вставить("НастройкиОтборовСправочников_Автообмен");
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("НеКэшировать", Истина);
			ДополнительныеПараметры.Вставить("НеПроверятьАктуальность", Истина);
			ДополнительныеПараметры.Вставить("КатегорииНастроекMS", пКатегорииНастроекMS);
			СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
			
			// НастройкиОбменаСправочников
			ЗначениеУзла = СтруктураНастроек.НастройкиОбменаСправочников;
			Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
				ЗначениеУзла = ЛокЯдро_СкопироватьМассив(НастройкиОбменаСправочников);
			КонецЕсли;
			НастройкиОбменаСправочников_Узлы.Вставить(ID_Узла, ЗначениеУзла);
			
			// НастройкиОтборовСправочников_Онлайн
			ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Онлайн;
			Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
				ЗначениеУзла = ЛокЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Онлайн);
			КонецЕсли;
			НастройкиОтборовСправочников_Онлайн_Узлы.Вставить(ID_Узла, ЗначениеУзла);
			
			Если ИспользоватьЧастнуюБазу Тогда
				
				// НастройкиОтборовСправочников_Интерактивный
				ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Интерактивный;
				Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
					ЗначениеУзла = ЛокЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Интерактивный);
				КонецЕсли;
				НастройкиОтборовСправочников_Интерактивный_Узлы.Вставить(ID_Узла, ЗначениеУзла);
				
				// НастройкиОтборовСправочников_Онлайн
				ЗначениеУзла = СтруктураНастроек.НастройкиОтборовСправочников_Автообмен;
				Если ЗначениеУзла = Ложь ИЛИ НЕ ЗначениеЗаполнено(ЗначениеУзла) Тогда
					ЗначениеУзла = ЛокЯдро_СкопироватьМассив(НастройкиОтборовСправочников_Автообмен);
				КонецЕсли;
				НастройкиОтборовСправочников_Автообмен_Узлы.Вставить(ID_Узла, ЗначениеУзла);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Для каждого СтрокаНастройки Из НастройкиОбменаСправочников Цикл	
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаНастройки = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиОтборовСправочников();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки, СтрокаНастройки);
		
		ИмяТаблицы = НоваяСтрокаНастройки.ИмяТаблицы;
		
		// Значения главного узла (обновление/добавление)
		Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Онлайн, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Онлайн.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Обновляем значение из НастройкиОбменаСправочников, т.к в старой версии ОО настройка могла быть изменена
			ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Онлайн[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Интерактивный, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Интерактивный.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
			//ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Интерактивный[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОтборовСправочников_Автообмен, "ИмяТаблицы", ИмяТаблицы, Истина);
		Если Индекс = Неопределено Тогда
			НастройкиОтборовСправочников_Автообмен.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
		Иначе
			// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
			//ЗаполнитьЗначенияСвойств(НастройкиОтборовСправочников_Автообмен[Индекс], НоваяСтрокаНастройки);
		КонецЕсли;
		
		// Значения узлов (обновление/добавление)
		Для каждого КлючЗначение Из ИдентификаторыУзлов Цикл
			
			ID_Узла = КлючЗначение.Ключ;
			ЭтоЧастнаяБаза = КлючЗначение.Значение;
			
			СтрокаНастройкиУзла = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НастройкиОбменаСправочников_Узлы[ID_Узла], "ИмяТаблицы", СтрокаНастройки.ИмяТаблицы);
			Если СтрокаНастройкиУзла <> Неопределено Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки, СтрокаНастройкиУзла);
				
				ЗначениеУзла = НастройкиОтборовСправочников_Онлайн_Узлы[ID_Узла];
				Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
				Если Индекс = Неопределено Тогда
					ЗначениеУзла.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
				Иначе
					// Обновляем значение из НастройкиОбменаСправочников, т.к в старой версии ОО настройка могла быть изменена
					ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
				КонецЕсли;
				
				// В интерактивном и автообмене разделение по узлам оставляем только в частных базах
				Если ЭтоЧастнаяБаза Тогда
					
					ЗначениеУзла = НастройкиОтборовСправочников_Интерактивный_Узлы[ID_Узла];
					Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
					Если Индекс = Неопределено Тогда
						ЗначениеУзла.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
					Иначе
						// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
						//ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
					КонецЕсли;
					
					ЗначениеУзла = НастройкиОтборовСправочников_Автообмен_Узлы[ID_Узла];
					Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеУзла, "ИмяТаблицы", ИмяТаблицы, Истина);
					Если Индекс = Неопределено Тогда
						ЗначениеУзла.Добавить(ЛокЯдро_СкопироватьСтруктуру(НоваяСтрокаНастройки));
					Иначе
						// Считаем, что в старой версии ОО мы работаем с Онлайн обменом, поэтому остальные не обновляем
						//ЗаполнитьЗначенияСвойств(ЗначениеУзла[Индекс], НоваяСтрокаНастройки);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	// Сохраняем настройки в базе МС:
	// - общие настройки и значения главного узла (без ID_Узла) пишем одним вызовом
	// - узловые настройки пишем отдельным вызовом на каждый ID_Узла
	НастройкиКСохранению = Новый Структура;
	НастройкиКСохранению.Вставить("НастройкиОбменаСправочников", 					НастройкиОбменаСправочников);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Онлайн", 			НастройкиОтборовСправочников_Онлайн);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Интерактивный", 	НастройкиОтборовСправочников_Интерактивный);
	НастройкиКСохранению.Вставить("НастройкиОтборовСправочников_Автообмен", 		НастройкиОтборовСправочников_Автообмен);
	
	ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению, "");
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Онлайн_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Онлайн", КлючЗначение.Значение);
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ);
	КонецЦикла;
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Интерактивный_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Интерактивный", КлючЗначение.Значение);
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ);
	КонецЦикла;
	
	Для каждого КлючЗначение Из НастройкиОтборовСправочников_Автообмен_Узлы Цикл
		НастройкиКСохранениюУзла = Новый Структура;
		НастройкиКСохранениюУзла.Вставить("НастройкиОтборовСправочников_Автообмен", КлючЗначение.Значение);
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранениюУзла, КлючЗначение.Ключ);
	КонецЦикла;
	
	// Сохраняем узловые настройки в кэш
	ИзмененияВКэше = Новый Структура;
	ИзмененияВКэше.Вставить("НастройкиОбменаСправочников", 	 НастройкиОбменаСправочников);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Онлайн", 			НастройкиОтборовСправочников_Онлайн);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Интерактивный", 	НастройкиОтборовСправочников_Интерактивный);
	ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Автообмен", 		НастройкиОтборовСправочников_Автообмен);
	Если НЕ ПустаяСтрока(ID_ТекущегоУзла) Тогда
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Онлайн_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Онлайн", ЗначениеНастройки);
		КонецЕсли;
		
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Интерактивный_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Интерактивный", ЗначениеНастройки);
		КонецЕсли;
		
		ЗначениеНастройки = Неопределено;
		НастройкиОтборовСправочников_Автообмен_Узлы.Свойство(ID_ТекущегоУзла, ЗначениеНастройки);
		Если ЗначениеНастройки <> Неопределено Тогда
			ИзмененияВКэше.Вставить("НастройкиОтборовСправочников_Автообмен", ЗначениеНастройки);
		КонецЕсли;
	КонецЕсли;
	
	ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(ИзмененияВКэше);
	
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияНастройкиОбменаСправочников", 1003025002);
	пСтруктураНастроек.Вставить("ВерсияНастройкиОбменаСправочников", 1003025002);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Истина;	
	
КонецФункции

// Миграция настроек справочников между новым и старым форматами:
//
// - ВерсияСтруктурыНастроек_ПоУмолчанию отсутствует (ключ не задан) - поддерживается совместимость НастройкиОбменаСправочников с ОО 1.7.0.
//    При подключении к старой базе при каждой инициализации выполняется обновление 1_3_25_2.
//    Это необходимо для актуализации узловых настроек НастройкиОтборовСправочников 
//		из НастройкиОбменаСправочников на случай, если они были изменены в старых версиях ОО.
//
// - ВерсияСтруктурыНастроек_ПоУмолчанию = 2 - поддержка старого формата прекращена, считается, что выполнен полный переход на ОО 2.0.
//    При подключении к базе версии 2.0 обновление выполняется один раз.
//
&НаКлиенте
Функция ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5(пСтруктураНастроек)
	
	ИмяСобытия = "ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_2_1_0_5";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пСтруктураНастроек",
		пСтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ВерсияСтруктурыНастроек_ПоУмолчанию = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияСтруктурыНастроек_ПоУмолчанию");
	ВерсияСтруктурыНастроек_ПоУмолчанию = ЛокЯдро_НормализоватьВерсиюВЧисло(ВерсияСтруктурыНастроек_ПоУмолчанию);
	
	Если ВерсияСтруктурыНастроек_ПоУмолчанию < 2000000001 Тогда
		
		// ДатаАктуальностиМиграцииНастроек — дублирует ДатаАктуальностиКэшируемыхНастроек.
		// Используется для отслеживания запуска старых версий ОО.
		// Если даты не совпадают, значит выполнялся запуск версии ОО 1.7.0, и будет произведена повторная миграция настроек.
		
		ДатаАктуальностиМиграцииНастроек = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ДатаАктуальностиМиграцииНастроек");
		Если ТипЗнч(ДатаАктуальностиМиграцииНастроек) = Тип("Строка") Тогда
			ДатаАктуальностиМиграцииНастроек = REST_API_ПреобразоватьКДате(ДатаАктуальностиМиграцииНастроек);
		КонецЕсли;
		
		Если ТипЗнч(ДатаАктуальностиМиграцииНастроек) = Тип("Дата") Тогда
			
			ПараметрыПодключенияMS = КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
			Если ПараметрыПодключенияMS = Неопределено Тогда
				ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();	
			КонецЕсли;
			
			ИдентификаторБазыMS = "";
			Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
				ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), СтрЗаменить(ПараметрыПодключенияMS.Ид, "-", "_"), "");
			КонецЕсли;
			
			СохраненнаяДатаАктуальности = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ДатаАктуальностиКэшируемыхНастроек_" + ИдентификаторБазыMS);
			
			Если ЗначениеЗаполнено(СохраненнаяДатаАктуальности)
				И СохраненнаяДатаАктуальности <> Ложь 
				И ДатаАктуальностиМиграцииНастроек < СохраненнаяДатаАктуальности Тогда
				
				ЛокЯдро_ВыполнитьОбновлениеНастроекОбменаСправочников_1_3_25_2(пСтруктураНастроек);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияНастройкиОбменаСправочников", 2001000005);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ПроверитьАктуальностьСтруктурыАтрибутов()

	ИмяСобытия = "ЛокЯдро_ПроверитьАктуальностьСтруктурыАтрибутов";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	ВерсияAPI = REST_API_ПолучитьВерсиюAPI();
	
	Если ВерсияAPI = 1 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало';
						|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеАтрибутов_ВерсияСтруктурыАтрибутов");
	ВерсияОбработки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ВерсияСтруктурыАтрибутов_ПоУмолчанию", Ложь);
	СтруктураНастроек.Вставить("ВерсияСтруктурыАтрибутов_Пользовательские", Ложь);
	
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек);
	
	ВерсияСтруктурыАтрибутов_ПоУмолчанию = СтруктураНастроек.ВерсияСтруктурыАтрибутов_ПоУмолчанию;
	ВерсияСтруктурыАтрибутов_Пользовательские = СтруктураНастроек.ВерсияСтруктурыАтрибутов_Пользовательские;
	
	Если ТипЗнч(ВерсияСтруктурыАтрибутов_Пользовательские) = Тип("Строка") Тогда
		ВерсияСтруктурыАтрибутов_Пользовательские = ЛокЯдро_КонвертироватьВерсиюВЧисло(ВерсияСтруктурыАтрибутов_Пользовательские);
	КонецЕсли;
	
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_ПоУмолчанию",	ВерсияСтруктурыАтрибутов_ПоУмолчанию);
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияСтруктурыАтрибутов_Пользовательские);
	
	
	ВерсияОбработкиЧислом = ЛокЯдро_КонвертироватьВерсиюВЧисло(ВерсияОбработки);
	
	Если НЕ ЗначениеЗаполнено(ВерсияСтруктурыАтрибутов_ПоУмолчанию)
		ИЛИ ВерсияСтруктурыАтрибутов_ПоУмолчанию = Ложь Тогда
		ВерсияСтруктурыАтрибутов_ПоУмолчанию = 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВерсияСтруктурыАтрибутов_Пользовательские)
		ИЛИ ВерсияСтруктурыАтрибутов_Пользовательские = Ложь Тогда
		ВерсияСтруктурыАтрибутов_Пользовательские = 0;
	КонецЕсли;
	
	Если ВерсияОбработкиЧислом < ВерсияСтруктурыАтрибутов_ПоУмолчанию
		ИЛИ ВерсияОбработкиЧислом < ВерсияСтруктурыАтрибутов_Пользовательские Тогда
		ТекстОшибки = НСтр("ru = 'Версия настроек в базе Клеверенс выше версии текущей основной обработки!'");
		
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Версию структуры атрибутов в пользовательских настройках поднимаем до версии текущей основной обработки, но не выше версии в настройках по умолчанию
	Если ВерсияСтруктурыАтрибутов_ПоУмолчанию = 0 Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если ВерсияОбработкиЧислом > ВерсияСтруктурыАтрибутов_Пользовательские Тогда
		Попытка
			ВерсияНастроекКонечная = Мин(ВерсияОбработкиЧислом, ВерсияСтруктурыАтрибутов_ПоУмолчанию);
			
			Если НЕ ВерсияСтруктурыАтрибутов_Пользовательские = ВерсияНастроекКонечная Тогда
				ЛокЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления(ВерсияСтруктурыАтрибутов_Пользовательские, ВерсияОбработкиЧислом);
			КонецЕсли;
		Исключение
			
			// <Лог>
			ИнфоОшибка = ИнформацияОбОшибке();
			ЯзСтрока = "ru = 'Ошибка при обновлении структуры атрибутов.'";
			ТекстОшибки = НСтр(ЯзСтрока);
			
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока,, ИнфоОшибка);
			// </Лог>
			
		КонецПопытки;
	КонецЕсли;
		
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	пСообщение = НСтр("ru = 'Конец';
						|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ОбновлениеАтрибутов_МассивПереходныхВерсий()
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеАтрибутов_МассивПереходныхВерсий");
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);

КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОбновлениеАтрибутов_РазницаСтруктур(СоответствиеАтрибутов1, СоответствиеАтрибутов2)

	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("СоответствиеАтрибутов1", СоответствиеАтрибутов1);
	ПараметрыМетода.Вставить("СоответствиеАтрибутов2", СоответствиеАтрибутов2);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеАтрибутов_РазницаСтруктур");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления(ВерсияНастроекНачальная, ВерсияНастроекКонечная)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеАтрибутов_ВыполнитьОбработчикОбновления";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ВерсияНастроекНачальная,ВерсияНастроекКонечная",
		ВерсияНастроекНачальная, ВерсияНастроекКонечная);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураАтрибутовНачальная = ЛокЯдро_СобратьСтруктуруАтрибутов(ВерсияНастроекНачальная);
	СтруктураАтрибутовКонечная 	= ЛокЯдро_СобратьСтруктуруАтрибутов(ВерсияНастроекКонечная);
	
	ОбновляемыеНастройки = ЛокЯдро_ОбновлениеАтрибутов_РазницаСтруктур(СтруктураАтрибутовНачальная, СтруктураАтрибутовКонечная);
	
	Если НЕ ОбновляемыеНастройки.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Ложь);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Ложь;
	КонецЕсли;
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	НастройкиПоУмолчанию = КатегорииНастроекMS.НастройкиПоУмолчанию;
	НастройкиСАтрибутами = КатегорииНастроекMS.НастройкиСАтрибутами;
	УзловыеНастройки 	 = КатегорииНастроекMS.УзловыеНастройки;
	
	// Получение значений настроек для перезаписи (главный узел)
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Узлы", Ложь);
	Для каждого КлючНастройки ИЗ НастройкиСАтрибутами Цикл
		Если НЕ НастройкиПоУмолчанию.Найти(КлючНастройки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Позиция_ = ЛокЯдро_СтрНайти(КлючНастройки, "_");
		Если Позиция_ Тогда
			КлючДляФильтрации = Лев(КлючНастройки, Позиция_ - 1);
			Если ОбновляемыеНастройки.Найти(КлючДляФильтрации) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураНастроек.Вставить(КлючНастройки, Ложь);
	КонецЦикла;
	
	ПараметрыЗаполненияНастроек = Новый Структура;
	ПараметрыЗаполненияНастроек.Вставить("НеКэшировать", 			Истина);
	ПараметрыЗаполненияНастроек.Вставить("НеПроверятьАктуальность", Истина);
	ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS",		СтруктураАтрибутовНачальная);
	СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек,,
		ПараметрыЗаполненияНастроек);
	
	СтруктураНастроекДляИдентификаторов = Новый Структура;
	
	НастройкиКЗаписи = Новый Структура;
	Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
		Если СтрокаНастройки.Ключ = "Узлы"
			ИЛИ СтрокаНастройки.Значение = Ложь Тогда
			Продолжить;
		КонецЕсли;
		НастройкиКЗаписи.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		
		СтруктураНастроекДляИдентификаторов.Вставить(СтрокаНастройки.Ключ, Неопределено);
	КонецЦикла;
	
	СоответствиеНастроекПоУзлам = Новый Соответствие;
	СоответствиеНастроекПоУзлам.Вставить("ГлавныйУзел", НастройкиКЗаписи);
	
	// Получение идентификаторов настроек для удаления (главный узел)
	ПараметрыПолученияИдентификаторов = Новый Структура;
	ПараметрыПолученияИдентификаторов.Вставить("НеПроверятьАктуальность", Ложь);
	ПараметрыПолученияИдентификаторов.Вставить("АтрибутыНастроекMS",	  СтруктураАтрибутовНачальная);
	ИдентификаторыНастроек = ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроекДляИдентификаторов,,
		ПараметрыПолученияИдентификаторов);
		
	НастройкиКУдалению = Новый Структура;
	Для каждого ИдентификаторНастройки ИЗ ИдентификаторыНастроек Цикл
		Если ИдентификаторНастройки.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НастройкиКУдалению.Вставить(ИдентификаторНастройки.Ключ, ИдентификаторНастройки.Значение);
	КонецЦикла;
	
	СоответствиеИдентификаторовПоУзлам = Новый Соответствие;
	СоответствиеИдентификаторовПоУзлам.Вставить("ГлавныйУзел", НастройкиКУдалению);	
	
	ВсеУзлы = СтруктураНастроек.Узлы;
	
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для каждого СтрокаУзла ИЗ ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// Получение значений настроек для перезаписи (торговые объекты)
			СтруктураНастроек = Новый Структура;
			Для каждого КлючНастройки ИЗ УзловыеНастройки Цикл
				// При первом обновлении структуры атрибутов пересохраняем все узловые настройки, при последующих - только атрибутивные
				Если НЕ СтруктураАтрибутовНачальная = Неопределено Тогда
					Позиция_ = ЛокЯдро_СтрНайти(КлючНастройки, "_");
					Если Позиция_ Тогда
						КлючДляФильтрации = Лев(КлючНастройки, Позиция_ - 1);
						Если ОбновляемыеНастройки.Найти(КлючДляФильтрации) = Неопределено Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				СтруктураНастроек.Вставить(КлючНастройки, Ложь);
			КонецЦикла;
			
			ПараметрыЗаполненияНастроек = Новый Структура;
			ПараметрыЗаполненияНастроек.Вставить("НеКэшировать", 			Истина);
			ПараметрыЗаполненияНастроек.Вставить("НеПроверятьАктуальность", Истина);
			ПараметрыЗаполненияНастроек.Вставить("АтрибутыНастроекMS",		СтруктураАтрибутовНачальная);
			СтруктураНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(СтруктураНастроек, СтрокаУзла.ID_Узла,
				ПараметрыЗаполненияНастроек);
	
			СтруктураНастроекДляИдентификаторов = Новый Структура;	
				
			НастройкиКЗаписи = Новый Структура;	
			Для каждого СтрокаНастройки ИЗ СтруктураНастроек Цикл
				Если СтрокаНастройки.Значение = Ложь Тогда
					Продолжить;
				КонецЕсли;
				НастройкиКЗаписи.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
				
				СтруктураНастроекДляИдентификаторов.Вставить(СтрокаНастройки.Ключ, Неопределено);
			КонецЦикла;
			
			СоответствиеНастроекПоУзлам.Вставить(СтрокаУзла.ID_Узла, НастройкиКЗаписи);	
			
			// Получение идентификаторов настроек для удаления (торговые объекты)
			ИдентификаторыНастроек = ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(СтруктураНастроекДляИдентификаторов,
				СтрокаУзла.ID_Узла, ПараметрыПолученияИдентификаторов);
				
			НастройкиКУдалению = Новый Структура;
			Для каждого ИдентификаторНастройки ИЗ ИдентификаторыНастроек Цикл
				Если ИдентификаторНастройки.Значение = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НастройкиКУдалению.Вставить(ИдентификаторНастройки.Ключ, ИдентификаторНастройки.Значение);
			КонецЦикла;
			
			СоответствиеИдентификаторовПоУзлам.Вставить(СтрокаУзла.ID_Узла, НастройкиКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	// Сохранение настроек в базе Mobile SMARTS (новые ключи)
	ПараметрыЗаписиНастроек = Новый Структура;
	ПараметрыЗаписиНастроек.Вставить("АтрибутыНастроекMS", СтруктураАтрибутовКонечная);
	
	Для каждого НастройкиУзла ИЗ СоответствиеНастроекПоУзлам Цикл
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиУзла.Значение, ?(НастройкиУзла.Ключ = "ГлавныйУзел", "", НастройкиУзла.Ключ),
			ПараметрыЗаписиНастроек);
	КонецЦикла;
	
	// Если новые настройки сохранены под прежними идентификаторами, удалять их нельзя
	ПараметрыПолученияИдентификаторов = Новый Структура;
	ПараметрыПолученияИдентификаторов.Вставить("НеПроверятьАктуальность", Истина);
	ПараметрыПолученияИдентификаторов.Вставить("НеИспользоватьАтрибуты",  Ложь);
	ПараметрыПолученияИдентификаторов.Вставить("АтрибутыНастроекMS",	  СтруктураАтрибутовКонечная);
	
	Для каждого НастройкиУзла ИЗ СоответствиеНастроекПоУзлам Цикл
		НовыеИдентификаторыНастроек = ЛокЯдро_ПолучитьИдентификаторыНастроекНаСервереSMARTS(НастройкиУзла.Значение,
			?(НастройкиУзла.Ключ = "ГлавныйУзел", "", НастройкиУзла.Ключ), ПараметрыПолученияИдентификаторов);
			
		СтарыеИдентификаторыНастроек = СоответствиеИдентификаторовПоУзлам.Получить(НастройкиУзла.Ключ);
		Если СтарыеИдентификаторыНастроек = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Для каждого ТекущаяНастройка ИЗ НовыеИдентификаторыНастроек Цикл
			Если СтарыеИдентификаторыНастроек.Свойство(ТекущаяНастройка.Ключ)
				И СтарыеИдентификаторыНастроек[ТекущаяНастройка.Ключ] = НовыеИдентификаторыНастроек[ТекущаяНастройка.Ключ] Тогда
				СтарыеИдентификаторыНастроек.Удалить(ТекущаяНастройка.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Удаление настроек в базе Mobile SMARTS (старые ключи)
	Для каждого ИдентификаторыУзла ИЗ СоответствиеИдентификаторовПоУзлам Цикл
		НастройкиКУдалению = ИдентификаторыУзла.Значение;
		
		REST_API_УдалитьНастройкиSMARTSПоИдентификаторам(НастройкиКУдалению);
	КонецЦикла;
	
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияНастроекКонечная);
	КомЯдро_СохранитьЗначениеПеременной("ВерсияСтруктурыАтрибутов_Пользовательские", ВерсияНастроекКонечная);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Истина);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

// Записывает новый файл, в который в последующем будут добавляться записи лога
//
// Возвращаемое значение:
//	Булево, Неопределено - при удачной записи возвращается значение Истина.
&НаКлиенте
Функция ЛокЯдро_ЗаписатьНачалоЛога(РабочийКаталог = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСистемнуюИнформациюДляШапкиЛога");	
	СисИнфо = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	ШапкаЛога 		= СисИнфо.ШапкаЛога;
	Если РабочийКаталог = Неопределено Тогда
		РабочийКаталог 	= СисИнфо.РабочийКаталог;
	КонецЕсли;
	
	ИмяФайлаОбщегоЛога = КомЯдро_ПолучитьЗначениеПеременной("ИмяФайлаОбщегоЛога");
	ИмяФайлаЛогаОшибок = КомЯдро_ПолучитьЗначениеПеременной("ИмяФайлаЛогаОшибок");
	Если ИмяФайлаЛогаОшибок = Неопределено
		Или ИмяФайлаЛогаОшибок = Неопределено Тогда
		ВызватьИсключение "Не удалось получить имя файла лога";
	КонецЕсли;
	
	ПутьКОбщемуЛогу = РабочийКаталог+ИмяФайлаОбщегоЛога+Формат(ТекущаяДата(),"ДФ=dd.MM.yy")+".txt";
	ПутьКЛогуОшибок = РабочийКаталог+ИмяФайлаЛогаОшибок+Формат(ТекущаяДата(),"ДФ=dd.MM.yy")+".txt";
	
	ЛогОбщий = Новый ЗаписьТекста(ПутьКОбщемуЛогу,КодировкаТекста.UTF8,,Ложь);
	ЛогОбщий.Записать(ШапкаЛога);
	ЛогОбщий.Закрыть();
	
	ЛогОшибок = Новый ЗаписьТекста(ПутьКЛогуОшибок,КодировкаТекста.UTF8,,Ложь);
	ЛогОшибок.Записать(ШапкаЛога);
	ЛогОшибок.Закрыть();
	
	КомЯдро_СохранитьЗначениеПеременной("ПутьКОбщемуЛогу",ПутьКОбщемуЛогу);
	КомЯдро_СохранитьЗначениеПеременной("ПутьКЛогуОшибок",ПутьКЛогуОшибок);
	
	Возврат Истина;
	
КонецФункции

// Выполняет запись события в файл лога в базе Клеверенс
//
// Параметры:
//	ПутьКФайлу - Строка - путь к файлу	
//  ТекстЗаписи - Строка - текст ошибки
//	СТаймштампом - Булево (необязательный) - с добавлением даты к тексту. Значение по умолчанию:Истина.
&НаКлиенте
Процедура ЛокЯдро_ДобавитьЗаписьВЛог(ПутьКФайлу, ТекстЗаписи,СТаймштампом = Истина) Экспорт
	
	ФайлЛога = Новый Файл(ПутьКФайлу);
	Если Не ФайлЛога.Существует() Тогда
		Возврат;
	Конецесли;
	
	ВремяСобытия = Формат(ТекущаяДата(),"ДЛФ=DT");
	
	ЗаписьЛога = Новый ЗаписьТекста(ПутьКФайлу,КодировкаТекста.UTF8,,Истина);
	ЗаписьЛога.ЗаписатьСтроку(?(СТаймштампом,ВремяСобытия+Символы.Таб,"")+ТекстЗаписи);
	ЗаписьЛога.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_УдалитьФайлЛога(ПутьКФайлу) Экспорт
	
	ФайлЛога = Новый Файл(ПутьКФайлу);
	Если Не ФайлЛога.Существует() Тогда
		Возврат;
	Конецесли;
	
	УдалитьФайлы(ПутьКФайлу);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОтправитьЛогПоПочте(ПутьКФайлу, ПараметрыОтправкиПочты) Экспорт
	
	#Область НесовместимыйКодFresh
	
	Если ПараметрыОтправкиПочты = Неопределено Тогда
		Возврат;
	Конецесли;
	МассивПолучателей 	= ПараметрыОтправкиПочты.МассивПолучателей;				
	АдресSMTP 			= ПараметрыОтправкиПочты.АдресSMTP;
	ПортSMTP 			= ПараметрыОтправкиПочты.ПортSMTP;
	ЛогинSMTP 			= ПараметрыОтправкиПочты.ЛогинSMTP;
	ПарольSMTP 			= ПараметрыОтправкиПочты.ПарольSMTP;
	ОтправительSMTP 	= ПараметрыОтправкиПочты.ОтправительSMTP;
	
	Если МассивПолучателей.Количество() = 0 
		Или Не ЗначениеЗаполнено(АдресSMTP) 
		Или Не ЗначениеЗаполнено(ПортSMTP)
		Или Не ЗначениеЗаполнено(ЛогинSMTP)
		Или Не ЗначениеЗаполнено(ПарольSMTP) Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСистемнуюИнформациюДляШапкиЛога");	
	СисИнфо = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Профиль = Вычислить("Новый ИнтернетПочтовыйПрофиль");				
	Профиль.АдресСервераSMTP 	= АдресSMTP;
	Профиль.ПортSMTP 			= ПортSMTP;
	Профиль.ПользовательSMTP 	= ЛогинSMTP;
	Профиль.ПарольSMTP 			= ПарольSMTP;
	Профиль.ИспользоватьSSLSMTP = Истина;
	Профиль.АутентификацияSMTP 	= Вычислить("СпособSMTPАутентификации.Login");
	
	Если ОтправительSMTP =  "" Тогда
		ОтправительSMTP = "autotest1c@cleverence.ru";
	КонецЕсли;
	
	Письмо = Вычислить("Новый ИнтернетПочтовоеСообщение");
	Текст = Письмо.Тексты.Добавить("Ошибки занесены в лог-файл во вложении, ознакомьтесь и передайте разработчикам!");
	Текст.ТипТекста = Вычислить("ТипТекстаПочтовогоСообщения.ПростойТекст");
	Письмо.Тема = "Автотесты 1С: Ошибка при прохождении тестов в базе "+СисИнфо.ИнформацияСтруктурой.Имябазы1С; 
	Письмо.Отправитель = ОтправительSMTP;		
	Для Каждого Получатель Из МассивПолучателей Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла;
	
	Письмо.Вложения.Добавить(ПутьКФайлу);
	
	Почта = Вычислить("Новый ИнтернетПочта");
	ЕстьПодключениеКПочтовомуСерверу = Истина;
	Попытка
		Почта.Подключиться(Профиль);		
	Исключение
		ЕстьПодключениеКПочтовомуСерверу = Ложь;
		ТекстОшибки = НСтр("ru = 'Не удалось подключиться к почтовому серверу';
							|en = 'Couldn''t connect to the mail server'; be = 'Не атрымалася падлучыцца да паштовага сервера'; es = 'No se pudo conectar al servidor de correo'; ka = 'ფოსტის სერვერთან დაკავშირება ვერ მოხერხდა'; kk = 'Пошта серверіне қосылу мүмкін болмады'; ro = 'Nu s-a putut conecta la serverul de e-mail'; tr = 'Posta sunucusuna bağlanılamadı'; uk = 'Не вдалося підключитися до поштового сервера'; uz = 'Pochta serveriga ulanib bo''lmadi'");
		ТекстОшибки = ТекстОшибки + ": " + ОписаниеОшибки(); 
		Сообщить(ТекстОшибки); 
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ОтправитьЛогПоПочте", "Ошибка", ТекстОшибки); 
	КонецПопытки;
	
	Если ЕстьПодключениеКПочтовомуСерверу Тогда
		Попытка
			РезультатОтправки = Почта.Послать(Письмо);		
		Исключение
			ТекстОшибки = НСтр("ru = 'Не удалось отправить письмо';
								|en = 'Couldn''t send email'; be = 'Не ўдалося адправіць ліст'; es = 'No se pudo enviar el correo'; ka = 'ელ. ფოსტის გაგზავნა ვერ მოხერხდა'; kk = 'Хат жіберу мүмкін болмады'; ro = 'Nu am putut trimite e-mail'; tr = 'Mektup gönderilemedi'; uk = 'Не вдалося надіслати лист'; uz = 'Xat yuborilmadi'");
			ТекстОшибки = ТекстОшибки + ": " + ОписаниеОшибки(); 
			Сообщить(ТекстОшибки); 
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ОтправитьЛогПоПочте", "Ошибка", ТекстОшибки); 
		КонецПопытки;
	КонецЕсли;
	
	Почта.Отключиться();
	
	#КонецОбласти //НесовместимыйКодFresh
	
КонецПроцедуры

// Выполняет запись событий из журнала регистрации с отбором по идентификатору автотеста в поле Данные
// в файл лога в базе Клеверенс
//
// Параметры:
//	ДанныеДляОтбораЖР 	- Строка - строка, по которой будет наложен отбор на записи журнала регистрации
//	МассивПолучателей 	- Массив - массив адресов эл почты, на которые необходимо отправить лог
//	ИмяКаталога 		- Строка - имя каталога, в который необходимо сохранить файл
//
&НаКлиенте
Процедура ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации(ДанныеДляОтбораЖР, ПараметрыОтправкиПочты = Неопределено, ИмяКаталога = Неопределено) Экспорт
			
	ИмяСобытия = "ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДанныеДляОтбораЖР,ПараметрыОтправкиПочты,ИмяКаталога",
		ДанныеДляОтбораЖР, ПараметрыОтправкиПочты, ИмяКаталога);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьДанныеЖурналаРегистрации");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДанныеДляОтбораЖР", ДанныеДляОтбораЖР);
	СтруктураВызова.Вставить("ПараметрыМетода", СтруктураПараметров);
	
	ДанныеЖурнала = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	ДанныеЖурналаОбщий = ДанныеЖурнала.ДанныеЖурналаОбщий;
	ДанныеЖурналаОшибки = ДанныеЖурнала.ДанныеЖурналаОшибки;
	
	ПутьКОбщемуЛогу = КомЯдро_ПолучитьЗначениеПеременной("ПутьКОбщемуЛогу");
	ПутьКЛогуОшибок = КомЯдро_ПолучитьЗначениеПеременной("ПутьКЛогуОшибок");
	
	Если ПутьКОбщемуЛогу <> Неопределено И ДанныеЖурналаОбщий <> "" Тогда
		ЛокЯдро_ДобавитьЗаписьВЛог(ПутьКОбщемуЛогу,ДанныеЖурналаОбщий,Ложь);						
	КонецЕсли;
	
	Если ПутьКЛогуОшибок <> Неопределено Тогда 
		Если ДанныеЖурналаОшибки <> "" Тогда
			ЛокЯдро_ДобавитьЗаписьВЛог(ПутьКЛогуОшибок,ДанныеЖурналаОшибки,Ложь);				
			ЛокЯдро_ОтправитьЛогПоПочте(ПутьКЛогуОшибок, ПараметрыОтправкиПочты);				
		Иначе
