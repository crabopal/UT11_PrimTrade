#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_ОбновлениеКомпонент

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ОбновитьПриПервомПодключении(пПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ОбновитьПриПервомПодключении";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрыВыполнения",
		пПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	ПараметрыВыполнения = ЛокЯдро_ОбновлениеКомпонент_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыВыполнения, пПараметрыВыполнения);
	
	ПараметрыВыполнения.ПервыйЗапуск = Истина;
	ПараметрыВыполнения.ПроверятьАктуальностьВерсии = Ложь;
	
	ЛокЯдро_ОбновлениеКомпонент_Начало(ПараметрыВыполнения);
	
	пСообщение = НСтр("ru = 'Конец.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

