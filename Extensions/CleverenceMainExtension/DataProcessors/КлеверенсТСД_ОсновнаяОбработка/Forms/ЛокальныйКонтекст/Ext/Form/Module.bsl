&НаКлиенте
Функция ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла = "") Экспорт

	ИмяСобытия = "ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НастройкаБП,ID_Узла",
		НастройкаБП, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Определяем, разрешено ли проведение документа
	Попытка
		МетаданныеДокумента = СтруктураМетаданных.Документы1С[НастройкаБП.ТипИсходногоДокумента1С];
		
		ПроведениеДокумента = ?(МетаданныеДокумента.Свойство("Проведение"), МетаданныеДокумента.Проведение, Ложь);
		СинонимДокумента	= ?(МетаданныеДокумента.Свойство("Синоним"), 	МетаданныеДокумента.Синоним, 	НастройкаБП.ТипИсходногоДокумента1С);
	Исключение
		пСообщение = НСтр("ru = 'Не удалось получить метаданные документа 1С по типу исходного документа.%1 Причина: %2';
							|en = 'It was not possible to get the metadata of the 1C document by the type of the source document.%1 Reason: %2';
							|be = 'Не атрымалася атрымаць метададзеныя дакумента 1С па тыпу зыходнага дакумента.%1 Прычына: %2'; es = 'No se pudieron obtener los metadatos del documento 1C por tipo de documento de origen.% 1 Causa: %2'; ka = 'შეუძლებელი იყო 1c დოკუმენტის მეტამონაცემების მიღება წყაროს დოკუმენტის ტიპის მიხედვით.%1 მიზეზი: %2'; kk = 'Бастапқы құжат түрі бойынша 1С құжатының метадеректерін алу мүмкін болмады.%1 себеп: %2'; ro = 'Nu a fost posibilă obținerea metadatelor documentului 1C după tipul documentului sursă.% 1 motiv: %2'; tr = '1C belgesinin meta verilerini kaynak belgenin türüne göre alamadım.%1 Sebep: %2'; uk = 'Не вдалося отримати метадані документа 1С за типом вихідного документа.% 1 Причина: %2'; uz = '1C hujjatining metama''lumotlarini asl hujjat turiga qarab olish mumkin emas edi.%1 sababi: %2'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, Символы.ПС, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		
		ПроведениеДокумента = Ложь;
		СинонимДокумента	= НастройкаБП.ТипИсходногоДокумента1С;
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Неопределено);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Неопределено;
	КонецПопытки;
	
	// Получаем настройки компоновщика по умолчанию
	АдресСхемыСКД = ЛокЯдро_ПолучитьКомпоновкуСКДДляОтбораДокументов1С(НастройкаБП.ТипИсходногоДокумента1С, ID_Узла);
	
	НастройкаКомпоновщикаСтрокой = ЛокЯдро_СформироватьНастройкиКомпоновщикаДляОтбораПоУмолчанию(АдресСхемыСКД, ПроведениеДокумента);
	
	// Формируем структуру настройки по умолчанию
	СтрокаНастройки = Новый Структура;
	СтрокаНастройки.Вставить("ID_БизнесПроцесса",               НастройкаБП.ID_БизнесПроцесса);
	СтрокаНастройки.Вставить("Название",                        НастройкаБП.Название);
	СтрокаНастройки.Вставить("ТипИсходногоДокумента1С",         НастройкаБП.ТипИсходногоДокумента1С);
	СтрокаНастройки.Вставить("ТипИсходногоДокумента1С_Синоним", СинонимДокумента);
	СтрокаНастройки.Вставить("НастройкаКомпоновщикаСтрокой",    НастройкаКомпоновщикаСтрокой);
	СтрокаНастройки.Вставить("Используется", 					Истина);	
	СтрокаНастройки.Вставить("ВариантОтбора",    				"Только конструктор");
	СтрокаНастройки.Вставить("ID_ПроизвольногоОтбора",   	 	"");
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтрокаНастройки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтрокаНастройки;
	
КонецФункции

&НаСервере
Функция ЛокЯдро_СформироватьНастройкиКомпоновщикаДляОтбораПоУмолчанию(АдресСхемыСКД, ПроведениеРазрешено)

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));	
	
	Для каждого ЭлПараметр из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		Если ЭлПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ГлубинаОтбора") Тогда
			ЭлПараметр.Использование = Истина;
			ЭлПараметр.ПредставлениеПользовательскойНастройки = "Глубина отбора (количество в днях)";
			ЭлПараметр.Значение = 10;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	НовыйОтбор = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйОтбор.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	НовыйОтбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	НовыйОтбор.ПравоеЗначение	= Ложь;
	НовыйОтбор.Использование	= Истина;

	Если ПроведениеРазрешено Тогда
		НовыйОтбор = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйОтбор.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Проведен");
		НовыйОтбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
		НовыйОтбор.ПравоеЗначение	= Истина;
		НовыйОтбор.Использование	= Истина;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, КомпоновщикНастроек.ПолучитьНастройки(), НазначениеТипаXML.Явное);
	НастройкаКомпоновщикаСтрокой = ЗаписьXML.Закрыть();
	
	Возврат НастройкаКомпоновщикаСтрокой;
	
КонецФункции

// Удаляет отборы бизнес-процесса для всех узлов по переданному ID_БизнесПроцесса.
// Если ID_БизнесПроцесса = Неопределено, удаляет все отборы, для которых не найдены бизнес-процессы.
// 
// Параметры:
//	ID_БизнесПроцесса - Строка, Неопределено - ID бизнес-процесса, отборы которого требуется удалить.
//	
&НаКлиенте
Процедура ЛокЯдро_УдалитьОтборыБизнесПроцессов(ID_БизнесПроцесса = Неопределено) Экспорт

	ИмяСобытия = "ЛокЯдро_УдалитьОтборыБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_БизнесПроцесса",
		ID_БизнесПроцесса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	УдалениеПоID = НЕ ID_БизнесПроцесса = Неопределено;
	
	Если НЕ УдалениеПоID Тогда
		НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
		Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда
			// Пока не будем удалять все отборы при отсутствии настроек бизнес-процессов в кэше (на случай если потеряли в кэше, а не удалили все полностью)
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	МассивУзлов = Новый Массив;
	МассивУзлов.Добавить("");
	
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			МассивУзлов.Добавить(СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;	
	
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		Для каждого ID_ОбрабатываемогоУзла ИЗ МассивУзлов Цикл
			ЭтоТекущийУзел = ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И (ID_ОбрабатываемогоУзла = ДанныеТекущегоУзла.ID_Узла);
			Если ЭтоТекущийУзел Тогда
				НастройкиОтборов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
			Иначе
				НастройкиОтборов = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_ОбрабатываемогоУзла);
			КонецЕсли;
			
			Если ТипЗнч(НастройкиОтборов) = Тип("Массив") Тогда
				ИндексыКУдалению = Новый СписокЗначений;
				
				Индекс = 0;
				Для Каждого СтрокаНастройки Из НастройкиОтборов Цикл
					Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
						Индекс = Индекс + 1;
						Продолжить;
					КонецЕсли;
					
					Если НЕ УдалениеПоID Тогда
						// Проверяем на наличие бизнес-процесса
						СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
						
						МассивБизнесПроцессов = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов, СтруктураОтбора);
						Если МассивБизнесПроцессов = Неопределено Тогда
							ИндексыКУдалению.Добавить(Индекс);
						КонецЕсли;
					Иначе
						// Проверяем на совпадение с переданным ID_БизнесПроцесса
						Если СтрокаНастройки.ID_БизнесПроцесса = ID_БизнесПроцесса Тогда
							ИндексыКУдалению.Добавить(Индекс);
							Прервать;	
						КонецЕсли;	
					КонецЕсли;
						
					Индекс = Индекс + 1;
				КонецЦикла;
				
				Если ИндексыКУдалению.Количество() Тогда
					ИндексыКУдалению.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
					Для каждого Индекс ИЗ ИндексыКУдалению Цикл
						НастройкиОтборов.Удалить(Индекс.Значение);
					КонецЦикла;
					
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов, ID_ОбрабатываемогоУзла);
					
					Если ЭтоТекущийУзел Тогда
						ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
    КонецЦикла;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Редактирует отборы бизнес-процесса для всех узлов по переданному ID_БизнесПроцесса.
// 
// Параметры:
//	ID_БизнесПроцесса - Строка - ID бизнес-процесса, отборы которого требуется изменить.
//	СтруктураНастроек - Структура:
//		Ключ - ключ настройки отбора, который требуется изменить.
//		Значение - новое значение ключа настройки отбора.
&НаКлиенте
Процедура ЛокЯдро_ИзменитьОтборыБизнесПроцессов(ID_БизнесПроцесса, СтруктураНастроек) Экспорт

	ИмяСобытия = "ЛокЯдро_ИзменитьОтборыБизнесПроцессов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_БизнесПроцесса,СтруктураНастроек",
		ID_БизнесПроцесса, СтруктураНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	МассивУзлов = Новый Массив;
	МассивУзлов.Добавить("");
	
	ВсеУзлы = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			МассивУзлов.Добавить(СтрокаУзла.ID_Узла);
		КонецЦикла;
	КонецЕсли;
	
	РежимыОбмена = Новый Массив;
	РежимыОбмена.Добавить("Интерактивный");
	РежимыОбмена.Добавить("Онлайн");
	
	Для каждого РежимОбмена ИЗ РежимыОбмена Цикл
		Для каждого ID_ОбрабатываемогоУзла ИЗ МассивУзлов Цикл
			ЭтоТекущийУзел = ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И (ID_ОбрабатываемогоУзла = ДанныеТекущегоУзла.ID_Узла);
			Если ЭтоТекущийУзел Тогда
				НастройкиОтборов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена);
			Иначе
				НастройкиОтборов = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, ID_ОбрабатываемогоУзла);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НастройкиОтборов) ИЛИ НастройкиОтборов = Ложь Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныеСтроки = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиОтборов, Новый Структура("ID_БизнесПроцесса", ID_БизнесПроцесса));
			Если НайденныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
				
			НастройкаОтбора = НайденныеСтроки[0];
			Для каждого НоваяНастройка ИЗ СтруктураНастроек Цикл
				НастройкаОтбора.Вставить(НоваяНастройка.Ключ, НоваяНастройка.Значение);
			КонецЦикла;
			
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов, ID_ОбрабатываемогоУзла);
					
			Если ЭтоТекущийУзел Тогда
				ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + РежимОбмена, НастройкиОтборов);
			КонецЕсли;
		КонецЦикла;
    КонецЦикла;	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьСтруктуруИменРасширений() Экспорт

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСтруктуруИменРасширений");
	
	СтруктураИменРасширений = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	Возврат СтруктураИменРасширений;	
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПостфиксРасширенияMain()

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьПостфиксРасширенияMain");
	
	ПостфиксРасширенияMain = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Возврат ПостфиксРасширенияMain;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ПолучитьПостфиксРасширенияSSL()

	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
