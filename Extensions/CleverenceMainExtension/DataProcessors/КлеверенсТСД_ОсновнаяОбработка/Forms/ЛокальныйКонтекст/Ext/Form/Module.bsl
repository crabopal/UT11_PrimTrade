// Записывает шапку файла лога в который в последующем будут добавляться записи лога
//
// Возвращаемое значение:
//	Булево - при удачной записи возвращается значение Истина.
&НаКлиенте
Функция ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога = Неопределено) Экспорт
	
	Попытка
		КомЯдро_СохранитьЗначениеПеременной("ИмяФайлаОбщегоЛога", ИмяФайлаОбщегоЛога);
		КомЯдро_СохранитьЗначениеПеременной("ИмяФайлаЛогаОшибок", ИмяФайлаЛогаОшибок);
		
		ШапкаЛогаЗаписана = ЛокЯдро_ЗаписатьНачалоЛога(ИмяКаталога);
	Исключение
		ШапкаЛогаЗаписана = Ложь;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = НСтр("ru = 'Не удалось записать файл лога журнала регистрации за период, Описание ошибки: %1';
							|en = 'Failed to write log log file for the period, Error description: %1';
							|be = 'Не атрымалася запісаць файл лога часопіса рэгістрацыі за перыяд, апісанне памылкі: %1'; es = 'No se pudo escribir el archivo de registro de registro del período, Descripción del error: %1'; ka = 'ვერ მოხერხდა ჟურნალის ჟურნალის ფაილის დაწერა პერიოდისთვის, შეცდომის აღწერა: %1'; kk = 'Кезең ішінде тіркеу журналының журнал файлын жазу мүмкін болмады, қате сипаттамасы: %1'; ro = 'Nu s-a scris fișierul jurnal jurnal pentru perioada respectivă, descrierea erorii: %1'; tr = 'Dönem için günlük kaydı günlüğü dosyası yazılamadı, Hatanın açıklaması: %1'; uk = 'Не вдалося записати файл журналу журналу реєстрації за період, опис помилки: %1'; uz = 'Davr uchun log log faylini yozib bo''lmadi, xato tavsifi: %1'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТекстОшибки);
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("Автотесты_ЗаписатьЗаголовокЛогаЖРЗаПериод", "Ошибка", пСообщение);		
	КонецПопытки;
	
	Возврат ШапкаЛогаЗаписана;
	
КонецФункции

