Процедура ЛокЯдро_ПолучитьНастройкиИзФайлаЗавершение(МассивФайлов, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьНастройкиИзФайлаЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивФайлов,ДополнительныеПараметры",
