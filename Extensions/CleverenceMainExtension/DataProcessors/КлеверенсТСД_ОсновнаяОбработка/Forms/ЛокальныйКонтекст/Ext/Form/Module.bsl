&НаКлиенте
Функция ЛокЯдро_ОбновлениеКомпонент_СтруктураПараметровВызова() Экспорт
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ПервыйЗапуск", 					Ложь);
	ПараметрыВыполнения.Вставить("ПроверятьАктуальностьПостфикса", 	Ложь);
	ПараметрыВыполнения.Вставить("ПроверятьАктуальностьВерсии", 	Ложь); // Ложь - принудительное обновление. Истина - проверка версии и постфикса.
	ПараметрыВыполнения.Вставить("ЭтоТестКлиент", 					Ложь);
	ПараметрыВыполнения.Вставить("ДополнительныеПараметры");
	ПараметрыВыполнения.Вставить("ОповещениеОбработкиЗавершения");
	Возврат ПараметрыВыполнения;
	
КонецФункции 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_Начало(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_Начало";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();	
	КонецЕсли;
	
	// Версии приложений
	ВерсияПриложенияАктуальная = Неопределено;
	ПараметрыПодключенияMS.Свойство("ВерсияПриложения", ВерсияПриложенияАктуальная);
	Если НЕ ЗначениеЗаполнено(ВерсияПриложенияАктуальная) Тогда
		
		// <Лог>
		ЯзСтрока = "ru = 'Отмена обновления компонент. В ПараметрыПодключенияMS не заполнена ВерсияПриложения.'";
		пСообщение = НСтр(ЯзСтрока);
		
		ЛогОшибка(логСобытие, пСообщение, ЯзСтрока);
		// </Лог>
		
		ЛокЯдро_ОбновлениеКомпонент_Завершение(Ложь, ПараметрыВыполнения);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат; // Не удалось определить актуальную версию
	КонецЕсли;
	ПараметрыВыполнения.Вставить("ВерсияПриложенияАктуальная", ВерсияПриложенияАктуальная);
	
	ВерсияПриложенияИзНастроек = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияПриложения");
	ПараметрыВыполнения.Вставить("ВерсияПриложенияИзНастроек", ВерсияПриложенияИзНастроек);
	
	#Область НесовместимыйКодFresh
	Если ПараметрыВыполнения.ОповещениеОбработкиЗавершения = Неопределено Тогда
		ВызватьИсключение "ЛокЯдро_ОбновлениеКомпонент_Начало: Параметр ""ОповещениеОбработкиЗавершения"" обязателен для заполнения.";
	КонецЕсли;
	
	Если ПараметрыВыполнения.ЭтоТестКлиент = Истина Тогда
		ЛокЯдро_ОбновлениеКомпонент_Завершение(Ложь, ПараметрыВыполнения);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	// Получаем параметры для обновления компонент
	//	и список компонент, которые нужно обновить.
	пПараметрыВыполнения = ЛокЯдро_СкопироватьСтруктуру(ПараметрыВыполнения);
	пПараметрыВыполнения.Удалить("ОповещениеОбработкиЗавершения");
	пПараметрыВыполнения.Вставить("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ПараметрыВыполнения", пПараметрыВыполнения);
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеКомпонент_ПолучитьПараметрыПодключенияКомпонент");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	ПараметрыПодключенияКомпонент = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	ПараметрыВыполнения.Вставить("ПараметрыПодключенияКомпонент", ПараметрыПодключенияКомпонент);
	
	ПодключаемыеКомпоненты = ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты;
	
	Если ПодключаемыеКомпоненты.Количество() Тогда
		
		Если ПараметрыПодключенияКомпонент.РасширенияИспользуются Тогда
			ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширения(ПараметрыВыполнения);
			
		ИначеЕсли ПараметрыПодключенияКомпонент.ДопОбработкиИспользуются Тогда
			РезультатПодключенияРасширений = Новый Массив;
			ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработки(РезультатПодключенияРасширений, ПараметрыВыполнения);
			
		Иначе
			ЛокЯдро_ОбновлениеКомпонент_Завершение(Истина, ПараметрыВыполнения);
		КонецЕсли;
		
	Иначе
		ЛокЯдро_ОбновлениеКомпонент_Завершение(Истина, ПараметрыВыполнения);
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//ЛокЯдро_ОбновлениеКомпонент_Завершение(Истина, ПараметрыВыполнения);
	#КонецОбласти //СовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширения(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	ПараметрыПодключенияКомпонент 	= ПараметрыВыполнения.ПараметрыПодключенияКомпонент;
	ПодключаемыеКомпоненты 			= ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты;
	
	// Формируем список расширений к обновлению.
	РасширенияДляОбработкиВыбора = Новый Массив;
	Для каждого КлючЗначение Из ПодключаемыеКомпоненты Цикл
		СтруктураКомпоненты = КлючЗначение.Значение;
		Если СтруктураКомпоненты.РасширениеПодключено Тогда
			// Расширение уже подключено к базе и его необходимо обновить.
			РасширенияДляОбработкиВыбора.Добавить(СтруктураКомпоненты);
		КонецЕсли;
	КонецЦикла;
	
	ЭтоАвтотест = КомЯдро_ПолучитьЗначениеПеременной("Автотест") = Истина;
	
	Если НЕ ЭтоАвтотест
		И РасширенияДляОбработкиВыбора.Количество() <> 0 Тогда
		
		ЛокЯдро_ОбновлениеКомпонент_ОтфильтроватьРасширенияБезИзменений(ПараметрыВыполнения, РасширенияДляОбработкиВыбора);
		
		Если РасширенияДляОбработкиВыбора.Количество() <> 0 Тогда
			ПараметрыВыполнения.Вставить("РасширенияДляОбработкиВыбора", РасширенияДляОбработкиВыбора);
			ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширения(ПараметрыВыполнения);
		Иначе
			ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширенияПродолжить(ПараметрыВыполнения);
		КонецЕсли;
	Иначе
		ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширенияПродолжить(ПараметрыВыполнения);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Фильтрует список расширений для формы выбора обновлений по версии файла расширения.
//
// Параметры:
//  ПараметрыВыполнения - Структура - параметры сценария обновления компонент.
//  РасширенияДляОбработкиВыбора - Массив из Структура - расширения, доступные для выбора обновления.
//
&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ОтфильтроватьРасширенияБезИзменений(ПараметрыВыполнения, РасширенияДляОбработкиВыбора)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ОтфильтроватьРасширенияБезИзменений";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения,РасширенияДляОбработкиВыбора",
		ПараметрыВыполнения, РасширенияДляОбработкиВыбора);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	ПараметрыПодключенияКомпонент = ПараметрыВыполнения.ПараметрыПодключенияКомпонент;
	
	// Фильтр работает только с расширениями, которые уже были бы показаны в форме выбора.
	ИменаФайловРасширений = Новый Массив;
	Для Каждого СтруктураКомпоненты Из РасширенияДляОбработкиВыбора Цикл
		ИменаФайловРасширений.Добавить(СтруктураКомпоненты.ИмяФайлаРасширения);
	КонецЦикла;
	
	МассивФайловРасширений = Новый Массив;
	ИменаЗагруженныхФайловРасширений = Новый Массив;
	ЛокЯдро_ПолучитьФайлыРасширений(ИменаФайловРасширений, МассивФайловРасширений, ИменаЗагруженныхФайловРасширений);
	
	КоличествоФайловРасширений = МассивФайловРасширений.Количество();
	Для ИндексФайла = 0 По КоличествоФайловРасширений - 1 Цикл
		ФайлРасширения = МассивФайловРасширений[ИндексФайла];
		ИмяФайлаРасширения = ИменаЗагруженныхФайловРасширений[ИндексФайла];
		ФайлРасширения.Вставить("ИмяФайлаРасширения", ИмяФайлаРасширения);
	КонецЦикла;
	
	МассивСтабильныхФайловРасширений = Новый Массив;
	ИменаЗагруженныхСтабильныхФайловРасширений = Новый Массив;
	ЛокЯдро_ПолучитьФайлыРасширений(
		ПараметрыПодключенияКомпонент.ПодключаемыеРасширенияСтабильные,
		МассивСтабильныхФайловРасширений,
		ИменаЗагруженныхСтабильныхФайловРасширений);
	
	КоличествоСтабильныхФайловРасширений = МассивСтабильныхФайловРасширений.Количество();
	Для ИндексФайла = 0 По КоличествоСтабильныхФайловРасширений - 1 Цикл
		СтабильныйФайлРасширения = МассивСтабильныхФайловРасширений[ИндексФайла];
		ИмяСтабильногоФайлаРасширения = ИменаЗагруженныхСтабильныхФайловРасширений[ИндексФайла];
		СтабильныйФайлРасширения.Вставить("ИмяФайлаРасширения", ИмяСтабильногоФайлаРасширения);
		МассивФайловРасширений.Добавить(СтабильныйФайлРасширения);
	КонецЦикла;
	
	СвойстваФайловРасширений = ЛокЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов(МассивФайловРасширений);
	
	СвойстваСтабильныхФайловПоИмениРасширения = Новый Соответствие;
	Для Каждого СтабильныйФайлРасширения Из МассивСтабильныхФайловРасширений Цикл
		ИмяСтабильногоФайлаРасширения = СтабильныйФайлРасширения.ИмяФайлаРасширения;
		СвойстваСтабильногоФайла = СвойстваФайловРасширений.Получить(ИмяСтабильногоФайлаРасширения);
		Если СвойстваСтабильногоФайла <> Неопределено Тогда
			СвойстваСтабильныхФайловПоИмениРасширения.Вставить(
				СвойстваСтабильногоФайла.ИмяРасширения,
				СвойстваСтабильногоФайла);
		КонецЕсли;
	КонецЦикла;
	
	ФайлыРасширенийПредварительно = Новый Соответствие;
	Для Каждого ФайлРасширения Из МассивФайловРасширений Цикл
		ИмяФайлаРасширения = ФайлРасширения.ИмяФайлаРасширения;
		ФайлыРасширенийПредварительно.Вставить(ИмяФайлаРасширения, ФайлРасширения);
	КонецЦикла;
	ПараметрыПодключенияКомпонент.Вставить("ФайлыРасширенийПредварительно", ФайлыРасширенийПредварительно);
	
	// Расширение скрывается из выбора только при доказанном совпадении версии.
	// Если свойства файла не прочитались, расширение остается в списке обновления.
	РасширенияСИзменениями = Новый Массив;
	Для Каждого СтруктураКомпоненты Из РасширенияДляОбработкиВыбора Цикл
		СвойстваФайлаРасширения = СвойстваФайловРасширений.Получить(СтруктураКомпоненты.ИмяФайлаРасширения);
		Если СвойстваФайлаРасширения = Неопределено Тогда
			СвойстваФайлаРасширения = СвойстваСтабильныхФайловПоИмениРасширения.Получить(СтруктураКомпоненты.ИмяРасширения);
			Если СвойстваФайлаРасширения <> Неопределено Тогда
				СтруктураКомпоненты.Вставить(
					"ИмяФайлаРасширенияДляПодключения",
					СвойстваФайлаРасширения.ИмяФайлаРасширения);
			КонецЕсли;
		КонецЕсли;
		
		Если СвойстваФайлаРасширения = Неопределено Тогда
			РасширенияСИзменениями.Добавить(СтруктураКомпоненты);
			Продолжить;
		КонецЕсли;
		
		СтруктураКомпоненты.Вставить("СвойстваФайлаРасширения", СвойстваФайлаРасширения);
		
		ВерсияУстановленногоРасширения 		= СтруктураКомпоненты.СвойстваУстановленногоРасширения.Версия;
		ВерсияФайлаРасширения 				= СтруктураКомпоненты.СвойстваФайлаРасширения.Версия;
		ХешСуммаУстановленногоРасширения 	= СтруктураКомпоненты.СвойстваУстановленногоРасширения.ХешСумма;
		ХешСуммаФайлаРасширения 			= СтруктураКомпоненты.СвойстваФайлаРасширения.ХешСумма;
		
		КонфликтИзменений = ВерсияУстановленногоРасширения = ВерсияФайлаРасширения
			И ХешСуммаУстановленногоРасширения <> ХешСуммаФайлаРасширения;
		СтруктураКомпоненты.Вставить("КонфликтИзменений", КонфликтИзменений);
		
		Если ВерсияУстановленногоРасширения = ВерсияФайлаРасширения Тогда
			ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты.Удалить(СтруктураКомпоненты.ТипРасширения);
			Если СтруктураКомпоненты.ТипРасширения = "ОсновноеРасширение" Тогда
				ПараметрыПодключенияКомпонент.ПодключаемыеРасширенияСтабильные = Новый Массив;
			КонецЕсли;
		Иначе
			РасширенияСИзменениями.Добавить(СтруктураКомпоненты);
		КонецЕсли;
	КонецЦикла;
	
	// Форма выбора получает тот же массив из ПараметрыВыполнения, поэтому обновляем его на месте.
	РасширенияДляОбработкиВыбора.Очистить();
	Для Каждого СтруктураКомпоненты Из РасширенияСИзменениями Цикл
		РасширенияДляОбработкиВыбора.Добавить(СтруктураКомпоненты);
	КонецЦикла;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Получает свойства файлов расширений через серверный контекст.
//
// Параметры:
//  МассивФайловРасширений - Массив из Структура - см. ГлЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов.
//
// Возвращаемое значение:
//  Соответствие - см. ГлЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов.
//
&НаКлиенте
Функция ЛокЯдро_ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов(МассивФайловРасширений)
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеКомпонент_ПолучитьСвойстваРасширенийИзФайлов");
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("МассивФайловРасширений", МассивФайловРасширений);
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширения(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	РасширенияДляОбработкиВыбора = ПараметрыВыполнения.РасширенияДляОбработкиВыбора;
	
	СписокВыбора = Новый Массив;
	Для Каждого СтруктураКомпоненты Из РасширенияДляОбработкиВыбора Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Использовать", 			Истина);
		НоваяСтрока.Вставить("Представление", 			СтруктураКомпоненты.СвойстваУстановленногоРасширения.Синоним);
		НоваяСтрока.Вставить("УстановленнаяВерсия", 	СтруктураКомпоненты.СвойстваУстановленногоРасширения.Версия);
		НоваяСтрока.Вставить("Идентификатор", 			СтруктураКомпоненты.ТипРасширения);
		НоваяСтрока.Вставить("ДополнительныеПараметры", СтруктураКомпоненты);
		
		Если СтруктураКомпоненты.Свойство("СвойстваФайлаРасширения") Тогда
			НоваяСтрока.Вставить("НоваяВерсия", СтруктураКомпоненты.СвойстваФайлаРасширения.Версия);
		КонецЕсли;
		
		СписокВыбора.Добавить(НоваяСтрока);
	КонецЦикла;
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	КолонкиТаблицы = Новый Массив;
	КолонкиТаблицы.Добавить(Новый Структура("Имя, Видимость", "Идентификатор", Ложь));
	КолонкиТаблицы.Добавить(Новый Структура("Имя, Заголовок, Тип",
		"УстановленнаяВерсия",
		НСтр("ru = 'Текущая версия'"),
		ТипСтрока));
	КолонкиТаблицы.Добавить(Новый Структура("Имя, Заголовок, Тип, ЦветТекста, Шрифт",
		"НоваяВерсия",
		НСтр("ru = 'Новая версия'"),
		ТипСтрока, WebЦвета.Зеленый, Новый Шрифт(,, Истина)));
	
	ЗаголовокФормы = НСтр("ru = 'Клеверенс: Обновление расширений'");
	Описание = НСтр("ru = 'Доступны обновления для следующих расширений, выберите те, которые будут обновлены.
							|Рекомендуем обновить всё для стабильной работы.'");
	
	ФормаСлужебная_МножественныйВыборИзСписка = ЛокЯдро_ПолучитьФорму("ФормаСлужебная_МножественныйВыборИзСписка", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	ФормаСлужебная_МножественныйВыборИзСписка.ВнешнийСписок 	= СписокВыбора;
	ФормаСлужебная_МножественныйВыборИзСписка.КолонкиТаблицы 	= КолонкиТаблицы;
	ФормаСлужебная_МножественныйВыборИзСписка.Заголовок 		= ЗаголовокФормы;
	ФормаСлужебная_МножественныйВыборИзСписка.Описание 			= Описание;
	ФормаСлужебная_МножественныйВыборИзСписка._ЛокКонтекст		= ЭтаФорма;
	ФормаСлужебная_МножественныйВыборИзСписка.РежимОткрытия 	= "ВыборРасширений";
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширенияЗавершение", ЭтаФорма, ПараметрыВыполнения);
	ФормаСлужебная_МножественныйВыборИзСписка.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_МножественныйВыборИзСписка.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_МножественныйВыборИзСписка.Открыть();
	#КонецЕсли
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширенияЗавершение(Результат, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ВыбратьРасширенияЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыполнения",
		Результат, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	Если Результат = Неопределено Тогда
		Результат = Новый Массив;
	КонецЕсли;
	
	// Оставляем только выбранные расширения для обновления и новые расширения
	ПодключаемыеКомпоненты 			= ПараметрыВыполнения.ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты;
	РасширенияДляОбработкиВыбора 	= ПараметрыВыполнения.РасширенияДляОбработкиВыбора;
	
	Для каждого СтрокаВыбора Из РасширенияДляОбработкиВыбора Цикл
		Если Результат.Найти(СтрокаВыбора.ТипРасширения) = Неопределено Тогда
			Если ПодключаемыеКомпоненты.Получить(СтрокаВыбора.ТипРасширения) <> Неопределено Тогда
				ПодключаемыеКомпоненты.Удалить(СтрокаВыбора.ТипРасширения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыВыполнения.Удалить("РасширенияДляОбработкиВыбора");
	
	ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширенияПродолжить(ПараметрыВыполнения);
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_СохранитьРасширенияВФайл(ИменаРасширений) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_СохранитьРасширенияВФайл";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИменаРасширений",
		ИменаРасширений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИменаРасширений", ИменаРасширений);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ОбновлениеКомпонент_ПолучитьАрхивПодключенныхРасширений");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	АдресАрхива = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	Если АдресАрхива <> Неопределено
		И ЭтоАдресВременногоХранилища(АдресАрхива) Тогда
		
		ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогВыбораФайла.ПолноеИмяФайла = "";
		ДиалогВыбораФайла.Фильтр = "(*.zip)|*.zip";
		ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Сохранить в файл';
											|en = 'Save to a file'; be = 'Захаваць у файл'; es = 'Guardar en un archivo'; ka = 'შენახვა ფაილი'; kk = 'Файлға сақтау'; ro = 'Salvați într-un fișier'; tr = 'Dosyaya kaydet'; uk = 'Зберегти у файл'; uz = 'Faylga saqlash'");
		
		ИмяФайла = "";
		ДанныеФайла = Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресАрхива);
		
		СохраняемыеФайлы = Новый Массив;
		СохраняемыеФайлы.Добавить(ДанныеФайла);
		
		Контекст = Новый Структура();
		Контекст.Вставить("Диалог", 			ДиалогВыбораФайла);
		Контекст.Вставить("Интерактивно", 		Истина);
		Контекст.Вставить("ТекстПредложения", 	"");
		Контекст.Вставить("ПолучаемыеФайлы", 	СохраняемыеФайлы);
		
		ДополнительныеПараметры = Новый Структура;
		
		ДополнительныеПараметры.Вставить("УстановитьЕслиНеПодключено", 	Истина);
		ДополнительныеПараметры.Вставить("Контекст",					Контекст);
		ДополнительныеПараметры.Вставить("ОбработчикЗавершения", 		"ЛокЯдро_ОбновлениеКомпонент_СохранитьРасширенияВФайлЗавершение");
		ДополнительныеПараметры.Вставить("ВыборЗавершение", 			Новый ОписаниеОповещения("ЛокЯдро_ПоказатьПолучениеФайлов", ЭтаФорма));
		
		#Если Не ВебКлиент Тогда
			// В мобильном, тонком и толстом клиентах расширение подключено всегда.
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыборЗавершение, ДополнительныеПараметры); 
		#Иначе
			ЛокЯдро_ПередПодключениемРасширенияРаботыСФайлами(ДополнительныеПараметры);
		#КонецЕсли
		
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_СохранитьРасширенияВФайлЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширенияПродолжить(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ПодключитьРасширенияПродолжить";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	ПараметрыПодключенияКомпонент 		= ПараметрыВыполнения.ПараметрыПодключенияКомпонент;
	ПодключаемыеКомпоненты 				= ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты;
	ПодключаемыеРасширенияСтабильные 	= ПараметрыПодключенияКомпонент.ПодключаемыеРасширенияСтабильные;
	СтруктураИменКомпонент 				= ПараметрыПодключенияКомпонент.СтруктураИменКомпонент;
	ПостфиксыРасширений 				= ПараметрыПодключенияКомпонент.ПостфиксыРасширений;
	
	// Формируем массив файлов, которые будут подключены
	МассивИменПодключаемыхФайлов = Новый Массив;
	Для каждого КлючЗначение Из ПодключаемыеКомпоненты Цикл
		СтруктураКомпоненты = КлючЗначение.Значение;
		Если ЗначениеЗаполнено(СтруктураКомпоненты.ИмяФайлаРасширения) Тогда
			ИмяФайлаРасширения = СтруктураКомпоненты.ИмяФайлаРасширения;
			Если СтруктураКомпоненты.Свойство("ИмяФайлаРасширенияДляПодключения") Тогда
				ИмяФайлаРасширения = СтруктураКомпоненты.ИмяФайлаРасширенияДляПодключения;
			КонецЕсли;
			МассивИменПодключаемыхФайлов.Добавить(ИмяФайлаРасширения);
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ФайлыРасширенийПредварительно = Новый Соответствие;
	Если ПараметрыПодключенияКомпонент.Свойство("ФайлыРасширенийПредварительно") Тогда
		ФайлыРасширенийПредварительно = ПараметрыПодключенияКомпонент.ФайлыРасширенийПредварительно;
	КонецЕсли;
	
	// Получаем файлы стабильных версий
	Если ПодключаемыеРасширенияСтабильные.Количество() Тогда
		// Резервные файлы будут использованы внутри ГлЯдро_ПодключитьРасширения при неудаче с основным файлом.
		МассивФайловРасширений = Новый Массив;
		ИменаФайловРасширений  = Новый Массив;
		Для Каждого ИмяФайлаРасширения Из ПодключаемыеРасширенияСтабильные Цикл
			ФайлРасширения = ФайлыРасширенийПредварительно.Получить(ИмяФайлаРасширения);
			Если ФайлРасширения <> Неопределено Тогда
				МассивФайловРасширений.Добавить(ФайлРасширения);
				ИменаФайловРасширений.Добавить(ИмяФайлаРасширения);
			КонецЕсли;
		КонецЦикла;
		ЛокЯдро_ПолучитьФайлыРасширений(ПодключаемыеРасширенияСтабильные, МассивФайловРасширений, ИменаФайловРасширений);
		ДополнительныеПараметры.Вставить("МассивФайловРасширенийСтабильные", МассивФайловРасширений);
	КонецЕсли;
	
	// Получаем файлы основных версий
	МассивФайловРасширений = Новый Массив;
	ИменаФайловРасширений  = Новый Массив;
	
	Для Каждого ИмяФайлаРасширения Из МассивИменПодключаемыхФайлов Цикл
		ФайлРасширения = ФайлыРасширенийПредварительно.Получить(ИмяФайлаРасширения);
		Если ФайлРасширения <> Неопределено Тогда
			МассивФайловРасширений.Добавить(ФайлРасширения);
			ИменаФайловРасширений.Добавить(ИмяФайлаРасширения);
		КонецЕсли;
	КонецЦикла;
	
	ЛокЯдро_ПолучитьФайлыРасширений(МассивИменПодключаемыхФайлов, МассивФайловРасширений, ИменаФайловРасширений);
	
	// Подключение расширений
	Если МассивФайловРасширений.Количество() Тогда
		РезультатПодключенияРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматическиЗавершение(МассивФайловРасширений, СтруктураИменКомпонент, ПостфиксыРасширений, ДополнительныеПараметры);
	Иначе
		РезультатПодключенияРасширений = Новый Массив;
	КонецЕсли;
	
	// Продолжение
	ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработки(РезультатПодключенияРасширений, ПараметрыВыполнения);
	
	пСообщение = НСтр("ru = 'Конец.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработки(РезультатПодключенияРасширений, ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатПодключенияРасширений,ПараметрыВыполнения",
		РезультатПодключенияРасширений, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	пСообщение = НСтр("ru = 'Начало.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	
	ЭтоАвтотест = КомЯдро_ПолучитьЗначениеПеременной("Автотест") = Истина;
	Если ЭтоАвтотест Тогда
		// В автотесте очистим массив подключенных расширений для проверки подключения обработок.
		РезультатПодключенияРасширений = Новый Массив;
		
		пСообщение = "Выполняется автотест. Дополнительные обработки будут обновлены независимо от успешности обновления расширений.";
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
		
	КонецЕсли;
	
	ВерсияПриложенияАктуальная 	= ПараметрыВыполнения.ВерсияПриложенияАктуальная;
	НеОбновлятьВерсиюПриложения = ПараметрыВыполнения.ВерсияПриложенияАктуальная = ПараметрыВыполнения.ВерсияПриложенияИзНастроек;
	
	ПараметрыПодключенияКомпонент 		= ПараметрыВыполнения.ПараметрыПодключенияКомпонент;
	ПодключаемыеКомпоненты 				= ПараметрыПодключенияКомпонент.ПодключаемыеКомпоненты;
	СтруктураИменКомпонент 				= ПараметрыВыполнения.ПараметрыПодключенияКомпонент.СтруктураИменКомпонент;
	
	ИмяОсновнойОбработки 		= "КлеверенсТСД_ОсновнаяОбработка.epf";
	ИмяИнтеграционнойОбработки 	= ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
	ИмяИнтеграционнойОбработки 	= ?(Найти(ИмяИнтеграционнойОбработки, ".epf") = 0, ИмяИнтеграционнойОбработки + ".epf", ИмяИнтеграционнойОбработки);	
	
	//Параметры для определения версий обработок
	ИмяПараметраНастройкиОО 	= "ОсновнаяОбработка";
	ИмяПараметраНастройкиИО 	= "ИнтеграционнаяОбработка";
	
	// Формируем массив файлов, которые будут подключены
	МассивИменПодключаемыхФайлов = Новый Массив;
	Для каждого КлючЗначение Из ПодключаемыеКомпоненты Цикл
		СтруктураКомпоненты = КлючЗначение.Значение;
		Если ЗначениеЗаполнено(СтруктураКомпоненты.ИмяФайлаОбработки) Тогда
			
			Если СтруктураКомпоненты.ТипОбработки = "ОсновнаяОбработка" Тогда
				ИмяОсновнойОбработки = СтруктураКомпоненты.ИмяФайлаОбработки;
				
			ИначеЕсли СтруктураКомпоненты.ТипОбработки = "ИнтеграционнаяОбработка" Тогда
				ИмяИнтеграционнойОбработки = СтруктураКомпоненты.ИмяФайлаОбработки;
				
			КонецЕсли;
			
			ПодключитьДопОбработку = Истина;
			
			// Проверяем, что расширение было подключено при текущем обновлении компонентов
			Для каждого РезультатПодключения ИЗ РезультатПодключенияРасширений Цикл
				Если РезультатПодключения.ИмяРасширения = СтруктураКомпоненты.ИмяРасширения Тогда
					ПодключитьДопОбработку = НЕ РезультатПодключения.Подключено;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ПодключитьДопОбработку Тогда
				МассивИменПодключаемыхФайлов.Добавить(СтруктураКомпоненты.ИмяФайлаОбработки);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Параметры подключения в справочник доп. обработки
	Если ПараметрыВыполнения.ПервыйЗапуск Тогда
		
		ОтключатьКонфликтующие 						= Истина;
		ДобавитьВБыстрыйДоступТекПользователя 		= Истина;
		ПеренестиБыстрыйДоступИзПредыдущейВерсии 	= Ложь;
		ДобавитьВоВсеРазделы 						= Истина;
		ПеренестиРазделыИзПредыдущейВерсии 			= Ложь;
		
	Иначе
		
		ОтключатьКонфликтующие 						= Истина;
		ДобавитьВБыстрыйДоступТекПользователя 		= Ложь;
		ПеренестиБыстрыйДоступИзПредыдущейВерсии 	= Истина;
		ДобавитьВоВсеРазделы 						= Ложь;
		ПеренестиРазделыИзПредыдущейВерсии 			= Истина;
		
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("РабочийКаталог", 							"");
	ДопПараметры.Вставить("ИмяСобытия", 								ИмяСобытия);
	ДопПараметры.Вставить("МассивИменПодключаемыхФайлов", 				МассивИменПодключаемыхФайлов);
	ДопПараметры.Вставить("ОтключатьКонфликтующие", 					ОтключатьКонфликтующие);
	ДопПараметры.Вставить("ДобавитьВБыстрыйДоступТекПользователя", 		ДобавитьВБыстрыйДоступТекПользователя);
	ДопПараметры.Вставить("ПеренестиБыстрыйДоступИзПредыдущейВерсии", 	ПеренестиБыстрыйДоступИзПредыдущейВерсии);
	ДопПараметры.Вставить("ДобавитьВоВсеРазделы", 						ДобавитьВоВсеРазделы);
	ДопПараметры.Вставить("ПеренестиРазделыИзПредыдущейВерсии", 		ПеренестиРазделыИзПредыдущейВерсии);	
	ДопПараметры.Вставить("ИмяИнтеграционнойОбработки", 				ИмяИнтеграционнойОбработки);
	ДопПараметры.Вставить("ВерсияПриложенияАктуальная",					ВерсияПриложенияАктуальная);        
	ДопПараметры.Вставить("ИмяОсновнойОбработки",						ИмяОсновнойОбработки);        
	ДопПараметры.Вставить("ИмяПараметраНастройкиОО",					ИмяПараметраНастройкиОО);        
	ДопПараметры.Вставить("ИмяПараметраНастройкиИО",					ИмяПараметраНастройкиИО);        
	ДопПараметры.Вставить("НеОбновлятьВерсиюПриложения",				НеОбновлятьВерсиюПриложения);
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработкиЗавершение", ЭтаФорма, ПараметрыВыполнения);
	ДопПараметры.Вставить("ОписаниеОповещения", ОП);
	
	Если МассивИменПодключаемыхФайлов.Количество() Тогда
		ЛокЯдро_ПолучитьФайлыДопОтчетовОбработок(ДопПараметры);
	Иначе
		ЛокЯдро_ОбновлениеКомпонент_Завершение(Истина, ПараметрыВыполнения);
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение, НачалоСобытия);
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_ПодключитьДопОбработкиЗавершение(Результат, ПараметрыВыполнения) Экспорт
	
	#Область НесовместимыйКодFresh
	ЛокЯдро_ОбновлениеКомпонент_Завершение(Результат, ПараметрыВыполнения);
	#КонецОбласти //НесовместимыйКодFresh
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ОбновлениеКомпонент_Завершение(Результат, ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбновлениеКомпонент_Завершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыполнения",
		Результат, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Сохраняем ВерсияПриложения для отключения повторных проверок.
	// Если пользователь отказался от обновления, то считаем, что все обновлено.
	Если Результат = Истина
		И ПараметрыВыполнения.ВерсияПриложенияАктуальная <> ПараметрыВыполнения.ВерсияПриложенияИзНастроек Тогда
		
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияПриложения", ПараметрыВыполнения.ВерсияПриложенияАктуальная);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ВерсияПриложения", ПараметрыВыполнения.ВерсияПриложенияАктуальная);
		
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Конец.'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ОбновлениеКомпонент_Завершение", "Информация", пСообщение);
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеОбработкиЗавершения, Результат);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 




// Выполняет автоматическое подключение расширений, обработок, отчетов из файлов
//
// Параметры:
//  ПервыйЗапуск - Булево  - признак первого запуска обработки
//	ОбновлятьОсновнуюОбработкуПриПервомЗапуске - Булево - Истина - если обновляется основная обработка
//											   			- Ложь - если обновляются расширения и интеграционная обработка
//											   - Неопределено
//	СтруктураПараметров - Структура - структура со значениями из параметров запуска
//						- Неопределено
&НаКлиенте
Процедура ЛокЯдро_ОбновитьКомпонентыИзПодключеннойБазы(ПервыйЗапуск = Ложь, ОбновлятьОсновнуюОбработкуПриПервомЗапуске = Неопределено, СтруктураПараметров = Неопределено) Экспорт
	
	Перем ОписаниеОповещения, ПроверятьВерсииПриПервомЗапуске;
	
	ИмяСобытия = "ЛокЯдро_ОбновитьКомпонентыИзПодключеннойБазы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПервыйЗапуск,ОбновлятьОсновнуюОбработкуПриПервомЗапуске,СтруктураПараметров",
		ПервыйЗапуск, ОбновлятьОсновнуюОбработкуПриПервомЗапуске, СтруктураПараметров);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ЭтоВебКлиент = Ложь;
	ЭтоТестКлиент = Ложь;
	
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;
	#КонецЕсли
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		СтруктураПараметров.Свойство("ЭтоТестКлиент",
			ЭтоТестКлиент);
		СтруктураПараметров.Свойство("ПроверятьВерсииПриПервомЗапуске",
			ПроверятьВерсииПриПервомЗапуске);
		СтруктураПараметров.Свойство("ОписаниеОповещения",
			ОписаниеОповещения);
	КонецЕсли;
	
	Если ЭтоТестКлиент = Истина Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если ПроверятьВерсииПриПервомЗапуске = Неопределено Тогда
		ПроверятьВерсииПриПервомЗапуске = Ложь;
	КонецЕсли;
	
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();	
	КонецЕсли;
	
	Если ПараметрыПодключенияMS.Свойство("ВерсияПриложения") Тогда
		ВерсияПриложенияАктуальная = ПараметрыПодключенияMS.ВерсияПриложения;
	Иначе
		// Не удалось определить актуальную версию
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураПараметровПодключения = Новый Структура;
	СтруктураПараметровПодключения.Вставить("ВерсияПриложенияАктуальная", 		  ВерсияПриложенияАктуальная);
	СтруктураПараметровПодключения.Вставить("ОбновлятьОсновнуюОбработку", 		  ОбновлятьОсновнуюОбработкуПриПервомЗапуске);
	СтруктураПараметровПодключения.Вставить("ПроверятьВерсииПриложенийОбработок", Ложь);
	СтруктураПараметровПодключения.Вставить("ОписаниеОповещения", 				  ОписаниеОповещения);
	
	РезультатыПодключенийРасширений = Новый Массив;
	
	Если ПервыйЗапуск Тогда
		
		// При первом запуске не проверяем версию приложения (сборки), если не передан параметр ПроверятьВерсииПриПервомЗапуске
		Если НЕ ПроверятьВерсииПриПервомЗапуске Тогда
			Если НЕ ОбновлятьОсновнуюОбработкуПриПервомЗапуске = Истина Тогда
				РезультатыПодключенийРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск, СтруктураПараметровПодключения);
			КонецЕсли;
			ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
		Иначе
			ВерсияПриложенияИзНастроек = Неопределено;
			Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
				И ПараметрыПодключенияMS.Свойство("ВерсияПриложения") Тогда
				ВерсияПриложенияИзНастроек = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияПриложения");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВерсияПриложенияАктуальная)
				ИЛИ ВерсияПриложенияАктуальная <> ВерсияПриложенияИзНастроек Тогда
				Если НЕ ОбновлятьОсновнуюОбработкуПриПервомЗапуске = Истина Тогда
					РезультатыПодключенийРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск, СтруктураПараметровПодключения);
				КонецЕсли;
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
			Иначе
				// Проверка актуальности расширений SSL/Main на случай, если изменилась версия БСП/версия совместимости конфигурации 1С
				СтруктураПараметровПодключения.Вставить("ПроверитьАктуальностьВерсийРасширений", Истина);
				РезультатыПодключенийРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск, СтруктураПараметровПодключения);
				
				СтруктураПараметровПодключения.Вставить("ПроверятьВерсииПриложенийОбработок", 	Истина);
				СтруктураПараметровПодключения.Вставить("НеОбновлятьВерсиюПриложения", 			Истина); // Версия приложения из настроек уже актуальна
				
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// Если запуск не первый, то сравниваем версию приложения (сборки) из базы Клеверенс с версией приложения из настроек
		// если версия приложения из настроек меньше, то запускаем обновление расширений/обработок
		
		Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура")
			И ПараметрыПодключенияMS.Свойство("ВерсияПриложения") Тогда
			ВерсияПриложенияИзНастроек = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияПриложения");
						
			Если ЗначениеЗаполнено(ВерсияПриложенияАктуальная)
				И ВерсияПриложенияАктуальная <> ВерсияПриложенияИзНастроек Тогда
				// Запускаем обновление
				РезультатыПодключенийРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск, СтруктураПараметровПодключения);
				// Сначала подключаем ИО, т.к. если обновить ИО и ОО вместе может возникнуть необрабатываемая ошибка "Неизвестный идентификатор формы"
				СтруктураПараметровПодключения.Вставить("ОбновлятьОсновнуюОбработку", Ложь);
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
				// Затем подключаем ОО
				СтруктураПараметровПодключения.Вставить("ОбновлятьОсновнуюОбработку", Истина);
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
				
			ИначеЕсли ВерсияПриложенияАктуальная = ВерсияПриложенияИзНастроек Тогда
				// Проверка актуальности расширений SSL/Main на случай, если изменилась версия БСП/версия совместимости конфигурации 1С
				СтруктураПараметровПодключения.Вставить("ПроверитьАктуальностьВерсийРасширений", Истина);
				РезультатыПодключенийРасширений = ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск, СтруктураПараметровПодключения);
				
				// Проверка версий приложений, для которых были получены ОО и ИО
				СтруктураПараметровПодключения.Вставить("ПроверятьВерсииПриложенийОбработок", 	Истина);
				СтруктураПараметровПодключения.Вставить("НеОбновлятьВерсиюПриложения", 			Истина); // Версия приложения из настроек уже актуальна
				// Сначала подключаем ИО, т.к. если обновить ИО и ОО вместе может возникнуть необрабатываемая ошибка "Неизвестный идентификатор формы"
				СтруктураПараметровПодключения.Вставить("ОбновлятьОсновнуюОбработку", Ложь);
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
				// Затем подключаем ОО
				СтруктураПараметровПодключения.Вставить("ОбновлятьОсновнуюОбработку", Истина);
				ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенийРасширений);
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Выполняет автоматическое подключение расширений
//
// Параметры:
//  ПервыйЗапуск 	- Булево  - признак первого запуска обработки
//
// Возвращаемое значение:
//   Массив   - см. описание ГлЯдро_ПодключитьРасширения
//	 Неопределено - если не требуется загрузка расширений
//
&НаКлиенте
Функция ЛокЯдро_ПодключитьРасширенияАвтоматически(ПервыйЗапуск = Ложь, СтруктураПараметровПодключения = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПодключитьРасширенияАвтоматически";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПервыйЗапуск,СтруктураПараметровПодключения",
		ПервыйЗапуск, СтруктураПараметровПодключения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	РезультатыПодключений = Новый Массив;
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьИмяКонфигурации");
	
	ИмяКонфигурации = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);
	
	ЭтоБазоваяВерсия = ЛокЯдро_СтрНайти(ВРег(ИмяКонфигурации), "БАЗОВАЯ") <> 0;
	
	Если ЭтоБазоваяВерсия Тогда
		// В базовые версии не подключаем расширения
		пСообщение = НСтр("ru = 'В базовую версию запрещено подключение расширений';
							|en = 'Extensions are not allowed in the basic version'; be = 'У базавую версію забаронена падключэнне пашырэнняў'; es = 'La versión básica no permite la conexión de extensiones'; ka = 'გაგრძელება არ არის დაშვებული ძირითადი ვერსია'; kk = 'Негізгі нұсқаға кеңейтімдерді қосуға тыйым салынады'; ro = 'Extensiile nu sunt permise în versiunea de bază'; tr = 'Uzantıları temel sürüme bağlamak yasaktır'; uk = 'У базову версію заборонено підключення розширень'; uz = 'Asosiy versiyada kengaytmalarni ulash taqiqlanadi'");
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыПодключений);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат РезультатыПодключений;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураПараметровПодключения) = Тип("Структура") И СтруктураПараметровПодключения.Свойство("ПроверитьАктуальностьВерсийРасширений") Тогда
		ПроверитьАктуальностьВерсийРасширений = СтруктураПараметровПодключения.ПроверитьАктуальностьВерсийРасширений;
	Иначе
		ПроверитьАктуальностьВерсийРасширений = Ложь;
	КонецЕсли;
	
	ОтключитьОбновление_ОсновнаяОбработка 		= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ОсновнаяОбработка");
	ОтключитьОбновление_ИнтеграционнаяОбработка = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка");
	
	ИмяИнтеграционнойОбработки = ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
	
	СтруктураИменРасширений = ЛокЯдро_ПолучитьСтруктуруИменРасширений();
	
	ПостфиксыРасширений	= Новый Структура;
	ПостфиксыРасширений.Вставить("РасширениеSSL",  			 ЛокЯдро_ПолучитьПостфиксРасширенияSSL());
	ПостфиксыРасширений.Вставить("ОсновноеРасширение", 		 ЛокЯдро_ПолучитьПостфиксРасширенияMain());
	ПостфиксыРасширений.Вставить("ИнтеграционноеРасширение", СтрЗаменить(СтрЗаменить(ИмяИнтеграционнойОбработки, "ИнтеграционнаяОбработка", ""), ".epf", ""));
	
	// Последняя стабильная версия совместимости
	СтабильныйПостфиксРасширенияMain = ЛокЯдро_ПолучитьСтабильныйПостфиксРасширения("ОсновноеРасширение");
	
	МассивИменПодключаемыхФайлов = Новый Массив;
	
	СтруктураВерсийПоУмолчанию = Новый Структура;
	
	Для каждого ЭлементСтруктуры Из СтруктураИменРасширений Цикл
		
		ЭтоРасширениеSSL 			= ЭлементСтруктуры.Ключ = "РасширениеSSL";
		ЭтоОсновноеРасширение 		= ЭлементСтруктуры.Ключ = "ОсновноеРасширение";
		ЭтоИнтеграционноеРасширение = ЭлементСтруктуры.Ключ = "ИнтеграционноеРасширение";
		
		КлючПостфиксаРасширения = ЭлементСтруктуры.Ключ;
		
		// Проверяем, требуется обновить все расширения или только актуализировать расширения SSL и Main
		Если ПроверитьАктуальностьВерсийРасширений
			И НЕ (ЭтоОсновноеРасширение ИЛИ ЭтоРасширениеSSL) Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверяем, не отключено ли обновление компонентов в настройках
		Если (ЭтоОсновноеРасширение ИЛИ ЭтоРасширениеSSL) И ОтключитьОбновление_ОсновнаяОбработка = Истина Тогда
			Продолжить;
		ИначеЕсли ЭтоИнтеграционноеРасширение И ОтключитьОбновление_ИнтеграционнаяОбработка = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Если не удалось определить постфикс расширения SSL, подключать его не нужно
		Если ЭтоРасширениеSSL И ПустаяСтрока(ПостфиксыРасширений[КлючПостфиксаРасширения]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПодключаемогоФайла = ЭлементСтруктуры.Значение;
		
		Если ПостфиксыРасширений.Свойство(КлючПостфиксаРасширения) Тогда
			ИмяПодключаемогоФайла = ИмяПодключаемогоФайла + ПостфиксыРасширений[КлючПостфиксаРасширения];
		КонецЕсли;
		
		// Расширения добавляются/обновляются:
		//	- при первом запуске
		//	- при подключении из окна настроек подключения с изменением версии
		//	- при открытии основной обработки с изменением версии
		//
		// Проверяется актуальность расширений SSL и Main:
		//	- при подключении из окна настроек подключения без изменения версии
		//	- при открытии основной обработки без изменения версии
		
		Если ПроверитьАктуальностьВерсийРасширений Тогда
			// Теперь проверяем только наличие настройки версии из настроек. Это значит, что расширение уже было подключено ранее
			// Если настройка есть, то добавляем в массив подключаемых файлов
			ИмяНастройки = "ВерсияРасширения_" + ЭлементСтруктуры.Значение;
			ЗначениеНастройки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(ИмяНастройки);
			Если ЗначениеНастройки <> Ложь
				И ЗначениеНастройки <> "0.0.0.0" Тогда
				// Проверяем, под каким именем было подключено расширение, и сравниваем его с актуальным именем
				ТекущееИмяРасширения = ?(ЭтоРасширениеSSL,
					ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИмяРасширенияSSL"),
					ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИмяРасширенияMain"));
				Если НЕ ТекущееИмяРасширения = ИмяПодключаемогоФайла Тогда
					МассивИменПодключаемыхФайлов.Добавить(ИмяПодключаемогоФайла);
				КонецЕсли;
			КонецЕсли;
		Иначе
			МассивИменПодключаемыхФайлов.Добавить(ИмяПодключаемогоФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивИменПодключаемыхФайлов.Количество() = 0 Тогда
		//Нечего подключать
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыПодключений);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат РезультатыПодключений;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	МассивФайловРасширений = Новый Массив;
	ИменаФайловРасширений  = Новый Массив;
	ИменаПодключаемыхФайловСтабильные = Новый Массив;
	
	// ОсновноеРасширение:
	// Файл без постфикса содержит самую свежую версию с режимом совместимости "НеИспользовать".
	// Она может не подойти для старых конфигураций.
	// Поэтому мы заранее готовим файл со стабильным постфиксом (например, _8_3_14),
	// чтобы использовать его, если файл без постфикса вызовет ошибку при подключении.
	
	ИндексОсновноеРасширение = МассивИменПодключаемыхФайлов.Найти(СтруктураИменРасширений.ОсновноеРасширение);
	Если НЕ ИндексОсновноеРасширение = Неопределено Тогда
		ИменаПодключаемыхФайловСтабильные.Добавить(СтруктураИменРасширений.ОсновноеРасширение + СтабильныйПостфиксРасширенияMain);
	КонецЕсли;
	
	// Резервные файлы будут использованы внутри ГлЯдро_ПодключитьРасширения при неудаче с основным файлом.
	Если ИменаПодключаемыхФайловСтабильные.Количество() Тогда
		ЛокЯдро_ПолучитьФайлыРасширений(ИменаПодключаемыхФайловСтабильные, МассивФайловРасширений, ИменаФайловРасширений);
		ДополнительныеПараметры.Вставить("МассивФайловРасширенийСтабильные", МассивФайловРасширений);
	КонецЕсли;
	
	// Получаем основные файлы расширений, которые будут загружены
	МассивФайловРасширений = Новый Массив;
	ИменаФайловРасширений  = Новый Массив;
	
	// Получаем файл основного расширения, чтобы определить необходимость получения конфликтующих расширений
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ИндексОсновноеРасширение = МассивИменПодключаемыхФайлов.Найти(СтруктураИменРасширений.ОсновноеРасширение);
		Если НЕ ИндексОсновноеРасширение = Неопределено Тогда
			МассивИменПодключаемыхФайловПерваяПорция = Новый Массив;
			МассивИменПодключаемыхФайловПерваяПорция.Добавить(СтруктураИменРасширений.ОсновноеРасширение);
			МассивИменПодключаемыхФайлов.Удалить(ИндексОсновноеРасширение);
			
			ЛокЯдро_ПолучитьФайлыРасширений(МассивИменПодключаемыхФайловПерваяПорция, МассивФайловРасширений, ИменаФайловРасширений);
			
			ЛокЯдро_ОтменитьЗагрузкуКонфликтующихРасширений(МассивИменПодключаемыхФайлов, МассивФайловРасширений, СтруктураИменРасширений);
		КонецЕсли;
	#КонецЕсли
	
	// Получаем файлы остальных расширений
	ЛокЯдро_ПолучитьФайлыРасширений(МассивИменПодключаемыхФайлов, МассивФайловРасширений, ИменаФайловРасширений);
	
	РезультатыПодключений = ЛокЯдро_ПодключитьРасширенияАвтоматическиЗавершение(МассивФайловРасширений, СтруктураИменРасширений, ПостфиксыРасширений, ДополнительныеПараметры);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыПодключений);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатыПодключений;
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВопросОбновленияРасширенийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ПолучитьФайлыРасширений(МассивИменПодключаемыхФайлов, МассивФайловРасширений, ИменаФайловРасширений)

	ИмяСобытия = "ЛокЯдро_ПолучитьФайлыРасширений";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивИменПодключаемыхФайлов,МассивФайловРасширений,ИменаФайловРасширений",
		МассивИменПодключаемыхФайлов, МассивФайловРасширений, ИменаФайловРасширений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	// 1. Загрузка расширений по http
	
	ПутиПоУмолчанию = "DataProcessors/Extensions/|Обработки%201С/Extensions/";
	
	ПутиФайловВБазеMS = Новый Соответствие;
	ПутиФайловВБазеMS.Вставить("CleverenceWebExtension", 	 "DataProcessors/Extensions/Web-сервис%20для%20онлайна/");
	ПутиФайловВБазеMS.Вставить("CleverenceButtonsExtension", "DataProcessors/Extensions/Кнопки%20в%20документах/");
		
	Для каждого ИмяБезРасширения ИЗ МассивИменПодключаемыхФайлов Цикл
		Если МассивИменПодключаемыхФайлов.Найти(ИмяБезРасширения) = Неопределено Тогда 	// Расширение подключать не нужно
			Продолжить;
		КонецЕсли;
		Если ИменаФайловРасширений.Найти(ИмяБезРасширения) <> Неопределено Тогда 		// Расширение уже загружено по другому пути
			Продолжить;
		КонецЕсли;
		
		ПутиКФайлуРасширения = ПутиФайловВБазеMS.Получить(ИмяБезРасширения);
		Если ПутиКФайлуРасширения = Неопределено Тогда
			// Расширение лежит в общей папке Extensions
			ПутиКФайлуРасширения = ПутиПоУмолчанию;
		КонецЕсли;
		
		Если Найти(ПутиКФайлуРасширения, "|") Тогда
			ПроверяемыеПути = ЛокЯдро_РазложитьСтрокуВМассивПодстрок(ПутиКФайлуРасширения, "|");
		Иначе
			ПроверяемыеПути = Новый Массив;
			ПроверяемыеПути.Добавить(ПутиКФайлуРасширения);
		КонецЕсли;
		
		Для каждого ПутьКФайлуРасширения ИЗ ПроверяемыеПути Цикл
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("ПутьКФайлу", ПутьКФайлуРасширения);
			ПараметрыФайла.Вставить("ИмяФайла",   ИмяБезРасширения + ".cfe");
					
			АдресРасширения = ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла);
			Если ЭтоАдресВременногоХранилища(АдресРасширения) Тогда	
				СтруктураФайлаРасширения = Новый Структура;
				СтруктураФайлаРасширения.Вставить("Имя", 		ПараметрыФайла.ИмяФайла);
				СтруктураФайлаРасширения.Вставить("Хранение", 	АдресРасширения);
					
				МассивФайловРасширений.Добавить(СтруктураФайлаРасширения);
				ИменаФайловРасширений.Добавить(ИмяБезРасширения);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// 2. Загрузка расширений из каталога базы Клеверенс и каталога основной обработки
	
	НужноПроверитьКаталоги = Ложь;
	
	#Если НЕ ВебКлиент Тогда
	Для каждого ИмяБезРасширения ИЗ МассивИменПодключаемыхФайлов Цикл
		Если ИменаФайловРасширений.Найти(ИмяБезРасширения) = Неопределено Тогда
			НужноПроверитьКаталоги = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	#КонецЕсли
	
	Если НужноПроверитьКаталоги Тогда
		РабочийКаталог = ?(ПараметрыПодключенияMS.Свойство("РабочийКаталог"), ПараметрыПодключенияMS.РабочийКаталог, "");
	
		КаталогОсновнойОбработки = "";
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			КаталогОсновнойОбработки = ЛокЯдро_ПолучитьРабочийКаталогОсновнойОбработки(ИспользуемоеИмяФайла);
		#КонецЕсли
		
		КаталогиПоискаРасширений = Новый Массив;
		Если ЗначениеЗаполнено(РабочийКаталог) Тогда
			КаталогиПоискаРасширений.Добавить(РабочийКаталог);
		КонецЕсли;
		Если ЗначениеЗаполнено(КаталогОсновнойОбработки) Тогда
			КаталогиПоискаРасширений.Добавить(КаталогОсновнойОбработки);
		КонецЕсли;
	
		Для каждого КаталогПоиска ИЗ КаталогиПоискаРасширений Цикл // Поиск расширений в папке базы Клеверенс и каталоге основной обработки
			МассивФайлов = НайтиФайлы(КаталогПоиска, "*.cfe", Истина);
				
			Для Каждого Файл Из МассивФайлов Цикл
				ИмяБезРасширения = Файл.ИмяБезРасширения;
				
				Если МассивИменПодключаемыхФайлов.Найти(ИмяБезРасширения) = Неопределено Тогда 	// Расширение подключать не нужно
					Продолжить;
				КонецЕсли;
				Если ИменаФайловРасширений.Найти(ИмяБезРасширения) <> Неопределено Тогда 		// Расширение уже загружено по другому пути
					Продолжить;
				КонецЕсли;
				
				ДвоичныеДанные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
					
				СтруктураФайлаРасширения = Новый Структура;
				СтруктураФайлаРасширения.Вставить("Имя", 		Файл.Имя);
				СтруктураФайлаРасширения.Вставить("Хранение", 	ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор));
					
				МассивФайловРасширений.Добавить(СтруктураФайлаРасширения);
				ИменаФайловРасширений.Добавить(ИмяБезРасширения);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// Проверяем, какие расширения не удалось загрузить, для записи ошибки в журнал регистрации
	Для каждого ИмяБезРасширения ИЗ МассивИменПодключаемыхФайлов Цикл
		Если ИменаФайловРасширений.Найти(ИмяБезРасширения) = Неопределено Тогда
			
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось получить файл расширения %1 из базы Клеверенс. При необходимости загрузите расширение вручную.';
						|en = 'Couldn''t get the %1 extension file from the Cleverence database. If necessary, download the extension manually.';
						|be = 'Не ўдалося атрымаць файл пашырэння %1 з базы Cleverence. Пры неабходнасці загрузіце пашырэнне ўручную.'; es = 'No se pudo recuperar el archivo de extensión %1 de la base de Cleverence. Si es necesario, descargue la extensión manualmente.'; ka = 'ვერ მიიღო %1 გაფართოების ფაილი Cleverence მონაცემთა ბაზიდან. საჭიროების შემთხვევაში, ჩამოტვირთეთ გაფართოება ხელით.'; kk = '%1 Кеңейту Файлын Cleverence базасынан алу мүмкін болмады. Қажет болса, кеңейтімді қолмен жүктеңіз.'; ro = 'Nu am putut obține fișierul de extensie %1 din Baza de date Cleverence. Dacă este necesar, descărcați manual extensia.'; tr = 'Cleverence veritabanından %1 uzantı dosyası alınamadı. Gerekirse uzantıyı manuel olarak indirin.'; uk = 'Не вдалося отримати файл розширення %1 з бази Cleverence. При необхідності завантажте розширення вручну.'; uz = 'Cleverence bazasidan % 1 kengaytma faylini olish mumkin emas edi. Agar kerak bo''lsa, kengaytmani qo''lda yuklab oling.'";
			ИмяРасширения = ИмяБезРасширения + ".cfe";
			ТекстОшибки = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), ИмяРасширения);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ИмяРасширения",
				ИмяРасширения);
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст);
			// </Лог>
			
		КонецЕсли;
	КонецЦикла;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Выполняет завершение автоматического подключения расширений
//
// Параметры:
//  МассивФайловРасширений  - Массив - массив, содержащий элементы ОписаниеПереданногоФайла либо структуры, 
//										в которых обязательно должны быть ключи: Хранение - адрес файла в хранилище, Имя - имя файла
//
// Возвращаемое значение:
//   Массив   - см. описание ГлЯдро_ПодключитьРасширения 
//
&НаКлиенте
Функция ЛокЯдро_ПодключитьРасширенияАвтоматическиЗавершение(МассивФайловРасширений, СтруктураИменРасширений, ПостфиксыРасширений, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПодключитьРасширенияАвтоматическиЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивФайловРасширений,СтруктураИменРасширений,ПостфиксыРасширений,ДополнительныеПараметры",
		МассивФайловРасширений, СтруктураИменРасширений, ПостфиксыРасширений, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ЛокЯдро_ОтключитьКонфликтующиеРасширения(МассивФайловРасширений, СтруктураИменРасширений);
	#КонецЕсли
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("МассивФайловРасширений", МассивФайловРасширений);
	ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПодключитьРасширенияАвтоматическиЗавершение");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	РезультатыПодключений = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	РасширенияОбновлены = Ложь;
	Для каждого РезультатПодключения Из РезультатыПодключений Цикл
		
		ИмяРасширения = РезультатПодключения.ИмяРасширения;
		
		Если РезультатПодключения.Подключено Тогда
			
			Версия = РезультатПодключения.Версия;

			// Сохранение версии в настройки
			ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияРасширения_" + ИмяРасширения, Версия);
			
			Если ИмяРасширения = СтруктураИменРасширений.ОсновноеРасширение Тогда
				ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяРасширенияMain", ИмяРасширения + ПостфиксыРасширений["ОсновноеРасширение"]);
			ИначеЕсли ИмяРасширения = СтруктураИменРасширений.РасширениеSSL Тогда
				ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяРасширенияSSL", ИмяРасширения + ПостфиксыРасширений["РасширениеSSL"]);
			КонецЕсли;
			
			// Если подключено интеграционное расширение, при следующей инициализации нужно переключиться на встроенную обработку
			#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
				Если ИмяРасширения = СтруктураИменРасширений.ИнтеграционноеРасширение Тогда
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПодключитьИОРасширения", Истина);
				КонецЕсли;
			#КонецЕсли
			
			ТекстИнформации = НСтр("ru = 'Подключено расширение %1 (версия %2)';
									|en = 'Extension %1 is enabled (version %2)'; be = 'Падключана пашырэнне %1 (версія % 2)'; es = 'Extensión %1 conectada (versión %2)'; ka = 'გაფართოება %1 ჩართულია (ვერსია %2)'; kk = '% 1 кеңейтімі қосылған (%2 нұсқасы)'; ro = 'Extensia %1 este activată (versiunea %2)'; tr = '%1 uzantısı bağlı (sürüm %2)'; uk = 'Підключено розширення %1 (версія %2)'; uz = '% 1 kengaytmasi ulangan (%2 versiyasi)'");
			ТекстИнформации = ЛокЯдро_СтрШаблон(ТекстИнформации, ИмяРасширения, Версия);
			
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстИнформации);
			
			РасширенияОбновлены = Истина;
			
		Иначе	
			
			Сообщение = НСтр("ru = 'Не удалось обновить расширение %1. При необходимости обновите его вручную из файла .cfe в каталоге базы Клеверенс.';
								|en = 'Couldn''t update %1 extension. If necessary, update it manually from the file.cfe in the Cleverence database directory.';
								|be = 'Не ўдалося абнавіць пашырэнне %1. Пры неабходнасці абновіце яго ўручную з файла .CFE ў каталогу базы Cleverence.'; es = 'No se pudo actualizar la extensión %1. Si es necesario, actualícelo manualmente desde el archivo .cfe en el directorio de base de Cleverence.'; ka = 'ვერ განახლდა %1 გაფართოება. საჭიროების შემთხვევაში, განაახლეთ იგი ხელით ფაილიდან.cfe Cleverence მონაცემთა ბაზის დირექტორიაში.'; kk = '% 1 кеңейтімін жаңарту мүмкін болмады. Қажет болса, оны файлдан қолмен жаңартыңыз .CFE Cleverence базалық каталогында.'; ro = 'Nu s-a putut actualiza extensia %1. Dacă este necesar, actualizați-l manual din fișier.cfe în directorul bazei de date Cleverence.'; tr = '%1 uzantısı güncellenemedi. Gerekirse dosyadan manuel olarak güncelleyin .cfe, Cleverence veritabanı dizininde.'; uk = 'Не вдалося оновити розширення %1. При необхідності оновіть його вручну з файлу .cfe в каталозі бази Cleverence.'; uz = '%1 kengaytmasini yangilash mumkin emas. Agar kerak bo''lsa, uni fayldan qo''lda yangilang.Cleverence ma''lumotlar bazasi katalogidagi cfe.'");
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ИмяРасширения);
			Сообщить(Сообщение);	
			
		КонецЕсли;
				
		Если ИмяРасширения = СтруктураИменРасширений.РасширениеСКнопкамиОбмена И РезультатПодключения.Подключено Тогда
			
			//Здесь можно выполнить какие-либо действия после успешного подключения расширения
			РезультатВыполния = ЛокЯдро_ВыполнитьДействияПослеПодключенияРасширения(ИмяРасширения, СтруктураИменРасширений, АдресаПеременных);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РасширенияОбновлены Тогда
		// Оповещаем главную форму для обновления информации о расширениях
		Оповестить("ПослеОбновленияРасширений",, ЭтаФорма);
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыПодключений);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатыПодключений;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОтключитьКонфликтующиеРасширения(МассивФайловРасширений, СтруктураИменРасширений)
	
	ИмяСобытия = "ЛокЯдро_ОтключитьКонфликтующиеРасширения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивФайловРасширений,СтруктураИменРасширений",
		МассивФайловРасширений, СтруктураИменРасширений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	// Если нужно подключить основное расширение, сначала нужно отключить конфликтующие расширения для веб-сервиса и с кнопками
	Если НЕ ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(МассивФайловРасширений, "Имя", СтруктураИменРасширений.ОсновноеРасширение + ".cfe") = Неопределено Тогда
		МассивКонфликтующихРасширений = Новый Массив;
		МассивКонфликтующихРасширений.Добавить(СтруктураИменРасширений.РасширениеДляВебСервиса);
		МассивКонфликтующихРасширений.Добавить(СтруктураИменРасширений.РасширениеСКнопкамиОбмена);
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("МассивФайловРасширений", МассивКонфликтующихРасширений);
		ПараметрыМетода.Вставить("РасширениеФайла", 	   "cfe");
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода",		"Функция");
		СтруктураВызова.Вставить("ИмяМетода",		"ОтключитьРасширения");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		
		РезультатыОтключения = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
		
		РасширенияОтключеныУспешно = ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(РезультатыОтключения, "Отключено", Ложь) = Неопределено;
		
		Если НЕ РасширенияОтключеныУспешно Тогда
			// Если не удалось отключить конфликтующие расширения, отменяем подключение основного расширения
			ЛокЯдро_УдалитьПоЗначениюИзМассиваСтруктур(МассивФайловРасширений, "Имя", СтруктураИменРасширений.ОсновноеРасширение + ".cfe");
			
			// <Лог>
			ЯзСтрока = "ru = 'Расширение %1 не будет подключено из-за ошибки отключения конфликтующих расширений.';
								|en = 'The %1 extension will not be enabled due to an error disabling conflicting extensions.';
								|be = 'Пашырэнне %1 не будзе падключана з-за памылкі адключэння канфліктуючых пашырэнняў.'; es = 'La extensión %1 no se conectará debido a un error al deshabilitar las extensiones en conflicto.'; ka = '%1 გაფართოება არ იქნება ჩართული გამო შეცდომა გამორთვა კონფლიქტის გაგრძელება.'; kk = '%1 кеңейтімі қайшылықты кеңейтімдерді өшіру қатесіне байланысты қосылмайды.'; ro = 'Extensia %1 nu va fi activată din cauza unei erori la dezactivarea extensiilor conflictuale.'; tr = 'Çakışan uzantıları devre dışı bırakma hatası nedeniyle %1 uzantısı bağlanmayacaktır.'; uk = 'Розширення %1 не буде підключено через помилку відключення конфліктуючих розширень.'; uz = 'Qarama-qarshi kengaytmalarni o''chirib qo''yish xatosi tufayli %1 kengaytmasi ulanmaydi.'";
			ТекстОшибки = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), СтруктураИменРасширений.ОсновноеРасширение);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"ОсновноеРасширение",
				СтруктураИменРасширений.ОсновноеРасширение);
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст);
			// </Лог>
		КонецЕсли;	
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОтключитьБезопасныйРежимРасширений(МассивИменРасширений = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОтключитьБезопасныйРежимРасширений";
	
	#Область НесовместимыйКодFresh
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("МассивИменРасширений", МассивИменРасширений);
	ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода",				"Функция");
	СтруктураВызова.Вставить("ИмяМетода",				"ОтключитьБезопасныйРежимРасширений");
	СтруктураВызова.Вставить("ПараметрыМетода", 	ПараметрыМетода);
	
	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	#КонецОбласти //НесовместимыйКодFresh
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_ОтменитьЗагрузкуКонфликтующихРасширений(МассивИменПодключаемыхФайлов, МассивФайловРасширений, СтруктураИменРасширений)
	
	ИмяСобытия = "ЛокЯдро_ОтменитьЗагрузкуКонфликтующихРасширений";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивИменПодключаемыхФайлов,МассивФайловРасширений,СтруктураИменРасширений",
		МассивИменПодключаемыхФайлов, МассивФайловРасширений, СтруктураИменРасширений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	// Если доступно к загрузке основное расширение, конфликтующие расширения загружать и обновлять не нужно
	//Если НЕ ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(МассивФайловРасширений, "Имя", СтруктураИменРасширений.ОсновноеРасширение + ".cfe") = Неопределено Тогда
		МассивКонфликтующихРасширений = Новый Массив;
		МассивКонфликтующихРасширений.Добавить(СтруктураИменРасширений.РасширениеДляВебСервиса);
		МассивКонфликтующихРасширений.Добавить(СтруктураИменРасширений.РасширениеСКнопкамиОбмена);
		
		Для каждого ИмяКонфликтующегоРасширения ИЗ МассивКонфликтующихРасширений Цикл
			ИндексМассива = МассивИменПодключаемыхФайлов.Найти(ИмяКонфликтующегоРасширения);
			Если НЕ ИндексМассива = Неопределено Тогда
				МассивИменПодключаемыхФайлов.Удалить(ИндексМассива);
				
				ТекстСообщения = НСтр("ru = 'Вместо расширения %1 будет загружено расширение %2.';
										|en = 'Instead of the %1 extension, the %2 extension will be loaded.';
										|be = 'Замест пашырэння %1 будзе загружана пашырэнне %2.'; es = 'En lugar de la extensión %1, se cargará la extensión %2.'; ka = '%1 გაფართოების ნაცვლად, %2 გაფართოება დატვირთული იქნება.'; kk = '%1 кеңейтімінің орнына % 2 кеңейтімі жүктеледі.'; ro = 'În loc de extensia %1, extensia %2 va fi încărcată.'; tr = '%1 uzantısı yerine %2 uzantısı yüklenecektir.'; uk = 'Замість розширення %1 буде завантажено розширення %2.'; uz = '%1 kengaytmasi o''rniga % 2 kengaytmasi yuklanadi.'");
				ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ИмяКонфликтующегоРасширения, СтруктураИменРасширений.ОсновноеРасширение);
				ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", ТекстСообщения);
			КонецЕсли;
		КонецЦикла;	
	//КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

// Выполняет дополнительные действия, после подключения расширения
//
// Параметры:
//  ИмяРасширения  			- Строка  - имя расширения
// 	СтруктураИменРасширений - Структура - структура
//
&НаКлиенте
Функция ЛокЯдро_ВыполнитьДействияПослеПодключенияРасширения(ИмяРасширения, СтруктураИменРасширений, АдресаПеременных) Экспорт

	//Здесь можно выполнить код после подключения расширения
	
КонецФункции

// Подключение файлов в справочник дополнительных отчетов и обработок
//
// Параметры:
//  ПервыйЗапуск 				   - Булево  - признак первого запуска обработки
//  СтруктураПараметровПодключения - Структура
&НаКлиенте
Процедура ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок(ПервыйЗапуск = Ложь, СтруктураПараметровПодключения = Неопределено, РезультатыПодключенияРасширений) Экспорт
	
	Перем ВерсияПриложенияАктуальная,
		ОбновлятьОсновнуюОбработку,
		ПроверятьВерсииПриложенийОбработок,
		НеОбновлятьВерсиюПриложения,
		РабочийКаталог,
		ОписаниеОповещения;
	
	ИмяСобытия = "ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработок";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПервыйЗапуск,СтруктураПараметровПодключения,РезультатыПодключенияРасширений",
		ПервыйЗапуск, СтруктураПараметровПодключения, РезультатыПодключенияРасширений);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ИмяОсновнойОбработки 		= "КлеверенсТСД_ОсновнаяОбработка.epf";
	ИмяИнтеграционнойОбработки 	= ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
	ИмяИнтеграционнойОбработки 	= ?(Найти(ИмяИнтеграционнойОбработки, ".epf") = 0, ИмяИнтеграционнойОбработки + ".epf", ИмяИнтеграционнойОбработки);	
	//Параметры для определения версий обработок
	ИмяПараметраНастройкиОО 	= "ОсновнаяОбработка";
	ИмяПараметраНастройкиИО 	= "ИнтеграционнаяОбработка";
	
	Если ТипЗнч(СтруктураПараметровПодключения) = Тип("Структура") Тогда
		СтруктураПараметровПодключения.Свойство("ВерсияПриложенияАктуальная",
			ВерсияПриложенияАктуальная);
		СтруктураПараметровПодключения.Свойство("ОбновлятьОсновнуюОбработку",
			ОбновлятьОсновнуюОбработку);
		СтруктураПараметровПодключения.Свойство("ПроверятьВерсииПриложенийОбработок",
			ПроверятьВерсииПриложенийОбработок);
		СтруктураПараметровПодключения.Свойство("НеОбновлятьВерсиюПриложения",
			НеОбновлятьВерсиюПриложения);
		СтруктураПараметровПодключения.Свойство("РабочийКаталог",
			РабочийКаталог);
		СтруктураПараметровПодключения.Свойство("ОписаниеОповещения",
			ОписаниеОповещения);
	КонецЕсли;
		
	Если ВерсияПриложенияАктуальная = Неопределено Тогда
		ВерсияПриложенияАктуальная = Ложь;
	КонецЕсли;
	Если ПроверятьВерсииПриложенийОбработок = Неопределено Тогда
		ПроверятьВерсииПриложенийОбработок = Ложь;
	КонецЕсли;
	Если НеОбновлятьВерсиюПриложения = Неопределено Тогда
		НеОбновлятьВерсиюПриложения = Ложь;
	КонецЕсли;
	Если РабочийКаталог = Неопределено Тогда
		РабочийКаталог = "";
	КонецЕсли;
	
	// Необходимо отключать автообновление ОО при запуске автотестов
	Если Найти(ПараметрЗапуска, "КлеверенсАвтотесты") Тогда
		ОбновлятьОсновнуюОбработку = Ложь;
	КонецЕсли;
	
	МассивИменПодключаемыхФайлов = Новый Массив;

	Если ПервыйЗапуск Тогда
		
		ОтключатьКонфликтующие 						= Истина;
		ДобавитьВБыстрыйДоступТекПользователя 		= Истина;
		ПеренестиБыстрыйДоступИзПредыдущейВерсии 	= Ложь;
		ДобавитьВоВсеРазделы 						= Истина;
		ПеренестиРазделыИзПредыдущейВерсии 			= Ложь;
		
	Иначе
		
		ОтключатьКонфликтующие 						= Истина;
		ДобавитьВБыстрыйДоступТекПользователя 		= Ложь;
		ПеренестиБыстрыйДоступИзПредыдущейВерсии 	= Истина;
		ДобавитьВоВсеРазделы 						= Ложь;
		ПеренестиРазделыИзПредыдущейВерсии 			= Истина;
		
	КонецЕсли;
	
	СтруктураИменРасширений = ЛокЯдро_ПолучитьСтруктуруИменРасширений();
	
	ДублирующиеРасширения = Новый Соответствие;
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДублирующиеРасширения.Вставить(ИмяОсновнойОбработки, 		СтруктураИменРасширений.ОсновноеРасширение);
		ДублирующиеРасширения.Вставить(ИмяИнтеграционнойОбработки, 	СтруктураИменРасширений.ИнтеграционноеРасширение);
	#КонецЕсли
	
	ОтключитьОбновление_ОсновнаяОбработка 		= ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ОсновнаяОбработка");
	ОтключитьОбновление_ИнтеграционнаяОбработка = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка");
	
	МассивПараметровФайлов = Новый Массив;
	Если НЕ ОбновлятьОсновнуюОбработку = Ложь Тогда
		МассивПараметровФайлов.Добавить(Новый Структура("ИмяФайла, ИмяПараметраНастройки", ИмяОсновнойОбработки, 		ИмяПараметраНастройкиОО));
	ИначеЕсли НЕ ОбновлятьОсновнуюОбработку = Истина Тогда
		МассивПараметровФайлов.Добавить(Новый Структура("ИмяФайла, ИмяПараметраНастройки", ИмяИнтеграционнойОбработки, 	ИмяПараметраНастройкиИО));
	Иначе
		МассивПараметровФайлов.Добавить(Новый Структура("ИмяФайла, ИмяПараметраНастройки", ИмяОсновнойОбработки, 		ИмяПараметраНастройкиОО));
		МассивПараметровФайлов.Добавить(Новый Структура("ИмяФайла, ИмяПараметраНастройки", ИмяИнтеграционнойОбработки, 	ИмяПараметраНастройкиИО));
	КонецЕсли;	
	
	//Определение актуальности версий
	Для каждого СтруктураПараметровФайла Из МассивПараметровФайлов Цикл
			
		ИмяФайла 				= СтруктураПараметровФайла.ИмяФайла;
		ИмяПараметраНастройки 	= СтруктураПараметровФайла.ИмяПараметраНастройки;
			
		ДублирующееРасширение = ДублирующиеРасширения.Получить(ИмяФайла);
		Если НЕ ДублирующееРасширение = Неопределено Тогда
			// Если было подключено дублирующее расширение, подключать обработку не надо
			НаличиеРасширения = ЛокЯдро_ПроверитьНаличиеРасширения(ДублирующееРасширение);
			Если НаличиеРасширения.Подключено Тогда
				// Проверяем, что расширение было подключено при текущем обновлении компонентов
				ЕстьОшибкаПодключенияРасширения = Ложь;
				Для каждого РезультатПодключения ИЗ РезультатыПодключенияРасширений Цикл
					Если РезультатПодключения.ИмяРасширения = ДублирующееРасширение Тогда
						ЕстьОшибкаПодключенияРасширения = НЕ РезультатПодключения.Подключено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ ЕстьОшибкаПодключенияРасширения Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Проверяем, не отключено ли обновление компонентов в настройках
		Если ИмяФайла = ИмяОсновнойОбработки И ОтключитьОбновление_ОсновнаяОбработка = Истина Тогда
			Продолжить;
		ИначеЕсли ИмяФайла = ИмяИнтеграционнойОбработки И ОтключитьОбновление_ИнтеграционнаяОбработка = Истина Тогда
			Продолжить;
		КонецЕсли;		
		
		Если ПроверятьВерсииПриложенийОбработок Тогда
			ИмяНастройки = "ВерсияПриложения_" + ИмяПараметраНастройки;
			ЗначениеНастройки = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(ИмяНастройки);
			Если ЗначениеНастройки <> ВерсияПриложенияАктуальная Тогда
				МассивИменПодключаемыхФайлов.Добавить(ИмяФайла);
			КонецЕсли;
		Иначе
			МассивИменПодключаемыхФайлов.Добавить(ИмяФайла);
		КонецЕсли;

	КонецЦикла;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("РабочийКаталог", 							РабочийКаталог);
	ДопПараметры.Вставить("ИмяСобытия", 								ИмяСобытия);
	ДопПараметры.Вставить("МассивИменПодключаемыхФайлов", 				МассивИменПодключаемыхФайлов);
	ДопПараметры.Вставить("ОтключатьКонфликтующие", 					ОтключатьКонфликтующие);
	ДопПараметры.Вставить("ДобавитьВБыстрыйДоступТекПользователя", 		ДобавитьВБыстрыйДоступТекПользователя);
	ДопПараметры.Вставить("ПеренестиБыстрыйДоступИзПредыдущейВерсии", 	ПеренестиБыстрыйДоступИзПредыдущейВерсии);
	ДопПараметры.Вставить("ДобавитьВоВсеРазделы", 						ДобавитьВоВсеРазделы);
	ДопПараметры.Вставить("ПеренестиРазделыИзПредыдущейВерсии", 		ПеренестиРазделыИзПредыдущейВерсии);	
	ДопПараметры.Вставить("ИмяИнтеграционнойОбработки", 				ИмяИнтеграционнойОбработки);
	ДопПараметры.Вставить("ВерсияПриложенияАктуальная",					ВерсияПриложенияАктуальная);        
	ДопПараметры.Вставить("ИмяОсновнойОбработки",						ИмяОсновнойОбработки);        
	ДопПараметры.Вставить("ИмяПараметраНастройкиОО",					ИмяПараметраНастройкиОО);        
	ДопПараметры.Вставить("ИмяПараметраНастройкиИО",					ИмяПараметраНастройкиИО);        
	ДопПараметры.Вставить("НеОбновлятьВерсиюПриложения",				НеОбновлятьВерсиюПриложения);
	ДопПараметры.Вставить("ОписаниеОповещения",							ОписаниеОповещения);
	
	ЛокЯдро_ПолучитьФайлыДопОтчетовОбработок(ДопПараметры);
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьФайлыДопОтчетовОбработок(ДополнительныеПараметры)
	
	ИмяСобытия = "ЛокЯдро_ПолучитьФайлыДопОтчетовОбработок";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ИменаЗагруженныхФайлов = Новый Массив;
	
	// 1. Загрузка файлов по http
	
	ПутиФайловВБазеMS = Новый Соответствие;
	ПутиФайловВБазеMS.Вставить(ДополнительныеПараметры.ИмяОсновнойОбработки, 		"DataProcessors/");
	ПутиФайловВБазеMS.Вставить(ДополнительныеПараметры.ИмяИнтеграционнойОбработки,	"DataProcessors/Integrations/");
	
	МассивПараметровПодключаемыхФайлов = Новый Массив;
	
	Для каждого ИмяФайла Из ДополнительныеПараметры.МассивИменПодключаемыхФайлов Цикл
		ПутиКФайлуОбработки = ПутиФайловВБазеMS.Получить(ИмяФайла);
		Если ПутиКФайлуОбработки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Найти(ПутиКФайлуОбработки, "|") Тогда
			ПроверяемыеПути = ЛокЯдро_РазложитьСтрокуВМассивПодстрок(ПутиКФайлуОбработки, "|");
		Иначе
			ПроверяемыеПути = Новый Массив;
			ПроверяемыеПути.Добавить(ПутиКФайлуОбработки);
		КонецЕсли;
		
		Для каждого ПутьКФайлуОбработки ИЗ ПроверяемыеПути Цикл
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("ПутьКФайлу", ПутьКФайлуОбработки);
			ПараметрыФайла.Вставить("ИмяФайла",   ИмяФайла);
			
			АдресОбработки = Неопределено;
			Если ИмяФайла = ДополнительныеПараметры.ИмяОсновнойОбработки
				И ЛокЯдро_ЭтоВнешняяОбработка() Тогда
				
				// Подключаем текущий файл ОО в доп. обработки, иначе возникнет ошибка «Неизвестный идентификатор»,
				// 	так как 1С создаст новый экземпляр внешней обработки, и контекст сервера будет потерян.
				
				Попытка
					#Если ТолстыйКлиентОбычноеПриложение Тогда
						ПутьОсновнойОбработки = ЭтаФорма.ОбъектСсылка.ИспользуемоеИмяФайла;
					#Иначе
						ПутьОсновнойОбработки = ИспользуемоеИмяФайла;
					#КонецЕсли
				Исключение
					ПутьОсновнойОбработки = "";
				КонецПопытки;
				
				Если НЕ ПустаяСтрока(ПутьОсновнойОбработки) Тогда
					Попытка
						ДД = Новый ДвоичныеДанные(ПутьОсновнойОбработки);
						АдресОбработки = ПоместитьВоВременноеХранилище(ДД, Новый УникальныйИдентификатор());
					Исключение
						АдресОбработки = Неопределено;
					КонецПопытки;
				КонецЕсли;
				
				пСообщение = НСтр("ru = 'Подключение основной обработки из текущей внешней обработки: %1'");
				пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ПутьОсновнойОбработки);
				ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
				
			КонецЕсли;
			
			Если АдресОбработки = Неопределено Тогда
				
				пСообщение = НСтр("ru = 'Подключение доп. обработки из файла по API: %1%2'");
				пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ПутьКФайлуОбработки, ИмяФайла);
				ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Информация", пСообщение);
				
				АдресОбработки = ЛокЯдро_ЗагрузитьФайлИзБазыSMARTS(ПараметрыПодключенияMS, ПараметрыФайла);
			КонецЕсли;
			
			Если ЭтоАдресВременногоХранилища(АдресОбработки) Тогда	
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("АдресФайла", 									АдресОбработки);
				СтруктураПараметров.Вставить("ИмяФайла",   									ИмяФайла);
				СтруктураПараметров.Вставить("ОтключатьКонфликтующие", 						ДополнительныеПараметры.ОтключатьКонфликтующие);
				СтруктураПараметров.Вставить("ДобавитьВБыстрыйДоступТекПользователя", 		ДополнительныеПараметры.ДобавитьВБыстрыйДоступТекПользователя);
				СтруктураПараметров.Вставить("ПеренестиБыстрыйДоступИзПредыдущейВерсии", 	ДополнительныеПараметры.ПеренестиБыстрыйДоступИзПредыдущейВерсии);
				СтруктураПараметров.Вставить("ДобавитьВоВсеРазделы", 						ДополнительныеПараметры.ДобавитьВоВсеРазделы);
				СтруктураПараметров.Вставить("ПеренестиРазделыИзПредыдущейВерсии", 			ДополнительныеПараметры.ПеренестиРазделыИзПредыдущейВерсии);
				СтруктураПараметров.Вставить("ИмяОсновнойОбработки", 						ДополнительныеПараметры.ИмяОсновнойОбработки);
				СтруктураПараметров.Вставить("ИмяИнтеграционнойОбработки", 					ДополнительныеПараметры.ИмяИнтеграционнойОбработки);
				СтруктураПараметров.Вставить("ВерсияПриложенияАктуальная",					ДополнительныеПараметры.ВерсияПриложенияАктуальная);
				СтруктураПараметров.Вставить("НеОбновлятьВерсиюПриложения",					ДополнительныеПараметры.НеОбновлятьВерсиюПриложения);
			
				МассивПараметровПодключаемыхФайлов.Добавить(СтруктураПараметров);
					
				Если ИмяФайла = ДополнительныеПараметры.ИмяИнтеграционнойОбработки Тогда
					// Устанавливка для главной формы режима перед подключением ИО, т.к. само подключение ИО происходит на сервере, а Оповестить работает с клиента
					СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
						"НачалоПодключенияИнтеграционнойОбработкиСообщениеБезопасности", 
						"", 
						"ПодключениеИО");
					Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
				КонецЕсли;
				
				ИменаЗагруженныхФайлов.Добавить(ИмяФайла);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ДополнительныеПараметры.Вставить("МассивПараметровПодключаемыхФайлов", МассивПараметровПодключаемыхФайлов);
	
	// 2. Загрузка файлов из каталога
	
	ИменаНезагруженныхФайлов = Новый Массив;
	Для каждого ИмяФайла Из ДополнительныеПараметры.МассивИменПодключаемыхФайлов Цикл
		Если ИменаЗагруженныхФайлов.Найти(ИмяФайла) = Неопределено Тогда
			ИменаНезагруженныхФайлов.Добавить(ИмяФайла);
		КонецЕсли;
	КонецЦикла;
	
	НужноПроверитьКаталоги = Ложь;
	
	#Если НЕ ВебКлиент Тогда
		НужноПроверитьКаталоги = ИменаНезагруженныхФайлов.Количество();
	#КонецЕсли
	
	Если НужноПроверитьКаталоги Тогда
		ДополнительныеПараметры.Вставить("ИменаНезагруженныхФайлов", ИменаНезагруженныхФайлов);
	
		РабочийКаталог = ДополнительныеПараметры.РабочийКаталог;
		Если НЕ ЗначениеЗаполнено(РабочийКаталог) Тогда
			Если ПараметрыПодключенияMS = Неопределено Тогда
				ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
			КонецЕсли;
			РабочийКаталог = ?(ПараметрыПодключенияMS.Свойство("РабочийКаталог"), ПараметрыПодключенияMS.РабочийКаталог, "");
			
			ДополнительныеПараметры.Вставить("РабочийКаталог", РабочийКаталог);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(РабочийКаталог) Тогда
			ТекстСообщения = "Не удалось определить рабочий каталог для загрузки файлов: %1";
			ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ЛокЯдро_ПолучитьЭлементыМассиваСтрокой(ИменаНезагруженныхФайлов));
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ДополнительныеПараметры.ИмяСобытия, "Предупреждение", ТекстСообщения);
			
			ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение(ДополнительныеПараметры);
		Иначе
			УказанныйКаталог = Новый Файл(РабочийКаталог);		
			УказанныйКаталог.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокПослеПроверкиСуществования", ЭтаФорма, ДополнительныеПараметры));
		КонецЕсли;
	Иначе
		ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение(ДополнительныеПараметры);
    КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокПослеПроверкиСуществования(КаталогСуществует, ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокПослеПроверкиСуществования";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"КаталогСуществует,ДополнительныеПараметры",
		КаталогСуществует, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	Если КаталогСуществует Тогда
		МассивПараметровПодключаемыхФайлов = ДополнительныеПараметры.МассивПараметровПодключаемыхФайлов;
		
		Для каждого ИмяФайла Из ДополнительныеПараметры.ИменаНезагруженныхФайлов Цикл	
			МассивФайлов = НайтиФайлы(ДополнительныеПараметры.РабочийКаталог, ИмяФайла, Истина);
			Если МассивФайлов.Количество() <> 0 Тогда
				
				ФайлОбработки	= МассивФайлов[0];
				ПутьОбработки	= ФайлОбработки.ПолноеИмя;
				ДвоичныеДанные	= Новый ДвоичныеДанные(ПутьОбработки);
				АдресОбработки	= ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
				
				Если ЭтоАдресВременногоХранилища(АдресОбработки) Тогда			
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("АдресФайла", 									АдресОбработки);
					СтруктураПараметров.Вставить("ИмяФайла",   									ИмяФайла);
					СтруктураПараметров.Вставить("ОтключатьКонфликтующие", 						ДополнительныеПараметры.ОтключатьКонфликтующие);
					СтруктураПараметров.Вставить("ДобавитьВБыстрыйДоступТекПользователя", 		ДополнительныеПараметры.ДобавитьВБыстрыйДоступТекПользователя);
					СтруктураПараметров.Вставить("ПеренестиБыстрыйДоступИзПредыдущейВерсии", 	ДополнительныеПараметры.ПеренестиБыстрыйДоступИзПредыдущейВерсии);
					СтруктураПараметров.Вставить("ДобавитьВоВсеРазделы", 						ДополнительныеПараметры.ДобавитьВоВсеРазделы);
					СтруктураПараметров.Вставить("ПеренестиРазделыИзПредыдущейВерсии", 			ДополнительныеПараметры.ПеренестиРазделыИзПредыдущейВерсии);
					СтруктураПараметров.Вставить("ИмяОсновнойОбработки", 						ДополнительныеПараметры.ИмяОсновнойОбработки);
					СтруктураПараметров.Вставить("ИмяИнтеграционнойОбработки", 					ДополнительныеПараметры.ИмяИнтеграционнойОбработки);
					СтруктураПараметров.Вставить("ВерсияПриложенияАктуальная",					ДополнительныеПараметры.ВерсияПриложенияАктуальная);
					СтруктураПараметров.Вставить("НеОбновлятьВерсиюПриложения",					ДополнительныеПараметры.НеОбновлятьВерсиюПриложения);
				
					МассивПараметровПодключаемыхФайлов.Добавить(СтруктураПараметров);
						
					Если ИмяФайла = ДополнительныеПараметры.ИмяИнтеграционнойОбработки Тогда
						// Устанавливка для главной формы режима перед подключением ИО, т.к. само подключение ИО происходит на сервере, а Оповестить работает с клиента
						СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
							"НачалоПодключенияИнтеграционнойОбработкиСообщениеБезопасности", 
							"", 
							"ПодключениеИО");
						Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
					КонецЕсли;
				Иначе
					ТекстСообщения = "Не удалось найти файл %1";
					ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ИмяФайла);
					ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ДополнительныеПараметры.ИмяСобытия, "Предупреждение", ТекстСообщения);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение(ДополнительныеПараметры);
	Иначе		
		ТекстСообщения = "Каталог ""%1"" не найден. Файлы не будут загружены: %2.";
		ТекстСообщения = ЛокЯдро_СтрШаблон(ТекстСообщения, ДополнительныеПараметры.РабочийКаталог, ЛокЯдро_ПолучитьЭлементыМассиваСтрокой(ДополнительныеПараметры.ИменаНезагруженныхФайлов));
		ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ДополнительныеПараметры.ИмяСобытия, "Предупреждение", ТекстСообщения);
		
		ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение(ДополнительныеПараметры);
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение(ДополнительныеПараметры) Экспорт

	ИмяСобытия = "ЛокЯдро_ПодключитьФайлыВСправочникДопОтчетовОбработокЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	#Область НесовместимыйКодFresh
	
	ПерезаписатьНастройки1С = Ложь;
		
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("МассивПараметровФайлов", 		ДополнительныеПараметры.МассивПараметровПодключаемыхФайлов);
	ПараметрыМетода.Вставить("НеОбновлятьВерсиюПриложения", ДополнительныеПараметры.НеОбновлятьВерсиюПриложения);
	ПараметрыМетода.Вставить("ВерсияПриложенияАктуальная", 	ДополнительныеПараметры.ВерсияПриложенияАктуальная);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", 		"Функция");
	СтруктураВызова.Вставить("ИмяМетода", 		"ПодключитьФайлыВСправочникДополнительныхОтчетовИОбработок");
	СтруктураВызова.Вставить("ПараметрыМетода",	ПараметрыМетода);
	
	РезультатыПодключений = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);
	
	Для Каждого РезультатПодключения Из РезультатыПодключений Цикл
		
		Если РезультатПодключения.Подключено Тогда
			Если РезультатПодключения.ИмяФайла = ДополнительныеПараметры.ИмяОсновнойОбработки Тогда
				
				Путь = РезультатПодключения.Путь;
				
				Если РасположениеКомпоненты = "НаКлиенте" Тогда
					// Сохраняем настройки только, если режим работы - НаКлиенте, т.к. при обновлении ОО может возникнуть ошибки "Неизвестный идентификатор формы"
					// из-за вызова серверного метода. Если режим работы НаСервере, то при сохранении настроек вызывается сервеный метод, чего нельзя делать.
					// Если режим работы = НаСервере, то аналогичный код выполняется в серверном методе "ГлЯдро_ПодключитьФайлВСправочникДополнительныхОтчетовИОбработок"
					СтруктураНастроекДляСохранения = Новый Структура();
					СтруктураНастроекДляСохранения.Вставить("ПутьОсновнойОбработки", Путь);
					СтруктураНастроекДляСохранения.Вставить("ТипОсновнойОбработки",  РезультатПодключения.ТипОбработки);
					СтруктураНастроекДляСохранения.Вставить("ВерсияОбработки_" + ДополнительныеПараметры.ИмяПараметраНастройкиОО,  РезультатПодключения.Версия);
					СтруктураНастроекДляСохранения.Вставить("ВерсияПриложения_" + ДополнительныеПараметры.ИмяПараметраНастройкиОО, ДополнительныеПараметры.ВерсияПриложенияАктуальная);
					СтруктураНастроекДляСохранения.Вставить("НеКэшировать", Истина); // Приведет к вызову серверного метода
					СтруктураНастроекДляСохранения.Вставить("НеЛогировать", Истина); // Приведет к вызову серверного метода
					
					ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроекДляСохранения);
					
					Сообщение = НСтр("ru = 'Основная обработка была актуализирована в справочнике ""%1"", перезапустите основную обработку.';
										|en = 'The main processing has been updated in the %1 directory, restart the main processing.';
										|be = 'Асноўная апрацоўка была актуалізаваная ў даведніку ""%1"", перазапусціце асноўную апрацоўку.'; es = 'El procesamiento principal se ha actualizado en la referencia ""%1"", reinicie el procesamiento principal.'; ka = 'ძირითადი დამუშავება განახლდა %1 დირექტორიაში, გადატვირთეთ ძირითადი დამუშავება.'; kk = 'Негізгі өңдеу ""%1 "" анықтамалығында жаңартылды, негізгі өңдеуді қайта іске қосыңыз.'; ro = 'Procesarea principală a fost actualizată în directorul %1, Reporniți procesarea principală.'; tr = 'Ana işlem ""%1"" dizininde güncellendi, ana işlemi yeniden başlatın.'; uk = 'Основна обробка була актуалізована в довіднику ""%1"", перезапустіть основну обробку.'; uz = 'Asosiy ishlov berish ""%1 "" katalogida yangilandi, asosiy ishlov berishni qayta boshlang.'");
					Сообщение = ЛокЯдро_СтрШаблон(Сообщение, РезультатПодключения.СинонимСправочника);
					Сообщить(Сообщение);
				КонецЕсли;
				
			ИначеЕсли РезультатПодключения.ИмяФайла = ДополнительныеПараметры.ИмяИнтеграционнойОбработки Тогда
				
				ТекстОшибки = "";
								
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					// Для ОФ корректность формы уже была проверена в методе "ГлЯдро_ПодключитьИнтеграционнуюОбработку"
					ОшибкиФормыИО = Ложь;
				#Иначе
					// Мы не можем выполнять серверные методы с клиента при подключении ОО/ИО, т.к. можно получить ошибку "Неизвестный идентификатор формы"
					// Поэтому выполняем только проверку корректности формы ИО.
					Попытка
						ФормаИнтеграционнойОбработки = ЛокЯдро_ПолучитьФормуИнтеграционнойОбработки(РезультатПодключения.ТипОбработки, РезультатПодключения.ИмяФайла);
						ОшибкиФормыИО = Ложь;
					Исключение
						ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ОшибкиФормыИО = Истина;
					КонецПопытки;
				#КонецЕсли
				
				Если Не ОшибкиФормыИО Тогда
										
					Путь = РезультатПодключения.Путь;
					
					// Актуализируем данные о подключенной обработке в переменной ПараметрыПодключенияMS
					ПараметрыПодключенияMS.Вставить("ИмяИнтеграционнойОбработки",  РезультатПодключения.ИмяФайла);
					ПараметрыПодключенияMS.Вставить("ПутьИнтеграционнойОбработки", Путь);
					ПараметрыПодключенияMS.Вставить("ТипОбработки", 			   РезультатПодключения.ТипОбработки);
					
					// Замена настроек в хранилище 1С
					ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
					КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", 			 ПараметрыПодключенияMS);
					
					// Замена настроек в базе Клеверенс
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ИмяИнтеграционнойОбработкиКонфигурации1С", 	РезультатПодключения.ИмяФайла);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПутьИнтеграционнойОбработкиКонфигурации1С", 	Путь);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ТипОбработки", РезультатПодключения.ТипОбработки);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияОбработки_" + ДополнительныеПараметры.ИмяПараметраНастройкиИО,  РезультатПодключения.Версия);
					ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ВерсияПриложения_" + ДополнительныеПараметры.ИмяПараметраНастройкиИО, ДополнительныеПараметры.ВерсияПриложенияАктуальная);
					
					пСообщение = НСтр("ru = 'Подключена интеграционная обработка %1';
										|en = 'Integration processing enabled %1'; be = 'Інтэграцыйная апрацоўка %1'; es = 'Procesamiento de integración %1 conectado'; ka = 'ინტეგრაციის დამუშავება ჩართულია %1'; kk = '%1 интеграциялық өңдеу қосылды'; ro = 'Procesarea integrării activată %1'; tr = 'Entegrasyon işleme %1 bağlı'; uk = 'Підключена інтеграційна обробка %1'; uz = 'Integratsion ishlov berish %1 ulangan'");
					пСообщение = ЛокЯдро_СтрШаблон(пСообщение, РезультатПодключения.ИмяФайла);
					ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ДополнительныеПараметры.ИмяСобытия, "Информация", пСообщение);
					
				Иначе
					ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки = РезультатПодключения.ИмяФайла;
					ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки = "";
					ПараметрыПодключенияMS.Вставить("ТипОбработки", "ФайлНаДиске");

					Если ЭтоАдресВременногоХранилища(_ИнтеграционнаяОбработкаАдрес) Тогда
						УдалитьИзВременногоХранилища(_ИнтеграционнаяОбработкаАдрес);
						_ИнтеграционнаяОбработкаАдрес = Неопределено;
					КонецЕсли;
					ИнтеграционнаяОбработкаПодключена = Ложь;
					
					// <Лог>
					ЯзСтрока = "ru = 'Ошибка подключения интеграционной обработки %1: %2';
										|en = 'Integration processing connection error %1: %2';
										|be = 'Памылка падлучэння інтэграцыйнай апрацоўкі %1: %2'; es = 'Error al conectar el procesamiento de integración %1: %2'; ka = 'ინტეგრაციის დამუშავების კავშირის შეცდომა %1: %2'; kk = 'Интеграциялық өңдеуді қосу қатесі %1: %2'; ro = 'Eroare conexiune procesare integrare %1: %2'; tr = 'Entegrasyon işleme bağlantı hatası %1: %2'; uk = 'Помилка підключення інтеграційної обробки %1: %2'; uz = 'Integratsiyani qayta ishlash ulanishidagi xato %1: %2'";
					пСообщение = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), РезультатПодключения.ИмяФайла, ТекстОшибки);
					
					логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
						"ИмяФайла,ТекстОшибки",
						РезультатПодключения.ИмяФайла, ТекстОшибки);
					ЛогОшибка(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
					// </Лог>
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если РезультатПодключения.ИмяФайла = ДополнительныеПараметры.ИмяИнтеграционнойОбработки Тогда
					
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
				"ТребуетсяОбновитьИнформациюОбИнтеграционнойОбработке", 
				"", 
				"ПодключениеИО");
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если НЕ ДополнительныеПараметры.ОписаниеОповещения = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещения, Истина);
	КонецЕсли;
	#КонецОбласти //НесовместимыйКодFresh
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_НастройкаПодключения

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ПроверитьСоединение(ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ПроверитьСоединение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	пПараметрыВыполнения = ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(пПараметрыВыполнения, ПараметрыВыполнения);
	
	пПараметрыВыполнения.ТипБазы = "Временная";
	пПараметрыВыполнения.РежимВыполнения = "ПроверкаСоединения";
	
	ЛокЯдро_НастройкаПодключения_Начало(пПараметрыВыполнения);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_НастроитьПодключение(ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_НастроитьПодключение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	пПараметрыВыполнения = ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(пПараметрыВыполнения, ПараметрыВыполнения);
	
	пПараметрыВыполнения.РежимВыполнения = "НастройкаПодключения";
	
	ЛокЯдро_НастройкаПодключения_Начало(пПараметрыВыполнения);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_Начало(ПараметрыВыполнения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_Начало";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПараметрыВыполнения.ОповещениеОбработкиЗавершения = Неопределено Тогда
		ВызватьИсключение "ЛокЯдро_НастройкаПодключения_Начало: Параметр ""ОповещениеОбработкиЗавершения"" обязателен для заполнения.";
	КонецЕсли;
	
	ОчиститьСообщения();
	
	СтрокаПодключенияСМАРТС = ПараметрыВыполнения.СтрокаПодключенияСМАРТС;
	ПараметрыВыполнения.ПолнаяСтрокаПодключенияСМАРТС = СтрокаПодключенияСМАРТС;
	
	// Формируем структуры подключения, по которым будет проведена проверка
	Если ПараметрыВыполнения.МассивСтруктурПодключения = Неопределено Тогда
		
		МассивСтрокПодключений = ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
		
		МассивСтруктурПодключения = Новый Массив;
		Для каждого СтрокаПодключения Из МассивСтрокПодключений Цикл
			
			СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
			
			СтруктураПодключения = Новый Структура;
			СтруктураПодключения.Вставить("СтруктураURI",					СтруктураURI);
			СтруктураПодключения.Вставить("СтрокаПодключения",				СтрокаПодключения);
			СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",		СтрокаПодключения);
			СтруктураПодключения.Вставить("TempUid",						СтруктураURI.TempUid);
			СтруктураПодключения.Вставить("IdBaseSMARTS",					Неопределено);
			
			СтруктураПодключения.Вставить("ТипБазы",						"Временная");
			СтруктураПодключения.Вставить("ТипИнтерфейса",					"REST_API");
			СтруктураПодключения.Вставить("РасположениеКомпоненты",			ПараметрыВыполнения.РасположениеКомпоненты);
			СтруктураПодключения.Вставить("РежимВыбораБазы",				"СтрокаПодключения");
			СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
			
			СтруктураПодключения.Вставить("АвторизацияВключена", 	 Ложь);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 "");
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 "");
			СтруктураПодключения.Вставить("АвторизацияТип",			 Неопределено);
			
			МассивСтруктурПодключения.Добавить(СтруктураПодключения);
			
		КонецЦикла;
		ПараметрыВыполнения.МассивСтруктурПодключения = МассивСтруктурПодключения;
		
	КонецЕсли;
	
	ЛокЯдро_НастройкаПодключения_ОчиститьДанныеАвторизации(ПараметрыВыполнения);
	
	ПараметрыВыбораСтроки = Новый Структура;
	ПараметрыВыбораСтроки.Вставить("МассивСтруктурПодключения", ПараметрыВыполнения.МассивСтруктурПодключения);
	ПараметрыВыбораСтроки.Вставить("ИндексСтрокиПодключения", 	0);
	ПараметрыВыбораСтроки.Вставить("РасположениеКомпоненты", 	ПараметрыВыполнения.РасположениеКомпоненты);
	ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключенияСПроверкой(ПараметрыВыбораСтроки, ПараметрыВыполнения);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Функция ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова() Экспорт
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("СтрокаПодключенияСМАРТС");
	ПараметрыВыполнения.Вставить("ПолнаяСтрокаПодключенияСМАРТС");
	ПараметрыВыполнения.Вставить("ТипБазы");
	ПараметрыВыполнения.Вставить("МассивСтрокПодключений");
	ПараметрыВыполнения.Вставить("МассивСтруктурПодключения");
	ПараметрыВыполнения.Вставить("ОповещениеОбработкиЗавершения");
	ПараметрыВыполнения.Вставить("РасположениеКомпоненты", "НаСервере");
	ПараметрыВыполнения.Вставить("ДополнительныеПараметры");
	ПараметрыВыполнения.Вставить("РежимВыполнения");
	ПараметрыВыполнения.Вставить("ПервыйЗапуск", Ложь);
	ПараметрыВыполнения.Вставить("СпособЗапуска");
	ПараметрыВыполнения.Вставить("НеПереключатьсяНаКлиент");
	
	Возврат ПараметрыВыполнения;
	
КонецФункции 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ОчиститьДанныеАвторизации(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ОчиститьДанныеАвторизации";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Очищаем данные авторизации и редиректов
	Для каждого СтруктураПодключения ИЗ ПараметрыВыполнения.МассивСтруктурПодключения Цикл
		
		СтруктураURI = Неопределено;
		СтруктураПодключения.Свойство("СтруктураURI", СтруктураURI);
		Если СтруктураURI = Неопределено Тогда
			СтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(СтруктураПодключения.СтрокаПодключения);
			СтруктураПодключения.Вставить("СтруктураURI", СтруктураURI);
		КонецЕсли;
		
		КлючURL = REST_API_ПолучитьКлючURL(СтруктураURI);
		КомЯдро_СохранитьЗначениеПеременной("API_session_" + КлючURL, Неопределено);
		
		// Очищаем редиректы и данные авторизации для редиректов
		Location = КомЯдро_ПолучитьЗначениеПеременной("Location_" + КлючURL);
		Если ЗначениеЗаполнено(Location) И НЕ Location = Ложь Тогда
			
			пСтруктураURI = REST_API_ПолучитьСтруктуруURIИзСтроки(Location);
			пКлючURL = REST_API_ПолучитьКлючURL(пСтруктураURI);
			КомЯдро_СохранитьЗначениеПеременной("API_session_" + пКлючURL, Неопределено);
			КомЯдро_СохранитьЗначениеПеременной("Location_" + КлючURL, Неопределено);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключенияСПроверкой(ПараметрыВыбораСтроки, ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключенияСПроверкой";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыбораСтроки,ПараметрыВыполнения",
		ПараметрыВыбораСтроки, ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	МассивСтруктурПодключения = ПараметрыВыбораСтроки.МассивСтруктурПодключения;
	
	Если ПараметрыВыбораСтроки.ИндексСтрокиПодключения > МассивСтруктурПодключения.Количество() - 1 Тогда
		
		ПараметрыВыбораСтроки.ИндексСтрокиПодключения = 0;
		Если ПараметрыВыбораСтроки.РасположениеКомпоненты = "НаКлиенте" Тогда
			
			ЛокЯдро_НастройкаПодключения_ОчиститьДанныеАвторизации(ПараметрыВыполнения);
			
			// Если ни по одной строке подключиться не удалось, оставляем первую
			СтруктураПодключения = МассивСтруктурПодключения[0];	
			ПараметрыВыполнения.Вставить("СтруктураПодключения", СтруктураПодключения);
			
			пСообщение = НСтр("ru = 'Не удалось выбрать строку подключения. Используется первая строка: %1';
								|en = 'Connection string could not be selected. The first line is used: %1';
								|be = 'Не атрымалася выбраць радок падключэння. Выкарыстоўваецца першы радок: %1'; es = 'No se pudo seleccionar la cadena de conexión. Se usa la primera línea: %1'; ka = 'კავშირი სიმებიანი ვერ შეირჩა. პირველი ხაზი გამოიყენება: %1'; kk = 'Қосылу жолын таңдау мүмкін болмады. Бірінші жол қолданылады: %1'; ro = 'Șirul de conexiune nu a putut fi selectat. Se folosește prima linie: %1'; tr = 'Bağlantı dizesini seçemedim. İlk satır kullanılır: %1'; uk = 'Не вдалося вибрати рядок підключення. Використовується перший рядок: %1'; uz = 'Ulanish satrini tanlab bo''lmadi. Birinchi satr ishlatilgan: %1'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СокрЛП(СтруктураПодключения.СтрокаПодключенияСМАРТС));
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Предупреждение", пСообщение);
			
			ЛокЯдро_НастройкаПодключения_ПослеВыбораСтроки(Ложь, ПараметрыВыполнения);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		Иначе
			// Повторяем обход строк подключения на клиенте
			ПараметрыВыбораСтроки.РасположениеКомпоненты = "НаКлиенте";
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПодключения = МассивСтруктурПодключения[ПараметрыВыбораСтроки.ИндексСтрокиПодключения];
	СтруктураПодключения.Вставить("ТипБазы",						"Временная");
	СтруктураПодключения.Вставить("ТипИнтерфейса",					"REST_API");
	СтруктураПодключения.Вставить("РасположениеКомпоненты",			ПараметрыВыбораСтроки.РасположениеКомпоненты);
	СтруктураПодключения.Вставить("РежимВыбораБазы",				"СтрокаПодключения");
	СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
	СтруктураПодключения.Вставить("СохранятьАвторизацию",	 		Ложь);
	
	ПараметрыВыполнения.Вставить("СтруктураПодключения", 		СтруктураПодключения);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ПараметрыВыбораСтроки",		ПараметрыВыбораСтроки);
	ПараметрыОповещения.Вставить("ПараметрыВыполнения", 		ПараметрыВыполнения);
	ОП = Новый ОписаниеОповещения("ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСоединения", ЭтаФорма, ПараметрыОповещения);
	
	ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СтруктураПодключения, Истина, "Временная", ПараметрыВыбораСтроки.РасположениеКомпоненты, Истина, Истина, ОП);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСоединения(Результат, ПараметрыОповещения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСоединения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыОповещения",
		Результат, ПараметрыОповещения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ПодключениеДоступно = Результат.ПодключениеДоступно;
	Иначе
		ПодключениеДоступно = Результат;
	КонецЕсли;
	
	ПараметрыВыбораСтроки 		= ПараметрыОповещения.ПараметрыВыбораСтроки;
	ПараметрыВыполнения 		= ПараметрыОповещения.ПараметрыВыполнения;
	СтруктураПодключения		= ПараметрыВыполнения.СтруктураПодключения;
	
	Если ПодключениеДоступно = Истина Тогда
		
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			СтруктураПодключения.Вставить("АвторизацияВключена", 	 Истина);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 Результат.АвторизацияТокен);
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 Результат.АвторизацияРефрешТокен);
			СтруктураПодключения.Вставить("АвторизацияТип",			 Результат.АвторизацияТип);
		КонецЕсли;
		
		ОП = Новый ОписаниеОповещения("ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСовместимостиПлатформы", ЭтаФорма, ПараметрыОповещения);
		ЛокЯдро_ПроверитьСовместимостьПлатформы(СтруктураПодключения, СтруктураПодключения.РасположениеКомпоненты, ОП);
		
	ИначеЕсли ПодключениеДоступно = Ложь Тогда
		// Продолжаем обход строк подключения
		ПараметрыВыбораСтроки.ИндексСтрокиПодключения = ПараметрыВыбораСтроки.ИндексСтрокиПодключения + 1;
		ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключенияСПроверкой(ПараметрыВыбораСтроки, ПараметрыВыполнения);
		
	Иначе
		// Авторизация была прервана - прерываем попытки подключения
		ПараметрыВыполнения.Вставить("ПодключениеДоступно", Ложь);
		ЛокЯдро_НастройкаПодключения_Завершение(ПараметрыВыполнения);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСовместимостиПлатформы(Результат, ПараметрыОповещения) Экспорт
	
	ИмяСобытия = "ЛокЯдро_НастройкаПодключения_ВыбратьСтрокуПодключения_ПослеПроверкиСовместимостиПлатформы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
