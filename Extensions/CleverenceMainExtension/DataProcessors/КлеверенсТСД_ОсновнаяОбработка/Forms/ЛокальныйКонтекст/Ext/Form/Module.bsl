Процедура ЛокЯдро_ПроверитьДоступностьРаботыСДокументами1С() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПроверитьДоступностьРаботыСДокументами1С";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
