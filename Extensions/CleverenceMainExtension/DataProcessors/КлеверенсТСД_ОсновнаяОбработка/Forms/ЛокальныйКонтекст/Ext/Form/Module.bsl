			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ВыгрузитьВОдин_НастройкаБП) Тогда
			Если ДоступныйСписокБП.Количество() = 1 Тогда
				ВыгрузитьВОдин_НастройкаБП = локВыгрузитьВОдин_НастройкаБП;
				ДокументыДляОбработкиВыбора.Очистить();
			Иначе 
				ПараметрыВыбора.Вставить("ДоступныйСписокБП", ДоступныйСписокБП);
			КонецЕсли;
		Иначе
			ДокументыДляОбработкиВыбора.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыВыгрузки.Вставить("ВыгрузитьВОдин_НастройкаБП", ВыгрузитьВОдин_НастройкаБП);
	ПараметрыВыгрузки.Вставить("СтрокиДокументов1С", СтрокиДокументов1С);
	
	Если ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыВыбора.Вставить("ДокументыДляОбработкиВыбора", ДокументыДляОбработкиВыбора);
		ПараметрыВыгрузки.Вставить("ПараметрыВыбора", ПараметрыВыбора);
		ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыВыгрузки);
	Иначе
		ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьПользователей(ПараметрыВыгрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыВыгрузки, Отказ = Ложь)
		
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцесс";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки,Отказ",
		ПараметрыВыгрузки, Отказ);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Отказ Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = ПараметрыВыгрузки.ПараметрыВыбора;
	Если НЕ ПараметрыВыбора.Свойство("ДокументыДляОбработкиВыбора") 
		ИЛИ НЕ ПараметрыВыбора.ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыВыгрузки.Удалить("ПараметрыВыбора");
		ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьПользователей(ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДокументыДляОбработкиВыбора = ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	СтрокаДокумента = ДокументыДляОбработкиВыбора[0];
	
	ТипДокумента1С_Синоним = Строка(ТипЗнч(СтрокаДокумента.Ссылка));
	
	Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
		СписокБизнесПроцессов = ПараметрыВыбора.ДоступныйСписокБП;
		СвязанныеСтрокиДокументов = ПараметрыВыгрузки.СтрокиДокументов1С;
		КоличествоДокументов = 1;
	Иначе
		СписокБизнесПроцессов = СтрокаДокумента.СписокБизнесПроцессов;
		
		ПоискДокументовТекТипа = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ДокументыДляОбработкиВыбора, Новый Структура("ТипДокумента1С, НастройкаБизнесПроцесса", СтрокаДокумента.ТипДокумента1С, ""), Ложь);
		Если ПоискДокументовТекТипа = Неопределено Тогда
			ПоискДокументовТекТипа = Новый Массив;
			ПоискДокументовТекТипа.Добавить(СтрокаДокумента);
		КонецЕсли;
		СвязанныеСтрокиДокументов = ПоискДокументовТекТипа;
		КоличествоДокументов = 	ПоискДокументовТекТипа.Количество();	
	КонецЕсли;
	
	ПараметрыВыбора.Вставить("СвязанныеСтрокиДокументов", СвязанныеСтрокиДокументов);
	ПараметрыВыбора.Вставить("ТекущаяСтрокаДокумента", СтрокаДокумента);
	
	ПереданнаяТаблица = Новый Массив;
	ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Название,ТипИсходногоДокумента1С_Синоним,ТипИсходногоДокумента1С,ID_БизнесПроцесса"));
	
	Для каждого БизнесПроцесс Из СписокБизнесПроцессов Цикл
		НоваяСтруктура = Новый Структура();
		НоваяСтруктура.Вставить("Название",								БизнесПроцесс.Значение);
		НоваяСтруктура.Вставить("ID_БизнесПроцесса",						БизнесПроцесс.Ключ);
		НоваяСтруктура.Вставить("ТипИсходногоДокумента1С_Синоним",	ТипДокумента1С_Синоним);
		НоваяСтруктура.Вставить("ТипИсходногоДокумента1С",				СтрокаДокумента.ТипДокумента1С);
		ПереданнаяТаблица.Добавить(НоваяСтруктура);
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСлужебная_ВыборСтрокиИзТаблицы", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборСтрокиИзТаблицы", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ВыборСтрокиИзТаблицы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли				
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы 				= "БизнесПроцессыДляВыгрузки";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст 		 		= ЭтаФорма;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ПереданнаяТаблица 		= ПереданнаяТаблица;
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ТекущийДокумент 	 		= СтрокаДокумента.Ссылка;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ТипДокумента1С		 	= ТипДокумента1С_Синоним;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.КоличествоДокументов	= КоличествоДокументов;
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцессЗавершение", ЭтаФорма, ПараметрыВыгрузки);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцессЗавершение(РезультатВыбора, ПараметрыВыгрузки) Экспорт	
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцессЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВыбора,ПараметрыВыгрузки",
		РезультатВыбора, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Отказ = Ложь;
	СтрокиДокументов1С 				= ПараметрыВыгрузки.СтрокиДокументов1С;
	ДокументыДляОбработкиВыбора 	= ПараметрыВыгрузки.ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	ТекущаяСтрокаДокумента 			= ПараметрыВыгрузки.ПараметрыВыбора.ТекущаяСтрокаДокумента;
	СвязанныеСтрокиДокументов 		= ПараметрыВыгрузки.ПараметрыВыбора.СвязанныеСтрокиДокументов;
	
	Если ЗначениеЗаполнено(РезультатВыбора) 
		И ЗначениеЗаполнено(РезультатВыбора.Данные)
		И РезультатВыбора.Данные.Количество() Тогда
		
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;
			
			Если (РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех)
				ИЛИ ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
				
				Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
					СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
					// Проверка на наличие выбранного БП в связанных документах
					Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ID_БизнесПроцесса) <> Неопределено Тогда
						СтрокаДокумента.НастройкаБизнесПроцесса = ID_БизнесПроцесса;
						ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
					КонецЕсли;
				КонецЦикла;
				
				Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
					ПараметрыВыгрузки.ВыгрузитьВОдин_НастройкаБП = ID_БизнесПроцесса;
				КонецЕсли;
				
			Иначе
				ТекущаяСтрокаДокумента.НастройкаБизнесПроцесса = ID_БизнесПроцесса;
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
			КонецЕсли;
			
		Иначе
			
			Сообщение = НСтр("ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID';
								|en = 'The selected business process ""%1"" has an ID not filled in';
								|be = 'У абранага бізнес-працэсу ""%1 "" не запоўнены ID'; es = 'El proceso de negocio ""%1 "" seleccionado no tiene ID'; ka = 'შერჩეულ ბიზნეს პროცესს ""%1 "" აქვს პირადობის მოწმობა, რომელიც არ არის შევსებული'; kk = 'Таңдалған бизнес-процестің ""%1 "" идентификаторы толтырылмаған'; ro = 'Procesul de afaceri selectat"" %1 "" are un ID care nu este completat'; tr = 'Seçilen iş sürecinin ""%1"" İD dolu değil'; uk = 'У обраного бізнес-процесу ""%1 "" не заповнений ID'; uz = 'Tanlangan biznes jarayonida ""%1 "" ID bilan to''ldirilmagan'");
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(РезультатВыбора.Данные.Название));
			ЛокЯдро_СообщениеПользователю(Сообщение, ПараметрыВыгрузки.Форма);
			
			Если (РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех)
				ИЛИ ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
				Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
					СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
					// Проверка на наличие выбранного БП в связанных документах
					Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ID_БизнесПроцесса) <> Неопределено Тогда
						СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(СтрокаДокумента));
						ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
					КонецЕсли;
				КонецЦикла;
			Иначе
				СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(ТекущаяСтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Сообщение = НСтр("ru = 'Не выбран бизнес-процесс для документа ""%1""! Документ не выгружен на ТСД';
							|en = 'The business process for the ""%1"" document is not selected! The document has not been uploaded to a Mobile device';
							|be = 'Не абраны бізнес-працэс для дакумента ""%1""! Дакумент не выгружаны на мабільную прыладу'; es = '¡No se ha seleccionado ningún proceso de negocio para el documento ""%1""! El documento no se ha descargado en el dispositivo Móvil'; ka = '""%1 "" დოკუმენტის ბიზნეს პროცესი არ არის შერჩეული! დოკუმენტი არ არის ატვირთული მობილურ მოწყობილობაზე'; kk = '""%1 "" құжаты үшін бизнес-процесс таңдалмаған! Құжат мобильді құрылғыға жүктелмеген'; ro = 'Procesul de afaceri pentru documentul ""%1 "" nu este selectat! Documentul nu a fost încărcat pe un dispozitiv mobil'; tr = '""%1"" belgesi için iş süreci seçilmedi! Belge Mobil cihaza yüklenmedi'; uk = 'Не вибрано бізнес-процес для документа ""%1""! Документ не вивантажено на мобільний пристрій'; uz = '""%1"" hujjatining ish jarayoni tanlanmagan! Hujjat mobil qurilmaga yuklanmagan'");
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ТекущаяСтрокаДокумента.Ссылка);
		ЛокЯдро_СообщениеПользователю(Сообщение, ПараметрыВыгрузки.Форма);
		
		Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(СтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;
		Иначе
			СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(ТекущаяСтрокаДокумента));
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	ЛокЯдро_ВыгрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыВыгрузки, Отказ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьПользователей(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ЗаполнитьПользователей";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	Если НЕ СтрокиДокументов1С.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для выгрузки.';
							|en = 'There are no selected documents to upload.'; be = 'Няма вылучаных дакументаў для выгрузкі.'; es = 'No hay documentos seleccionados para descargar.'; ka = 'ატვირთვის არჩეული დოკუმენტები არ არის.'; kk = 'Жүктеу үшін таңдалған құжаттар жоқ.'; ro = 'Nu există documente selectate de încărcat.'; tr = 'Yüklenecek seçili belge yok.'; uk = 'Немає обраних документів для вивантаження.'; uz = 'Yuklash uchun tanlangan hujjatlar yo''q.'");
		ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов", Истина);
	УстройстваMS 	= ЛокЯдро_ПолучитьМассивПодключенныхУстройствБезВинКлиентовНаСервере(СтруктураМетаданных.УстройстваMS);
	
	СоответствиеНастроекБП = Новый Соответствие;
	Для каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") И НастройкаБП.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		Если НастройкаБП.Используется Тогда
			СоответствиеНастроекБП.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыВыгрузки.Вставить("СоответствиеНастроекБП", СоответствиеНастроекБП);
	
	ВыгрузитьВОдин_НазначенныеПользователи = Неопределено;
	ПолучитьУстройства = Ложь;
	ДокументыДляОбработкиВыбора = Новый Массив;
	Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
		
		НазначенныеПользователи = СтрокаДокумента.НазначенныеПользователи;
		Если НазначенныеПользователи = Неопределено Тогда
			
			НастройкаБП 				= СоответствиеНастроекБП.Получить(СтрокаДокумента.НастройкаБизнесПроцесса);
			ОтправитьНаУстройство 		= НастройкаБП.НазначитьПользователю =  "Конкретному устройству";
			УказатьПользователя 		= НастройкаБП.НазначитьПользователю =  "Спрашивать при выгрузке";
			
			Если ОтправитьНаУстройство Тогда
				Если УстройстваMS.Количество() = 1 Тогда
					НазначенныеПользователи = УстройстваMS;
				КонецЕсли;
			ИначеЕсли Не УказатьПользователя Тогда
				НазначенныеПользователи = НастройкаБП.НазначитьПользователю;
			КонецЕсли;
			
			Если НазначенныеПользователи = Неопределено Тогда
				Если НЕ ПолучитьУстройства Тогда
					ПолучитьУстройства = НастройкаБП.Свойство("СпособНазначения") И НастройкаБП.СпособНазначения = "Устройству";
				КонецЕсли;
				ДокументыДляОбработкиВыбора.Добавить(СтрокаДокумента);	
			КонецЕсли;
			
			Если ПараметрыВыгрузки.ВыгрузитьВОдин
				И ВыгрузитьВОдин_НазначенныеПользователи = Неопределено
				И НазначенныеПользователи <> Неопределено Тогда
				ВыгрузитьВОдин_НазначенныеПользователи = НазначенныеПользователи;
				ДокументыДляОбработкиВыбора.Очистить();
				Прервать;
			КонецЕсли;
			
			Если НазначенныеПользователи = "Выгружать всем" Тогда
				НазначенныеПользователи = Неопределено;
			КонецЕсли;
			
			СтрокаДокумента.НазначенныеПользователи = НазначенныеПользователи;
			
		КонецЕсли;
		 
	КонецЦикла;
	
	ПараметрыВыгрузки.Вставить("ВыгрузитьВОдин_НазначенныеПользователи", ВыгрузитьВОдин_НазначенныеПользователи);
	
	Если ДокументыДляОбработкиВыбора.Количество() Тогда
		
		пУстройстваMS = Неопределено;
		Если ПолучитьУстройства Тогда
			пУстройстваMS 	= ЛокЯдро_ПолучитьМобильныеУстройстваSMARTS();
			пУстройстваMS 	= ЛокЯдро_ПодготовитьДеревоУстройствНаСервере(пУстройстваMS);
		КонецЕсли;
		
		ПользователиMS = ЛокЯдро_ПодготовитьДеревоПользователейНаСервере(СтруктураМетаданных.ПользователиMS);
		
		ПараметрыВыбора = Новый Структура;
		ПараметрыВыбора.Вставить("СоответствиеНастроекБП", СоответствиеНастроекБП);
		ПараметрыВыбора.Вставить("ПользователиMS", ПользователиMS);
		ПараметрыВыбора.Вставить("УстройстваMS", пУстройстваMS);
		ПараметрыВыбора.Вставить("ДокументыДляОбработкиВыбора", ДокументыДляОбработкиВыбора);
		
		ПараметрыВыгрузки.Вставить("ПараметрыВыбора", ПараметрыВыбора);
		ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователей(ПараметрыВыгрузки);
		
	Иначе
		ЛокЯдро_ВыгрузкаДокументов_НачатьВыгрузку(ПараметрыВыгрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователей(ПараметрыВыгрузки, Отказ = Ложь)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователей";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки,Отказ",
		ПараметрыВыгрузки, Отказ);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Отказ Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = ПараметрыВыгрузки.ПараметрыВыбора;
	Если НЕ ПараметрыВыбора.Свойство("ДокументыДляОбработкиВыбора") 
		ИЛИ НЕ ПараметрыВыбора.ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыВыгрузки.Удалить("ПараметрыВыбора");
		ЛокЯдро_ВыгрузкаДокументов_НачатьВыгрузку(ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДокументыДляОбработкиВыбора 	= ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	СтрокаДокумента 						= ДокументыДляОбработкиВыбора[0];
	НастройкаБП 							= ПараметрыВыгрузки.СоответствиеНастроекБП.Получить(СтрокаДокумента.НастройкаБизнесПроцесса);
	СпособНазначения 					= ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
	
	Если СпособНазначения = "Устройству" Тогда
		НазначенияMS = ПараметрыВыбора.УстройстваMS;
	Иначе
		НазначенияMS = ПараметрыВыбора.ПользователиMS;
	КонецЕсли;
	
	Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
		СвязанныеСтрокиДокументов = ПараметрыВыгрузки.СтрокиДокументов1С;
	Иначе
		СвязанныеСтрокиДокументов = Новый Массив;
	КонецЕсли;
	
	ПараметрыВыбора.Вставить("ТекущаяСтрокаДокумента", СтрокаДокумента);
	ПараметрыВыбора.Вставить("СпособНазначения", СпособНазначения);
	ПараметрыВыбора.Вставить("СвязанныеСтрокиДокументов", СвязанныеСтрокиДокументов);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы = ЭтаФорма.ВладелецФормы.ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы", ЭтаФорма);
	#Иначе		
		ФормаСлужебная_ВыборПользователяИлиГруппы = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ВыборПользователяИлиГруппы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаСлужебная_ВыборПользователяИлиГруппы.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборПользователяИлиГруппы._ЛокКонтекст = ЭтаФорма;
	
	Если СпособНазначения = "Устройству" Тогда                                                                                      
		Если ДокументыДляОбработкиВыбора.Количество() > 1 Тогда
			ТекстЗаголовка = НСтр("ru = 'Выберите устройство для документа %1 и еще %2 документов';
									|en = 'Select the device for document %1 and %2 more documents';
									|be = 'Выберыце прыладу для дакумента %1 і яшчэ %2 дакументаў'; es = 'Seleccione un dispositivo para el documento %1 y otro % 2 documentos'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტი %1 და % 2 სხვა დოკუმენტები'; kk = 'Құжат үшін құрылғыны таңдаңыз %1 және тағы %2 құжат'; ro = 'Selectați dispozitivul pentru document %1 și %2 mai multe documente'; tr = 'Belge %1 ve diğer belge %2 için bir cihaz seçin'; uk = 'Виберіть пристрій для документа %1 і ще %2 документів'; uz = '%1 hujjat va yana %2 hujjat uchun qurilmani tanlang'");
			ТекстЗаголовка = ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка), Строка(ДокументыДляОбработкиВыбора.Количество()-1));
		Иначе     
			ТекстЗаголовка = НСтр("ru = 'Выберите устройство для документа %1';
									|en = 'Select the device for the document %1'; be = 'Выберыце прыладу для дакумента %1'; es = 'Seleccione el dispositivo para el documento %1'; ka = 'აირჩიეთ მოწყობილობა დოკუმენტისთვის %1'; kk = '%1 құжаты үшін құрылғыны таңдаңыз'; ro = 'Selectați dispozitivul pentru documentul %1'; tr = '%1 belgesi için cihazı seçin'; uk = 'Виберіть пристрій для документа %1'; uz = '%1 hujjati uchun qurilmani tanlang'");
			ТекстЗаголовка = ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка));
		КонецЕсли;
		ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;
		ФормаСлужебная_ВыборПользователяИлиГруппы.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("ru = 'Устройство';
																													|en = 'Device'; be = 'Прыстасаванне'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
	КонецЕсли;
	
	Если ДокументыДляОбработкиВыбора.Количество() > 1 Тогда
		ТекстЗаголовка = НСтр("ru = 'Выберите пользователя для документа %1 и еще %2 документов';
								|en = 'Select a user for document %1 and %2 more documents';
								|be = 'Выберыце карыстальніка для дакумента %1 і яшчэ %2 дакументаў'; es = 'Seleccione un usuario para el documento %1 y otro documento %2'; ka = 'აირჩიეთ მომხმარებელი დოკუმენტისთვის %1 და % 2 მეტი დოკუმენტი'; kk = '%1 құжаты үшін пайдаланушыны және қосымша %2 құжатты таңдаңыз'; ro = 'Selectați un utilizator pentru documentul %1 și %2 mai multe documente'; tr = '%1 belgesi ve %2 belgesi için bir kullanıcı seçin'; uk = 'Виберіть користувача для документа %1 і ще %2 документів'; uz = '%1 hujjat va yana %2 hujjat uchun foydalanuvchini tanlang'");
		ТекстЗаголовка = ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка), Строка(ДокументыДляОбработкиВыбора.Количество()-1));
	Иначе     
		ТекстЗаголовка = НСтр("ru = 'Выберите пользователя для документа %1';
								|en = 'Select the user for the document %1'; be = 'Выберыце карыстальніка для дакумента %1'; es = 'Seleccione un usuario para el documento %1'; ka = 'აირჩიეთ მომხმარებელი დოკუმენტისთვის %1'; kk = '%1 құжаты үшін пайдаланушыны таңдаңыз'; ro = 'Selectați utilizatorul pentru documentul %1'; tr = '%1 belgesi için bir kullanıcı seçin'; uk = 'Виберіть користувача для документа %1'; uz = '%1 hujjati uchun foydalanuvchini tanlang'");
		ТекстЗаголовка = ЛокЯдро_СтрШаблон(ТекстЗаголовка, Строка(СтрокаДокумента.Ссылка));
	КонецЕсли;
	
	ФормаСлужебная_ВыборПользователяИлиГруппы.Заголовок = ТекстЗаголовка;				
	ФормаСлужебная_ВыборПользователяИлиГруппы.ПользователиMSАдрес = НазначенияMS;
	ФормаСлужебная_ВыборПользователяИлиГруппы.ОдиночныйРежимВыделения = Истина;
	ФормаСлужебная_ВыборПользователяИлиГруппы.СпособНазначения = СпособНазначения;
	                                                             
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователейЗавершение", ЭтаФорма, ПараметрыВыгрузки);
	ФормаСлужебная_ВыборПользователяИлиГруппы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборПользователяИлиГруппы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборПользователяИлиГруппы.Открыть();
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователейЗавершение(РезультатВыбора, ПараметрыВыгрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователейЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВыбора,ПараметрыВыгрузки",
		РезультатВыбора, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С 				= ПараметрыВыгрузки.СтрокиДокументов1С;
	ДокументыДляОбработкиВыбора 	= ПараметрыВыгрузки.ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	ТекущаяСтрокаДокумента 			= ПараметрыВыгрузки.ПараметрыВыбора.ТекущаяСтрокаДокумента;
	СпособНазначения			 	= ПараметрыВыгрузки.ПараметрыВыбора.СпособНазначения;
	СвязанныеСтрокиДокументов 		= ПараметрыВыгрузки.ПараметрыВыбора.СвязанныеСтрокиДокументов;
	
	Если РезультатВыбора <> Неопределено 
		И ТипЗнч(РезультатВыбора) = Тип("Массив")
		И РезультатВыбора.Количество() > 0 Тогда
		
		Если РезультатВыбора[0].Ид = "Выгружать всем" Тогда
			РезультатВыбора = Неопределено;
		КонецЕсли;
		
		Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				ТекущаяСтрокаДокумента.НазначенныеПользователи = РезультатВыбора;
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;
			
			ПараметрыВыгрузки.ВыгрузитьВОдин_НазначенныеПользователи = РезультатВыбора;
			
		Иначе
			ТекущаяСтрокаДокумента.НазначенныеПользователи = РезультатВыбора;
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	Иначе
		
		Если СпособНазначения = "Устройству" Тогда
			Сообщение = НСтр("ru = 'Не выбрано устройство для работы с документом ""%1""! Документ не выгружен на ТСД';
								|en = 'The device for working with the ""%1"" document is not selected! The document has not been uploaded to a Mobile device';
								|be = 'Не абрана прылада для працы з дакументам ""%1""! Дакумент не выгружаны на мабільную прыладу'; es = '¡No se ha seleccionado ningún dispositivo para trabajar con el documento ""%1""! El documento no se ha descargado en el dispositivo Móvil'; ka = '""%1 "" დოკუმენტთან მუშაობის მოწყობილობა არ არის შერჩეული! დოკუმენტი არ არის ატვირთული მობილურ მოწყობილობაზე'; kk = '""%1 "" құжатымен жұмыс істеу үшін құрылғы таңдалмаған! Құжат мобильді құрылғыға жүктелмеген'; ro = 'Dispozitivul pentru lucrul cu documentul ""%1 "" nu este selectat! Documentul nu a fost încărcat pe un dispozitiv mobil'; tr = '""%1"" belgesiyle çalışmak için cihaz seçilmedi! Belge Mobil cihaza yüklenmedi'; uk = 'Не вибрано пристрій для роботи з документом ""%1""! Документ не вивантажено на мобільний пристрій'; uz = '""%1"" hujjati bilan ishlash uchun moslama tanlanmagan! Hujjat mobil qurilmaga yuklanmagan'");
		Иначе
			Сообщение = НСтр("ru = 'Не выбран пользователь для работы с документом ""%1""! Документ не выгружен на ТСД.';
								|en = 'The user has not been selected to work with the %1 document! The document has not been uploaded to a Mobile device.';
								|be = 'Не абраны карыстальнік для працы з дакументам ""%1""! Дакумент не выгружаны на мабільную прыладу.'; es = '¡No se ha seleccionado un usuario para trabajar con el documento ""%1""! El documento no se ha descargado en el dispositivo Móvil.'; ka = 'მომხმარებელი არ არის შერჩეული %1 დოკუმენტთან მუშაობისთვის! დოკუმენტი არ არის ატვირთული მობილურ მოწყობილობაზე.'; kk = '""%1 "" құжатымен жұмыс істеу үшін пайдаланушы таңдалмаған! Құжат мобильді құрылғыға жүктелмеген.'; ro = 'Utilizatorul nu a fost selectat pentru a lucra cu documentul %1! Documentul nu a fost încărcat pe un dispozitiv mobil.'; tr = '""%1"" belgesiyle çalışmak için kullanıcı seçilmedi! Belge Mobil cihaza yüklenmedi.'; uk = 'Не обраний Користувач для роботи з документом ""%1""! Документ не вивантажено на мобільний пристрій.'; uz = 'Foydalanuvchi %1 hujjati bilan ishlash uchun tanlanmagan! Hujjat mobil qurilmaga yuklanmagan.'");
		КонецЕсли;
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, ТекущаяСтрокаДокумента.Ссылка);
		ЛокЯдро_СообщениеПользователю(Сообщение, ПараметрыВыгрузки.Форма);
			
		Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(СтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;			
		Иначе
			СтрокиДокументов1С.Удалить(СтрокиДокументов1С.Найти(ТекущаяСтрокаДокумента));
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = Ложь;
	ЛокЯдро_ВыгрузкаДокументов_ВыбратьПользователей(ПараметрыВыгрузки, Отказ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_НачатьВыгрузку(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_НачатьВыгрузку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С = ПараметрыВыгрузки.СтрокиДокументов1С;
	
	Если НЕ СтрокиДокументов1С.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для выгрузки.';
							|en = 'There are no selected documents to upload.'; be = 'Няма вылучаных дакументаў для выгрузкі.'; es = 'No hay documentos seleccionados para descargar.'; ka = 'ატვირთვის არჩეული დოკუმენტები არ არის.'; kk = 'Жүктеу үшін таңдалған құжаттар жоқ.'; ro = 'Nu există documente selectate de încărcat.'; tr = 'Yüklenecek seçili belge yok.'; uk = 'Немає обраних документів для вивантаження.'; uz = 'Yuklash uchun tanlangan hujjatlar yo''q.'");
		ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыВыгрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	ПараметрыВыгрузки.Вставить("ТипБазы", ТипБазы);
	
	СоответствиеНастроекБПДляИсполнения = ЛокЯдро_ОтобратьНастройкиБПВыбранныхДокументов(
		ПараметрыВыгрузки,
		"СтрокиДокументов1С",
		"ВыгрузитьВОдин",
		"ВыгрузитьВОдин_НастройкаБП");
	ПараметрыВыгрузки.Вставить("СоответствиеНастроекБП", СоответствиеНастроекБПДляИсполнения);
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаСервере(ПараметрыВыгрузки);
	Иначе	
		РезультатыВыгрузки = ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаКлиенте(ПараметрыВыгрузки);
		ЛокЯдро_ВыгрузкаДокументов_Завершение(РезультатыВыгрузки, ПараметрыВыгрузки);
	КонецЕсли;
		
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаСервере(ПараметрыВыгрузки)
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаСервере";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	локПараметрыВыгрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыВыгрузки);
	локПараметрыВыгрузки.Удалить("ОповещениеОбработкиЗавершения");
	локПараметрыВыгрузки.Удалить("ОповещениеОбработкиОшибки");
	локПараметрыВыгрузки.Удалить("Форма");
	
	Если ДоступноВыполнениеВФоне = Истина Тогда
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПараметрыВыгрузки", локПараметрыВыгрузки);
		ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);
		//ПараметрыМетода.Вставить("Автотест", АвтотестКлеверенс);

		ПараметрыФЗ = Новый Структура;
		ПараметрыФЗ.Вставить("ИмяМетода", 						"ГлЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыВБазуSMARTS");
		ПараметрыФЗ.Вставить("ПараметрыМетода", 				ПараметрыМетода);		
		ПараметрыФЗ.Вставить("НаименованиеФЗ",					НСтр("ru = 'Выгрузка документов';
																		|en = 'Uploading documents'; be = 'Выгрузка дакументаў'; es = 'Descarga de documentos'; ka = 'დოკუმენტების ატვირთვა'; kk = 'Құжаттарды түсіру'; ro = 'Încărcarea documentelor'; tr = 'Belgelerin yüklenmesi'; uk = 'Вивантаження документів'; uz = 'Hujjatlarni yuklash'"));
		ПараметрыФЗ.Вставить("ТекстСообщения", 					ПараметрыФЗ.НаименованиеФЗ);
		ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 		Истина);
		ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 	Истина);
		ПараметрыФЗ.Вставить("ИнтервалПроверкиВыполнения", 	1);
		ПараметрыФЗ.Вставить("ЗапускВФоне", 						Истина);
		
		ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузкаДокументов_Завершение", ЭтаФорма, ПараметрыВыгрузки);
		ОповещениеОбработкиОшибки = Новый ОписаниеОповещения("ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку", ЭтаФорма, ПараметрыВыгрузки);
		
		ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОповещениеОбработкиЗавершения, ОповещениеОбработкиОшибки);
		
	Иначе
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ВыгрузкаДокументов_ВыгрузитьДокументыВБазуSMARTS");
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Параметры", Новый Структура("ПараметрыВыгрузки", локПараметрыВыгрузки));
		СтруктураВызова.Вставить("ПараметрыМетода", СтруктураПараметров);
		
		РезультатыВыгрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		ЛокЯдро_ВыгрузкаДокументов_Завершение(РезультатыВыгрузки, ПараметрыВыгрузки);
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаКлиенте(ПараметрыВыгрузки)
		
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьДокументыНаКлиенте";
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыгрузки",
		ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов1С 		= ПараметрыВыгрузки.СтрокиДокументов1С;
	СоответствиеНастроекБП 	= ПараметрыВыгрузки.СоответствиеНастроекБП;
	ТипБазы					= ПараметрыВыгрузки.ТипБазы;
	
	СписокПередаваемыхНастроек = Новый Структура();
			
	Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", "Шапка");
	ПроизвольныеКодыШапки = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыШапки",ПроизвольныеКодыШапки);
	
	Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", "ТабличнаяЧасть");
	ПроизвольныеКодыТабличнойЧасти = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыТабличнойЧасти",ПроизвольныеКодыТабличнойЧасти);
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередВыгрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОтправкиДокумента");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаЗагрузки = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаВыгрузки",ПроизвольныеКодыОбработчикаЗагрузки);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередВыгрузкойТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиТЧ");
	МассивТиповОбъектов.Добавить("ПослеОбъединенияТЧ");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаТЧ = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаТЧ",ПроизвольныеКодыОбработчикаТЧ);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередВыгрузкойСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеОбъединенияСтрокиТЧ");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаСтрокиТЧ = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	СписокПередаваемыхНастроек.Вставить("ПроизвольныеКодыОбработчикаСтрокиТЧ",ПроизвольныеКодыОбработчикаСтрокиТЧ);
	  	
	СписокПередаваемыхНастроек.Вставить("ЗначенияПараметров", ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров());
	
	РезультатыВыгрузки = Новый Соответствие;
	
	Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
		
		МассивСсылокДокументов = Новый Массив;
		Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
			МассивСсылокДокументов.Добавить(СтрокаДокумента.Ссылка);
		КонецЦикла;
		
		Документ1С = СтрокаДокумента.Ссылка;
		ID_БизнесПроцесса = ПараметрыВыгрузки.ВыгрузитьВОдин_НастройкаБП;
		
		НастройкаБП = СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
		УказатьПользователя 				= НастройкаБП.НазначитьПользователю =  "Спрашивать при выгрузке";	
		НазначенныеПользователи 			= ?(НастройкаБП.НазначитьПользователю = "Выгружать всем", Неопределено, ПараметрыВыгрузки.ВыгрузитьВОдин_НазначенныеПользователи);
		//КопияДляКаждогоПользователя 		= ?(УказатьПользователя, НастройкаБП.КопияДокументаДляКаждогоПользователя, Ложь);
		//СпособНазначения 					= ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
		
		СписокБизнесПроцессов = Новый Массив;
		СписокБизнесПроцессов.Добавить(НастройкаБП);
		СписокПередаваемыхНастроек.Вставить("СписокБизнесПроцессов",  СписокБизнесПроцессов);
		
		РезультатВыгрузки = ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(МассивСсылокДокументов, 
								ID_БизнесПроцесса, 
								НазначенныеПользователи, 
								ТипБазы, 
								СписокПередаваемыхНастроек);
			
		РезультатыВыгрузки.Вставить(СтрокиДокументов1С[0], РезультатВыгрузки);
			
	Иначе
		Для каждого СтрокаДокумента Из СтрокиДокументов1С Цикл
			Документ1С = СтрокаДокумента.Ссылка;
			ID_БизнесПроцесса = СтрокаДокумента.НастройкаБизнесПроцесса;
			
			НастройкаБП = СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
			УказатьПользователя 				= НастройкаБП.НазначитьПользователю =  "Спрашивать при выгрузке";	
			НазначенныеПользователи 			= ?(НастройкаБП.НазначитьПользователю = "Выгружать всем", Неопределено, СтрокаДокумента.НазначенныеПользователи);
			//КопияДляКаждогоПользователя 		= ?(УказатьПользователя, НастройкаБП.КопияДокументаДляКаждогоПользователя, Ложь);
			//СпособНазначения 					= ?(НастройкаБП.Свойство("СпособНазначения"), НастройкаБП.СпособНазначения, "");
			
			СписокБизнесПроцессов = Новый Массив;
			СписокБизнесПроцессов.Добавить(НастройкаБП);
			СписокПередаваемыхНастроек.Вставить("СписокБизнесПроцессов",  СписокБизнесПроцессов);
			
			РезультатВыгрузки = ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(Документ1С, 
									ID_БизнесПроцесса, 
									НазначенныеПользователи, 
									ТипБазы, 
									СписокПередаваемыхНастроек);
				
			РезультатыВыгрузки.Вставить(СтрокаДокумента, РезультатВыгрузки);
				
		КонецЦикла;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыВыгрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатыВыгрузки;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_Завершение(РезультатыВыгрузки, ПараметрыВыгрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_Завершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатыВыгрузки,ПараметрыВыгрузки",
		РезультатыВыгрузки, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(РезультатыВыгрузки) Тогда
		РезультатыВыгрузки = ПолучитьИзВременногоХранилища(РезультатыВыгрузки);	
	КонецЕсли;
	
	Если РезультатыВыгрузки = Неопределено Тогда
		ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку(РезультатыВыгрузки, ПараметрыВыгрузки);
	КонецЕсли;
	
	УспешноВыгружено = 0;
	Для каждого КлючЗначение Из РезультатыВыгрузки Цикл
		
		СтрокаДокумента = КлючЗначение.Ключ;
		РезультатВыгрузки = КлючЗначение.Значение;
		
		Если РезультатВыгрузки.СтатусВыгрузки Тогда
			УспешноВыгружено = УспешноВыгружено + 1;
			
			Если ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
				Прервать;
			КонецЕсли;
			
		ИначеЕсли НЕ ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
			пСообщение = НСтр("ru = 'Не удалось выгрузить документ «%1»! Подробности см. в журнале регистрации.';
								|en = 'The ""%1"" document could not be uploaded! For details, see in the registration log.';
								|be = 'Не атрымалася выгрузіць Дакумент ""%1""! Падрабязнасці гл. у часопісе рэгістрацыі.'; es = '¡No se pudo descargar el documento ""%1""! Consulte el registro para obtener más detalles.'; ka = '""%1 "" დოკუმენტი ვერ აიტვირთა! დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში.'; kk = '""%1 "" құжатын түсіру мүмкін болмады! Мәліметтерді тіркеу журналынан қараңыз.'; ro = 'Documentul ""%1 "" nu a putut fi încărcat! Consultați jurnalul de înregistrare pentru detalii.'; tr = '«% 1"" belgesi yüklenemedi! Ayrıntılar için kayıt defterine bakın.'; uk = 'Не вдалося вивантажити документ ""%1""! Подробиці див. в журналі реєстрації.'; uz = '""%1 "" hujjatini tushirib bo''lmadi! Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang.'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтрокаДокумента.Ссылка);
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыВыгрузки.Форма);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
		
		пСообщение = НСтр("ru = 'На ТСД успешно выгружено %1 документов.';
							|en = '%1 of the documents were successfully uploaded to the Mobile device.'; be = 'На мабільную прыладу паспяхова выгружана %1 дакументаў.'; es = '%1 documentos se descargaron correctamente en el dispositivo Móvil.'; ka = 'დოკუმენტების % 1 წარმატებით აიტვირთა მობილურ მოწყობილობაზე.'; kk = 'Мобильді құрылғыға %1 құжат сәтті түсірілді.'; ro = '%1 din documente au fost încărcate cu succes pe dispozitivul mobil.'; tr = 'Belgelerin% 1''i mobil cihaza başarıyla yüklendi.'; uk = 'На мобільний пристрій успішно вивантажено %1 документів.'; uz = '%1 hujjat mobil qurilmaga muvaffaqiyatli tushirildi.'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, УспешноВыгружено);
		ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыВыгрузки.Форма);
		
	ИначеЕсли ПараметрыВыгрузки.ВыгрузитьВОдин Тогда
		
		Если УспешноВыгружено = 0 Тогда
			пСообщение = НСтр("ru = 'Не удалось выгрузить объединённый документ. Подробности см. в журнале регистрации.';
								|en = 'The combined document could not be uploaded. For details, see in the registration log.';
								|be = 'Не атрымалася выгрузіць аб''яднаны дакумент. Падрабязнасці гл. у часопісе рэгістрацыі.'; es = 'No se pudo descargar el documento combinado. Consulte el registro para obtener más detalles.'; ka = 'კომბინირებული დოკუმენტის ატვირთვა ვერ მოხერხდა. დეტალებისთვის იხილეთ სარეგისტრაციო ჟურნალში.'; kk = 'Біріктірілген құжатты түсіру мүмкін болмады. Мәліметтерді тіркеу журналынан қараңыз.'; ro = 'Documentul combinat nu a putut fi încărcat. Consultați jurnalul de înregistrare pentru detalii.'; tr = 'Birleştirilmiş belge yüklenemedi. Ayrıntılar için kayıt defterine bakın.'; uk = 'Не вдалося вивантажити об''єднаний документ. Подробиці див. в журналі реєстрації.'; uz = 'Birlashtirilgan hujjatni tushirib bo''lmadi. Tafsilotlar uchun ro''yxatdan o''tish jurnaliga qarang.'");
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыВыгрузки.Форма);
		Иначе
			пСообщение = НСтр("ru = 'Выделенные документы объединены и выгружены на ТСД';
								|en = 'The selected documents are combined and uploaded to a Mobile device';
								|be = 'Выдзеленыя дакументы аб''яднаны і выгружаны на мабільную прыладу'; es = 'Los documentos seleccionados se combinan y se cargan en el dispositivo Móvil'; ka = 'შერჩეული დოკუმენტები გაერთიანებულია და ატვირთულია მობილურ მოწყობილობაზე'; kk = 'Бөлінген құжаттар біріктіріліп мобильді құрылғыға түсірілді'; ro = 'Documentele selectate sunt combinate și încărcate pe un dispozitiv mobil'; tr = 'Vurgulanan belgeler birleştirilir ve Mobil cihaza yüklenir'; uk = 'Виділені документи об''єднані і вивантажені на мобільний пристрій'; uz = 'Ajratilgan hujjatlar birlashtirilib, mobil qurilmaga yuklanadi'");
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыВыгрузки.Форма);
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыгрузки.ОповещениеОбработкиЗавершения, РезультатыВыгрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку(Результат, ПараметрыВыгрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузкаДокументов_ОбработатьОшибку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыВыгрузки",
		Результат, ПараметрыВыгрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(Результат) = Тип("Строка") И НЕ ПустаяСтрока(Результат) Тогда
		ЛокЯдро_СообщениеПользователю(Результат, ПараметрыВыгрузки.Форма);
	КонецЕсли;
	
	Если ПараметрыВыгрузки.ОповещениеОбработкиОшибки <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыВыгрузки.ОповещениеОбработкиОшибки, Результат);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ЛокальныйКонтекст_ЗагрузкаДокументов

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьВОткрытыйДокумент(ОбъектНазначения, ПараметрыВызова) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьВОткрытыйДокумент";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОбъектНазначения,ПараметрыВызова",
		ОбъектНазначения, ПараметрыВызова);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыЗагрузки = ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, ПараметрыВызова);
	
	ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент";
	ПараметрыЗагрузки.СтрокиДокументов = Новый Массив;
	
	ОбъектыНазначения = Новый Массив;
	ОбъектыНазначения.Добавить(ОбъектНазначения);
	ПараметрыЗагрузки.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	
	ПараметрыЗагрузки.Вставить("ТипыДокументов1С", Новый Массив);
	ПараметрыЗагрузки.Вставить("ИдДокументов1С", Новый Массив);
	
	локПараметрыЗагрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыЗагрузки);
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиЗавершения");
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиОшибки");
	локПараметрыЗагрузки.Удалить("Форма");
	локПараметрыЗагрузки.Удалить("ФормаДокументаНазначения");
	
	ЛокЯдро_ЗагрузкаДокументов_ОбработатьПараметрыЗагрузкиНаСервере(локПараметрыЗагрузки);
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, локПараметрыЗагрузки);
	
	ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTS(ПараметрыЗагрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзСпискаДокументов(ОбъектыНазначения, ПараметрыВызова) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзСпискаДокументов";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОбъектыНазначения,ПараметрыВызова",
		ОбъектыНазначения, ПараметрыВызова);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыЗагрузки = ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, ПараметрыВызова);
	
	ПараметрыЗагрузки.РежимЗагрузки = "ИзСпискаДокументов";
	ПараметрыЗагрузки.СтрокиДокументов = Новый Массив;
	
	ПараметрыЗагрузки.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	ПараметрыЗагрузки.Вставить("ТипыДокументов1С", Новый Массив);
	ПараметрыЗагрузки.Вставить("ИдДокументов1С", Новый Массив);
	
	локПараметрыЗагрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыЗагрузки);
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиЗавершения");
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиОшибки");
	локПараметрыЗагрузки.Удалить("Форма");
	локПараметрыЗагрузки.Удалить("ФормаДокументаНазначения");
	
	ЛокЯдро_ЗагрузкаДокументов_ОбработатьПараметрыЗагрузкиНаСервере(локПараметрыЗагрузки);
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, локПараметрыЗагрузки);
	
	ПараметрыЗагрузки.ИдДокументов1С.Очистить();
	ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTS(ПараметрыЗагрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЛокЯдро_ЗагрузкаДокументов_ОбработатьПараметрыЗагрузкиНаСервере(ПараметрыЗагрузки)
	
	ОбъектыНазначения 	= ПараметрыЗагрузки.ОбъектыНазначения;
	ТипыДокументов1С 	= ПараметрыЗагрузки.ТипыДокументов1С;
	ИдДокументов1С 		= ПараметрыЗагрузки.ИдДокументов1С;
	
	Для каждого ОбъектНазначения Из ОбъектыНазначения Цикл
		ТипыДокументов1С.Добавить(ОбъектНазначения.Метаданные().Имя);
		ИдДокументов1С.Добавить(XMLСтрока(ОбъектНазначения));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTS(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 	= ПараметрыЗагрузки.СтрокиДокументов;
	ТипыДокументов1С 	= ПараметрыЗагрузки.ТипыДокументов1С;
	ИдДокументов1С 		= ПараметрыЗагрузки.ИдДокументов1С;
	ID_Узла 			= ПараметрыЗагрузки.ID_Узла;
	
	ФильтрТекущегоУзла = Неопределено;
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		ФильтрТекущегоУзла = Новый Структура("ID_Узла", ID_Узла)
	КонецЕсли;
	
	ДокументыMS = ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS(,,, ФильтрТекущегоУзла);
	
	// Определяем доступные БП
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	
	СтрокиБП = Новый Массив;
	Для Каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Используется и ТипыДокументов1С.Найти(НастройкаБП.ТипРезультирующегоДокумента1С) <> Неопределено Тогда
			СтрокиБП.Добавить(НастройкаБП);			
		КонецЕсли;
	КонецЦикла;
		
	// Сформируем список возможных операций смартс, для которых настроены БП для загрузки в текущий тип документа 1С
	МассивТиповДокументовМС = Новый Массив;	
	Для Каждого СтрокаБП из СтрокиБП Цикл
		Если МассивТиповДокументовМС.Найти(СтрокаБП.ТипДокументаMS) = Неопределено Тогда
			МассивТиповДокументовМС.Добавить(СтрокаБП.ТипДокументаMS);
		КонецЕсли;
	КонецЦикла;
	
	ПереданнаяТаблица = Новый Массив;
	ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"ВремяЗавершения,Имя,Ид,ИмяПользователя,ИмяТипаДокумента,ИмяБП,СтрокиФактКоличество"));
	
	Для каждого ДокументТСД Из ДокументыMS Цикл
		Если ДокументТСД.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		// Если есть документ назначения, то ищем этот документ в MS
		Если ИдДокументов1С.Количество() Тогда
			
			ИдДокумента1С = ИдДокументов1С[0];
			
			ИдДокументаВбазе = ДокументТСД.Ид;
			Если Найти(ИдДокументаВбазе,"#") > 0
				И Найти(ИдДокумента1С,"#") = 0 Тогда
				ИдДокументаВБазе = Лев(ИдДокументаВбазе, Найти(ИдДокументаВбазе,"#")-1);
			КонецЕсли;
			
			Если ИдДокументов1С.Найти(ИдДокументаВБазе) <> Неопределено Тогда
				
				Если ДокументТСД.Завершен = Ложь Тогда
					пСообщение = НСтр("ru = 'Работа с текущим документом не завершена на тсд.';
										|en = 'Work with the current document has not been completed on the tsd.'; be = 'Праца з бягучым дакументам не завершана на тсд.'; es = 'El trabajo con el documento actual no se ha completado en TSD.'; ka = 'მიმდინარე დოკუმენტთან მუშაობა tsd-ზე არ დასრულებულა.'; kk = 'Ағымдағы құжатпен жұмыс ОТҚ-да аяқталған жоқ.'; ro = 'Lucrul cu documentul curent nu a fost finalizat pe tsd.'; tr = 'Tsd''de mevcut belgeyle çalışma tamamlanmadı.'; uk = 'Робота з поточним документом не завершена на тсд.'; uz = 'Joriy hujjat bilan ishlash tsdda tugallanmagan.'");
					ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(пСообщение, ПараметрыЗагрузки);
					
					// <Лог>
					ЛогЗавершитьСобытие(логСобытие);
					// </Лог>
					
					Возврат;
				КонецЕсли;
				
				ДокументТСД.Вставить("СписокБизнесПроцессов", Новый Соответствие);
				СтрокиДокументов.Добавить(ДокументТСД);
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		 
		Если МассивТиповДокументовМС.Найти(ДокументТСД.ИмяТипаДокумента) <> Неопределено
			И ДокументТСД.Завершен = Истина Тогда			
			НоваяСтруктура = Новый Структура("ВремяЗавершения,Имя,Ид,ИмяПользователя,ИмяТипаДокумента,ИмяБП,СтрокиФактКоличество");
			ЗаполнитьЗначенияСвойств(НоваяСтруктура, ДокументТСД);
			
			ПереданнаяТаблица.Добавить(НоваяСтруктура);
		КонецЕсли;
	КонецЦикла; 			
	
	Если СтрокиДокументов.Количество() > 0 Тогда
		ЛокЯдро_ЗагрузкаДокументов_Начало(ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы = ЛокЯдро_ПолучитьФорму("ФормаСлужебная_ВыборСтрокиИзТаблицы", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы = "ВыборДокументаТСД";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст = ЭтаФорма;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ПереданнаяТаблица = ПереданнаяТаблица;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ЗакрыватьПриЗакрытииВладельца = Ложь;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ДокументыMS", ДокументыMS);
	ПараметрыЗагрузки.Вставить("ПараметрыВыбора", ПараметрыВыбора);
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTSЗавершение", ЭтаФорма, ПараметрыЗагрузки);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTSЗавершение(РезультатВыбора, ПараметрыЗагрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументSMARTSЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВыбора,ПараметрыЗагрузки",
		РезультатВыбора, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЗначениеЗаполнено(РезультатВыбора) 
		И ЗначениеЗаполнено(РезультатВыбора.Данные) 
		И РезультатВыбора.Данные.Количество() Тогда
		
		СтрокиДокументов = ПараметрыЗагрузки.СтрокиДокументов;
		ДокументыMS = ПараметрыЗагрузки.ПараметрыВыбора.ДокументыMS;
		
		Для каждого ДокументТСД Из ДокументыMS Цикл
			Если ДокументТСД.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ДокументТСД.Ид = РезультатВыбора.Данные.Ид Тогда
				ДокументТСД.Вставить("СписокБизнесПроцессов", Новый Соответствие);
				СтрокиДокументов.Добавить(ДокументТСД);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЛокЯдро_ЗагрузкаДокументов_Начало(ПараметрыЗагрузки);
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена(СтрокиДокументовТЗ, ПараметрыВызова) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокиДокументовТЗ,ПараметрыВызова",
		СтрокиДокументовТЗ, ПараметрыВызова);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов = Новый Массив;
	Для каждого СтрокаТЗ Из СтрокиДокументовТЗ Цикл
		
		СтрокаДокумента = ЛокЯдро_СкопироватьСтруктуру(СтрокаТЗ);
		СтрокаДокумента.Вставить("СписокБизнесПроцессов", Новый Соответствие);
		СтрокиДокументов.Добавить(СтрокаДокумента);
		
	КонецЦикла;
	
	ПараметрыЗагрузки = ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова();
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, ПараметрыВызова);
	ПараметрыЗагрузки.СтрокиДокументов = СтрокиДокументов;
	
	ЛокЯдро_ЗагрузкаДокументов_Начало(ПараметрыЗагрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова() Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("СтрокиДокументов", Новый Массив);
	ПараметрыВызова.Вставить("ИдДокументовMS");
	ПараметрыВызова.Вставить("ID_Узла", "");
	ПараметрыВызова.Вставить("ЗагрузитьВОдин", Ложь);
	ПараметрыВызова.Вставить("ОповещениеОбработкиЗавершения"); // Обязательно для заполнения иначе ГлавнаяФорма может удалиться
	ПараметрыВызова.Вставить("ОповещениеОбработкиОшибки");
	ПараметрыВызова.Вставить("ВыбратьБизнесПроцесс", Ложь);
	ПараметрыВызова.Вставить("Форма");
	ПараметрыВызова.Вставить("ФормаДокументаНазначения");
	ПараметрыВызова.Вставить("РежимЗагрузки");
	
	Возврат ПараметрыВызова;
	
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_Начало(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_Начало";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов = ПараметрыЗагрузки.СтрокиДокументов;
	
	Если ПараметрыЗагрузки.ОповещениеОбработкиЗавершения = Неопределено Тогда
		ВызватьИсключение "ЛокЯдро_ЗагрузкаДокументов_Начало: Параметр ""ОповещениеОбработкиЗавершения"" обязателен для заполнения.";
	КонецЕсли;
	
	Если НЕ СтрокиДокументов.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для загрузки.'");
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗагрузки.ID_Узла) Тогда
		ПараметрыЗагрузки.ID_Узла = "";
	КонецЕсли;
	
	Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
		Если НЕ СтрокаДокумента.Свойство("ИдУзла")
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.ИдУзла) Тогда
			СтрокаДокумента.Вставить("ИдУзла", "");
		КонецЕсли;
	КонецЦикла;
	
	ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьБизнесПроцессы(ПараметрыЗагрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьБизнесПроцессы(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьБизнесПроцессы";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 		= ПараметрыЗагрузки.СтрокиДокументов;
	ЗагрузитьВОдин			= ПараметрыЗагрузки.ЗагрузитьВОдин;
	ВыбратьБизнесПроцесс 	= ПараметрыЗагрузки.ВыбратьБизнесПроцесс;
	
	ТипыДокументов1С = Неопределено;
	ПараметрыЗагрузки.Свойство("ТипыДокументов1С", ТипыДокументов1С);
	
	Если НЕ СтрокиДокументов.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для загрузки.'");
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Если ТипЗнч(НастройкиБизнесПроцессов) <> Тип("Массив") Тогда
		Сообщение = НСтр("ru = 'Номер ошибки #INTEX001. Нет настроенного или активного бизнес-процесса, настройте бизнес-процесс в настройках обработки для 1С %2 или загрузите по произвольному существующему бизнес-процессу через контекстное меню по нажатию правой кнопки мыши. Подробнее - https://www.cleverence.ru/support/97289/';
							|en = 'The error number is #INTEX001. There is no configured or active business process, configure the business process in the processing settings for 1C %2 or upload an arbitrary existing business process through the context menu by right-clicking. Learn more - https://www.cleverence.ru/support/97289/';
							|be = 'Нумар памылкі # INTEX001. Няма наладжанага або актыўнага бізнес-працэсу, Наладзьце бізнес-працэс у наладах апрацоўкі для 1С %2 або загрузіце па адвольным існуючага бізнес-працэсу праз кантэкстнае меню па націску правай кнопкі мышы. Больш падрабязна - https://www.cleverence.ru/support/97289/'; es = 'Número de error # INTEX001. No hay un proceso de negocio configurado o activo, configure el proceso de negocio en la configuración de procesamiento para 1C %2 o cargue un proceso de negocio existente arbitrario a través del menú contextual con un clic derecho. Más detalles - https://www.cleverence.ru/support/97289/'; ka = 'შეცდომის ნომერი არის # INTEX001. არ არსებობს კონფიგურირებული ან აქტიური ბიზნეს პროცესი, ბიზნეს პროცესის კონფიგურაცია დამუშავების პარამეტრებში 1c %2 ან ატვირთეთ თვითნებური არსებული ბიზნეს პროცესი კონტექსტური მენიუს მეშვეობით მარჯვენა ღილაკით. შეიტყვეთ მეტი - https://www.cleverence.ru/support/97289/'; kk = 'Қате нөмірі #INTEX001. Теңшелген немесе белсенді бизнес-процесс жоқ, 1С %2 үшін өңдеу параметрлерінде бизнес-процесті орнатыңыз немесе тінтуірдің оң жақ түймешігін басу арқылы контекстік мәзір арқылы бар бизнес-процесті жүктеңіз. Толығырақ - https://www.cleverence.ru/support/97289/'; ro = 'Numărul de eroare este # INTEX001. Nu există un proces de afaceri configurat sau activ, configurați procesul de afaceri în setările de procesare pentru 1C %2 sau încărcați un proces de afaceri arbitrar existent prin meniul contextual făcând clic dreapta. Aflați mai multe - https://www.cleverence.ru/support/97289/'; tr = 'Hata numarası #İNTEX001''DİR. Yapılandırılmış veya aktif bir iş süreci yoktur, % 1C 2 için işleme ayarlarında iş sürecini yapılandırın veya sağ fare düğmesine tıklayarak bağlam menüsünden keyfi bir mevcut iş sürecine göre yükleyin. Devamını oku - https://www.cleverence.ru/support/97289/'; uk = 'Номер помилки #INTEX001. Немає налаштованого або активного бізнес-процесу, налаштуйте бізнес-процес в Налаштуваннях обробки для 1С %2 або завантажте по довільному існуючому бізнес-процесу через контекстне меню після натискання правої кнопки миші. Детальніше - https://www.cleverence.ru/support/97289/'; uz = 'Xato raqami # INTEX001. Sozlangan yoki faol biznes jarayoni yo''q, 1C %2 uchun ishlov berish sozlamalarida biznes jarayonini sozlang yoki sichqonchaning o''ng tugmachasini bosish orqali kontekst menyusi orqali o''zboshimchalik bilan mavjud biznes jarayonini yuklang. Ko''proq o''qing - https://www.cleverence.ru/support/97289/'");
		Сообщение = ЛокЯдро_СтрШаблон(Сообщение, Символы.ПС);
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки); 
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СоответствиеНастроекБП = Новый Соответствие;
	Для каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
		Если НастройкаБП.Свойство("ЭтоТаблицаЗначений") И НастройкаБП.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		СоответствиеНастроекБП.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
	КонецЦикла;
	ПараметрыЗагрузки.Вставить("СоответствиеНастроекБП", СоответствиеНастроекБП);
	
	ПервыйДокумент = СтрокиДокументов[0];
	
	НастройкиБППоУзлам = Новый Соответствие;
	
	// Поиск доступных БП
	Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
		
		Если ЗагрузитьВОдин Тогда
			Если ПервыйДокумент.ИмяТипаДокумента <> СтрокаДокумента.ИмяТипаДокумента Тогда
				Сообщение = НСтр("ru = 'Выбраны разные типы документов. Для загрузки в один документ 1С необходимо, чтобы документы Клеверенс были одного типа.'");
				ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки); 
				
				// <Лог>
				ЛогЗавершитьСобытие(логСобытие);
				// </Лог>
				
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		
		// Получаем список БП для своего узла
		Если СтрокаДокумента.ИдУзла = ДанныеТекущегоУзла.ID_Узла Тогда
			НБП_ПользовательскиеНастройки = НастройкиБизнесПроцессов;
		Иначе
			НБП_ПользовательскиеНастройки = НастройкиБППоУзлам.Получить(СтрокаДокумента.ИдУзла);
			Если НБП_ПользовательскиеНастройки = Неопределено Тогда
				Если СтрокаДокумента.ИдУзла = "" Тогда
					// Для главного узла получаем собранные настройки, 
					//	т.к в НастройкиБизнесПроцессов_ПользовательскиеНастройки нет настроек для пользовательских БП
					НБП_ПользовательскиеНастройки = ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов();
				Иначе
					НБП_ПользовательскиеНастройки = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", СтрокаДокумента.ИдУзла);
				КонецЕсли;
				
				НастройкиБППоУзлам.Вставить(СтрокаДокумента.ИдУзла,  НБП_ПользовательскиеНастройки);
			КонецЕсли;
		КонецЕсли;
		
		Для каждого НастройкаБП Из НастройкиБизнесПроцессов Цикл
			
			Если ВыбратьБизнесПроцесс Тогда
				СтрокаДокумента.НастройкаБизнесПроцесса = "";
			КонецЕсли;
			
			// Проверяем, что БП включен для узла из документа
			Если НЕ СтрокаДокумента.ИдУзла = "" Тогда
				Отбор = Новый Структура("ID_БизнесПроцесса", НастройкаБП.ID_БизнесПроцесса);
				ПользовательскаяНастройка = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НБП_ПользовательскиеНастройки, Отбор, Истина);
				Если ПользовательскаяНастройка = Неопределено Тогда
					ПользовательскаяНастройка = НастройкаБП;
				КонецЕсли;
			Иначе
				ПользовательскаяНастройка = НастройкаБП;
			КонецЕсли;
			
			Если НЕ ПользовательскаяНастройка.Свойство("Используется")
				ИЛИ НЕ ПользовательскаяНастройка.Используется Тогда
				
				Если СтрокаДокумента.НастройкаБизнесПроцесса = НастройкаБП.ID_БизнесПроцесса Тогда
					// Очищаем ID_БизнесПроцесса в документе, т.к он выключен. Будет предложен выбор БП.
					СтрокаДокумента.НастройкаБизнесПроцесса = "";
				КонецЕсли;
				Продолжить;
				
			КонецЕсли;
			
			// Не заполнен результирующий документ или произвольный код загрузки
			ВыполнитьТолькоПроизвольныйКод = НастройкаБП.Свойство("ВыполнитьТолькоПроизвольныйКод")
				И НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина;
			Если НЕ ЗначениеЗаполнено(СокрЛП(НастройкаБП.ТипРезультирующегоДокумента1С))
				И НЕ ВыполнитьТолькоПроизвольныйКод Тогда
				
				Если СтрокаДокумента.НастройкаБизнесПроцесса = НастройкаБП.ID_БизнесПроцесса Тогда
					// Очищаем ID_БизнесПроцесса в документе, т.к он выключен. Будет предложен выбор БП.
					СтрокаДокумента.НастройкаБизнесПроцесса = "";
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			// Пропускаем БП, которые по плану, но документ создан на ТСД
			Если (НастройкаБП.Свойство("ТипИсходногоДокумента1С")
				И СтрокаДокумента.СозданНаТСД = ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С)) Тогда
				
				Если СтрокаДокумента.НастройкаБизнесПроцесса = НастройкаБП.ID_БизнесПроцесса Тогда
					// Очищаем ID_БизнесПроцесса в документе, т.к он выключен. Будет предложен выбор БП.
					СтрокаДокумента.НастройкаБизнесПроцесса = "";
				КонецЕсли;
				Продолжить;
				
			КонецЕсли;
			
			Если ВыбратьБизнесПроцесс Тогда
				СтрокаДокумента.СписокБизнесПроцессов.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
			ИначеЕсли НастройкаБП.Свойство("ТипДокументаMS") 
				И НастройкаБП.ТипДокументаMS = СокрЛП(СтрокаДокумента.ИмяТипаДокумента) Тогда
				
				Если ТипыДокументов1С <> Неопределено Тогда
					// Загрузка из встроенных кнопок: отображаем БП с отбором по типу документа, из которого вызвана загрузка
					Если ТипыДокументов1С.Найти(НастройкаБП.ТипРезультирующегоДокумента1С) <> Неопределено Тогда
						СтрокаДокумента.СписокБизнесПроцессов.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
					КонецЕсли;
				Иначе
					СтрокаДокумента.СписокБизнесПроцессов.Вставить(НастройкаБП.ID_БизнесПроцесса, НастройкаБП);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СообщениеРазныхБП = НСтр("ru = 'Для выбранных документов настроены разные бизнес процессы. Объединение невозможно.';
								|en = 'Different business processes are configured for the selected documents. Unification is impossible.';
								|be = 'Для выбраных дакументаў настроены розныя бізнес працэсы. Аб''яднанне немагчыма.'; es = 'Se configuran diferentes procesos de negocio para los documentos seleccionados. La Unión es imposible.'; ka = 'შერჩეული დოკუმენტებისთვის კონფიგურირებულია სხვადასხვა ბიზნეს პროცესები. გაერთიანება შეუძლებელია.'; kk = 'Таңдалған құжаттар үшін әртүрлі бизнес-процестер конфигурацияланған. Біріктіру мүмкін емес.'; ro = 'Diferite procese de afaceri sunt configurate pentru documentele selectate. Unificarea este imposibilă.'; tr = 'Seçilen belgeler için farklı iş süreçleri yapılandırılmıştır. Birleşme mümkün değildir.'; uk = 'Для обраних документів налаштовані різні бізнес процеси. Об''єднання неможливе.'; uz = 'Tanlangan hujjatlar uchun turli xil biznes jarayonlari tuzilgan. Birlashtirish mumkin emas.'");
	
	ЗагрузитьВОдин_НастройкаБП = "";
	ДокументыДляОбработкиВыбора = Новый Массив;
	ДоступныйСписокБП = Неопределено;
	
	// Заполняем бизнес-процессы
	Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
		
		// Очищаем БП, если его нет в списке доступных
		Если ЗначениеЗаполнено(СтрокаДокумента.НастройкаБизнесПроцесса)
			И СтрокаДокумента.СписокБизнесПроцессов.Получить(СтрокаДокумента.НастройкаБизнесПроцесса) = Неопределено Тогда
			СтрокаДокумента.НастройкаБизнесПроцесса = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.НастройкаБизнесПроцесса) Тогда
			// БП уже определен
			
		ИначеЕсли СтрокаДокумента.СписокБизнесПроцессов.Количество() = 1 Тогда
			// Единственный БП сразу запишем в документ
			
			// Костыль, т.к в соответствие нельзя обращаться по индексу
			Для каждого КлючЗначение Из СтрокаДокумента.СписокБизнесПроцессов Цикл
				СтрокаДокумента.НастройкаБизнесПроцесса = КлючЗначение.Ключ;
				Прервать;
			КонецЦикла;
			
		ИначеЕсли СтрокаДокумента.СписокБизнесПроцессов.Количество() > 1 Тогда
			// Обнаружено несколько БП, будет предложен выбор
			ДокументыДляОбработкиВыбора.Добавить(СтрокаДокумента);
			
		Иначе
			Сообщение = НСтр("ru = 'Для документа «%1» не настроен или не активен бизнес-процесс. Настройте бизнес-процесс либо выполните загрузку, выбрав существующий бизнес-процесс через контекстное меню (правая кнопка мыши).'");
			Сообщение = ЛокЯдро_СтрШаблон(Сообщение, СтрокаДокумента.Имя, Символы.ПС);
			Если ЗагрузитьВОдин Тогда
				// Для какого-то документа нет БП, прерываем загрузку объединенного документа
				ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
				
				// <Лог>
				ЛогЗавершитьСобытие(логСобытие);
				// </Лог>
				
				Возврат;
			Иначе
				// БП не найден, пропускаем текущий документ
				ЛокЯдро_СообщениеПользователю(Сообщение, ПараметрыЗагрузки.Форма);
				СтрокиДокументов.Удалить(СтрокиДокументов.Найти(СтрокаДокумента));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗагрузитьВОдин Тогда
			// Определяем по какому БП будет загружен объединенный документ
			Если ПустаяСтрока(ЗагрузитьВОдин_НастройкаБП) Тогда
				ЗагрузитьВОдин_НастройкаБП = СтрокаДокумента.НастройкаБизнесПроцесса;
				Если ДоступныйСписокБП = Неопределено Тогда
					ДоступныйСписокБП = СтрокаДокумента.СписокБизнесПроцессов;
				ИначеЕсли ДоступныйСписокБП.Количество() > СтрокаДокумента.СписокБизнесПроцессов.Количество() Тогда
					ДоступныйСписокБП = СтрокаДокумента.СписокБизнесПроцессов;
				КонецЕсли;
			Иначе
				Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ЗагрузитьВОдин_НастройкаБП) = Неопределено Тогда
					ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(СообщениеРазныхБП, ПараметрыЗагрузки);
					
					// <Лог>
					ЛогЗавершитьСобытие(логСобытие);
					// </Лог>
					
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыВыбора = Новый Структура;
	
	// Фильтруем бизнес-процессы, которые доступны во всех документах для объединения
	Если ЗагрузитьВОдин Тогда
		
		Если ДоступныйСписокБП = Неопределено
			ИЛИ НЕ ДоступныйСписокБП.Количество() Тогда
			ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(СообщениеРазныхБП, ПараметрыЗагрузки);
			
			// <Лог>
			ЛогЗавершитьСобытие(логСобытие);
			// </Лог>
			
			Возврат;
		КонецЕсли;
		
		локЗагрузитьВОдин_НастройкаБП = "";
		Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
			// Фильтрация БП доступных для всех документов
			Если ПустаяСтрока(ЗагрузитьВОдин_НастройкаБП) Тогда
				
				локДоступныйСписокБП = Новый Соответствие;
				Для каждого НастройкаБП Из ДоступныйСписокБП Цикл
					Если СтрокаДокумента.СписокБизнесПроцессов.Получить(НастройкаБП.Ключ) <> Неопределено Тогда
						локЗагрузитьВОдин_НастройкаБП = НастройкаБП.Ключ;
						локДоступныйСписокБП.Вставить(НастройкаБП.Ключ, НастройкаБП.Значение);
					КонецЕсли;
				КонецЦикла;
				ДоступныйСписокБП = локДоступныйСписокБП;
				
			Иначе
				Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ЗагрузитьВОдин_НастройкаБП) = Неопределено Тогда
					ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(СообщениеРазныхБП, ПараметрыЗагрузки);
					
					// <Лог>
					ЛогЗавершитьСобытие(логСобытие);
					// </Лог>
					
					Возврат;
				Иначе
					СтрокаДокумента.НастройкаБизнесПроцесса = ЗагрузитьВОдин_НастройкаБП;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ЗагрузитьВОдин_НастройкаБП) Тогда
			Если ДоступныйСписокБП.Количество() = 1 Тогда
				ЗагрузитьВОдин_НастройкаБП = локЗагрузитьВОдин_НастройкаБП;
				ДокументыДляОбработкиВыбора.Очистить();
			Иначе 
				ПараметрыВыбора.Вставить("ДоступныйСписокБП", ДоступныйСписокБП);
			КонецЕсли;
		Иначе
			ДокументыДляОбработкиВыбора.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыЗагрузки.Вставить("ЗагрузитьВОдин_НастройкаБП", ЗагрузитьВОдин_НастройкаБП);
	ПараметрыЗагрузки.Вставить("СтрокиДокументов", СтрокиДокументов);
	
	Если ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыВыбора.Вставить("ДокументыДляОбработкиВыбора", ДокументыДляОбработкиВыбора);
		ПараметрыЗагрузки.Вставить("ПараметрыВыбора", ПараметрыВыбора);
		ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыЗагрузки);
	Иначе
		ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументыДляЗаполнения(ПараметрыЗагрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыЗагрузки, Отказ = Ложь)
		
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцесс";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки,Отказ",
		ПараметрыЗагрузки, Отказ);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Отказ Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = ПараметрыЗагрузки.ПараметрыВыбора;
	Если НЕ ПараметрыВыбора.Свойство("ДокументыДляОбработкиВыбора") 
		ИЛИ НЕ ПараметрыВыбора.ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыЗагрузки.Удалить("ПараметрыВыбора");
		ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументыДляЗаполнения(ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДокументыДляОбработкиВыбора = ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	СтрокаДокумента = ДокументыДляОбработкиВыбора[0];
	
	Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
		СписокБизнесПроцессов = ПараметрыВыбора.ДоступныйСписокБП;
		СвязанныеСтрокиДокументов = ПараметрыЗагрузки.СтрокиДокументов;
		КоличествоДокументов = 1;
	Иначе
		СписокБизнесПроцессов = СтрокаДокумента.СписокБизнесПроцессов;
		
		ПоискДокументовТекТипа = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ДокументыДляОбработкиВыбора, Новый Структура("ИмяТипаДокумента, НастройкаБизнесПроцесса", СтрокаДокумента.ИмяТипаДокумента, ""), Ложь);
		Если ПоискДокументовТекТипа = Неопределено Тогда
			ПоискДокументовТекТипа = Новый Массив;
			ПоискДокументовТекТипа.Добавить(СтрокаДокумента);
		КонецЕсли;
		СвязанныеСтрокиДокументов = ПоискДокументовТекТипа;
		КоличествоДокументов = 	ПоискДокументовТекТипа.Количество();	
	КонецЕсли;
	
	ПараметрыВыбора.Вставить("СвязанныеСтрокиДокументов", СвязанныеСтрокиДокументов);
	ПараметрыВыбора.Вставить("ТекущаяСтрокаДокумента", СтрокаДокумента);
	
	ПереданнаяТаблица = Новый Массив;
	ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Название,ID_БизнесПроцесса,ТипРезультирующегоДокумента1С,ТипРезультирующегоДокумента1С_Синоним,ЗагружатьВТотЖе,ТипИсходногоДокумента1С"));
	
	Для каждого КлючЗначение Из СписокБизнесПроцессов Цикл
		БизнесПроцесс = КлючЗначение.Значение;
		НоваяСтруктура = Новый Структура();
		НоваяСтруктура.Вставить("Название",									БизнесПроцесс.Название);
		НоваяСтруктура.Вставить("ID_БизнесПроцесса",						БизнесПроцесс.ID_БизнесПроцесса);
		НоваяСтруктура.Вставить("ТипРезультирующегоДокумента1С",			БизнесПроцесс.ТипРезультирующегоДокумента1С);
		Если ЗначениеЗаполнено(НоваяСтруктура.ТипРезультирующегоДокумента1С) Тогда
			НоваяСтруктура.Вставить("ТипРезультирующегоДокумента1С_Синоним",	СтруктураМетаданных.Документы1С[БизнесПроцесс.ТипРезультирующегоДокумента1С].Синоним);	
		Иначе	
			НоваяСтруктура.Вставить("ТипРезультирующегоДокумента1С_Синоним", "");
		КонецЕсли;
		НоваяСтруктура.Вставить("ТипИсходногоДокумента1С",					БизнесПроцесс.ТипИсходногоДокумента1С);
		НоваяСтруктура.Вставить("ЗагружатьВТотЖе",							БизнесПроцесс.ЗагружатьВТотЖе);
		ПереданнаяТаблица.Добавить(НоваяСтруктура);
	КонецЦикла; 
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы = ЛокЯдро_ПолучитьФорму("ФормаСлужебная_ВыборСтрокиИзТаблицы", ПараметрыЗагрузки.Форма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс,, ПараметрыЗагрузки.Форма);
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы 				= "БизнесПроцессыДляЗагрузки";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст 		 	= ЭтаФорма;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ПереданнаяТаблица 		= ПереданнаяТаблица;
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ТекущийДокумент 	 	= СтрокаДокумента.Имя;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ТипДокумента1С		 	= СтруктураМетаданных.ДокументыMS[СтрокаДокумента.ИмяТипаДокумента].Синоним;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.КоличествоДокументов	= КоличествоДокументов;
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцессЗавершение", ЭтаФорма, ПараметрыЗагрузки);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцессЗавершение(РезультатВыбора, ПараметрыЗагрузки) Экспорт	
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцессЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВыбора,ПараметрыЗагрузки",
		РезультатВыбора, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Отказ = Ложь;
	СтрокиДокументов 				= ПараметрыЗагрузки.СтрокиДокументов;
	ДокументыДляОбработкиВыбора 	= ПараметрыЗагрузки.ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	ТекущаяСтрокаДокумента 			= ПараметрыЗагрузки.ПараметрыВыбора.ТекущаяСтрокаДокумента;
	СвязанныеСтрокиДокументов 		= ПараметрыЗагрузки.ПараметрыВыбора.СвязанныеСтрокиДокументов;
	
	Если ЗначениеЗаполнено(РезультатВыбора) 
		И ЗначениеЗаполнено(РезультатВыбора.Данные)
		И РезультатВыбора.Данные.Количество() Тогда
		
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;
			
			Если (РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех)
				ИЛИ ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
				
				Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
					СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
					// Проверка на наличие выбранного БП в связанных документах
					Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ID_БизнесПроцесса) <> Неопределено Тогда
						СтрокаДокумента.НастройкаБизнесПроцесса = ID_БизнесПроцесса;
						ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
					КонецЕсли;
				КонецЦикла;
				
				Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
					ПараметрыЗагрузки.ЗагрузитьВОдин_НастройкаБП = ID_БизнесПроцесса;
				КонецЕсли;
				
			Иначе
				ТекущаяСтрокаДокумента.НастройкаБизнесПроцесса = ID_БизнесПроцесса;
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
			КонецЕсли;
			
		Иначе
			
			пСообщение = НСтр("ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID';
								|en = 'The selected business process ""%1"" has an ID not filled in';
								|be = 'У абранага бізнес-працэсу ""%1 "" не запоўнены ID'; es = 'El proceso de negocio ""%1 "" seleccionado no tiene ID'; ka = 'შერჩეულ ბიზნეს პროცესს ""%1 "" აქვს პირადობის მოწმობა, რომელიც არ არის შევსებული'; kk = 'Таңдалған бизнес-процестің ""%1 "" идентификаторы толтырылмаған'; ro = 'Procesul de afaceri selectat"" %1 "" are un ID care nu este completat'; tr = 'Seçilen iş sürecinin ""%1"" İD dolu değil'; uk = 'У обраного бізнес-процесу ""%1 "" не заповнений ID'; uz = 'Tanlangan biznes jarayonida ""%1 "" ID bilan to''ldirilmagan'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СокрЛП(РезультатВыбора.Данные.Название));
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
			
			Если (РезультатВыбора.Свойство("ДляВсех") И РезультатВыбора.ДляВсех)
				ИЛИ ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
				
				Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
					СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
					// Проверка на наличие выбранного БП в связанных документах
					Если СтрокаДокумента.СписокБизнесПроцессов.Получить(ID_БизнесПроцесса) <> Неопределено Тогда
						СтрокиДокументов.Удалить(СтрокиДокументов.Найти(СтрокаДокумента));
						ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
					КонецЕсли;
				КонецЦикла;
			Иначе
				СтрокиДокументов.Удалить(СтрокиДокументов.Найти(ТекущаяСтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		пСообщение = НСтр("ru = 'Не выбран бизнес-процесс для документа ""%1""! Документ не загружен в 1С.'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТекущаяСтрокаДокумента.Имя);
		ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
		
		Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				СтрокиДокументов.Удалить(СтрокиДокументов.Найти(СтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;
		Иначе
			СтрокиДокументов.Удалить(СтрокиДокументов.Найти(ТекущаяСтрокаДокумента));
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	ЛокЯдро_ЗагрузкаДокументов_ВыбратьБизнесПроцесс(ПараметрыЗагрузки, Отказ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументыДляЗаполнения(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументыДляЗаполнения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 	= ПараметрыЗагрузки.СтрокиДокументов;
	ЗагрузитьВОдин		= ПараметрыЗагрузки.ЗагрузитьВОдин;
	ЗагрузитьВОдин_ДокументДляЗаполнения = Неопределено;
	
	Если НЕ СтрокиДокументов.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для загрузки.'");
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = Новый Структура;
	ДокументыДляОбработкиВыбора = Новый Массив;
	
	Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
		
		Если ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент"
			И ПараметрыЗагрузки.Свойство("ФормаДокументаНазначения") Тогда
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				ДанныеФормы = ПараметрыЗагрузки.ФормаДокументаНазначения.ДокументОбъект;
			#Иначе
				ДанныеФормы = ПараметрыЗагрузки.ФормаДокументаНазначения.Объект;
			#КонецЕсли
			
			ДокументДляЗаполнения = Новый Структура("Данные", ДанныеФормы);
			СтрокаДокумента.Вставить("ДокументДляЗаполнения", ДокументДляЗаполнения);
			
		КонецЕсли;
		
		Если НЕ СтрокаДокумента.Свойство("ДокументДляЗаполнения") 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаДокумента.ДокументДляЗаполнения) Тогда
			
			СтрокаДокумента.Вставить("ДокументДляЗаполнения", Неопределено);
			
			НастройкаБП = ПараметрыЗагрузки.СоответствиеНастроекБП.Получить(СтрокаДокумента.НастройкаБизнесПроцесса);
			
			ЭтоОбъединенныйДокумент = Ложь;
			Если СтрокаДокумента.Свойство("ИдИсходныхДокументов") И ЗначениеЗаполнено(СтрокаДокумента.ИдИсходныхДокументов) 
				И (Не НастройкаБП.Свойство("НеРазбиватьОбъединенныйДокументПриЗагрузке")
				ИЛИ Не НастройкаБП.НеРазбиватьОбъединенныйДокументПриЗагрузке = Истина) Тогда // При включенной настройке будет загружаться как 1 обычный документ
				ЭтоОбъединенныйДокумент = Истина;
			КонецЕсли;
			
			ВыполнитьТолькоПроизвольныйКод = НастройкаБП.Свойство("ВыполнитьТолькоПроизвольныйКод")
				И НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина;
			
			Если НЕ (ЭтоОбъединенныйДокумент
				ИЛИ НастройкаБП.ЗагружатьВТотЖе 
				ИЛИ ВыполнитьТолькоПроизвольныйКод)
				И НЕ НастройкаБП.СоздаватьНовыйДокументПриЗагрузке = Истина Тогда
				
				ДокументыДляОбработкиВыбора.Добавить(СтрокаДокумента);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗагрузитьВОдин
			И ЗагрузитьВОдин_ДокументДляЗаполнения = Неопределено
			И ЗначениеЗаполнено(СтрокаДокумента.ДокументДляЗаполнения) Тогда
			
			ЗагрузитьВОдин_ДокументДляЗаполнения = СтрокаДокумента.ДокументДляЗаполнения;
			ДокументыДляОбработкиВыбора.Очистить();
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыЗагрузки.Вставить("ЗагрузитьВОдин_ДокументДляЗаполнения", ЗагрузитьВОдин_ДокументДляЗаполнения);
	
	Если ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыВыбора.Вставить("ДокументыДляОбработкиВыбора", ДокументыДляОбработкиВыбора);
		ПараметрыЗагрузки.Вставить("ПараметрыВыбора", ПараметрыВыбора);
		ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполнения(ПараметрыЗагрузки);
	Иначе
		ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежим(ПараметрыЗагрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполнения(ПараметрыЗагрузки, Отказ = Ложь)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполнения";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки,Отказ",
		ПараметрыЗагрузки, Отказ);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Отказ Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = ПараметрыЗагрузки.ПараметрыВыбора;
	Если НЕ ПараметрыВыбора.Свойство("ДокументыДляОбработкиВыбора") 
		ИЛИ НЕ ПараметрыВыбора.ДокументыДляОбработкиВыбора.Количество() Тогда
		ПараметрыЗагрузки.Удалить("ПараметрыВыбора");
		ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежим(ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ДокументыДляОбработкиВыбора 	= ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	СтрокаДокумента 				= ДокументыДляОбработкиВыбора[0];
	НастройкаБП 					= ПараметрыЗагрузки.СоответствиеНастроекБП.Получить(СтрокаДокумента.НастройкаБизнесПроцесса);
	
	Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
		СвязанныеСтрокиДокументов = ПараметрыЗагрузки.СтрокиДокументов;
	Иначе
		СвязанныеСтрокиДокументов = Новый Массив;
	КонецЕсли;
	
	ПараметрыВыбора.Вставить("ТекущаяСтрокаДокумента", СтрокаДокумента);
	ПараметрыВыбора.Вставить("СвязанныеСтрокиДокументов", СвязанныеСтрокиДокументов);
	
	ФормаСлужебная_ВыборДокументаДляЗагрузки = ЛокЯдро_ПолучитьФорму("ФормаСлужебная_ВыборДокументаДляЗагрузки", ПараметрыЗагрузки.Форма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс,, ПараметрыЗагрузки.Форма);
	
	ФормаСлужебная_ВыборДокументаДляЗагрузки._ЛокКонтекст = ЭтаФорма;
	ФормаСлужебная_ВыборДокументаДляЗагрузки.ТипДокумента1С = НастройкаБП.ТипРезультирующегоДокумента1С;
	
	ИмяТЧ = Неопределено;
	Если НастройкаБП.НастройкаЗагрузкиТЧ <> Ложь
		И ТипЗнч(НастройкаБП.НастройкаЗагрузкиТЧ) = Тип("Массив") Тогда
		Для каждого СтрокаНастройкиТЧ из НастройкаБП.НастройкаЗагрузкиТЧ Цикл
			Если СтрокаНастройкиТЧ.Свойство("ЭтоТаблицаЗначений")	Тогда
				Продолжить;
			КонецЕсли;
			ИмяТЧ = СтрокаНастройкиТЧ.НастройкаТЧСтрокой;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	ФормаСлужебная_ВыборДокументаДляЗагрузки.ИмяТабличнойЧасти1С = ИмяТЧ;
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполненияЗавершение", ЭтаФорма, ПараметрыЗагрузки);
	ФормаСлужебная_ВыборДокументаДляЗагрузки.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборДокументаДляЗагрузки.ОткрытьМодально();	
	#Иначе
		ФормаСлужебная_ВыборДокументаДляЗагрузки.Открыть();
	#КонецЕсли
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполненияЗавершение(РезультатВыбора, ПараметрыЗагрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполненияЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВыбора,ПараметрыЗагрузки",
		РезультатВыбора, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 				= ПараметрыЗагрузки.СтрокиДокументов;
	ДокументыДляОбработкиВыбора 	= ПараметрыЗагрузки.ПараметрыВыбора.ДокументыДляОбработкиВыбора;
	ТекущаяСтрокаДокумента 			= ПараметрыЗагрузки.ПараметрыВыбора.ТекущаяСтрокаДокумента;
	СвязанныеСтрокиДокументов 		= ПараметрыЗагрузки.ПараметрыВыбора.СвязанныеСтрокиДокументов;
	
	Если РезультатВыбора <> Неопределено Тогда
		
		РезультатВыбора = ?(РезультатВыбора = Ложь, Неопределено, РезультатВыбора);
		
		Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				СтрокаДокумента.Вставить("ДокументДляЗаполнения", РезультатВыбора);
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;
			
			ПараметрыЗагрузки.ЗагрузитьВОдин_ДокументДляЗаполнения = РезультатВыбора;
			
		Иначе
			ТекущаяСтрокаДокумента.Вставить("ДокументДляЗаполнения", РезультатВыбора);
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	Иначе
		пСообщение = НСтр("ru = 'Не выбран результирующий документ 1С для загрузки документа ""%1""! Документ не загружен в 1С.'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, ТекущаяСтрокаДокумента.Имя);
		ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
			
		Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
			Для Индекс = -СвязанныеСтрокиДокументов.Количество() + 1 По 0 Цикл
				СтрокаДокумента = СвязанныеСтрокиДокументов[-Индекс];
				СтрокиДокументов.Удалить(СтрокиДокументов.Найти(СтрокаДокумента));
				ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(СтрокаДокумента));
			КонецЦикла;			
		Иначе
			СтрокиДокументов.Удалить(СтрокиДокументов.Найти(ТекущаяСтрокаДокумента));
			ДокументыДляОбработкиВыбора.Удалить(ДокументыДляОбработкиВыбора.Найти(ТекущаяСтрокаДокумента));
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = Ложь;
	ЛокЯдро_ЗагрузкаДокументов_ВыбратьДокументДляЗаполнения(ПараметрыЗагрузки, Отказ);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежим(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежим";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов = ПараметрыЗагрузки.СтрокиДокументов;
	Если НЕ СтрокиДокументов.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для загрузки.'");
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыЗагрузки.Свойство("ИдУстройствДляПроверкиДемо") Тогда
		
		ИдУстройствДляПроверкиДемо = Новый Массив;
		Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
			
			СтруктураИд = Новый Структура("ИдУстройства, DeviceId");
			ЗаполнитьЗначенияСвойств(СтруктураИд, СтрокаДокумента);
			
			ИдУстройства = "";
			Если ЗначениеЗаполнено(СтруктураИд.ИдУстройства) Тогда
				ИдУстройства = СтруктураИд.ИдУстройства;
			ИначеЕсли ЗначениеЗаполнено(СтруктураИд.DeviceId) Тогда
				ИдУстройства = СтруктураИд.DeviceId;
			КонецЕсли;
			
			Если ИдУстройствДляПроверкиДемо.Найти(ИдУстройства) = Неопределено Тогда
				ИдУстройствДляПроверкиДемо.Добавить(ИдУстройства);
			КонецЕсли;
			
		КонецЦикла;
		
		ПараметрыЗагрузки.Вставить("ИдУстройствДляПроверкиДемо", ИдУстройствДляПроверкиДемо);
		
	КонецЕсли;
	
	Если НЕ ПараметрыЗагрузки.ИдУстройствДляПроверкиДемо.Количество() Тогда
		ПараметрыЗагрузки.Удалить("ИдУстройствДляПроверкиДемо");
		ЛокЯдро_ЗагрузкаДокументов_НачатьЗагрузку(ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ИдУстройства = ПараметрыЗагрузки.ИдУстройствДляПроверкиДемо[0];
	ПараметрыЗагрузки.ИдУстройствДляПроверкиДемо.Удалить(0);
	
	ПараметрыПроверки = Новый Структура("Событие,ИдУстройства", "ЗагрузкаДокумента", ИдУстройства);
	
	ОП = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежимЗавершение", ЭтаФорма, ПараметрыЗагрузки);
	ЛокЯдро_ПроверитьДемоРежим(ОП, ПараметрыПроверки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежимЗавершение(Результат, ПараметрыЗагрузки) Экспорт
	
	ЛокЯдро_ЗагрузкаДокументов_ПроверитьДемоРежим(ПараметрыЗагрузки);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_НачатьЗагрузку(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_НачатьЗагрузку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 	= ПараметрыЗагрузки.СтрокиДокументов;
	ЗагрузитьВОдин		= ПараметрыЗагрузки.ЗагрузитьВОдин;
	
	Если НЕ СтрокиДокументов.Количество() Тогда
		Сообщение = НСтр("ru = 'Нет выбранных документов для загрузки.'");
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Сообщение, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	ПараметрыЗагрузки.Вставить("ТипБазы", ТипБазы);
	
	СоответствиеНастроекБПДляИсполнения = ЛокЯдро_ОтобратьНастройкиБПВыбранныхДокументов(
		ПараметрыЗагрузки,
		"СтрокиДокументов",
		"ЗагрузитьВОдин",
		"ЗагрузитьВОдин_НастройкаБП");
	ПараметрыЗагрузки.Вставить("СоответствиеНастроекБП", СоответствиеНастроекБПДляИсполнения);
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаСервере(ПараметрыЗагрузки);
	Иначе	
		РезультатыЗагрузки = ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаКлиенте(ПараметрыЗагрузки);
		ЛокЯдро_ЗагрузкаДокументов_ПослеЗагрузки(РезультатыЗагрузки, ПараметрыЗагрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаСервере(ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаСервере";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	локПараметрыЗагрузки = ЛокЯдро_СкопироватьСтруктуру(ПараметрыЗагрузки);
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиЗавершения");
	локПараметрыЗагрузки.Удалить("ОповещениеОбработкиОшибки");
	локПараметрыЗагрузки.Удалить("Форма");
	локПараметрыЗагрузки.Удалить("ФормаДокументаНазначения");
	
	Если ДоступноВыполнениеВФоне = Истина
		// ДанныеФормыСтруктура не доступен в фоновом задании, 
		//	поэтому выполняем без фонового при загрузке в открытый документ
		И НЕ ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент" Тогда
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПараметрыЗагрузки", локПараметрыЗагрузки);
		ПараметрыМетода.Вставить("АдресаПеременных", АдресаПеременных);
		//ПараметрыМетода.Вставить("Автотест", АвтотестКлеверенс);

		ПараметрыФЗ = Новый Структура;
		ПараметрыФЗ.Вставить("ИмяМетода", 						"ГлЯдро_ЗагрузкаДокументов_ЗагрузитьДокументы1С");
		ПараметрыФЗ.Вставить("ПараметрыМетода", 				ПараметрыМетода);		
		ПараметрыФЗ.Вставить("НаименованиеФЗ",					НСтр("ru = 'Загрузка документов'"));
		ПараметрыФЗ.Вставить("ТекстСообщения", 					ПараметрыФЗ.НаименованиеФЗ);
		ПараметрыФЗ.Вставить("ВыводитьОкноОжидания", 			Истина);
		ПараметрыФЗ.Вставить("ВыводитьПрогрессВыполнения", 		Истина);
		ПараметрыФЗ.Вставить("ИнтервалПроверкиВыполнения", 		1);
		ПараметрыФЗ.Вставить("ЗапускВФоне", 					Истина);
		
		ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ПослеЗагрузки", ЭтаФорма, ПараметрыЗагрузки);
		ОповещениеОбработкиОшибки = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку", ЭтаФорма, ПараметрыЗагрузки);
		
		ЛокЯдро_НачатьВыполнениеФоновогоЗадания(ПараметрыФЗ, ОповещениеОбработкиЗавершения, ОповещениеОбработкиОшибки);
		
	Иначе
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ЗагрузкаДокументов_ЗагрузитьДокументы1С");
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Параметры", Новый Структура("ПараметрыЗагрузки", локПараметрыЗагрузки));
		СтруктураВызова.Вставить("ПараметрыМетода", СтруктураПараметров);
		
		РезультатыЗагрузки = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
		ЛокЯдро_ЗагрузкаДокументов_ПослеЗагрузки(РезультатыЗагрузки, ПараметрыЗагрузки);
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаКлиенте(ПараметрыЗагрузки)
		
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьДокументыНаКлиенте";
		
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыЗагрузки",
		ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокиДокументов 		= ПараметрыЗагрузки.СтрокиДокументов;
	СоответствиеНастроекБП 	= ПараметрыЗагрузки.СоответствиеНастроекБП;
	ТипБазы					= ПараметрыЗагрузки.ТипБазы;
	ЗагрузитьВОдин			= ПараметрыЗагрузки.ЗагрузитьВОдин;
	ID_ТекущегоУзла			= ПараметрыЗагрузки.ID_Узла;
	
	// Настройки БП
	ДанныеНастроекИзКэша = Новый Структура;
	
	Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", "Шапка");
	ПроизвольныеКодыШапки = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыШапки",ПроизвольныеКодыШапки);
	
	Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", "ТабличнаяЧасть");
	ПроизвольныеКодыТабличнойЧасти = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыТабличнойЧасти",ПроизвольныеКодыТабличнойЧасти);
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередЗагрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеЗагрузкиДокумента");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаЗагрузки = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыОбработчикаЗагрузки",ПроизвольныеКодыОбработчикаЗагрузки);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередЗаполнениемТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияТЧ");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаТЧ = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыОбработчикаТЧ",ПроизвольныеКодыОбработчикаТЧ);
	
	МассивТиповОбъектов.Очистить();
	МассивТиповОбъектов.Добавить("ПередЗаполнениемСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияСтрокиТЧ");
	Отбор = Новый Структура("Направление,ТипОбъекта", "Загрузка", МассивТиповОбъектов);
	ПроизвольныеКодыОбработчикаСтрокиТЧ = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыОбработчикаСтрокиТЧ",ПроизвольныеКодыОбработчикаСтрокиТЧ);
	
	// Кэшируем узловые настройки, чтобы не получать их повторно и не переключаться между узлами
	НастройкиПоУзлам = Новый Соответствие;
	
	ЗначенияНастроекУзла = Новый Структура;
	ЗначенияНастроекУзла.Вставить("ЗначенияПараметров", ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров());
	ЗначенияНастроекУзла.Вставить("НастройкиДляОбмена", ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов"));
	НастройкиПоУзлам.Вставить(ID_ТекущегоУзла, ЗначенияНастроекУзла);
	
	РезультатыЗагрузки = Новый Массив;
	Если ЗагрузитьВОдин Тогда
		
		ДокументыКЗагрузке = Новый Массив;
		Для Каждого СтрокаДокумента Из СтрокиДокументов Цикл
			ДанныеДокументаКЗагрузке = Новый Структура("Ид, ИмяТипаДокумента");
			ЗаполнитьЗначенияСвойств(ДанныеДокументаКЗагрузке, СтрокаДокумента);			
			ДокументыКЗагрузке.Добавить(ДанныеДокументаКЗагрузке);			
		КонецЦикла;
		
		СтрокаДокумента 		= СтрокиДокументов[0];
		ID_БизнесПроцесса 		= ПараметрыЗагрузки.ЗагрузитьВОдин_НастройкаБП;
		НастройкаБП 			= СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
		
		пТипДокументаMS 		= ЛокЯдро_ПреобразованиеНаименованияДокументаБезПробелов(СтрокаДокумента.ИмяТипаДокумента);
		СтруктураДокументаMS 	= СтруктураМетаданных.ДокументыMS[пТипДокументаMS];
		
		ID_Узла = ID_ТекущегоУзла;
		Если СтрокаДокумента.Свойство("ИдУзла") И СтрокаДокумента.ИдУзла <> ID_ТекущегоУзла Тогда
			ID_Узла = СтрокаДокумента.ИдУзла;
		КонецЕсли;
		
		// Вставляем узловые настройки из узла документа
		ЗначенияНастроекУзла = НастройкиПоУзлам.Получить(ID_Узла);
		Если ЗначенияНастроекУзла = Неопределено Тогда
			ЗначенияНастроекУзла = Новый Структура;
			ЗначенияНастроекУзла.Вставить("ЗначенияПараметров", ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла));
			ЗначенияНастроекУзла.Вставить("НастройкиДляОбмена", ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ID_Узла));
			НастройкиПоУзлам.Вставить(ID_Узла, ЗначенияНастроекУзла);
		КонецЕсли;
		
		ДанныеНастроекИзКэша.Вставить("ЗначенияПараметров", ЗначенияНастроекУзла.ЗначенияПараметров);
		ДанныеНастроекИзКэша.Вставить("НастройкиДляОбмена", ЗначенияНастроекУзла.НастройкиДляОбмена);
		
		ДополнительныеПараметры = Новый Структура("ДанныеНастроекИзКэша");
		РезультатЗагрузки = ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID(ДокументыКЗагрузке, 
																				СтрокаДокумента.ИмяТипаДокумента, 
																				ID_БизнесПроцесса, 
																				НастройкаБП, 
																				СтрокаДокумента.ДокументДляЗаполнения,
																				,
																				, 
																				Истина,
																				ДополнительныеПараметры);
			
		СтрокаРезультата = Новый Структура("СтрокаДокумента, Результат", СтрокиДокументов[0], РезультатЗагрузки);
		РезультатыЗагрузки.Добавить(СтрокаРезультата);
		
	Иначе
		Для каждого СтрокаДокумента Из СтрокиДокументов Цикл
			
			ID_БизнесПроцесса 		= СтрокаДокумента.НастройкаБизнесПроцесса;
			НастройкаБП 			= СоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
			
			пТипДокументаMS 		= ЛокЯдро_ПреобразованиеНаименованияДокументаБезПробелов(СтрокаДокумента.ИмяТипаДокумента);
			СтруктураДокументаMS 	= СтруктураМетаданных.ДокументыMS[пТипДокументаMS];
			
			ID_Узла = ID_ТекущегоУзла;
			Если СтрокаДокумента.Свойство("ИдУзла") И СтрокаДокумента.ИдУзла <> ID_ТекущегоУзла Тогда
				ID_Узла = СтрокаДокумента.ИдУзла;
			КонецЕсли;
			
			// Вставляем узловые настройки из узла документа
			ЗначенияНастроекУзла = НастройкиПоУзлам.Получить(ID_Узла);
			Если ЗначенияНастроекУзла = Неопределено Тогда
				ЗначенияНастроекУзла = Новый Структура;
				ЗначенияНастроекУзла.Вставить("ЗначенияПараметров", ЛокЯдро_ПолучитьЗначенияГлобальныхПараметров(ID_Узла));
				ЗначенияНастроекУзла.Вставить("НастройкиДляОбмена", ЛокЯдро_ПолучитьОбщуюСтруктуруБизнесПроцессов(ID_Узла));
				НастройкиПоУзлам.Вставить(ID_Узла, ЗначенияНастроекУзла);
			КонецЕсли;
			
			ДанныеНастроекИзКэша.Вставить("ЗначенияПараметров", ЗначенияНастроекУзла.ЗначенияПараметров);
			ДанныеНастроекИзКэша.Вставить("НастройкиДляОбмена", ЗначенияНастроекУзла.НастройкиДляОбмена);
			
			ЭтоОбъединенныйДокумент = Ложь;
			Если СтрокаДокумента.Свойство("ИдИсходныхДокументов") И ЗначениеЗаполнено(СтрокаДокумента.ИдИсходныхДокументов) 
				И (Не НастройкаБП.Свойство("НеРазбиватьОбъединенныйДокументПриЗагрузке")
				ИЛИ Не НастройкаБП.НеРазбиватьОбъединенныйДокументПриЗагрузке = Истина) Тогда // При включенной настройке будет загружаться как 1 обычный документ
				ЭтоОбъединенныйДокумент = Истина;
			КонецЕсли;
			
			Если ЭтоОбъединенныйДокумент Тогда
				МассивИдИсходныхДокументов = ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаДокумента.ИдИсходныхДокументов,";");
				Для Каждого ИсходныйДокумент Из МассивИдИсходныхДокументов Цикл
					
					ДополнительныеПараметры = Новый Структура("ДанныеНастроекИзКэша");
					РезультатЗагрузки = ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID(СтрокаДокумента.Ид, 
																							СтрокаДокумента.ИмяТипаДокумента, 
																							ID_БизнесПроцесса, 
																							НастройкаБП, 
																							СтрокаДокумента.ДокументДляЗаполнения,
																							,
																							ИсходныйДокумент, 
																							,
																							ДополнительныеПараметры);
																												
					СтрокаРезультата = Новый Структура("СтрокаДокумента, Результат", СтрокаДокумента, РезультатЗагрузки);
					РезультатыЗагрузки.Добавить(СтрокаРезультата);
					
				КонецЦикла;
			Иначе
				РезультатЗагрузки = ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID(СтрокаДокумента.Ид, 
																						СтрокаДокумента.ИмяТипаДокумента, 
																						ID_БизнесПроцесса, 
																						НастройкаБП, 
																						СтрокаДокумента.ДокументДляЗаполнения,
																						,
																						, 
																						,
																						ДополнительныеПараметры);
																										
				СтрокаРезультата = Новый Структура("СтрокаДокумента, Результат", СтрокаДокумента, РезультатЗагрузки);
				РезультатыЗагрузки.Добавить(СтрокаРезультата);
			
			КонецЕсли;
						
		КонецЦикла;
	КонецЕсли;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатыЗагрузки);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат РезультатыЗагрузки;
		
КонецФункции

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ПослеЗагрузки(РезультатыЗагрузки, ПараметрыЗагрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ПослеЗагрузки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатыЗагрузки,ПараметрыЗагрузки",
		РезультатыЗагрузки, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ЭтоАдресВременногоХранилища(РезультатыЗагрузки) Тогда
		РезультатыЗагрузки = ПолучитьИзВременногоХранилища(РезультатыЗагрузки);	
	КонецЕсли;
	
	Если РезультатыЗагрузки = Неопределено Тогда
		ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(РезультатыЗагрузки, ПараметрыЗагрузки);
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СоответствиеНастроекБП 	= ПараметрыЗагрузки.СоответствиеНастроекБП;
	
	ДокументыКУдалению = Новый Массив;
	УспешноЗагружено = Ложь;
	
	Для каждого СтрокаРезультата Из РезультатыЗагрузки Цикл
		
		СтрокаДокумента = СтрокаРезультата.СтрокаДокумента;
		РезультатЗагрузки = СтрокаРезультата.Результат;
		
		Если НЕ РезультатЗагрузки.Статус Тогда
			
			Если НЕ ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
				пСообщение = НСтр("ru = 'Не удалось загрузить документ «%1»! Подробности см. в журнале регистрации.'");
				пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтрокаДокумента.Имя);
			Иначе
				пСообщение = НСтр("ru = 'Не удалось объединить и загрузить документы. Подробности см. в журнале регистрации.'");
			КонецЕсли;
			
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
			
			Если ЗначениеЗаполнено(РезультатЗагрузки.Сообщение) Тогда
				ЛокЯдро_СообщениеПользователю(РезультатЗагрузки.Сообщение, ПараметрыЗагрузки.Форма);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		УспешноЗагружено = Истина;
		ДокументыКУдалению.Добавить(СтрокаДокумента);
		
		НастройкаБП = СоответствиеНастроекБП.Получить(СтрокаДокумента.НастройкаБизнесПроцесса);
		
		Если НастройкаБП.ВыполнитьТолькоПроизвольныйКод = Истина Тогда
			пСообщение = НСтр("ru = 'Данные документа обработаны: %1. От пользователя: %2';
								|en = 'The document data has been processed: %1. From the user: %2';
								|be = 'Дадзеныя дакумента апрацаваны: %1. Ад карыстальніка: %2'; es = 'Datos del documento procesados: %1. Por usuario: %2'; ka = 'დოკუმენტის მონაცემები დამუშავებულია: %1. მომხმარებლისგან: %2'; kk = 'Құжат деректері өңделді: %1. Пайдаланушыдан: %2'; ro = 'Datele documentului au fost prelucrate: %1. De la utilizator: %2'; tr = 'Belge verileri işlenir: %1. Kullanıcıdan: %2'; uk = 'Дані документа оброблені: %1. Від користувача: %2'; uz = 'Hujjat ma''lumotlari qayta ishlanadi: %1. Foydalanuvchidan: %2'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтрокаДокумента.Имя, СтрокаДокумента.ИмяПользователя);
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
			ЛокЯдро_СообщениеПользователю(РезультатЗагрузки.Сообщение, ПараметрыЗагрузки.Форма);
		Иначе
			ЛокЯдро_ЗагрузкаДокументов_ОткрытьФормуДокумента(СтрокаДокумента, РезультатЗагрузки, НастройкаБП, ПараметрыЗагрузки);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ПараметрыЗагрузки.ЗагрузитьВОдин Тогда
		
		Если УспешноЗагружено Тогда
			пСообщение = НСтр("ru = 'Выделенные документы объединены и загружены в 1С.'");
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
		КонецЕсли;
		
	КонецЕсли;
	
	Если УспешноЗагружено Тогда
		
		Если НЕ ПараметрыПодключенияMS = Неопределено И ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
			Если ПараметрыПодключенияMS.Свойство("РаботаСКаталогом") И ПараметрыПодключенияMS.РаботаСКаталогом = Истина Тогда
				ТекстВопроса = НСтр("ru = 'Удалить выбранные документы из папки обмена?';
										|en = 'Delete selected documents from the exchange folder?'; be = 'Выдаліць выбраныя дакументы з тэчкі абмену?'; es = 'Eliminar los documentos seleccionados de la carpeta de intercambio?'; ka = 'წაშალეთ შერჩეული დოკუმენტები გაცვლითი საქაღალდიდან?'; kk = 'Таңдалған құжаттарды бөлісу қалтасынан жою керек пе?'; ro = 'Ștergeți documentele selectate din folderul exchange?'; tr = 'Seçili belgeleri paylaşım klasöründen siliyor musunuz?'; uk = 'Видалити вибрані документи з папки обміну?'; uz = 'Tanlangan hujjatlarni almashish papkasidan olib tashlaysizmi?'");	
			ИначеЕсли ПараметрыПодключенияMS.Свойство("РаботаСУстройствомНапрямую") И ПараметрыПодключенияMS.РаботаСУстройствомНапрямую = Истина Тогда
				ТекстВопроса = НСтр("ru = 'Удалить выбранные документы с мобильного устройства?';
										|en = 'Delete selected documents from your mobile device?';
										|be = 'Выдаліць выбраныя дакументы з мабільнага прылады?'; es = 'Eliminar los documentos seleccionados de su dispositivo móvil?'; ka = 'წაშალეთ შერჩეული დოკუმენტები თქვენი მობილური მოწყობილობიდან?'; kk = 'Таңдалған құжаттарды мобильді құрылғыдан жою керек пе?'; ro = 'Ștergeți documentele selectate de pe dispozitivul dvs. mobil?'; tr = 'Seçilen belgeleri mobil cihazınızdan siliyor musunuz?'; uk = 'Видалити вибрані документи з мобільного пристрою?'; uz = 'Tanlangan hujjatlarni mobil qurilmadan olib tashlaysizmi?'");
			Иначе
				ТекстВопроса = НСтр("ru = 'Удалить выбранные документы с сервера?';
										|en = 'Delete selected documents from the server?'; be = 'Выдаліць выбраныя дакументы з сервера?'; es = '¿Eliminar los documentos seleccionados del servidor?'; ka = 'წაშალეთ შერჩეული დოკუმენტები სერვერიდან?'; kk = 'Таңдалған құжаттарды серверден жою керек пе?'; ro = 'Ștergeți documentele selectate de pe server?'; tr = 'Seçilen belgeleri sunucudan siliyor musunuz?'; uk = 'Видалити вибрані документи з сервера?'; uz = 'Tanlangan hujjatlarni serverdan olib tashlaysizmi?'");
			КонецЕсли;
		Иначе	
			ТекстВопроса = НСтр("ru = 'Удалить выбранные документы с ТСД?';
									|en = 'Delete selected documents from your Mobile device?'; be = 'Выдаліць выбраныя дакументы з Мабільнае прылада?'; es = 'Eliminar los documentos seleccionados de su dispositivo Móvil?'; ka = 'წაშალეთ შერჩეული დოკუმენტები თქვენი მობილური მოწყობილობიდან?'; kk = 'Таңдалған құжаттарды жойыңыз мобильді құрылғы?'; ro = 'Ștergeți documentele selectate de pe dispozitivul dvs. mobil?'; tr = 'Seçilen belgeleri Mobil cihazdan siliyor musunuz?'; uk = 'Видалити вибрані документи з мобільний пристрій?'; uz = 'Tanlangan hujjatlarni o''chirib tashlang mobil qurilma?'");	
		КонецЕсли;
		
		ПараметрыВопроса = Новый Структура;
		ПараметрыВопроса.Вставить("ПараметрыЗагрузки", ПараметрыЗагрузки);
		ПараметрыВопроса.Вставить("ДокументыКУдалению", ДокументыКУдалению);
		ПараметрыВопроса.Вставить("РезультатыЗагрузки", РезультатыЗагрузки);
		
		ОповещениеВопросПовторВыгрузки = Новый ОписаниеОповещения("ЛокЯдро_ЗагрузкаДокументов_ВопросУдалитьДокументыЗавершение", ЭтаФорма, ПараметрыВопроса);
		ПоказатьВопрос(ОповещениеВопросПовторВыгрузки, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, ЛокЯдро_ТекстВнимание()); 
		
	Иначе
		ЛокЯдро_ЗагрузкаДокументов_Завершение(РезультатыЗагрузки, ПараметрыЗагрузки);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ОткрытьФормуДокумента(СтрокаДокумента, РезультатЗагрузки, НастройкаБП, ПараметрыЗагрузки)
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ОткрытьФормуДокумента";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаДокумента,РезультатЗагрузки,НастройкаБП,ПараметрыЗагрузки",
		СтрокаДокумента, РезультатЗагрузки, НастройкаБП, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДокументЗаписан = РезультатЗагрузки.ДокументЗаписан;
	Если ДокументЗаписан Тогда
		
		Если ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент" Тогда
			ПараметрыЗагрузки.ФормаДокументаНазначения.Прочитать();
			Форма = ПараметрыЗагрузки.ФормаДокументаНазначения;
		Иначе
			
			ПоказатьЗначение(,РезультатЗагрузки.Данные);
			
			// Для выполнения обработчика ПослеОткрытияФормыДокумента
			Попытка
				Если ЗначениеЗаполнено(РезультатЗагрузки.Ссылка) И НЕ РезультатЗагрузки.Ссылка.Пустая() Тогда
					#Если ТолстыйКлиентОбычноеПриложение Тогда
						Форма = РезультатЗагрузки.Ссылка.ПолучитьФорму();
					#Иначе
						ПараметрыФормы = Новый Структура("Ключ", РезультатЗагрузки.Ссылка);
						Форма = ПолучитьФорму("Документ." + РезультатЗагрузки.МетаданныеИмя + ".ФормаОбъекта", ПараметрыФормы);
					#КонецЕсли
				КонецЕсли;
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			Если ТипЗнч(РезультатЗагрузки.Данные) = Тип("Строка") Тогда
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.УстановитьСтроку(РезультатЗагрузки.Данные);
				ДокОбъект = ПрочитатьXML(ЧтениеXML);
			Иначе
				ДокОбъект = РезультатЗагрузки.Данные;
			КонецЕсли;
			
			Если ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент" Тогда
				Форма = ПараметрыЗагрузки.ФормаДокументаНазначения;
			ИначеЕсли ДокументЗаписан Тогда
				Форма = ДокОбъект.ПолучитьФорму();			
			ИначеЕсли НЕ РезультатЗагрузки.Ссылка.Пустая() Тогда
				Форма = РезультатЗагрузки.Ссылка.ПолучитьФорму();
			Иначе
				Форма = ПолучитьФорму("Документ." + ДокОбъект.Метаданные().Имя + ".ФормаОбъекта");
			КонецЕсли;
			
			// для записанного документа не выполняем заполнение реквизитов и табличных частей
			// из РезультатЗаписи.Данные, т.к. они уже заполнены в записанном документе
			Если НЕ ДокументЗаписан Тогда
				
				ТабличныеЧасти = Новый Массив;
				Для каждого ТабличнаяЧасть Из ДокОбъект.Метаданные().ТабличныеЧасти Цикл
					ТабличныеЧасти.Добавить(ТабличнаяЧасть.Имя);
				КонецЦикла;				
				ТабличныеЧастиСтрокой = "";
				Для каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
					ТабличныеЧастиСтрокой = ТабличныеЧастиСтрокой + ТабличнаяЧасть + ", ";
				КонецЦикла;	
				ТабличныеЧастиСтрокой = Лев(ТабличныеЧастиСтрокой, СтрДлина(ТабличныеЧастиСтрокой) - 2);
				Если ТипЗнч(Форма) = Тип("УправляемаяФорма") Тогда
					ОсновнойРеквизитФормы = "Объект";				
				Иначе
					ОсновнойРеквизитФормы = "ДокументОбъект";				
				КонецЕсли;
				
				Для Каждого Рекизит Из ДокОбъект.Метаданные().Реквизиты Цикл
					Попытка
						Форма[ОсновнойРеквизитФормы][Рекизит.Имя] = ДокОбъект[Рекизит.Имя];
					Исключение
					КонецПопытки;
				КонецЦикла;
				
				Для каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
					Форма[ОсновнойРеквизитФормы][ТабличнаяЧасть].Очистить();
					Для каждого СтрокаТЧ Из ДокОбъект[ТабличнаяЧасть] Цикл
						ЗаполнитьЗначенияСвойств(Форма[ОсновнойРеквизитФормы][ТабличнаяЧасть].Добавить(), СтрокаТЧ);
					КонецЦикла;	
				КонецЦикла;
				
			КонецЕсли;
			
		#Иначе
			Если ПараметрыЗагрузки.РежимЗагрузки = "ВОткрытыйДокумент" Тогда
				Форма = ПараметрыЗагрузки.ФормаДокументаНазначения;
				
			ИначеЕсли ЗначениеЗаполнено(РезультатЗагрузки.Ссылка)
				и НЕ РезультатЗагрузки.Ссылка.Пустая() Тогда
				ПараметрыФормы = Новый Структура("Ключ", РезультатЗагрузки.Ссылка);
				Форма = ПолучитьФорму("Документ." + РезультатЗагрузки.МетаданныеИмя + ".ФормаОбъекта",ПараметрыФормы);
			Иначе
				ПараметрыФормы = Новый Структура;
				Если РезультатЗагрузки.Свойство("ПараметрыОткрытияФормы") И ТипЗнч(РезультатЗагрузки.ПараметрыОткрытияФормы) = Тип("Структура") Тогда
					ПараметрыФормы = РезультатЗагрузки.ПараметрыОткрытияФормы;
					Если ПараметрыФормы.Свойство("ЗначенияЗаполнения") Тогда
						ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументНаСервере(ПараметрыФормы.ЗначенияЗаполнения, РезультатЗагрузки, Истина);
					КонецЕсли;
				КонецЕсли;						
				Форма = ПолучитьФорму("Документ." + РезультатЗагрузки.МетаданныеИмя + ".ФормаОбъекта", ПараметрыФормы);
			КонецЕсли;
			
			ИмяОбъектаФормы = "Объект";
			Попытка
				ДанныеФормы = Форма[ИмяОбъектаФормы];
			Исключение
				ИмяОбъектаФормы = "Object";
				ДанныеФормы = Форма[ИмяОбъектаФормы];
			КонецПопытки;
			ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументНаСервере(ДанныеФормы,РезультатЗагрузки);
			КопироватьДанныеФормы(ДанныеФормы, Форма[ИмяОбъектаФормы]);
		#КонецЕсли 
		
		Форма.Открыть();			
		Форма.Модифицированность = НЕ ДокументЗаписан;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		// Вывод сообщений, которые "потерялись" при формировании документа
		Если РезультатЗагрузки.Свойство("СообщенияПользователю") Тогда
			
			СообщенияПользователю = РезультатЗагрузки.СообщенияПользователю;
			
			Для Каждого СообщениеПользователю Из СообщенияПользователю Цикл
				СообщениеПользователю.ИдентификаторНазначения = Форма.УникальныйИдентификатор;
				СообщениеПользователю.Сообщить(); 
			КонецЦикла;
			
		КонецЕсли;
	#КонецЕсли
	
	ЛокЯдро_ВыполнитьОбработчикПослеОткрытияФормыДокумента1С(Форма, НастройкаБП, РезультатЗагрузки);
	
	Если РезультатЗагрузки.Свойство("ЕстьОшибкиПриВыполненииОбработчиков") И РезультатЗагрузки.ЕстьОшибкиПриВыполненииОбработчиков Тогда
		пСообщение = НСтр("ru = 'Не удалось загрузить документ «%1»! Подробности см. в журнале регистрации.'");
		пСообщение = ЛокЯдро_СтрШаблон(пСообщение, СтрокаДокумента.Имя);
		ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Заполняет данные формы переданным объектом. Вызывается перед открытием формы загруженного документа.
// 
// Параметры:
// 	ДанныеФормы - ДанныеФормы - Данные открываемой формы 
// 	РезультатЗаписи - (См. ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID)
//	ТипСтруктура - Структура - Если тип данных формы является обычной структурой
//
&НаСервереБезКонтекста
Процедура ЛокЯдро_ЗагрузкаДокументов_ЗаполнитьДокументНаСервере(ДанныеФормы, РезультатЗаписи, ТипСтруктура = Ложь)
	
	Если ТипЗнч(РезультатЗаписи.Данные) = Тип("Строка") Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(РезультатЗаписи.Данные);
		Значение = ПрочитатьXML(ЧтениеXML);
	Иначе
		Значение = РезультатЗаписи.Данные;
	КонецЕСли;
	
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Объект") Тогда
		Значение = Значение.Объект;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		Значение = Значение.ПолучитьОбъект();
	КонецЕсли;
	
	Если ТипСтруктура Тогда
		ЗаполнитьЗначенияСвойств(ДанныеФормы, Значение);
	Иначе
		ЗначениеВДанныеФормы(Значение, ДанныеФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ВопросУдалитьДокументыЗавершение(РезультатВопроса, ПараметрыВопроса) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ВопросУдалитьДокументыЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"РезультатВопроса,ПараметрыВопроса",
		РезультатВопроса, ПараметрыВопроса);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыЗагрузки = ПараметрыВопроса.ПараметрыЗагрузки;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда	
		Для Каждого СтрокаДокумента Из ПараметрыВопроса.ДокументыКУдалению Цикл
			
			РезультатУдаления = ЛокЯдро_УдалитьДокументНаСервереSMARTS(СтрокаДокумента.Ид);
			пСообщение = РезультатУдаления.Сообщение + " [" + СтрокаДокумента.Имя + "]";
			ЛокЯдро_СообщениеПользователю(пСообщение, ПараметрыЗагрузки.Форма);
			
		КонецЦикла;
	КонецЕсли;
	
	ЛокЯдро_ЗагрузкаДокументов_Завершение(ПараметрыВопроса.РезультатыЗагрузки, ПараметрыЗагрузки);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_Завершение(РезультатыЗагрузки, ПараметрыЗагрузки)
	
	ВыполнитьОбработкуОповещения(ПараметрыЗагрузки.ОповещениеОбработкиЗавершения, РезультатыЗагрузки);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку(Результат, ПараметрыЗагрузки) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ЗагрузкаДокументов_ОбработатьОшибку";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ПараметрыЗагрузки",
		Результат, ПараметрыЗагрузки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ТипЗнч(Результат) = Тип("Строка") И НЕ ПустаяСтрока(Результат) Тогда
		ЛокЯдро_СообщениеПользователю(Результат, ПараметрыЗагрузки.Форма);
	КонецЕсли;
	
	Если ПараметрыЗагрузки.ОповещениеОбработкиОшибки <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыЗагрузки.ОповещениеОбработкиОшибки, Результат);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

// Отбирает настройки бизнес-процессов, необходимые для выбранных документов обмена.
//
// Параметры:
//  ПараметрыОбмена - Структура - параметры загрузки или выгрузки документов.
//  ИмяКоллекцииДокументов - Строка - имя свойства с коллекцией выбранных документов.
//  ИмяПризнакаОбъединения - Строка - имя свойства с признаком объединения документов.
//  ИмяНастройкиБПОбъединения - Строка - имя свойства с настройкой бизнес-процесса для объединенного документа.
//
// Возвращаемое значение:
//  Соответствие - настройки бизнес-процессов по идентификаторам бизнес-процессов.
//
&НаКлиенте
Функция ЛокЯдро_ОтобратьНастройкиБПВыбранныхДокументов(ПараметрыОбмена, ИмяКоллекцииДокументов, ИмяПризнакаОбъединения, ИмяНастройкиБПОбъединения)
	
	ПолноеСоответствиеНастроекБП = ПараметрыОбмена.СоответствиеНастроекБП;
	СоответствиеНастроекБП = Новый Соответствие;
	
	ОбъединятьДокументы = ПараметрыОбмена[ИмяПризнакаОбъединения];
	Если ОбъединятьДокументы Тогда
		ID_БизнесПроцесса = ПараметрыОбмена[ИмяНастройкиБПОбъединения];
		НастройкаБП = ПолноеСоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
		СоответствиеНастроекБП.Вставить(ID_БизнесПроцесса, НастройкаБП);
	Иначе
		КоллекцияДокументов = ПараметрыОбмена[ИмяКоллекцииДокументов];
		Для Каждого СтрокаДокумента Из КоллекцияДокументов Цикл
			ID_БизнесПроцесса = СтрокаДокумента.НастройкаБизнесПроцесса;
			Если СоответствиеНастроекБП.Получить(ID_БизнесПроцесса) = Неопределено Тогда
				НастройкаБП = ПолноеСоответствиеНастроекБП.Получить(ID_БизнесПроцесса);
				СоответствиеНастроекБП.Вставить(ID_БизнесПроцесса, НастройкаБП);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СоответствиеНастроекБП;
	
КонецФункции

// Вызывает функцию получения данных документа 1С для выгрузки и процедуру записи полученных данных в базу Клеверенс
//
// Параметры:
//	Документ1С - ДокументСсылка - документ в базе, выгружаемый на сервер Клеверенс
//  ID_БизнесПроцесса - Строка - идентификатор бизнес-процесса
//  НазначенныеПользователи - Неопределено
//							- Строка - идентификторы пользователей или устройств Клеверенс, которым назначается документ, разделенные "|"
//							- Массив из Структура - содержит:
//								* Ид - Строка - идентификатор пользователя или устройства Клеверенс, которому назначается документ
//                              * Имя - Строка - наименование пользователя или устройства Клеверенс, которому назначается документ
//  ТипБазы - Строка - "Частная", "Временная", "Основная"
&НаКлиенте
Функция ЛокЯдро_ВыгрузитьДокументВБазуSMARTS(Документ1С, ID_БизнесПроцесса,НазначенныеПользователи,ТипБазы, СписокПередаваемыхНастроек = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ВыгрузитьДокументВБазуSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Документ1С,ID_БизнесПроцесса,НазначенныеПользователи,ТипБазы,СписокПередаваемыхНастроек",
		Документ1С, ID_БизнесПроцесса, НазначенныеПользователи, ТипБазы, СписокПередаваемыхНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	РезультатВыгрузки = Новый Структура;
	РезультатВыгрузки.Вставить("СтатусВыгрузки", Ложь);
	РезультатВыгрузки.Вставить("СообщениеОбОшибках", "");
	
	// Временное решение,  что бы не получать настройки в цикле. Возможно нужно переделать этот метод.
	Если СписокПередаваемыхНастроек = Неопределено Тогда
		
		ДанныеНастроекИзКэша = Новый Структура();
		
		Отбор = Новый Структура("Используется,ТипИсходногоДокумента1С,ID_БизнесПроцесса", Истина, ЛокЯдро_ПолучитьТипДокументаПоСсылке(Документ1С), ID_БизнесПроцесса);
		ОтобранныеБизнесПроцессы = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиБизнесПроцессов", Отбор, "");
		Если ОтобранныеБизнесПроцессы = Неопределено
			Или ОтобранныеБизнесПроцессы.Количество() = 0 Тогда
			
			АвтотестКлеверенс = КомЯдро_ПолучитьЗначениеПеременной("Автотест");
			// Для автотеста не важно, включен ли бизнес-процесс, поэтому не будем накладывать отбор по использованию
			Если АвтотестКлеверенс = Истина Тогда
				Если Отбор.Свойство("Используется") Тогда
					Отбор.Удалить("Используется");
					ОтобранныеБизнесПроцессы = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("НастройкиБизнесПроцессов", Отбор, "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ОтобранныеБизнесПроцессы = Неопределено
			Или ОтобранныеБизнесПроцессы.Количество() = 0 Тогда
			// <Лог>
			ЯзСтрока = "ru = 'Не удалось получить бизнес-процесс при выгрузке документа %1';
								|en = 'Couldn''t get the business process when uploading the document %1';
								|be = 'Не атрымалася атрымаць бізнес-працэс пры выгрузцы дакумента %1'; es = 'No se pudo recuperar el proceso de negocio al descargar el documento %1'; ka = 'ვერ მოხერხდა ბიზნეს პროცესის მიღება დოკუმენტის ატვირთვისას %1'; kk = '%1 құжатын түсіру кезінде бизнес-процесті алу мүмкін болмады'; ro = 'Nu s-a putut obține procesul de afaceri la încărcarea documentului %1'; tr = 'Belge %1 yüklendiğinde iş süreci alınamadı'; uk = 'Не вдалося отримати бізнес-процес при вивантаженні документа %1'; uz = '%1 hujjatini yuklashda biznes jarayonini olish mumkin emas'";
			ТекстОшибки = ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока), Документ1С);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
				"Документ1С",
				Документ1С);
			ЛогОшибка(логСобытие, ТекстОшибки, ЯзСтрока, логКонтекст);
			
			логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", РезультатВыгрузки);
			ЛогЗавершитьСобытие(логСобытие, логКонтекст);
			// </Лог>
			
			Сообщить(ТекстОшибки); 
			
			Возврат РезультатВыгрузки;
		Иначе
			ДанныеНастроекИзКэша.Вставить("СписокБизнесПроцессов",  ОтобранныеБизнесПроцессы);		
		КонецЕсли;
		
		Отбор = Новый Структура("Направление,ТипОбъекта", "Выгрузка", "Шапка");
		ПроизвольныеКодыШапки = ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
		ДанныеНастроекИзКэша.Вставить("ПроизвольныеКодыШапки",ПроизвольныеКодыШапки);
		
