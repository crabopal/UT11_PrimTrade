												|be = 'Дадзеная апрацоўка працуе ў дэма рэжыме. Выгрузка даведнікаў будзе абмежаваная 100 радкоў. Набудзьце падаўжэнне падпіскі на абнаўлення і тэхнічную падтрымку. У наступных прылад скончылася падпіска на абнаўленне:'; es = 'Este procesamiento funciona en modo demo. La descarga de directorios se limitará a 100 líneas. Compre una renovación de suscripción para actualizaciones y soporte técnico. Los siguientes dispositivos han terminado de suscribirse a la actualización:'; ka = 'ეს დამუშავება მუშაობს დემო რეჟიმში. დირექტორიების ატვირთვა შემოიფარგლება 100 ხაზით. შეიძინეთ სააბონენტო გაფართოება განახლებებისა და ტექნიკური მხარდაჭერისთვის. შემდეგი მოწყობილობები ამოიწურა მათი განახლება გამოწერა:'; kk = 'Бұл өңдеу демо режимінде жұмыс істейді. Анықтамалықтарды түсіру 100 жолмен шектеледі. Жаңартулар мен техникалық қолдауға жазылымды жаңартуды сатып алыңыз. Келесі құрылғылар жаңартуға жазылуды аяқтады:'; ro = 'Această procesare funcționează în modul demo. Încărcarea directoarelor va fi limitată la 100 de linii. Achiziționați o extensie de abonament pentru actualizări și asistență tehnică. Următoarele dispozitive au expirat abonamentul de upgrade:'; tr = 'Bu işlem demo modunda çalışır. Dizinlerin boşaltılması 100 satırla sınırlı olacaktır. Güncellemeler ve teknik destek için abonelik yenilemeleri satın alın. Aşağıdaki cihazların güncelleme aboneliği sona erdi:'; uk = 'Дана обробка працює в демо режимі. Вивантаження довідників буде обмежена 100 рядків. Придбайте поновлення підписки на оновлення та технічну підтримку. У наступних пристроїв Закінчилася підписка на оновлення:'; uz = 'Ushbu ishlov berish demo rejimida ishlaydi. Kataloglarni yuklash 100 qator bilan cheklanadi. Yangilanish obunasini yangilash va texnik yordamni sotib oling. Quyidagi qurilmalar yangilanish obunasini tugatdi:'");
	ТекстВыгрузкаДокумента 				= НСтр("ru = 'Данная обработка работает в демо режиме. При работе с документом на следующих устройствах табличная часть документа будет обрезана до трех строк:';
												|en = 'This processing works in demo mode. When working with a document on the following devices, the tabular part of the document will be trimmed to three lines.:';
												|be = 'Дадзеная апрацоўка працуе ў дэма рэжыме. Пры працы з дакументам на наступных прыладах Таблічная частка дакумента будзе абрэзана да трох радкоў:'; es = 'Este procesamiento funciona en modo demo. Si trabaja con un documento en los siguientes dispositivos, la parte de tabla del documento se recortará a tres líneas:'; ka = 'ეს დამუშავება მუშაობს დემო რეჟიმში. შემდეგ მოწყობილობებზე დოკუმენტთან მუშაობისას დოკუმენტის ცხრილის ნაწილი სამ ხაზამდე იქნება დამსხვრეული.:'; kk = 'Бұл өңдеу демо режимінде жұмыс істейді. Құжатпен келесі құрылғыларда жұмыс істегенде құжаттың кестелік бөлігі үш жолға дейін кесіледі:'; ro = 'Această procesare funcționează în modul demo. Când lucrați cu un document pe următoarele dispozitive, partea tabelară a documentului va fi tăiată la trei linii.:'; tr = 'Bu işlem demo modunda çalışır. Aşağıdaki cihazlarda bir belgeyle çalışırken, belgenin tablo kısmı en fazla üç satıra kırpılacaktır:'; uk = 'Дана обробка працює в демо режимі. При роботі з документом на наступних пристроях таблична частина документа буде обрізана до трьох рядків:'; uz = 'Ushbu ishlov berish demo rejimida ishlaydi. Quyidagi qurilmalarda hujjat bilan ishlashda hujjatning jadval qismi uch qatorga qisqartiriladi:'");
	ТекстЗагрузкаДокументаСОбрезкой 	= НСтр("ru = 'Документ будет обрезан до трех строк, так как обработка более свежая чем позволяет подписка на обновления на ТСД. Приобретите продление подписки на обновления и техническую поддержку.';
											|en = 'The document will be trimmed to three lines, as the processing is more recent than the subscription for updates to the Mobile device allows. Purchase a subscription extension for updates and technical support.';
											|be = 'Дакумент будзе абрэзаны да трох радкоў, так як апрацоўка больш свежая чым дазваляе падпіска на абнаўлення на мабільную прыладу. Набудзьце падаўжэнне падпіскі на абнаўлення і тэхнічную падтрымку.'; es = 'El documento se recortará a tres líneas, ya que el procesamiento es más reciente de lo que permite la suscripción a actualizaciones en el dispositivo Móvil. Compre una renovación de suscripción para actualizaciones y soporte técnico.'; ka = 'დოკუმენტი სამ ხაზამდე იქნება შემცირებული, რადგან დამუშავება უფრო ახალია, ვიდრე მობილური მოწყობილობის განახლებების გამოწერა საშუალებას იძლევა. შეიძინეთ სააბონენტო გაფართოება განახლებებისა და ტექნიკური მხარდაჭერისთვის.'; kk = 'Құжат үш жолға дейін кесіледі, өйткені өңдеу мобильді құрылғының жаңартуларына жазылуға мүмкіндік береді. Жаңартулар мен техникалық қолдауға жазылымды жаңартуды сатып алыңыз.'; ro = 'Documentul va fi redus la trei linii, deoarece procesarea este mai recentă decât permite abonamentul pentru actualizări la dispozitivul mobil. Achiziționați o extensie de abonament pentru actualizări și asistență tehnică.'; tr = 'İşlem, Mobil Cihazdaki güncellemelere abone olmanın izin verdiğinden daha yeni olduğu için belge en fazla üç satıra kesilecektir. Güncellemeler ve teknik destek için abonelik yenilemeleri satın alın.'; uk = 'Документ буде обрізаний до трьох рядків, так як обробка більш свіжа ніж дозволяє підписка на оновлення на мобільний пристрій. Придбайте поновлення підписки на оновлення та технічну підтримку.'; uz = 'Hujjat uch qatorga qisqartiriladi, chunki ishlov berish mobil qurilmaga yangilanishlarga obuna bo''lishdan ko''ra yangiroq. Yangilanish obunasini yangilash va texnik yordamni sotib oling.'");
	
	Если Событие = "ПоУмолчанию" Тогда 
		ЗаголовокСообщения = ТекстПредупреждение;
	ИначеЕсли Событие = "ВыгрузкаСправочника" Тогда
		Если СтруктураМетаданных.HardDemo = Истина Тогда
			ЗаголовокСообщения = ТекстВыгрузкаСправочниковСОбрезкой;
		Иначе
			ЗаголовокСообщения = ТекстПредупреждение;	
		КонецЕсли;
	ИначеЕсли Событие = "ВыгрузкаДокумента" Тогда 
		ЗаголовокСообщения = ТекстВыгрузкаДокумента;
	ИначеЕсли Событие = "ЗагрузкаДокумента" Тогда 
		ЗаголовокСообщения = ТекстЗагрузкаДокументаСОбрезкой;
	КонецЕсли;
	
	МассивСтрок.Добавить(ЗаголовокСообщения);
	
	ДопустимаяДата = Дата(2050,1,1);	
	Для Каждого Устройство Из СтруктураМетаданных.УстройстваMS Цикл
		Если ПроверяемоеУстройство <> "" Тогда
			Если Устройство.deviceId <> ПроверяемоеУстройство Тогда
				Продолжить;
			ИначеЕсли Устройство.isDemo = Ложь Тогда
				Возврат "";
			КонецЕсли;
		КонецЕсли;
				
		Если Устройство.isDemo = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если Устройство.supportDate < ДопустимаяДата Тогда
			ДопустимаяДата = Устройство.supportDate;
		КонецЕсли;
		СтрокаИдУстройства = Новый ФорматированнаяСтрока(Символы.ПС+Устройство.deviceDescription+" ("+Формат(Устройство.supportDate, "ДЛФ=Д")+")", Новый Шрифт(,, Истина), WebЦвета.Красный);
		МассивСтрок.Добавить(СтрокаИдУстройства);
	КонецЦикла;
	
	Если ДопустимаяДата < Дата(2050,1,1) Тогда
		МассивСтрок.Добавить(Символы.ПС);
		ПодвалСообщения = НСтр("ru = 'Используйте обработку версии не позднее %1';
								|en = 'Use version processing no later than %1'; be = 'Выкарыстоўвайце апрацоўку версіі не пазней %1'; es = 'Utilice el tratamiento de la versión dentro de %1'; ka = 'გამოიყენეთ ვერსიის დამუშავება არაუგვიანეს %1-ისა'; kk = 'Нұсқаны өңдеуді %1-ден кешіктірмей қолданыңыз'; ro = 'Utilizați procesarea versiunilor nu mai târziu de %1'; tr = 'Sürüm işlemeyi en geç% 1''e kadar kullanın'; uk = 'Використовуйте обробку версії не пізніше %1'; uz = 'Eng kamida %1 versiyasini qayta ishlashdan foydalaning'");
		ПодвалСообщения = ЛокЯдро_СтрШаблон(ПодвалСообщения, Формат(ДопустимаяДата, "ДЛФ=Д"));
		МассивСтрок.Добавить(ПодвалСообщения);
	КонецЕсли;
	
	МассивСтрок.Добавить(Символы.ПС);
	СтрокаСсылкаНаБЗ = Новый ФорматированнаяСтрока(НСтр("ru = 'Подробнее';
															|en = 'More detailed'; be = 'Падрабязна'; es = 'Detallado'; ka = 'უფრო დეტალური'; kk = 'Толығырақ'; ro = 'Mai detaliat'; tr = 'Etraflıca'; uk = 'Докладно'; uz = 'Batafsil'"),,,,"https://www.cleverence.ru/support/355758/");
		
	МассивСтрок.Добавить(СтрокаСсылкаНаБЗ);
	РезультатСообщение = Новый ФорматированнаяСтрока(МассивСтрок);
	
	Возврат РезультатСообщение;	
КонецФункции

#КонецОбласти

&НаКлиенте
Функция ЛокЯдро_ПредопределенныеЗначения(Группа = "Общее", Ключ = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Если Кэш = Неопределено Тогда
		Кэш = Новый Структура;
	КонецЕсли;
	
	// в кэш тянется вся группа кроме Общее
	Если Не Кэш.Свойство(Группа) Тогда
		Если Группа = "Общее" Тогда
			ПредопределенныеЗначения = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, Ключ);
		Иначе
			ПредопределенныеЗначения = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа);
		КонецЕсли;
		
		Кэш.Вставить(Группа, ПредопределенныеЗначения);		
	КонецЕсли;
	
	Результат = Новый Структура;
	НетВКэше = Новый Массив;
	Ключи = ЛокЯдро_СтрРазделить(Ключ, ",");
	
	Если Ключ = Неопределено Тогда
		
		Для каждого КЗ Из Кэш[Группа] Цикл
			Результат.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		
	Иначе
		
		ЗначениеКлюча = Неопределено;
		Для каждого ОдинКлюч Из Ключи Цикл
			Если Не Кэш[Группа].Свойство(ОдинКлюч, ЗначениеКлюча) Тогда
				НетВКэше.Добавить(ОдинКлюч);
			Иначе
				Результат.Вставить(ОдинКлюч, ЗначениеКлюча);
			КонецЕсли;
		КонецЦикла;
		
		КоличествоДляЗапроса = НетВКэше.Количество();
		Если КоличествоДляЗапроса > 0 Тогда
			КлючейНетВКэше = ЛокЯдро_СтрСоединить(НетВКэше, ",");
			ЗначенияКлючей = ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, КлючейНетВКэше);
			Если КоличествоДляЗапроса = 1 Тогда
				Кэш[Группа].Вставить(КлючейНетВКэше, ЗначенияКлючей);
				Результат.Вставить(КлючейНетВКэше, ЗначенияКлючей);
			Иначе
				Для каждого КЗ Из ЗначенияКлючей Цикл
					Кэш[Группа].Вставить(КЗ.Ключ, КЗ.Значение);
					Результат.Вставить(КЗ.Ключ, КЗ.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	
		
		
	КонецЕсли;
	
	Если Ключи.Количество() = 1 Тогда
		Возврат Кэш[Группа][Ключ];
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЛокЯдро_ПредопределенныеЗначенияНаСервере(Группа, Ключ = Неопределено)
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Группа", Группа);
	ПараметрыМетода.Вставить("Ключ",   Ключ);
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПредопределенныеЗначения");
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	ПередаваемыеПараметры = Транзит_ПоместитьЗначениеВХранилищеНаСервере(СтруктураВызова);
	
	АдресРезультата = Транзит_ВызватьГлобальныйМетодНаСервере(ПередаваемыеПараметры, АдресаПеременных);
	
	ПолученноеЗначение = ?(ЭтоАдресВременногоХранилища(АдресРезультата),
		ПолучитьИзВременногоХранилища(АдресРезультата), Новый Структура);
	
	Возврат ПолученноеЗначение;
		
КонецФункции

#Область ЛокальныйКонтекстПроверкаОткрытияФорм

&НаКлиенте
Процедура ЛокЯдро_ПроверитьОткрытиеФорм() 
	НачалоПроверки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	пСообщение = НСтр("ru = 'Старт тестирования открытия форм';
						|en = 'Start of form opening testing'; be = 'Старт тэставання адкрыцця формаў'; es = 'Inicio de pruebas de apertura de formularios'; ka = 'ფორმის გახსნის ტესტირების დაწყება'; kk = 'Нысандарды ашуды тестілеуді бастау'; ro = 'Începerea testării deschiderii formularului'; tr = 'Form açma testine başlama'; uk = 'Старт тестування відкриття форм'; uz = 'Shakllarni ochish sinovini boshlash'");
	ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверкаОткрытияФорм", "Информация", пСообщение);
	
	СписокПроцедур = Новый СписокЗначений;
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыСправочников");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ОбменДокументами");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_ПодборПользователей1С");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиПодключения");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_БизнесПроцессы");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ГлобальныеПараметры");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_Узлы");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСлужебная_НастройкиОбработки");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ОтборДокументов");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаСписка_ОтборыДокументов");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_БизнесПроцесс");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаВыгрузкиПолей");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаЗагрузкиПолей");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаВыгрузкиТЧ");
	СписокПроцедур.Добавить("ЛокЯдро_ПроверитьОткрытиеФорм_ФормаНастройки_ПравилаЗагрузкиТЧ");
	
	Для каждого ТекПроцедура из СписокПроцедур Цикл
		ТекстОшибки = "";
		Попытка
			#Область НесовместимыйКодFresh
			Выполнить(ТекПроцедура.Значение + "()");
			#КонецОбласти //НесовместимыйКодFresh
			#Область СовместимыйКодFresh	
			//СтруктураВыполнения = ЛокЯдро_ВыполнитьМетодПоИмени(ТекПроцедура.Значение);
			//
			//ТекстОшибки = СтруктураВыполнения.ТекстОшибки;
			#КонецОбласти //СовместимыйКодFresh
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекФорма = СтрЗаменить(ТекПроцедура.Значение, "ЛокЯдро_ПроверитьОткрытиеФорм_", "");
			
