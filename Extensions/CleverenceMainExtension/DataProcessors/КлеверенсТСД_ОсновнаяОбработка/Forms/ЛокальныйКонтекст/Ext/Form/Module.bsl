#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_УстановкаНастроек

// Обновляет значения текущих настроек Клеверенс в кэше переданными значениями настроек
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо сохранить
&НаКлиенте 
Процедура ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "ЗаписатьВКэшНастройкиSMARTS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("СтруктураНастроек", СтруктураНастроек));
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	
	Если ТипЗнч(ТекущиеНастройкиMS) <> Тип("Структура") Тогда
		ТекущиеНастройкиMS = Новый Структура;
	КонецЕсли;
	
	Для Каждого Настройка Из СтруктураНастроек Цикл
		ТекущиеНастройкиMS.Вставить(Настройка.Ключ, Настройка.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Обновляет значение текущей настройки Клеверенс в кэше переданным значением
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, значение которой необходимо сохранить
//  ЗначениеНастройки - Произвольный - значение настройки
&НаКлиенте 
Процедура ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS(КлючНастройки, ЗначениеНастройки) Экспорт
		
	СтруктураНастроек = Новый Структура(КлючНастройки, ЗначениеНастройки);
	ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
	
КонецПроцедуры

// Вызывает процедуру сохранения настроек в базе Клеверенс
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, значения которых необходимо сохранить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
&НаКлиенте
Процедура ЛокЯдро_СохранитьНастройкиВБазеSMARTS(Знач СтруктураНастроек, ID_Узла = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СохранитьНастройкиВБазеSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла,ДополнительныеПараметры",
		СтруктураНастроек, ID_Узла, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	
	НеКэшировать = Ложь;
	НеЛогировать = Ложь;
	Если СтруктураНастроек.Свойство("НеКэшировать", НеКэшировать) Тогда
		СтруктураНастроек.Удалить("НеКэшировать");
	КонецЕсли;
	Если СтруктураНастроек.Свойство("НеЛогировать", НеЛогировать) Тогда
		СтруктураНастроек.Удалить("НеЛогировать");				
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("СтруктураНастроек", СтруктураНастроек);
		ПараметрыМетода.Вставить("ID_Узла", 		  ID_Узла);
		ПараметрыМетода.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Процедура");
		СтруктураВызова.Вставить("ИмяМетода", "СохранитьНастройкиВБазеSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	Иначе
		Если КатегорииНастроекMS = Неопределено Тогда
			КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();		
		КонецЕсли;
		
		СтруктураНастроекДляКэширования = ЛокЯдро_СкопироватьСтруктуру(СтруктураНастроек);
		
		СериализуемыеНастройки = Неопределено;
		ДополнительныеПараметры.Свойство("СериализуемыеНастройки", СериализуемыеНастройки);
		
		СтруктураНастроекДляЗаписи = ЛокЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, "ВСтроку", СериализуемыеНастройки);
		
		Если НеЛогировать = Истина Тогда
			ДополнительныеПараметры.Вставить("НеЛогировать", Истина);
		КонецЕсли;
		Если НеКэшировать = Истина Тогда
			ДополнительныеПараметры.Вставить("НеКэшировать", Истина);
		КонецЕсли;
		
		ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
		Если ТипИнтерфейса = "REST_API" Тогда
			REST_API_ЗаписатьНастройкиSMARTS(СтруктураНастроекДляЗаписи, КатегорииНастроекMS, ID_Узла, СтруктураНастроекДляКэширования, ДополнительныеПараметры);
		Иначе	
			КомЯдро_ЗаписатьНастройкиSMARTS(СтруктураНастроекДляЗаписи, КатегорииНастроекMS, ID_Узла, СтруктураНастроекДляКэширования, ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Вызывает процедуру сохранения настройки в базе Клеверенс по ключу
//
// Параметры:
//	КлючНастройки - Строка - имя настройки Клеверенс, значение которой необходимо сохранить
//	ЗначениеНастройки - Произвольный - значение настройки
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
&НаКлиенте 
Процедура ЛокЯдро_СохранитьНастройкуВБазеSMARTS(КлючНастройки, ЗначениеНастройки, ID_Узла = "") Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки, ЗначениеНастройки);
	ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_Узла);
	
КонецПроцедуры

// В базе Клеверенс находит настройку табличного типа (массив структур) по ключу, 
// находит все строки, соответствующие отбору, и заполняет их значениями из переданной структуры настроек 
// 
// Параметры:
//	КлючНастройки - Строка - название настройки в базе SMARTS
//	Отбор - Структура - в качестве ключей содержит имена колонок табличной настройки Клеверенс, в качестве
//						значений - значения соответствующих колонок, по которым необходимо выполнить отбор
// 	СтруктураНастройки - Структура - сохраняемое значение табличной настройки
// 	ID_Узла - Строка - идентификатор узла сохраняемых настроек
//	ПолнаяЗамена - Булево - флаг необходимости полной замены значений настроек в отобранных строках
&НаКлиенте
Процедура ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS(КлючНастройки, Отбор, СтруктураНастройки, ID_Узла = "", ПолнаяЗамена = Ложь) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"КлючНастройки,Отбор,СтруктураНастройки,ID_Узла,ПолнаяЗамена",
		КлючНастройки, Отбор, СтруктураНастройки, ID_Узла, ПолнаяЗамена);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ЭтоТекущийУзел = (ID_Узла = ДанныеТекущегоУзла.ID_Узла) ИЛИ (КатегорииНастроекMS.УзловыеНастройки.Найти(КлючНастройки) = Неопределено);
	Если ЭтоТекущийУзел Тогда
		ТаблицаНастроек = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS(КлючНастройки);
	Иначе
		ТаблицаНастроек = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS(КлючНастройки, ID_Узла);
	КонецЕсли;
	
	// Новые настройки бизнес-процессов заключены в структуру, поэтому сначала получим саму таблицу из нее
	ТаблицаВСтруктуре = Ложь;
	Если ТипЗнч(ТаблицаНастроек) = Тип("Структура") И ТаблицаНастроек.Свойство("НастройкиБизнесПроцессов") Тогда
		ТаблицаВСтруктуре = Истина;		
		пТаблицаНастроек = Новый Структура(Новый ФиксированнаяСтруктура(ТаблицаНастроек));
		ТаблицаНастроек = пТаблицаНастроек.НастройкиБизнесПроцессов;	
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаНастроек) <> Тип("Массив") Тогда
		ТаблицаНастроек = Новый Массив;
		ТаблицаНастроек.Добавить(СтруктураНастройки);
	Иначе
		СтрокиДляЗаполнения = ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ТаблицаНастроек,Отбор);
		Если СтрокиДляЗаполнения = Неопределено Тогда
			ТаблицаНастроек.Добавить(СтруктураНастройки);
		Иначе
			Если ПолнаяЗамена = Истина Тогда
				Для Каждого СтрокаНастройки Из СтрокиДляЗаполнения Цикл
					СтрокаНастройки.Очистить();
					Для каждого КлючЗначение Из СтруктураНастройки Цикл
						СтрокаНастройки.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);
					КонецЦикла;
				КонецЦикла;
			Иначе
				Для Каждого СтрокаНастройки Из СтрокиДляЗаполнения Цикл
					ЗаполнитьЗначенияСвойств(СтрокаНастройки,СтруктураНастройки);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//Создадим описание структуры массива		
	Если ТаблицаНастроек[0].Свойство("ЭтоТаблицаЗначений") = Ложь Тогда	
		ПеречислениеКолонок = "";
		Для Каждого Свойство Из СтруктураНастройки Цикл
			ПеречислениеКолонок = ПеречислениеКолонок+?(ПеречислениеКолонок = "","",",")+Свойство.Ключ;
		КонецЦикла;
		СтрокаОписания = Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,ПеречислениеКолонок);
		ТаблицаНастроек.Вставить(0,СтрокаОписания);
	КонецЕсли; 		
	
	Если ТаблицаВСтруктуре Тогда
		пТаблицаНастроек.Вставить("НастройкиБизнесПроцессов", ТаблицаНастроек);
		ТаблицаНастроек = пТаблицаНастроек;
	КонецЕсли;
	
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS(КлючНастройки, ТаблицаНастроек, ID_Узла);
	Если ЭтоТекущийУзел Тогда
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS(КлючНастройки, ТаблицаНастроек);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_ПолучитьТекущуюДатуНаСервере() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьТекущуюДату");

	Возврат Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);	

КонецФункции

// Вызывает метод из модуля обработки для сохранения данных в хранилище общих настроек
//
// Параметры:
//	 КлючДляСохранения - Строка - ключ настройки для сохранения
//   ДанныеДляСохранения - Произвольный - значение настройки для сохранения
&НаКлиенте
Процедура ЛокЯдро_СохранитьДанныеВХранилище1С(КлючДляСохранения, ДанныеДляСохранения) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "СохранитьДанныеВХранилище1С");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("КлючДляСохранения,ДанныеДляСохранения", КлючДляСохранения, ДанныеДляСохранения));
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);	

КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "СохранитьПараметрыПодключенияMS");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ПараметрыПодключенияMS, ДополнительныеПараметры", ПараметрыПодключенияMS, ДополнительныеПараметры));
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);	
	
КонецПроцедуры

// Вызывает процедуру обновления шаблонов весового товара в базе Клеверенс
//
// Параметры:
//	ТаблицаШаблонов - Массив из Структура - содержит:
//		* Префикс - Строка	
//      * ЦелаяЧасть - Строка
//      * ДробнаяЧасть - Строка
//      * ДлинаКодаВесовогоТовара - Строка
//      * ПрефиксВключенВКод - Булево
&НаКлиенте
Процедура ЛокЯдро_СохранитьШаблоныВесовогоТовараВБазеSMARTS() Экспорт
	
	ИмяСобытия = "ЛокЯдро_СохранитьШаблоныВесовогоТовараВБазеSMARTS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	ТаблицаШаблонов = Новый Массив;	
	ИспользоватьШаблоны = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ИспользоватьШаблоныВесовогоТовара"); 
	
	Если Не ИспользоватьШаблоны Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;	
	КонецЕсли;
	
	Если ИспользоватьШаблоны Тогда
		СтрокаПрефиксов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксКодаВесовогоТовара");
		СтрокаПрефиксов = ?(СокрЛП(СтрокаПрефиксов) = "", "21", СтрокаПрефиксов);
		ДлинаКодаВесовогоТовара = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ДлинаКодаВесовогоТовара");
		ОбщаяДлина = 12;
		ДробнаяЧасть = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ЧислоЗнаковПослеЗапятойВесТовара");
		ДробнаяЧасть = ?(ДробнаяЧасть = Ложь ИЛИ ДробнаяЧасть = 0, 3, ДробнаяЧасть);
		ЦелаяЧасть = ОбщаяДлина - (ДробнаяЧасть + ДлинаКодаВесовогоТовара);
		ПрефиксВключенВКод = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПрефиксВключенВКодВесовогоТовара");
		ПрефиксВключенВКод = ?(ПрефиксВключенВКод = Истина, Истина, Ложь); // если вернется неопределено или "", то ложь.  
		
		МассивПрефиксов = Новый Массив;
		Пока Истина Цикл
			ПозицияРазделителя = Найти(СтрокаПрефиксов, ",");
			Если ПозицияРазделителя = 0 Тогда
				Если (СокрЛП(СтрокаПрефиксов) <> "") Тогда
					МассивПрефиксов.Добавить(СтрокаПрефиксов);
				КонецЕсли;
				Прервать;
			КонецЕсли;
			МассивПрефиксов.Добавить(СокрЛП(Лев(СтрокаПрефиксов,ПозицияРазделителя - 1)));
			СтрокаПрефиксов = Сред(СтрокаПрефиксов, ПозицияРазделителя + 1);
		КонецЦикла;
		
		Для Каждого Префикс Из МассивПрефиксов Цикл
			НовыйШаблон = Новый Структура;
			НовыйШаблон.Вставить("Префикс",Префикс);
			НовыйШаблон.Вставить("ЦелаяЧасть",Строка(ЦелаяЧасть));
			НовыйШаблон.Вставить("ДробнаяЧасть",Строка(ДробнаяЧасть));
			НовыйШаблон.Вставить("ДлинаКодаВесовогоТовара",Строка(ДлинаКодаВесовогоТовара));
			НовыйШаблон.Вставить("ПрефиксВключенВКод",ПрефиксВключенВКод);
			ТаблицаШаблонов.Добавить(НовыйШаблон);
		КонецЦикла;
	КонецЕсли;
	
	ЕстьЧастнаяБаза = КомЯдро_ПолучитьЗначениеПеременной("ЕстьЧастнаяБаза");
	Если ЕстьЧастнаяБаза = Истина Тогда
		ТипБазы = "Частная";
	Иначе
		ТипБазы = "Основная";
	КонецЕсли;
	
	#Если ВебКлиент Тогда  
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Процедура");
		СтруктураВызова.Вставить("ИмяМетода", "СохранитьШаблоныВесовогоТовараВБазеSMARTS");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ТаблицаШаблонов,ТипБазы", ТаблицаШаблонов, ТипБазы));
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	#Иначе
		Если РасположениеКомпоненты = "НаСервере" Тогда
			СтруктураВызова = Новый Структура;
			СтруктураВызова.Вставить("ТипМетода", "Процедура");
			СтруктураВызова.Вставить("ИмяМетода", "СохранитьШаблоныВесовогоТовараВБазеSMARTS");
			СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ТаблицаШаблонов,ТипБазы", ТаблицаШаблонов, ТипБазы));
			Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
		Иначе               
			ТипИнтерфейса = ЛокЯдро_ПолучитьТипИнтерфейса(ТипБазы);	
	
			Если ТипИнтерфейса = "REST_API" Тогда				
				REST_API_ОбновитьШаблоныВесовогоТовараMS(ТаблицаШаблонов, ТипБазы);
			Иначе
				КомЯдро_ОбновитьШаблоныВесовогоТовараMS(ТаблицаШаблонов);
			КонецЕсли;
		КонецЕсли;  
	#КонецЕсли	
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Устанавливает в базе Клеверенс флаг, определяющий, будет ли доступен поиск по наименованию для выгруженной номенклатуры
&НаКлиенте
Процедура ЛокЯдро_УстановитьПоискПоНаименованиюИАртикулу() Экспорт
	
	ИмяСобытия = "ЛокЯдро_УстановитьПоискПоНаименованиюИАртикулу";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	УстановитьПоискПоНаименованиюИАртикулу = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("УстановитьПоискПоНаименованиюИАртикулу");
	
	ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
	Если ТипИнтерфейса ="REST_API" Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Процедура");
		СтруктураВызова.Вставить("ИмяМетода", "УстановитьПоискПоНаименованиюИАртикулу");		
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("УстановитьПоискПоНаименованиюИАртикулу", УстановитьПоискПоНаименованиюИАртикулу));
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);	
	Иначе
		КомЯдро_УстановитьПоискПоНаименованиюИАртикулу(УстановитьПоискПоНаименованиюИАртикулу);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Удаляет из базы Клеверенс настройку по ключу
// 
// Параметры:
// 	КлючНастройки - Строка - название настройки
// 	ID_Узла - Строка - идентификатор узла удаляемой настройки
&НаКлиенте
Процедура ЛокЯдро_УдалитьНастройкуВБазеSMARTS(КлючНастройки, ID_Узла = "") Экспорт
	
	СтруктураНастроек = Новый Структура(КлючНастройки);
	ЛокЯдро_УдалитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_Узла);
	
КонецПроцедуры	

// Вызывает процедуру удаления настроек в базе Клеверенс
//
// Параметры:
//	СтруктураНастроек - Структура - ключами являются имена настроек Клеверенс, которые необходимо удалить
//  ID_Узла - Строка - идентификатор узла в текущей сессии Клеверенс
&НаКлиенте
Процедура ЛокЯдро_УдалитьНастройкиВБазеSMARTS(Знач СтруктураНастроек, ID_Узла = "") Экспорт
	
	ИмяСобытия = "ЛокЯдро_УдалитьНастройкиВБазеSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ID_Узла",
		СтруктураНастроек, ID_Узла);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	Если РасположениеКомпоненты = "НаСервере" Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Процедура");
		СтруктураВызова.Вставить("ИмяМетода", "УдалитьНастройкиВБазеSMARTS");				
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
		СтруктураВызова.ПараметрыМетода.Вставить("СтруктураНастроек", СтруктураНастроек);
		СтруктураВызова.ПараметрыМетода.Вставить("УзловыеНастройки", КатегорииНастроекMS.УзловыеНастройки);
		СтруктураВызова.ПараметрыМетода.Вставить("ID_Узла", ID_Узла);				
		Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	Иначе		
		// При удалении настроек из базы также удаляем их из настроек пользователя
		ЛокЯдро_ОчиститьКэшируемыеНастройки(, СтруктураНастроек);
		
		ТипИнтерфейса = КомЯдро_ПолучитьЗначениеПеременной("ТипИнтерфейса");
		Если ТипИнтерфейса = "REST_API" Тогда
			REST_API_УдалитьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS.УзловыеНастройки, ID_Узла);
		Иначе
			КомЯдро_УдалитьНастройкиSMARTS(СтруктураНастроек, КатегорииНастроекMS.УзловыеНастройки, ID_Узла);
		КонецЕсли;
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_СохранитьИдентификаторыНастроекMS(ИдентификаторыНастроек)
	
	ИмяСобытия = "ЛокЯдро_СохранитьИдентификаторыНастроекMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ИдентификаторыНастроек",
		ИдентификаторыНастроек);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы");
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	СохраненныеИдентификаторыНастроекMS = ЛокЯдро_ПолучитьИдентификаторыНастроекMS();
	Если СохраненныеИдентификаторыНастроекMS = Неопределено Тогда
		СохраненныеИдентификаторыНастроекMS = Новый Структура;
	КонецЕсли;
	
	СохранитьНастройки = Истина; // Ложь;
	
	Для каждого СтрокаНастройки ИЗ ИдентификаторыНастроек Цикл
		СохраненныеИдентификаторыНастроекMS.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		
		//ТекущееЗначение = Неопределено;
		//Если НЕ СохраненныеИдентификаторыНастроекMS.Свойство(СтрокаНастройки.Ключ, ТекущееЗначение)	ИЛИ ТекущееЗначение = Неопределено Тогда
		//	СохраненныеИдентификаторыНастроекMS.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		//	
		//	Если НЕ СохранитьНастройки Тогда
		//		СохранитьНастройки = Истина;
		//	КонецЕсли;
		//КонецЕсли;
	КонецЦикла;
	
	Если СохранитьНастройки Тогда
		ЛокЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
		КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_УдалитьИдентификаторыНастроекMS(МассивНастроек, ПоИдентификаторам = Ложь)
	
	ИмяСобытия = "ЛокЯдро_УдалитьИдентификаторыНастроекMS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"МассивНастроек,ПоИдентификаторам",
		МассивНастроек, ПоИдентификаторам);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ИдентификаторБазыMS = КомЯдро_ПолучитьЗначениеПеременной("ID_ТекущейБазы");
	Если ИдентификаторБазыMS = Неопределено Тогда
		ИдентификаторБазыMS = ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ID_ТекущейБазы");
	КонецЕсли;	
	
	Если ИдентификаторБазыMS = Неопределено Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;		
	КонецЕсли;
	
	КлючНастройки = "Cleverence_ИдентификаторыНастроекMS_" + СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	
	СохраненныеИдентификаторыНастроекMS = ЛокЯдро_ПолучитьИдентификаторыНастроекMS();
	Если СохраненныеИдентификаторыНастроекMS = Неопределено Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки = Ложь;
	
	Для каждого Настройка ИЗ МассивНастроек Цикл
		Если ПоИдентификаторам Тогда
			НайденныеНастройки = ЛокЯдро_НайтиПоЗначениюВСтруктуре(СохраненныеИдентификаторыНастроекMS, Настройка);
			Для каждого СтрокаНастройки ИЗ НайденныеНастройки Цикл
				СохраненныеИдентификаторыНастроекMS.Удалить(СтрокаНастройки.Ключ);
				Если НЕ СохранитьНастройки Тогда
					СохранитьНастройки = Истина;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если СохраненныеИдентификаторыНастроекMS.Свойство(Настройка) Тогда
				СохраненныеИдентификаторыНастроекMS.Удалить(Настройка);
				Если НЕ СохранитьНастройки Тогда
					СохранитьНастройки = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СохранитьНастройки Тогда
		ЛокЯдро_СохранитьДанныеВХранилище1С(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
		КомЯдро_СохранитьЗначениеПеременной(КлючНастройки, СохраненныеИдентификаторыНастроекMS);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЛокЯдро_ОчиститьХранилищеОбщихНастроек1С() Экспорт
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Процедура");
	СтруктураВызова.Вставить("ИмяМетода", "ОчиститьХранилищеОбщихНастроек1С");	
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура);
	
	Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова);	

КонецПроцедуры
#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_ОбменНастройками

// Функция - Лок ядро обмен настройками получить настройки для экспорта
//
// Параметры:
//  ОтборНастроек			 - Структура, Неопределено 	- Отбор по именам настроек. При Неопределено - будут получены все настройки. 
//  ОтборИдУзлов			 - Массив, Неопределено 	- Отбор по узлам. При Неопределено - будут получены все узлы. 
//  ДополнительныеПараметры	 - Произвольный 
// 
// Возвращаемое значение:
//   - Структура - Значения настроек, узловые настройки сгруппированы
//
&НаКлиенте
Функция ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляЭкспорта(ОтборНастроек = Неопределено, ОтборИдУзлов = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляЭкспорта";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОтборНастроек,ОтборИдУзлов,ДополнительныеПараметры",
		ОтборНастроек, ОтборИдУзлов, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// На всякий случай на будущее
	ВерсияОбменаНастроек = 2;
	
	// Получаем настройки на сервере SMARTS без кэширования
	ЗначенияНастроекЭкспорт = ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек, ОтборИдУзлов, ДополнительныеПараметры);
	
	// Копия структуры настроек со всеми данными, включая служебные
	ЗначенияНастроекСлужебные = ЛокЯдро_СкопироватьСтруктуру(ЗначенияНастроекЭкспорт);
	ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ЗначенияНастроекСлужебные, ОтборИдУзлов, ДополнительныеПараметры);
	
	// Экспортируемую структуру очищаем от лишних данных
	ЛокЯдро_ОбменНастройками_УдалитьИзбыточныеНастройкиДляЭкспорта(ЗначенияНастроекЭкспорт, ДополнительныеПараметры);
	
	ДанныеНастроекЭкспорт = Новый Структура;
	ДанныеНастроекЭкспорт.Вставить("ДатаНастроек", ТекущаяДата());
	ДанныеНастроекЭкспорт.Вставить("ВерсияОбменаНастроек", ВерсияОбменаНастроек);
	ДанныеНастроекЭкспорт.Вставить("Значения", ЗначенияНастроекЭкспорт);
	
	ДанныеНастроекСлужебные = Новый Структура;
	ДанныеНастроекСлужебные.Вставить("ДатаНастроек", ДанныеНастроекЭкспорт.ДатаНастроек);
	ДанныеНастроекСлужебные.Вставить("ВерсияОбменаНастроек", ВерсияОбменаНастроек);
	ДанныеНастроекСлужебные.Вставить("Значения", ЗначенияНастроекСлужебные);
	
	ДанныеНастроек = Новый Структура("ДанныеНастроекЭкспорт, ДанныеНастроекСлужебные", ДанныеНастроекЭкспорт, ДанныеНастроекСлужебные);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ДанныеНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ДанныеНастроек;
	
КонецФункции

// Функция - Лок ядро обмен настройками получить настройки для копирования узла
//
// Параметры:
//  ID_УзлаОснование		 - 	 - 
//  ОтборНастроек			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте
Функция ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляКопированияУзла(ID_УзлаОснование = "", ОтборНастроек = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляКопированияУзла";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ID_УзлаОснование,ОтборНастроек,ДополнительныеПараметры",
		ID_УзлаОснование, ОтборНастроек, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	
	// Настройки, которые не экспортируются и не копируются между ТО.
	ИсключаемыеНастройки = Новый Массив;
	ИсключаемыеНастройки.Добавить("ЗначенияПараметровУзлов");
	ИсключаемыеНастройки.Добавить("ФормаОбменаВыбранныеКолонки");
	ИсключаемыеНастройки.Добавить("ФормаОбменаВыбранныеКолонкиSMARTS");
	ИсключаемыеНастройки.Добавить("НастройкиТаймаутов");
	ИсключаемыеНастройки.Добавить("НастройкиРазмеровПорцийДанных");
	ИсключаемыеНастройки.Добавить("НастройкиПечатиЭтикеток");
	ИсключаемыеНастройки.Добавить("UnavailableDocuments");
	ИсключаемыеНастройки.Добавить("НастройкиБизнесПроцессов");
	ИсключаемыеНастройки.Добавить("ГлобальныеПараметры"); // Пока не нужны
	
	// Если не задан параметр, то получаем все настройки
	Если ОтборНастроек = Неопределено Тогда
		
		ОтборНастроек = Новый Структура;
		ОтборНастроек.Вставить("Узлы");
		Для каждого ИмяНастройки Из КатегорииНастроекMS.СериализуемыеНастройки Цикл
			Если ИсключаемыеНастройки.Найти(ИмяНастройки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИмяНастройки <> "Пользователи"
				И УзловыеНастройки.Найти(ИмяНастройки) <> Неопределено Тогда
				ОтборНастроек.Вставить(ИмяНастройки + "_Узлы");
				
				Если ИмяНастройки <> "ПользователиТСД" Тогда
					ОтборНастроек.Вставить(ИмяНастройки);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// 
	ОтборИдУзлов = Новый Массив;
	ОтборИдУзлов.Добавить(ID_УзлаОснование);
	Если ЗначениеЗаполнено(ID_УзлаОснование) Тогда
		ОтборИдУзлов.Добавить("");
	КонецЕсли;
	
	// Получаем настройки на сервере SMARTS без кэширования
	ЗначенияНастроек = ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек, ОтборИдУзлов, ДополнительныеПараметры);
	ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ЗначенияНастроек, ОтборИдУзлов, ДополнительныеПараметры);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", ЗначенияНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат ЗначенияНастроек;
	
КонецФункции 

// +++ Экспорт настроек

// Получает настройки с сервера SMARTS без кэша для экспорта и копирования
//  Настройки которые могут быть экспортированы или скопированы между узлами
//
// Параметры:
//  ОтборНастроек			 - 	 - 
//  ОтборИдУзлов			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте
Функция ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек = Неопределено, ОтборИдУзлов = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ОтборНастроек,ОтборИдУзлов,ДополнительныеПараметры",
		ОтборНастроек, ОтборИдУзлов, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	
	// Отбор по узлам
	Если ОтборИдУзлов = Неопределено Тогда
		МассивИдУзлов = Новый Массив;
		МассивИдУзлов.Добавить("");
		Узлы = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("Узлы");
		Если НЕ Узлы = Ложь И ТипЗнч(Узлы) = Тип("Массив")  Тогда
			Для Каждого СтрокаУзла Из Узлы Цикл
				Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;	
				МассивИдУзлов.Добавить(СтрокаУзла.ID_Узла);
			КонецЦикла;
		КонецЕсли;
	Иначе
		МассивИдУзлов = ОтборИдУзлов;
	КонецЕсли;
	
	Если НЕ МассивИдУзлов.Количество() Тогда
		
		// <Лог>
		логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", Новый Структура);
		ЛогЗавершитьСобытие(логСобытие, логКонтекст);
		// </Лог>
		
		Возврат Новый Структура;
	КонецЕсли;
	
	// Добавить пустую строку в МассивИдУзлов для получения настроек главного узла или не узловых настроек
	ПолучатьДляГлавногоУзла = МассивИдУзлов.Найти("") <> Неопределено;
	ПолучатьДляУзлов = МассивИдУзлов.Количество() > 1;
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	ИменаНастроек = Новый Массив;
	ИменаНастроек.Добавить("ГруппыПользователей");
	ИменаНастроек.Добавить("НастройкиНоменклатуры");
	Для каждого ИмяНастройки Из КатегорииНастроекMS.СериализуемыеНастройки Цикл
		ИменаНастроек.Добавить(ИмяНастройки);
	КонецЦикла;
	
	УзловыеНастройки = КатегорииНастроекMS.УзловыеНастройки;
	
	// Настройки, которые не экспортируются и не копируются между ТО.
	ИсключаемыеНастройки = Новый Массив;
	ИсключаемыеНастройки.Добавить("ЗначенияПараметровУзлов");
	ИсключаемыеНастройки.Добавить("ФормаОбменаВыбранныеКолонки");
	ИсключаемыеНастройки.Добавить("ФормаОбменаВыбранныеКолонкиSMARTS");
	ИсключаемыеНастройки.Добавить("НастройкиТаймаутов");
	ИсключаемыеНастройки.Добавить("НастройкиРазмеровПорцийДанных");
	ИсключаемыеНастройки.Добавить("НастройкиПечатиЭтикеток");
	ИсключаемыеНастройки.Добавить("UnavailableDocuments");
	ИсключаемыеНастройки.Добавить("НастройкиБизнесПроцессов");
	
	// Пока не нужны
	ИсключаемыеНастройки.Добавить("ГлобальныеПараметры");
	
	// Если не задан параметр, то получаем все настройки
	Если ОтборНастроек = Неопределено Тогда
		СтруктураНастроек = Новый Структура;
		Для каждого ИмяНастройки Из ИменаНастроек Цикл
			Если ИсключаемыеНастройки.Найти(ИмяНастройки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПолучатьДляГлавногоУзла
				И ИмяНастройки <> "ПользователиТСД" Тогда
				СтруктураНастроек.Вставить(ИмяНастройки);
			КонецЕсли;
			
			Если ПолучатьДляУзлов
				И ИмяНастройки <> "Пользователи"
				И УзловыеНастройки.Найти(ИмяНастройки) <> Неопределено Тогда
				СтруктураНастроек.Вставить(ИмяНастройки + "_Узлы");
			КонецЕсли;
		КонецЦикла;
	Иначе
		СтруктураНастроек = ЛокЯдро_СкопироватьСтруктуру(ОтборНастроек);
	КонецЕсли;
	
	// Выбираем связанные настройки
	ЛокЯдро_ОбменНастройками_ДобавитьСвязанныеИменаНастроек(СтруктураНастроек);
	
	// Формируем структуру настроек в которую запишутся настройки.
	НастройкиКПолучениюУзловые 		= Новый Структура;
	
	НастройкиКПолучению = Новый Структура;
	НастройкиКПолучению.Вставить("ВерсияОбработкиНастроек");
	
	Для каждого Настройка Из СтруктураНастроек Цикл
		ИмяНастройки = Настройка.Ключ;
		ИмяНастройкиБезУзла = СтрЗаменить(ИмяНастройки, "_Узлы", "");
		
		Если ИменаНастроек.Найти(ИмяНастройкиБезУзла) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяНастройки <> ИмяНастройкиБезУзла Тогда
			НастройкиКПолучениюУзловые.Вставить(ИмяНастройкиБезУзла);
		Иначе
			НастройкиКПолучению.Вставить(ИмяНастройки);
		КонецЕсли;
	КонецЦикла;
	
	// Настройки справочников в шапке
	Если СтруктураНастроек.Свойство("НастройкиНоменклатуры") Тогда
		Для каждого ИмяНастройки Из КатегорииНастроекMS.НастройкиНоменклатуры Цикл
			Если ИсключаемыеНастройки.Найти(ИмяНастройки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НастройкиКПолучению.Вставить(ИмяНастройки);
		КонецЦикла;
	КонецЕсли;
	
	ПолучитьПользователей = Ложь;
	Если НастройкиКПолучению.Свойство("Пользователи") Тогда
		ПолучитьПользователей = Истина;
		НастройкиКПолучению.Удалить("Пользователи");
	КонецЕсли;
	
	ПолучитьГруппыПользователей = Ложь;
	Если НастройкиКПолучению.Свойство("ГруппыПользователей") Тогда
		ПолучитьГруппыПользователей = Истина;
		НастройкиКПолучению.Удалить("ГруппыПользователей");
	КонецЕсли;
	
	// Получаем настройки напрямую с сервера SMARTS без чтения и записи кэша
	ДополнительныеПараметры.Вставить("НеКэшировать", Истина);
	ДополнительныеПараметры.Вставить("НеПроверятьАктуальность", Истина);
	
	// Получаем настройки главного узла
	ЗначенияНастроек = Новый Структура;
	Если НастройкиКПолучению.Количество() Тогда
		ЗначенияНастроек = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(НастройкиКПолучению,, ДополнительныеПараметры);
	КонецЕсли;
	
	// Настройки узлов
	УзловыеЗначенияНастроек = Новый Структура;
	Если НастройкиКПолучениюУзловые.Количество() Тогда
		
		Для каждого ИдУзла Из МассивИдУзлов Цикл
			Если ИдУзла = "" Тогда
				Продолжить;
			КонецЕсли;
			
			пНастройкиКПолучениюУзловые = ЛокЯдро_СкопироватьСтруктуру(НастройкиКПолучениюУзловые);
			ЗначенияНастроекУзла = ЛокЯдро_ПолучитьНастройкиНаСервереSMARTS(пНастройкиКПолучениюУзловые, ИдУзла, ДополнительныеПараметры);
			Для каждого НастройкаУзла Из ЗначенияНастроекУзла Цикл
				
				ИмяУзловойНастройки = НастройкаУзла.Ключ + "_Узлы";
				
				НастройкиУзлов = Неопределено;
				УзловыеЗначенияНастроек.Свойство(ИмяУзловойНастройки, НастройкиУзлов);
				Если НастройкиУзлов = Неопределено Тогда
					НастройкиУзлов = Новый Структура;
				КонецЕсли;
				
				НастройкиУзлов.Вставить(ИдУзла, НастройкаУзла.Значение);
				УзловыеЗначенияНастроек.Вставить(ИмяУзловойНастройки, НастройкиУзлов);
				
			КонецЦикла;
		КонецЦикла;
		
		Для каждого УзловаяНастройка Из УзловыеЗначенияНастроек Цикл
			ЗначенияНастроек.Вставить(УзловаяНастройка.Ключ, УзловаяНастройка.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	// Получение пользователей
	Если ПолучитьПользователей Тогда
		ЗначениеНастройки = ЛокЯдро_ПолучитьПользователейSMARTS();
		Если ЭтоАдресВременногоХранилища(ЗначениеНастройки) Тогда
			ЗначениеНастройки = ПолучитьИзВременногоХранилища(ЗначениеНастройки);
		КонецЕсли;
		ЗначенияНастроек.Вставить("Пользователи", ЗначениеНастройки);
	КонецЕсли;
	
	// Получение группы пользователей
	Если ПолучитьГруппыПользователей Тогда
		// Группы пользователей
		ЗначениеНастройки = ЛокЯдро_ПолучитьГруппыПользователейSMARTS();
		Если ЭтоАдресВременногоХранилища(ЗначениеНастройки) Тогда	
			ЗначениеНастройки = ПолучитьИзВременногоХранилища(ЗначениеНастройки);
		КонецЕсли;
		ЗначенияНастроек.Вставить("ГруппыПользователей", ЗначениеНастройки);
	КонецЕсли;
	
	// Заполняем значения настроек
	Для каждого Настройка Из ЗначенияНастроек Цикл
		ИмяНастройки = Настройка.Ключ;
		ЗначениеНастройки = Настройка.Значение;
		
		// Группируем настройки шапки справочников
		Если КатегорииНастроекMS.НастройкиНоменклатуры.Найти(ИмяНастройки) <> Неопределено Тогда
			
			НастройкиНоменклатуры = Неопределено;
			СтруктураНастроек.Свойство("НастройкиНоменклатуры", НастройкиНоменклатуры);
			НастройкиНоменклатуры = ?(НастройкиНоменклатуры = Неопределено, Новый Структура, НастройкиНоменклатуры);
			
			НастройкиНоменклатуры.Вставить(ИмяНастройки, ЗначениеНастройки);
			СтруктураНастроек.Вставить("НастройкиНоменклатуры", НастройкиНоменклатуры);
			
		Иначе
			СтруктураНастроек.Вставить(ИмяНастройки, ЗначениеНастройки);
		КонецЕсли;
		
	КонецЦикла;
	
	ЛокЯдро_ОбменНастройками_ЗаполнитьНедостающиеНастройки(СтруктураНастроек, ДополнительныеПараметры);
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
 	Возврат СтруктураНастроек;
	
КонецФункции 

// Процедура - Лок ядро обмен настройками добавить связанные имена настроек
//
// Параметры:
//  СтруктураНастроек	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ДобавитьСвязанныеИменаНастроек(СтруктураНастроек) Экспорт
	
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию")
		ИЛИ СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские")
		ИЛИ СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки")Тогда
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские");
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки");
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ГлобальныеПараметры_ПоУмолчанию")
		ИЛИ СтруктураНастроек.Свойство("ГлобальныеПараметры_Пользовательские") 
		ИЛИ СтруктураНастроек.Свойство("ГлобальныеПараметры_Значения")
		ИЛИ СтруктураНастроек.Свойство("ГлобальныеПараметры_Значения_Узлы")Тогда
		СтруктураНастроек.Вставить("ГлобальныеПараметры_ПоУмолчанию");
		СтруктураНастроек.Вставить("ГлобальныеПараметры_Пользовательские");
		СтруктураНастроек.Вставить("ГлобальныеПараметры_Значения");
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НастройкиОбменаСправочников_ПоУмолчанию") 
		ИЛИ СтруктураНастроек.Свойство("НастройкиОбменаСправочников")
		ИЛИ СтруктураНастроек.Свойство("НастройкиОбменаСправочников_Узлы")Тогда
		СтруктураНастроек.Вставить("НастройкиОбменаСправочников_ПоУмолчанию");
		СтруктураНастроек.Вставить("НастройкиОбменаСправочников");
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_ПоУмолчанию_Онлайн")
		ИЛИ СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Онлайн") Тогда
		СтруктураНастроек.Вставить("НастройкиОтборовУзлов_ПоУмолчанию_Онлайн");
		СтруктураНастроек.Вставить("НастройкиОтборовУзлов_Онлайн");
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Интерактивный")
		ИЛИ СтруктураНастроек.Свойство("НастройкиОтборовУзлов_ПоУмолчанию_Интерактивный") Тогда
		СтруктураНастроек.Вставить("НастройкиОтборовУзлов_ПоУмолчанию_Интерактивный");
		СтруктураНастроек.Вставить("НастройкиОтборовУзлов_Интерактивный");
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ПроизвольныеКоды_ПоУмолчанию")
		ИЛИ СтруктураНастроек.Свойство("ПроизвольныеКоды_Пользовательские") Тогда
		СтруктураНастроек.Вставить("ПроизвольныеКоды_ПоУмолчанию");
		СтруктураНастроек.Вставить("ПроизвольныеКоды_Пользовательские");
	КонецЕсли;
	
КонецПроцедуры 

// Заполняет значения главного узла из значений ПоУмолчанию, если не задано собственное.
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ЗаполнитьНедостающиеНастройки(СтруктураНастроек, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ЗаполнитьНедостающиеНастройки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ДополнительныеПараметры",
		СтруктураНастроек, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию", ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию));
	КонецЕсли;
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские") Тогда
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские", ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_Пользовательские));
	КонецЕсли;
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки") Тогда
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_ПользовательскиеНастройки));
	КонецЕсли;
	
	// Глобальные параметры
	Если СтруктураНастроек.Свойство("ГлобальныеПараметры_Значения") Тогда
		
		ГлобальныеПараметры 	= Новый Массив();
		СтрокаНастройки 			= ЛокЯдро_СтруктураСтрокиНастроек_ГлобальныеПараметры();
		ОписаниеТаблицы 		= ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтрокаНастройки);
		ГлобальныеПараметры.Добавить(ОписаниеТаблицы);
		
		ГлобальныеПараметры_ПоУмолчанию 	 =  СтруктураНастроек.ГлобальныеПараметры_ПоУмолчанию;
		ГлобальныеПараметры_Пользовательские = СтруктураНастроек.ГлобальныеПараметры_Пользовательские;
		ГлобальныеПараметры_Значения = СтруктураНастроек.ГлобальныеПараметры_Значения;
		
		Если ЗначениеЗаполнено(ГлобальныеПараметры_ПоУмолчанию) И НЕ ГлобальныеПараметры_ПоУмолчанию = Ложь Тогда
			Для каждого СтрокаГП ИЗ ГлобальныеПараметры_ПоУмолчанию Цикл
				Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
					НоваяСтрока = ЛокЯдро_СкопироватьСтруктуру(СтрокаГП);
					НоваяСтрока.Вставить("Типовой", Истина);
					
					НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", НоваяСтрока.ID_Параметра);
					Если НайденныйПараметр <> Неопределено Тогда
						НоваяСтрока.Значение = НайденныйПараметр.Значение;
					КонецЕсли;
					
					ГлобальныеПараметры.Добавить(НоваяСтрока);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГлобальныеПараметры_Пользовательские) И НЕ ГлобальныеПараметры_Пользовательские = Ложь Тогда
			Для каждого СтрокаГП ИЗ ГлобальныеПараметры_Пользовательские Цикл
				Если НЕ СтрокаГП.Свойство("ЭтоТаблицаЗначений") Тогда
					НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_ПоУмолчанию, "ID_Параметра", СтрокаГП.ID_Параметра);
					Если НайденныйПараметр = Неопределено Тогда
						
						НоваяСтрока = ЛокЯдро_СкопироватьСтруктуру(СтрокаГП);
						НоваяСтрока.Вставить("Типовой", Ложь);
						
						НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Значения, "ID_Параметра", НоваяСтрока.ID_Параметра);
						Если НайденныйПараметр <> Неопределено Тогда
							НоваяСтрока.Значение = НайденныйПараметр.Значение;
						КонецЕсли;
						
						ГлобальныеПараметры.Добавить(НоваяСтрока);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		СтруктураНастроек.Вставить("ГлобальныеПараметры_Значения", ГлобальныеПараметры);
		
	КонецЕсли;
	
	// Онлайн отборы
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Онлайн") Тогда
		
		ИмяНастройки = "НастройкиОтборовУзлов_Онлайн";
		ЗначениеПользовательское = Неопределено;
		СтруктураНастроек.Свойство(ИмяНастройки, ЗначениеПользовательское);
		
		ЗначениеПоУмолчанию = Неопределено;
		СтруктураНастроек.Свойство("НастройкиОтборовУзлов_ПоУмолчанию_Онлайн", ЗначениеПоУмолчанию);
		
		КлючОтбора 					= ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
		ЗначениеПользовательское 	= ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЗначениеПоУмолчанию, ЗначениеПользовательское, КлючОтбора);
		СтруктураНастроек.Вставить(ИмяНастройки, ЗначениеПользовательское);
		
	КонецЕсли;
	
	// Офлайн отборы
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Интерактивный") Тогда
		
		ИмяНастройки = "НастройкиОтборовУзлов_Интерактивный";
		ЗначениеПользовательское = Неопределено;
		СтруктураНастроек.Свойство(ИмяНастройки, ЗначениеПользовательское);
		
		ЗначениеПоУмолчанию = Неопределено;
		СтруктураНастроек.Свойство("НастройкиОтборовУзлов_ПоУмолчанию_Интерактивный", ЗначениеПоУмолчанию);
		
		КлючОтбора 					= ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройки);
		ЗначениеПользовательское 	= ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЗначениеПоУмолчанию, ЗначениеПользовательское, КлючОтбора);
		СтруктураНастроек.Вставить(ИмяНастройки, ЗначениеПользовательское);
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Удаляет настройки по умолчанию, т.к они избыточны и есть в главном узле.
//  При импорте не имеет значения настройка является типовой или нет.
//  При импорте всегда проверяется наличие значения в базе, если нет, то добавляется как пользовательский.
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_УдалитьИзбыточныеНастройкиДляЭкспорта(СтруктураНастроек, ДополнительныеПараметры = Неопределено) Экспорт
	
	// Глобальные параметры
	Если СтруктураНастроек.Свойство("ГлобальныеПараметры_ПоУмолчанию") Тогда
		СтруктураНастроек.Удалить("ГлобальныеПараметры_ПоУмолчанию");
	КонецЕсли;
	Если СтруктураНастроек.Свойство("ГлобальныеПараметры_Пользовательские") Тогда
		СтруктураНастроек.Удалить("ГлобальныеПараметры_Пользовательские");
	КонецЕсли;
	
	// Настройки справочников
	Если СтруктураНастроек.Свойство("НастройкиОбменаСправочников") Тогда
		СтруктураНастроек.Удалить("НастройкиОбменаСправочников_ПоУмолчанию");
	КонецЕсли;
	
	// Онлайн отборы
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Онлайн") Тогда
		СтруктураНастроек.Удалить("НастройкиОтборовУзлов_ПоУмолчанию_Онлайн");
	КонецЕсли;
	
	// Офлайн отборы
	Если СтруктураНастроек.Свойство("НастройкиОтборовУзлов_Интерактивный") Тогда
		СтруктураНастроек.Удалить("НастройкиОтборовУзлов_ПоУмолчанию_Интерактивный");
	КонецЕсли;
	
КонецПроцедуры 

// Выполняется после чтения настроек из файла
//  Дополняет настройки служебными значениями.
//  Заполняет пустые значения настроек из типовых или главного узла,
//  нужно стремиться к тому, чтобы настройки всегда были заполнены.
//  Для оптимизации выполняем этот метод после чтения настроек из файла, чтобы не увеличивать размер файла.
//  Частично восстанавливает удаленные значения в ЛокЯдро_ОбменНастройками_ОбработатьИзбыточныеИНедостающиеНастройки
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ОтборИдУзлов			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(СтруктураНастроек, ОтборИдУзлов = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ОтборИдУзлов,ДополнительныеПараметры",
		СтруктураНастроек, ОтборИдУзлов, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Узлы
	МассивИдУзлов = Новый Массив;
	Если СтруктураНастроек.Свойство("Узлы") Тогда
		Узлы = СтруктураНастроек.Узлы;
		Если НЕ Узлы = Ложь И ТипЗнч(Узлы) = Тип("Массив")  Тогда
			Для Каждого СтрокаУзла Из Узлы Цикл
				Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;	
				МассивИдУзлов.Добавить(СтрокаУзла.ID_Узла);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	СтруктураНастроек.Вставить("ИдУзлов", МассивИдУзлов);
	СтруктураНастроек.Вставить("ЕстьУзлы", МассивИдУзлов.Количество() > 0);
	// ---
	
	// Общий список бизнес-процессов
	ИдБизнесПроцессов = Новый Массив;
	ОбщаяСтруктураБизнесПроцессов = Новый Массив();
	ИдТиповыхБП = Новый Массив();
	
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПоУмолчанию") Тогда
		НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_ПоУмолчанию);
		
		Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_ПоУмолчанию) И НЕ НастройкиБизнесПроцессов_ПоУмолчанию = Ложь Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_ПоУмолчанию) = Тип("Строка") Тогда
				НастройкиБизнесПроцессов_ПоУмолчанию = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_ПоУмолчанию, Истина);		
			КонецЕсли;
			Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_ПоУмолчанию Цикл			
				Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда
					СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Истина);
					ОбщаяСтруктураБизнесПроцессов.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
					ИдТиповыхБП.Добавить(СтрокаБП.ID_БизнесПроцесса);
					ИдБизнесПроцессов.Добавить(СтрокаБП.ID_БизнесПроцесса);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураНастроек.Вставить("ОбщаяСтруктураБизнесПроцессов", ОбщаяСтруктураБизнесПроцессов);
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские") Тогда
		НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_Пользовательские);
		
		Если ЗначениеЗаполнено(НастройкиБизнесПроцессов_Пользовательские) И НЕ НастройкиБизнесПроцессов_Пользовательские = Ложь Тогда
			Если ТипЗнч(НастройкиБизнесПроцессов_Пользовательские) = Тип("Строка") Тогда
				НастройкиБизнесПроцессов_Пользовательские = ЛокЯдро_ЗначениеИзСтрокиXML(НастройкиБизнесПроцессов_Пользовательские, Истина);		
			КонецЕсли;
			Для Каждого СтрокаБП Из НастройкиБизнесПроцессов_Пользовательские Цикл
				Если НЕ СтрокаБП.Свойство("ЭтоТаблицаЗначений") Тогда			
					СтрокаБП.Вставить("ЭтоТиповойБизнесПроцесс",Ложь);
					Если ИдТиповыхБП.Найти(СтрокаБП.ID_БизнесПроцесса) = Неопределено Тогда
						ОбщаяСтруктураБизнесПроцессов.Добавить(ЛокЯдро_СкопироватьСтруктуру(СтрокаБП));
						ИдБизнесПроцессов.Добавить(СтрокаБП.ID_БизнесПроцесса);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураНастроек.Вставить("ОбщаяСтруктураБизнесПроцессов", ОбщаяСтруктураБизнесПроцессов);
	КонецЕсли;
	
	СтруктураНастроек.Вставить("ИдБизнесПроцессов", ИдБизнесПроцессов);
	
	// в ПользовательскиеНастройки главного узла записываются значения только для типовых БП
	//	для пользовательских они хранятся прямо в НастройкиБизнесПроцессов_Пользовательские
	// Но для упрощения объединяем их в один массив. Проще их разделить непосредственно при сохранении в МС.
	// Также это необходимо для метода ЛокЯдро_ОбменНастройками_ЗаполнитьПустыеНастройкиИзГлавногоУзла. 
	Если СтруктураНастроек.Свойство("ОбщаяСтруктураБизнесПроцессов")
		И СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки") Тогда
		
		НовыеПользовательскиеНастройки = Новый Массив;
		СохраненныеПользовательскиеНастройки = ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.НастройкиБизнесПроцессов_ПользовательскиеНастройки);
		
		Для каждого СтрокаБП Из СтруктураНастроек.ОбщаяСтруктураБизнесПроцессов Цикл
				
			Индекс = Неопределено;
			Если ЗначениеЗаполнено(СохраненныеПользовательскиеНастройки) Тогда
				Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СохраненныеПользовательскиеНастройки, "ID_БизнесПроцесса", СтрокаБП.ID_БизнесПроцесса, Истина);
			КонецЕсли;
			Если Индекс = Неопределено Тогда
				СтрокаНастройки = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
				ЗаполнитьЗначенияСвойств(СтрокаНастройки, СтрокаБП);
			Иначе
				СтрокаНастройки = ЛокЯдро_СкопироватьСтруктуру(СохраненныеПользовательскиеНастройки[Индекс]);
			КонецЕсли;
			НовыеПользовательскиеНастройки.Добавить(СтрокаНастройки);
			
		КонецЦикла;
		СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НовыеПользовательскиеНастройки);
		
	КонецЕсли;
	
	Если ОтборИдУзлов <> Неопределено Тогда
		ИндексГлавного = ОтборИдУзлов.Найти("");
		Если ИндексГлавного <> Неопределено Тогда
			ОтборИдУзлов.Удалить(ИндексГлавного);
		КонецЕсли;
		ИдУзлов = ОтборИдУзлов;
	Иначе
		ИдУзлов = МассивИдУзлов;
	КонецЕсли;
	
	Если ИдУзлов.Количество() Тогда
		ЛокЯдро_ОбменНастройками_ЗаполнитьПустыеНастройкиИзГлавногоУзла(СтруктураНастроек, ИдУзлов);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Копирует значения настроек из главного узла в пользовательские,
//  если собственное значение не задано.
//  Нужно стремиться к тому, чтобы настройки всегда были заполнены.
//
// Параметры:
//  ЗначенияНастроек - 	 - 
//  ОтборИдУзлов	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ЗаполнитьПустыеНастройкиИзГлавногоУзла(ЗначенияНастроек, ИдУзлов = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ЗаполнитьПустыеНастройкиИзГлавногоУзла";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЗначенияНастроек,ИдУзлов",
		ЗначенияНастроек, ИдУзлов);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Для каждого КлючЗначение Из ЗначенияНастроек Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ИмяНастройкиБезУзла = СтрЗаменить(ИмяНастройки, "_Узлы", "");
		Если ИмяНастройки <> ИмяНастройкиБезУзла Тогда
			
			ЗначениеГлавногоУзла = Неопределено;
			ЗначенияНастроек.Свойство(ИмяНастройкиБезУзла, ЗначениеГлавногоУзла);
			Если ЗначениеГлавногоУзла <> Неопределено Тогда
				
				ЗначенияУзлов = КлючЗначение.Значение;
				Для каждого ИдУзла Из ИдУзлов Цикл
					
					ЗначениеУзла = Неопределено;
					ЗначенияУзлов.Свойство(ИдУзла, ЗначениеУзла);
					
					Если ИмяНастройкиБезУзла = "НастройкиБизнесПроцессов_ПользовательскиеНастройки" И ЗначениеЗаполнено(ЗначениеУзла) Тогда
						ЗначениеУзла = ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(ЗначениеУзла);
					ИначеЕсли ИмяНастройкиБезУзла = "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
						
						ЗначениеГлавногоУзла = ЛокЯдро_СкопироватьМассив(ЗначениеГлавногоУзла);
						Для каждого СтрокаНастройки Из ЗначениеГлавногоУзла Цикл
							
							Если СтрокаНастройки.Свойство("ИспользоватьТиповыеНастройки") Тогда
								СтрокаНастройки.ИспользоватьТиповыеНастройки = Неопределено;
							КонецЕсли;
							
							Если СтрокаНастройки.Свойство("ПереопределяемыеНастройки") Тогда
								СтрокаНастройки.ПереопределяемыеНастройки = Неопределено;
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Если ТипЗнч(ЗначениеУзла) = Тип("Массив") И ЛокЯдро_МассивСтруктурСодержитЭлементы(ЗначениеУзла) Тогда
						КлючОтбора = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройкиБезУзла);
						ЗначениеУзла = ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЗначениеГлавногоУзла, ЗначениеУзла, КлючОтбора);
						ЗначенияУзлов.Вставить(ИдУзла, ЗначениеУзла);
					Иначе
						ЗначенияУзлов.Вставить(ИдУзла, ЛокЯдро_СкопироватьМассив(ЗначениеГлавногоУзла));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// +++ Импорт настроек

// Процедура - Лок ядро обмен настройками импортировать настройки
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ОтборИдУзлов			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ИмпортироватьНастройки(СтруктураНастроек, ОтборИдУзлов, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ИмпортироватьНастройки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ОтборИдУзлов,ДополнительныеПараметры",
		СтруктураНастроек, ОтборИдУзлов, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	
	ОповещениеОбработкиЗавершения = Неопределено;
	Если ДополнительныеПараметры.Свойство("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения) Тогда
		ДополнительныеПараметры.Удалить("ОповещениеОбработкиЗавершения");
	КонецЕсли;
	
	ОповещениеОбработкиОшибки = Неопределено;
	Если ДополнительныеПараметры.Свойство("ОповещениеОбработкиОшибки", ОповещениеОбработкиОшибки) Тогда
		ДополнительныеПараметры.Удалить("ОповещениеОбработкиОшибки");
	КонецЕсли;
	
	РежимОбмена = Неопределено;
	ДополнительныеПараметры.Свойство("РежимОбмена", РежимОбмена);
	
	// Получаем настройки из SMARTS для импортируемых настроек
	ОтборНастроек = Новый Структура;
	Для каждого КлючЗначение Из СтруктураНастроек Цикл
		ОтборНастроек.Вставить(КлючЗначение.Ключ);
	КонецЦикла;
	
	ЗначенияSMARTS = ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек, ОтборИдУзлов, ДополнительныеПараметры);
	ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ЗначенияSMARTS, ОтборИдУзлов, ДополнительныеПараметры);
	
	// Обработка пользовательских, типовых и связанных настроек
	ЛокЯдро_ОбменНастройками_ОбработатьСвязанныеЗначенияНастроек(ЗначенияSMARTS, СтруктураНастроек, ДополнительныеПараметры);
	
	// Объединение значений настроек, чтобы не затереть настройки SMARTS
	ЛокЯдро_ОбменНастройками_ОбъединитьЗначенияНастроек(ЗначенияSMARTS, СтруктураНастроек, ДополнительныеПараметры);
	
	// Формируем ПользовательскиеНастройки для главного узла
	
	НБП_ПользовательскиеНастройкиЗначениеMS = Неопределено;
	ЗначенияSMARTS.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НБП_ПользовательскиеНастройкиЗначениеMS);
	
	НБП_ПользовательскиеНастройки = Неопределено;
	СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки", НБП_ПользовательскиеНастройки);
	Если ЗначениеЗаполнено(НБП_ПользовательскиеНастройки) И НЕ НБП_ПользовательскиеНастройки = Ложь Тогда
		
		НастройкаИзменена = Ложь;
		
		// Т.к ПользовательскиеНастройки для главного узла пользовательских БП хранятся в НастройкиБизнесПроцессов_Пользовательские, то проверяем является ли БП типовым.
		// см. ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями
		НБП_Пользовательские = Неопределено;
		СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские", НБП_Пользовательские);
		Если ЗначениеЗаполнено(НБП_Пользовательские) И НЕ НБП_Пользовательские = Ложь Тогда
			
			ПользовательскиеНастройкиНовые = Новый Массив;
			СтрокаНастройки 	= ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
			ОписаниеТаблицы 	= ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(СтрокаНастройки);
			ПользовательскиеНастройкиНовые.Добавить(ОписаниеТаблицы);
			
			Для каждого пСтрокаНастройки Из НБП_ПользовательскиеНастройки Цикл
				Если пСтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И пСтрокаНастройки.ЭтоТаблицаЗначений = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаНастройки = ЛокЯдро_СтруктураСтрокиНастроек_НастройкиБизнесПроцессов_ПользовательскиеНастройки();
				ЗаполнитьЗначенияСвойств(СтрокаНастройки, пСтрокаНастройки);
				
				Индекс = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НБП_Пользовательские, "ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса, Истина);
				Если Индекс = Неопределено Тогда
					// Типовой БП
					
					// Восстанавливаем значение ПереопределяемыеНастройки при копировании из сохраненных,
					//	т.к этот параметр заполняется только в главном узле.
					Если РежимОбмена = "Копирование"
						И НБП_ПользовательскиеНастройкиЗначениеMS <> Неопределено
						И НБП_ПользовательскиеНастройкиЗначениеMS <> Ложь Тогда
						
						СтрокаЗначенияSMARTS = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(НБП_ПользовательскиеНастройкиЗначениеMS, "ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса);
						Если СтрокаЗначенияSMARTS <> Неопределено Тогда
							
							Если СтрокаЗначенияSMARTS.Свойство("ИспользоватьТиповыеНастройки") Тогда
								СтрокаНастройки.Вставить("ИспользоватьТиповыеНастройки", СтрокаЗначенияSMARTS.ИспользоватьТиповыеНастройки);
							КонецЕсли;
							Если СтрокаЗначенияSMARTS.Свойство("ПереопределяемыеНастройки") Тогда
								СтрокаНастройки.Вставить("ПереопределяемыеНастройки", СтрокаЗначенияSMARTS.ПереопределяемыеНастройки);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					ПользовательскиеНастройкиНовые.Добавить(СтрокаНастройки);
				Иначе
					// Пользовательский БП
					// Если, это был типовой БП, то переносим переопределяемые настройки в основной БП
					#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
						Если СтрокаНастройки.Свойство("ПереопределяемыеНастройки") И ЗначениеЗаполнено(СтрокаНастройки.ПереопределяемыеНастройки) Тогда
							НБП_Пользовательские[Индекс] = ЛокЯдро_ОбъединитьСтруктуруНастроек(НБП_Пользовательские[Индекс], СтрокаНастройки.ПереопределяемыеНастройки);
						КонецЕсли;
					#КонецЕсли
					
					// Пользовательский БП в НастройкиБизнесПроцессов_ПользовательскиеНастройки не добавляем
					// но тогда необходимо обновить НастройкиБизнесПроцессов_Пользовательские
					ЗаполнитьЗначенияСвойств(НБП_Пользовательские[Индекс], СтрокаНастройки);
				КонецЕсли;
			КонецЦикла;
			
			СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки", ПользовательскиеНастройкиНовые);
			
			// Конвертируем в пользовательские БП, так-как при импорте типовой БП мог стать пользовательским
			НБП_Пользовательские = ЛокЯдро_ПреобразоватьБизнесПроцессыВПользовательские(НБП_Пользовательские);
			СтруктураНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские", НБП_Пользовательские);
			
		КонецЕсли;
	КонецЕсли;
	
	// Удаляем ПереопределяемыеНастройки в значениях узлов, т.к этот параметр заполняется только в главном узле.
	ЗначениеНастройки = Неопределено;
	Если СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_ПользовательскиеНастройки_Узлы", ЗначениеНастройки) Тогда
		Для каждого КлючЗначение Из ЗначениеНастройки Цикл
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				Для каждого СтрокаНастройки Из КлючЗначение.Значение Цикл
					
					Если СтрокаНастройки.Свойство("ИспользоватьТиповыеНастройки") Тогда
						СтрокаНастройки.ИспользоватьТиповыеНастройки = Неопределено;
					КонецЕсли;
					
					Если СтрокаНастройки.Свойство("ПереопределяемыеНастройки") Тогда
						СтрокаНастройки.ПереопределяемыеНастройки = Неопределено;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
	ДополнительныеПараметры.Вставить("ОповещениеОбработкиОшибки", ОповещениеОбработкиОшибки);
	
	// Сохранение настроек и обновление кэша
	ЛокЯдро_ОбменНастройками_СохранитьНастройкиНаСерверSMARTS(СтруктураНастроек, ДополнительныеПараметры);
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Процедура - Лок ядро обмен настройками обработать связанные значения настроек
//
// Параметры:
//  ЗначенияSMARTS			 - 	 - 
//  ЗначенияИмпорт			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ОбработатьСвязанныеЗначенияНастроек(ЗначенияSMARTS, ЗначенияИмпорт, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ОбработатьСвязанныеЗначенияНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЗначенияSMARTS,ЗначенияИмпорт,ДополнительныеПараметры",
		ЗначенияSMARTS, ЗначенияИмпорт, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Проверка наличия импортируемой и родительской настройки в SMARTS. Если нет, то добавляем в пользовательские
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ЗначенияИмпорт", 					ЗначенияИмпорт);
	ПараметрыВыполнения.Вставить("ЗначенияSMARTS", 					ЗначенияSMARTS);
	
	// НастройкиБизнесПроцессов
	ПараметрыВыполнения.Вставить("ИмяНастройкиИсточник", 			"НастройкиБизнесПроцессов_ПоУмолчанию");
	ПараметрыВыполнения.Вставить("ИмяНастройкиПриемник", 			"НастройкиБизнесПроцессов_Пользовательские");
	ПараметрыВыполнения.Вставить("ЗначенияДляСтрокиПриемника", 		Новый Структура("ЭтоТиповойБизнесПроцесс", Ложь));
	ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения);
	
	// ПроизвольныеКоды
	ПараметрыВыполнения.Вставить("ИмяНастройкиИсточник", 			"ПроизвольныеКоды_ПоУмолчанию");
	ПараметрыВыполнения.Вставить("ИмяНастройкиПриемник", 			"ПроизвольныеКоды_Пользовательские");
	ПараметрыВыполнения.Вставить("ЗначенияДляСтрокиПриемника", 		Новый Структура("ЭтоТиповой", Ложь));
	ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения);
	
	// ГлобальныеПараметры
	ПараметрыВыполнения.Вставить("ИмяНастройкиИсточник", 			"ГлобальныеПараметры_Значения");
	ПараметрыВыполнения.Вставить("ИмяНастройкиПриемник", 			"ГлобальныеПараметры_Пользовательские");
	ПараметрыВыполнения.Вставить("ЗначенияДляСтрокиПриемника", 		Новый Структура("Типовой", Ложь));
	ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения);
	
	ПараметрыВыполнения.Вставить("ИмяНастройкиИсточник", 			"ГлобальныеПараметры_Значения_Узлы");
	ПараметрыВыполнения.Вставить("ИмяНастройкиПриемник", 			"ГлобальныеПараметры_Пользовательские");
	ПараметрыВыполнения.Вставить("ЗначенияДляСтрокиПриемника", 		Новый Структура("Типовой", Ложь));
	ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения);
	
	ОбновитьГПГлавногоУзла = ЗначенияИмпорт.Свойство("ГлобальныеПараметры_Значения");
	
	// Заполняем значения главного узла, если ГП импортируется только для пользовательских узлов
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ЗначенияИмпорт", 					ЗначенияИмпорт);
	ПараметрыВыполнения.Вставить("ЗначенияSMARTS", 					Новый Структура);
	ПараметрыВыполнения.Вставить("ИмяНастройкиИсточник", 			"ГлобальныеПараметры_Пользовательские");
	ПараметрыВыполнения.Вставить("ИмяНастройкиПриемник", 			"ГлобальныеПараметры_Значения");
	ПараметрыВыполнения.Вставить("ЗначенияДляСтрокиПриемника", 		Новый Структура("Типовой", Ложь));
	ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения);
	
	Если ЗначенияИмпорт.Свойство("ГлобальныеПараметры_Значения") Тогда
		
		// Значения ГП в ГлобальныеПараметры_Пользовательские и ГлобальныеПараметры_Значения должны быть одинаковыми
		// 	поэтому определяем в каком параметре хранятся актуальные значения.
		// Если импортируются значения для главного узла, 
		//	то необходимо обновить значения в ГлобальныеПараметры_Пользовательские из ГлобальныеПараметры_Значения
		// Если значений главного узла нет, 
		//	то обновляем значения в ГлобальныеПараметры_Значения из ГлобальныеПараметры_Пользовательские
		
		ГлобальныеПараметры_Значения 	= ЗначенияИмпорт.ГлобальныеПараметры_Значения;
		КлючУникальности 					= ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек("ГлобальныеПараметры_Значения");
		
		ИндексВставки = Неопределено;
		ГлобальныеПараметры_Пользовательские = Неопределено;
		ЗначенияИмпорт.Свойство("ГлобальныеПараметры_Пользовательские", ГлобальныеПараметры_Пользовательские);
		Если ГлобальныеПараметры_Пользовательские = Неопределено ИЛИ ГлобальныеПараметры_Пользовательские.Количество() = 0 Тогда
			ГлобальныеПараметры_Пользовательские = Новый Массив;
			ОписаниеТаблицы = ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ЛокЯдро_СтруктураСтрокиНастроек_ГлобальныеПараметры());
			ГлобальныеПараметры_Пользовательские.Добавить(ОписаниеТаблицы);
			ИндексВставки = 1;
		КонецЕсли;
		
		Для каждого СтрокаНастройки Из ГлобальныеПараметры_Значения Цикл
			
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений = Истина Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаНастройки.Типовой = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйПараметр = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ГлобальныеПараметры_Пользовательские, КлючУникальности, СтрокаНастройки[КлючУникальности], Истина);
			Если НайденныйПараметр = Неопределено Тогда
				
				Если ИндексВставки = Неопределено Тогда
					Если ГлобальныеПараметры_Пользовательские[0].Свойство("ЭтоТаблицаЗначений") 
						И ГлобальныеПараметры_Пользовательские[0].ЭтоТаблицаЗначений = Истина Тогда
						ИндексВставки = 1;
					Иначе
						ИндексВставки = 0;
					КонецЕсли;
				КонецЕсли;
				
				ГлобальныеПараметры_Пользовательские.Вставить(ИндексВставки, ЛокЯдро_СкопироватьСтруктуру(СтрокаНастройки));
				ИндексВставки = ИндексВставки + 1;
			Иначе
				Если ОбновитьГПГлавногоУзла Тогда
					ЗаполнитьЗначенияСвойств(ГлобальныеПараметры_Пользовательские[НайденныйПараметр], СтрокаНастройки);
				Иначе
					ЗаполнитьЗначенияСвойств(СтрокаНастройки, ГлобальныеПараметры_Пользовательские[НайденныйПараметр]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЗначенияИмпорт.Вставить("ГлобальныеПараметры_Пользовательские", ГлобальныеПараметры_Пользовательские);
		
	КонецЕсли;
	
	// Удаляем настройки ПоУмолчанию, т.к они не могут быть импортированы
	Для каждого ЗначениеНастройки Из ЗначенияИмпорт Цикл
		Если Найти(ЗначениеНастройки.Ключ, "_ПоУмолчанию") Тогда
			ЗначенияИмпорт.Удалить(ЗначениеНастройки.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Проверяет наличие пользовательской строки в значениях SMARTS
//  Если строка не найдена, то добавляет строку настройки в пользовательское значение.
//  Например. Разбирает ГлобальныеПараметры_Значения и добавляет строки в ГлобальныеПараметры_Пользовательские, если есть новый ГП
//  Разбирает НастройкиОбменаСправочников_Узлы и добавляет строки в НастройкиОбменаСправочников – т.к добавление справочников доступно только в главном узле
//
// Параметры:
//  ПараметрыВыполнения	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек(ПараметрыВыполнения)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ЗаполнитьПользовательскиеСтрокиНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения",
		ПараметрыВыполнения);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ЗначенияИмпорт 					= ПараметрыВыполнения.ЗначенияИмпорт;
	ЗначенияSMARTS 					= ПараметрыВыполнения.ЗначенияSMARTS;
	ИмяНастройкиИсточник 			= ПараметрыВыполнения.ИмяНастройкиИсточник;
	ИмяНастройкиИсточникБезУзла 	= СтрЗаменить(ИмяНастройкиИсточник, "_Узлы", "");
	ИмяНастройкиПриемник 			= ПараметрыВыполнения.ИмяНастройкиПриемник;
	ЗначенияДляСтрокиПриемника	= Неопределено;
	ПараметрыВыполнения.Свойство("ЗначенияДляСтрокиПриемника", ЗначенияДляСтрокиПриемника);
	
	ЗначениеИмпортИсточник = Неопределено;
	ЗначенияИмпорт.Свойство(ИмяНастройкиИсточник, ЗначениеИмпортИсточник);
	Если ЗначениеЗаполнено(ЗначениеИмпортИсточник) И НЕ ЗначениеИмпортИсточник = Ложь Тогда
		
		НастройкаИзменена = Ложь;
		
		// Поиск приемника, если он ранее был заполнен
		ЗначениеИмпортПриемник = Неопределено;
		ЗначенияИмпорт.Свойство(ИмяНастройкиПриемник, ЗначениеИмпортПриемник);
		Если НЕ ЗначениеЗаполнено(ЗначениеИмпортПриемник) ИЛИ ЗначениеИмпортПриемник = Ложь Тогда
			ЗначениеИмпортПриемник = Новый Массив;
		КонецЕсли;
		
		ЗначениеSMARTS = Неопределено;
		ЗначенияSMARTS.Свойство(ИмяНастройкиИсточникБезУзла, ЗначениеSMARTS);
		Если НЕ ЗначениеЗаполнено(ЗначениеSMARTS) ИЛИ ЗначениеSMARTS = Ложь Тогда
			ЗначениеSMARTS = Неопределено;
		КонецЕсли;
		
		// Для универсальности. Работа с узловыми и обычными настройками.
		Если ИмяНастройкиИсточник <> ИмяНастройкиИсточникБезУзла Тогда
			ЗначенияПоУзлам = ЗначениеИмпортИсточник;
		Иначе
			ЗначенияПоУзлам = Новый Структура("ГлавныйУзел", ЗначениеИмпортИсточник);
		КонецЕсли;
		
		КлючУникальности = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройкиИсточникБезУзла);
		ИндексВставки = Неопределено;
		
		// Цикл по узлам и их значениям
		Для каждого ЗначениеУзла Из ЗначенияПоУзлам Цикл
			Для каждого СтрокаНастройки Из ЗначениеУзла.Значение Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				//сделать добавление значений из ГлобальныеПараметры_Значения в ГлобальныеПараметры_Пользовательские
				// пользовательские ГП главного узла нужно обновлять в двух ключах
				
				// Т.к приемник не является узловой настройкой (общая для всех), то ищем текущую строку в приемнике
				// Возможно ранее в приемник была добавлена строка - пропускаем
				ПоискСтроки = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеИмпортПриемник, КлючУникальности, СтрокаНастройки[КлючУникальности]);	
				Если ПоискСтроки <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				// Поиск в значение SMARTS
				ПоискСтроки = Неопределено;
				Если ЗначениеSMARTS <> Неопределено Тогда
					ПоискСтроки = ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ЗначениеSMARTS, КлючУникальности, СтрокаНастройки[КлючУникальности]);	
				КонецЕсли;
				
				// Если не нашли в SMARTS, значит текущая строка новая и необходимо добавить как не типовая
				Если ПоискСтроки = Неопределено Тогда
					пСтрокаНастройки = ЛокЯдро_СкопироватьСтруктуру(СтрокаНастройки);
					Если ЗначенияДляСтрокиПриемника <> Неопределено Тогда
						// Заполняем доп поля созданной строки
						// Например: Типовой, ЭтоТиповойБизнесПроцесс
						ЗаполнитьЗначенияСвойств(пСтрокаНастройки, ЗначенияДляСтрокиПриемника);
					КонецЕсли;
					
					// Добавляем описание таблицы. Не везде она нужна, но и нет списка где она нужна, поэтому добавляем везде.
					Если НЕ ЗначениеИмпортПриемник.Количество() Тогда
						ЗначениеИмпортПриемник.Добавить(ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(пСтрокаНастройки));
						ИндексВставки = 1;
					КонецЕсли;
					
					// Т.к значение является типовым (в файле импорта) то вставляем их в начало
					// Чтобы получился след порядок при просмотре: 
					//	1 - Типовые в тек. базе (типовые)
					//	2 - Пользовательские в тек. базе (пользовательские)
					//	3 - Типовые из файла (теперь они пользовательские)
					//	4 - Пользовательские из файла (пользовательские)
					Если ИндексВставки = Неопределено Тогда
						Если ЗначениеИмпортПриемник[0].Свойство("ЭтоТаблицаЗначений") 
							И ЗначениеИмпортПриемник[0].ЭтоТаблицаЗначений = Истина Тогда
							ИндексВставки = 1;
						Иначе
							ИндексВставки = 0;
						КонецЕсли;
					КонецЕсли;
					
					ЗначениеИмпортПриемник.Вставить(ИндексВставки, пСтрокаНастройки);
					ИндексВставки = ИндексВставки + 1;
					НастройкаИзменена = Истина;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если НастройкаИзменена Тогда
			ЗначенияИмпорт.Вставить(ИмяНастройкиПриемник, ЗначениеИмпортПриемник);
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Процедура - Лок ядро обмен настройками объединить значения настроек
//
// Параметры:
//  ЗначенияSMARTS			 - 	 - 
//  ЗначенияИмпорт			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ОбъединитьЗначенияНастроек(ЗначенияSMARTS, ЗначенияИмпорт, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ОбъединитьЗначенияНастроек";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"ЗначенияSMARTS,ЗначенияИмпорт,ДополнительныеПараметры",
		ЗначенияSMARTS, ЗначенияИмпорт, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Для каждого Настройка Из ЗначенияИмпорт Цикл
		
		ИмяНастройки = Настройка.Ключ;
		ИмяНастройкиБезУзла = СтрЗаменить(ИмяНастройки, "_Узлы", "");
		
		ЗначениеИмпорт = Настройка.Значение;
		ЗначениеSMARTS = Неопределено;
		ЗначенияSMARTS.Свойство(ИмяНастройки, ЗначениеSMARTS);
			
		КлючиОтбора = ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройкиБезУзла);
		
		Если КлючиОтбора <> ""
			И ЗначениеЗаполнено(ЗначениеSMARTS)
			И НЕ ЗначениеSMARTS = Ложь Тогда
			
			Если ИмяНастройки <> ИмяНастройкиБезУзла Тогда
				Для каждого Настройка Из ЗначениеИмпорт Цикл
					
					ИдУзла = Настройка.Ключ;
					ЗначениеУзлаИмпорт = Настройка.Значение;
					
					ЗначениеУзлаSMARTS = Неопределено;
					ЗначениеSMARTS.Свойство(ИдУзла, ЗначениеУзлаSMARTS);
					
					Если ЗначениеЗаполнено(ЗначениеУзлаSMARTS) И НЕ ЗначениеУзлаSMARTS = Ложь Тогда
						НовоеЗначение = ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЗначениеУзлаSMARTS, ЗначениеУзлаИмпорт, КлючиОтбора);
						ЗначениеИмпорт.Вставить(ИдУзла, НовоеЗначение);
					КонецЕсли;
					
				КонецЦикла;
			Иначе
				НовоеЗначение = ЛокЯдро_ВыполнитьПолноеСоединениеМассивов(ЗначениеSMARTS, ЗначениеИмпорт, КлючиОтбора);
				ЗначенияИмпорт.Вставить(ИмяНастройки, НовоеЗначение);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Процедура - Лок ядро обмен настройками сохранить настройки на сервер SMARTS
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_СохранитьНастройкиНаСерверSMARTS(СтруктураНастроек, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_СохранитьНастройкиНаСерверSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ДополнительныеПараметры",
		СтруктураНастроек, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("Узлы") Тогда
		ЛокЯдро_СохранитьНастройкуВБазеSMARTS("Узлы", СтруктураНастроек.Узлы);
		ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", СтруктураНастроек.Узлы);
	КонецЕсли;
	
	// Узловые настройки сохраняем пакетами
	НастройкиПоУзлам = Новый Соответствие;
	
	НастройкиКСохранению = Новый Структура;
	Для каждого Настройка Из СтруктураНастроек Цикл
		ИмяНастройки = Настройка.Ключ;
		ИмяНастройкиБезУзла = СтрЗаменить(ИмяНастройки, "_Узлы", "");
		ЗначениеНастройки = Настройка.Значение;
		
		Если ИмяНастройки <> ИмяНастройкиБезУзла Тогда
			
			Для каждого КлючЗначение Из ЗначениеНастройки Цикл
				
				Если ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Онлайн"
					ИЛИ ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Интерактивный" 
					ИЛИ ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Автообмен" Тогда
					РежимОбмена = СтрЗаменить(ИмяНастройкиБезУзла, "НастройкиОтборовСправочников_", "");
					ЛокЯдро_СохранитьНастройкиОтборовСправочников(РежимОбмена, КлючЗначение.Значение, КлючЗначение.Ключ);
					Продолжить;
				КонецЕсли;
				
				НастройкиУзла = НастройкиПоУзлам.Получить(КлючЗначение.Ключ);
				Если НастройкиУзла = Неопределено Тогда
					НастройкиУзла = Новый Структура;
					НастройкиПоУзлам.Вставить(КлючЗначение.Ключ, НастройкиУзла);
				КонецЕсли;
				
				НастройкиУзла.Вставить(ИмяНастройкиБезУзла, КлючЗначение.Значение);
				
			КонецЦикла;
			
		ИначеЕсли ИмяНастройки = "НастройкиНоменклатуры" Тогда
			Для каждого КлючЗначение Из ЗначениеНастройки Цикл
				НастройкиКСохранению.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		ИначеЕсли (ИмяНастройки = "НастройкиБизнесПроцессов_Пользовательские" ИЛИ ИмяНастройки = "НастройкиБизнесПроцессов_ПользовательскиеНастройки") 
			И ТипЗнч(ЗначениеНастройки) <> Тип("Структура") Тогда
			ЗначениеНастройки = ЛокЯдро_СкомпоноватьСтруктуруНастроекДляСохранения(ЗначениеНастройки, ЛокЯдро_ПолучитьВерсиюСтруктурыНастроекОбработки());
			НастройкиКСохранению.Вставить(ИмяНастройки, ЗначениеНастройки);
		Иначе
			НастройкиКСохранению.Вставить(ИмяНастройки, ЗначениеНастройки);
		КонецЕсли;
		
	КонецЦикла;
	
	// Обновление структуры настроек
	ВерсияОбработки =ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработки");		
	Если НастройкиКСохранению.Свойство("ВерсияОбработкиНастроек") Тогда
		ВерсияОбработкиНастроек = НастройкиКСохранению.ВерсияОбработкиНастроек;
	Иначе
		ВерсияОбработкиНастроек = 0;		
	КонецЕсли;  
	Если ВерсияОбработки>ВерсияОбработкиНастроек Тогда
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "ВыполнитьОбновлениеНастроек");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ВерсияНастроек,СтруктураНастроек", ВерсияОбработкиНастроек, НастройкиКСохранению));
		
		НастройкиКСохранению = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, АдресаПеременных);		
	КонецЕсли;
	
	// Сохранение в базу SMARTS
	Если НастройкиКСохранению.Свойство("Пользователи") Тогда
		ЗначениеИмпорт = НастройкиКСохранению.Пользователи;
		
		// TODO: Сделать загрузку пользователей без цикла, одним запросом
		Если ЗначениеЗаполнено(ЗначениеИмпорт) И НЕ ЗначениеИмпорт = Ложь Тогда
			Для каждого СтрокаПользователя Из ЗначениеИмпорт Цикл
				Если СтрокаПользователя.Свойство("ЭтоТаблицаЗначений") И СтрокаПользователя.ЭтоТаблицаЗначений = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыПользователя = Новый Соответствие;
				ПараметрыПользователя.Вставить("id", 			СтрокаПользователя.Ид);
				ПараметрыПользователя.Вставить("name", 			СтрокаПользователя.Имя);		
				ПараметрыПользователя.Вставить("description", 	СтрокаПользователя.Описание);		
				ПараметрыПользователя.Вставить("password", 		СтрокаПользователя.Пароль);			
				ПараметрыПользователя.Вставить("barcode", 		СтрокаПользователя.Штрихкод);		
				ПараметрыПользователя.Вставить("groupId", 		СтрокаПользователя.ИдГруппы);		
				ПараметрыПользователя.Вставить("groupName", 	СтрокаПользователя.ИмяГруппы);		
				ПараметрыПользователя.Вставить("warehouseIds",  СтрокаПользователя.ИдСкладов.ВыгрузитьЗначения());				
				
				ЗагрузкаПользователя = ЛокЯдро_ЗагрузитьПользователейВSMARTS(ПараметрыПользователя);    
				
			КонецЦикла;
		КонецЕсли;
		НастройкиКСохранению.Удалить("Пользователи");
	КонецЕсли;
	
	Если НастройкиКСохранению.Свойство("ГруппыПользователей") Тогда
		ЗначениеИмпорт = НастройкиКСохранению.ГруппыПользователей;
		
		// TODO: Сделать загрузку пользователей без цикла, одним запросом
		Если ЗначениеЗаполнено(ЗначениеИмпорт) И НЕ ЗначениеИмпорт = Ложь Тогда
			Для каждого СтрокаГруппы Из ЗначениеИмпорт Цикл
				Если СтрокаГруппы.Свойство("ЭтоТаблицаЗначений") И СтрокаГруппы.ЭтоТаблицаЗначений = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыГруппы = Новый Соответствие;
				ПараметрыГруппы.Вставить("id", 							СтрокаГруппы.Ид);
				ПараметрыГруппы.Вставить("name", 						СтрокаГруппы.Имя);
				ПараметрыГруппы.Вставить("documentTypeNames", 			СтрокаГруппы.ТипыДокументов);
				
				// Типы документов для ком-режима
				ПараметрыГруппы.Вставить("batchMode", 					Ложь);
				ПараметрыГруппы.Вставить("role", 						СтрокаГруппы.Роль);
				ПараметрыГруппы.Вставить("serverSideInventory", 		Ложь);
				ПараметрыГруппы.Вставить("autorunDocumentTypeName", 	"");
				//ПараметрыГруппы.Вставить("onStartHandlerName", 		"При начале работы пользователя");
				//ПараметрыГруппы.Вставить("onFinishHandlerName", 		"При завершении работы пользователя");
				
				РезультатЗагрузки = ЛокЯдро_ЗагрузитьГруппыПользователейВSMARTS(ПараметрыГруппы);
				
			КонецЦикла;
		КонецЕсли;
		НастройкиКСохранению.Удалить("ГруппыПользователей");
	КонецЕсли;
	
	пДополнительныеПараметры = Новый Структура;
	пДополнительныеПараметры.Вставить("НеКэшировать", Истина);
	
	Если НастройкиКСохранению.Количество() Тогда
		ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению,, пДополнительныеПараметры);
	КонецЕсли;
	
	Если НастройкиПоУзлам.Количество() Тогда
		Для каждого НастройкиУзла Из НастройкиПоУзлам Цикл
			ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиУзла.Значение, НастройкиУзла.Ключ, пДополнительныеПараметры);
		КонецЦикла;
	КонецЕсли;
	
	ЛокЯдро_ОбменНастройками_ИнициализацияПослеСохраненияНастроекSMARTS(НастройкиКСохранению, ДополнительныеПараметры);

	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Процедура - Лок ядро обмен настройками инициализация после сохранения настроек SMARTS
//
// Параметры:
//  СтруктураНастроек		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ИнициализацияПослеСохраненияНастроекSMARTS(СтруктураНастроек, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ИнициализацияПослеСохраненияНастроекSMARTS";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,ДополнительныеПараметры",
		СтруктураНастроек, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ДополнительныеПараметры = ?(ДополнительныеПараметры = Неопределено, Новый Структура, ДополнительныеПараметры);
	ДополнительныеПараметры.Вставить("СтруктураНастроек", СтруктураНастроек);
	
	ПараметрыПодключенияMS = ПараметрыПодключенияMS;
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
		
	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторБазыMS) Тогда
		Сообщение = НСтр("ru = 'Не удалось определить идентификатор подключенной базы Клеверенс!';
							|en = 'The ID of the connected Cleverence database could not be determined!';
							|be = 'Не ўдалося вызначыць ідэнтыфікатар падключанай базы Cleverence!'; es = '¡No se pudo determinar el id de base de Cleverence conectada!'; ka = 'დაკავშირებული Cleverence მონაცემთა ბაზის ID ვერ განისაზღვრა!'; kk = 'Қосылған Cleverence базасының идентификаторын анықтау мүмкін болмады!'; ro = 'ID-ul bazei de date connected Cleverence nu a putut fi determinat!'; tr = 'Bağlı Cleverence veritabanının kimliği belirlenemedi!'; uk = 'Не вдалося визначити ідентифікатор підключеної бази Cleverence!'; uz = 'Ulangan Cleverence ma''lumotlar bazasi identifikatorini aniqlab bo''lmadi!'");
		Сообщить(Сообщение); 
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;		
	КонецЕсли;
	
	ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS);
	
	ИнициализацияВФоне = ДоступноВыполнениеВФоне И НЕ РасположениеКомпоненты = "НаКлиенте";
		
	ОписаниеОповещения = Неопределено;
	Если ИнициализацияВФоне Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЛокЯдро_ОбменНастройками_ИнициализацияЗавершение", ЭтаФорма, ДополнительныеПараметры);
	КонецЕсли;
	
	ЛокЯдро_Инициализация(ПараметрыПодключенияMS, ОписаниеОповещения);
	
	Если НЕ ИнициализацияВФоне Тогда
		ЛокЯдро_ОбменНастройками_ИнициализацияЗавершение(, ДополнительныеПараметры);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

// Процедура - Лок ядро обмен настройками инициализация завершение
//
// Параметры:
//  Результат				 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_ОбменНастройками_ИнициализацияЗавершение(Результат = Неопределено, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЛокЯдро_ОбменНастройками_ИнициализацияЗавершение";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если Результат = "ОшибкаИнициализации" Тогда
		
		// <Лог>
		ЛогЗавершитьСобытие(логСобытие);
		// </Лог>
		
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = ДополнительныеПараметры.СтруктураНастроек;
	
	Если СтруктураНастроек.Свойство("Узлы")
		ИЛИ СтруктураНастроек.Свойство("НастройкиБизнесПроцессов_Пользовательские") Тогда
		
		ТаблицаУзлов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
		
		Если ЗначениеЗаполнено(ТаблицаУзлов) И НЕ ТаблицаУзлов = Ложь Тогда	
			ЛокЯдро_ВыгрузитьТаблицуУзловСобытиеФормы(ТаблицаУзлов);	
		КонецЕсли;
		
		ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
		НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
		
		Если ЗначениеЗаполнено(НастройкиБизнесПроцессов) И НЕ НастройкиБизнесПроцессов = Ложь Тогда	
			ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ОповещениеОбработкиЗавершения") 
		И ДополнительныеПараметры.ОповещениеОбработкиЗавершения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОбработкиЗавершения, Истина);
	КонецЕсли;
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

// Процедура - Лок ядро создать узел
//
// Параметры:
//  НоваяСтрокаУзла			 - 	 - 
//  ID_УзлаОснование		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЛокЯдро_СоздатьУзел(НоваяСтрокаУзла = Неопределено, ID_УзлаОснование = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_СоздатьУзел";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"НоваяСтрокаУзла,ID_УзлаОснование,ДополнительныеПараметры",
		НоваяСтрокаУзла, ID_УзлаОснование, ДополнительныеПараметры);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	// Если ID_УзлаПриемник заполнено, то возможно настройки для узла уже частично существуют, 
	//	поэтому этот метод можно использовать только для дозаполнения недостающих настроек на основании главного узла.
	// Даже если узел еще не сохранен, то метод получит для него настройки на основе главного узла.
	УзелОснование = ?(НоваяСтрокаУзла <> Неопределено, НоваяСтрокаУзла.ID_Узла, ID_УзлаОснование);
	СтруктураНастроек = ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляКопированияУзла(УзелОснование,, ДополнительныеПараметры);
	
	Если СтруктураНастроек.Свойство("Узлы")
		И ТипЗнч(СтруктураНастроек.Узлы) = Тип("Массив") Тогда
		Узлы = СтруктураНастроек.Узлы;
	Иначе
		Узлы = Новый Массив;
		ОписаниеТаблицы = ЛокЯдро_ПолучитьОписаниеТаблицыЗначенийДляМассиваСтруктур(ЛокЯдро_СтруктураСтрокиНастроек_Узлы());
		Узлы.Добавить(ОписаниеТаблицы);
	КонецЕсли;
	
	// Формируем параметры нового узла
	Если НоваяСтрокаУзла = Неопределено Тогда
		
		НоваяСтрокаУзла = ЛокЯдро_СтруктураСтрокиНастроек_Узлы();
		ИмяНовогоУзла = "";
		ИменаУзлов = Новый Массив;
		
		// Формируем имя нового узла
		Узлы = СтруктураНастроек.Узлы;
		Для Каждого СтрокаУзла Из Узлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ID_УзлаОснование)
				И ID_УзлаОснование = СтрокаУзла.ID_Узла Тогда
				ИмяНовогоУзла = СтрокаУзла.Наименование;
				ЗаполнитьЗначенияСвойств(НоваяСтрокаУзла, СтрокаУзла);
				Прервать;
			КонецЕсли;
			
			ИменаУзлов.Добавить(СтрокаУзла.Наименование);
		КонецЦикла;
		
		Если ИмяНовогоУзла = "" Тогда
			ШаблонИмени = НСтр("ru = 'Торговый объект №%1';
								|en = 'Shopping facility no. %1'; be = 'Гандлёвы аб''ект № %1'; es = 'Objeto comercial no. %1'; ka = 'სავაჭრო ობიექტი no. %1'; kk = '№%1 сауда объектісі'; ro = 'Centru comercial nr. %1'; tr = 'Ticaret nesnesi No.%1'; uk = 'Торговий об''єкт № %1'; uz = '%1 savdo obyekti'");
		Иначе
			ШаблонИмени = НСтр("ru = '(Копия №%1) '");
		КонецЕсли;
		
		НомерУзлаПоУмолчанию = 1;		
		Пока (Истина) Цикл
			пИмя = ЛокЯдро_СтрШаблон(ШаблонИмени, НомерУзлаПоУмолчанию) + ИмяНовогоУзла;
			Если ИменаУзлов.Найти(пИмя) = Неопределено Тогда
				ИмяНовогоУзла = пИмя;
				Прервать;
			КонецЕсли;   
			НомерУзлаПоУмолчанию = НомерУзлаПоУмолчанию + 1;
		КонецЦикла;
			
		НоваяСтрокаУзла.Наименование = ИмяНовогоУзла;
		НоваяСтрокаУзла.НаименованиеДляПоиска = НРег(ИмяНовогоУзла);
		НоваяСтрокаУзла.ID_Узла 	= ЛокЯдро_ПолучитьНовыйID("ND");
		НоваяСтрокаУзла.Ид 			= НоваяСтрокаУзла.ID_Узла;
		НоваяСтрокаУзла.Код 		= НоваяСтрокаУзла.ID_Узла;
		НоваяСтрокаУзла.ШК 			= "";
		
	Иначе
		пНоваяСтрокаУзла = ЛокЯдро_СтруктураСтрокиНастроек_Узлы();
		ЗаполнитьЗначенияСвойств(пНоваяСтрокаУзла, НоваяСтрокаУзла);
		НоваяСтрокаУзла = пНоваяСтрокаУзла;
	КонецЕсли;
	
	// Сохраняем новый узел в базе
	Узлы.Добавить(НоваяСтрокаУзла);
	ЛокЯдро_СохранитьНастройкуВБазеSMARTS("Узлы", Узлы);
	ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", Узлы);
	ЛокЯдро_ВыгрузитьТаблицуУзловСобытиеФормы(Узлы);
	
	// Формируем структуру настроек для нового узла. 
	// Настройки будут получены из узла основания или главного узла, если настройки не все заполнены.
	НастройкиКСохранению = Новый Структура;
	Для каждого КлючЗначение Из СтруктураНастроек Цикл
		
		ИмяНастройки = КлючЗначение.Ключ;
		ИмяНастройкиБезУзла = СтрЗаменить(ИмяНастройки, "_Узлы", "");
		Если ИмяНастройки <> ИмяНастройкиБезУзла Тогда
			
			Если ЗначениеЗаполнено(ID_УзлаОснование) Тогда
				ЗначениеНастройки = КлючЗначение.Значение[ID_УзлаОснование];
			Иначе
				ЗначениеНастройки = КлючЗначение.Значение[НоваяСтрокаУзла.ID_Узла];
			КонецЕсли;
			
			Если ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Онлайн"
					ИЛИ ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Интерактивный" 
					ИЛИ ИмяНастройкиБезУзла = "НастройкиОтборовСправочников_Автообмен" Тогда
					
				РежимОбмена = СтрЗаменить(ИмяНастройкиБезУзла, "НастройкиОтборовСправочников_", "");
				ЛокЯдро_СохранитьНастройкиОтборовСправочников(РежимОбмена, ЗначениеНастройки, НоваяСтрокаУзла.ID_Узла);
				
			Иначе
				НастройкиКСохранению.Вставить(ИмяНастройкиБезУзла, ЗначениеНастройки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЛокЯдро_СохранитьНастройкиВБазеSMARTS(НастройкиКСохранению, НоваяСтрокаУзла.ID_Узла);
	
	НастройкиБизнесПроцессов = ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");
	ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
	ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
	
	// <Лог>
	ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

#КонецОбласти

#Область ЛокальныйКонтекст_Настройки_ВспомогательныеМеханизмы

// Осуществляет поиск в массиве структур по отбору
// 
// Параметры:
//	пМассив - Массив из Структура - массив структур, в котором осуществляется поиск
//	пОтбор - Структура - содержит параметры отбора
// 
// Возвращаемое значение:
// 	Неопределено, Массив из Структура - если значение не найдено, то возвращается Неопределено, иначе возвращается массив найденных значений
&НаКлиенте
Функция ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(пМассив, пОтбор, ВернутьПервоеЗначение = Ложь) Экспорт
	
	Если ТипЗнч(пМассив) <> Тип("Массив") 
		ИЛИ ТипЗнч(пОтбор) <> Тип("Структура") 
		ИЛИ пМассив.Количество() = 0
		ИЛИ ТипЗнч(пМассив[0]) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	МассивРезультат = Новый Массив;	
	Для Каждого пСтруктура Из пМассив Цикл
		Если пСтруктура.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Подходит = Истина;
		Для Каждого ЭлОтбора Из пОтбор Цикл
			Значение = Неопределено;
			Если НЕ пСтруктура.Свойство(ЭлОтбора.Ключ,Значение)
				ИЛИ Значение <> ЭлОтбора.Значение Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Подходит Тогда
			Если ВернутьПервоеЗначение Тогда
				Возврат пСтруктура;
			Иначе
				МассивРезультат.Добавить(пСтруктура);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если МассивРезультат.Количество() > 0 Тогда
		Возврат МассивРезультат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

// Преобразует значения из структуры настроек в строку или из строки в значения.
// Преобразуются только сериализуемые настройки. Сериализуемые берутся из параметра или из глобальных переменных
// 
// Параметры:
//	СтруктураНастроек - Структура - структура преобразовываемых настроек
//	Направление - Строка - направление преобразования "ИзСтроки" или "ВСтроку"
//	СериализуемыеНастройки - Массив из Строка, Неопределено - массив с именами настроек для преобразования 
//
// Возвращаемое значение:
//	Структура - структура преобразованных настроек
&НаКлиенте
Функция ЛокЯдро_КонвертироватьСериализуемыеНастройки(СтруктураНастроек, Направление, СериализуемыеНастройки = Неопределено) Экспорт
	
	ИмяСобытия = "ЛокЯдро_КонвертироватьСериализуемыеНастройки";
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,,
		"СтруктураНастроек,Направление,СериализуемыеНастройки",
		СтруктураНастроек, Направление, СериализуемыеНастройки);
		
	логСобытие = ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если СериализуемыеНастройки = Неопределено Тогда
		СериализуемыеНастройки = КатегорииНастроекMS.СериализуемыеНастройки;
	КонецЕсли;
	
	Для Каждого Настройка Из СтруктураНастроек Цикл
		Если НЕ Настройка.Значение = Ложь И СериализуемыеНастройки.Найти(Настройка.Ключ) <> Неопределено Тогда
			
			пСообщение = НСтр("ru = 'Начало, %1, %2';
								|en = 'Start, %1, %2'; be = 'Пачатак, %1, %2'; es = 'Inicio, %1, %2'; ka = 'დაწყება, %1, %2'; kk = 'Басталуы, %1, %2'; ro = 'Start, %1, %2'; tr = 'Başlangıç, %1, %2'; uk = 'Початок, %1, %2'; uz = 'Boshlanish, %1, %2'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, Направление, СокрЛП(Настройка.Ключ));
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_КонвертироватьСериализуемыеНастройки", "Информация", пСообщение, НачалоСобытия);
			ЗначениеНастройки = Настройка.Значение;
			Если Направление = "ИзСтроки" Тогда
				ЗначениеНастройки = ЛокЯдро_ЗначениеИзСтрокиXML(ЗначениеНастройки,Истина);
			ИначеЕсли Направление = "ВСтроку" Тогда	
				ЗначениеНастройки = ЛокЯдро_ЗначениеВСтрокуXML(ЗначениеНастройки);
			КонецЕсли;
			СтруктураНастроек.Вставить(Настройка.Ключ, ЗначениеНастройки);
			пСообщение = НСтр("ru = 'Конец, %1, %2';
								|en = 'End, %1, %2'; be = 'Канец, %1, %2'; es = 'Fin, %1, %2'; ka = 'დასასრული, %1, %2'; kk = 'Соңы, %1, %2'; ro = 'Sfârșit, %1, %2'; tr = 'Son, %1, %2'; uk = 'Кінець, %1, %2'; uz = 'Tugatish, %1, %2'");
			пСообщение = ЛокЯдро_СтрШаблон(пСообщение, Направление, СокрЛП(Настройка.Ключ));
			ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_КонвертироватьСериализуемыеНастройки", "Информация", пСообщение, НачалоСобытия);
			
		КонецЕсли;
	КонецЦикла;
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СтруктураНастроек);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СтруктураНастроек;
	
КонецФункции

// Получает список доступных реквизитов для формирования представлений документов, выгружаемых в базу Клеверенс
// 
// Параметры:
//	ИмяДокумента1С - Строка - название документа 1С
//
// Возвращаемое значение:
//	СписокЗначений - список реквизитов документа
&НаКлиенте
Функция ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента(ИмяДокумента1С = Неопределено) Экспорт
	
	// Список реквизитов по умолчанию для всех конфигураций 	
	СписокРекв = Новый СписокЗначений;
	Если ИмяДокумента1С = Неопределено Тогда // Временное решение. Если не указано имя документа, то значит запрос пришел от формы обмена 
		СписокРекв.Добавить("Ссылка", НСтр("ru = 'Название';
											|en = 'Title'; be = 'Назва'; es = 'Nombre'; ka = 'დასახელება'; kk = 'Атауы'; ro = 'Titlu'; tr = 'Ad'; uk = 'Назва'; uz = 'Nomi'"));
		СписокРекв.Добавить("Количество", НСтр("ru = 'Количество строк';
												|en = 'Number of rows'; be = 'Колькасць радкоў'; es = 'Número de filas'; ka = 'რიგების რაოდენობა'; kk = 'Жолдар саны'; ro = 'Numărul de rânduri'; tr = 'Satır sayısı'; uk = 'Кількість рядків'; uz = 'Qatorlar soni'"));
		СписокРекв.Добавить("БизнесПроцесс", НСтр("ru = 'Бизнес процесс';
													|en = 'Business process'; be = 'Бізнес працэс'; es = 'Proceso de negocio'; ka = 'ბიზნეს პროცესი'; kk = 'Бизнес процесс'; ro = 'Procesul de afaceri'; tr = 'İş süreci'; uk = 'Бізнес процес'; uz = 'Biznes jarayoni'"));
	Иначе
		СписокРекв.Добавить("Ссылка", НСтр("ru = 'Ссылка';
											|en = 'Link'; be = 'Спасылка'; es = 'Referencia'; ka = 'ბმული'; kk = 'Сілтеме'; ro = 'Legătura'; tr = 'Atıf'; uk = 'Посилання'; uz = 'Havola'"));
		СписокРекв.Добавить("Количество", НСтр("ru = 'Количество';
												|en = 'Quantity'; be = 'Колькасць'; es = 'Cantidad'; ka = 'რაოდენობა'; kk = 'Саны'; ro = 'Cantitate'; tr = 'Sayı'; uk = 'Кількість'; uz = 'Miqdori'"));	
	КонецЕсли;
	
	СписокРекв.Добавить("Дата", НСтр("ru = 'Дата';
										|en = 'Date'; be = 'Дата'; es = 'Fecha'; ka = 'თარიღი'; kk = 'Күні'; ro = 'Data'; tr = 'Tarih'; uk = 'Дата'; uz = 'Sana'"));
	СписокРекв.Добавить("Номер", НСтр("ru = 'Номер';
										|en = 'Number'; be = 'Нумар'; es = 'Habitación'; ka = 'ნომერი'; kk = 'Нөмірі'; ro = 'Număr'; tr = 'Numara'; uk = 'Номер'; uz = 'Raqam'"));
	 	
	// дополнительные реквизиты, настроенные для подключенной конфигурации
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьДопРеквизитыПредставленияДокумента");
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяДокумента1С", ИмяДокумента1С);
	СтруктураВызова.Вставить("ПараметрыМетода", ПараметрыМетода);
	
	СписокДопРеквизитов = Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,,АдресаПеременных);
	Если СписокДопРеквизитов <> Неопределено Тогда
		Для Каждого ДопРеквизит из СписокДопРеквизитов Цикл
			СписокРекв.Добавить(ДопРеквизит.Значение, ДопРеквизит.Представление);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокРекв;
	
КонецФункции

// Получает список доступных реквизитов для формирования таблицы документов Клеверенс
// 
// Возвращаемое значение:
//	Массив - массив реквизитов документа
&НаКлиенте
Функция ЛокЯдро_ПолучитьМассивКолонокТаблицыДокументовSMARTS() Экспорт
	
	ИмяСобытия = "ЛокЯдро_ПолучитьМассивКолонокТаблицыДокументовSMARTS";
	
	// <Лог>
	логСобытие = ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	СписокРеквизитов = Новый СписокЗначений;
	
	ВычисляемыеПоля = ЛокЯдро_ПредопределенныеЗначения("ВычисляемыеПоляШапкиДокументаMS", "СтрокиПланКоличество, СтрокиФактКоличество, Состояние");
	
	Для каждого КЗ Из ВычисляемыеПоля Цикл
		СписокРеквизитов.Добавить(КЗ.Ключ, КЗ.Значение.Представление);
	КонецЦикла;
	
	#Если Не ВебКлиент Тогда
		// В документах могут быть реквизиты с одним названием, отличающимся регистром одной буквы, такие дубли надо исключать
		РеквизитыВВерхРегистре = Новый Соответствие;		
		Для Каждого СтрокаРеквизит Из СписокРеквизитов Цикл
			РеквизитыВВерхРегистре.Вставить(ВРег(СтрокаРеквизит.Значение),СтрокаРеквизит.Значение);	
		КонецЦикла;
		
		// Дополняем существующую таблицу реквизитами шапки всех доступных типов документов
		СтруктураДоступныхДокументов = СтруктураМетаданных.ДокументыMS;
		Для Каждого ТипДокумента Из СтруктураДоступныхДокументов Цикл
			МассивРеквизитов = ТипДокумента.Значение.Реквизиты;
			Для Каждого СтрокаРеквизит Из МассивРеквизитов Цикл
				Если Не СписокРеквизитов.НайтиПоЗначению(СтрокаРеквизит.Значение) = Неопределено 
					Или Не РеквизитыВВерхРегистре.Получить(ВРег(СтрокаРеквизит.Значение)) = Неопределено Тогда
					Продолжить;
				КонецЕсли;				
				СписокРеквизитов.Добавить(СтрокаРеквизит.Значение, СтрокаРеквизит.Ключ);
				РеквизитыВВерхРегистре.Вставить(ВРег(СтрокаРеквизит.Значение),СтрокаРеквизит.Значение);
			КонецЦикла;		
			
		КонецЦикла;
	#КонецЕсли
	
	#Если ВебКлиент Тогда
		СписокРеквизитов.Добавить("ДатаСоздания", 				"Дата создания");
		СписокРеквизитов.Добавить("Имя", 						"Наименование");
		СписокРеквизитов.Добавить("ИмяПользователя", 			"Имя пользователя");
		СписокРеквизитов.Добавить("ИмяТипаДокумента", 			"Имя типа документа");
		СписокРеквизитов.Добавить("ДатаЗавершения", 			"Дата завершения");
		СписокРеквизитов.Добавить("ИмяБП", 						"Имя бизнес-процесса");
		СписокРеквизитов.Добавить("КонтрольКоличества", 		"Контроль количества");
		СписокРеквизитов.Добавить("ЕстьНедобор", 				"Есть недобор");
		СписокРеквизитов.Добавить("ЕстьПереполнение", 			"Есть переполнение");
		СписокРеквизитов.Добавить("ЕстьПереполнениеИлиНедобор", "Есть переполнение или недобор");
		СписокРеквизитов.Добавить("СозданНаТСД", 				"Создан на ТСД");
		СписокРеквизитов.Добавить("Ид", 						"Ид");
		СписокРеквизитов.Добавить("НастройкаБизнесПроцесса", 	"Настройка бизнес-процесса");
		СписокРеквизитов.Добавить("ИдИсходныхДокументов", 		"Ид исходных документов");
		СписокРеквизитов.Добавить("ИдУзла", 					"ИдУзла");	
	#КонецЕсли
	
	// <Лог>
	логКонтекст = ЛогОписатьКонтекст(ИмяСобытия,, "", СписокРеквизитов);
	ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат СписокРеквизитов;
	
КонецФункции

