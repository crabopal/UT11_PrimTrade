&НаКлиенте
Процедура ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(ЭлементКнопки) Экспорт
	
	ТипПродукта = "Клеверенс";
	Если ПараметрыПодключенияMS <> Неопределено
		И ПараметрыПодключенияMS.Свойство("ТипУстановленногоПродукта")
		И ЗначениеЗаполнено(ПараметрыПодключенияMS.ТипУстановленногоПродукта) Тогда
		ТипПродукта = ПараметрыПодключенияMS.ТипУстановленногоПродукта;
	КонецЕсли;
	
	ЭлементКнопки.ЦветФона 		= ЛокЯдро_Оформление_ПолучитьЦветПродукта(ТипПродукта);
	ЭлементКнопки.ЦветТекста 	= Новый Цвет(255, 255, 255);
	ЭлементКнопки.Шрифт 		= Новый Шрифт(,,Истина);
	
КонецПроцедуры

&НаКлиенте
Функция ЛокЯдро_Оформление_ПолучитьЦветПродукта(ТипПродукта) Экспорт
	
	Если ТипПродукта = "Склад" Тогда
		Цвет = Новый Цвет(255, 113, 1);
		
	ИначеЕсли ТипПродукта = "Магазин" Тогда
		Цвет = Новый Цвет(234, 11, 63);
		
	ИначеЕсли ТипПродукта = "Прайсчекер" Тогда
		Цвет = Новый Цвет(234, 11, 63); // Цвета от магазина
		
	ИначеЕсли ТипПродукта = "Фабрика" Тогда
		Цвет = Новый Цвет(35, 78, 39);
		
	ИначеЕсли ТипПродукта = "Учет" Тогда
		Цвет = Новый Цвет(154, 50, 105);
		
	ИначеЕсли ТипПродукта = "УчетИмущества" Тогда
		Цвет = Новый Цвет(37, 142, 227);
		
	ИначеЕсли ТипПродукта = "Курьер" Тогда
		Цвет = Новый Цвет(64, 135, 96);
		
	ИначеЕсли ТипПродукта = "Кировка" Тогда
		Цвет = Новый Цвет(201, 145, 0);
		
	ИначеЕсли ТипПродукта = "Клеверенс" Тогда
		//Цвет = Новый Цвет(224, 53, 45);		// Красный из лого клеверенса
		Цвет = Новый Цвет(255, 113, 1); 		// Вместо клеверенса используем цвет склада
	Иначе
		//Цвет = Новый Цвет(224, 53, 45);		// Красный из лого клеверенса
		Цвет = Новый Цвет(255, 113, 1); 		// Вместо клеверенса используем цвет склада
	КонецЕсли;
	
	Возврат Цвет;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_Оформление_ПолучитьФирменныйЦвет(Название) Экспорт
	
	// Фирменные
	Если Название = "Акцентирование" 
		ИЛИ Название = "Ссылка" Тогда
		Цвет = Новый Цвет(56, 88, 201);			// Цвет акцентов синий		#3858C9
		
	ИначеЕсли Название = "АкцентПодложка" Тогда
		Цвет = Новый Цвет(235, 240, 255);		// Голубая подложка 		#EBF0FF
		
		
	// Тексты
	ИначеЕсли Название = "ОсновнойТекст" Тогда
		Цвет = Новый Цвет(51, 51, 51);			// Обычный черный текст			#333333
		
	ИначеЕсли Название = "ВторичныйТекст" Тогда
		Цвет = Новый Цвет(128, 128, 128);		// Вторичное описание			#808080
		
	ИначеЕсли Название = "НедоступныеДанные" Тогда
		Цвет = Новый Цвет(150, 150, 150);		// Текст недоступных данных		#969696
		
		
	// Заголовки
	ИначеЕсли Название = "ПервичныйЗаголовок" Тогда
		Цвет = Новый Цвет(6, 25, 94);			// Первичный заголовок			#06195E
		
	ИначеЕсли Название = "ВторичныйЗаголовок" Тогда
		Цвет = Новый Цвет(123, 124, 133);		// Вторичный заголовок			#7B7C85
		
		
	// Состояния статусов
	ИначеЕсли Название = "Ошибка" Тогда
		Цвет = Новый Цвет(224, 53, 45);			// Красный текст из лого		#E0352D
		
	ИначеЕсли Название = "Примечание" Тогда
		Цвет = Новый Цвет(255, 136, 0);			// Желтый текст					#FF8800
		
	ИначеЕсли Название = "Успех" Тогда
		Цвет = Новый Цвет(0, 150, 70);			// Зеленый текст				#009646
		
		
	// Подложки, плитки
	ИначеЕсли Название = "СерыйСветлый" Тогда
		Цвет = Новый Цвет(246, 246, 246);		// Серая подложка				#F6F6F6
		
	ИначеЕсли Название = "СерыйТемный" Тогда
		Цвет = Новый Цвет(123, 124, 133);		// Серый текст на подложке		#7B7C85
	
	ИначеЕсли Название = "КрасныйСветлый" Тогда
		Цвет = Новый Цвет(255, 195, 195);		// Красная подложка				#FFC3C3
		
	ИначеЕсли Название = "КрасныйТемный" Тогда
		Цвет = Новый Цвет(121, 53, 41);			// Красный текст на подложке 	#793529
		
	ИначеЕсли Название = "ЖелтыйСветлый" Тогда
		Цвет = Новый Цвет(255, 243, 195);		// Желтая подложка				#FFF3C3
		
	ИначеЕсли Название = "ЖелтыйТемный" Тогда
		Цвет = Новый Цвет(121, 100, 41);		// Желтый текст на подложке		#796429
		
	ИначеЕсли Название = "ЗеленыйСветлый" Тогда
		Цвет = Новый Цвет(195, 255, 195);		// Зеленая подложка				#C3FFC3
		
	ИначеЕсли Название = "ЗеленыйТемный" Тогда
		Цвет = Новый Цвет(41, 121, 44);			// Зеленый текст на подложке 	#29792C
		
		
	// Остальное
	Иначе
		Цвет = Новый Цвет(51, 51, 51);			// По умолчанию					#333333
		
	КонецЕсли;
	
	Возврат Цвет;
	
КонецФункции

&НаКлиенте
Функция ЛокЯдро_Оформление_ПолучитьВнешнююКартинку(ИмяКартинки, ВозвращатьНеопределено = Ложь) Экспорт
	
	// Возвращаем картинку заглушку, так-как тип "Картинка" не может принять "Неопределено"
	Картинка = ?(ВозвращатьНеопределено, Неопределено, БиблиотекаКартинок.УсловноеОформлениеКомпоновкиДанныхНедоступное);
	Если ВладелецФормы = Неопределено Тогда
		Возврат Картинка;
	КонецЕсли;
	
	// Владельцем формы должна быть ГлавнаяФорма, все картинки хранятся в ней
	ИмяЭлемента = "Картинка" + СтрЗаменить(ИмяКартинки, "Картинка", "");
	
	Если ВладелецФормы.Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат ВладелецФормы.Элементы[ИмяЭлемента].Картинка;
	КонецЕсли;
	
	Возврат Картинка;
	
КонецФункции

