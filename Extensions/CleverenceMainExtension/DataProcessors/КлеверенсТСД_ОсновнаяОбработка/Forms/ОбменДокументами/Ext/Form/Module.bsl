&НаКлиенте
Функция КоличествоДокументовПревышаетРазмерВыборки()
	
	Если ВыборкаДокументов1СБезОграничений Тогда
		Возврат Ложь;		
	КонецЕсли;
	
	КоличествоДокументов = Новый Соответствие;
	
	Для каждого Строка Из Документы1С Цикл
		
		Ключ = ?(Строка.НастройкаБизнесПроцесса = "", Строка.ТипДокумента1С, Строка.НастройкаБизнесПроцесса);
		СоответствиеКоличества = КоличествоДокументов.Получить(Ключ);
		
		Если СоответствиеКоличества = Неопределено Тогда
			КоличествоДокументов.Вставить(Ключ, 1);
		Иначе
			КоличествоДокументов[Ключ] = СоответствиеКоличества + 1;
			Если СоответствиеКоличества + 1 = КоличествоДокументовНаФорме Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

