/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере".

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)            
	КоличествоДокументовНаФорме = 50;
	
	ID_Узла = ЭтаФорма.ID_Узла;
	ID_БазыMS = ЭтаФорма.ID_БазыMS;
	// Запоминаем текущий узел на случай, если при загрузке документа придется временно переключаться на другой узел
	ID_ТекущегоУзла = ЭтаФорма.ID_Узла;
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;		
		КонецЕсли;		
	#КонецЕсли
	
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;		
	#КонецЕсли
	
	НеВыводитьИнфоСтроку1С 			= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщений1СФормыОбмена");
	НеВыводитьИнфоСтроку1С_Пустую	= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщений1СПустойФормыОбмена");
	НеВыводитьИнфоСтрокуMS			= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийMSФормыОбмена");
	НеВыводитьИнфоСтрокуMS_Пустую	= Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийMSПустойФормыОбмена");
	
	ИдВыбранногоДокументаМС = "";
	
	СостояниеДокументаВРаботе = НСтр("ru = 'В работе';
										|en = 'At work'; be = 'У працы'; es = 'En el trabajo'; ka = 'სამსახურში'; kk = 'Жұмыста'; ro = 'La locul de muncă'; tr = 'İş yerinde'; uk = 'В роботі'; uz = 'Ishda'");
	СостояниеДокументаВыгружен = НСтр("ru = 'Выгружен';
										|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'");
	СостояниеДокументаЗавершен = НСтр("ru = 'Завершен';
										|en = 'Completed'; be = 'Завершаны'; es = 'Completo'; ka = 'დასრულდა'; kk = 'Аяқталды'; ro = 'Finalizat'; tr = 'Tamamlandı'; uk = 'Завершений'; uz = 'Tugallandi'");
	СостояниеДокументаЗавершенНеИзменен = НСтр("ru = 'Завершен, не изменен';
												|en = 'Completed, not modified'; be = 'Завершаны, ня зменены'; es = 'Completado, no modificado'; ka = 'დასრულდა, არ შეცვლილა'; kk = 'Аяқталған, өзгертілмеген'; ro = 'Completat, nemodificat'; tr = 'Tamamlandı, değiştirilmedi'; uk = 'Завершено, не змінено'; uz = 'Tugallangan, o''zgartirilmagan'");
	СостояниеДокументаЗавершенЕстьРасхождения = НСтр("ru = 'Завершен, есть расхождения';
														|en = 'Completed, there are discrepancies'; be = 'Завершаны, ёсць разыходжанні'; es = 'Terminado, hay discrepancias'; ka = 'დასრულდა, არსებობს შეუსაბამობები'; kk = 'Аяқталды, сәйкессіздіктер бар'; ro = 'Finalizat, există discrepanțe'; tr = 'Tamamlandı, tutarsızlıklar var'; uk = 'Завершено, є розбіжності'; uz = 'Tugallangan, farqlar mavjud'");
	СостояниеДокументаЗавершенБезРасхождений = НСтр("ru = 'Завершен, без расхождений';
														|en = 'Completed, no discrepancies'; be = 'Завершаны, без разыходжанняў'; es = 'Completado, sin discrepancias'; ka = 'დასრულდა, შეუსაბამობები არ არის'; kk = 'Аяқталды, сәйкессіздіктер жоқ'; ro = 'Finalizat, fără discrepanțe'; tr = 'Tutarsızlık olmadan tamamlandı'; uk = 'Завершено, без розбіжностей'; uz = 'To''liq, kelishmovchiliklarsiz'");
	
	ЗаполнитьТаблицуДокументов1С();
	ЗаполнитьТаблицуДокументовSMARTS(Истина);
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВосстановлениеДокументов"
		ИЛИ ИмяСобытия = "ЗаполнитьТаблицуДокументовSMARTS" Тогда
		ЗаполнитьТаблицуДокументовSMARTS();		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомПанель_Документы1СОбновитьНажатие(Команда)
	ЗаполнитьТаблицуДокументов1С();
	ОбновитьДанныеТорговогоОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СНастроитьОтборНажатие(Команда)	
	ОткрытьНастройкуОтбораДокументов();
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СВыделитьВсе(Команда)
	
	УстановкаСнятиеФлагаВыгрузкиВсехДокументов1С(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1ССнятьВсе(Команда)
	
	УстановкаСнятиеФлагаВыгрузкиВсехДокументов1С(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СВыбратьОтображаемыеКолонки(Команда)	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборКолонок = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборКолонок", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборКолонок = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборКолонок", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	
	ФормаСлужебная_ВыборКолонок.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборКолонок._ЛокКонтекст = _ЛокКонтекст;
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВыборКолонокЗакрытие",ЭтаФорма,Истина);
	ФормаСлужебная_ВыборКолонок.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборКолонок.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSОбновитьНажатие(Команда)
	
	ОбновитьДанныеТорговогоОбъекта();
		
	ОП = Новый ОписаниеОповещения("КомПанель_ДокументыMSОбновитьНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);

КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSУдалитьДокумент(Команда)
	
	ОП = Новый ОписаниеОповещения("КомПанель_ДокументыMSУдалитьДокументПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSВыделитьВсе(Команда)
	
	УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSСнятьВсе(Команда)
	
	УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSВыбратьОтображаемыеКолонки(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборКолонок = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборКолонокSMARTS", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборКолонок = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборКолонокSMARTS", , ЭтаФорма, ЭтаФорма);		
	#КонецЕсли
	
	ФормаСлужебная_ВыборКолонок.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ВыборКолонок._ЛокКонтекст = _ЛокКонтекст;
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВыборКолонокSMARTSЗакрытие",ЭтаФорма,Истина);
	ФормаСлужебная_ВыборКолонок.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборКолонок.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СПеренестиНаТерминалНажатие(Команда)
	
	ЕстьСтрокиКВыгрузке = ПроверитьОтметкуВыгрузка();
	Если НЕ ЕстьСтрокиКВыгрузке Тогда
		Возврат;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("КомПанель_Документы1СПеренестиНаТерминалНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSОткрытьДокумент(Команда)
	
	ОП = Новый ОписаниеОповещения("КомПанель_ДокументыMSОткрытьДокументПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSПеренестиСТерминала(Команда)
	
	ЕстьСтрокиКЗагрузке = ПроверитьОтметкуЗагрузка();
	Если НЕ ЕстьСтрокиКЗагрузке Тогда
		Возврат;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("КомПанель_ДокументыMSПеренестиСТерминалаПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СУстановитьПериод(Команда)	
	
	ОткрытиеДиалогаРедактированияСтандартногоПериода1С();
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSУстановитьПериод(Команда)
	
	ОткрытиеДиалогаРедактированияСтандартногоПериодаMS();
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_Документы1СВосстановитьИнфоСообщения(Команда)	
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщений1СФормыОбмена", 		Истина, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщений1СПустойФормыОбмена", Истина, ID_Узла);
	НеВыводитьИнфоСтроку1С 				= Ложь;
	НеВыводитьИнфоСтроку1С_Пустую 		= Ложь; 	
	
	ВыводИнфоОбОтсутствииДокументов		= Не (Документы1С.Количество() Или НеВыводитьИнфоСтроку1С_Пустую);
	ВыводИнфоПриПолномВыводе			= Документы1С.Количество() И Документы1С.Количество() < КоличествоДокументовНаФорме И Не НеВыводитьИнфоСтроку1С;	
	ВидимостьГруппаИнфо1СВерх 			= ВыводИнфоОбОтсутствииДокументов Или ВыводИнфоПриПолномВыводе;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппаИнфо1СВерх Тогда
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрока1СВерх.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаИнфо1СВерх.Видимость = ВидимостьГруппаИнфо1СВерх;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура КомПанель_ДокументыMSВосстановитьИнфоСообщения(Команда)
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщенийMSФормыОбмена", 		Истина, ID_Узла);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьПользовательскуюНастройку("ВыводИнфоСообщенийMSПустойФормыОбмена", Истина, ID_Узла);
	НеВыводитьИнфоСтрокуMS 				= Ложь;
	НеВыводитьИнфоСтрокуMS_Пустую 		= Ложь;    

	ВидимостьГруппаИнфоMSВерх = ДокументыMS.Количество() < КоличествоДокументовНаФорме И Не (НеВыводитьИнфоСтрокуMS И НеВыводитьИнфоСтрокуMS_Пустую);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппаИнфоMSВерх Тогда
			Элементы.ПанельИнфоСтрокаMSВерх.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрокаMSВерх.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаИнфоMSВерх.Видимость = ВидимостьГруппаИнфоMSВерх;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНаТерминалНесколькоКакОдинНажатие(Команда)
	
	ЕстьСтрокиКВыгрузке = ПроверитьОтметкуВыгрузка();
	Если НЕ ЕстьСтрокиКВыгрузке Тогда
		Возврат;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ПеренестиНаТерминалНесколькоКакОдинНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПоБизнесПроцессуНаВыбор(Команда)
	
	ОП = Новый ОписаниеОповещения("ЗагрузитьПоБизнесПроцессуНаВыборПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСТерминалаНесколькоНажатие(Команда)
	
	ЕстьСтрокиКЗагрузке = ПроверитьОтметкуЗагрузка();
	Если НЕ ЕстьСтрокиКЗагрузке Тогда
		Возврат;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ПеренестиСТерминалаНесколькоНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьДокументы(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСужебная_ВосстановлениеДокументовSMARTS = ПолучитьФорму("ОФ_ФормаСлужебная_ВосстановлениеДокументовSMARTS", ЭтаФорма);
	#Иначе		
		ФормаСужебная_ВосстановлениеДокументовSMARTS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВосстановлениеДокументовSMARTS", , ЭтаФорма, ЭтаФорма);			
		ФормаСужебная_ВосстановлениеДокументовSMARTS.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;			
	#КонецЕсли
	ФормаСужебная_ВосстановлениеДокументовSMARTS._ЛокКонтекст 	= _ЛокКонтекст;
	ФормаСужебная_ВосстановлениеДокументовSMARTS.ТипБазы 		= ТипБазы;
	
	ОП = Новый ОписаниеОповещения("Служебная_ВосстановлениеДокументовSMARTSЗакрытие", ЭтаФорма);
