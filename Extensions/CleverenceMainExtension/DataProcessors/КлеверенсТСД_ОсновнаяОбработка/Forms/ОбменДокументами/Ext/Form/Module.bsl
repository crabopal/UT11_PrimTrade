КонецПроцедуры

&НаКлиенте
Процедура УстановитьДанныеТекущегоУзла(ID_УстанавливаемогоУзла)

	Если ID_ТекущегоУзла = ID_УстанавливаемогоУзла Тогда
		Возврат;		
	КонецЕсли;
		
	ID_ТекущегоУзла = ID_УстанавливаемогоУзла;
	_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_УстанавливаемогоУзла);
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруБизнесПроцессов(ID_УстанавливаемогоУзла);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнформационныеСообщения1С()
	
	МассивПодстрок = Новый Массив;
	
	Если Документы1С.Количество() Тогда                       
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			НомерОшибки1СВерх 								= "#1CEDHT001";
			Элементы.ОшибкаСтрока1СВерхСтраница1.Заголовок 	= НомерОшибки1СВерх;
			
			Элементы.ПанельИнфоСтрока1СВерх.ТекущаяСтраница = Элементы.ПанельИнфоСтрока1СВерх.Страницы.Страница1;
		#Иначе			
			МассивПодстрок.Добавить(_ЛокКонтекст.ЛокЯдро_ПолучитьФорматированнуюСтрокуПоНомеруОшибки("#1CEDHT001"));
			МассивПодстрок.Добавить(". ");
