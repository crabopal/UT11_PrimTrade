#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	
	&НаСервере
	Процедура УстановитьУсловноеОформлениеФормы(ВключенныеКолонкиMS = Неопределено, ВключенныеКолонки1С = Неопределено)
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если ВключенныеКолонкиMS <> Неопределено Тогда
				//УсловноеОформление.Элементы.Очистить();
				ОчиститьЭлементыУсловногоОформления("ДокументыMS");
				
				МассивПолейОформления = Новый Массив;
				Для Каждого Колонка Из ВключенныеКолонкиMS Цикл
					МассивПолейОформления.Добавить(Новый ПолеКомпоновкиДанных("ДокументыMS" + Колонка.Название));
				КонецЦикла;
				
				// Завершенные строки
				ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
				
				ГруппаОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение = СостояниеДокументаЗавершен;
				ЭлементОтбора.Использование = Истина;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение = СостояниеДокументаЗавершенБезРасхождений;
				ЭлементОтбора.Использование = Истина;
				
				Для Каждого ПолеОформления Из МассивПолейОформления Цикл
					ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
					ПолеЭлемента.Поле = ПолеОформления;
				КонецЦикла;
				
				ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(216, 251, 216));
				
				// Строки в работе
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаВРаботе, 
				Новый Цвет(230, 230, 250),
				МассивПолейОформления);
				
				// Строки завершены с расхождениями
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаЗавершенЕстьРасхождения,
				Новый Цвет(255, 227, 227),
				МассивПолейОформления);
				
				// Строки завершены и не изменены
				ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(
				СостояниеДокументаЗавершенНеИзменен, 
				Новый Цвет(255, 255, 222),
				МассивПолейОформления);
			ИначеЕсли ВключенныеКолонки1С <> Неопределено Тогда
				// Оформление таблицы документов 1С, подсвечивание исходного документа 1С	
				ОчиститьЭлементыУсловногоОформления("Документы1С");
				
				ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
				ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Документы1С.Ссылка_GUID");
				ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
				ЭлементОтбора.ПравоеЗначение 	= Новый ПолеКомпоновкиДанных("ИдВыбранногоДокументаМС");				
				ЭлементОтбора.Использование 	= Истина;								
				
				Для Каждого Колонка Из ВключенныеКолонки1С Цикл
					ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
					ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("Документы1С" + Колонка.Название);
				КонецЦикла;
				
				ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 204, 153));
			КонецЕсли;
						
		#КонецЕсли
		
	КонецПроцедуры
	
	&НаСервере
	Процедура ДобавлениеУсловногоОформленияФормыПоСостояниюДокументаSMARTS(Состояние, ЦветФона, МассивПолейОформления)
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ДокументыMS.Состояние");
		ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.ПравоеЗначение 	= Состояние;
		ЭлементОтбора.Использование 	= Истина;
		
		Для Каждого ПолеОформления Из МассивПолейОформления Цикл
			ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = ПолеОформления;
		КонецЦикла;
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
		
	КонецПроцедуры
	
	Процедура ОчиститьЭлементыУсловногоОформления(Условие)
		МассивКУдалению = Новый Массив;
		Для Каждого ЭлементУО Из УсловноеОформление.Элементы Цикл
			Если Найти(Строка(ЭлементУО.Поля.Элементы[0].Поле),Условие) > 0 Тогда
				МассивКУдалению.Добавить(ЭлементУО);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ЭлементУО Из МассивКУдалению Цикл
			УсловноеОформление.Элементы.Удалить(ЭлементУО);
		КонецЦикла;
		
	КонецПроцедуры
#Иначе
	
	Процедура ЗаполнитьТаблицуДокументов1СОбязательнымиКолонками()
		
		// Колонка с галочками выбора
		Документы1С.Колонки.Добавить("Выгружать", Новый ОписаниеТипов("Булево"), "Выгружать", 21);
		НовыйЭФ = Элементы.Документы1С.Колонки.Добавить("Выгружать", "");
		НовыйЭФ.Видимость 			= Истина;
		НовыйЭФ.ДанныеФлажка 		= "Выгружать";
		НовыйЭФ.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
		НовыйЭФ.ТекстШапки 			= "";
		НовыйЭФ.Ширина 				= 5;
		НовыйЭФ.ИзменениеРазмера 	=  ИзменениеРазмераКолонки.НеИзменять;
		
	КонецПроцедуры
	
	Процедура ЗаполнитьТаблицуДокументовSMARTSОбязательнымиКолонками()
		
		// Колонка с галочками выбора
		ДокументыMS.Колонки.Добавить("Загружать", Новый ОписаниеТипов("Булево"), "Загружать", 21);	
		НовыйЭФ = Элементы.ДокументыMS.Колонки.Добавить("ДокументыMSЗагружать", "");
		НовыйЭФ.Видимость = Истина;
		НовыйЭФ.ДанныеФлажка = "Загружать";
		НовыйЭФ.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
		НовыйЭФ.ТекстШапки = "";
		НовыйЭФ.Ширина = 5;
		НовыйЭФ.ИзменениеРазмера = ИзменениеРазмераКолонки.НеИзменять;
		
		// Вспомогательная колонка
		ДокументыMS.Колонки.Добавить("Загружен", Новый ОписаниеТипов("Булево"), "Загружать", 21);	
		
		ДокументыMS.Колонки.Добавить("ШапкаДокумента");
		
	КонецПроцедуры

	Процедура ДокументыMSПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		Если ДанныеСтроки.Состояние = СостояниеДокументаЗавершен ИЛИ ДанныеСтроки.Состояние = СостояниеДокументаЗавершенБезРасхождений Тогда
			ОформлениеСтроки.ЦветФона = Новый Цвет(216,251,216);	
		ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаВРаботе Тогда	
			ОформлениеСтроки.ЦветФона = WebЦвета.БледноЛиловый;
		ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаЗавершенЕстьРасхождения Тогда	
			ОформлениеСтроки.ЦветФона = Новый Цвет(255,227,227);
	    ИначеЕсли ДанныеСтроки.Состояние = СостояниеДокументаЗавершенНеИзменен Тогда	
			ОформлениеСтроки.ЦветФона = Новый Цвет(255,255,222);
		КонецЕсли;
	КонецПроцедуры
	
	Функция ПолучитьСкрытыеКолонки()
	
		СкрытыеКолонки = Новый Массив;
		
		// Документ1С
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Название",		"Документ1С");
		НовыйЭлемент.Вставить("Представление", 	"Документ 1С");
		НовыйЭлемент.Вставить("ТипРеквизита", 	Новый ОписаниеТипов(Документы.ТипВсеСсылки()));
				
		СкрытыеКолонки.Добавить(НовыйЭлемент);
		
		// Ссылка
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Название",		"Ссылка");
		НовыйЭлемент.Вставить("Представление", 	"Название");
		НовыйЭлемент.Вставить("ТипРеквизита", 	Новый ОписаниеТипов(Документы.ТипВсеСсылки()));
		
		ДополнительныеСвойства = Новый Структура;
		ДополнительныеСвойства.Вставить("КнопкаОткрытия",	Истина);
		ДополнительныеСвойства.Вставить("КнопкаВыбора",		Ложь);
		ДополнительныеСвойства.Вставить("КнопкаОчистки",  	Ложь);
		НовыйЭлемент.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
		
		СкрытыеКолонки.Добавить(НовыйЭлемент);
		
		// НастройкаБизнесПроцесса
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Название",		"НастройкаБизнесПроцесса");
		НовыйЭлемент.Вставить("Представление", 	"ID бизнес-процесса");
		
		СкрытыеКолонки.Добавить(НовыйЭлемент);
		
		// БизнесПроцесс
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Название",		"БизнесПроцесс");
		НовыйЭлемент.Вставить("Представление", 	"Настройка бизнес-процесса");
		
		ДополнительныеСвойства = Новый Структура;
		ДополнительныеСвойства.Вставить("КнопкаОткрытия", 	   Истина);
		ДополнительныеСвойства.Вставить("РежимРедактирования", РежимРедактированияКолонки.Непосредственно);
		НовыйЭлемент.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);
		
		СкрытыеКолонки.Добавить(НовыйЭлемент);
		
		// ТипДокумента1С
		НовыйЭлемент = Новый Структура;
		НовыйЭлемент.Вставить("Название",		"ТипДокумента1С");
		НовыйЭлемент.Вставить("Представление", 	"Тип документа 1С");
		
		СкрытыеКолонки.Добавить(НовыйЭлемент);	
		
		Возврат СкрытыеКолонки;
		
	КонецФункции
	
	Процедура ДобавитьКолонкуДокументы1С(ДанныеКолонки, ОтображатьНаФорме = Ложь)
	
		Если ДанныеКолонки.Свойство("ТипРеквизита") Тогда
			Документы1С.Колонки.Добавить(ДанныеКолонки.Название, ДанныеКолонки.ТипРеквизита, ДанныеКолонки.Представление);
		Иначе
			Документы1С.Колонки.Добавить(ДанныеКолонки.Название,, ДанныеКолонки.Представление);
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Документы1С.Колонки.Добавить(ДанныеКолонки.Название, ДанныеКолонки.Представление);
		НовыйЭлемент.Видимость = ОтображатьНаФорме;
		НовыйЭлемент.Данные = ДанныеКолонки.Название;
		
		ДополнительныеСвойства = Неопределено;
		Если НЕ ДанныеКолонки.Свойство("ДополнительныеСвойства", ДополнительныеСвойства) Тогда
			Возврат;
		КонецЕсли;
			
		Для каждого СвойствоЭлемента ИЗ ДополнительныеСвойства Цикл
			КлючНастройки = СвойствоЭлемента.Ключ;
			
			Если _ЛокКонтекст.ЛокЯдро_СтрНайти(КлючНастройки, "Кнопка") Тогда
				НовыйЭлемент["ЭлементУправления"][КлючНастройки] = СвойствоЭлемента.Значение;
			Иначе
				НовыйЭлемент[КлючНастройки] = СвойствоЭлемента.Значение;
			КонецЕсли;
		КонецЦикла;
			
	КонецПроцедуры
	
	ПолноеИмяОбъекта = ЭтаФорма.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтаФорма;
#КонецЕсли
