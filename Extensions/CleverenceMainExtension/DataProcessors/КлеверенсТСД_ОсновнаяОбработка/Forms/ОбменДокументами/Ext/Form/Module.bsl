&НаКлиенте
Процедура ОткрытьНастройкуОтбораДокументов() 
	
	ОП = Новый ОписаниеОповещения("КомПанель_Документы1СНастроитьОтборНажатиеПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеСпискаДокументов1С(БезОграничений = Ложь)
	
	Документы1С.Очистить();
	
	ЗаполнитьКолонкиТаблицыДокументов1С();
	
	ОтборПоПериоду = Неопределено;
	Если ЗначениеЗаполнено(ПериодОтбора1С.ДатаНачала) Или ЗначениеЗаполнено(ПериодОтбора1С.ДатаОкончания) Тогда
		ОтборПоПериоду = Новый Структура("ДатаНачала,ДатаОкончания", ПериодОтбора1С.ДатаНачала, ПериодОтбора1С.ДатаОкончания);
	КонецЕсли;
	
	СписокОтобранныхДокументов = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДокументов1С("Интерактивный", ?(БезОграничений, 0, КоличествоДокументовНаФорме), ОтборПоПериоду);
	Если ЗначениеЗаполнено(СписокОтобранныхДокументов) Тогда 
		Для Каждого СтрокаДокумента Из СписокОтобранныхДокументов Цикл
			Если СтрокаДокумента.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;	
			КонецЕсли;
			НоваяСтрока = Документы1С.Добавить();
			Если СтрокаДокумента.Свойство("ЭтоУникальнаяСсылка") И СтрокаДокумента.ЭтоУникальнаяСсылка = Ложь Тогда
				СтрокаДокумента.НастройкаБизнесПроцесса = "";
				СтрокаДокумента.БизнесПроцесс = "";
				СтрокаДокумента.ИмяБП = "";
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);			
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьСоответсвияПользователейВНазначении(ПользователиMS)
	
	ПользователиМС = ПолучитьИзВременногоХранилища(ПользователиMS);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		МодульОбработки = ОбработкаОбъект;
	#Иначе
		МодульОбработки = РеквизитФормыВЗначение("Объект");
	#КонецЕсли
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЕстьКолонкаНазначение = НЕ ДокументыMS.Колонки.Найти("Назначение") = Неопределено;
	#КонецЕсли
	
	Для Каждого ДокументMS ИЗ ДокументыMS Цикл
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ЕстьКолонкаНазначение Тогда
				Продолжить;
			КонецЕсли;
		#Иначе
			Если НЕ ДокументMS.Свойство("Назначение") Тогда
				Продолжить;
			КонецЕсли;
		#КонецЕсли
		
		Если ДокументMS.Назначение <> "" Тогда
			СтрокаНазначения = "";
			МассивПользователей = МодульОбработки.ГлЯдро_СтрРазделить(ДокументMS.Назначение,"|", Ложь); 
			МассивКоличество = МассивПользователей.Количество();
			
			Для ИндексМассива = 1 ПО МассивКоличество  Цикл
				ДанныеПользователяПоID = ПользователиМС.Строки.Найти(МассивПользователей[ИндексМассива-1],,Истина);
				Если ДанныеПользователяПоID = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаНазначения = СтрокаНазначения+ ДанныеПользователяПоID.ГруппаПользователь + "(" + ДанныеПользователяПоID.ИдГруппыПользователя + ")";
				Если ИндексМассива <> МассивКоличество Тогда
					СтрокаНазначения = СтрокаНазначения + "|";
				КонецЕсли;	
			КонецЦикла;
			ДокументMS.Назначение = СтрокаНазначения; 
		КонецЕсли;	 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаВидимостиФункционалаВосстановленияДокументов()

	InternetGateOption 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("InternetGateOption");
	флЛегкоеОблако 		= InternetGateOption <> Ложь И ВРег(InternetGateOption) = "AVAILABLE";
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ДокументыMSВосстановитьДокументы.Видимость = флЛегкоеОблако;
	#Иначе                                                                                           
		КнопкаВосстановления = Элементы.КомПанель_ДокументыMS.Кнопки.Найти("ВосстановитьДокументы");
		Если Не флЛегкоеОблако И КнопкаВосстановления <> Неопределено Тогда
			Элементы.КомПанель_ДокументыMS.Кнопки.Удалить(КнопкаВосстановления);
		КонецЕсли;
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПолучениеСпискаДокументовSMARTS(ОткрытиеФормы = Ложь, БезОграничений = Ложь)

	УстановкаВидимостиФункционалаВосстановленияДокументов();
	
	ДокументыMS.Очистить();	
	Если ОткрытиеФормы Тогда
		ЗаполнитьКолонкиТаблицыДокументовSMARTS();	
	КонецЕсли;
	ИзменениеВидимостиКолонокТаблицыДокументовSMARTS();
	
	СписокИдВыгруженныхДокументов.Очистить();
	
	ОтборПоПериоду = Неопределено;
	Если ЗначениеЗаполнено(ПериодОтбораMS.ДатаНачала) Или ЗначениеЗаполнено(ПериодОтбораMS.ДатаОкончания) Тогда
		ОтборПоПериоду = Новый Структура("ДатаНачала,ДатаОкончания", ПериодОтбораMS.ДатаНачала, ПериодОтбораMS.ДатаОкончания);
	КонецЕсли;
	
	ОтборПоУзлу = Неопределено;
	Если ЗначениеЗаполнено(ID_Узла) Тогда
		ОтборПоУзлу = Новый Структура("ID_Узла", ID_Узла);
	КонецЕсли;	
		
	ТЗ = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДокументовНаСервереSMARTS(, ?(БезОграничений, 0, КоличествоДокументовНаФорме), ОтборПоПериоду, ОтборПоУзлу);
	Если ТипЗнч(ТЗ) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТЗ = ДокументыMS.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, СтрокаТЗ);
			НоваяСтрокаТЗ.ШапкаДокумента = СтрокаТЗ;
			
			// Состояние
			Если СтрокаТЗ.Завершен Тогда
				Если СтрокаТЗ.СозданНаТСД Тогда
					НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершен;					
				Иначе
					Если СтрокаТЗ.СтрокиФактКоличество = 0 Тогда
						НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенНеИзменен;
					Иначе
						Если СтрокаТЗ.КонтрольКоличества = Истина Тогда
							Если СтрокаТЗ.ЕстьПереполнениеИлиНедобор Тогда
								НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенЕстьРасхождения;
							Иначе
								НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершенБезРасхождений;
							КонецЕсли;
						Иначе
							НоваяСтрокаТЗ.Состояние = СостояниеДокументаЗавершен;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли СтрокаТЗ.ВОбработке Тогда
				НоваяСтрокаТЗ.Состояние = СостояниеДокументаВРаботе;
			Иначе
				НоваяСтрокаТЗ.Состояние = СостояниеДокументаВыгружен;
			КонецЕсли;
						
			Если ЗначениеЗаполнено(СтрокаТЗ.ИдИсходныхДокументов) Тогда
				МассивИд =  _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаТЗ.ИдИсходныхДокументов,";");
				Для Каждого ИдОбъединенногоДокумента Из МассивИд Цикл
					Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(ИдОбъединенногоДокумента) =  Неопределено Тогда
						СписокИдВыгруженныхДокументов.Добавить(ИдОбъединенногоДокумента);	
					КонецЕсли;
				КонецЦикла;
			Иначе
				Если СписокИдВыгруженныхДокументов.НайтиПоЗначению(СтрокаТЗ.Ид) =  Неопределено Тогда
					СписокИдВыгруженныхДокументов.Добавить(СтрокаТЗ.Ид);	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	 ПользователиMS = _ЛокКонтекст.СтруктураМетаданных.ПользователиMS;
	 ПроставитьСоответсвияПользователейВНазначении(ПользователиMS);
	
	ЗаполнитьИнформационныеСообщенияMS();
	
КонецПроцедуры

#КонецОбласти

