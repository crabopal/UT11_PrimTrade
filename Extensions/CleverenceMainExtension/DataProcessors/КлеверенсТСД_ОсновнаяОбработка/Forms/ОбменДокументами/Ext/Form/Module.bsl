&НаКлиенте
Процедура ВыгрузкаДокументов_ВыгрузитьИзОкнаОбмена(ВыгрузитьВОдин)
	
	ОП = Новый ОписаниеОповещения("ВыгрузкаДокументов_ОповещениеОбработкиЗавершения", ЭтаФорма);
	
	ПараметрыВызова = _ЛокКонтекст.ЛокЯдро_ВыгрузкаДокументов_СтруктураПараметровВызова();
	ПараметрыВызова.ID_Узла = ID_Узла;
	ПараметрыВызова.ВыгрузитьВОдин = ВыгрузитьВОдин;
	ПараметрыВызова.ОповещениеОбработкиЗавершения = ОП;
	ПараметрыВызова.ОповещениеОбработкиОшибки = ОП;
	ПараметрыВызова.Форма = ЭтаФорма;
	
	СтрокиДокументовТЗ = Документы1С.НайтиСтроки(Новый Структура("Выгружать",Истина));
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузкаДокументов_ВыгрузитьИзОкнаОбмена(СтрокиДокументовТЗ, СписокИдВыгруженныхДокументов, ПараметрыВызова);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена(ЗагрузитьВОдин = Ложь, ВыбратьБизнесПроцесс = Ложь)
	
	СтрокиДокументов = Новый Массив;
	ОтмеченныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
	
	Для Каждого ВыбранныйДок Из ОтмеченныеДокументы  Цикл
		Если Найти(ВыбранныйДок.Состояние, СостояниеДокументаЗавершен) >  0 Тогда
			СтрокиДокументов.Добавить(ВыбранныйДок.ШапкаДокумента);
		Иначе
			ТекстСообщения = НСтр("ru = '%1: для загрузки в 1С документ должен находиться в состоянии ""Завершен""';
									|en = '%1: To upload to 1C, the document must be in the ""Completed"" state';
									|be = '%1: для загрузкі ў 1С дакумент павінен знаходзіцца ў стане ""завершаны""'; es = '%1: para cargar en 1C, el documento debe estar en el estado ""Completado""'; ka = '%1: 1c-ზე ატვირთვისთვის დოკუმენტი უნდა იყოს ""დასრულებულ"" მდგომარეობაში'; kk = '%1: 1С жүктеу үшін құжат ""аяқталған""күйде болуы керек'; ro = '%1: pentru a încărca în 1C, documentul trebuie să fie în starea "" completat'; tr = '%1: 1c''ye yüklemek için belgenin ""Tamamlandı"" durumunda olması gerekir'; uk = '%1: для завантаження в 1С документ повинен знаходитися в стані""завершено""'; uz = '%1: 1C-ga yuklash uchun hujjat ""tugallangan""holatda bo''lishi kerak'");
			ТекстСообщения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстСообщения, ВыбранныйДок.Имя);
			
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = ТекстСообщения;
			СообщениеПользователю.Сообщить();
			
			ВыбранныйДок.Загружать = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
	Если СтрокиДокументов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ЗагрузкаДокументов_ОповещениеОбработкиЗавершения", ЭтаФорма);
	
	ПараметрыВызова = _ЛокКонтекст.ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова();
	ПараметрыВызова.ID_Узла = ID_Узла;
	ПараметрыВызова.ЗагрузитьВОдин = ЗагрузитьВОдин;
	ПараметрыВызова.ВыбратьБизнесПроцесс = ВыбратьБизнесПроцесс;
	ПараметрыВызова.ОповещениеОбработкиЗавершения = ОП;
	ПараметрыВызова.ОповещениеОбработкиОшибки = ОП;
	ПараметрыВызова.Форма = ЭтаФорма;
	
	_ЛокКонтекст.ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена(СтрокиДокументов, ПараметрыВызова);
		
КонецПроцедуры

// Подготавливает таблицу Документов1С и заполняет документами по настроенным отборам
// 
// Параметры:
&НаКлиенте
Процедура ЗаполнитьТаблицуДокументов1С()
	
	ПолучениеСпискаДокументов1С(ВыборкаДокументов1СБезОграничений);
	ЗаполнитьИнформационныеСообщения1С();
	
КонецПроцедуры         

// Обновляет набор колонок в таблице Документов1С согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ЗаполнитьКолонкиТаблицыДокументов1С()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Документы1С.Колонки.Очистить();
		Элементы.Документы1С.Колонки.Очистить();
		ЗаполнитьТаблицуДокументов1СОбязательнымиКолонками();
	#Иначе
		УдалитьЛишниеКолонкиТаблицыДокументов1С();
	#КонецЕсли
	
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонки", Истина);	
	
	Если СохраненныеНастройки = Ложь ИЛИ СохраненныеНастройки = Неопределено Тогда
		СписокПредставлений = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокРеквизитовВПредставленииДокумента();
		СохраненныеНастройки = ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокПредставлений);
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонки", СохраненныеНастройки, ID_Узла);	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонки",	СохраненныеНастройки);		
	КонецЕсли;
	
	ВключенныеКолонки = Новый Массив;
	ЕстьКолонкаСсылка = Ложь; 
	Для Каждого Настройка ИЗ СохраненныеНастройки Цикл
		Если НЕ Настройка.Свойство("Использование")
			ИЛИ НЕ Настройка.Использование Тогда
			Продолжить;
		КонецЕсли;
		ВключенныеКолонки.Добавить(Настройка);
		Если Настройка.Название = "Ссылка"
			И НЕ ЕстьКолонкаСсылка Тогда
			ЕстьКолонкаСсылка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьКолонкаСсылка Тогда
		ВключенныеКолонки.Вставить(0, Новый Структура("Название, Представление, Использование", "Ссылка", "Ссылка", Истина));
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СкрытыеКолонки = ПолучитьСкрытыеКолонки();
		
		// Добавляем включенные колонки
		Для каждого ВключеннаяКолонка ИЗ ВключенныеКолонки Цикл
			Если Документы1С.Колонки.Найти(ВключеннаяКолонка.Название) <> Неопределено Тогда
				Элементы.Документы1С.Колонки.Найти(ВключеннаяКолонка.Название).Видимость = Истина;
				Продолжить;
			КонецЕсли;
			
			СкрытаяКолонка = _ЛокКонтекст.ЛокЯдро_НайтиПоЗначениюВМассивеСтруктур(СкрытыеКолонки, "Название", ВключеннаяКолонка.Название);
			Если СкрытаяКолонка <> Неопределено Тогда
				ДобавитьКолонкуДокументы1С(СкрытаяКолонка, Истина);
			Иначе	
				ДобавитьКолонкуДокументы1С(ВключеннаяКолонка, Истина);
			КонецЕсли;
		КонецЦикла;
		
		// Добавляем скрытые обязательные колонки
		Для каждого СкрытаяКолонка ИЗ СкрытыеКолонки Цикл
			Если Документы1С.Колонки.Найти(СкрытаяКолонка.Название) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьКолонкуДокументы1С(СкрытаяКолонка, Ложь);
		КонецЦикла;
	#Иначе
		ДобавитьКолонкиТаблицыДокументов1С(ВключенныеКолонки);
	#КонецЕсли
	
КонецПроцедуры

// Добавляет колонки на форму в таблицу документов 1С
// 
// Параметры:
// 	ВключенныеКолонки - Массив - Массив с описанием колонок
&НаСервере
Процедура ДобавитьКолонкиТаблицыДокументов1С(ВключенныеКолонки)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда

		МассивРеквизитов = Новый Массив;
		КС = Новый КвалификаторыСтроки(0);
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);                
		ТаблицаПолейВыбора = Элементы.Документы1С;
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			
			Если Колонка.Название = "Ссылка" Тогда
				ТипКолонки = Новый ОписаниеТипов();
			ИначеЕсли ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ДАТА") > 0
					ИЛИ ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ВРЕМЯ") > 0 Тогда
				ТипКолонки = Новый ОписаниеТипов("Дата");
			Иначе 
				ТипКолонки = ОписаниеТиповС;
			КонецЕсли;
			
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Название, ТипКолонки, "Документы1С"));
			
		КонецЦикла;
		ИзменитьРеквизиты(МассивРеквизитов);
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			НовыйЭлемент = Элементы.Добавить("Документы1С"+Колонка.Название, Тип("ПолеФормы"), ТаблицаПолейВыбора);
			НовыйЭлемент.ПутьКДанным = "Документы1С." + Колонка.Название;
			НовыйЭлемент.Заголовок = Колонка.Представление;					
			НовыйЭлемент.Ширина = 5;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Истина;
			Если Колонка.Название = "Количество" Тогда
				НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
			КонецЕсли;
		КонецЦикла;  
		
		УстановитьУсловноеОформлениеФормы(,ВключенныеКолонки);
	#КонецЕсли
	
КонецПроцедуры

// Удаляет все колонки но форме из таблицы документов 1С, кроме обязательных колонок
// 
// Параметры:
&НаСервере
Процедура УдалитьЛишниеКолонкиТаблицыДокументов1С()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ТабВыборки = РеквизитФормыВЗначение("Документы1С");
		
		
		МассивОбязательныхКолонок = Новый Массив;
		МассивОбязательныхКолонок.Добавить("Выгружать");
		МассивОбязательныхКолонок.Добавить("НастройкаБизнесПроцесса");
		МассивОбязательныхКолонок.Добавить("Документ1С");
		МассивОбязательныхКолонок.Добавить("ТипДокумента1С");
		МассивОбязательныхКолонок.Добавить("Ссылка_GUID");
		
		МассивУдаляемыхРеквизитов = Новый Массив;
		
		Для Каждого Колонка Из ТабВыборки.Колонки Цикл
			Если МассивОбязательныхКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяЭлементы = "Документы1С"+Колонка.Имя;
			ЭлементФ = Элементы.Найти(ИмяЭлементы);
			Если ЭлементФ <> Неопределено Тогда 
				МассивУдаляемыхРеквизитов.Добавить("Документы1С."+Колонка.Имя);
				Элементы.Удалить(ЭлементФ);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);	
	#КонецЕсли

КонецПроцедуры

// Формирует структуру с описанием колонок на основании списка представлений
// 
// Параметры:
// 	СписокПредставлений - СписокЗначений - Представления реквизитов документов по умолчанию
// Возвращаемое значение:
// 	Массив - Массив структур с описанием колонок
&НаСервере
Функция ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокПредставлений)		
	
	ТаблицаВыбранныхКолонок = Новый Массив;
	ТаблицаВыбранныхКолонок.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Использование,Представление,Название"));	
	
	Для Каждого ОписаниеКолонки Из СписокПредставлений Цикл
		Если ОписаниеКолонки.Значение = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		НС = Новый Структура();
		НС.Вставить("Использование",?(ОписаниеКолонки.Значение = "Ссылка" ИЛИ ОписаниеКолонки.Значение = "Количество" ИЛИ ОписаниеКолонки.Значение = "Контрагент",Истина,Ложь));
		НС.Вставить("Представление",ОписаниеКолонки.Представление);
		НС.Вставить("Название",ОписаниеКолонки.Значение);
		ТаблицаВыбранныхКолонок.Добавить(НС);
	КонецЦикла;
	
	Возврат ТаблицаВыбранныхКолонок;
КонецФункции

// Получает из базы SMARTS данные всех документов и заполняет ими таблицу на форме
// 
// Параметры:
// 	ID_БазыSMARTS - Строка - Идентификатор базы SMARTS
&НаКлиенте
Процедура ЗаполнитьТаблицуДокументовSMARTS(ОткрытиеФормы = Ложь)

	ПолучениеСпискаДокументовSMARTS(ОткрытиеФормы, ВыборкаДокументовMSБезОграничений);
	
КонецПроцедуры

// Обновляет набор колонок в таблице Документов SMARTS согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ЗаполнитьКолонкиТаблицыДокументовSMARTS()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ДокументыMS.Колонки.Очистить();
		Элементы.ДокументыMS.Колонки.Очистить();		
		ЗаполнитьТаблицуДокументовSMARTSОбязательнымиКолонками();
	#Иначе
		УдалитьЛишниеКолонкиТаблицыДокументовSMARTS();
	#КонецЕсли
	
	ТаблицаНастроекКолонок = ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS();
	
	ВключенныеКолонки = Новый Массив;	
	Для Каждого Настройка из ТаблицаНастроекКолонок Цикл	
		Если Не Настройка.Свойство("Использование") Тогда
			Продолжить;
		КонецЕсли;
		ВключенныеКолонки.Добавить(Настройка);		
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Для Каждого Строка Из ВключенныеКолонки Цикл
			Если ДокументыMS.Колонки.Найти(Строка.Название) <> Неопределено Тогда
				Элементы.ДокументыMS.Колонки.Найти("ДокументыMS" + Строка.Название).Видимость = Истина;
				Продолжить;
			КонецЕсли;
			НоваяКолонка = ДокументыMS.Колонки.Добавить(Строка.Название, ,Строка.Представление);							
			
			НовыйЭФ = Элементы.ДокументыMS.Колонки.Добавить("ДокументыMS" + Строка.Название,Строка.Представление);
			НовыйЭФ.Данные = Строка.Название; 			
		КонецЦикла;
	#Иначе
		РезультатДобавленияКолонок = ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки);
		Если НЕ РезультатДобавленияКолонок = Истина Тогда
			МассивСодержитДубли = ПроверитьМассивКолонокНаНаличиеДублей(ТаблицаНастроекКолонок);
			
			Если МассивСодержитДубли Тогда
				ВключенныеКолонки = Новый Массив;	
				Для Каждого Настройка ИЗ ТаблицаНастроекКолонок Цикл	
					Если Не Настройка.Свойство("Использование") Тогда
						Продолжить;
					КонецЕсли;
					ВключенныеКолонки.Добавить(Настройка);		
				КонецЦикла;
				
				РезультатДобавленияКолонок = ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки);
				Если РезультатДобавленияКолонок = Истина Тогда
					_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", ТаблицаНастроекКолонок, ID_Узла);
					_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	ТаблицаНастроекКолонок);
				Иначе
					ВызватьИсключение(РезультатДобавленияКолонок);
				КонецЕсли;
			Иначе
				ВызватьИсключение(РезультатДобавленияКолонок);
			КонецЕсли;
		КонецЕсли;
		
		УстановитьУсловноеОформлениеФормы(ВключенныеКолонки);
	#КонецЕсли
		
КонецПроцедуры

// Удаляет все колонки но форме из таблицы документов SMARTS
// 
// Параметры:
&НаСервере
Процедура УдалитьЛишниеКолонкиТаблицыДокументовSMARTS()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		ТабВыборки = РеквизитФормыВЗначение("ДокументыMS"); 		
		
		МассивОбязательныхКолонок = Новый Массив;
		МассивОбязательныхКолонок.Добавить("Загружать");
		МассивОбязательныхКолонок.Добавить("Загружен");
		МассивОбязательныхКолонок.Добавить("ШапкаДокумента");

		МассивУдаляемыхРеквизитов = Новый Массив;
		
		Для Каждого Колонка Из ТабВыборки.Колонки Цикл
			Если МассивОбязательныхКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МассивУдаляемыхРеквизитов.Добавить("ДокументыMS." + Колонка.Имя);
			
			ЭлементФ = Элементы.Найти(Колонка.Имя);
			Если ЭлементФ <> Неопределено Тогда 
				Элементы.Удалить(ЭлементФ);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);
		
	#КонецЕсли

КонецПроцедуры

// Выгружает выделенные документы 1С в базу SMARTS. При необходимости предлагает пользователю выбрать настройку бизнес-процесса и назначить пользователю
// 
// Параметры:
// 	СтрокаДокумента - Строка таблицы документов 1С для выгрузки
// 	ПроверитьНаТСД - Булево - Флаг проведённой проверки на существование этого документа в базе SMARTS
// 	ID_БизнесПроцесса - Строка - Идентификатор бизнес-процесса для выгрузки документа
// 	НазначенныеПользователи - Массив - Выбранные пользователи для назначения
&НаКлиенте
Процедура ВыгрузитьДокументВБазуSMARTS(СтрокаДокумента = Неопределено,ПроверитьНаТСД=Истина,ID_БизнесПроцесса = Неопределено,НазначенныеПользователи=Неопределено)
	
	
			
КонецПроцедуры

// Обновляет набор колонок в таблице ДокументовMS согласно сохранённым настройкам
// 
// Параметры:
&НаКлиенте
Процедура ИзменениеВидимостиКолонокТаблицыДокументовSMARTS()
			
	ТаблицаНастроекКолонок = ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS();
	
	Для Каждого Настройка из ТаблицаНастроекКолонок Цикл
		Если Настройка.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ИмяКолонки = "ДокументыMS" + Настройка.Название;
		
		ИспользованиеКолонки = Ложь;
		Если Настройка.Свойство("Использование") Тогда
			ИспользованиеКолонки = Настройка.Использование;
		КонецЕсли;
			
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если ЭлементыФормы.ДокументыMS.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
				ЭлементыФормы.ДокументыMS.Колонки[ИмяКолонки].Видимость = ИспользованиеКолонки;
			КонецЕсли;
		#Иначе
			Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
				Элементы[ИмяКолонки].Видимость = ИспользованиеКолонки;
			КонецЕсли;
		#КонецЕсли     	
	КонецЦикла;
		
КонецПроцедуры

// Получает из настроек/формирует по-умолчанию список колонок документов SMARTS
// 
// Параметры:
&НаКлиенте
Функция ПолучитьАктуальнуюТаблицуКолонокДокументовSMARTS()
	
	Перем АктуальнаяТаблицаКолонок;
	
	СписокКолонокТаблицы = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивКолонокТаблицыДокументовSMARTS();		
	СохраненныеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",Истина);
	 	
	Если ЭтоВебКлиент И ТипЗнч(СохраненныеНастройки) = Тип("Массив") Тогда
		НастройкиПоУмолчанию = СписокКолонокТаблицы.Количество() < СохраненныеНастройки.Количество();	
	Иначе
		НастройкиПоУмолчанию = СохраненныеНастройки = Ложь Или СохраненныеНастройки = Неопределено;
	КонецЕсли;
	
	Если НастройкиПоУмолчанию Тогда
		
		_ЛокКонтекст.ЛокЯдро_УпорядочитьКолонкиТаблицыДокументовSMARTS(СписокКолонокТаблицы);
		
		АктуальнаяТаблицаКолонок = ЗаполнитьКолонкиТаблицыДокументов1СПоУмолчанию(СписокКолонокТаблицы);
		// Таблица документов SMARTS по умолчанию должна выводиться со всеми колонками
		Для Каждого СтрокаРеквизита Из АктуальнаяТаблицаКолонок Цикл
			Если СтрокаРеквизита.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СтрокаРеквизита.Использование = Истина;		
		КонецЦикла;
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", АктуальнаяТаблицаКолонок, ID_Узла);	
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	АктуальнаяТаблицаКолонок);		
		
	Иначе 	
		
		АктуальнаяТаблицаКолонок = Новый Массив;
		АктуальнаяТаблицаКолонок.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Использование,Представление,Название"));
		
		// Если вдруг сохранились настройки с ограниченным количеством реквизитов, необходимо дополнить их актуальными
		ЕстьИзменениеКолонок = Ложь;
		
		МассивКолонок = Новый Массив; 		
		Для Каждого Строка Из СохраненныеНастройки Цикл
			Если Строка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			// оставляем только существующие
			Колонка = СписокКолонокТаблицы.НайтиПоЗначению(Строка.Название);
			Если Колонка <> Неопределено Тогда
				Если Строка.Представление <> Колонка.Представление Тогда
					Строка.Представление = Колонка.Представление;
					ЕстьИзменениеКолонок = Истина;
				КонецЕсли;
				АктуальнаяТаблицаКолонок.Добавить(Строка);
				МассивКолонок.Добавить(Строка.Название);
			Иначе
				ЕстьИзменениеКолонок = Истина;
			КонецЕсли;
		КонецЦикла;
		
		// добавляем отсутствующие
		Для Каждого СтрокаКолонки Из СписокКолонокТаблицы Цикл
			Если МассивКолонок.Найти(СтрокаКолонки.Значение) = Неопределено Тогда
				НоваяСтрокаНастройки = Новый Структура("Использование, Название, Представление", 
					Ложь, 
					СтрокаКолонки.Значение, 
					СтрокаКолонки.Представление);
				АктуальнаяТаблицаКолонок.Добавить(НоваяСтрокаНастройки);
				ЕстьНовыеКолонки = Истина;			
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьИзменениеКолонок Тогда
			_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS", АктуальнаяТаблицаКолонок, ID_Узла);	
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ФормаОбменаВыбранныеКолонкиSMARTS",	АктуальнаяТаблицаКолонок);		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АктуальнаяТаблицаКолонок;
	
КонецФункции

// Убирает флаг Выгружать в строке таблицы документов 1С после выгрузки
// 
// Параметры:
// 	Документ1С - ДокументСсылка - Ссылка на выгруженный документ 
&НаКлиенте
Процедура СнятьПометкуВыгружатьВСтрокеТаблицы(Документ1С)
	
	Если ТипЗнч(Документ1С) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива ИЗ Документ1С Цикл
			СнятьПометкуВыгружатьВСтрокеТаблицы(ЭлементМассива);
		КонецЦикла;
	КонецЕсли;	

	Строка = Документы1С.НайтиСтроки(Новый Структура("Ссылка",Документ1С));
	
	Если Строка.Количество() > 0 Тогда
		Строка[0].Выгружать = Ложь;	
	КонецЕсли;	

КонецПроцедуры

// Открывает форму просмотра документа Клеверенс
// 
// Параметры:
&НаКлиенте
Процедура ОткрытьДокументТСД()
	
	ТекущиеДанные = Элементы.ДокументыMS.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда			
		Возврат;
	КонецЕсли; 					
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаПросмотра_ДокументMS = ПолучитьФорму("ОФ_ФормаПросмотра_ДокументMS", ЭтаФорма);
	#Иначе
		ФормаПросмотра_ДокументMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаПросмотра_ДокументMS", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	
	Если ФормаПросмотра_ДокументMS.Открыта() Тогда		
		ФормаПросмотра_ДокументMS.Закрыть();	
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаПросмотра_ДокументMS = ПолучитьФорму("ОФ_ФормаПросмотра_ДокументMS", ЭтаФорма);
		#Иначе
			ФормаПросмотра_ДокументMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаПросмотра_ДокументMS", , ЭтаФорма, ЭтаФорма);									
		#КонецЕсли
	КонецЕсли;		
	
	ФормаПросмотра_ДокументMS.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаПросмотра_ДокументMS._ЛокКонтекст = _ЛокКонтекст;
	ФормаПросмотра_ДокументMS.ID_Узла = ID_Узла;
	ФормаПросмотра_ДокументMS.Ид = ТекущиеДанные.Ид;
	ФормаПросмотра_ДокументMS.ТипДокументаMS = ТекущиеДанные.ИмяТипаДокумента;
	ФормаПросмотра_ДокументMS.ШапкаДокументаСписка = ТекущиеДанные.ШапкаДокумента;
	ФормаПросмотра_ДокументMS.Открыть();							
	
КонецПроцедуры

// Загружает в базу 1С документ полученный из базы SMARTS. При необходимости предлагет выбрать бизнес-процесс 
// для загрузки документа и существующий документ 1С для заполнения данными из SMARTS
// 
// Параметры:
// 	ДокументКЗагрузке - Строка таблицы документов Клеверенс
// 	ID_БизнесПроцесса - Строка - Идентификатор бизнес-процесса для загрузки
// 	ДокументДляЗаполнения - ДокументСсылка - Ссылка на документ заполняемый данными из SMARTS
//	ВсеВОдин - Булево - Все документы Клеверенс будут загружены в один документ 1С
//	ЛюбойБП - Булево - Предоставится выбор любого бизнес-процесса для загрузки
&НаКлиенте
Процедура ЗагрузитьВыбранныеДокументыВБазу1С(ДокументКЗагрузке = Неопределено,ID_БизнесПроцесса=Неопределено,ДокументДляЗаполнения=Неопределено, ВсеВОдин=Ложь,ЛюбойБП=Ложь)
	
	
	Возврат;
	
	// Флаг, предназначеный для определения последнего элемента массива загружаемых документов
	ЭтоПоследнийДокумент = Истина;
	
	Если ДокументКЗагрузке = Неопределено Тогда		
		ОтмеченныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		
		ВыбранныеДокументы = Новый Массив;
		Для Каждого ВыбранныйДок Из ОтмеченныеДокументы  Цикл
			Если Найти(ВыбранныйДок.Состояние, СостояниеДокументаЗавершен) >  0 Тогда
				
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Если ТипЗнч(ВыбранныйДок) = Тип("СтрокаТаблицыЗначений") Тогда
						СтруктураДокумента = Новый Структура;
						Для каждого Колонка Из ДокументыMS.Колонки Цикл
							СтруктураДокумента.Вставить(Колонка.Имя);
						КонецЦикла;
						ЗаполнитьЗначенияСвойств(СтруктураДокумента, ВыбранныйДок);
						ВыбранныйДок = СтруктураДокумента;
					КонецЕсли;
				#КонецЕсли 
				
				ВыбранныеДокументы.Добавить(ВыбранныйДок);
			Иначе
				ТекстСообщения = НСтр("ru = '%1: для загрузки в 1С документ должен находиться в состоянии ""Завершен""';
										|en = '%1: To upload to 1C, the document must be in the ""Completed"" state';
										|be = '%1: для загрузкі ў 1С дакумент павінен знаходзіцца ў стане ""завершаны""'; es = '%1: para cargar en 1C, el documento debe estar en el estado ""Completado""'; ka = '%1: 1c-ზე ატვირთვისთვის დოკუმენტი უნდა იყოს ""დასრულებულ"" მდგომარეობაში'; kk = '%1: 1С жүктеу үшін құжат ""аяқталған""күйде болуы керек'; ro = '%1: pentru a încărca în 1C, documentul trebuie să fie în starea "" completat'; tr = '%1: 1c''ye yüklemek için belgenin ""Tamamlandı"" durumunda olması gerekir'; uk = '%1: для завантаження в 1С документ повинен знаходитися в стані""завершено""'; uz = '%1: 1C-ga yuklash uchun hujjat ""tugallangan""holatda bo''lishi kerak'");
				ТекстСообщения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстСообщения, ВыбранныйДок.Имя);
				
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = ТекстСообщения;
				СообщениеПользователю.Сообщить();
				
				ВыбранныйДок.Загружать = Ложь;
			КонецЕсли;
		КонецЦикла;												
		
		Если ВыбранныеДокументы.Количество() > 0 Тогда
			ДокументКЗагрузке = ВыбранныеДокументы[0];
			
			ЭтоПоследнийДокумент = ВыбранныеДокументы.Количество() = 1;
			
			Если ВсеВОдин и ID_БизнесПроцесса = Неопределено Тогда
				Для Каждого ВыбранныйДокумент из ВыбранныеДокументы Цикл
					Если ВыбранныйДокумент.ИмяТипаДокумента <> ДокументКЗагрузке.ИмяТипаДокумента Тогда
						Сообщение = НСтр("ru = 'Для загрузки в один документ 1С нужны документы СМАРТС одного типа';
											|en = 'To upload to a single 1C document, you need the same type of Cleverence documents';
											|be = 'Для загрузкі ў адзін дакумент 1С патрэбныя дакументы Cleverence аднаго тыпу'; es = 'Para cargar en un documento 1C, necesita documentos Cleverence del mismo tipo'; ka = 'ერთი 1C დოკუმენტის ატვირთვისთვის საჭიროა იგივე ტიპის Cleverence დოკუმენტები'; kk = 'Бір құжатқа 1С жүктеу үшін сізге бір типтегі Cleverence құжаттары қажет'; ro = 'Pentru a încărca într-un singur document 1C, aveți nevoie de același tip de documente Cleverence'; tr = 'Bir 1C belgesine yüklemek için aynı türdeki Cleverence belgelerine ihtiyacınız var'; uk = 'Для завантаження в один документ 1С потрібні документи Cleverence одного типу'; uz = 'Bitta 1C hujjatiga yuklash uchun sizga bir xil turdagi Cleverence hujjatlari kerak'");
						Сообщить(Сообщение); 
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			УстановитьДанныеТекущегоУзла(ID_Узла);
			Возврат;
		КонецЕсли;
	ИначеЕсли Не ВсеВОдин Тогда
		ВыбранныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		
		КоличествоДокументов = 0;
		Для каждого ВыбранныйДокумент ИЗ ВыбранныеДокументы Цикл
			Если Найти(ВыбранныйДокумент.Состояние, "Завершен") Тогда
				КоличествоДокументов = КоличествоДокументов + 1;
				Если КоличествоДокументов = 2 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЭтоПоследнийДокумент = КоличествоДокументов = 1;
		//ЭтоПоследнийДокумент = ВыбранныеДокументы.Количество() = 1;
	КонецЕсли;	
	
	Попытка
		Если ДокументКЗагрузке.Свойство("ИдУзла") И ДокументКЗагрузке.ИдУзла <> ID_ТекущегоУзла Тогда
			ПереключитьсяНаУзелДокумента = Истина;
			
			Если НЕ ЗначениеЗаполнено(ДокументКЗагрузке.ИдУзла) Тогда
				ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
				Если ЕстьЧастнаяБаза = Истина Тогда
					// В частной базе могут оказаться документы с пустым ИдУзла, в этом случае переключаться на основную базу не нужно
					ПереключитьсяНаУзелДокумента = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если ПереключитьсяНаУзелДокумента Тогда
				УстановитьДанныеТекущегоУзла(ДокументКЗагрузке.ИдУзла);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		пСообщение = НСтр("ru = 'Не удалось определить узел загружаемого документа или получить его настройки по причине: %1';
							|en = 'Couldn''t identify the node of the uploaded document or get its settings for the reason: %1';
							|be = 'Не ўдалося вызначыць вузел загружанага дакумента або атрымаць яго налады па прычыне: %1'; es = 'No se pudo identificar el nodo del documento que se está cargando ni obtener su configuración porque: %1'; ka = 'ვერ მოხერხდა ატვირთული დოკუმენტის კვანძის იდენტიფიცირება ან მისი პარამეტრების მიღება მიზეზის გამო: %1'; kk = 'Жүктелетін құжаттың түйінін анықтау немесе оның параметрлерін алу мүмкін болмады: % 1'; ro = 'Nu s-a putut identifica nodul documentului încărcat sau obține setările acestuia din motivul: %1'; tr = 'Yüklenmekte olan belgenin düğümünü belirleyemedim veya aşağıdaki nedenlerden dolayı ayarlarını alamadım: %1'; uk = 'Не вдалося визначити вузол завантажуваного документа або отримати його налаштування з причини: %1'; uz = 'Yuklab olingan hujjatning tugunini aniqlash yoki uning sozlamalarini quyidagi sabablarga ko''ra olish mumkin emas: %1'");
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, ТекстОшибки);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЗагрузитьВыбранныеДокументыВБазу1С", "Ошибка", пСообщение);
	КонецПопытки;
	
	Если СписокИдДокументовПредупрежденныхДемо.НайтиПоЗначению(ДокументКЗагрузке.Ид) = Неопределено Тогда
		
		СписокИдДокументовПредупрежденныхДемо.Добавить(ДокументКЗагрузке.Ид);
		
		ДопПараметры = Новый Структура;		
		ДопПараметры.Вставить("ДокументКЗагрузке",Неопределено);
		ДопПараметры.Вставить("ID_БизнесПроцесса",Неопределено);
		ДопПараметры.Вставить("ДокументДляЗаполнения",Неопределено);
		ДопПараметры.Вставить("ВсеВОдин",ВсеВОдин);
		ДопПараметры.Вставить("ЛюбойБП",Ложь);
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьВыбранныеДокументыВБазу1СПослеПроверкиДемо", ЭтаФорма,ДопПараметры);
		
		ИдУстройства = "";
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ДокументыMS.Колонки.Найти("DeviceId") <> Неопределено
			И ЗначениеЗаполнено(ДокументКЗагрузке.DeviceId) Тогда
			ИдУстройства = ДокументКЗагрузке.DeviceId;
		ИначеЕсли ДокументыMS.Колонки.Найти("ИдУстройства") <> Неопределено Тогда
			ИдУстройства = ДокументКЗагрузке.ИдУстройства;
		КонецЕсли;
		#Иначе				
		Если ДокументКЗагрузке.Свойство("DeviceId")
			И ЗначениеЗаполнено(ДокументКЗагрузке.DeviceId) Тогда
			ИдУстройства = ДокументКЗагрузке.DeviceId;
		ИначеЕсли ДокументКЗагрузке.Свойство("ИдУстройства") Тогда
			ИдУстройства = ДокументКЗагрузке.ИдУстройства;
		КонецЕсли;	
		#КонецЕсли
		
		ПараметрыПроверки = Новый Структура("Событие,ИдУстройства", "ЗагрузкаДокумента", ИдУстройства);
		_ЛокКонтекст.ЛокЯдро_ПроверитьДемоРежим(Оповещение, ПараметрыПроверки);
		Возврат;
	КонецЕсли;
	
	Если ID_БизнесПроцесса = Неопределено Тогда
		НастройкиОбмена = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
		Если НастройкиОбмена = Неопределено Тогда
			Сообщение = НСтр("ru = 'Номер ошибки #INTEX001. Для данного типа документа нет настроенного или активного бизнес-процесса, настройте бизнес-процесс в настройках обработки для 1С %1 или загрузите по произвольному существующему бизнес-процессу через контекстное меню по нажатию правой кнопки мыши. Подробнее - https://www.cleverence.ru/support/97289/';
								|en = 'The error number is #INTEX001. There is no configured or active business process for this type of document. Configure the business process in the processing settings for 1C %1 or upload an arbitrary existing business process via the context menu by right-clicking. Learn more - https://www.cleverence.ru/support/97289/';
