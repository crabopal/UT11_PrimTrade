	ПараметрыВозврата = _ЛокКонтекст.ЛокЯдро_ВозвратДокументаВРаботу_СтруктураПараметровВызова();
	ПараметрыВозврата.ИдДокумента = ТекущиеДанные.Ид;
	ПараметрыВозврата.ШапкаДокумента = ТекущиеДанные.ШапкаДокумента;
	ПараметрыВозврата.ТипБазы = ТипБазы;
	ПараметрыВозврата.ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ВозвратДокументаВРаботу_Завершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ВозвратДокументаВРаботу_Начало(ПараметрыВозврата);
	
