								|be = 'Дадзеныя дакумента апрацаваны: %1. Ад карыстальніка: %2'; es = 'Datos del documento procesados: %1. Por usuario: %2'; ka = 'დოკუმენტის მონაცემები დამუშავებულია: %1. მომხმარებლისგან: %2'; kk = 'Құжат деректері өңделді: %1. Пайдаланушыдан: %2'; ro = 'Datele documentului au fost prelucrate: %1. De la utilizator: %2'; tr = 'Belge verileri işlenir: %1. Kullanıcıdan: %2'; uk = 'Дані документа оброблені: %1. Від користувача: %2'; uz = 'Hujjat ma''lumotlari qayta ishlanadi: %1. Foydalanuvchidan: %2'");
