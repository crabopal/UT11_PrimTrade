&НаКлиенте
Процедура ДокументыMSПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдВыбранногоДокументаМС = Элемент.ТекущиеДанные.Ид;
	Если Найти(ИдВыбранногоДокументаМС,"#")>0  Тогда
		ИдВыбранногоДокументаМС = Лев(ИдВыбранногоДокументаМС, Найти(ИдВыбранногоДокументаМС,"#")-1 );
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИнфоСтрокаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) 
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "otbor" Тогда
		СтандартнаяОбработка = Ложь;                                             	
		ОткрытьНастройкуОтбораДокументов();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "obnovit" Тогда
		СтандартнаяОбработка = Ложь;                                             	
		ПолучениеСпискаДокументовSMARTS(, ВыборкаДокументовMSБезОграничений);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "vse1C" Тогда
		СтандартнаяОбработка = Ложь;      
		ВыборкаДокументов1СБезОграничений = Истина;
		ПолучениеСпискаДокументов1С(ВыборкаДокументов1СБезОграничений);   
		ЗаполнитьИнформационныеСообщения1С();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "vseMS" Тогда
		СтандартнаяОбработка = Ложь;      
		ВыборкаДокументовMSБезОграничений = Истина;
		ПолучениеСпискаДокументовSMARTS(, ВыборкаДокументовMSБезОграничений);
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ЗапуститьПриложение(НавигационнаяСсылкаФорматированнойСтроки);			
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

// Завершает обновление формы после возврата SMARTS-документа в работу.
//
// Параметры:
//  ДокументВозвращен - Булево - Истина, если шапка документа обновлена.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры
//
&НаКлиенте
Процедура ВозвратДокументаВРаботу_Завершение(ДокументВозвращен, ДополнительныеПараметры) Экспорт
	
	Если ДокументВозвращен Тогда
		ЗаполнитьТаблицуДокументовSMARTS();
	Иначе
		пСообщение = НСтр("ru = 'Не удалось вернуть документ в работу.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры

