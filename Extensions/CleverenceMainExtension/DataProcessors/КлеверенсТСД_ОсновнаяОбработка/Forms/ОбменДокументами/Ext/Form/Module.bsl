&НаКлиенте
Процедура ОповещениеВопросУдалитьДокументСТСДЗавершение(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ДокументыКУдалению 	= ДокументыMS.НайтиСтроки(Новый Структура("Загружен", Истина));
		ОтмеченныеДокументы	= ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		Для Каждого Док Из ОтмеченныеДокументы Цикл
			ДокументыКУдалению.Добавить(Док);	
		КонецЦикла;
		
		Для Каждого ДокументКЗагрузке Из ДокументыКУдалению Цикл
			Если Найти(ДокументКЗагрузке.Состояние,"Завершен") =  0 Тогда
				Продолжить;	
			КонецЕсли;
			РезультатУдаления = _ЛокКонтекст.ЛокЯдро_УдалитьДокументНаСервереSMARTS(ДокументКЗагрузке.Ид);
			Сообщить(РезультатУдаления.Сообщение + " [" + ДокументКЗагрузке.Имя + "]"); 
			Строка = ДокументыMS.НайтиСтроки(Новый Структура("Ид",ДокументКЗагрузке.Ид));
			Если Строка.Количество() > 0 Тогда
				ДокументыMS.Удалить(Строка[0]);
			КонецЕсли;	
		КонецЦикла; 
		
	Иначе
		
		ЗагруженныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружен", Истина));
		ОтмеченныеДокументы	 = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
		Для Каждого Док Из ОтмеченныеДокументы Цикл
			ЗагруженныеДокументы.Добавить(Док);	
		КонецЦикла;
		
		Для Каждого ДокументКЗагрузке Из ЗагруженныеДокументы Цикл
			Если Найти(ДокументКЗагрузке.Состояние,"Завершен") =  0 Тогда
				Продолжить;	
			КонецЕсли;
			СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументКЗагрузке.Ид, Ложь);	
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСлужебная_ВыборДокументаДляЗагрузкиЗакрытие(ДокументДляЗаполнения, СтруктураПараметров) Экспорт
	Если ДокументДляЗаполнения = Неопределено Тогда
		СнятьПометкуЗагружатьВСтрокеТаблицыMS(СтруктураПараметров.ДокументКЗагрузке.Ид);
		ЗагрузитьВыбранныеДокументыВБазу1С();
	Иначе
		ЗагрузитьВыбранныеДокументыВБазу1С(СтруктураПараметров.ДокументКЗагрузке,СтруктураПараметров.ID_БизнесПроцесса,ДокументДляЗаполнения,СтруктураПараметров.ВсеВОдин);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныеДокументыВБазу1СВыборБПЗакрытие(РезультатВыбора, СтруктураПараметров) Экспорт
	
	Если ЗначениеЗаполнено(РезультатВыбора)
			И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		Если ЗначениеЗаполнено(РезультатВыбора.Данные.ID_БизнесПроцесса) Тогда
			ID_БизнесПроцесса = РезультатВыбора.Данные.ID_БизнесПроцесса;
			ЗагрузитьВыбранныеДокументыВБазу1С(СтруктураПараметров.ДокументКЗагрузке, ID_БизнесПроцесса,,СтруктураПараметров.ВсеВОдин);
		Иначе
			Сообщение = НСтр("ru = 'У выбранного бизнес-процесса ""%1"" не заполнен ID';
								|en = 'The selected business process ""%1"" has an ID not filled in';
								|be = 'У абранага бізнес-працэсу ""%1 "" не запоўнены ID'; es = 'El proceso de negocio ""%1 "" seleccionado no tiene ID'; ka = 'შერჩეულ ბიზნეს პროცესს ""%1 "" აქვს პირადობის მოწმობა, რომელიც არ არის შევსებული'; kk = 'Таңдалған бизнес-процестің ""%1 "" идентификаторы толтырылмаған'; ro = 'Procesul de afaceri selectat"" %1 "" are un ID care nu este completat'; tr = 'Seçilen iş sürecinin ""%1"" İD dolu değil'; uk = 'У обраного бізнес-процесу ""%1 "" не заповнений ID'; uz = 'Tanlangan biznes jarayonida ""%1 "" ID bilan to''ldirilmagan'");
			Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(РезультатВыбора.Данные.Название));
			Сообщить(Сообщение); 
			СнятьПометкуЗагружатьВСтрокеТаблицыMS(СтруктураПараметров.ДокументКЗагрузке.Ид);
			ЗагрузитьВыбранныеДокументыВБазу1С(,,,СтруктураПараметров.ВсеВОдин);
		КонецЕсли;
	Иначе
		Если СтруктураПараметров.ВсеВОдин Тогда //Если пользователь хотел загрузить все документы Клеверенс  в один док. 1С и отказался при выборе БП
			//ЗаполнитьТаблицуДокументовSMARTS();
		Иначе
			СнятьПометкуЗагружатьВСтрокеТаблицыMS(СтруктураПараметров.ДокументКЗагрузке.Ид);
			ЗагрузитьВыбранныеДокументыВБазу1С(,,,СтруктураПараметров.ВсеВОдин);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

