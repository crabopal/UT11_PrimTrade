					Иначе	
						ТекстВопроса = НСтр("ru = 'Удалить выбранные документы с ТСД?';
												|en = 'Delete selected documents from your Mobile device?'; be = 'Выдаліць выбраныя дакументы з Мабільнае прылада?'; es = 'Eliminar los documentos seleccionados de su dispositivo Móvil?'; ka = 'წაშალეთ შერჩეული დოკუმენტები თქვენი მობილური მოწყობილობიდან?'; kk = 'Таңдалған құжаттарды жойыңыз мобильді құрылғы?'; ro = 'Ștergeți documentele selectate de pe dispozitivul dvs. mobil?'; tr = 'Seçilen belgeleri Mobil cihazdan siliyor musunuz?'; uk = 'Видалити вибрані документи з мобільний пристрій?'; uz = 'Tanlangan hujjatlarni o''chirib tashlang mobil qurilma?'");	
					КонецЕсли;
					
					#Если ТолстыйКлиентОбычноеПриложение Тогда
						#Область НесовместимыйКодFresh
						Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
						ОповещениеВопросУдалитьДокументСТСДЗавершение(Ответ, Новый Структура("ДокументКЗагрузке,ВсеВОдин",ДокументКЗагрузке,ВсеВОдин));
						#КонецОбласти //НесовместимыйКодFresh
					#Иначе
						ОповещениеВопросПовторВыгрузки = Новый ОписаниеОповещения("ОповещениеВопросУдалитьДокументСТСДЗавершение", ЭтаФорма,Новый Структура("ДокументКЗагрузке,ВсеВОдин",ДокументКЗагрузке,ВсеВОдин));
						ПоказатьВопрос(ОповещениеВопросПовторВыгрузки, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
					#КонецЕсли
					
				Иначе
					
					Если ВсеВОдин Тогда
						ВыбранныеДокументы = ДокументыMS.НайтиСтроки(Новый Структура("Загружать", Истина));
						Для Каждого ДокументКЗагрузке Из ВыбранныеДокументы Цикл
							Если Найти(ДокументКЗагрузке.Состояние,"Завершен") =  0 Тогда
								Продолжить;	
							КонецЕсли;
							СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументКЗагрузке.Ид, Истина);	
						КонецЦикла;		
					Иначе
						СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументКЗагрузке.Ид, Истина);
					КонецЕсли;
					
					ЗагрузитьВыбранныеДокументыВБазу1С();
					
				КонецЕсли;				
			КонецЕсли;
	КонецЦикла;
	
	Если ЭтоПоследнийДокумент Тогда
		УстановитьДанныеТекущегоУзла(ID_Узла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВыбранныеДокументыКакОдинВБазуSMARTS(РезультатВопроса = Неопределено,ДополнительныеПараметры = Неопределено) Экспорт
	
	
КонецПроцедуры	
	
// Снимает флаг Загружать в таблицы документов Клеверенс после загрузки документа
// 
// Параметры:
// 	ДокументMS - Строка - Идентификатор загруженного документа Клеверенс
&НаКлиенте
Процедура СнятьПометкуЗагружатьВСтрокеТаблицыMS(ДокументMS, ПризнакЗагрузки = Неопределено)

	Строка = ДокументыMS.НайтиСтроки(Новый Структура("Ид",ДокументMS));
	
	Если Строка.Количество() > 0 Тогда
		Строка[0].Загружать = Ложь;	
		Если ПризнакЗагрузки <> Неопределено Тогда
			Строка[0].Загружен = ПризнакЗагрузки;	    
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

// Заполняет данные формы переданным объектом. Вызывается перед открытием формы загруженного документа.
// 
// Параметры:
// 	ДанныеФормы - ДанныеФормы - Данные открываемой формы 
// 	РезультатЗаписи - (См. ЛокЯдро_СформироватьИЗаписатьДокументВБазу1С_ПоID)
//	ТипСтруктура - Структура - Если тип данных формы является обычной структурой
//
&НаСервереБезКонтекста
Процедура ЗаполнитьДокументНаСервере(ДанныеФормы, РезультатЗаписи, ТипСтруктура = Ложь)
	
	Если ТипЗнч(РезультатЗаписи.Данные) = Тип("Строка") Тогда
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.УстановитьСтроку(РезультатЗаписи.Данные);
		Значение = ПрочитатьXML(ЧтениеХМЛ);
	Иначе
		Значение = РезультатЗаписи.Данные;
	КонецЕСли;
	
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Объект") Тогда
		Значение = Значение.Объект;
	КонецЕсли;
	
	Если ТипСтруктура Тогда
		ЗаполнитьЗначенияСвойств(ДанныеФормы, Значение);
	Иначе
		ЗначениеВДанныеФормы(Значение, ДанныеФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаСнятиеФлагаВыгрузкиВсехДокументов1С(ЗначениеФлага)
	
	Для Каждого СтрокаДокумента Из Документы1С Цикл		
		Если СтрокаДокумента.Выгружать = ЗначениеФлага Тогда
			Продолжить;	
		КонецЕсли;
		СтрокаДокумента.Выгружать = ЗначениеФлага;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(ЗначениеФлага)
	
	Для Каждого СтрокаДокумента Из ДокументыMS Цикл		
		Если СтрокаДокумента.Загружать = ЗначениеФлага Тогда
			Продолжить;	
		КонецЕсли;
		СтрокаДокумента.Загружать = ЗначениеФлага;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеТорговогоОбъекта()

	ДанныеТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла;
	
	Если ТипЗнч(ДанныеТекущегоУзла) = Тип("Структура") И ДанныеТекущегоУзла.Свойство("ID_Узла") И ДанныеТекущегоУзла.ID_Узла <> ID_Узла Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
		ID_ТекущегоУзла 	   = ДанныеТекущегоУзла.ID_Узла;
		НастройкиУзла 		   = Неопределено;
		
		ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
		Если ЕстьЧастнаяБаза Тогда
			ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
			Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
				НастройкиУзла = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы, "ID_Узла", ID_ТекущегоУзла);
			КонецЕсли;
		КонецЕсли;
		
		ID_Узла 		 = ID_ТекущегоУзла;
		ID_БазыMS 		 = ?(НастройкиУзла <> Неопределено И НастройкиУзла.ИспользоватьЧастнуюБазу, НастройкиУзла.ЧастнаяБазаMS, ПараметрыПодключенияMS.Ид);
		ТипБазы 		 = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
		НаименованиеУзла = ДанныеТекущегоУзла.Наименование;
		
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеУзла) Тогда
				Элементы.НаименованиеУзла.Видимость = Ложь;
			Иначе
				Элементы.НаименованиеУзла.Видимость = Истина;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьМассивКолонокНаНаличиеДублей(ТаблицаНастроекКолонок)

	МассивСодержитДубли = Ложь;
	
	КоличествоРеквизитов = ТаблицаНастроекКолонок.Количество();
	
	ТекущийИндекс = 0;
	Пока ТекущийИндекс < КоличествоРеквизитов Цикл
		Если ТаблицаНастроекКолонок[ТекущийИндекс].Свойство("ЭтоТаблицаЗначений") Тогда
			ТекущийИндекс = ТекущийИндекс + 1;
			Продолжить;
		КонецЕсли;
		
		ИмяТекущегоРеквизита = ТаблицаНастроекКолонок[ТекущийИндекс].Название;
		
		СледующийИндекс = ТекущийИндекс + 1;
		Пока СледующийИндекс < КоличествоРеквизитов Цикл
	    	Если ВРег(ИмяТекущегоРеквизита) = ВРег(ТаблицаНастроекКолонок[СледующийИндекс].Название) Тогда
				ТаблицаНастроекКолонок.Удалить(СледующийИндекс);	
				КоличествоРеквизитов = КоличествоРеквизитов - 1;
				
				МассивСодержитДубли = Истина;
			Иначе
				СледующийИндекс = СледующийИндекс + 1;
			КонецЕсли;
		КонецЦикла;
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
	Возврат МассивСодержитДубли;
	
КонецФункции

// Добавляет колонки на форму в таблицу документов SMARTS
// 
// Параметры:
// 	ВключенныеКолонки - Массив - Массив с описанием колонок
&НаСервере
Функция ДобавитьКолонкиТаблицыДокументовSMARTS(ВключенныеКолонки)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		МассивРеквизитов = Новый Массив;
		КС = Новый КвалификаторыСтроки(0);
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
		ТаблицаПолейВыбора = Элементы.ДокументыMS;
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			
			Если ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ДАТА") > 0
			ИЛИ ТекОбъект.ГлЯдро_СтрНайти(ВРЕГ(Колонка.Название), "ВРЕМЯ") > 0 Тогда
				ТипКолонки = Новый ОписаниеТипов("Дата");
			Иначе 
				ТипКолонки = ОписаниеТиповС;
			КонецЕсли;
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Название, ТипКолонки, "ДокументыMS"));
			
		КонецЦикла;
		
		Попытка
			ИзменитьРеквизиты(МассивРеквизитов);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			// Удалим реквизиты, которые не удалось добавить
			МассивУдаляемыхРеквизитов = Новый Массив;
			Для каждого УдаляемыйРеквизит ИЗ МассивРеквизитов Цикл
				МассивУдаляемыхРеквизитов.Добавить("ДокументыMS." + УдаляемыйРеквизит.Имя);
			КонецЦикла;
			ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
			
			Возврат ТекстОшибки;
		КонецПопытки;
		
		Для Каждого Колонка Из ВключенныеКолонки Цикл
			НовыйЭлемент = Элементы.Добавить("ДокументыMS" + Колонка.Название, Тип("ПолеФормы"), ТаблицаПолейВыбора);
			НовыйЭлемент.ПутьКДанным = "ДокументыMS." + Колонка.Название;
			НовыйЭлемент.Заголовок = Колонка.Представление;		
			НовыйЭлемент.Ширина = 5;
			НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
			Если Колонка.Название = "Количество" Тогда
				НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
			КонецЕсли;
		КонецЦикла; 
		
	#КонецЕсли
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПроверитьОтметкуВыгрузка()

	СтрокиКВыгрузке = Документы1С.НайтиСтроки(Новый Структура("Выгружать", Истина));
	
