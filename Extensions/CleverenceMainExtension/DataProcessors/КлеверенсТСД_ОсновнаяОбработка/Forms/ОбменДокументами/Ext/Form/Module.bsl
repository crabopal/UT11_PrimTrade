&НаКлиенте
Процедура ВыполнитьПослеВыбораПериода1С(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
        ПериодОтбора1С = Результат;	
		Если Не (ПериодОтбора1С.ДатаНачала = Дата(1, 1, 1) И ПериодОтбора1С.ДатаОкончания = Дата(1, 1, 1)) Тогда					
			ТекстПериодОтбора1С = Формат(ПериодОтбора1С.ДатаНачала, "ДФ=dd.MM.yyyy; ДП=...") 
			+ " - " + Формат(ПериодОтбора1С.ДатаОкончания, "ДФ=dd.MM.yyyy; ДП=...");    
			
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ГруппаПериодОтбора1С.Видимость = Истина;
			#КонецЕсли
		Иначе
			ТекстПериодОтбора1С = "";
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ГруппаПериодОтбора1С.Видимость = Ложь;
			#КонецЕсли
		КонецЕсли;
		
		ЗаполнитьТаблицуДокументов1С();
	КонецЕсли;  
	
КонецПроцедуры

