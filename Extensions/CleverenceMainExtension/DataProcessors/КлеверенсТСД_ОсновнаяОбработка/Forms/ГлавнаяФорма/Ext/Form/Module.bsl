&НаКлиенте
Процедура ОткрытьФормуВыбораИнтеграционнойОбработки()
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_НастройкиИнтеграционнойОбработки = ПолучитьФорму("ОФ_ФормаСлужебная_НастройкиОбработки",ЭтаФорма);
	#Иначе
		ФормаСлужебная_НастройкиИнтеграционнойОбработки = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_НастройкиОбработки", , ЭтаФорма);
	#КонецЕсли
	
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ВидОбработки = "ИнтеграционнаяОбработка";
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ВерсияОбработки = ВерсияИнтеграционнойОбработки;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.КонфигурацияИнтеграции = ПоддерживаемыеКонфигурации;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ПоддерживаемыеВерсии = ПоддерживаемыеВерсии;
	пПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	
	ТипОбработки = ?(пПараметрыПодключенияMS.Свойство("ТипОбработки"),пПараметрыПодключенияMS.ТипОбработки,"ФайлНаДиске");
	Если ТипОбработки = "ФайлНаДиске" Тогда 
		ФормаСлужебная_НастройкиИнтеграционнойОбработки.ПутьКОбработке = Строка(пПараметрыПодключенияMS.ПутьИнтеграционнойОбработки)+Строка(пПараметрыПодключенияMS.ИмяИнтеграционнойОбработки);
	Иначе
		ФормаСлужебная_НастройкиИнтеграционнойОбработки.ПутьКОбработке = пПараметрыПодключенияMS.ПутьИнтеграционнойОбработки;
	КонецЕсли;	
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ТипОбработки = ТипОбработки;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ID_ТекущейБазы = ID_ТекущейБазы;
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_НастройкиИнтеграционнойОбработкиЗакрытие",ЭтаФорма);
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_НастройкиИнтеграционнойОбработки.Открыть();		
КонецПроцедуры

// Получает из интеграционной обработки информацию совместимости и версию интеграции. 
// Обновляет отображение инофрмации на форме
&НаКлиенте
Процедура ОбновитьИнформациюОбИнтеграционнойОбработке()
	
	ИнформацияСовместимостиПолучена = Ложь;
	
	ИнтеграционнаяОбработкаПодключена = ЭтоАдресВременногоХранилища(_ЛокКонтекст._ИнтеграционнаяОбработкаАдрес);
	Если ИнтеграционнаяОбработкаПодключена Тогда
		ИнформацияСовместимости = _ЛокКонтекст.ЛокЯдро_ПолучитьИнформациюСовместимости();
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ИнформацияСовместимости", ИнформацияСовместимости);
		
		ИнформацияСовместимостиПолучена = НЕ ИнформацияСовместимости = Неопределено;
	КонецЕсли;
	
	ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	ТипОбработки = ?(ПараметрыПодключенияMS.Свойство("ТипОбработки"),ПараметрыПодключенияMS.ТипОбработки,"ФайлНаДиске");
	
	ЦветОшибки = "Ошибка";
	ЦветУспеха = "ОсновнойТекст";
	
	ЦветПутьИнтеграционнойОбработки 		= ЦветУспеха;
	ЦветВерсияИнтеграционнойОбработки		= ЦветУспеха;
	ЦветПоддерживаемыеКонфигурации 			= ЦветУспеха;
	ЦветПоддерживаемыеВерсии				= ЦветУспеха;
	
	ПоддерживаемыеКонфигурацииПодсказка 	= "";
	ПоддерживаемыеКонфигурации 				= "";
	ПоддерживаемыеВерсииПодсказка			= "";
	ПоддерживаемыеВерсии					= "";
	
	Если ИнформацияСовместимостиПолучена Тогда
		
		//ИнформацияСовместимости содержит следующие поля:
		//	ВерсияИнтеграции 					- Строка, код версии интеграционной обработки
		//	ВерсияAPI                           - Число, версия поддерживаемого API 
		//	ПоддерживаемаяКонфигурацияМассивИмен- Массив строк, Названия поддерживаемых конфигураций
		//	ПоддерживаемаяКонфигурацияСиноним 	- Строка, Человеческое название поддерживаемой конфигурации(или нескольких)
		//	флСоответствуетКонфигурации			- булево, результат проверки соответствия имени конфигурации, сама проверка происходит внутри интеграционной обработки, сюда должен приходить готовый результат
		//	ПоддерживаемыеВерсииКонфигурации	- Строка, диапазон поддерживаемых версий конфигураций
		//	флСоответствуетВерсии				- булево, результат проверки соответствия версии 
		//	КонфигурацияПоМетаданным			- Структура, Неопределено, результат определения конфигурации по метаданным,
		//	заполняется если ИО не соответствует конфигурации
		
		ПутьКОбработке = ИнформацияСовместимости.ПутьКФайлу;
		
		ВерсияИнтеграционнойОбработки = "API: v"+Строка(ИнформацияСовместимости.ВерсияAPI)+", "+ИнформацияСовместимости.ВерсияИнтеграции;
		ПоддерживаемыеКонфигурации 	= ИнформацияСовместимости.ПоддерживаемаяКонфигурацияСиноним;
		ПоддерживаемыеВерсии 			= ИнформацияСовместимости.ПоддерживаемыеВерсииКонфигурации;
		
		Если ТипОбработки = "ФайлНаДиске" Тогда
			Если ПараметрыПодключенияMS.ПутьИнтеграционнойОбработки = "REST_API" Тогда
				ПутьИнтеграционнойОбработки = НСтр("ru = 'Загружено по API: '");
				ПутьКОбработке = ПутьИнтеграционнойОбработки + ПараметрыПодключенияMS.ИмяИнтеграционнойОбработки;
			Иначе
				ПутьИнтеграционнойОбработки = НСтр("ru = 'Файл на диске:';
													|en = 'The file on yandex.disk:'; be = 'Файл на дыску:'; es = 'Archivo en el disco:'; ka = 'ფაილი yandex-ზე.დისკი:'; kk = 'Дискідегі Файл:'; ro = 'Fișierul de pe yandex. disk:'; tr = 'Diskteki dosya:'; uk = 'Файл на диску:'; uz = 'Diskdagi fayl:'");
				
				#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
					ПутьКОбработке = ПутьИнтеграционнойОбработки + Символы.ПС + СокращенноеПредставлениеПутиФайла(ПутьКОбработке);
				#Иначе
					ПутьКОбработке = ПутьИнтеграционнойОбработки + " " + СокращенноеПредставлениеПутиФайла(ПутьКОбработке);
				#КонецЕсли
				
			КонецЕсли;
		КонецЕсли;
		
		//Должно быть написано красным и в конце поля восклицательный знак (!) если интеграционная обработке - не подходит для данной конфигурации
		//А также, в аннотациях при наведении должно быть написано: "Подключенная конфигурации не поддерживается обработкой и может работать с ошибками, 
		//проверьте верно ли выбрана рабочая конфигурация 1С при установке +ИмяУстановленнойПрограммыБазы+".		
		//Должно быть написано красным и в конце поля восклицательный знак (!) если Метаданные.Версия - не входит в поддерживаемый диапазон
		//А также, в аннотациях при наведении должно быть написано: "Данная версия конфигурации не поддерживается и может работать с ошибками". 				
		КонфигурацияПоМетаданным = Неопределено;
		ИнформацияСовместимости.Свойство("КонфигурацияПоМетаданным", КонфигурацияПоМетаданным);
		КонфигурацияОпределенаПоМетаданным = КонфигурацияПоМетаданным <> Неопределено;
		
		Если НЕ ИнформацияСовместимости.флСоответствуетКонфигурации
			И КонфигурацияОпределенаПоМетаданным Тогда
			
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
				"ПодключеннаяИнтеграционнаяОбработкаОпределенаПоМетаданным",
				КонфигурацияПоМетаданным,
				"ПодключениеИО");
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			
			пСообщение = НСтр("ru = 'Текущая конфигурация 1С не указана в списке совместимости интеграционной обработки, но по метаданным определена как ""%1"" версии ""%2"".'");
			ПоддерживаемыеКонфигурацииПодсказка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение,
				КонфигурацияПоМетаданным.OneCConfigName,
				КонфигурацияПоМетаданным.OneCConfigVersion);
				
		ИначеЕсли НЕ ИнформацияСовместимости.флСоответствуетКонфигурации Тогда
			
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
				"ПодключеннаяИнтеграционнаяОбработкаДляДругойКонфигурации", 
				, 
				"ПодключениеИО");
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			
			ЦветПоддерживаемыеКонфигурации 	= ЦветОшибки;
			ПоддерживаемыеКонфигурации 			= ПоддерживаемыеКонфигурации + " (!)";
			
			пСообщение = НСтр("ru = 'Подключенная конфигурации не поддерживается обработкой и может работать с ошибками, %1 проверьте верно ли выбрана рабочая конфигурация 1С при установке «%2»';
								|en = 'The connected configuration is not supported by processing and may work with errors, %1 check if the 1C working configuration is selected correctly when installing %2';
								|uk = 'Підключена конфігурації не підтримується обробкою і може працювати з помилками, %1 Перевірте чи вірно обрана робоча конфігурація 1С при установці «%2»'");
			пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, Символы.ПС, ПараметрыПодключенияMS.Имя);
			ПоддерживаемыеКонфигурацииПодсказка = пСообщение;
			
			Сообщение = НСтр("ru = 'Ваша конфигурация 1С ""%1"" не поддерживается выбранной обработкой интеграции (поддерживаемые конфигурации: ""%2"").';
								|en = 'Your 1C configuration ""%1"" is not supported by the selected integration processing (supported configurations: ""%2"").';
								|be = 'Ваша канфігурацыя 1С "" %1 ""не падтрымліваецца абранай апрацоўкай інтэграцыі (падтрымліваюцца канфігурацыі:""%2"").'; es = 'Su configuración 1C "" %1 ""no es compatible con el procesamiento de integración seleccionado (configuraciones admitidas:""%2"").'; ka = 'თქვენი 1c კონფიგურაცია "" %1 ""არ არის მხარდაჭერილი შერჩეული ინტეგრაციის დამუშავებით (მხარდაჭერილი კონფიგურაციები:""%2"").'; kk = 'Сіздің 1С ""%1 "" конфигурацияңызға таңдалған интеграциялық өңдеу қолдау көрсетпейді (қолдау көрсетілетін конфигурациялар: ""%2"").'; ro = 'Configurația 1C ""%1 ""nu este acceptată de procesarea de integrare selectată (configurații acceptate:""%2"").'; tr = '1C ""%1"" yapılandırmanız, seçilen entegrasyon işlemi tarafından desteklenmemektedir (desteklenen yapılandırmalar: ""%2"").'; uk = 'Ваша конфігурація 1С "" %1 ""не підтримується обраною обробкою інтеграції (підтримувані конфігурації:""%2"").'; uz = 'Sizning 1C konfiguratsiyangiz ""%1"" tanlangan integratsion ishlov berish orqali qo''llab-quvvatlanmaydi (qo''llab-quvvatlanadigan konfiguratsiyalar: ""%2"").'")
			            + Символы.ПС
						+ НСтр("ru = 'Убедитесь что выбрана верная обработка интеграции. Проверьте базу Клеверенс на наличие обновлений.';
								|en = 'Make sure that the correct integration processing is selected. Check the Cleverence database for updates.';
