	КонецЕсли;
	
	СтруктураСостояния.СтатусЗапускаОсновнойОбработки = СтатусЗапускаОсновнойОбработки;
	Если СтруктураСостояния.Уровень < 5 Тогда
		СтруктураОшибокСостояний.Вставить(ОперацияПоСменеСтатуса, СтруктураСостояния);
	КонецЕсли;
	
	ОбновитьОтображениеПриСменеСтатуса();
	
КонецПроцедуры 

