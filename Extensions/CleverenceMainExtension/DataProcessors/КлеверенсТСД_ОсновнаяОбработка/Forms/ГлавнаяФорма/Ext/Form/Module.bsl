#Область СлужебныеПроцедурыИФункции

// Активизирует/открывает форму для настройки подключения к базе Клеверенс
//
// Параметры:
//	Результат - КодВозвратаДиалога - ответ на вопрос об открытии формы для настройки подключения
//	ДопПараметры - Произвольный
&НаКлиенте
Процедура ВопросОткрытьГлавнуюФормуЗавершение(Результат,ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнениеВнешнейКоманды = Ложь;
		Если ЭтаФорма.Открыта() Тогда
			ЭтаФорма.Активизировать();
		Иначе
			ЭтаФорма.Открыть();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СменитьСтатус(Параметр)
	
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		Возврат;	
	КонецЕсли;
	
	СтатусЗапускаОсновнойОбработки 	= Параметр.Статус;
	ПереданныйПараметр 				= Параметр.Параметр;
	ОперацияПоСменеСтатуса			= ?(Параметр.Свойство("Операция"), Параметр.Операция, "Служебное");
	Если Параметр.Свойство("ТипБазы") Тогда
		ТипБазы = Параметр.ТипБазы;
	Иначе
		ТипБазы = "Основная";
	КонецЕсли;
	
	СтруктураСостояния = ПолучитьСтруктуруСостоянияОбработки();
	
	// Уровни:
	//  0 - Загрузка
	//	1 - Критическая ошибка
	//	2 - Ошибка (на будущее)
	//	3 - Предупреждение
	//	4 - демо-режим
	//	5 - Успех, всё хорошо
	
	Если Ложь Тогда
		// Шаблон
		СтруктураСостояния.Уровень = 1;
		
		// Состояние
		пСообщение 	= НСтр("ru = 'текст';
							|en = 'text'; be = 'тэкст'; es = 'texto'; ka = 'ტექსტი'; kk = 'мәтін'; ro = 'textul'; tr = 'Metin'; uk = 'текст'; uz = 'matn'");
		СтруктураСостояния.ТекстСостоянияОбработки = пСообщение;
		
		СтруктураСостояния.КодОшибки = "код";
		
		// Описание
		пСообщение 	= НСтр("ru = 'текст';
							|en = 'text'; be = 'тэкст'; es = 'texto'; ka = 'ტექსტი'; kk = 'мәтін'; ro = 'textul'; tr = 'Metin'; uk = 'текст'; uz = 'matn'");
		СтруктураСостояния.ОписаниеСостоянияОбработки = пСообщение;
		
		// Ошибки
		Причина 		= НСтр("ru = 'текст';
							|en = 'text'; be = 'тэкст'; es = 'texto'; ka = 'ტექსტი'; kk = 'мәтін'; ro = 'textul'; tr = 'Metin'; uk = 'текст'; uz = 'matn'");
		Решение 		= НСтр("ru = 'текст';
							|en = 'text'; be = 'тэкст'; es = 'texto'; ka = 'ტექსტი'; kk = 'мәтін'; ro = 'textul'; tr = 'Metin'; uk = 'текст'; uz = 'matn'");
		СтруктураСостояния.ПричиныИРешенияОшибок.Вставить(Причина, Решение);
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки = "ОтсутствуютНастройкиПодключения" Тогда	
		
		// Шаблон
		СтруктураСостояния.Уровень = 1;
		
		// Состояние
		пСообщение 	= НСтр("ru = 'Подключение к базе Клеверенс не настроено';
							|en = 'Connection to the Cleverence database is not configured'; uk = 'Підключення до бази Cleverence не налаштовано'");
		СтруктураСостояния.ТекстСостоянияОбработки = пСообщение;
		
		СтруктураСостояния.ОсновноеДействие = "ОткрытьСписокПодключенныхБазMS";
		
		//пСообщение 	= НСтр("ru = 'Добавьте подключение к базе Клеверенс'; uk = 'Додайте підключення до бази Cleverence'; en = 'Add a connection to the Cleverence database'; ka = 'დაამატეთ კავშირი Cleverence მონაცემთა ბაზაში'; kk = 'Cleverence базасына қосылымды қосыңыз'; uz = ""Cleverence ma'lumotlar bazasiga ulanishni qo'shing""; be = 'Дадайце падключэнне да базы Cleverence'; tr = 'Cleverence veritabanına bağlantı ekleyin'; es = 'Agregue una conexión a la base de Cleverence'; ro = 'Adăugați o conexiune la baza de date Cleverence'");
		//Сообщение = Новый СообщениеПользователю;
		//Сообщение.Текст = пСообщение;
		//Сообщение.Поле = "ID_ТекущейБазы";
		//Сообщение.Сообщить();
		
	ИначеЕсли СтатусЗапускаОсновнойОбработки = "НачалоВыполненияПроцедурыЗапускаОбработки" Тогда
		
		СтруктураСостояния.Уровень = 0;
		
		// Состояние
		пСообщение 	= НСтр("ru = 'Загрузка обработки...';
							|en = 'Loading the processing...'; be = 'Загрузка апрацоўкі...'; es = 'Carga de procesamiento...'; ka = 'დამუშავების დატვირთვა...'; kk = 'Өңдеуді жүктеу...'; ro = 'Încărcarea procesării...'; tr = 'İşleme yükleniyor...'; uk = 'Завантаження обробки...'; uz = 'Qayta ishlashni yuklash...'");
