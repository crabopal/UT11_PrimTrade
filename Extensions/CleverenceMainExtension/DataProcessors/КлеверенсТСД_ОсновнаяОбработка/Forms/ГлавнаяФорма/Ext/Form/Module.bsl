	#КонецЕсли
	
	НастройкиУзла = Неопределено;
	Если ID_ТекущегоУзла <> "" Тогда
		НастройкиУзла = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(_ЛокКонтекст.ТекущиеНастройкиMS.Узлы, "ID_Узла", ID_ТекущегоУзла);
	КонецЕсли;
	
	ТипБазы = ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	
	ФормаСписка_ОтборыСправочников.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСписка_ОтборыСправочников._ЛокКонтекст 	= _ЛокКонтекст;
	ФормаСписка_ОтборыСправочников.ID_Узла 			= ID_ТекущегоУзла;
	ФормаСписка_ОтборыСправочников.ТипБазы 			= ТипБазы;
	ФормаСписка_ОтборыСправочников.НаименованиеУзла = _ЛокКонтекст.ДанныеТекущегоУзла.Наименование;	
	ФормаСписка_ОтборыСправочников.РежимОбмена 		= ДопПараметры.РежимОбмена;
	ФормаСписка_ОтборыСправочников.ВыгрузитьСправочникиПриОткрытии = ?(ДопПараметры <> Неопределено И ДопПараметры.Свойство("ВыгрузитьСправочникиПриОткрытии"),
		ДопПараметры.ВыгрузитьСправочникиПриОткрытии, Ложь);
	ФормаСписка_ОтборыСправочников.Открыть();
	
КонецПроцедуры

