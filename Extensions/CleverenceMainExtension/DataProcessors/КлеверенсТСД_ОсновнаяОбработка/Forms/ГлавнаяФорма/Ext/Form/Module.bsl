// Обновляет выпадающий список выбора текущего узла, всеми доступными узлами 
&НаКлиенте 
Процедура УстановитьСписокВыбораУзлов()
	
	Элементы.ID_ТекущегоУзла.СписокВыбора.Очистить();
	
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			Конецесли;
			Элементы.ID_ТекущегоУзла.СписокВыбора.Добавить(СтрокаУзла.ID_Узла, СтрокаУзла.Наименование);
		КонецЦикла;
		Элементы.ID_ТекущегоУзла.СписокВыбора.СортироватьПоПредставлению();
	КонецЕсли;
	
	// Добавление и открытие настроек узлов разрешаем только админам
	Если ДоступноИзменениеНастроек Тогда
		пСообщение = НСтр("ru = '+ Добавить торговый объект';
							|en = '+ Add a shopping facility'; be = '+ Дадаць гандлёвы аб''ект'; es = '+ Añadir objeto comercial'; ka = '+ დაამატეთ სავაჭრო ობიექტი'; kk = '+ Сауда нысанын қосыңыз'; ro = '+ Adăugați o facilitate de cumpărături'; tr = '+ Ticari nesne ekle'; uk = '+ Додати торговий об''єкт'; uz = '+ Savdo ob''ektini qo''shing'");
		Элементы.ID_ТекущегоУзла.СписокВыбора.Добавить("ДобавитьУзел", пСообщение);
	КонецЕсли;
	
КонецПроцедуры

