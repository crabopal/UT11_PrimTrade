		// Возвращаем просто имя файла
		Возврат "...\" + МассивСегментов[МассивСегментов.ВГраница()];
		
		// Алгоритм форматирования пути с вырезом средней части: C:\...\ИнтеграционнаяОбработка_УТ_10_3.epf
		КоличествоСегментов = МассивСегментов.Количество();
		
		Если НЕ КоличествоСегментов % 2 = 0 Тогда
			ГраницаСегмента = (КоличествоСегментов - 1) / 2 - 1;
		Иначе
			ГраницаСегмента = КоличествоСегментов / 2 - 1;
		КонецЕсли;
		
		ИндексЛевогоСегмента = 0;
		ИндексПравогоСегмента = КоличествоСегментов - 1;
		
		Для ИндексЛевогоСегмента = 0 По ГраницаСегмента Цикл
			
			ЛевыйСегмент 	= МассивСегментов[ИндексЛевогоСегмента];
			ПравыйСегмент 	= МассивСегментов[ИндексПравогоСегмента];
			
			пЛеваяЧасть = ЛеваяЧасть + ЛевыйСегмент + "\";
			пПраваяЧасть = "\" + ПравыйСегмент + ПраваяЧасть;
			
			Если СтрДлина(пЛеваяЧасть + "..." + ПраваяЧасть) > МаксДлинна
				И ИндексЛевогоСегмента > 0 Тогда
				Прервать;
			Иначе
				ЛеваяЧасть = пЛеваяЧасть;
			КонецЕсли;
			
			Если СтрДлина(пЛеваяЧасть + "..." + пПраваяЧасть) > МаксДлинна 
				И ИндексПравогоСегмента < КоличествоСегментов - 1 Тогда
				Прервать;
			Иначе
				ЛеваяЧасть = пЛеваяЧасть;
				ПраваяЧасть = пПраваяЧасть;
				ИндексПравогоСегмента = ИндексПравогоСегмента - 1;
			КонецЕсли;
			
		КонецЦикла;
		
		ПредставлениеПути = ЛеваяЧасть + "..." + ПраваяЧасть;
		
	Иначе
		ПредставлениеПути = ПутьКФайлу;
	КонецЕсли;
	
	Возврат ПредставлениеПути;
	
КонецФункции 

// Выгружает  в базу SMARTS все отмеченные справочники 
// 
// Параметры:
//	СерверДоступен - Булево - флаг доступности сервера Клеверенс
//	ДопПараметры - Произвольный
&НаКлиенте
Процедура ВыгрузитьСправочники(СерверДоступен, ДопПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеВопросВыгрузитьСправочникиЗавершение = Новый ОписаниеОповещения("ВопросВыгрузитьСправочникиЗавершение", ЭтаФорма, ДопПараметры);
	ТекстВопроса = НСтр("ru = 'Выгрузить справочники?';
							|en = 'Should I upload the reference books?'; be = 'Выгрузіць даведнікі?'; es = '¿Descargar manuales?'; ka = 'უნდა ატვირთო საცნობარო წიგნები?'; kk = 'Анықтамалықтарды түсіру керек пе?'; ro = 'Ar trebui să încarc cărțile de referință?'; tr = 'Referans kitaplarını boşaltmak mı?'; uk = 'Вивантажити довідники?'; uz = 'Kataloglarni tushirasizmi?'");
	ПоказатьВопрос(ОповещениеВопросВыгрузитьСправочникиЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	
КонецПроцедуры

&НаКлиенте 
Процедура ВопросВыгрузитьСправочникЗавершение(РезультатВопроса, ТекущаяСтрокаНастройки) Экспорт
	
	ИмяСобытия = "ВопросВыгрузитьСправочникЗавершение";
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// <Лог>
	логПоток 	= _ЛокКонтекст.ЛогОткрытьПоток(ИмяСобытия, ЭтаФорма);
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,, "ИмяСправочника,ПараметрыВыгрузки", ТекущаяСтрокаНастройки.ИмяТаблицы, ТекущаяСтрокаНастройки.ПараметрыВыгрузки);
	логСобытие 	= _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	СтрокаПараметров = Новый Структура;
	СтрокаПараметров.Вставить("ИмяСправочника", ТекущаяСтрокаНастройки.ИмяТаблицы);
	СтрокаПараметров.Вставить("ПараметрыВыгрузки", ТекущаяСтрокаНастройки.ПараметрыВыгрузки);
	
	ПараметрыВыгрузкиСправочников = Новый Массив;
	ПараметрыВыгрузкиСправочников.Добавить(СтрокаПараметров);			
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьСправочникиНаСерверSMARTS(ПараметрыВыгрузкиСправочников);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
	// </Лог>
	
КонецПроцедуры

// Выгружает список бизнес-процессов в базу SMARTS
&НаКлиенте
Процедура ВыгрузитьБизнесПроцессы()
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");	
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда			
		Возврат;
	КонецЕсли; 	
	
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	Если _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "БизнесПроцессы") <> Неопределено Тогда
		ИмяТаблицыБП = "БизнесПроцессы";
	Иначе
		ИмяТаблицыБП = "BusinessProcesses";		
	КонецЕсли;
	
	// Выгружаются все строки бизнес процессов, которые имеют статус включен в таблицу БизнесПроцессы базы смартс.
	ТаблицаДляВыгрузки = Новый Массив;
	Для Каждого СтрокаНастройки ИЗ НастройкиБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") ИЛИ НЕ СтрокаНастройки.Используется Тогда
			Продолжить;
		КонецЕсли;
		
		Настройка = Новый Структура();
		Если ИмяТаблицыБП = "БизнесПроцессы" Тогда
			Настройка.Вставить("Ид",							СтрокаНастройки.ID_БизнесПроцесса);
			Настройка.Вставить("Наименование",					СтрокаНастройки.Название);
			Настройка.Вставить("ТипДокументаMobileSMARTS",		СтрокаНастройки.ТипДокументаMS);
			Настройка.Вставить("ТипИсходногоДокумента",			СтрокаНастройки.ТипИсходногоДокумента1С);
			Настройка.Вставить("ТипРезультирующегоДокумента",	СтрокаНастройки.ТипРезультирующегоДокумента1С);
		Иначе
			Настройка.Вставить("Id",							СтрокаНастройки.ID_БизнесПроцесса);
			Настройка.Вставить("Name",							СтрокаНастройки.Название);
			Настройка.Вставить("MSDocumentType",				СтрокаНастройки.ТипДокументаMS);
			Настройка.Вставить("SourceDocumentType",			СтрокаНастройки.ТипИсходногоДокумента1С);
			Настройка.Вставить("ResultDocumentType",			СтрокаНастройки.ТипРезультирующегоДокумента1С);
			Настройка.Вставить("Description",					СтрокаНастройки.Комментарий);
		КонецЕсли;
		ТаблицаДляВыгрузки.Добавить(Настройка);
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьПодготовленнуюТаблицуНаСерверSMARTS(ИмяТаблицыБП, ТаблицаДляВыгрузки, ID_ТекущейБазы);
	
КонецПроцедуры	

// Формирует список допустимых ключей параметров запуска программы 1С 
// 
// Параметры:
// 	ПараметрЗапуска - Строка - Параметр запуска
//
// Возвращаемое значение:
// 	Булево - Параметр запуска найден в исклбчениях
&НаКлиенте
Функция ПараметрЗапускаИсключение(ПараметрЗапуска)
	
	СписокИсключений = Новый СписокЗначений;
	СписокИсключений.Добавить("/С ЗапуститьОбновлениеИнформационнойБазы"); //УТАП 10.3 всегда запускает с таким параметром
	СписокИсключений.Добавить("ОбновитьКомпоненту");                       // Далион УМ
	
	
	ЗначениеНайдено = Не (СписокИсключений.НайтиПоЗначению(ПараметрЗапуска) = Неопределено);
	
	Возврат ЗначениеНайдено;
	
КонецФункции

// Формирует структуру с метаданными базы 1С
// 
// Возвращаемое значение:
// 	Структура - структура с метаданными
&НаСервере
Функция ПолучитьДанныеДляПервогоЗапуска()
	
	СисИнфо = Новый СистемнаяИнформация;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПодключеннаяБазаИмяКонфигурации1С",	  СокрЛП(Метаданные.Имя));
	СтруктураПараметров.Вставить("ПодключеннаяБазаСинонимКонфигурации1С", СокрЛП(Метаданные.Синоним)); 
	СтруктураПараметров.Вставить("ПодключеннаяБазаВерсияПлатформы1С",	  СокрЛП(СисИнфо.ВерсияПриложения));
	СтруктураПараметров.Вставить("ПодключеннаяБазаВерсияКонфигурации1С",  СокрЛП(Метаданные.Версия));
	
	Возврат СтруктураПараметров;
	
КонецФункции

// Инициализирует форму локального контекста и заполняет в переменную формы
&НаКлиенте
Процедура СоздатьЛокКонтекст()
	
	Автотесты_НачатьЗамерПроизводительности("СоздатьЛокКонтекст");
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		_ЛокКонтекст = Объект.ПолучитьФорму("ОФ_ЛокальныйКонтекст", ЭтаФорма);
	#Иначе
		_ЛокКонтекст = ПолучитьФорму(ПолноеИмяОбъекта + ".Форма.ЛокальныйКонтекст", , ЭтаФорма);
	#КонецЕсли
	_ЛокКонтекст.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	_ЛокКонтекст.ОбъектСсылка 					= ОбъектСсылка;
	
	Автотесты_ЗавершитьЗамерПроизводительности("СоздатьЛокКонтекст", "СоздатьЛокКонтекст");
	
КонецПроцедуры

// Открывает форму настройки подключения к базе SMARTS
&НаКлиенте
Процедура ОткрытьФормуНастройкиПодключения()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения = ПолучитьФорму("ОФ_ФормаСлужебная_НастройкиПодключения",ЭтаФорма);
	#Иначе
		СтруктураПараметров = Новый Структура;
		ЭтоВебКлиент = Ложь;
		#Если ВебКлиент Тогда
			ЭтоВебКлиент = Истина;
		#КонецЕсли
        СтруктураПараметров.Вставить("ЭтоВебКлиент", ЭтоВебКлиент);

		ФормаНастройкиПодключения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_НастройкиПодключения", СтруктураПараметров, ЭтаФорма, ЭтаФорма);
		ФормаНастройкиПодключения.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаНастройкиПодключения.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне;
	#КонецЕсли
	
	СтруктураПараметров = Новый Структура("ПараметрыПодключения, Компонента, ТипИнтерфейса, РежимВыбораБазы");
	
	ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
	Если ЕстьЧастнаяБаза Тогда
		// Получаем настройки подключения частной базы из соответствующей переменной
		СтруктураПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("СтруктураПодключенияЧастнойБазыMS");
		Если СтруктураПодключенияMS <> Неопределено Тогда
			СтруктураПараметров.ПараметрыПодключения = СтруктураПодключенияMS.ОписаниеБазы;
		Иначе
			СтруктураПараметров.ПараметрыПодключения = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		КонецЕсли;		
	Иначе
		СтруктураПараметров.ПараметрыПодключения	= _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		СтруктураПараметров.Компонента				= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
		СтруктураПараметров.ТипИнтерфейса			= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
		СтруктураПараметров.РежимВыбораБазы			= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РежимВыбораБазы");
	КонецЕсли;
	
	ФормаНастройкиПодключения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройкиПодключения._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаНастройкиПодключения.ТипБазы						= ?(ЕстьЧастнаяБаза, "Частная", "Основная");
	ФормаНастройкиПодключения.ПараметрыПодключения			= СтруктураПараметров.ПараметрыПодключения;
	ФормаНастройкиПодключения.Компонента					= СтруктураПараметров.Компонента;
	ФормаНастройкиПодключения.ТипИнтерфейса					= СтруктураПараметров.ТипИнтерфейса;
	ФормаНастройкиПодключения.РежимВыбораБазы				= СтруктураПараметров.РежимВыбораБазы;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения.ОткрытьМодально();
	#Иначе
		ФормаНастройкиПодключения.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСпискаПодключенныхБазMS(ОткрытьФормуПодключения = Ложь)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСпискаПодключенныхБазMS = ПолучитьФорму("ОФ_ФормаСписка_ПодключенныеБазыMS", ЭтаФорма);
	#Иначе
		ФормаСпискаПодключенныхБазMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПодключенныеБазыMS", , ЭтаФорма, "ФормаСписка_ПодключенныеБазыMS");	
	#КонецЕсли
	
	ФормаСпискаПодключенныхБазMS.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСпискаПодключенныхБазMS._ЛокКонтекст = _ЛокКонтекст;
	ФормаСпискаПодключенныхБазMS.ID_ТекущейБазы = ID_ТекущейБазы;
	ФормаСпискаПодключенныхБазMS.ОткрытьФормуПодключения = ОткрытьФормуПодключения;
	
	ФормаСпискаПодключенныхБазMS.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСпискаУзлов(ОткрытьФормуРедактированияУзла = Ложь) Экспорт
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСписка_Узлы = ПолучитьФорму("ОФ_ФормаСписка_Узлы", ЭтаФорма);
	#Иначе
		ФормаСписка_Узлы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_Узлы", , ЭтаФорма);	
	#КонецЕсли
	
	ФормаСписка_Узлы.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСписка_Узлы._ЛокКонтекст = _ЛокКонтекст;
	ФормаСписка_Узлы.ID_ТекущейБазы = ID_ТекущейБазы;
	ФормаСписка_Узлы.ОткрытьФормуРедактированияУзла = ОткрытьФормуРедактированияУзла;
	ФормаСписка_Узлы.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтруктуруПараметровЗапуска()
	
	СтруктураПараметровЗапуска = Новый Структура;
	
	Если Найти(ВРег(ПараметрЗапуска), "TESTCLIENT") Тогда
		СтруктураПараметровЗапуска.Вставить("ЭтоТестКлиент", Истина);
	КонецЕсли;
	Если Найти(ВРег(ПараметрЗапуска), "НЕЗАПУСКАТЬФОНОВЫЕЗАДАНИЯ") Тогда
		СтруктураПараметровЗапуска.Вставить("НеЗапускатьФоновыеЗадания", Истина);
	Иначе
		СтруктураПараметровЗапуска.Вставить("НеЗапускатьФоновыеЗадания", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПризнакДоступностиВыполненияВФоне()

	_ЛокКонтекст.ДоступноВыполнениеВФоне = ДоступноВыполнениеВФоне; // Передаем признак в лок контекст
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", ДоступноВыполнениеВФоне); // Записываем в кэш

КонецПроцедуры

&НаСервере
Функция ЕстьПравоАдминистрированияДанных() 
	Возврат ПравоДоступа("АдминистрированиеДанных", Метаданные);
КонецФункции

&НаКлиенте
Процедура ОбновитьИнформациюОРасширениях()
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		пСообщение = НСтр("ru = 'Начало';
							|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ОбновитьИнформациюОРасширениях", "Информация", пСообщение, НачалоСобытия);
		
		СостояниеРасширений 	= _ЛокКонтекст.ЛокЯдро_ПолучитьСостояниеПодключенныхРасширений();
		ПодключенныеРасширения 	= СостояниеРасширений.ИнформацияТекст;
		ДанныеРасширений 		= СостояниеРасширений.ХешСуммыРасширений;
		
		МассивОтключитьБезопасныйРежим = Новый Массив;
		ТекстОбновленныеРасширения = "";
		
		Для Каждого ДанныеРасширения Из ДанныеРасширений Цикл
			
			Если ДанныеРасширения.Значение.БезопасныйРежим ИЛИ ДанныеРасширения.Значение.ЗащитаОтОпасныхДействий Тогда
				МассивОтключитьБезопасныйРежим.Добавить(ДанныеРасширения.Ключ);
			КонецЕсли;
			
			Если ДанныеРасширения.Значение.Обновлено Тогда
				ТекстОбновленныеРасширения = ТекстОбновленныеРасширения
					+ Символы.ПС + "- " + ДанныеРасширения.Значение.Синоним;
			КонецЕсли;
			
			Если ДанныеРасширения.Значение.Отключено Тогда
				ШаблонСообщения = НСтр("ru = 'Не удалось подключить расширение конфигурации: %1';
										|en = 'Couldn''t connect configuration extension: %1'; be = 'Не ўдалося падключыць пашырэнне канфігурацыі: %1'; es = 'No se pudo conectar la extensión de configuración: %1'; ka = 'ვერ დააკავშირებს კონფიგურაციის გაფართოება: %1'; kk = 'Конфигурация кеңейтімін қосу мүмкін болмады: %1'; ro = 'Nu s-a putut conecta extensia de configurare: %1'; tr = 'Yapılandırma uzantısı bağlanamadı: %1'; uk = 'Не вдалося підключити розширення конфігурації: %1'; uz = 'Konfiguratsiya kengaytmasini ulab bo''lmadi: %1'");
				ТекстСообщения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ШаблонСообщения, ДанныеРасширения.Значение.Синоним);
				
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = ТекстСообщения;
				СообщениеПользователю.Сообщить();
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивОтключитьБезопасныйРежим.Количество() Тогда
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр",
				"РасширенияВБезопасномРежиме",
				МассивОтключитьБезопасныйРежим);
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ТекстОбновленныеРасширения) Тогда
			
			Если ОбновлениеРасширенийПоказано = Истина
				ИЛИ СпособЗапуска <> "Обычный" Тогда
				// Предупреждение уже было показано
				Возврат;
			КонецЕсли;
			
			ОбновлениеРасширенийПоказано = Истина;
			
			СтруктураСменыСтатуса = Новый Структура("Статус, Параметр",
				"ТребуетсяПерезапускДляПримененияРасширений",
				"");
			Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			
			Если НЕ Найти(ПараметрЗапуска, "КлеверенсАвтотесты.") Тогда
				ПоказатьПредупреждениеОбОбновленииРасширений(ТекстОбновленныеРасширения);
			КонецЕсли;
			
		КонецЕсли;
		
		пСообщение = НСтр("ru = 'Конец';
							|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ОбновитьИнформациюОРасширениях", "Информация", пСообщение, НачалоСобытия);
	Исключение
		ВызватьИсключение("Основная обработка была актуализирована. Требуется перезапустить новую версию из справочника.");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеОбОбновленииРасширений(ТекстПодключенныеРасширения)

	Если ВыполнениеВнешнейКоманды = Истина Тогда
		// При работе с кнопками просто выводим сообщение о необходимости перезапуска
		ТекстСообщения = НСтр("ru = 'Требуется перезапуск программы 1С для применения подключенных расширений.';
								|en = 'A restart of the 1C program is required to apply the connected extensions.';
								|be = 'Патрабуецца перазапуск праграмы 1С для прымянення падлучаных пашырэнняў.'; es = 'Es necesario reiniciar el programa 1C para aplicar las extensiones conectadas.'; ka = 'დაკავშირებული გაფართოებების გამოსაყენებლად საჭიროა 1c პროგრამის გადატვირთვა.'; kk = 'Қосылған кеңейтімдерді қолдану үшін 1С бағдарламасын қайта іске қосу қажет.'; ro = 'Este necesară o repornire a programului 1C pentru a aplica extensiile conectate.'; tr = 'Bağlı uzantıları uygulamak için 1C programını yeniden başlatmanız gerekir.'; uk = 'Потрібно перезапуск програми 1С для застосування підключених розширень.'; uz = 'Ulangan kengaytmalarni qo''llash uchun 1C dasturini qayta ishga tushirish talab qilinadi.'");
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
	Иначе
		ТекстПредупрежденияНачало = НСтр("ru = 'Были загружены новые расширения:';
											|en = 'New extensions have been uploaded:'; be = 'Новыя пашырэння былі загружаныя:'; es = 'Se han cargado nuevas extensiones:'; ka = 'ატვირთულია ახალი გაფართოებები:'; kk = 'Жаңа кеңейтімдер жүктелді:'; ro = 'Au fost încărcate noi extensii:'; tr = 'Yeni uzantılar yüklendi:'; uk = 'Були завантажені нові розширення:'; uz = 'Yangi kengaytmalar Yuklandi:'");
		ТекстПредупрежденияКонец  = НСтр("ru = 'Перезапустить программу 1С с учетом сделанных изменений?';
											|en = 'Should I restart the 1C program taking into account the changes made?';
											|be = 'Перазапусціць праграму 1С з улікам зробленых змяненняў?'; es = '¿Reiniciar el programa 1C teniendo en cuenta los cambios realizados?'; ka = 'უნდა გადატვირთოთ 1c პროგრამა განხორციელებული ცვლილებების გათვალისწინებით?'; kk = 'Жасалған өзгерістерді ескере отырып, 1С бағдарламасын қайта іске қосыңыз?'; ro = 'Ar trebui să repornesc programul 1C ținând cont de modificările făcute?'; tr = 'Yapılan değişiklikleri dikkate alarak 1C programını yeniden başlatıyor musunuz?'; uk = 'Перезапустити програму 1С з урахуванням зроблених змін?'; uz = 'O''zgarishlarni hisobga olgan holda 1C dasturini qayta ishga tushirasizmi?'");
		ТекстПредупреждения 	  
			= ТекстПредупрежденияНачало
			+ ТекстПодключенныеРасширения
			+ Символы.ПС
			+ Символы.ПС
			+ ТекстПредупрежденияКонец;
				
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПерезапускПрограммыПослеОтветаНаВопрос", ЭтаФорма);
				
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, 	 "Перезапустить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			
		ПоказатьВопрос(ОписаниеОповещения, ТекстПредупреждения, СписокКнопок,, КодВозвратаДиалога.Да, _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруСостоянияОбработки()
	
	СтруктураСостояния = Новый Структура;
	СтруктураСостояния.Вставить("Уровень", 							5);
	СтруктураСостояния.Вставить("ТекстСостоянияОбработки", 			"");
	СтруктураСостояния.Вставить("ОписаниеСостоянияОбработки", 		"");
	СтруктураСостояния.Вставить("ПричиныИРешенияОшибок", 			Новый Соответствие);
	СтруктураСостояния.Вставить("ПоказыватьСсылкуТП", 				Ложь);
	СтруктураСостояния.Вставить("ОсновноеДействие", 				"ПерезапуститьОбработку");
	СтруктураСостояния.Вставить("КодОшибки", 						"");
	СтруктураСостояния.Вставить("СтатусЗапускаОсновнойОбработки", 	"");
	
	Возврат СтруктураСостояния;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьСсылкуНаВнешнийРесурс(ИмяРесурса)
	
	Ссылка = "https://www.cleverence.ru/support/";
	
	Если ИмяРесурса = "БазаЗнаний" Тогда
		Ссылка = "https://www.cleverence.ru/support/";
		
	ИначеЕсли ИмяРесурса = "БазаЗнанийРаботаИО" Тогда
		Ссылка = "https://www.cleverence.ru/support/67266/";
		
	ИначеЕсли ИмяРесурса = "БазаЗнанийРаботаОО" Тогда
		Ссылка = "https://www.cleverence.ru/support/50247/"; 
		
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции 

#Область ОбновлениеXML

&НаКлиенте
Процедура ОбновлениеXML_ОбновитьCustomSettingsDflt()
	
	// Пример параметра запуска: "КлеверенсОбновлениеXML.ПутьФайла:C:\ProgramData\Cleverence\1C_DefaultSettings\ut114.xml"	
	ИмяОперации 	= "КлеверенсОбновлениеXML.ПутьФайла:";
	ИндексОперации 	= Найти(ВРег(ПараметрЗапуска), ВРег(ИмяОперации));	
	
	Если ИндексОперации = 0 Тогда
		Сообщить("Не найден путь к файлу");
		Возврат;
	КонецЕсли;
	
	// Ищем переданный в параметре путь
	ПутьКФайлуНастроек 	= Сред(ПараметрЗапуска, ИндексОперации + СтрДлина(ИмяОперации));
	ИндексОкончания = Найти(ПутьКФайлуНастроек, "xml");
	Если ИндексОкончания <> 0 Тогда
		// Обрезаем до знака окончания пути, т.к. началась другая операция
		ПутьКФайлуНастроек = Лев(ПутьКФайлуНастроек, ИндексОкончания + 3);
	КонецЕсли;
	
	ПередаваемыеФайлы = Новый Массив;
	ПередаваемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьКФайлуНастроек));
	
	ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ОбновлениеXML_ОбновитьCustomSettingsDfltЗавершение", ЭтаФорма);
	
	ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("ОповещениеОбработкиЗавершения", ОповещениеОбработкиЗавершения);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Идентификатор = Новый УникальныйИдентификатор();
	#Иначе
		Идентификатор = ЭтаФорма.УникальныйИдентификатор;
	#КонецЕсли
	
	_ЛокКонтекст.ЛокЯдро_ОбновлениеXML_ОбновитьCustomSettingsDflt(ПередаваемыеФайлы, Идентификатор, ПараметрыОбновления);
	
КонецПроцедуры 

