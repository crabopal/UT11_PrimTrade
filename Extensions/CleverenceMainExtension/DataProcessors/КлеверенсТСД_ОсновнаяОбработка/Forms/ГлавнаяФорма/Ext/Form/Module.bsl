&НаСервереБезКонтекста
Функция ПолучитьИменаСобытийЖурналаРегистрации()
	
	События = ПолучитьЗначенияОтбораЖурналаРегистрации("Событие").Событие;
	
	МассивСобытий = Новый Массив;
	
	Для каждого КлючЗначение Из События Цикл
		
		Если Найти(КлючЗначение.Ключ, "КлеверенсТСД") Тогда
			МассивСобытий.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСобытий;
	
КонецФункции 

&НаСервере
Функция ПолучитьВнешнююКартинкуНаСервере(ИмяКартинки) Экспорт
	
	ИмяЭлемента = "Картинка" + СтрЗаменить(ИмяКартинки, "Картинка", "");
	
	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат Элементы[ИмяЭлемента].Картинка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

