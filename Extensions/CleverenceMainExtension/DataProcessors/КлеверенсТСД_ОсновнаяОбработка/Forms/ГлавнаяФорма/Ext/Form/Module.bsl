///////////////////////////////////////////////////////////////////////////////
// Модуль формы содержит:
// - обработчики событий формы, команд и элементов формы;
// - служебные процедуры и функции;
// - прочее.
///////////////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
Перем ТекущаяБазаСуществует; 
Перем ТекущаяБаза;

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст;
#КонецЕсли

&НаКлиенте
Перем МиграцияНастроекПодключенияВыполнена;
&НаКлиенте 
Перем РегламентныеЗаданияВыполнены;

&НаКлиенте
Перем ID_ТекущегоУзлаПредыдущееЗначение;

&НаКлиенте
Перем ВыполнениеВнешнейКоманды,
	ИдентификаторВнешнейКоманды,
	ОбъектыНазначенияВнешнейКоманды;

&НаКлиенте
Перем ПередаваемыеПараметры Экспорт;

&НаКлиенте
Перем СтруктураПараметровЗапуска,
	ЗапускПоИмениФайла,
	ЗапускПоИмениФайла_НеПроверятьИмяФайла,
	ВыполнятьЗамеры,
	КэшШапкаЛога,
	ОбновлениеРасширенийПоказано;
	
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// +++ Служебные замеры производительности
	СтруктураЗамера = Новый Структура;
	СтруктураЗамера.Вставить("НачалоЗамера", ТекущаяУниверсальнаяДатаВМиллисекундах());
	СтруктураЗамера.Вставить("ЗавершенияЗамера", Новый Соответствие);
	ДанныеЗамеровПроизводительности = Новый Структура;
	ДанныеЗамеровПроизводительности.Вставить("ПриСозданииНаСервере", СтруктураЗамера);
	// --- Служебные замеры производительности
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		РеквизитОбъект 			= РеквизитФормыВЗначение("Объект");
		ПолноеИмяОбъекта 		= РеквизитОбъект.Метаданные().ПолноеИмя();
		
		// Если основная обработка запускается из справочника, 
		// то параметр ДополнительнаяОбработкаСсылка содержит ссылку на доп обработку. Запишем ее в реквизит
		ОбъектСсылка = Параметры.ДополнительнаяОбработкаСсылка;
		
		ДоступноИзменениеНастроек = ЕстьПравоАдминистрированияДанных();
		
		// Временное решение. 
		// Сразу добавляем элементы для ошибок, что бы избежать многократного вызова сервера при смене статуса
		КоличествоРезерв = 6;
		ИндексЭлемента = 2; // Начинаем с 2, т.к первый уже добавлен
		Пока ИндексЭлемента <= КоличествоРезерв Цикл
			
			НоваяГруппаСтрока 	= Элементы.Добавить("ГруппаИнформация_ПричиныИРешенияОшибок_Строка" + ИндексЭлемента, Тип("ГруппаФормы"), Элементы.ГруппаИнформация_ПричиныИРешенияОшибок);
			ЗаполнитьЗначенияСвойств(НоваяГруппаСтрока, Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Строка,, "ПутьКДаннымЗаголовка");
			
			НоваяПричина 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Причина" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаСтрока);
			ЗаполнитьЗначенияСвойств(НоваяПричина, Элементы.Информация_ПричиныИРешенияОшибок_Причина);
			
			НоваяГруппаРешение 	= Элементы.Добавить("ГруппаИнформация_ПричиныИРешенияОшибок_Решение" + ИндексЭлемента, Тип("ГруппаФормы"), НоваяГруппаСтрока);
			ЗаполнитьЗначенияСвойств(НоваяГруппаРешение, Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Решение,, "ПутьКДаннымЗаголовка");
			
			НовыйОтступ 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Отступ" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаРешение);
			ЗаполнитьЗначенияСвойств(НовыйОтступ, Элементы.Информация_ПричиныИРешенияОшибок_Отступ);
			
			НовоеРешение 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Решение" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаРешение);
			ЗаполнитьЗначенияСвойств(НовоеРешение, Элементы.Информация_ПричиныИРешенияОшибок_Решение);
			
			ИндексЭлемента = ИндексЭлемента + 1;
			
		КонецЦикла;
		
		УстановитьУсловноеОформление();
		
		// Общий обработчик
		ДополнительныеПараметры = Новый Структура("КартинкаПодсказкаИконка", Элементы.Найти("КартинкаПодсказкаИконка").Картинка);
		РеквизитОбъект.ГлЯдро_ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт
	
	// +++ Служебные замеры производительности
	Автотесты_ЗавершитьЗамерПроизводительности("ПриСозданииНаСервере", "После ПриСозданииНаСервере");
	Автотесты_НачатьЗамерПроизводительности("ПриОткрытии");
	// --- Служебные замеры производительности
	
	#Область НесовместимыйКодFresh
	ЭтоФреш = Ложь;
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//ЭтоФреш = Истина;
	#КонецОбласти //СовместимыйКодFresh
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// В УФ выполняется в ПриСозданииНаСервере
		ДоступноИзменениеНастроек = ЕстьПравоАдминистрированияДанных();
	#КонецЕсли
	
	ПоддерживаемыеВерсии 			= "";
	ПоддерживаемыеКонфигурации		= "";
	ПутьКОбработке					= "";
	ВерсияИнтеграционнойОбработки	= "";
	ПодключенныеРасширения			= "";
	ВерсияПриложения				= "";
	
	СтруктураОшибокСостояний = Новый Структура; // Инициализируем реквизит формы произвольного типа
	
	Если _ЛокКонтекст = Неопределено Тогда
		СоздатьЛокКонтекст();
	Иначе
		ЗапускПоИмениФайла_НеПроверятьИмяФайла = Истина; // Запуск по имени файла выполняем только при открытии обработки
	КонецЕсли;
	
	_ЛокКонтекст.НастройкиИнициализированы = Ложь;
	МиграцияНастроекПодключенияВыполнена = Ложь;
	
	ОбновитьОтображениеПриОткрытии();
	
	СформироватьСтруктуруПараметровЗапуска();
	
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
		"НачалоВыполненияПроцедурыЗапускаОбработки", 
		, 
		"ЗапускОсновнойОбработки");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		ПослеОткрытия();
	Иначе
		// Выполняем в обработчике ожидания, что бы форма была отрисована полностью, иначе на время инициализации форма пустая
		ПодключитьОбработчикОжидания("ПослеОткрытия", 0.1, Истина);
	КонецЕсли;
	
	// +++ Служебные замеры производительности
	Автотесты_ЗавершитьЗамерПроизводительности("ПриОткрытии", "ПриОткрытии");
	// --- Служебные замеры производительности
	
КонецПроцедуры

// Инициализирует форму локального контекста. Выполняет попытку подключения к базе Клеверенс.
&НаКлиенте
Процедура ПослеОткрытия()
	
	ИмяСобытия = "ПослеОткрытия";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		_ЛокКонтекст.АдресаПеременных = Новый Структура("ИдентификаторФормы","");
	#Иначе	
		_ЛокКонтекст.АдресаПеременных = Новый Структура("ИдентификаторФормы",ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
	_ЛокКонтекст.ПараметрыПодключенияMS = Неопределено;
	
	// <Лог>
	логПоток = _ЛокКонтекст.ЛогОткрытьПоток(ИмяСобытия, ЭтаФорма);
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия,, ЭтаФорма);
	// </Лог>
	
	// +++ Служебные замеры производительности
	Автотесты_НачатьЗамерПроизводительности("ПослеОткрытия");
	// --- Служебные замеры производительности
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ТекущаяБазаСуществует = Ложь;
	
	// +++ Проверка способа запуска
	СпособЗапуска = "Обычный";
	
	пПараметрЗапуска = "";
	ПервыйЗапуск = ЗначениеЗаполнено(ПараметрЗапуска) И НЕ ПараметрЗапускаИсключение(ПараметрЗапуска) И Найти(ПараметрЗапуска, "|") > 0;
		
	Если ПервыйЗапуск Тогда
		пПараметрЗапуска = ПараметрЗапуска;
		Если НЕ ПустаяСтрока(пПараметрЗапуска) Тогда
			СпособЗапуска = "ПоПараметруЗапуска";
		КонецЕсли;
	КонецЕсли;
	
	ЗапускПоИмениФайла = Ложь;
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ПервыйЗапуск И НЕ ЗапускПоИмениФайла_НеПроверятьИмяФайла = Истина Тогда
			пПараметрЗапуска = ЗапускПоИмениФайла_ПараметрЗапуска(_ЛокКонтекст.ИспользуемоеИмяФайла);
			
			Если НЕ ПустаяСтрока(пПараметрЗапуска) Тогда
				ЗапускПоИмениФайла = Истина;
				СпособЗапуска = "ПоИмениФайла";
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
	
	Если ЗначениеЗаполнено(ПараметрЗапуска)
		И Найти(ПараметрЗапуска, "КлеверенсОбновлениеXML.") Тогда	
		СпособЗапуска = "ОбновлениеXML";	
	КонецЕсли;
	// --- Проверка способа запуска
	
	// +++ Данные первичной инициализации
	
	Автотесты_НачатьЗамерПроизводительности("ПервичнаяИнициализация");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("локПараметрЗапуска", 					ПараметрЗапуска);
	ДополнительныеПараметры.Вставить("СпособЗапуска", 						СпособЗапуска);
	ДополнительныеПараметры.Вставить("ОшибкиФоновойИнициализации", 			ОшибкиФоновойИнициализации);
	ДополнительныеПараметры.Вставить("ВыполнятьЗамерыПроизводительности", 	Автотесты_ВыполнятьЗамерыПроизводительности());
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ГлавнаяФорма_ПервичнаяИнициализация");
	СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("ДополнительныеПараметры", ДополнительныеПараметры));
	ПервичныеДанные = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, _ЛокКонтекст.АдресаПеременных);
	
	ВерсияОсновнойОбработки 				= ПервичныеДанные.ВерсияОсновнойОбработки;
	ПодключеннаяКонфигурация 				= ПервичныеДанные.ПодключеннаяКонфигурация;
	ID_ТекущейБазы 							= ПервичныеДанные.ID_ТекущейБазы;
	ДоступноВыполнениеВФоне 				= ПервичныеДанные.ДоступноВыполнениеВФоне;
	РасположениеКомпоненты 					= ПервичныеДанные.РасположениеКомпоненты;
	ТипИнтерфейса 							= ПервичныеДанные.ТипИнтерфейса;
	_ЛокКонтекст.ДоступноВыполнениеВФоне 	= ДоступноВыполнениеВФоне; // Передаем признак в лок контекст
	
	Если НЕ ЗначениеЗаполнено(ИмяТекущейСтраницы) Тогда
		ИмяТекущейСтраницы = ?(ЗначениеЗаполнено(ПервичныеДанные.ИмяТекущейСтраницы), ПервичныеДанные.ИмяТекущейСтраницы, "");
	КонецЕсли;
	
	Автотесты_ЗавершитьЗамерПроизводительности("ПервичнаяИнициализация", "ПервичнаяИнициализация");
	
	// --- Данные первичной инициализации
	
	Если СпособЗапуска = "ПоИмениФайла" Тогда
		
		ОбновитьИнформациюОРасширениях();
		ОбновитьОтображениеСобытиеЭлементов("ОбновлениеОсновнойИнформации");
		ЗапускПоИмениФайла_ПроверкаПодключения(пПараметрЗапуска);
		
	ИначеЕсли СпособЗапуска = "ПоПараметруЗапуска" Тогда
		
		НастройкаПодключения_НастроитьПодключение(пПараметрЗапуска);
		
	ИначеЕсли СпособЗапуска = "ОбновлениеXML" Тогда
		
		ОбновлениеXML_ОбновитьCustomSettingsDflt();
		
	ИначеЕсли СпособЗапуска = "Обычный" Тогда
		
		ОбновитьИнформациюОРасширениях();
		ОбновитьОтображениеСобытиеЭлементов("ОбновлениеОсновнойИнформации");
		Подключение_ПодключитьсяКБазе(ПервичныеДанные.ПараметрыПодключенияMS);

	КонецЕсли;
	
	// +++ Служебные замеры производительности
	Автотесты_ЗавершитьЗамерПроизводительности("ПослеОткрытия", "ПослеОткрытия");
	Автотесты_ЗавершитьЗамерПроизводительности("ПриОткрытии", "ПослеОткрытия");
	
	Если Автотесты_ВыполнятьЗамерыПроизводительности() Тогда
		Автотесты_ЗаписатьРезультатыЗамеровПроизводительности();
	КонецЕсли;
	// --- Служебные замеры производительности
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// Сохраняет имя последней страницы, для её открытия при повторном запуске
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ЗавершениеРаботы = Истина Тогда
			Попытка
				_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ТекущаяСтраницаГлавнойФормы", Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя);	
			Исключение
			КонецПопытки;
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "УстановленыНастройкиПодключения" Тогда
		
		// При перезаполнении текущей базы учитываем, что если к торговому объекту подключена частная база, необходимо подключить ее
		ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
		Если ЕстьЧастнаяБаза Тогда			
			СтруктураПодключения = Новый Структура("ЧастнаяБазаMS");
			СтрокаУзла 			 = Неопределено;
			
			ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
			Если ТипЗнч(ВсеУзлы) = Тип("Массив") Тогда
				СтрокаУзла = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ВсеУзлы, "ID_Узла", _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураПодключения, СтрокаУзла);
			
			Если ЗначениеЗаполнено(СтруктураПодключения.ЧастнаяБазаMS) Тогда						
				ПараметрыПодключенияMSЧастнойБазы = СтруктураПодключения.ЧастнаяБазаMS;
				
				СтруктураПодключенияЧастнойБазыMS = Новый Структура("IdBaseSMARTS, ОписаниеБазы, СтрокаПодключенияСМАРТС");
				ЗаполнитьЗначенияСвойств(СтруктураПодключенияЧастнойБазыMS, ПараметрыПодключенияMSЧастнойБазы);
				СтруктураПодключенияЧастнойБазыMS.ОписаниеБазы = ПараметрыПодключенияMSЧастнойБазы;
				
				_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("СтруктураПодключенияЧастнойБазыMS", СтруктураПодключенияЧастнойБазыMS);	
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
		Подключение_ЗаполнитьПараметрыПодключаемойБазы(ПараметрыПодключенияMS);
		
		ID_ТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
		ID_ТекущегоУзлаПредыдущееЗначение = ID_ТекущегоУзла;
		
		УстановитьСписокВыбораУзлов();
		УстановитьСписокВыбораПодключенныхБаз();
		
		ОбновитьИнформациюОбИнтеграционнойОбработке();
		ОбновитьОтображениеПослеПодключения(ПараметрыПодключенияMS);
		
		ЗаполнитьТаблицуНастройкиОбменаСправочников();
		
	ИначеЕсли ИмяСобытия = "ПослеОбновленияРасширений" Тогда	
		
		ОбновитьИнформациюОРасширениях();
		ОбновитьИнформациюОбИнтеграционнойОбработке();
		
	ИначеЕсли ИмяСобытия = "ПослеПодключенияИнтеграционнойОбработки" Тогда
		
		ОбновитьИнформациюОбИнтеграционнойОбработке();
		
	ИначеЕсли ИмяСобытия = "ОшибкаАвторизацииПоTempUid"
		ИЛИ ИмяСобытия = "ОшибкаАвторизацииБезTempUid" Тогда
		
		Если ЗапускПоИмениФайла Тогда
			ТекущаяБазаСуществует = Истина;
				
			Если ТипЗнч(Параметр) = Тип("Строка") Тогда
				Если НЕ ВыполнениеВнешнейКоманды = Истина Тогда
					ОткрытьФормуНастройкиПодключения();
				КонецЕсли;
				
				СообщениеПользователю = Новый СообщениеПользователю();
				СообщениеПользователю.Текст = Параметр;
				СообщениеПользователю.Сообщить();
			КонецЕсли;
			
			СтруктураОшибокСостояний.Вставить("ОшибкаАвторизации");
		КонецЕсли;
				
	ИначеЕсли ИмяСобытия = "ИзменениеСпискаПодключенныхБазMS" Тогда
		
		УстановитьСписокВыбораПодключенныхБаз();
		
	ИначеЕсли ИмяСобытия = "СменаСтатуса" Тогда
		СменитьСтатус(Параметр);	
	КонецЕсли; 
	
КонецПроцедуры

