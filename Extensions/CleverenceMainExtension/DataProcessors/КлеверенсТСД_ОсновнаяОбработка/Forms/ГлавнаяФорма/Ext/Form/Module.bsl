#Область Автотесты

&НаКлиенте
Процедура ВыполнитьАвтотестКлеверенс(ПараметрЗапуска)
	
	ИмяКаталога 	= Неопределено;	
	ДопПараметры 	= Новый Структура("ИмяКаталога", ИмяКаталога);
	
	// Определение пути к каталогу хранения логов, в конце обязателен знак ";", т.к. пробел может присутствовать и в самом пути
	// Пример параметра запуска: "КлеверенсАвтотесты.КаталогЗаписиЛогов:C:\ProgramData\Cleverence\Базы Клеверенс\Папка для логов;"	
	ИмяОперации 	= "КлеверенсАвтотесты.КаталогЗаписиЛогов:";
	ИндексОперации 	= Найти(ВРег(ПараметрЗапуска), ВРег(ИмяОперации));	
	
	Если ИндексОперации <> 0 Тогда
		// Ищем переданный в параметре путь
		ИмяКаталога 	= Сред(ПараметрЗапуска, ИндексОперации + СтрДлина(ИмяОперации));
		ИндексОкончания = Найти(ИмяКаталога, ";");
		Если ИндексОкончания <> 0 Тогда
			// Обрезаем до знака окончания пути, т.к. началась другая операция
			ИмяКаталога = Лев(ИмяКаталога, ИндексОкончания - 1);
		КонецЕсли;		
		
		ДопПараметры.ИмяКаталога = ИмяКаталога;		
		
		УказанныйКаталог = Новый Файл(ИмяКаталога);		
		#Область НесовместимыйКодFresh
		Выполнить("УказанныйКаталог.НачатьПроверкуСуществования(Новый ОписаниеОповещения(""ВыполнитьАвтотестКлеверенсЗавершение"", ЭтаФорма, ДопПараметры))"); //Запрещенные операции fresh
		#КонецОбласти //НесовместимыйКодFresh
		
	Иначе 
		
		ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ВыполнитьАвтотестКлеверенсЗавершение", ЭтаФорма, ДопПараметры), Ложь);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтотестКлеверенсЗавершение(Существует, ДополнительныеПараметры) Экспорт
	
	СтруктураПараметров = _ЛокКонтекст.ПолучитьПараметрыВыполненияАвтотестов();
	
	СтрокаВыделенияАвтотестов		= СтруктураПараметров.СтрокаВыделенияАвтотестов;
	СтруктураВыполненияАвтотестов 	= СтруктураПараметров.СтруктураВыполненияАвтотестов;
	ИдАвтотеста 					= СтруктураПараметров.ИдАвтотеста;
		
	ПолныйАвтотест = Ложь;
	Если Найти(ПараметрЗапуска, "КлеверенсАвтотесты.ПолныйАвтотест") Тогда
		ПолныйАвтотест = Истина; // Запускаем все операции автотестов
	КонецЕсли;
	
	КаталогВПараметре = Ложь;
	
	Если Существует Тогда	
		ИмяКаталога = ДополнительныеПараметры.ИмяКаталога;
		КаталогВПараметре = Истина;
	Иначе
		Если ЗначениеЗаполнено(ДополнительныеПараметры.ИмяКаталога) Тогда
			ТекстКомментария = НСтр("ru = 'Каталог записи логов по пути <%1> не найден. Логи будут записаны в папку с подключенной базой';
										|en = 'The log entry directory along the path <%1> was not found. The logs will be recorded in the folder with the connected database';
										|be = 'Каталог запісу логаў па шляху <%1 > Не знойдзены. Логі будуць запісаныя ў тэчку з падключанай базай'; es = 'No se encontró el directorio de registro de la ruta <%1>. Los registros se escribirán en la carpeta con la base de datos conectada'; ka = 'ჟურნალის შესვლის დირექტორი ბილიკის გასწვრივ < %1> ვერ მოიძებნა. ჟურნალები ჩაიწერება საქაღალდეში დაკავშირებული მონაცემთა ბაზით'; kk = '<%1 > жолындағы журналдарды жазу каталогы табылмады. Журналдар базасы қосылған қалтаға жазылады'; ro = 'Directorul de intrare în jurnal de-a lungul căii <%1> nu a fost găsit. Jurnalele vor fi înregistrate în folderul cu baza de date conectată'; tr = '<%1> yolundaki günlük kaydı dizini bulunamadı. Kayıtlar, bağlı veritabanına sahip klasöre yazılacaktır'; uk = 'Каталог запису журналів на шляху <%1 > не знайдено. Логи будуть записані в папку з підключеною базою'; uz = 'Yo''l bo''ylab jurnal yozuvlari katalogi < %1> topilmadi. Jurnallar ma''lumotlar bazasi ulangan papkaga yoziladi'");
			ТекстКомментария = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстКомментария, ДополнительныеПараметры.ИмяКаталога);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПоискКаталогаЗаписиЛогов", "Ошибка", ТекстКомментария);	
		КонецЕсли;
		ИмяКаталога = Неопределено;
	КонецЕсли;	 	
	
	// Это автотест для ТП, запускаемый в базе клиента. Он не входит в перечень автотестов, выполняющихся при полном автотесте.
	Если Найти(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверкаПодключеннойБазы1С") Тогда
		
		// Выгрузка записей ЖР, добавленных при работе с обработкой
		ИмяФайлаОбщегоЛога = ?(КаталогВПараметре, "\Logs_full_", "\Logs\Logs_full_");
		ИмяФайлаЛогаОшибок = ?(КаталогВПараметре, "\Logs_errors_", "\Logs\Logs_errors_");		
		
		ШапкаПолногоЛогаЗаписана = _ЛокКонтекст.ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);
		
		// Существование каталога проверили, поэтому если не удается записать файл, значит дело в правах
		Если Не ШапкаПолногоЛогаЗаписана Тогда
			
			ТекстКомментария = НСтр("ru = 'Нет доступа к каталогу записи логов по пути <%1>. Логи будут записаны в папку с подключенной базой';
										|en = 'There is no access to the log entry directory using the <%1> path. The logs will be recorded in the folder with the connected database';
										|be = 'Няма доступу да каталога запісу логаваў па шляху <%1>. Логі будуць запісаныя ў тэчку з падключанай базай'; es = 'No se puede acceder al directorio de registro en la ruta <%1>. Los registros se escribirán en la carpeta con la base de datos conectada'; ka = 'არ არსებობს წვდომა ჟურნალის შესვლის დირექტორიაში <%1> ბილიკის გამოყენებით. ჟურნალები ჩაიწერება საქაღალდეში დაკავშირებული მონაცემთა ბაზით'; kk = '<%1 > жолы бойынша журналдарды жазу каталогына кіру мүмкін емес. Журналдар базасы қосылған қалтаға жазылады'; ro = 'Nu există acces la directorul de intrare în jurnal utilizând calea <%1>. Jurnalele vor fi înregistrate în folderul cu baza de date conectată'; tr = '<%1> yolunda günlük kaydı dizinine erişim yoktur. Kayıtlar, bağlı veritabanına sahip klasöre yazılacaktır'; uk = 'Немає доступу до каталогу запису журналів на шляху <%1>. Логи будуть записані в папку з підключеною базою'; uz = 'Yo''l bo''ylab log yozish katalogiga kirish imkoni yo''q <%1>. Jurnallar ma''lumotlar bazasi ulangan papkaga yoziladi'");
			ТекстКомментария = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстКомментария, ДополнительныеПараметры.ИмяКаталога);
			_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПоискКаталогаЗаписиЛогов", "Ошибка", ТекстКомментария);	
			
			КаталогВПараметре = Ложь;			
			ИмяКаталога = Неопределено;
			ИмяФайлаОбщегоЛога = "\Logs\Logs_full_";
			ИмяФайлаЛогаОшибок = "\Logs\Logs_errors_";				
			
			ШапкаПолногоЛогаЗаписана = _ЛокКонтекст.ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);	
			
		КонецЕсли;
		
		// Установка даты, начиная с которой будут получены и выгружены в лог записи ЖР
		ДатаНачалаВыгрузкиЖР = НачалоДня(ТекущаяДата()) - 7 * 24 * 60 * 60; // 7 дней назад
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ДатаНачалаВыгрузкиЖР", ДатаНачалаВыгрузкиЖР);
		
		ДанныеДляОтбораЖР = "MobileSMARTSLog";
		
		Если ШапкаПолногоЛогаЗаписана Тогда
			_ЛокКонтекст.ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации(ДанныеДляОтбораЖР);
		КонецЕсли;
		
		// Выполнение операций автотестов. Вместо параметра запуска будем передавать полное имя автотеста, 
		// т.к. в параметре запуска его может не быть, но в рамках данного автотеста необходимо его выполнить
		
		ВыполнитьОперациюАвтотестовКлеверенс(
			"КлеверенсАвтотесты.ПроверкаПодключенныхРасширенийИПатчей", 
			"КлеверенсАвтотесты.ПроверкаПодключенныхРасширенийИПатчей", 
			СтруктураВыполненияАвтотестов, 
			Ложь, 
			ПолныйАвтотест, 
			СтрокаВыделенияАвтотестов);
				
		ВыполнитьОперациюАвтотестовКлеверенс(
			"КлеверенсАвтотесты.ПроверкаДоступностиРаботыСДокументами1С", 
			"КлеверенсАвтотесты.ПроверкаДоступностиРаботыСДокументами1С", 
			СтруктураВыполненияАвтотестов, 
			Ложь, 
			ПолныйАвтотест, 
			СтрокаВыделенияАвтотестов);
		
		ВыполнитьОперациюАвтотестовКлеверенс(
			"КлеверенсАвтотесты.ПолучитьСписокГлобальныхПеременныхИЗначений", 
			"КлеверенсАвтотесты.ПолучитьСписокГлобальныхПеременныхИЗначений", 
			СтруктураВыполненияАвтотестов, 
			Ложь, 
			ПолныйАвтотест, 
			СтрокаВыделенияАвтотестов);		
			
		ВыполнитьОперациюАвтотестовКлеверенс(
			"КлеверенсАвтотесты.ПолучитьСписокМакетовСКДДляВыгрузкиСправочников", 
			"КлеверенсАвтотесты.ПолучитьСписокМакетовСКДДляВыгрузкиСправочников", 
			СтруктураВыполненияАвтотестов, 
			Ложь, 
			ПолныйАвтотест, 
			СтрокаВыделенияАвтотестов);		
				
		ВыполнитьОперациюАвтотестовКлеверенс(
			"КлеверенсАвтотесты.ДиагностикаБизнесПроцессов", 
			"КлеверенсАвтотесты.ДиагностикаБизнесПроцессов", 
			СтруктураВыполненияАвтотестов, 
			Ложь, 
			ПолныйАвтотест, 
			СтрокаВыделенияАвтотестов);
						
	КонецЕсли;
	
	// Выполняем подключение расширений, обработок до записи шапки лога, т.к. в шапке содержится информации об ИО
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ОбновитьКомпонентыИзПодключеннойБазы", СтруктураВыполненияАвтотестов, Ложь, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ИмяФайлаОбщегоЛога = ?(КаталогВПараметре, "\Autotest1C_logs_full_", "\Logs\Autotest1C_logs_full_");
	ИмяФайлаЛогаОшибок = ?(КаталогВПараметре, "\Autotest1C_logs_errors_", "\Logs\Autotest1C_logs_errors_");
	
	ШапкаЛогаЗаписана = _ЛокКонтекст.ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);
	
	// Существование каталога проверили, поэтому если не удается записать файл, значит дело в правах
	Если Не ШапкаЛогаЗаписана Тогда
			
		ТекстКомментария = НСтр("ru = 'Нет доступа к каталогу записи логов по пути <%1>. Логи будут записаны в папку с подключенной базой';
									|en = 'There is no access to the log entry directory using the <%1> path. The logs will be recorded in the folder with the connected database';
									|be = 'Няма доступу да каталога запісу логаваў па шляху <%1>. Логі будуць запісаныя ў тэчку з падключанай базай'; es = 'No se puede acceder al directorio de registro en la ruta <%1>. Los registros se escribirán en la carpeta con la base de datos conectada'; ka = 'არ არსებობს წვდომა ჟურნალის შესვლის დირექტორიაში <%1> ბილიკის გამოყენებით. ჟურნალები ჩაიწერება საქაღალდეში დაკავშირებული მონაცემთა ბაზით'; kk = '<%1 > жолы бойынша журналдарды жазу каталогына кіру мүмкін емес. Журналдар базасы қосылған қалтаға жазылады'; ro = 'Nu există acces la directorul de intrare în jurnal utilizând calea <%1>. Jurnalele vor fi înregistrate în folderul cu baza de date conectată'; tr = '<%1> yolunda günlük kaydı dizinine erişim yoktur. Kayıtlar, bağlı veritabanına sahip klasöre yazılacaktır'; uk = 'Немає доступу до каталогу запису журналів на шляху <%1>. Логи будуть записані в папку з підключеною базою'; uz = 'Yo''l bo''ylab log yozish katalogiga kirish imkoni yo''q <%1>. Jurnallar ma''lumotlar bazasi ulangan papkaga yoziladi'");
		ТекстКомментария = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстКомментария, ДополнительныеПараметры.ИмяКаталога);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПоискКаталогаЗаписиЛогов", "Ошибка", ТекстКомментария);	
		
		КаталогВПараметре = Ложь;			
		ИмяКаталога = Неопределено;
		ИмяФайлаОбщегоЛога = "\Logs\Autotest1C_logs_full_";
		ИмяФайлаЛогаОшибок = "\Logs\Autotest1C_logs_errors_";				
		
		ШапкаЛогаЗаписана = _ЛокКонтекст.ЛокЯдро_ЗаписатьШапкуЛога(ИмяФайлаОбщегоЛога, ИмяФайлаЛогаОшибок, ИмяКаталога);	
		
	КонецЕсли;

	НачалоТестов = ТекущаяУниверсальнаяДатаВМиллисекундах();
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("НачалоАвтотестов", "Информация", "ПараметрЗапуска = " + ПараметрЗапуска);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.СброситьНастройкиПодключеннойБазыНаСтандартные", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.НастройкаПодключения_Clgt", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.НастройкаПодключения_НаКлиенте", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.НастройкаПодключения_НаСервере", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ОчиститьСправочники", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ВыгрузитьСправочники", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверкаПодключенныхРасширенийИПатчей", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверкаДоступностиРаботыСДокументами1С", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПолучитьСписокГлобальныхПеременныхИЗначений", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПолучитьСписокМакетовСКДДляВыгрузкиСправочников", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ДиагностикаБизнесПроцессов", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверитьПоддерживаемыеВерсииКонфигурации", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ВыгрузитьДокументы", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ЗагрузитьДокументы", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверитьОткрытиеФорм", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ВыполнитьОперациюАвтотестовКлеверенс(ПараметрЗапуска, "КлеверенсАвтотесты.ПроверитьРаботуСМаркированнойПродукцией", СтруктураВыполненияАвтотестов, Истина, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
	
	ПараметрыЗавершения = Новый Структура;
	ПараметрыЗавершения.Вставить("ИдАвтотеста",				ИдАвтотеста);
	ПараметрыЗавершения.Вставить("ШапкаЛогаЗаписана",		ШапкаЛогаЗаписана);
	ПараметрыЗавершения.Вставить("ИмяКаталога",				ИмяКаталога);
	ПараметрыЗавершения.Вставить("НачалоТестов",			НачалоТестов);
	
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыЗавершения", ПараметрыЗавершения);
	
	ПодключитьОбработчикОжидания("ПроверитьЗавершениеАвтотестов", 15);
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеАвтотестов() Экспорт
	
	ПараметрыЗавершения = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыЗавершения");
	ИдАвтотеста 		= ПараметрыЗавершения.ИдАвтотеста;
	ШапкаЛогаЗаписана 	= ПараметрыЗавершения.ШапкаЛогаЗаписана;
	ИмяКаталога 		= ПараметрыЗавершения.ИмяКаталога;
	НачалоТестов 		= ПараметрыЗавершения.НачалоТестов;
	
	МожноЗавершать = Истина;
	
	// надо дождаться окончания выгрузки, чтоб получить результат,
	// ограничим время ожидания в 90 мин
	Если _ЛокКонтекст.ЛокЯдро_ПроверитьЗапускВыгрузкиТаблицыВФоне() Тогда
		МожноЗавершать = Ложь;
		ПрошлоСекунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() -НачалоТестов)/1000;
		Если ПрошлоСекунд > 60*90 Тогда
			МожноЗавершать = Истина;
			пСообщение = НСтр("ru = 'Справочники выгружались в фоне дольше 90 минут.';
								|en = 'The directories were uploaded to the background for longer than 90 minutes.'; be = 'Даведнікі выгружаліся ў фоне даўжэй 90 хвілін.'; es = 'Los manuales se descargaron en el fondo durante más de 90 minutos.'; ka = 'დირექტორიები ატვირთული იყო ფონზე 90 წუთზე მეტხანს.'; kk = 'Анықтамалықтар фонда 90 минуттан артық түсірілді.'; ro = 'Directoarele au fost încărcate în fundal mai mult de 90 de minute.'; tr = 'Dizinler arka planda 90 dakikadan uzun süre boşaltıldı.'; uk = 'Довідники вивантажувалися в фоні довше 90 хвилин.'; uz = 'Ma''lumotnomalar fonda 90 daqiqadan ko''proq vaqt davomida tushirildi.'");
			_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПроверитьЗавершениеАвтотестов", "Ошибка", пСообщение);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ МожноЗавершать Тогда
		Возврат;
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("КонецАвтотестов", "Информация", "", НачалоТестов);
	
	СтрокаПолучателей = ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.ПолучателиОшибокНаПочту:");
	МассивПолучателейОшибок = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПолучателей, ";");
	
	АдресSMTP 		= ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.АдресSMTP:");
	ПортSMTP 		= ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.ПортSMTP:");
	ЛогинSMTP 		= ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.ЛогинSMTP:");
	ПарольSMTP 		= ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.ПарольSMTP:");
	ОтправительSMTP = ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, "КлеверенсАвтотесты.ОтправительSMTP:");
	
	ПараметрыОтправкиПочты = Новый Структура(
		"МассивПолучателей, АдресSMTP, ПортSMTP, ЛогинSMTP, ПарольSMTP, ОтправительSMTP",
		МассивПолучателейОшибок, АдресSMTP, ПортSMTP, ЛогинSMTP, ПарольSMTP, ОтправительSMTP);
	
	ДанныеДляОтбораЖР = ИдАвтотеста;
	
	Если ШапкаЛогаЗаписана Тогда
		_ЛокКонтекст.ЛокЯдро_ВыгрузитьЛогИзЖурналаРегистрации(ДанныеДляОтбораЖР, ПараметрыОтправкиПочты, ИмяКаталога);
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеАвтотестов");
	
	// ЗавершитьРаботуСистемы(Ложь); // При ПрекратитьРаботуСистемы не всегда успевают записаться в журнал последние события
	
	_ЛокКонтекст.ЛокЯдро_Пауза(30);
	
	ПрекратитьРаботуСистемы();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗначениеПараметраЗапуска(ПараметрЗапуска, ИмяОперации, Разделитель = " ")
	
	ИндексОперации = Найти(ВРег(ПараметрЗапуска), ВРег(ИмяОперации));
	
	Если ИндексОперации = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = Сред(ПараметрЗапуска, ИндексОперации + СтрДлина(ИмяОперации));
	ИндексРазделителя = Найти(Значение, Разделитель);
	
	Если ИндексРазделителя <> 0 Тогда
		Значение = Лев(Значение, ИндексРазделителя - 1);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьОперациюАвтотестовКлеверенс(СтрокаПараметраЗапуска, ПолноеИмяАвтотеста, СтруктураВыполненияАвтотестов, ВключатьВПолныйАвтотест, ПолныйАвтотест, СтрокаВыделенияАвтотестов)
	_ЛокКонтекст.ВыполнитьОперациюАвтотестовКлеверенс(СтрокаПараметраЗапуска, ПолноеИмяАвтотеста, СтруктураВыполненияАвтотестов, ВключатьВПолныйАвтотест, ПолныйАвтотест, СтрокаВыделенияАвтотестов);
КонецПроцедуры

&НаКлиенте
Процедура Автотесты_НачатьЗамерПроизводительности(ИмяЗамера)
	
	Если НЕ Автотесты_ВыполнятьЗамерыПроизводительности() Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗамеровПроизводительности = Неопределено Тогда
		ДанныеЗамеровПроизводительности = Новый Структура;
	КонецЕсли;
	
	СтруктураЗамера = Новый Структура;
	СтруктураЗамера.Вставить("НачалоЗамера", ТекущаяУниверсальнаяДатаВМиллисекундах());
	СтруктураЗамера.Вставить("ЗавершенияЗамера", Новый Соответствие);
	
	ДанныеЗамеровПроизводительности.Вставить(ИмяЗамера, СтруктураЗамера);
	
КонецПроцедуры

&НаКлиенте
Процедура Автотесты_ЗавершитьЗамерПроизводительности(ИмяЗамера, ТекстСообщения = "")
	
	Если НЕ Автотесты_ВыполнятьЗамерыПроизводительности() Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗамеровПроизводительности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураЗамера = Неопределено;
	ДанныеЗамеровПроизводительности.Свойство(ИмяЗамера, СтруктураЗамера);
	Если СтруктураЗамера <> Неопределено Тогда
		
		ТекстСообщения = ?(ТекстСообщения = "", ИмяЗамера, ТекстСообщения);
		СтруктураЗамера.ЗавершенияЗамера.Вставить(ТекстСообщения, ТекущаяУниверсальнаяДатаВМиллисекундах());
		ДанныеЗамеровПроизводительности.Вставить(ИмяЗамера, СтруктураЗамера);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Автотесты_ЗаписатьРезультатыЗамеровПроизводительности()
	
	Если ДанныеЗамеровПроизводительности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатыЗамеров = "";
	Для каждого КлючЗначение Из ДанныеЗамеровПроизводительности Цикл
		
		ИмяЗамера = КлючЗначение.Ключ;
		СтруктураЗамера = КлючЗначение.Значение;
		НачалоЗамера = СтруктураЗамера.НачалоЗамера;
		
		Для каждого КлючЗначение Из СтруктураЗамера.ЗавершенияЗамера Цикл
			
			ТекстСообщения = КлючЗначение.Ключ;
			КонецЗамера = КлючЗначение.Значение;
			
			ВремяВыполнения = Макс(КонецЗамера - НачалоЗамера, 0);
			ВремяВыполнения = Формат(ВремяВыполнения/1000, "ЧРД=.; ЧН=0");
			РезультатыЗамеров = РезультатыЗамеров + Символы.ПС + ИмяЗамера + ";" + ТекстСообщения + ";" + ВремяВыполнения;
			
		КонецЦикла;
		
	КонецЦикла;
	РезультатыЗамеров = СокрЛП(РезультатыЗамеров);
	
	ИмяОперации 	= "КлеверенсАвтотесты.ПутьКФайлуЗамеров:";
	ИндексОперации 	= Найти(ВРег(ПараметрЗапуска), ВРег(ИмяОперации));
	
	Если ИндексОперации = 0 Тогда
		Сообщить(РезультатыЗамеров);
	Иначе
		// Ищем переданный в параметре путь
		ПутьКФайлу 	= Сред(ПараметрЗапуска, ИндексОперации + СтрДлина(ИмяОперации));
		ИндексОкончания = Найти(ПутьКФайлу, ";");
		Если ИндексОкончания <> 0 Тогда
			// Обрезаем до знака окончания пути, т.к. началась другая операция
			ПутьКФайлу = Лев(ПутьКФайлу, ИндексОкончания - 1);
		КонецЕсли;		
		
		ЗаписьЛога = Новый ЗаписьТекста(ПутьКФайлу,КодировкаТекста.UTF8,,Истина);
		ЗаписьЛога.ЗаписатьСтроку(РезультатыЗамеров);
		ЗаписьЛога.Закрыть();
		
		ПрекратитьРаботуСистемы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция Автотесты_ВыполнятьЗамерыПроизводительности()
	
	Если ВыполнятьЗамеры <> Неопределено Тогда
		Возврат ВыполнятьЗамеры;
	КонецЕсли;
	
	ВыполнятьЗамеры = Найти(ПараметрЗапуска, "КлеверенсАвтотесты.ЗамерыПроизводительности") > 0;
	Возврат ВыполнятьЗамеры;
	
КонецФункции 

#КонецОбласти

