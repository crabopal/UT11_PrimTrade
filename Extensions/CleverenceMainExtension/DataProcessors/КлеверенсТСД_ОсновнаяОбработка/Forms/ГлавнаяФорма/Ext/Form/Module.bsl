		ПараметрыПоляHTML.Вставить("пШаг1",						НСтр("ru = 'первый раз, чтобы скачать мобильное приложение'"));
		ПараметрыПоляHTML.Вставить("пШаг2",						НСтр("ru = 'второй раз, чтобы подключить устройство к базе данных'"));
		
		ПараметрыПоляHTML.Вставить("пСкачатьПеред",				НСтр("ru = 'Также вы можете использовать эту ссылку, чтобы'"));
		ПараметрыПоляHTML.Вставить("пСкачатьКнопка",			НСтр("ru = 'скачать мобильное приложение'"));
		ПараметрыПоляHTML.Вставить("пСкачатьПосле",				НСтр("ru = 'на компьютер'"));
		
		ПараметрыПоляHTML.Вставить("пНазваниеБазыДанныхИмя",	НСтр("ru = 'Название базы данных'"));
		ПараметрыПоляHTML.Вставить("пНазваниеБазыДанныхЗнач",	ПараметрыПодключенияMS.Имя);
		
		ПараметрыПоляHTML.Вставить("пИдБазыИмя",				НСтр("ru = 'ID базы'"));
		ПараметрыПоляHTML.Вставить("пИдБазыЗнач",				ПараметрыПодключенияMS.IdBaseSMARTS);
		
		ПараметрыПоляHTML.Вставить("пВерсияПродуктаИмя",		НСтр("ru = 'Версия продукта'"));
		ПараметрыПоляHTML.Вставить("пВерсияПродуктаЗнач",		ПараметрыПодключенияMS.ВерсияПриложения);
		
		ПараметрыПоляHTML.Вставить("пВерсияСервераИмя",			НСтр("ru = 'Версия сервера'"));
		ПараметрыПоляHTML.Вставить("пВерсияСервераЗнач",		ПараметрыПодключенияMS.ВерсияПлатформыSMARTS);
		
		ПараметрыПоляHTML.Вставить("connectionQRCode",			ПараметрыПодключенияMS.Qr);
		
		HTMLСтрока = _ЛокКонтекст.ЛокЯдро_ПолучитьМакетОбработки("HTMLСтраницаПодключенияТСД").ПолучитьТекст();
		Для каждого КлючЗначение Из ПараметрыПоляHTML Цикл
			HTMLСтрока = СтрЗаменить(HTMLСтрока, "%" + КлючЗначение.Ключ + "%", КлючЗначение.Значение);
		КонецЦикла;
		
		ПодключитьТСДПолеHTML = HTMLСтрока;
	#КонецЕсли
	
КонецПроцедуры

