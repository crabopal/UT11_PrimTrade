&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии(ПараметрыВыполнения = Неопределено)
	
	// Не выполняем никакие действия с формой при выполнении внешней команды
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		Возврат;	
	КонецЕсли;
	
	Заголовок = НСтр("ru = 'Клеверенс: загрузка...';
						|en = 'Cleverence: download...'; be = 'Cleverence: загрузка...'; es = 'Cleverence: descarga...'; ka = 'Cleverence: ჩამოტვირთვა...'; kk = 'Cleverence: жүктеу...'; ro = 'Inteligență: descărcare...'; tr = 'Cleverence: yükleniyor...'; uk = 'Cleverence: завантаження...'; uz = 'Cleverence: yuklab olish...'");
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		// Служебная группа с картинками
		Элементы.ГруппаКартинкиСлужебный.Видимость = Ложь;
		
		// Блокировка остальных страниц на время инициализации
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница_Информация;
		Для каждого Страница Из Элементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
			Если НЕ Страница.Имя = "ГруппаСтраница_Информация"
				И НЕ Страница.Имя = "ГруппаСтраница_Техподдержка" Тогда
				Страница.Доступность = Ложь;
				Страница.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
		Элементы.ГруппаШапка_ТекущийУзел.Доступность = Ложь;
		
		// Делаем вкладку ТП доступной, но убираем доступность у кнопок, которые требуют наличие подключения
		Элементы.ГруппаПлитка_Техподдержка_СамостоятельноеРешение_ОбновлениеНастроек.Доступность = Ложь;
	#Иначе
		
		КнопкаПоказатьСкрытьНастройкиПометка = Истина;
		ПоказатьСкрытьНастройки("");	
		
		ТекстЗаголовка = НСтр("ru = 'Открыть окно обмена %1 справочников и печати';
								|en = 'Open the %1 directory exchange and printing window'; be = 'Адкрыць акно абмену %1 даведнікаў і друку'; es = 'Abrir la ventana de intercambio de directorios e impresión %1'; ka = 'გახსენით % 1 დირექტორიის გაცვლა და ბეჭდვის ფანჯარა'; kk = '%1 анықтамалық және басып шығару алмасу терезесін ашыңыз'; ro = 'Deschideți fereastra % 1 directory exchange și printing'; tr = 'Referans kitaplarının ve baskının %1''ini değiştirme penceresini açın'; uk = 'Відкрити вікно обміну %1 довідників і друку'; uz = '%1 katalog va bosib chiqarish almashish oynasini oching'");
		
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, Символы.ПС);
		Элементы["НастроитьСправочники"].Заголовок = ТекстЗаголовка;
		
		Элементы.ГруппаОсновнаяЛево.ТекущаяСтраница = Элементы.ГруппаОсновнаяЛево.Страницы.ГруппаПерезапускОбработки;
		
	#КонецЕсли
	
	УстановитьСтильПродукта("Клеверенс");
	УстановитьВнешниеКартинки();
	УстановитьСтильОформления();
	
	ОбновитьОтображениеСобытиеЭлементов("ОбновлениеОсновнойИнформации");
	ОбновитьОтображениеСобытиеЭлементов("ЗаполнениеТаблицыНастройкиОбменаСправочников");
	
	УстановитьДоступностьНастроек();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеПослеПодключения(ПараметрыПодключенияMS)
	
	// Не выполняем никакие действия с формой при выполнении внешней команды
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		Возврат;	
	КонецЕсли;
	
	ЭтоМинимум = ПараметрыПодключенияMS <> Неопределено
		И ПараметрыПодключенияMS.Свойство("УровеньПриложенияСтрокой")
		И ПараметрыПодключенияMS.УровеньПриложенияСтрокой = "Минимум";
	
	ТаблицыMS = _ЛокКонтекст.СтруктураМетаданных.Tables;
	ЕстьТаблицаУзлов = _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "Узлы") <> Неопределено
		ИЛИ _ЛокКонтекст.ЛокЯдро_НайтиВСпискеПоПредставлению(ТаблицыMS, "Nodes") <> Неопределено;
	
	ДоступныТорговыеОбъекты = ЕстьТаблицаУзлов И НЕ ЭтоМинимум;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		// Снятие блокировки страниц, после успешного запуска
		Для каждого Страница Из Элементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
			Страница.Доступность = Истина;
			Страница.Видимость = Истина;
		КонецЦикла;
		
		// Блокируем настройки по ролям
		УстановитьДоступностьНастроек();
		
		// Открывает последнюю страницу на которой был пользователь
		Если ЗначениеЗаполнено(ИмяТекущейСтраницы) Тогда
			
			// Если на вкладке "Информация" есть основное действие, необходимо переключиться на неё,
			// 	чтобы пользователь увидел сообщение и основную кнопку.
			Если Элементы.ГруппаИнформация_СостояниеОбработки_ОсновноеДействие.Видимость Тогда
				ИмяТекущейСтраницы = "ГруппаСтраница_Информация";
			КонецЕсли;
			
			ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Найти(ИмяТекущейСтраницы);
			Если ТекущаяСтраница <> Неопределено И ТекущаяСтраница.Доступность Тогда
				Элементы.ГруппаСтраницы.ТекущаяСтраница = ТекущаяСтраница;
				ГруппаСтраницыПриСменеСтраницы(Неопределено, ТекущаяСтраница); // Выполняем обработчик, т.к при программной смене страницы он не вы полняется
			КонецЕсли;
		КонецЕсли;
		
		Элементы.ГруппаШапка_ТекущийУзел.Видимость = ДоступныТорговыеОбъекты;
		Элементы.ГруппаШапка_ТекущийУзел.Доступность = Истина;
		
		Элементы.ГруппаПлитка_Техподдержка_СамостоятельноеРешение_ОбновлениеНастроек.Доступность = Истина;
		
	#Иначе
		// Блокируем настройки по ролям
		УстановитьДоступностьНастроек();
		
		Элементы.ГруппаОсновнаяЛево.ТекущаяСтраница = Элементы.ГруппаОсновнаяЛево.Страницы.РаботаСТСД;
		Элементы.ПодключитьТСД.Подсказка = ПараметрыПодключенияMS.СтрокаПодключения;
		Элементы.РедактироватьНастройкиУзлов.Доступность = ДоступныТорговыеОбъекты;
	#КонецЕсли
	
	УстановитьЗаголовокФормы();
	УстановитьСсылкиНаВнешниеРесурсы();
	
	ТипПродукта = "Клеверенс";
	Если ПараметрыПодключенияMS <> Неопределено
		И ПараметрыПодключенияMS.Свойство("ТипУстановленногоПродукта")
		И ЗначениеЗаполнено(ПараметрыПодключенияMS.ТипУстановленногоПродукта) Тогда
		ТипПродукта = ПараметрыПодключенияMS.ТипУстановленногоПродукта;
	КонецЕсли;
	
	УстановитьСтильПродукта(ТипПродукта);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьНастроек()
	
	ОграничитьДоступность = Новый Массив;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ОграничитьДоступность.Добавить("ГруппаСтраница_Настройки");
		ОграничитьДоступность.Добавить("ОтключитьБезопасныйРежимРасширений");
		ОграничитьДоступность.Добавить("ВыборИнтеграционнойОбработки");
		
		// Вкладка Обмен справочниками
		ОграничитьДоступность.Добавить("ВыгрузкаСправочников_НастройкиОтборовИнтерактивный_Кнопка");
		ОграничитьДоступность.Добавить("ВыгрузкаСправочников_НастройкиОтборовОнлайн_Кнопка");
		ОграничитьДоступность.Добавить("ВыгрузкаСправочников_НастройкиОтборовАвтообмен_Кнопка");
		
		// Вкладка Обмен документами
		ОграничитьДоступность.Добавить("Плитка_ОбменДокументами_БизнесПроцессы_НастроитьБизнесПроцессы");
		ОграничитьДоступность.Добавить("Плитка_ОбменДокументами_ГлобальныеПараметры_НастроитьГлобальныеПараметры");
		ОграничитьДоступность.Добавить("Плитка_ОбменДокументами_НастройкиОбменаОнлайн_Кнопка");
		ОграничитьДоступность.Добавить("Плитка_ОбменДокументами_НастройкиОбменаАвтообмен_Кнопка");
		ОграничитьДоступность.Добавить("Плитка_ОбменДокументами_НастройкиОбменаИнтерактивный_Кнопка");
		
		// Вкладка техподдержка
		ОграничитьДоступность.Добавить("ГруппаПлитка_Техподдержка_СамостоятельноеРешение_АнализЖР");
	#Иначе
		ОграничитьДоступность.Добавить("СкопироватьНастройкиПодключенияДругимПользователям1С");
	#КонецЕсли
	
	Для каждого ИмяЭлемента Из ОграничитьДоступность Цикл
		
		Попытка
			Элементы[ИмяЭлемента].Доступность = Элементы[ИмяЭлемента].Доступность И ДоступноИзменениеНастроек;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПредупреждениеОграниченияПравДоступа.ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Примечание");
		Элементы.ПредупреждениеОграниченияПравДоступа.Видимость = НЕ ДоступноИзменениеНастроек;
		
		// Запрещаем открытие настроек узлов
		Элементы.ID_ТекущегоУзла.КнопкаОткрытия = ДоступноИзменениеНастроек;
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеПриСменеСтатуса()
	
	// Уровни:
	//  0 - Загрузка
	//	1 - Критическая ошибка
	//	2 - Ошибка (на будущее)
	//	3 - Предупреждение
	//	4 - демо-режим
	//	5 - Успех, всё хорошо
	
	Уровень = 5;
	
	пТекстСостоянияОбработки = "";
	КодОшибки = "";
	ОписаниеСостоянияОбработки = "";
	
	Если Не ЗначениеЗаполнено(СтруктураОшибокСостояний) Тогда		
		// Если ошибок не осталось, выводится одна-единственная надпись по отсутствию ошибок
		пТекстСостоянияОбработки = НСтр("ru = 'Можно работать! Всё загружено без ошибок!';
											|en = 'You can work! Everything is loaded without errors!'; be = 'Можна працаваць! Усе загружана без памылак!'; es = '¡Se puede trabajar! ¡Todo cargado sin errores!'; ka = 'შეგიძლიათ მუშაობა! ყველაფერი დატვირთულია შეცდომების გარეშე!'; kk = 'Сіз жұмыс істей аласыз! Барлығы қатесіз жүктелген!'; ro = 'Poți lucra! Totul este încărcat fără erori!'; tr = 'Çalışabiliriz! Her şey hatasız yüklendi!'; uk = 'Можна працювати! Все завантажено без помилок!'; uz = 'Siz ishlashingiz mumkin! Hammasi xatosiz Yuklangan!'");
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаИнформация_СостояниеОбработки_ОсновноеДействие.Видимость = Ложь;
		Если Не ЗначениеЗаполнено(СтруктураОшибокСостояний) Тогда		
			// Если ошибок не осталось, выводится одна-единственная надпись по отсутствию ошибок									
			Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Отступ.Видимость = Ложь;
		Иначе
			
			// Скрываем все основные кнопки
			Для каждого ЭлементКнопки Из Элементы.ГруппаИнформация_СостояниеОбработки_ОсновноеДействиеОтступ.ПодчиненныеЭлементы Цикл
				ЭлементКнопки.Видимость = Ложь;
			КонецЦикла;
			
			// Формируем общий список причин и решений
			ПричиныИРешенияОшибок = Новый Соответствие;
			Для Каждого ЭлементСтруктуры Из СтруктураОшибокСостояний Цикл
				
				СтруктураСостояния = ЭлементСтруктуры.Значение;
				Если НЕ ЗначениеЗаполнено(СтруктураСостояния) Тогда
					Продолжить;
				КонецЕсли;
				
				Если Уровень > СтруктураСостояния.Уровень Тогда
					// Выводим минимальный уровень состояния. Так-как могут быть ошибки + предупреждения
					Уровень = СтруктураСостояния.Уровень;
					пТекстСостоянияОбработки = СтруктураСостояния.ТекстСостоянияОбработки;
					КодОшибки = СтруктураСостояния.КодОшибки;
				КонецЕсли;
				
				Для каждого ПричинаИРешение Из СтруктураСостояния.ПричиныИРешенияОшибок Цикл
					ПричиныИРешенияОшибок.Вставить(ПричинаИРешение.Ключ, ПричинаИРешение.Значение);
				КонецЦикла;
				
				// Отображаем только первое основное действие
				Если ЗначениеЗаполнено(СтруктураСостояния.ОсновноеДействие) 
					И Элементы.ГруппаИнформация_СостояниеОбработки_ОсновноеДействие.Видимость = Ложь Тогда
					Элементы.ГруппаИнформация_СостояниеОбработки_ОсновноеДействие.Видимость = Истина;
					Элементы[СтруктураСостояния.ОсновноеДействие].Видимость = Истина;
				КонецЕсли;
				
				ОписаниеСостоянияОбработки = ОписаниеСостоянияОбработки + Символы.ПС + СтруктураСостояния.ОписаниеСостоянияОбработки;
				
			КонецЦикла;
			
			// Скрываем все строки ошибок
			Для каждого ЭлементПричинаИРешение Из Элементы.ГруппаИнформация_ПричиныИРешенияОшибок.ПодчиненныеЭлементы Цикл
				ЭлементПричинаИРешение.Видимость = Ложь;
			КонецЦикла;
			
			КоличествоЭлементов = Элементы.ГруппаИнформация_ПричиныИРешенияОшибок.ПодчиненныеЭлементы.Количество();
			
			ИндексЭлемента = 1;
			Для каждого ПричинаИРешение Из ПричиныИРешенияОшибок Цикл
				
				// Первая строка уже создана в конфигураторе
				Если ИндексЭлемента = 1 Тогда
					
					НоваяГруппаСтрока	= Элементы.Найти("ГруппаИнформация_ПричиныИРешенияОшибок_Строка");
					НоваяПричина 		= Элементы.Найти("Информация_ПричиныИРешенияОшибок_Причина");
					НовоеРешение 		= Элементы.Найти("Информация_ПричиныИРешенияОшибок_Решение");
					
					// Если не хватает строк для ошибок, то создаем новые элементы
				ИначеЕсли ИндексЭлемента > КоличествоЭлементов Тогда
									
					НоваяГруппаСтрока 	= Элементы.Добавить("ГруппаИнформация_ПричиныИРешенияОшибок_Строка" + ИндексЭлемента, Тип("ГруппаФормы"), Элементы.ГруппаИнформация_ПричиныИРешенияОшибок);
					ЗаполнитьЗначенияСвойств(НоваяГруппаСтрока, Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Строка,, "ПутьКДаннымЗаголовка");
					
					НоваяПричина 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Причина" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаСтрока);
					ЗаполнитьЗначенияСвойств(НоваяПричина, Элементы.Информация_ПричиныИРешенияОшибок_Причина);
					
					НоваяГруппаРешение 	= Элементы.Добавить("ГруппаИнформация_ПричиныИРешенияОшибок_Решение" + ИндексЭлемента, Тип("ГруппаФормы"), НоваяГруппаСтрока);
					ЗаполнитьЗначенияСвойств(НоваяГруппаРешение, Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Решение,, "ПутьКДаннымЗаголовка");
					
					НовыйОтступ 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Отступ" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаРешение);
					ЗаполнитьЗначенияСвойств(НовыйОтступ, Элементы.Информация_ПричиныИРешенияОшибок_Отступ);
					
					НовоеРешение 		= Элементы.Добавить("Информация_ПричиныИРешенияОшибок_Решение" + ИндексЭлемента, Тип("ДекорацияФормы"), НоваяГруппаРешение);
					ЗаполнитьЗначенияСвойств(НовоеРешение, Элементы.Информация_ПричиныИРешенияОшибок_Решение);
					
				// Если элементы были ранее созданы, то просто показываем их и меняем тексты
				Иначе
					
					НоваяГруппаСтрока	= Элементы.Найти("ГруппаИнформация_ПричиныИРешенияОшибок_Строка" + ИндексЭлемента);
					НоваяПричина 		= Элементы.Найти("Информация_ПричиныИРешенияОшибок_Причина" + ИндексЭлемента);
					НовоеРешение 		= Элементы.Найти("Информация_ПричиныИРешенияОшибок_Решение" + ИндексЭлемента);
					
				КонецЕсли;
				
				НоваяГруппаСтрока.Видимость 	= Истина;
				НоваяПричина.Заголовок 			= "• " + ПричинаИРешение.Ключ;
				НовоеРешение.Заголовок 		= ПричинаИРешение.Значение;
				
				ИндексЭлемента = ИндексЭлемента + 1;
				
			КонецЦикла;
			
			Элементы.ГруппаИнформация_ПричиныИРешенияОшибок_Отступ.Видимость = ИндексЭлемента > 1;
			
		КонецЕсли;
		
		Элементы.ГруппаИнформация_ОписаниеСостоянияОбработки.Видимость = ЗначениеЗаполнено(СокрЛП(ОписаниеСостоянияОбработки));;
		Элементы.ОписаниеСостоянияОбработки.Заголовок = СокрЛП(ОписаниеСостоянияОбработки);
	#Иначе
		ВысотаЭлементаСостояния = 0;
		Если НЕ ЗначениеЗаполнено(СтруктураОшибокСостояний) Тогда
			ВысотаЭлементаСостояния = 3;
			ТекстСостоянияОбработки = пТекстСостоянияОбработки;
		Иначе
			МассивСтрокСостояний = Новый Массив;
			Для Каждого ЭлементСтруктуры Из СтруктураОшибокСостояний Цикл
				
				СтруктураСостояния = ЭлементСтруктуры.Значение;
				Если НЕ ЗначениеЗаполнено(СтруктураСостояния) Тогда
					Продолжить;
				КонецЕсли;
				
				Если Уровень > СтруктураСостояния.Уровень Тогда
					// Выводим минимальный уровень состояния. Так-как могут быть ошибки + предупреждения
					Уровень = СтруктураСостояния.Уровень;
				КонецЕсли;
						
				Если СтруктураСостояния.Уровень = 0 Тогда
					ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Успех");
				ИначеЕсли СтруктураСостояния.Уровень = 1 Тогда
					ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Ошибка");
				ИначеЕсли СтруктураСостояния.Уровень = 2 Тогда
					ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Ошибка");
				ИначеЕсли СтруктураСостояния.Уровень = 3 Тогда
					ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Примечание");
				Иначе
					ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Успех");
				КонецЕсли;
				
				СтруктураНадписи = ЭлементСтруктуры.Значение;
				
				Если ЗначениеЗаполнено(СтруктураСостояния.ОписаниеСостоянияОбработки) Тогда
					НовыйТекстСостояния = Новый ФорматированнаяСтрока(СтруктураСостояния.ОписаниеСостоянияОбработки,, ЦветТекста);
				Иначе
					НовыйТекстСостояния = Новый ФорматированнаяСтрока(СтруктураСостояния.ТекстСостоянияОбработки,, ЦветТекста);
				КонецЕсли;
				
				Если МассивСтрокСостояний.Количество() Тогда
					МассивСтрокСостояний.Добавить(Символы.ПС);
				КонецЕсли;
				МассивСтрокСостояний.Добавить(НовыйТекстСостояния);
				// Т.к. скролл и растягивание по наполнению у форматированной строки добавить нельзя,
				// будем "играться" с высотой поля, отталкиваясь от количества символов в передаваемых строках
				СимволовВСтроке 	= 60; // Мин. ширина поля
				СтрокТекста 			= Окр(СтрДлина(СтруктураСостояния.ОписаниеСостоянияОбработки) / СимволовВСтроке, 0);
				ВысотаЭлементаСостояния = ВысотаЭлементаСостояния + СтрокТекста;
			КонецЦикла;
			ТекстСостоянияОбработки = Новый ФорматированнаяСтрока(МассивСтрокСостояний);
			
		КонецЕсли;
		Элементы.Состояние.Высота = ВысотаЭлементаСостояния;
		
		Если Уровень = 1 ИЛИ Уровень = 2 Тогда
			Элементы.ГруппаОсновнаяЛево.ТекущаяСтраница = Элементы.ГруппаОсновнаяЛево.Страницы.ГруппаПерезапускОбработки;
		Иначе
			//Элементы.ГруппаОсновнаяЛево.ТекущаяСтраница = Элементы.ГруппаОсновнаяЛево.Страницы.РаботаСТСД;
		КонецЕсли;
		
	#КонецЕсли
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если Уровень = 0 Тогда
			ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Успех");
		ИначеЕсли Уровень = 1 Тогда
			ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Ошибка");
		ИначеЕсли Уровень = 2 Тогда
			ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Ошибка");
		ИначеЕсли Уровень = 3 Тогда
			ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Примечание");
		Иначе
			ЦветТекста = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Успех");
		КонецЕсли;
		
		МассивПодстрок = Новый Массив;
		Если НЕ ПустаяСтрока(КодОшибки) Тогда
			
			СсылкаОшибки = "https://www.cleverence.ru/search/?searchid=2471938&text=%23" 
				+ Прав(КодОшибки, СтрДлина(КодОшибки) - 1) + "&web=0#lr=20523&constraintid=0";
			СсылкаОшибки = Новый ФорматированнаяСтрока(КодОшибки,, ЦветТекста,, СсылкаОшибки);
			
			МассивПодстрок.Добавить(СсылкаОшибки);
			МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(". ",, ЦветТекста));
			
		КонецЕсли;
		пТекстСостоянияОбработки = Новый ФорматированнаяСтрока(пТекстСостоянияОбработки,, ЦветТекста);	
		МассивПодстрок.Добавить(пТекстСостоянияОбработки);
		ТекстСостоянияОбработки = Новый ФорматированнаяСтрока(МассивПодстрок);
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеСобытиеЭлементов(Событие, ДопПараметры = Неопределено)
	
	// Не выполняем никакие действия с формой при выполнении внешней команды
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		Возврат;	
	КонецЕсли;
	
	Если Событие = "ОбновлениеОсновнойИнформации" Тогда
		
		ОбновитьОтображениеОсновнойИнформацииПолеHTML(ДопПараметры);
		
	ИначеЕсли Событие = "ЗаполнениеТаблицыНастройкиОбменаСправочников" Тогда
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Если НастройкиОбменаСправочников.Количество() Тогда
				Элементы.НастройкиОбменаСправочников.Видимость = Истина;
				Элементы.ВыгрузкаСправочников_РучнаяВыгрузка_ОписаниеОтсутствиеСправочников.Видимость = Ложь;
			Иначе
				Элементы.НастройкиОбменаСправочников.Видимость = Ложь;
				Элементы.ВыгрузкаСправочников_РучнаяВыгрузка_ОписаниеОтсутствиеСправочников.Видимость = Истина;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтильОформления()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ЦветАкцентирования = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("Акцентирование");
		
		// ГруппаПлитки_Настройки
		ЦветПлитки = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("СерыйСветлый");
		Элементы.ГруппаПлитка_Настройки_ИнтеграционнаяОбработка.ЦветФона			= ЦветПлитки;
		Элементы.ГруппаПлитка_Настройки_БизнесПроцессы.ЦветФона						= ЦветПлитки;
		Элементы.ГруппаПлитка_Настройки_ОтборыДокументов.ЦветФона					= ЦветПлитки;
		Элементы.ГруппаПлитка_Настройки_ПользователиТСД.ЦветФона					= ЦветПлитки;
		Элементы.ГруппаПлитка_Настройки_ГлобальныеПараметры.ЦветФона				= ЦветПлитки;
		Элементы.ГруппаПлитка_Настройки_РасширенныеНастройки.ЦветФона				= ЦветПлитки;
		
		Элементы.ГруппаВыгрузкаСправочников_РучнаяВыгрузка_Тело.ЦветФона			= ЦветПлитки;
		Элементы.ГруппаПлитка_ВыгрузкаСправочников_ОтборыОнлайн.ЦветФона			= ЦветПлитки;
		Элементы.ГруппаПлитка_ВыгрузкаСправочников_ОтборыАвтообмен.ЦветФона			= ЦветПлитки;
		Элементы.ГруппаПлитка_ОбменДокументами_БизнесПроцессы.ЦветФона				= ЦветПлитки;
		Элементы.ГруппаПлитка_ОбменДокументами_ГлобальныеПараметры.ЦветФона			= ЦветПлитки;
		Элементы.ГруппаПлитка_ОбменДокументами_НастройкиОбменаОнлайн.ЦветФона		= ЦветПлитки;
		Элементы.ГруппаПлитка_ОбменДокументами_НастройкиОбменаАвтообмен.ЦветФона	= ЦветПлитки;
		Элементы.ГруппаПлитка_ОбменДокументами_НастройкиОбменаИнтерактивный.ЦветФона= ЦветПлитки;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтильПродукта(ТипПродукта)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ИконкаТекущейБазы.Картинка = ПолучитьИконкуПродукта(ТипПродукта);
		
		// Кнопки в статусах
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ПерезапуститьОбработку);
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ВыборИнтеграционнойОбработки);
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ОтключитьБезопасныйРежимРасширений);
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ОткрытьСписокПодключенныхБазMS);
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ПерезапуститьСеанс1С);
		
		// Кнопки во вкладках
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ВыгрузитьСправочники);
		_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ОткрытьОбменДокументами);
		//_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ОтправитьОтчетОбОшибках);
	#КонецЕсли
	
КонецПроцедуры

// Внешние картинки необходимо устанавливать программно, чтобы не создавать множество копий картинок.
// 	При выгрузке обработки в файлы, внешние картинки дублируются для каждого отдельного элемента.
//	Поэтому загружаем картинку только для одного элемента и далее присваиваем её программно.
// Для загрузки картинки необходимо создать элемент декорации картинка в группе ГруппаКартинкиСлужебный
//	Загрузить в неё картинку и далее прописать элементы в СоответствиеЭлементов, которые будут использовать эту картинку.
&НаКлиенте
Процедура УстановитьВнешниеКартинки()
	
	// Пишем имена картинок без приписки "Картинка"
	СоответствиеЭлементов = Новый Соответствие;

	// Кнопки при ошибках
	СоответствиеЭлементов.Вставить("ПерезапуститьОбработку",														"ПерезагрузитьБелый");
	СоответствиеЭлементов.Вставить("ПерезапуститьСеанс1С",															"ПерезагрузитьБелый");
	СоответствиеЭлементов.Вставить("ВыборИнтеграционнойОбработки",													"ЧекЛистБелый");
	СоответствиеЭлементов.Вставить("ОтключитьБезопасныйРежимРасширений",											"ЧекЛистБелый");
	СоответствиеЭлементов.Вставить("ОткрытьСписокПодключенныхБазMS",												"ЧекЛистБелый");
	
	// Вкладки
	СоответствиеЭлементов.Вставить("ГруппаСтраница_Информация",														"Информация");
	СоответствиеЭлементов.Вставить("ГруппаСтраница_ПодключитьТСД",													"ПодключитьТСД");
	СоответствиеЭлементов.Вставить("ГруппаСтраница_ВыгрузкаСправочников",											"ВыгрузкаСправочниковЧерный");
	СоответствиеЭлементов.Вставить("ГруппаСтраница_ОбменДокументами",												"ОбменДокументамиЧерный");
	СоответствиеЭлементов.Вставить("ГруппаСтраница_Настройки",														"Настройки");
	СоответствиеЭлементов.Вставить("ГруппаСтраница_Техподдержка",													"ТехПоддержка");
	
	// Выгрузка справочников
	СоответствиеЭлементов.Вставить("ВыгрузитьСправочники",															"ВыгрузкаСправочниковБелый");
	СоответствиеЭлементов.Вставить("Плитка_ВыгрузкаСправочников_ОтборыАвтообмен_Картинка",							"ВыгрузкаСправочников");
	СоответствиеЭлементов.Вставить("Плитка_ВыгрузкаСправочников_ОтборыОнлайн_Картинка",								"ВыгрузкаСправочников");
	
	// Обмен документов
	СоответствиеЭлементов.Вставить("ОткрытьОбменДокументами",														"ОбменДокументамиБелый");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_БизнесПроцессы_Картинка",								"БизнесПроцессы");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_ГлобальныеПараметры_Картинка",							"ГлобальныеПараметры");
	
	// Настройки
	СоответствиеЭлементов.Вставить("Плитка_Настройки_БизнесПроцессы_Картинка",										"БизнесПроцессы");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ГлобальныеПараметры_Картинка",									"ГлобальныеПараметры");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ОтборыДокументов_Картинка",									"ОтборыДокументов");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ВыгрузкаСправочников_Картинка",								"ВыгрузкаСправочников");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ПользователиТСД_Картинка",										"ПользователиТСД");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_СкопироватьПодключение_Картинка",								"Узлы");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ИнтеграционнаяОбработка_Картинка",								"ИнтеграционнаяОбработка");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_РасширенныеНастройки_Картинка",								"РасширенныеНастройки");
	
	СоответствиеЭлементов.Вставить("ГруппаПлитка_Настройки_ОтборыДокументов_ГруппаКнопок",							"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("ГруппаПлитка_Настройки_ВыгрузкаСправочников_ГруппаКнопок",						"ЧекЛистЧерный");
	
	// Техподдержка
	СоответствиеЭлементов.Вставить("ОтправитьОтчетОбОшибках",														"ОбращениеВТПЧерный");
	СоответствиеЭлементов.Вставить("ОткрытьЖурналРегистрации",														"Журнал");
	СоответствиеЭлементов.Вставить("СохранитьЛогиДляТехПоддержки",													"Скачать");
	СоответствиеЭлементов.Вставить("ОткрытьБазуЗнаний",																"ВыгрузкаСправочниковЧерный");
	СоответствиеЭлементов.Вставить("ОбновитьНастройкиМетаданные",													"КартинкаОбновить");
	
	// Кнопки настроек
	СоответствиеЭлементов.Вставить("ВыгрузкаСправочников_НастройкиОтборовОнлайн_Кнопка",							"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("ВыгрузкаСправочников_НастройкиОтборовАвтообмен_Кнопка",							"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("ВыгрузкаСправочников_НастройкиОтборовИнтерактивный_Кнопка",						"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_БизнесПроцессы_НастроитьБизнесПроцессы",				"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_ГлобальныеПараметры_НастроитьГлобальныеПараметры",		"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_НастройкиОбменаОнлайн_Кнопка",							"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_НастройкиОбменаАвтообмен_Кнопка",						"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_ОбменДокументами_НастройкиОбменаИнтерактивный_Кнопка",					"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_БизнесПроцессы_НастроитьБизнесПроцессы",						"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ГлобальныеПараметры_НастроитьГлобальныеПараметры",				"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ПользователиТСД_НастроитьПользователей",						"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_СкопироватьПодключение_СкопироватьПодключениеПользователям",	"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_ИнтеграционнаяОбработка_ВыборИнтеграционнойОбработки",			"ЧекЛистЧерный");
	СоответствиеЭлементов.Вставить("Плитка_Настройки_РасширенныеНастройки_ОткрытьРасширенныенастройки",				"ЧекЛистЧерный");
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Для каждого КлючЗначение Из СоответствиеЭлементов Цикл
			Элементы[КлючЗначение.Ключ].Картинка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку(КлючЗначение.Значение);
		КонецЦикла;
	#КонецЕсли
	
КонецПроцедуры 

