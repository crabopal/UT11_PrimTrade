&НаКлиенте
Процедура ОтключитьБезопасныйРежимРасширенийВопрос(РезультатВопроса, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ТекстРезультата = НСтр("ru = 'Результат отключения безопасного режима расширений:';
								|en = 'The result of disabling the safe extension mode:';
								|be = 'Вынік адключэння бяспечнага рэжыму пашырэнняў:'; es = 'Resultado de deshabilitar el modo seguro de extensiones:'; ka = 'უსაფრთხო გაფართოების რეჟიმის გამორთვის შედეგი:'; kk = 'Қауіпсіз кеңейту режимін өшіру нәтижесі:'; ro = 'Rezultatul dezactivării modului de extensie sigură:'; tr = 'Uzantıların güvenli modunu devre dışı bırakmanın sonucu:'; uk = 'Результат відключення безпечного режиму розширень:'; uz = 'Xavfsiz kengaytma rejimini o''chirish natijasi:'");
		РезультатОтключения = _ЛокКонтекст.ЛокЯдро_ОтключитьБезопасныйРежимРасширений();
		Для каждого Расширение Из РезультатОтключения.РезультатыОтключения Цикл
			
			Если Расширение.Отключен Тогда
				пСообщение = НСтр("ru = '- %1 - отключен';
									|en = '- %1 - disabled'; be = '- %1-адключаны'; es = '- %1-desactivado'; ka = '- %1-გამორთულია'; kk = '- %1-өшірілген'; ro = '- %1-dezactivat'; tr = '- %1 - devre dışı'; uk = '- %1-вимкнено'; uz = '- %1-o''chirilgan'");
				пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, Расширение.СинонимРасширения);
				ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.Таб + пСообщение;
			Иначе
				пСообщение = НСтр("ru = '- %1 - ошибка при отключении. Подробности в журнале регистрации.';
									|en = '- %1 - error during shutdown. The details are in the registration log.';
									|be = '- %1-памылка пры адключэнні. Падрабязнасці ў часопісе рэгістрацыі.'; es = '- %1-error de desconexión. Detalles en el registro.'; ka = '- %1-შეცდომა გამორთვის დროს. დეტალები სარეგისტრაციო ჟურნალშია.'; kk = '- %1-өшіру кезінде қате. Толығырақ тіркеу журналында.'; ro = '- %1-eroare în timpul opririi. Detaliile sunt în Jurnalul de înregistrare.'; tr = '- %1 - bağlantı kesilirken hata oluştu. Ayrıntılar kayıt defterinde.'; uk = '- %1-Помилка при відключенні. Подробиці в журналі реєстрації.'; uz = '- %1-o''chirishda xato. Tafsilotlar ro''yxatga olish jurnalida.'");
				пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, Расширение.СинонимРасширения);
				ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.Таб + пСообщение;
				Сообщить(Расширение.ТекстОшибки);
			КонецЕсли;
			
		КонецЦикла;
		
		Если РезультатОтключения.ЕстьИзменения Тогда
			
			пСообщение = НСтр("ru = 'Для применения изменений, необходимо перезапустить программу.';
								|en = 'To apply the changes, you need to restart the program.';
								|be = 'Для прымянення змяненняў, неабходна перазапусціць праграму.'; es = 'Para aplicar los cambios, debe reiniciar el programa.'; ka = 'ცვლილებების გამოსაყენებლად, თქვენ უნდა გადატვირთოთ პროგრამა.'; kk = 'Өзгерістерді қолдану үшін бағдарламаны қайта бастау керек.'; ro = 'Pentru a aplica modificările, trebuie să reporniți programul.'; tr = 'Değişiklikleri uygulamak için programı yeniden başlatmanız gerekir.'; uk = 'Для застосування змін, необхідно перезапустити програму.'; uz = 'O''zgarishlarni qo''llash uchun dasturni qayta ishga tushirishingiz kerak.'");
			пСообщение = пСообщение + Символы.ПС + Символы.ПС + ТекстРезультата;
			
			КнопкиДиалога = Новый СписокЗначений;
			Представление = НСтр("ru = 'Перезапустить программу';
									|en = 'Restart the program'; uk = 'Перезапустити програму'");
			КнопкиДиалога.Добавить("Перезапустить", Представление);
			КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
			
			ОП = Новый ОписаниеОповещения("ВопросПерезапуститьСеанс1СЗавершение", ЭтаФорма);
			ПоказатьВопрос(ОП, пСообщение, КнопкиДиалога);
			
		Иначе
			ОП = Новый ОписаниеОповещения("ВопросПерезапуститьСеанс1СЗавершение", ЭтаФорма);
			ПоказатьВопрос(ОП, ТекстРезультата, РежимДиалогаВопрос.ОК);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

