						|en = 'Learn more about how buttons work'; be = 'Больш падрабязна аб працы кнопак'; es = 'Más información sobre el funcionamiento de los botones'; ka = 'შეიტყვეთ მეტი იმის შესახებ, თუ როგორ მუშაობს ღილაკები'; kk = 'Түймелердің жұмысы туралы толығырақ'; ro = 'Aflați mai multe despre cum funcționează butoanele'; tr = 'Düğmelerin çalışması hakkında daha fazla bilgi edinin'; uk = 'Детальніше про роботу кнопок'; uz = 'Tugmalarning ishlashi haqida ko''proq ma''lumot'");
		МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(Текст,,,, "https://www.cleverence.ru/support/113667"));
