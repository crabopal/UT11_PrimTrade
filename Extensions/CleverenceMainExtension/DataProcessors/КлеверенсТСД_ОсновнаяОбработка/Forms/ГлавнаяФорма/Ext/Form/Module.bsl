&НаКлиенте
Процедура ДобавитьСтрокуВHTMLПолеИнформация(ТекстТаблицы, ДанныеСтроки, ДанныеЗаполнены)
	
	ТекстЗаголовкаЛев 	= ДанныеСтроки.ТекстЗаголовкаЛев;
	СодержимоеЛев 		= ДанныеСтроки.СодержимоеЛев;
	ТекстЗаголовкаПрав 	= ДанныеСтроки.ТекстЗаголовкаПрав;
	СодержимоеПрав 		= ДанныеСтроки.СодержимоеПрав;
	
	Если НЕ ПустаяСтрока(СодержимоеЛев) И ДанныеСтроки.Свойство("ЦветЛев") И ДанныеСтроки.ЦветЛев <> Неопределено Тогда
		
		Цвет = ДанныеСтроки.ЦветЛев;
		Шаблон 	= "<span style=""color: rgb(%1,%2,%3)"">%4</span>";
		СодержимоеЛев 	= _ЛокКонтекст.ЛокЯдро_СтрШаблон(Шаблон, Цвет.Красный, Цвет.Зеленый, Цвет.Синий, СодержимоеЛев);
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СодержимоеПрав) И ДанныеСтроки.Свойство("ЦветПрав") И ДанныеСтроки.ЦветПрав <> Неопределено Тогда
		
		Цвет = ДанныеСтроки.ЦветПрав;
		Шаблон 	= "<span style=""color: rgb(%1,%2,%3)"">%4</span>";
		СодержимоеПрав 	= _ЛокКонтекст.ЛокЯдро_СтрШаблон(Шаблон, Цвет.Красный, Цвет.Зеленый, Цвет.Синий, СодержимоеПрав);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстЗаголовкаЛев) И НЕ ЗначениеЗаполнено(СодержимоеЛев) Тогда
		
		Цвет 			= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("НедоступныеДанные");
		СодержимоеЛев 	= "<span style=""color: rgb(%1,%2,%3)"">--</span>";
		СодержимоеЛев 	= _ЛокКонтекст.ЛокЯдро_СтрШаблон(СодержимоеЛев, Цвет.Красный, Цвет.Зеленый, Цвет.Синий);
		
	Иначе
		ДанныеЗаполнены = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстЗаголовкаПрав) И НЕ ЗначениеЗаполнено(СодержимоеПрав) Тогда
		
		Цвет 			= _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьФирменныйЦвет("НедоступныеДанные");
		СодержимоеПрав 	= "<span style=""color: rgb(%1,%2,%3)"">--</span>";
		СодержимоеПрав 	= _ЛокКонтекст.ЛокЯдро_СтрШаблон(СодержимоеПрав, Цвет.Красный, Цвет.Зеленый, Цвет.Синий);
		
	Иначе
		ДанныеЗаполнены = Истина;
	КонецЕсли;
	
	ТекстСтроки = "
	|	<tr>
    |        <td>
    |            <p class=""block-title"">" + ТекстЗаголовкаЛев + ":</p>
    |            <p class=""block-text"">" + СтрЗаменить(СодержимоеЛев, Символы.ПС, "<br/>") + "</p>
    |        </td>
    |        <td>
    |            <p class=""block-title"">" + ТекстЗаголовкаПрав + ":</p>
    |            <p class=""block-text"">" + СтрЗаменить(СодержимоеПрав, Символы.ПС, "<br/>") + "</p>
    |        </td>
    |    </tr>";
	
	ТекстТаблицы = ТекстТаблицы + ТекстСтроки;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьИконкуПродукта(ТипПродукта)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат Неопределено;
