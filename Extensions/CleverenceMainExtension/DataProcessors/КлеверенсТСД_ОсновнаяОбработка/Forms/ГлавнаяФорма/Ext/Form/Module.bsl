		// Ошибки
		Причина 		= НСтр("ru = 'Долгая загрузка';
							|en = 'Long loading time'; be = 'Доўгая загрузка'; es = 'Carga larga'; ka = 'ხანგრძლივი დატვირთვის დრო'; kk = 'Ұзақ жүктеу'; ro = 'Timp lung de încărcare'; tr = 'Uzun yükleme süreleri'; uk = 'Довге завантаження'; uz = 'Uzoq yuklash'");
		Решение 		= НСтр("ru = 'Если интерфейс основной обработки недоступен, значит, загрузка ещё продолжается. Дождитесь её завершения.';
