			Элементы.КнопкаПоказатьСкрытьНастройки.Заголовок = НСтр("ru = 'Скрыть настройки';
																		|en = 'Hide Settings'; be = 'Схаваць Налады'; es = 'Ocultar configuración'; ka = 'პარამეტრების დამალვა'; kk = 'Параметрлерді жасыру'; ro = 'Ascunde Setările'; tr = 'Ayarları gizle'; uk = 'Сховати Налаштування'; uz = 'Sozlamalarni yashirish'");
			
		КонецЕсли;
	#КонецЕсли
	
