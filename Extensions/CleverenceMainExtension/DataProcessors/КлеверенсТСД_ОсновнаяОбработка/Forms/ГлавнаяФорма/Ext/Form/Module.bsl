Процедура ЗаполнитьТаблицуНастройкиОбменаСправочников()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		// Не выполняем никакие действия с формой при выполнении внешней команды
		Если ВыполнениеВнешнейКоманды = Истина Тогда
			Возврат;	
		КонецЕсли;
		
		НастройкиОбменаСправочников.Очистить();
		
		пНастройкиОбменаСправочников = _ЛокКонтекст.ЛокЯдро_ПолучитьСобранныеНастройкиОбменаСправочниковРежима("Интерактивный", ID_ТекущегоУзла);
		Для каждого СтрокаНастройки Из пНастройкиОбменаСправочников Цикл
			Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") И СтрокаНастройки.ЭтоТаблицаЗначений Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаНастройки.Выгружать = Истина Тогда	
				НоваяСтрока = НастройкиОбменаСправочников.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
				НоваяСтрока.Выгрузить = НСтр("ru = 'Выгрузить';
												|en = 'Upload'; be = 'Выгрузіць'; es = 'Descargar'; ka = 'ატვირთვა'; kk = 'Түсіру'; ro = 'Încarcă'; tr = 'Boşaltmak'; uk = 'Вивантажити'; uz = 'Tushirish'");
				НоваяСтрока.ПараметрыВыгрузки = СтрокаНастройки;
			КонецЕсли;
			
		КонецЦикла;
		
		ОбновитьОтображениеСобытиеЭлементов("ЗаполнениеТаблицыНастройкиОбменаСправочников");
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВБуферОбменаJS() Экспорт
	
	// Вызываем JS метод, т.к работа с буфером обмена появилась только в 8.3.24
	
	СтруктураВызова = Новый Структура;
	СтруктураВызова.Вставить("ТипМетода", "Функция");
	СтруктураВызова.Вставить("ИмяМетода", "ПолучитьСистемнуюИнформациюДляШапкиЛога");
	Попытка
		СисИнфо = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова,, _ЛокКонтекст.АдресаПеременных);
	Исключение
		СисИнфо = Неопределено;
	КонецПопытки;
	
	Если СисИнфо <> Неопределено И СисИнфо.Свойство("ШапкаЛога") И ЗначениеЗаполнено(СисИнфо.ШапкаЛога) Тогда
		
		ШапкаЛога = СисИнфо.ШапкаЛога;
		
		// Вырезаем строку с именами колонок журнала регистрации
		СтрокаШапкиЖурнала = СтрПолучитьСтроку(ШапкаЛога, СтрЧислоСтрок(ШапкаЛога));
		ШапкаЛога = СокрЛП(СтрЗаменить(ШапкаЛога, СтрокаШапкиЖурнала, ""));
		
		ШапкаЛога = ШапкаЛога + Символы.ПС + "Состояние обработки: " + ТекстСостоянияОбработки;
		
		// Добавляем описание состояния
		Если Элементы.ОписаниеСостоянияОбработки.Видимость
			И ЗначениеЗаполнено(Элементы.ОписаниеСостоянияОбработки.Заголовок) Тогда
			
			ШапкаЛога = ШапкаЛога + Символы.ПС + "Описание состояния обработки: " +Элементы.ОписаниеСостоянияОбработки.Заголовок;
			
		КонецЕсли;
		КэшШапкаЛога = ШапкаЛога;
		
		// Копирование реализовано через асинхронную JS функцию в html поле ИнформацияПолеHTML
		// После выполнения метода copyToClipboard, будет вызвано событие ИнформацияПолеHTMLПриНажатии с атрибутом setCopyResult,
		//	которое означает, что работа асинхронного метода copyToClipboard завершена и можно проверять успешность работы с буфером обмена.
		Скопировано = Ложь;
		Попытка
			Элементы.ИнформацияПолеHTML.Документ.defaultView.copyToClipboard(ШапкаЛога);
			Скопировано = Истина;
		Исключение
		КонецПопытки;
		
		Если НЕ Скопировано Тогда
			ПоместитьВБуферОбменаJSПроверитьРезультат(Ложь);
		КонецЕсли;
				
	Иначе
		пСообщение = НСтр("ru = 'Не удалось получить информацию';
							|en = 'Couldn''t get the information'; be = 'Не ўдалося атрымаць інфармацыю'; es = 'No se pudo obtener la información'; ka = 'ვერ მიიღო ინფორმაცია'; kk = 'Ақпарат алу мүмкін болмады'; ro = 'Nu am putut obține informațiile'; tr = 'Bilgi alınamadı'; uk = 'Не вдалося отримати інформацію'; uz = 'Ma''lumot ololmadi'");
		ПоказатьОповещениеПользователя(пСообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВБуферОбменаJSПроверитьРезультат(ПроверятьРезультат = Истина)
	
	// Т.к copyToClipboard выполняется асинхронно в JS, а 1С не будет ожидать результата, 
	//	поэтому отдельной функцией проверяем результат успешности копирования.
	// 0 - в процессе выполнения
	// 1 - успешно
	// 3 - ошибка
	
	РезультатКопирования = 3;
	Если ПроверятьРезультат Тогда
		Попытка
			РезультатКопирования = Элементы.ИнформацияПолеHTML.Документ.defaultView.getCopyResult();
			РезультатКопирования = ?(РезультатКопирования = 0 ИЛИ РезультатКопирования = 1 ИЛИ РезультатКопирования = 3, РезультатКопирования, 3);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если РезультатКопирования = 1 Тогда
		пСообщение = НСтр("ru = 'Скопировано';
							|en = 'Copied'; be = 'Скапіяваны'; es = 'Copiado'; ka = 'გადაწერა'; kk = 'Көшірілді'; ro = 'Copiat'; tr = 'Kopyalandı'; uk = 'Скопійований'; uz = 'Ko''chirilgan'");
		ПоказатьОповещениеПользователя(пСообщение);
	Иначе
		пСообщение = НСтр("ru = 'Не удалось скопировать информацию. Пожалуйста, скопируйте текст вручную из открывшегося окна.';
							|en = 'Couldn''t copy the information. Please copy the text manually from the window that opens.';
							|be = 'Не атрымалася скапіяваць інфармацыю. Калі ласка, скапіюйце тэкст ўручную з адкрытага акна.'; es = 'No se pudo copiar la información. Por favor, copie el texto manualmente desde la ventana que se abre.'; ka = 'ინფორმაციის კოპირება ვერ მოხერხდა. გთხოვთ, ხელით დააკოპიროთ ტექსტი გახსნილი ფანჯრიდან.'; kk = 'Ақпаратты көшіру мүмкін болмады. Мәтінді ашылған терезеден қолмен көшіріңіз.'; ro = 'Nu am putut copia informația. Copiați textul manual din fereastra care se deschide.'; tr = 'Bilgileri kopyalayamadım. Lütfen metni açılan pencereden manuel olarak kopyalayın.'; uk = 'Не вдалося скопіювати інформацію. Будь ласка, скопіюйте текст вручну з вікна, що відкриється.'; uz = 'Ma''lumotni nusxalash mumkin emas edi. Iltimos, ochilgan oynadan matnni qo''lda nusxalash.'");
		Сообщить(пСообщение);
		
		ОП = Новый ОписаниеОповещения("СкопироватьВручнуюЗавершение", ЭтаФорма);
		пСообщение = НСтр("ru = 'Скопируйте текст';
							|en = 'Copy the text'; be = 'Скапіруйце тэкст'; es = 'Copiar texto'; ka = 'დააკოპირეთ ტექსტი'; kk = 'Мәтінді көшіріңіз'; ro = 'Copiați textul'; tr = 'Metni kopyalayın'; uk = 'Скопіюйте текст'; uz = 'Matnni nusxalash'");
		ПоказатьВводСтроки(ОП, КэшШапкаЛога, пСообщение,, Истина);
	КонецЕсли;
	КэшШапкаЛога = Неопределено;
	
КонецПроцедуры 

