#Область ПодключениеКБазе

&НаКлиенте
Процедура Подключение_ПодключитьсяКБазе(ПараметрыПодключенияMS, ДополнительныеПараметры  = Неопределено)
	
	ИмяСобытия = "Подключение_ПодключитьсяКБазе";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS,ДополнительныеПараметры",
		ПараметрыПодключенияMS, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ВыполняетсяВФоне = ДоступноВыполнениеВФоне;
	
	Подключение_ЗаполнитьПараметрыПодключаемойБазы();
	УстановитьСписокВыбораПодключенныхБаз();
	
	Если ПараметрыПодключенияMS <> Неопределено Тогда
		
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"НачалоВыполненияПроцедурыЗапускаОбработки", 
			, 
			"ЗапускОсновнойОбработки");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
		ОП = Новый ОписаниеОповещения("Подключение_ПослеПроверкиСоединения", ЭтаФорма, ДополнительныеПараметры);
		
		пСообщение = НСтр("ru = 'Начало';
							|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", пСообщение, НачалоСобытия);
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(ПараметрыПодключенияMS,Ложь,,РасположениеКомпоненты,,,ОП);
		пСообщение = НСтр("ru = 'Конец';
							|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", пСообщение, НачалоСобытия);
	
	Иначе
		
		// <Лог>
		пСообщение = "Настройки подключения отсутствуют.";
		_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, пСообщение);
		// </Лог>
		
		// Ошибка. Подключение еще не было настроено
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
			"ОтсутствуютНастройкиПодключения",
			,
			"ЗапускОсновнойОбработки");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);

		Если НЕ ВыполнениеВнешнейКоманды = Истина Тогда
			ОткрытьФормуНастройкиПодключения();			
		Иначе
			ОповещениеВопросОткрытьГлавнуюФорму = Новый ОписаниеОповещения("ВопросОткрытьГлавнуюФормуЗавершение", ЭтаФорма);
			пСообщение 	= НСтр("ru = 'Подключение к базе Клеверенс не настроено. Открыть обработку Клеверенс для настройки подключения?';
								|en = 'Connection to the Cleverence database is not configured. Open the Cleverence processing to configure the connection?';
								|uk = 'Підключення до бази Cleverence не налаштовано. Відкрити обробку Cleverence для налаштування підключення?'");
			ЗаголовокВопроса = НСтр("ru = 'Внимание';
										|en = 'Attention'; be = 'Увага'; es = 'Atención'; ka = 'ყურადღება'; kk = 'Назар аударыңыз'; ro = 'Atenție'; tr = 'Dikkat'; uk = 'Увага'; uz = 'Diqqat'");
			ПоказатьВопрос(ОповещениеВопросОткрытьГлавнуюФорму, пСообщение, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса); 
		КонецЕсли;
		
	КонецЕсли;
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключение_ПослеПроверкиСоединения(ПодключениеДоступно, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "Подключение_ПослеПроверкиСоединения";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПодключениеДоступно,ДополнительныеПараметры",
		ПодключениеДоступно, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ТипЗнч(ПодключениеДоступно) = Тип("Структура") Тогда
		СтруктураАвторизации = ПодключениеДоступно;
		ПодключениеДоступно = СтруктураАвторизации.Свойство("ПодключениеДоступно") И СтруктураАвторизации.ПодключениеДоступно = Истина;
	КонецЕсли;
	
	ПараметрыБазыMS = Неопределено;
	Если ПодключениеДоступно = Истина Тогда	
		пСообщение = НСтр("ru = 'Начало';
							|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПолучитьОписаниеБазыSMARTS", "Информация", пСообщение, НачалоСобытия);
		ПараметрыБазыMS = _ЛокКонтекст.ЛокЯдро_ПолучитьОписаниеБазыSMARTS(РасположениеКомпоненты,, "REST_API");
		пСообщение = НСтр("ru = 'Конец';
							|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПолучитьОписаниеБазыSMARTS", "Информация", пСообщение, НачалоСобытия);
	КонецЕсли;
	
	Подключение_ЗаполнитьПараметрыПодключаемойБазы(ПараметрыБазыMS);
	
	Если ПараметрыБазыMS <> Неопределено Тогда
		
		// <Лог>
		пСообщение = "Инициализация к базе.";
		
		логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
			"ПараметрыБазыMS",
			ПараметрыБазыMS);
			
		_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, пСообщение, логКонтекст);
		// </Лог>
		
		_ЛокКонтекст.ПараметрыПодключенияMS = ПараметрыБазыMS;
		_ЛокКонтекст.ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыБазыMS);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ПараметрыБазыMS);
		
		ИзмениласьВерсияКонфигурацииSMARTS = _ЛокКонтекст.ЛокЯдро_ИнициализацияНастроек_ИзмениласьВерсияКонфигурацииSMARTS(ПараметрыБазыMS);
		Если ИзмениласьВерсияКонфигурацииSMARTS Тогда
			_ЛокКонтекст.ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(ПараметрыБазыMS);
		КонецЕсли;
		
		Подключение_ПодключитьИнтеграционнуюОбработку(ПараметрыБазыMS);
		Подключение_НачатьИнициализацию();
		
	Иначе
		
		// <Лог>
		пСообщение = "База недоступна.";
		_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, пСообщение);
		// </Лог>
		
		ПараметрыПодключенияMS = ДополнительныеПараметры.ПараметрыПодключенияMS;
		
		Если НЕ Подключение_МиграцияНастроекПодключения(ПараметрыПодключенияMS) Тогда
			Подключение_ОтобразитьНедоступностьБазы(ПараметрыПодключенияMS);
		КонецЕсли;
		
	КонецЕсли;
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>

КонецПроцедуры

&НаКлиенте
Процедура Подключение_ОтобразитьНедоступностьБазы(ПараметрыПодключенияMS)
	
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
		"РаботаССерверомБазаНедоступна",
		ПараметрыПодключенияMS,
		"ПодключениеКБазеSMARTS");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		ОповещениеВопросОткрытьГлавнуюФорму = Новый ОписаниеОповещения("ВопросОткрытьГлавнуюФормуЗавершение", ЭтаФорма);
		
		пСообщение = НСтр("ru = 'Отсутствует соединение с базой Клеверенс. Открыть обработку Клеверенс для настройки подключения?';
							|en = 'There is no connection to the Cleverence database. Open the Cleverence processing to configure the connection?';
							|be = 'Адсутнічае злучэнне з базай Cleverence. Адкрыць апрацоўку Cleverence для налады падлучэння?'; es = 'No hay conexión con la base de Cleverence. ¿Abrir el procesamiento de Cleverence para configurar la conexión?'; ka = 'არ არსებობს კავშირი Cleverence მონაცემთა ბაზასთან. გახსენით Cleverence დამუშავება კავშირის კონფიგურაციისთვის?'; kk = 'Cleverence базасымен байланыс жоқ. Қосылымды орнату үшін Cleverence өңдеуін ашыңыз?'; ro = 'Nu există nicio legătură cu baza de date Cleverence. Deschideți procesarea inteligentă pentru a configura conexiunea?'; tr = 'Cleverence tabanına bağlantı yok. Bağlantıyı yapılandırmak için Cleverence işlemeyi açın mı?'; uk = 'Відсутнє з''єднання з базою Cleverence. Відкрити обробку Cleverence для налаштування підключення?'; uz = 'Cleverence bazasiga ulanish yo''q. Ulanishni sozlash uchun Cleverence jarayonini ochasizmi?'");
							
		ЗаголовокВопроса = НСтр("ru = 'Внимание';
									|en = 'Attention'; be = 'Увага'; es = 'Atención'; ka = 'ყურადღება'; kk = 'Назар аударыңыз'; ro = 'Atenție'; tr = 'Dikkat'; uk = 'Увага'; uz = 'Diqqat'");
		ПоказатьВопрос(ОповещениеВопросОткрытьГлавнуюФорму, пСообщение, РежимДиалогаВопрос.ДаНет,,, ЗаголовокВопроса);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция Подключение_МиграцияНастроекПодключения(ПараметрыПодключенияMS)
	
	ИмяСобытия = "Подключение_МиграцияНастроекПодключения";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыПодключенияMS",
		ПараметрыПодключенияMS);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	МиграцияНастроекПодключенияДоступна = НЕ МиграцияНастроекПодключенияВыполнена
		И ВыполнениеВнешнейКоманды <> Истина;
		
	Если МиграцияНастроекПодключенияДоступна Тогда
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(ПараметрыПодключенияMS.СтрокаПодключенияСМАРТС);
	КонецЕсли;
	
	Если МиграцияНастроекПодключенияДоступна Тогда
		ИдБазыДоМиграции 					= ПараметрыПодключенияMS.Ид;
		ПутьНаСервереДоМиграции 			= СтруктураURI.ПутьНаСервере;
		МиграцияНастроекПодключенияДоступна = СтруктураURI.Порт = 10501
			И ЗначениеЗаполнено(СтруктураURI.Хост)
			И ЗначениеЗаполнено(ПутьНаСервереДоМиграции)
			И ЗначениеЗаполнено(ИдБазыДоМиграции);
	КонецЕсли;
	
	Если МиграцияНастроекПодключенияДоступна Тогда
		СхемаПодключения = СтруктураURI.Схема;
		Если НЕ ЗначениеЗаполнено(СхемаПодключения) Тогда
			СхемаПодключения = "http";
		КонецЕсли;
		
		СтрокаПодключенияПослеМиграции = СхемаПодключения + "://" + СтруктураURI.Хост + ":10503/" + ПутьНаСервереДоМиграции;
	КонецЕсли;
	
	Если МиграцияНастроекПодключенияДоступна Тогда
		
		МиграцияНастроекПодключенияВыполнена 	= Истина;
		СтрокаПодключенияДоМиграции 			= ПараметрыПодключенияMS.СтрокаПодключенияСМАРТС;
		РасположениеКомпонентыДляМиграции 		= РасположениеКомпоненты;
		Если НЕ ЗначениеЗаполнено(РасположениеКомпонентыДляМиграции) Тогда
			РасположениеКомпонентыДляМиграции = "НаСервере";
		КонецЕсли;
		
		ПараметрыВыполнения 						= _ЛокКонтекст.ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
		ПараметрыВыполнения.СтрокаПодключенияСМАРТС = СтрокаПодключенияПослеМиграции;
		ПараметрыВыполнения.РасположениеКомпоненты 	= РасположениеКомпонентыДляМиграции;
		ПараметрыВыполнения.СпособЗапуска 			= "ОткрытиеОсновнойОбработки";
		
		ДополнительныеПараметрыМиграции = Новый Структура;
		ДополнительныеПараметрыМиграции.Вставить("ПараметрыПодключенияMS", 				ПараметрыПодключенияMS);
		ДополнительныеПараметрыМиграции.Вставить("ИдБазыДоМиграции", 					ИдБазыДоМиграции);
		ДополнительныеПараметрыМиграции.Вставить("СтрокаПодключенияДоМиграции", 		СтрокаПодключенияДоМиграции);
		ДополнительныеПараметрыМиграции.Вставить("СтрокаПодключенияПослеМиграции", 		СтрокаПодключенияПослеМиграции);
		ДополнительныеПараметрыМиграции.Вставить("РасположениеКомпонентыДляМиграции", 	РасположениеКомпонентыДляМиграции);
		ПараметрыВыполнения.ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения(
			"Подключение_МиграцияНастроекПодключенияЗавершение",
			ЭтаФорма,
			ДополнительныеПараметрыМиграции);
			
		// <Лог>
		ЯзСтрока = "ru = 'Начата миграция настроек подключения базы SMARTS. Ид базы: %1. Строка подключения до миграции: %2. Строка подключения после миграции: %3.'";
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока),
			ИдБазыДоМиграции,
			СтрокаПодключенияДоМиграции,
			СтрокаПодключенияПослеМиграции);
		
		логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
			"ИдБазыДоМиграции,СтрокаПодключенияДоМиграции,СтрокаПодключенияПослеМиграции",
			ИдБазыДоМиграции,
			СтрокаПодключенияДоМиграции,
			СтрокаПодключенияПослеМиграции);
		_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
		// </Лог>
		
		_ЛокКонтекст.ЛокЯдро_НастройкаПодключения_ПроверитьСоединение(ПараметрыВыполнения);
		
	КонецЕсли;
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия, , "", МиграцияНастроекПодключенияДоступна);
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие, логКонтекст);
	// </Лог>
	
	Возврат МиграцияНастроекПодключенияДоступна;
	
КонецФункции

&НаКлиенте
Процедура Подключение_МиграцияНастроекПодключенияЗавершение(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "Подключение_МиграцияНастроекПодключенияЗавершение";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения,ДополнительныеПараметры",
		ПараметрыВыполнения,
		ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПараметрыВыполнения.ПодключениеДоступно = Истина
		И ПараметрыВыполнения.ПараметрыБазыMS.Ид = ДополнительныеПараметры.ИдБазыДоМиграции Тогда
		
		ПараметрыВыполненияНастройки 							= _ЛокКонтекст.ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
		ПараметрыВыполненияНастройки.СтрокаПодключенияСМАРТС 	= ДополнительныеПараметры.СтрокаПодключенияПослеМиграции;
		ПараметрыВыполненияНастройки.ТипБазы 					= "Основная";
		ПараметрыВыполненияНастройки.РасположениеКомпоненты 	= ДополнительныеПараметры.РасположениеКомпонентыДляМиграции;
		ПараметрыВыполненияНастройки.СпособЗапуска 				= "ОткрытиеОсновнойОбработки";
		
		ПараметрыВыполненияНастройки.ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения(
			"Подключение_МиграцияНастроекПодключенияНастройкаЗавершение",
			ЭтаФорма,
			ДополнительныеПараметры);
			
		// <Лог>
		ЯзСтрока = "ru = 'Миграция настроек подключения подтверждена, запускается настройка подключения. Ид базы после проверки: %1.'";
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока),
			ПараметрыВыполнения.ПараметрыБазыMS.Ид);
		
		логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
			"ИдБазыПослеМиграции",
			ПараметрыВыполнения.ПараметрыБазыMS.Ид);
		_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
		// </Лог>
		
		_ЛокКонтекст.ЛокЯдро_НастройкаПодключения_НастроитьПодключение(ПараметрыВыполненияНастройки);
		
	Иначе
		
		// <Лог>
		ЯзСтрока = "ru = 'Миграция настроек подключения не подтверждена. Подключение доступно: %1.'";
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока),
			ПараметрыВыполнения.ПодключениеДоступно);
		
		логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
			"ПараметрыВыполнения",
			ПараметрыВыполнения);
		_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
		// </Лог>
		
		Подключение_ОтобразитьНедоступностьБазы(ДополнительныеПараметры.ПараметрыПодключенияMS);
		
	КонецЕсли;
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура Подключение_МиграцияНастроекПодключенияНастройкаЗавершение(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "Подключение_МиграцияНастроекПодключенияНастройкаЗавершение";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения,ДополнительныеПараметры",
		ПараметрыВыполнения,
		ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если ПараметрыВыполнения.ПодключениеДоступно <> Истина Тогда
		
		// <Лог>
		ЯзСтрока = "ru = 'Настройка подключения после миграции не выполнена. Подключение доступно: %1.'";
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(НСтр(ЯзСтрока),
			ПараметрыВыполнения.ПодключениеДоступно);
		
		логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
			"ПараметрыВыполнения",
			ПараметрыВыполнения);
		_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, ЯзСтрока, логКонтекст);
		// </Лог>
		
		Подключение_ОтобразитьНедоступностьБазы(ДополнительныеПараметры.ПараметрыПодключенияMS);
	Иначе
		
		// <Лог>
		ЯзСтрока = "ru = 'Миграция настроек подключения завершена.'";
		пСообщение = НСтр(ЯзСтрока);
		
		_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, ЯзСтрока);
		// </Лог>
		
	КонецЕсли;
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура Подключение_ПодключитьИнтеграционнуюОбработку(ПараметрыБазыMS)
	
	ИмяСобытия = "Подключение_ПодключитьИнтеграционнуюОбработку";
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	// Подключаем ИО
	ПараметрыОбработки = Новый Структура;
	ТипОбработки = ?(НЕ ПараметрыБазыMS.Свойство("ТипОбработки") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыБазыMS.ТипОбработки), "ФайлНаДиске", ПараметрыБазыMS.ТипОбработки);
	ПараметрыОбработки.Вставить("ТипОбработки", 			   ТипОбработки);
	ПараметрыОбработки.Вставить("ИмяИнтеграционнойОбработки",  ПараметрыБазыMS.ИмяИнтеграционнойОбработки);
	ПараметрыОбработки.Вставить("ПутьИнтеграционнойОбработки", ПараметрыБазыMS.ПутьИнтеграционнойОбработки);
	_ЛокКонтекст.ЛокЯдро_ПодключитьИнтеграционнуюОбработкуПриОткрытии(, ПараметрыОбработки);
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключение_НачатьИнициализацию()
	
	ИмяСобытия = "Подключение_НачатьИнициализацию";
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	ОП = Новый ОписаниеОповещения("Подключение_ЗавершениеИнициализации", ЭтаФорма);
	Если РасположениеКомпоненты = "НаСервере"
		И ДоступноВыполнениеВФоне Тогда
		_ЛокКонтекст.ЛокЯдро_Инициализация(, ОП);
	Иначе
		_ЛокКонтекст.ЛокЯдро_Инициализация();
		ВыполнитьОбработкуОповещения(ОП);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключение_ЗавершениеИнициализации(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "Подключение_ЗавершениеИнициализации";
	
	// <Лог>
	логПоток = _ЛокКонтекст.ЛогОткрытьПоток(ИмяСобытия, ЭтаФорма);
	
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"Результат,ДополнительныеПараметры",
		Результат, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Автотесты_ЗавершитьЗамерПроизводительности("Подключение_НачатьИнициализацию", "Подключение_ЗавершениеИнициализации");
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Результат = "ОшибкаИнициализации" Тогда
		
		// <Лог>
		пСообщение = "Ошибка инициализации базы.";
		_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, пСообщение);
		// </Лог>
		
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
			"РаботаССерверомБазаНедоступна", 
			"", 
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Если Не ВыполнениеВнешнейКоманды = Истина Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка инициализации базы Клеверенс. Повторите попытку или выберите другую базу.';
									|en = 'Error initializing the Cleverence database. Try again or choose another database.';
									|be = 'Памылка ініцыялізацыі базы Cleverence. Паўтарыце спробу або абярыце іншую базу.'; es = 'Error de inicialización de base Cleverence. Inténtelo de nuevo o seleccione otra base.'; ka = 'შეცდომა Cleverence მონაცემთა ბაზის ინიციალიზაცია. სცადეთ კიდევ ერთხელ ან აირჩიეთ სხვა მონაცემთა ბაზა.'; kk = 'Cleverence базасын инициализациялау қатесі. Әрекетті қайталаңыз немесе басқа негізді таңдаңыз.'; ro = 'Eroare la inițializarea bazei de date Cleverence. Încercați din nou sau alegeți o altă bază de date.'; tr = 'Cleverence tabanı başlatma hatası. Tekrar deneyin veya farklı bir taban seçin.'; uk = 'Помилка ініціалізації бази Cleverence. Повторіть спробу або виберіть іншу базу.'; uz = 'Cleverence ma''lumotlar bazasini ishga tushirishda xatolik yuz berdi. Qayta urinib ko''ring yoki boshqa bazani tanlang.'");
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить(); 
		Иначе
			ОповещениеВопросОткрытьГлавнуюФорму = Новый ОписаниеОповещения("ВопросОткрытьГлавнуюФормуЗавершение", ЭтаФорма);
			ТекстВопроса = НСтр("ru = 'Ошибка инициализации базы Клеверенс. Открыть обработку Клеверенс для настройки подключения?';
									|en = 'Error initializing the Cleverence database. Open the Cleverence processing to configure the connection?';
									|be = 'Памылка ініцыялізацыі базы Cleverence. Адкрыць апрацоўку Cleverence для налады падлучэння?'; es = 'Error de inicialización de base Cleverence. ¿Abrir el procesamiento de Cleverence para configurar la conexión?'; ka = 'შეცდომა Cleverence მონაცემთა ბაზის ინიციალიზაცია. გახსენით Cleverence დამუშავება კავშირის კონფიგურაციისთვის?'; kk = 'Cleverence базасын инициализациялау қатесі. Қосылымды орнату үшін Cleverence өңдеуін ашыңыз?'; ro = 'Eroare la inițializarea bazei de date Cleverence. Deschideți procesarea inteligentă pentru a configura conexiunea?'; tr = 'Cleverence tabanı başlatma hatası. Bağlantıyı yapılandırmak için Cleverence işlemeyi açın mı?'; uk = 'Помилка ініціалізації бази Cleverence. Відкрити обробку Cleverence для налаштування підключення?'; uz = 'Cleverence ma''lumotlar bazasini ishga tushirishda xatolik yuz berdi. Ulanishni sozlash uchun Cleverence jarayonini ochasizmi?'");
			ЗаголовокВопроса = НСтр("ru = 'Внимание';
										|en = 'Attention'; be = 'Увага'; es = 'Atención'; ka = 'ყურადღება'; kk = 'Назар аударыңыз'; ro = 'Atenție'; tr = 'Dikkat'; uk = 'Увага'; uz = 'Diqqat'");
			ПоказатьВопрос(ОповещениеВопросОткрытьГлавнуюФорму, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, ЗаголовокВопроса); 
		КонецЕсли;
		
		// <Лог>
		_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
		_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
		// </Лог>
		
		Возврат;
		
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ИзменитьТекущиеНастройкиMS(_ЛокКонтекст.ТекущиеНастройкиMS);
	_ЛокКонтекст.ЛокЯдро_ОбновитьПараметрыПодключения1С(Ложь);
	
	// Обновление компонент
	ПараметрыОбновления = _ЛокКонтекст.ЛокЯдро_ОбновлениеКомпонент_СтруктураПараметровВызова();
	Если СтруктураПараметровЗапуска <> Неопределено Тогда
		СтруктураПараметровЗапуска.Свойство("ЭтоТестКлиент", ПараметрыОбновления.ЭтоТестКлиент);
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("Подключение_ОбновлениеКомпонентЗавершение", ЭтаФорма);
	ПараметрыОбновления.ОповещениеОбработкиЗавершения = ОП;
	
	_ЛокКонтекст.ЛокЯдро_ОбновлениеКомпонент_ОбновитьИзПодключеннойБазы(ПараметрыОбновления);
	
	// Действия после инициализации
	Подключение_ПослеИнициализации();
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	_ЛокКонтекст.ЛогЗакрытьПоток(логПоток);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура Подключение_ОбновлениеКомпонентЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	
	
