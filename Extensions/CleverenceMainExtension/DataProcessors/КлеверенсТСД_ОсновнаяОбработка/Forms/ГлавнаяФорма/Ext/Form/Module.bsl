Процедура СкопироватьНастройкиПодключенияПользователям(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму("ОФ_ФормаСлужебная_ПодборПользователей1С", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ПодборПользователей1С = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ПодборПользователей1С", , ЭтаФорма);	
	#КонецЕсли
	
	ФормаСлужебная_ПодборПользователей1С.ЗакрыватьПриЗакрытииВладельца 	= Истина;
	ФормаСлужебная_ПодборПользователей1С._ЛокКонтекст 					= _ЛокКонтекст;	
	ФормаСлужебная_ПодборПользователей1С.ПодборДляКопированияНастроек	= Истина;
	
	ОП = Новый ОписаниеОповещения("СкопироватьНастройкиПодключенияДругимПользователям1СЗавершение", ЭтаФорма);
	ФормаСлужебная_ПодборПользователей1С.ОписаниеОповещенияОЗакрытии = ОП;
	
	ФормаСлужебная_ПодборПользователей1С.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНастройкиБизнесПроцессов(Команда)
	
	ОП = Новый ОписаниеОповещения("РедактироватьНастройкиБизнесПроцессовПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтчетОбОшибкахНажатие(Команда)
	
	СерверКачестваДоступен = _ЛокКонтекст.ЛокЯдро_СерверКачества_ПроверитьДоступностьСервера();
	
	Если СерверКачестваДоступен = Ложь Тогда
		Сообщить(НСтр("ru = 'Портал технической поддержки Клеверенс недоступен. Попробуйте позже.';
						|en = 'The Cleverence Technical Support portal is unavailable. Try again later.';
						|be = 'Партал тэхнічнай падтрымкі Cleverence недаступны. Паспрабуйце пазней.'; es = 'El portal de soporte técnico de Cleverence no está disponible. Inténtalo más tarde.'; ka = 'Cleverence ტექნიკური მხარდაჭერის პორტალი მიუწვდომელია. სცადეთ მოგვიანებით.'; kk = 'Cleverence техникалық қолдау порталы қол жетімді емес. Кейінірек көріңіз.'; ro = 'Portalul de asistență tehnică Cleverence nu este disponibil. Încercați din nou mai târziu.'; tr = 'Cleverence Teknik Destek Portalı mevcut değildir. Daha sonra dene.'; uk = 'Портал технічної підтримки Cleverence недоступний. Спробуйте пізніше.'; uz = 'Cleverence texnik qo''llab-quvvatlash portali mavjud emas. Keyinroq sinab ko''ring.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ГлубинаОтбора", 3);
	ПараметрыМетода.Вставить("СрокДоСледующейПроверки", 3);
	ПараметрыМетода.Вставить("РучноеФормирование", Истина);
	ПараметрыМетода.Вставить("ДатаТекущейПроверки", НачалоДня(ТекущаяДата()));
	_ЛокКонтекст.ЛокЯдро_СерверКачества_ОткрытьФормуОтправкиОтчетаОбОшибках(ПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьБезопасныйРежимРасширений(Команда)
	
	ОП = Новый ОписаниеОповещения("ОтключитьБезопасныйРежимРасширенийВопрос", ЭтаФорма);
	
	пСообщение = НСтр("ru = 'Отключить безопасный режим для расширений Клеверенс?';
						|en = 'Disable the safe mode for Cleverence extensions?';
						|be = 'Адключыць бяспечны рэжым для пашырэньні Cleverence?'; es = '¿Deshabilitar el modo seguro para las extensiones de Cleverence?'; ka = 'გამორთეთ უსაფრთხო რეჟიმი Cleverence გაფართოებისთვის?'; kk = 'Cleverence кеңейтімдері үшін қауіпсіз режимді өшіресіз бе?'; ro = 'Dezactivați Modul sigur pentru extensiile Cleverence?'; tr = 'Cleverence uzantıları için güvenli modu devre dışı mı bırakıyorsunuz?'; uk = 'Вимкнути безпечний режим для розширень Cleverence?'; uz = 'Cleverence kengaytmalari uchun xavfsiz rejimni o''chirib qo''yasizmi?'");
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезапуститьСеанс1С(Команда)
	
	пСообщение = НСтр("ru = 'Перезапустить сеанс 1С?';
						|en = 'Restart the 1C session?'; uk = 'Перезапустити сеанс 1С?'");
	
	КнопкиДиалога = Новый СписокЗначений;
	Представление = НСтр("ru = 'Перезапустить программу';
							|en = 'Restart the program'; uk = 'Перезапустити програму'");
	КнопкиДиалога.Добавить("Перезапустить", Представление);
	КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
	
	ОП = Новый ОписаниеОповещения("ВопросПерезапуститьСеанс1СЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, КнопкиДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБазуЗнаний(Команда)
	
	_ЛокКонтекст.ЛокЯдро_ОткрытьСсылкуВнешнегоРесурса(ПолучитьСсылкуНаВнешнийРесурс("БазаЗнаний"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналРегистрации(Команда)
	
	//  Отбор - Структура:
	//      Пользователь              - Строка
	//                                - СписокЗначений - имя или список пользователей информационной базы.
	//      СобытиеЖурналаРегистрации - Строка, Массив - идентификатор события.
	//      ДатаНачала                - Дата           - начало интервала отображаемых событий.
	//      ДатаОкончания             - Дата           - конец интервала отображаемых событий.
	//      Данные                    - Произвольный   - данные любого типа.
	//      Сеанс                     - СписокЗначений - список выбираемых сеансов.
	//      Уровень                   - Строка, Массив - представление уровня важности события журнала регистрации.
	//      ИмяПриложения             - Массив         - массив идентификаторов приложения.
	
	Если _ЛокКонтекст.ЛокЯдро_ОбщийМодульСуществует("ЖурналРегистрацииКлиент") Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("СобытиеЖурналаРегистрации", ПолучитьИменаСобытийЖурналаРегистрации());
		Отбор.Вставить("Уровень", "Ошибка");
		
		МодульЖурналРегистрацииКлиент = _ЛокКонтекст.ЛокЯдро_ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор, ЭтаФорма);
		
	ИначеЕсли _ЛокКонтекст.ЛокЯдро_ОбщийМодульСуществует("EventLogClient") Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("EventLogEvent", ПолучитьИменаСобытийЖурналаРегистрации());
		Отбор.Вставить("Level", "Error");
		
		МодульЖурналРегистрацииКлиент = _ЛокКонтекст.ЛокЯдро_ОбщийМодуль("EventLogClient");
		МодульЖурналРегистрацииКлиент.OpenEventLog(Отбор, ЭтаФорма);
		
	Иначе
		Сообщить("Не удалось открыть журнал регистрации");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройкиМетаданные(Команда)
	
	// Обновление метаданных 1С
	_ЛокКонтекст.ЛокЯдро_ОбновлениеМетаданныхДокументов1С(Ложь);
	
	// Обновление метаданных MS
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДанныеУстройствMS",   Неопределено);
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаЗапросаЛицензий", Неопределено);
	
	пСтруктураМетаданных = _ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеДокументовMS(Ложь, Истина);
	
	// Обновление настроек
	ПараметрыПодключенияMS = _ЛокКонтекст.ПараметрыПодключенияMS;
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
		
	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторБазыMS) Тогда
		Сообщение = НСтр("ru = 'Не удалось определить идентификатор подключенной базы Клеверенс!';
							|en = 'The ID of the connected Cleverence database could not be determined!';
							|be = 'Не ўдалося вызначыць ідэнтыфікатар падключанай базы Cleverence!'; es = '¡No se pudo determinar el id de base de Cleverence conectada!'; ka = 'დაკავშირებული Cleverence მონაცემთა ბაზის ID ვერ განისაზღვრა!'; kk = 'Қосылған Cleverence базасының идентификаторын анықтау мүмкін болмады!'; ro = 'ID-ul bazei de date connected Cleverence nu a putut fi determinat!'; tr = 'Bağlı Cleverence veritabanının kimliği belirlenemedi!'; uk = 'Не вдалося визначити ідентифікатор підключеної бази Cleverence!'; uz = 'Ulangan Cleverence ma''lumotlar bazasi identifikatorini aniqlab bo''lmadi!'");
		Сообщить(Сообщение); 
		Возврат;		
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS);
	
	ИнициализацияВФоне = _ЛокКонтекст.ДоступноВыполнениеВФоне И НЕ _ЛокКонтекст.РасположениеКомпоненты = "НаКлиенте";
		
	ОписаниеОповещения = Неопределено;
	Если ИнициализацияВФоне Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПроверкуБизнесПроцессовПослеИнициализации", ЭтаФорма);
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(ПараметрыПодключенияMS);
	
	_ЛокКонтекст.ЛокЯдро_Инициализация(ПараметрыПодключенияMS, ОписаниеОповещения);
	
	Если НЕ ИнициализацияВФоне Тогда
		ВыполнитьПроверкуБизнесПроцессовПослеИнициализации(, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

