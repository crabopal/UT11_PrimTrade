		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Магазин" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Прайсчекер" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + "Магазин"); // Иконка от магазина
		
	ИначеЕсли ТипПродукта = "Фабрика" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Учет" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "УчетИмущества" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Курьер" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Кировка" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	ИначеЕсли ТипПродукта = "Клеверенс" Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Иконка" + ТипПродукта);
		
	КонецЕсли;
	
	Если Иконка = Неопределено Тогда
		Иконка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("ИконкаКлеверенс");
	КонецЕсли;
	
	Возврат Иконка;
	
