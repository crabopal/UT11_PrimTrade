&НаКлиенте
Процедура Подключение_ПослеИнициализации(ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "Подключение_ПослеИнициализации";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ДополнительныеПараметры",
		ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ПараметрЗапуска = "ВыполнитьРегламентныеЗадания" Тогда
		ПрекратитьРаботуСистемы(); // в отличие от ЗавершитьРаботуСистемы, данный метод сразу завершает работу, а не ждет пока обработчик "ПриОткрытии" выполнится до конца
	КонецЕсли;
	
	ДоступноВыполнениеВФоне = _ЛокКонтекст.ДоступноВыполнениеВФоне;
	
	// Обновление метаданных документов 1С
	Если ДоступноВыполнениеВФоне Тогда
		_ЛокКонтекст.ЛокЯдро_ОбновлениеМетаданныхДокументов1С(, Новый Структура("ВыводитьОкноОжидания", Ложь));
	КонецЕсли;
	
	// Завершение
	Оповестить("УстановленыНастройкиПодключения",, ЭтаФорма);
	СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
		"БезОшибок",
		"",
		"ПодключениеКБазеSMARTS");
	Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	
	Если _ЛокКонтекст.СтруктураМетаданных.isDemo Тогда
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция",
			"ДемоРежим",
			"",
			"ПодключениеКБазеSMARTS");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
	КонецЕсли;
	
	// Завершение запуска по имени файла
	ЗапускПоИмениФайла = Ложь;
	
	// Данный код должен выполняться в последнюю очередь
	Если ВыполнениеВнешнейКоманды = Истина Тогда
		
		ИдентификаторКоманды = ИдентификаторВнешнейКоманды;
		ОбъектыНазначения = ОбъектыНазначенияВнешнейКоманды;
		
		ОП = Новый ОписаниеОповещения("ВыполнитьКомандуПослеПроверкиПодключения", ЭтаФорма,
			Новый Структура("ИдентификаторКоманды, ОбъектыНазначения", ИдентификаторКоманды, ОбъектыНазначения));
			
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,, ?(ЕстьЧастнаяБаза, "Частная", "Основная"),,,, ОП);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрЗапуска) И НЕ Автотесты_ВыполнятьЗамерыПроизводительности() Тогда
		Если Найти(ПараметрЗапуска, "КлеверенсАвтотесты.") Тогда
			ВыполнитьАвтотестКлеверенс(ПараметрЗапуска);
		ИначеЕсли Найти(ПараметрЗапуска, "КлеверенсРегламентнаяВыгрузка.") Тогда
			ВыполнитьРегламентнуюВыгрузкуКлеверенс(ПараметрЗапуска);
		ИначеЕсли ВыполнениеВнешнейКоманды <> Истина И ДоступноВыполнениеВФоне И ТекущаяБазаСуществует = Истина Тогда
			_ЛокКонтекст.ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФоне();
		КонецЕсли;
	ИначеЕсли ВыполнениеВнешнейКоманды <> Истина И ДоступноВыполнениеВФоне И ТекущаяБазаСуществует = Истина Тогда
		_ЛокКонтекст.ЛокЯдро_СерверКачества_НачатьПроверкуОшибокВФоне();
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_Логирование_ПереслатьОтправляемыеСообщенияВElasticsearchВФоне();
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура Подключение_ЗаполнитьПараметрыПодключаемойБазы(ПараметрыБазыMS = Неопределено, ДополнительныеПараметры = Неопределено)
	
	ТекущаяБазаСуществует 		= Ложь;
	ID_ТекущейБазы 				= "";
	ИмяТекущейБазы 				= "";
	СтрокаПодключенияСМАРТС 	= "";
	QRКодПодключения 			= "";
	ИмяПриложения 				= "";
	ВерсияПриложения 			= "";
	ID_ТекущегоУзла				= "";
	
	Если ПараметрыБазыMS <> Неопределено Тогда
		
		ТекущаяБазаСуществует 		= Истина;
		ID_ТекущейБазы 				= ПараметрыБазыMS.IdBaseSMARTS;
		ИмяТекущейБазы 				= ПараметрыБазыMS.Имя + ?(ПараметрыБазыMS.Свойство("ВерсияПриложения") И ЗначениеЗаполнено(ПараметрыБазыMS.ВерсияПриложения), ", версия: " + ПараметрыБазыMS.ВерсияПриложения, "");
		СтрокаПодключенияСМАРТС 	= ПараметрыБазыMS.СтрокаПодключенияСМАРТС;
		QRКодПодключения 			= ПараметрыБазыMS.QR;
		ИмяПриложения 				= ?(ПараметрыБазыMS.Свойство("ИмяПриложения") <> Неопределено, ПараметрыБазыMS.ИмяПриложения, "");
		ВерсияПриложения 			= ?(ПараметрыБазыMS.Свойство("ВерсияПриложения") И ЗначениеЗаполнено(ПараметрыБазыMS.ВерсияПриложения), ПараметрыБазыMS.ВерсияПриложения, "");
		
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область НастройкаПодключения

&НаКлиенте
Процедура НастройкаПодключения_НастроитьПодключение(СтрокаПодключенияСМАРТС, ДополнительныеПараметры = Неопределено)
	
	ИмяСобытия = "НастройкаПодключения_НастроитьПодключение";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"СтрокаПодключенияСМАРТС,ДополнительныеПараметры",
		СтрокаПодключенияСМАРТС, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Автотесты_НачатьЗамерПроизводительности(ИмяСобытия);
	
	пСообщение = НСтр("ru = 'Параметр запуска: %1';
						|en = 'Launch parameter: %1'; be = 'Параметр запуску: %1'; es = 'Parámetro de Inicio: %1'; ka = 'გაშვების პარამეტრი: %1'; kk = 'Іске қосу параметрі: %1'; ro = 'Parametrul de lansare: %1'; tr = 'Başlangıç parametresi: %1'; uk = 'Параметр запуску: %1'; uz = 'Ishga tushirish opsiyasi: %1'");
	пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, СокрЛП(СтрокаПодключенияСМАРТС));
	_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ПервыйЗапуск", "Предупреждение", пСообщение);
	
	МассивСтрокПодключений = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(СтрокаПодключенияСМАРТС, "|");
	МассивСтруктурПодключения = Новый Массив;
	Для каждого СтрокаПодключения Из МассивСтрокПодключений Цикл
		
		Если Найти(ВРег(СтрокаПодключения), "HTTP") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураURI = _ЛокКонтекст.REST_API_ПолучитьСтруктуруURIИзСтроки(СтрокаПодключения);
		
		ПутьНаСервере = СтруктураURI.ПутьНаСервере;
		Поз = Найти(ПутьНаСервере, "?");
		ПутьНаСервере = ?(Поз > 0, Лев(ПутьНаСервере, Поз - 1), ПутьНаСервере);
		
		// Цикл по хостам
		МассивХостов = СтруктураURI.МассивХостов;
		Для каждого Хост Из МассивХостов Цикл
			
			URIБазы = СтруктураURI.Схема + "://" + Хост + ?(ЗначениеЗаполнено(СтруктураURI.Порт), ":" + Формат(СтруктураURI.Порт, "ЧГ="), "") + ?(ЗначениеЗаполнено(ПутьНаСервере), "/" + ПутьНаСервере, "") + ?(ЗначениеЗаполнено(СтруктураURI.TempUid), "?tempuid=" + СтруктураURI.TempUid, "");
			
			СтруктураПодключения = Новый Структура;
			СтруктураПодключения.Вставить("СтрокаПодключения",				URIБазы);
			СтруктураПодключения.Вставить("СтрокаПодключенияСМАРТС",		URIБазы);
			СтруктураПодключения.Вставить("TempUid",						СтруктураURI.TempUid);
			СтруктураПодключения.Вставить("IdBaseSMARTS",					Неопределено);
			
			СтруктураПодключения.Вставить("ТипБазы",						"Основная");
			СтруктураПодключения.Вставить("ТипИнтерфейса",					"REST_API");
			СтруктураПодключения.Вставить("РасположениеКомпоненты",			"НаСервере");
			СтруктураПодключения.Вставить("РежимВыбораБазы",				"СтрокаПодключения");
			СтруктураПодключения.Вставить("НеПроверятьТокеныВХранилище1С", 	Истина);
			
			СтруктураПодключения.Вставить("АвторизацияВключена", 			Ложь);
			СтруктураПодключения.Вставить("АвторизацияТокен",		 		"");
			СтруктураПодключения.Вставить("АвторизацияРефрешТокен",	 		"");
			СтруктураПодключения.Вставить("АвторизацияТип",			 		Неопределено);
			
			МассивСтруктурПодключения.Добавить(СтруктураПодключения);
			
		КонецЦикла;
		
	КонецЦикла;
	
	// <Лог>
	пШаблон = "Разбор строки подключения. Найдено хостов: %1";
	пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пШаблон, МассивСтруктурПодключения.Количество());
	_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, пШаблон);
	// </Лог>
	
	Если МассивСтруктурПодключения.Количество() > 0 Тогда
		
		ПараметрыВыполнения = _ЛокКонтекст.ЛокЯдро_НастройкаПодключения_СтруктураПараметровВызова();
		ПараметрыВыполнения.СтрокаПодключенияСМАРТС 		= СтрокаПодключенияСМАРТС;
		ПараметрыВыполнения.ТипБазы 						= "Основная";
		ПараметрыВыполнения.РасположениеКомпоненты 			= "НаСервере";
		ПараметрыВыполнения.РежимВыполнения 				= "НастройкаПодключения";
		ПараметрыВыполнения.СпособЗапуска 					= "ПоПараметруЗапуска";
		ПараметрыВыполнения.МассивСтруктурПодключения		= МассивСтруктурПодключения;
		
		ОП = Новый ОписаниеОповещения("НастройкаПодключения_НастроитьПодключениеЗавершение", ЭтаФорма);
		ПараметрыВыполнения.ОповещениеОбработкиЗавершения = ОП;
		
		_ЛокКонтекст.ЛокЯдро_НастройкаПодключения_НастроитьПодключение(ПараметрыВыполнения);
		
	КонецЕсли;
	
	Автотесты_ЗавершитьЗамерПроизводительности(ИмяСобытия);
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры 

&НаКлиенте
Процедура НастройкаПодключения_НастроитьПодключениеЗавершение(ПараметрыВыполнения = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = "НастройкаПодключения_НастроитьПодключениеЗавершение";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"ПараметрыВыполнения,ДополнительныеПараметры",
		ПараметрыВыполнения, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	ПараметрыБазыMS = Неопределено;
	Если ПараметрыВыполнения <> Неопределено Тогда
		ПараметрыВыполнения.Свойство("ПараметрыБазыMS", ПараметрыБазыMS);
		РасположениеКомпоненты = ПараметрыВыполнения.СтруктураПодключения.РасположениеКомпоненты;
				
		Если ПараметрыВыполнения.ПодключениеДоступно Тогда
			
			// <Лог>
			пСообщение = "Подключение по параметру запуска успешно.";
			_ЛокКонтекст.ЛогИнфо(логСобытие, пСообщение, пСообщение);
			// </Лог>
			
			ПрекратитьРаботуСистемы(); // Запуск по параметру запуска
			
		Иначе
			
			// <Лог>
			пСообщение = "Не удалось подключиться по параметру запуска.";
			_ЛокКонтекст.ЛогПредупреждение(логСобытие, пСообщение, пСообщение);
			// </Лог>
			
			Если ПараметрыБазыMS = Неопределено Тогда
				// Ошибка. Ошибка подключения к базе
				СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"БазаНедоступнаПоПараметруЗапуска", 
					ПараметрыВыполнения.СтруктураПодключения, 
					"ПодключениеКБазеSMARTS");
				Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			Иначе
				// Ошибка. Описание базы получили, но подключиться не получилось
				СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
					"РаботаССерверомБазаНедоступна", 
					ПараметрыБазыMS, 
					"ПодключениеКБазеSMARTS");
				Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Проверка допустимого символа base64url
&НаКлиенте
Функция ЗапускПоИмениФайла_ЭтоBase64UrlСимвол(ЗначениеСимвола) Экспорт
	
	Код = КодСимвола(ЗначениеСимвола);
	
	// 'A'-'Z' (65-90), 'a'-'z' (97-122), '0'-'9' (48-57), '-' (45), '_' (95)
    Если (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122) ИЛИ (Код >= 48 И Код <= 57) ИЛИ Код = 45 ИЛИ Код = 95 Тогда
        Возврат Истина;
    КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Извлечь base64url-строку из имени (останавливаемся на первом недопустимом символе)
&НаКлиенте
Функция ЗапускПоИмениФайла_ИзвлечьBase64UrlИзСтрокиПодключения(СтрокаПодключения) Экспорт
	
	// 1) обрезать расширение
    Точка = _ЛокКонтекст.ЛокЯдро_СтрНайти(СтрокаПодключения, ".", "СКонца");
    Если Точка > 0 Тогда
        СтрокаПодключения = Лев(СтрокаПодключения, Точка - 1);
    КонецЕсли;

    // 2) считываем только допустимые base64url символы
    Результат = "";
    Для Позиция = 1 По СтрДлина(СтрокаПодключения) Цикл
        ЗначениеСимвола = Сред(СтрокаПодключения, Позиция, 1);
        Если ЗапускПоИмениФайла_ЭтоBase64UrlСимвол(ЗначениеСимвола) Тогда
            Результат = Результат + ЗначениеСимвола;
        Иначе
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЗапускПоИмениФайла_СтрокаПодключения(Знач СтрокаBase64Url)
	
	СтрокаПараметры = _ЛокКонтекст.ЛокЯдро_РасшифроватьZLIB(
		_ЛокКонтекст.ЛокЯдро_ДвоичныеДанныеИзBase64Url(СтрокаBase64Url));
	
	Возврат СтрокаПараметры;
	
КонецФункции

&НаКлиенте
Функция ЗапускПоИмениФайла_ПараметрЗапуска(ИмяФайла)

	СтрокаЗапуска = "";
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат СтрокаЗапуска;
	КонецЕсли;
	
	ПроверяемыеСтроки = Новый Массив;
	ПроверяемыеСтроки.Добавить("КлеверенсТСД_ОсновнаяОбработка_");
	ПроверяемыеСтроки.Добавить("CleverencePDT_MainDataProcessor_");
	
	Для каждого ПроверяемаяСтрока ИЗ ПроверяемыеСтроки Цикл
		Позиция = Найти(ИмяФайла, ПроверяемаяСтрока);
		Если Позиция Тогда
			СтрокаBase64 = Сред(ИмяФайла, Позиция + СтрДлина(ПроверяемаяСтрока));
			
			Попытка
				СтрокаПараметры = _ЛокКонтекст.ЛокЯдро_СтрокаИзBase64(
					СтрЗаменить(СтрокаBase64, ".epf", ""));
			Исключение
				СтрокаПараметры = Неопределено;
			КонецПопытки;
			
			Если СтрокаПараметры = Неопределено Тогда
				Попытка
					СтрокаПараметры = ЗапускПоИмениФайла_СтрокаПодключения(
						ЗапускПоИмениФайла_ИзвлечьBase64UrlИзСтрокиПодключения(СтрокаBase64));
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЕсли;
			
			СтрокаЗапуска = ЗапускПоИмениФайла_ПарсингСтрокиLoclClgt(СтрокаПараметры);
			Если НЕ ПустаяСтрока(СтрокаЗапуска) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокаЗапуска;	
	
КонецФункции

&НаКлиенте
Функция ЗапускПоИмениФайла_ПарсингСтрокиLoclClgt(ИсходнаяСтрока)

	Если ТипЗнч(ИсходнаяСтрока) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ЧастьLocl = "";
	ЧастьClgt = ИсходнаяСтрока;
	
	ПозицияLocl	= Найти(ИсходнаяСтрока, "locl_");
	Если ПозицияLocl Тогда
		ПозицияРазделитель = Найти(ИсходнаяСтрока, "|");
		Если ПозицияРазделитель Тогда
			ЧастьLocl = Лев(ИсходнаяСтрока, ПозицияРазделитель - 1);
			ЧастьClgt = Сред(ИсходнаяСтрока, ПозицияРазделитель + 1);
		Иначе
			ЧастьLocl = ИсходнаяСтрока;
			ЧастьClgt = "";
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ЧастьLocl)
		И ПустаяСтрока(ЧастьClgt) Тогда
		Возврат "";
	КонецЕсли;	
	
	ИдБазыSMARTS1 = "";
	ИдБазыSMARTS2 = "";
	
	// locl_Хост1,Хост2,...:Порт/ИдБазыSMARTS1
	МассивХостов = Новый Массив;
	
	Если НЕ ПустаяСтрока(ЧастьLocl) Тогда
		ДанныеLocl = Сред(ЧастьLocl, 6);

		ПозицияСлэш = Найти(ДанныеLocl, "/");
		Если ПозицияСлэш Тогда
			ХостыИПорт = Лев(ДанныеLocl, ПозицияСлэш - 1);
			ИдБазыSMARTS1 = Сред(ДанныеLocl, ПозицияСлэш + 1);
			
			ПозицияДвоеточие = Найти(ХостыИПорт, ":");
			Если ПозицияДвоеточие Тогда
				Хосты = Лев(ХостыИПорт, ПозицияДвоеточие - 1);
				Порт = Сред(ХостыИПорт, ПозицияДвоеточие + 1);
				
				МассивХостов = _ЛокКонтекст.ЛокЯдро_СтрРазделить(Хосты, ",");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// cloud_ИдБазыSMARTS2_TempUid
	// clgt_ИдБазыSMARTS2_TempUid
	СтрокаTempuid = "";
	
	Если НЕ ПустаяСтрока(ЧастьClgt) Тогда
		ДанныеClgt = "";
		
		ПозицияCloud = Найти(ЧастьClgt, "cloud_");
		Если ПозицияCloud Тогда
			ДанныеClgt = Сред(ЧастьClgt, 7);
		Иначе
			ПозицияClgt = Найти(ЧастьClgt, "clgt_");
			Если ПозицияClgt Тогда
				ДанныеClgt = Сред(ЧастьClgt, 6);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ДанныеClgt) Тогда
			Позиция_ = Найти(ДанныеClgt, "_");
			Если Позиция_ Тогда
				ИдБазыSMARTS2 = Лев(ДанныеClgt, Позиция_ - 1);
				СтрокаTempuid = Сред(ДанныеClgt, Позиция_ + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ИдБазыSMARTS1)
		И ПустаяСтрока(ИдБазыSMARTS2) Тогда
		Возврат "";
	КонецЕсли;
	
	Результаты = Новый Массив;

	// Первый элемент — основной идентификатор базы SMARTS
	Результаты.Добавить(?(ПустаяСтрока(ИдБазыSMARTS1),
		ИдБазыSMARTS2, ИдБазыSMARTS1));

	// URL-ы для каждого хоста (http/https)
	Для Каждого Хост Из МассивХостов Цикл
		Результаты.Добавить("http://" + Хост + ":" + Порт + "/" + ИдБазыSMARTS1);
		Результаты.Добавить("https://" + Хост + ":" + Порт + "/" + ИдБазыSMARTS1);
	КонецЦикла;

	// Финальный clgt URL
	Если НЕ ПустаяСтрока(ИдБазыSMARTS2) Тогда
		Результаты.Добавить(_ЛокКонтекст.ЛокЯдро_СтрШаблон("https://%1.cleverence.ru/%2?tempuid=%3",
			?(ПозицияCloud, "cloud", "clgt"), ИдБазыSMARTS2, СтрокаTempuid));
	КонецЕсли;

	// Склеиваем '|' без конечного разделителя
	СтрокаЗапуска = "";
	Для i = 0 По Результаты.ВГраница() Цикл
		СтрокаЗапуска = СтрокаЗапуска + ?(ПустаяСтрока(СтрокаЗапуска), "", "|") + Результаты[i];
	КонецЦикла;  
	
	Возврат СтрокаЗапуска;

КонецФункции

&НаКлиенте
Процедура ЗапускПоИмениФайла_ПроверкаПодключения(пПараметрЗапуска)
	
	ИмяСобытия = "ЗапускПоИмениФайла_ПроверкаПодключения";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"пПараметрЗапуска",
		пПараметрЗапуска);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	НачалоСобытия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ДополнительныеПараметры = Новый Структура("НеКэшировать", Истина);
	
	СохраненныеПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS(, ДополнительныеПараметры);
	
	СтрокиПодключенияСовпадают = Ложь;
	
	Если НЕ СохраненныеПараметрыПодключенияMS = Неопределено
		И ТипЗнч(СохраненныеПараметрыПодключенияMS) = Тип("Структура") Тогда
		
		Позиция = Найти(пПараметрЗапуска, "|");
		Если Позиция И НЕ Лев(пПараметрЗапуска, Позиция - 1) = "" Тогда
			МассивПараметров = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(пПараметрЗапуска, "|");
			
			Для каждого пПараметр ИЗ МассивПараметров Цикл
				ПроверяемаяСтрока = пПараметр;
				
				ПозицияTempuid = Найти(ПроверяемаяСтрока, "?tempuid");
				Если ПозицияTempuid Тогда
					ПроверяемаяСтрока = Сред(ПроверяемаяСтрока, 1, ПозицияTempuid - 1);
				КонецЕсли;
				
				Если _ЛокКонтекст.ЛокЯдро_СтрокиПодключенияСовпадают(СохраненныеПараметрыПодключенияMS.СтрокаПодключения, ПроверяемаяСтрока) Тогда
			    	СтрокиПодключенияСовпадают = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокиПодключенияСовпадают Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрЗапуска", 		пПараметрЗапуска);
		ДополнительныеПараметры.Вставить("ПараметрыПодключенияMS", 	СохраненныеПараметрыПодключенияMS);
		ДополнительныеПараметры.Вставить("РасположениеКомпоненты", 	РасположениеКомпоненты);
		
		ОП = Новый ОписаниеОповещения("ЗапускПоИмениФайла_ПослеПроверкиПодключения", ЭтаФорма, ДополнительныеПараметры);
			
		пСообщение = НСтр("ru = 'Начало';
							|en = 'Beginning'; be = 'Пачатак'; es = 'Comienzo'; ka = 'დასაწყისი'; kk = 'Басталуы'; ro = 'Început'; tr = 'Başlangıç'; uk = 'Почавши'; uz = 'Boshlanish'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", пСообщение, НачалоСобытия);
		_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(СохраненныеПараметрыПодключенияMS, Ложь,, РасположениеКомпоненты,,, ОП);
		пСообщение = НСтр("ru = 'Конец';
							|en = 'The end'; be = 'Канец'; es = 'Final'; ka = 'დასასრული'; kk = 'Соңы'; ro = 'Sfârșitul'; tr = 'Son'; uk = 'Кінець'; uz = 'Oxiri'");
		_ЛокКонтекст.ЛокЯдро_ЗаписатьСобытиеВЖурналРегистрации("ЛокЯдро_ПроверитьСоединениеССерверомSMARTS", "Информация", пСообщение, НачалоСобытия);
	Иначе
		НастройкаПодключения_НастроитьПодключение(пПараметрЗапуска);
	КонецЕсли;
			
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапускПоИмениФайла_ПослеПроверкиПодключения(СерверДоступен, ДополнительныеПараметры) Экспорт
	
	ИмяСобытия = "ЗапускПоИмениФайла_ПослеПроверкиПодключения";
	
	// <Лог>
	логКонтекст = _ЛокКонтекст.ЛогОписатьКонтекст(ИмяСобытия,,
		"СерверДоступен,ДополнительныеПараметры",
		СерверДоступен, ДополнительныеПараметры);
		
	логСобытие = _ЛокКонтекст.ЛогНачатьСобытие(ИмяСобытия, логКонтекст, ЭтаФорма);
	// </Лог>
	
	Если СерверДоступен = Истина Тогда
		
		СтруктураСменыСтатуса = Новый Структура("Статус, Параметр, Операция", 
			"НачалоВыполненияПроцедурыЗапускаОбработки", 
			, 
			"ЗапускОсновнойОбработки");
		Оповестить("СменаСтатуса", СтруктураСменыСтатуса);
		
		Подключение_ЗаполнитьПараметрыПодключаемойБазы();
		УстановитьСписокВыбораПодключенныхБаз();
		
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS", ДополнительныеПараметры.ПараметрыПодключенияMS);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("РасположениеКомпоненты", РасположениеКомпоненты);
		_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ТипИнтерфейса", ТипИнтерфейса);
		
		Подключение_ПослеПроверкиСоединения(Истина, ДополнительныеПараметры);
		
	Иначе
		НастройкаПодключения_НастроитьПодключение(ДополнительныеПараметры.ПараметрЗапуска);
	КонецЕсли;
	
	// <Лог>
	_ЛокКонтекст.ЛогЗавершитьСобытие(логСобытие);
	// </Лог>
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	
	// Обработчик клиентской назначаемой команды.
	//
	// Параметры:
	//   ИдентификаторКоманды - Строка - Имя команды, как оно задано в функции СведенияОВнешнейОбработке модуля объекта.
	//   ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда.
	&НаКлиенте
	Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения = Неопределено) Экспорт
		
		Автотесты_НачатьЗамерПроизводительности("ВыполнитьКоманду");
		
		ВыполнениеВнешнейКоманды 		= Истина;
		ИдентификаторВнешнейКоманды 	= ИдентификаторКоманды;
		ОбъектыНазначенияВнешнейКоманды = ОбъектыНазначения;
		
		Если _ЛокКонтекст = Неопределено Тогда
			// В данном случае код, выполняющий команду, будет выполняться в методе "ДействияПриОткрытииФормыЗавершение"
			// Это необходимо для работы механизма при фоновой инициализации, т.к. в фоне инициализации происходит в другом сеансе,
			// и поэтому необходимо вызывать код после ее выполнения
			ПриОткрытии(Ложь);
		Иначе
			ОП = Новый ОписаниеОповещения("ВыполнитьКомандуПослеПроверкиПодключения",ЭтаФорма,Новый Структура("ИдентификаторКоманды,ОбъектыНазначения",ИдентификаторКоманды,ОбъектыНазначения));
			_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,?(ЕстьЧастнаяБаза,"Частная","Основная"),,,,ОП);
		КонецЕсли;
		
		Автотесты_ЗавершитьЗамерПроизводительности("ВыполнитьКоманду", "ВыполнитьКоманду"); 
		
	КонецПроцедуры
	
	// Обработчик клиентской назначаемой команды.
	//
	// Параметры:
	//   ИдентификаторКоманды - Строка - Имя команды, как оно задано в функции СведенияОВнешнейОбработке модуля объекта.
	//   ОбъектыНазначения - Массив - Ссылки, для которых выполняется команда.
	&НаКлиенте
	Процедура ExecuteCommand(ИдентификаторКоманды, ОбъектыНазначения = Неопределено) Экспорт
		ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения);
	КонецПроцедуры
	
#Иначе
	
	Процедура ВыполнитьКоманду_ОФ(ИдентификаторКоманды, ОбъектыНазначения = Неопределено) Экспорт
		
		Автотесты_НачатьЗамерПроизводительности("ВыполнитьКоманду");
		
		ВыполнениеВнешнейКоманды 		= Истина;
		ИдентификаторВнешнейКоманды 	= ИдентификаторКоманды;
		ОбъектыНазначенияВнешнейКоманды = ОбъектыНазначения;
		
		Если _ЛокКонтекст = Неопределено Тогда
			// В данном случае код, выполняющий команду, будет выполняться в методе "ДействияПриОткрытииФормыЗавершение"
			// Это необходимо для работы механизма при фоновой инициализации, т.к. в фоне инициализации происходит в другом сеансе,
			// и поэтому необходимо вызывать код после ее выполнения
			ПриОткрытии(Ложь);
		Иначе
			ОП = Новый ОписаниеОповещения("ВыполнитьКомандуПослеПроверкиПодключения",ЭтаФорма,Новый Структура("ИдентификаторКоманды,ОбъектыНазначения",ИдентификаторКоманды,ОбъектыНазначения));
			_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,?(ЕстьЧастнаяБаза,"Частная","Основная"),,,,ОП);
		КонецЕсли;
		
		Автотесты_ЗавершитьЗамерПроизводительности("ВыполнитьКоманду", "ВыполнитьКоманду");
		
	КонецПроцедуры	
	
#КонецЕсли

// Вызывает процедуру по идентификатору команды
//
// Параметры:
//	СерверДоступен - Булево - флаг доступности сервера Клеверенс	
//	ДопПараметры - Структура - содержит:	
//		* ИдентификаторКоманды - Строка - Имя команды, как оно задано в функции СведенияОВнешнейОбработке модуля объекта.
//   	* ОбъектыНазначения - Массив из ЛюбаяСсылка - Ссылки, для которых выполняется команда.	
&НаКлиенте
Процедура ВыполнитьКомандуПослеПроверкиПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если НЕ СерверДоступен = Истина Тогда
		// Еще на этапе инициализации и проверке подключения будет показан вопрос, поэтому его перебивать не надо
		ВыполнениеВнешнейКоманды = Ложь;
		Возврат;
	КонецЕсли;
	
	// Перед выполнением команды необходимо выполнить процедуру ДействияПередОткрытиемФормыПослеПодключения из оповещения
	// в методе ПриОткрытии, т.к. она не отработала ранее из-за открытия формы авторизации SMARTS
	Если _ЛокКонтекст.ДанныеТекущегоУзла = Неопределено Тогда
		
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
		Если ПараметрыПодключенияMS <> Неопределено Тогда
			Подключение_ЗаполнитьПараметрыПодключаемойБазы();
			ДополнительныеПараметры = Новый Структура("ПараметрыПодключенияMS", ПараметрыПодключенияMS);
			Подключение_ПослеПроверкиСоединения(СерверДоступен, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
	ИдентификаторКоманды	= ДопПараметры.ИдентификаторКоманды;
	ОбъектыНазначения 		= ДопПараметры.ОбъектыНазначения;
	
	Если ИдентификаторКоманды = "Выгрузить все справочники в Клеверенс" Тогда		
		ВыгрузитьСправочникиНажатие("");
		
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ВыгрузитьСправочники" Тогда
		// ВыгрузитьСправочникиНажатие("");
		
		// Проверка подключения уже выполнена до вызова этого метода
		ВыгрузитьСправочники(Истина, Новый Структура("ВстраиваемаяКоманда", Истина));
		
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ВыгрузитьДокумент" Тогда
		
		#Если Не ВебКлиент Тогда
			Если ТипЗнч(ОбъектыНазначения) = Тип("ВыделенныеСтрокиТабличногоПоля") Тогда
				МассивСсылок = Новый Массив;
				Для Каждого Ссылка из ОбъектыНазначения Цикл
					МассивСсылок.Добавить(Ссылка);
				КонецЦикла;
				ОбъектыНазначения = МассивСсылок;	
			КонецЕсли;
		#КонецЕсли
		
		Если Не ТипЗнч(ОбъектыНазначения) = Тип("Массив") Тогда
			Если Не ЗначениеЗаполнено(ОбъектыНазначения) Тогда
				Сообщение = НСтр("ru = 'Документ должен быть записан перед выгрузкой в ТСД!';
									|en = 'The document must be recorded before uploading to a Mobile device!';
									|be = 'Дакумент павінен быць запісаны перад выгрузкай ў мабільную прыладу!'; es = '¡El documento debe escribirse antes de descargarlo en el dispositivo Móvil!'; ka = 'დოკუმენტი უნდა ჩაიწეროს მობილურ მოწყობილობაზე ატვირთვამდე!'; kk = 'Құжат мобильді құрылғыға жүктелмес бұрын жазылуы керек!'; ro = 'Documentul trebuie înregistrat înainte de încărcare pe un dispozitiv mobil!'; tr = 'Mobil cihaza indirilmeden önce belge kaydedilmelidir!'; uk = 'Документ повинен бути записаний перед вивантаженням в мобільний пристрій!'; uz = 'Hujjat mobil qurilmaga yuklamasdan oldin yozilishi kerak!'");
				Сообщить(Сообщение); 
				Возврат;
			КонецЕсли;			
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ОбъектыНазначения);
			ОбъектыНазначения = МассивОбъектов;
		КонецЕсли;
		
		ВыгрузкаДокументов_ВыгрузитьПоМассивуДокументов(ОбъектыНазначения);		
		
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ВыгрузитьДокументыВОдин" Тогда
		
		ВыгрузкаДокументов_ВыгрузитьПоМассивуДокументов(ОбъектыНазначения, Истина);		
	
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ЗагрузитьВТекущийДокумент" Тогда
		
		ЗагрузкаДокументов_ЗагрузитьВОткрытыйДокумент(ОбъектыНазначения);
		
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ЗагрузитьДокументы" Тогда
		
		ЗагрузкаДокументов_ЗагрузитьИзСпискаДокументов(ОбъектыНазначения);
		
	ИначеЕсли ИдентификаторКоманды = "КлеверенсТСД_ОткрытьОбработкуОбмена" Тогда

		Если ЭтаФорма.Открыта() Тогда
			ЭтаФорма.Активизировать();
		Иначе
			ЭтаФорма.Открыть();
		КонецЕсли;

	КонецЕсли;

	ВыполнениеВнешнейКоманды = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегламентнуюВыгрузкуКлеверенс(ПараметрЗапуска)	
		
	НачалоВыполненияОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Найти(ПараметрЗапуска,".Справочники") Тогда 
