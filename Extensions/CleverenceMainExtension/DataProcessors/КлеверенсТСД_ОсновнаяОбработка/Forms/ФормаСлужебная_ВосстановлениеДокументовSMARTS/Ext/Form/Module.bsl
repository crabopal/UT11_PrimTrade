/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;		
#КонецЕсли

#Область ОбработчикиФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Устанавливаем период по умолчанию в 1 день (со вчерашнего по сегодняшний)
	НачалоПериода 	= НачалоДня(НачалоДня(ТекущаяДата()) - 1);
	КонецПериода	= НачалоПериода + 86400;

	// Загружаем доступные типы документов Клеверенс
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.ДокументыMS Цикл
		Элементы.Тип.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);
	КонецЦикла;
	Элементы.Тип.СписокВыбора.СортироватьПоПредставлению();
	
	// Загружаем доступные типы документов 1С
	Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.Документы1С Цикл
		Элементы.ИмяДокумента.СписокВыбора.Добавить(ДанныеДокумента.Ключ, ДанныеДокумента.Значение.Синоним);		
	КонецЦикла;
	Элементы.ИмяДокумента.СписокВыбора.СортироватьПоПредставлению();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсе(Команда)
	
	УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(Истина);

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура УстановкаСнятиеФлагаЗагрузкиВсехДокументовMS(ЗначениеФлага)
	
	Для Каждого СтрокаДокумента Из ДокументыMS Цикл		
		Если СтрокаДокумента.Загружать = ЗначениеФлага Тогда
			Продолжить;	
		КонецЕсли;
		СтрокаДокумента.Загружать = ЗначениеФлага;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДокументы(Команда)

	Если (НачалоПериода > КонецПериода) Тогда
		Сообщение = НСтр("ru = 'Введен некорректный период отбора!';
							|en = 'An incorrect selection period has been introduced!'; be = 'Уведзены некарэктны перыяд адбору!'; es = '¡Se ha introducido un período de selección incorrecto!'; ka = 'შემოღებულია შერჩევის არასწორი პერიოდი!'; kk = 'Іріктеудің дұрыс емес кезеңі енгізілді!'; ro = 'A fost introdusă o perioadă de selecție incorectă!'; tr = 'Yanlış bir seçim dönemi getirildi!'; uk = 'Введено некоректний період відбору!'; uz = 'Noto''g''ri tanlov davri joriy etildi!'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;
	
	ДокументыMS.Очистить();
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("PeriodFrom", НачалоДня(НачалоПериода));
	ПараметрыЗапроса.Вставить("PeriodTo", 	?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), КонецПериода));	
	
	ФильтрыЗапроса = Новый Структура;
	Если Не ПустаяСтрока(ИмяДокумента) Тогда
		ФильтрыЗапроса.Вставить("name", 	СокрЛП(ИмяДокумента));	
	КонецЕсли;
	Если Не ПустаяСтрока(УИД) Тогда
		ФильтрыЗапроса.Вставить("id", 		СокрЛП(УИД));	
	КонецЕсли;
	Если Не ПустаяСтрока(ИДУстройства) Тогда
		ФильтрыЗапроса.Вставить("deviceId", СокрЛП(ИДУстройства));	
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		ФильтрыЗапроса.Вставить("fileName", СокрЛП(ИмяФайла));	
	КонецЕсли;
	Если Не ПустаяСтрока(Тип) Тогда
		ФильтрыЗапроса.Вставить("documentTypeName", 	СокрЛП(Тип));	
	КонецЕсли;
	
	СписокДокументов = _ЛокКонтекст.ЛокЯдро_ПолучениеАрхивныхДокументовSMARTS(ПараметрыЗапроса, ФильтрыЗапроса, ТипБазы);
	
	Если СписокДокументов <> Неопределено 
		И ТипЗнч(СписокДокументов) = Тип("Массив")
		И СписокДокументов.Количество() > 0 Тогда
		
		Для Каждого СтруктураДокумента Из СписокДокументов Цикл
			
			НоваяСтрока = ДокументыMS.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураДокумента);
			
			Для Каждого ДанныеДокумента Из _ЛокКонтекст.СтруктураМетаданных.Документы1С Цикл
				Если _ЛокКонтекст.ЛокЯдро_СтрНайти(НоваяСтрока.Синоним, ДанныеДокумента.Значение.Синоним) > 0 Тогда					
					НоваяСтрока.Тип1С = ДанныеДокумента.Значение.Синоним;                                              
					Прервать;					
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьДокументы(Команда)
	
	МассивДокументовКВыгрузке 	= Новый Массив;
	МассивСтрокТаблицы			= Новый Массив;
	
	Для Каждого СтрокаДокументовMS Из ДокументыMS Цикл
		
		Если Не СтрокаДокументовMS.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураДокумента = Новый Структура("УИД,ИмяФайла,ИДУстройства,Тип"); 
		ЗаполнитьЗначенияСвойств(СтруктураДокумента, СтрокаДокументовMS);
		МассивДокументовКВыгрузке.Добавить(СтруктураДокумента);
		МассивСтрокТаблицы.Добавить(СтрокаДокументовMS);
		
	КонецЦикла;
	
	Если Не МассивДокументовКВыгрузке.Количество() Тогда             		
		Сообщение = НСтр("ru = 'Отсутствуют выбранные документы к восстановлению';
							|en = 'The selected recovery documents are missing'; be = 'Адсутнічаюць выбраныя дакументы да аднаўлення'; es = 'Faltan documentos seleccionados para restaurar'; ka = 'შერჩეული აღდგენის დოკუმენტები აკლია'; kk = 'Қалпына келтіру үшін таңдалған құжаттар жоқ'; ro = 'Documentele de recuperare selectate lipsesc'; tr = 'Kurtarma için seçili belgeler eksik'; uk = 'Відсутні вибрані документи до відновлення'; uz = 'Qayta tiklash uchun tanlangan hujjatlar yo''q'");
		Сообщить(Сообщение); 
		Возврат;		
	КонецЕсли;
	
	Результат = _ЛокКонтекст.ЛокЯдро_ВосстановитьДокументыSMARTS(МассивДокументовКВыгрузке, ТипБазы);
	Если Результат Тогда
		Для Каждого ВосстановленнаяСтрока Из МассивСтрокТаблицы Цикл
			ДокументыMS.Удалить(ВосстановленнаяСтрока);
		КонецЦикла;		
		Закрыть(Истина);
	Иначе
		Сообщение = НСтр("ru = 'Не удалось отправить запрос на восстановление (см. журнал регистрации)';
							|en = 'Failed to send a recovery request (see the log)';
							|be = 'Не атрымалася адправіць запыт на аднаўленне (гл. часопіс рэгістрацыі)'; es = 'No se pudo enviar la solicitud de recuperación (consulte el registro)'; ka = 'ვერ მოხერხდა აღდგენის მოთხოვნის გაგზავნა (იხილეთ ჟურნალი)'; kk = 'Қалпына келтіру туралы сұраныс жіберілмеді (тіркеу журналын қараңыз)'; ro = 'Nu a reușit să trimită o cerere de recuperare (a se vedea jurnalul)'; tr = 'Kurtarma talebi gönderilemedi (kayıt defterine bakın)'; uk = 'Не вдалося надіслати запит на відновлення (див. журнал реєстрації)'; uz = 'Qayta tiklash so''rovini yuborib bo''lmadi (jurnalga qarang)'");
		Сообщить(Сообщение); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть(Ложь);
	
КонецПроцедуры

#КонецОбласти