/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ОткрытьФормуРедактированияУзла Экспорт;

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьТаблицуУзлов();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
	
	Если ОткрытьФормуРедактированияУзла = Истина Тогда
		ПодключитьОбработчикОжидания("ОткрытьФормуРедактированияУзлаПослеОжидания", 0.1, Истина);
	КонецЕсли;
	ОткрытьФормуРедактированияУзла = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	Если ОткрытьФормуРедактированияУзла = Истина Тогда
		ОткрытьФормуРедактированияУзла(Истина);
	КонецЕсли;
	ОткрытьФормуРедактированияУзла = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТаблицаУзловПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ОткрытьФормуРедактированияУзла(Истина);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУзловПередНачаломИзменения(Элемент, Отказ)
	ОткрытьФормуРедактированияУзла(Ложь);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьУзлы(Команда = Неопределено)	Экспорт	
	
	ОП = Новый ОписаниеОповещения("ВыгрузитьУзлыПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,,,,,ОП);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУзловПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока	 = Элемент.ТекущиеДанные;
	ID_УзлаУдаляемый = ТекущаяСтрока.ID_Узла;
	
	// Очищаем настройки
	СтруктураНастроек = Новый Структура;
	Для Каждого КлючНастройки Из _ЛокКонтекст.КатегорииНастроекMS.УзловыеНастройки Цикл
		СтруктураНастроек.Вставить(КлючНастройки, Неопределено);
	КонецЦикла;
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВБазеSMARTS(СтруктураНастроек, ID_УзлаУдаляемый);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкиSMARTS(СтруктураНастроек);
	
	// Удаляем строку
	ТаблицаУзлов.Удалить(ТекущаяСтрока);
	ТаблицаДляСохранения = ПолучитьСтруктуруУзловДляСохранения();
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("Узлы", ТаблицаДляСохранения);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", ТаблицаДляСохранения);	
	
	// Удаляем бизнес-процессы узла
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов");
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьБизнесПроцессыСобытиеФормы(НастройкиБизнесПроцессов);
	
	// Устанавливаем новое значение текущего узла / восстанавливаем настройки предыдущего
	ID_ТекущегоУзла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	Если ID_ТекущегоУзла = ID_УзлаУдаляемый Тогда
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла("");		
	Иначе
		_ЛокКонтекст.ЛокЯдро_УстановитьДанныеТекущегоУзла(ID_ТекущегоУзла);		
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаУзловСкопироватьУзел.Доступность = ТаблицаУзлов.Количество();
	#Иначе	
		Элементы.КомПанель.Кнопки.ТаблицаУзловСкопироватьУзел.Доступность = ТаблицаУзлов.Количество();
	#КонецЕсли
	
	ВыгрузитьУзлы();
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьУзел(Команда)
	
	Если Элементы.ТаблицаУзлов.ТекущиеДанные = Неопределено Тогда
		пСообщение = НСтр("ru = 'Не выбран торговый объект для копирования.';
							|en = 'The shopping facility has not been selected for copying.'; be = 'Не абраны гандлёвы аб''ект для капіявання.'; es = 'No se ha seleccionado ningún objeto comercial para copiar.'; ka = 'სავაჭრო ობიექტი არ არის შერჩეული კოპირებისთვის.'; kk = 'Көшіру үшін сауда орны таңдалмаған.'; ro = 'Unitatea de cumpărături nu a fost selectată pentru copiere.'; tr = 'Kopyalanacak ticari nesne seçilmedi.'; uk = 'Не вибрано торговий об''єкт для копіювання.'; uz = 'Nusxalash uchun savdo ob''ekti tanlanmagan.'");
		Сообщить(пСообщение);
		Возврат;	
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ID_УзлаОснование", Элементы.ТаблицаУзлов.ТекущиеДанные.ID_Узла);
	ОП = Новый ОписаниеОповещения("СкопироватьУзелВопросЗавершение", ЭтаФорма, ДопПараметры);
	
	пСообщение = НСтр("ru = 'Скопировать торговый объект «%1» и его настройки?';
						|en = 'Copy the ""%1"" trading object and its settings?'; be = 'Скапіяваць гандлёвы аб''ект ""%1 "" і яго Налады?'; es = '¿Copiar el objeto comercial ""%1 "" y sus ajustes?'; ka = 'დააკოპირეთ"" %1 "" სავაჭრო ობიექტი და მისი პარამეტრები?'; kk = '""%1"" сауда нысанын және оның параметрлерін көшіру керек пе?'; ro = 'Copiați obiectul de tranzacționare ""%1 "" și setările acestuia?'; tr = '«%1» ticaret nesnesini ve ayarlarını kopyalamak mı?'; uk = 'Скопіювати торговий об''єкт ""%1 "" і його налаштування?'; uz = '""%1"" savdo ob''ekti va uning sozlamalarini nusxa ko''chirasizmi?'");
	пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, Элементы.ТаблицаУзлов.ТекущиеДанные.Наименование);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Импорт");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЭкспортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКопированияНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Копирование");
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ОткрытьФормуРедактированияУзлаПослеОжидания()
	
	ОткрытьФормуРедактированияУзла(Истина);
	
КонецПроцедуры 

// Открывает форму редактирования узла
// 
// Параметры:
// 	НовыйУзел - Булево - Признак создания нового узла
&НаКлиенте
Процедура ОткрытьФормуРедактированияУзла(НовыйУзел)
	
	ТекущаяСтрока = ?(НовыйУзел, Неопределено, Элементы.ТаблицаУзлов.ТекущиеДанные);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_Узел = ПолучитьФорму("ОФ_ФормаНастройки_Узел", ЭтаФорма, ?(ТекущаяСтрока = Неопределено, Новый УникальныйИдентификатор, ТекущаяСтрока.ID_Узла));
	#Иначе
		ФормаНастройки_Узел = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_Узел",, ЭтаФорма, ?(ТекущаяСтрока = Неопределено, УникальныйИдентификатор, ТекущаяСтрока.ID_Узла));
	#КонецЕсли
	
	ФормаНастройки_Узел.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройки_Узел._ЛокКонтекст = _ЛокКонтекст;	
	Если НовыйУзел Тогда
		ФормаНастройки_Узел.ЭтоНовыйУзел = НовыйУзел;         
		// Задаем по-умолчанию наименование нового узла
		НомерУзлаПоУмолчанию = 1;		
		Пока (Истина) Цикл
			ИмяНовогоУзла = НСтр("ru = 'Торговый объект №';
									|en = 'Shopping facility no'; be = 'Гандлёвы аб''ект №'; es = 'Objeto comercial no'; ka = 'სავაჭრო ობიექტი no'; kk = '№ Сауда нысаны'; ro = 'Centrul comercial nr'; tr = 'Ticari nesne No'; uk = 'Торговий об''єкт №'; uz = 'Savdo obyekti №'");
			ИмяНовогоУзла = ИмяНовогоУзла + НомерУзлаПоУмолчанию;
			Если Не ТаблицаУзлов.НайтиСтроки(Новый Структура("Наименование", ИмяНовогоУзла)).Количество() Тогда
				Прервать;
			КонецЕсли;   
			НомерУзлаПоУмолчанию = НомерУзлаПоУмолчанию + 1;
		КонецЦикла;      	
		ФормаНастройки_Узел.Наименование = ИмяНовогоУзла;
	Иначе
		ЗаполнитьЗначенияСвойств(ФормаНастройки_Узел, ТекущаяСтрока);
	КонецЕсли;
	ОП = Новый ОписаниеОповещения("Настройки_УзелЗакрытие",ЭтаФорма,ТекущаяСтрока);
	ФормаНастройки_Узел.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаНастройки_Узел.Открыть();	
	
КонецПроцедуры

// Перезаполнить таблицу узлов из кэша
// 
// Параметры:
&НаКлиенте
Процедура ОбновитьТаблицуУзлов()
	
	ТаблицаУзлов.Очистить();
	ВсеУзлы = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("Узлы");
	Если НЕ ВсеУзлы = Ложь И ТипЗнч(ВсеУзлы) = Тип("Массив")  Тогда
		Для Каждого СтрокаУзла Из ВсеУзлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ТаблицаУзлов.Добавить(), СтрокаУзла);
		КонецЦикла;
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаУзловСкопироватьУзел.Доступность = ТаблицаУзлов.Количество();
	#Иначе	
		Элементы.КомПанель.Кнопки.ТаблицаУзловСкопироватьУзел.Доступность = ТаблицаУзлов.Количество();
	#КонецЕсли
	
КонецПроцедуры

// Формирует структуру узлов с таблицей пользователей
// 
// Параметры:
// 	ДляСохранения - Булево - Признак получения структуры для сохранения 
// Возвращаемое значение:
// 	Массив, Структура - Если установлен флаг "ДляСохранения", то будет возвращена структура, а иначе массив для выгрузки в SMARTS 
&НаКлиенте
Функция ПолучитьСтруктуруУзловДляСохранения()
	
	СтруктураПользователиТСД = Новый Структура();	
	Для каждого Строка Из ТаблицаУзлов Цикл
		ПользователиТСД = Новый Массив;
		ТаблицаПользователейТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ПользователиТСД", Строка.ID_Узла);
		Если ТипЗнч(ТаблицаПользователейТСД) = Тип("Массив") Тогда
			Для Каждого СтрокаНастройки Из ТаблицаПользователейТСД Цикл
				Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ПользователиТСД.Добавить(Новый Структура("Наименование,ID_Пользователя",СтрокаНастройки.Наименование,СтрокаНастройки.ID_Пользователя));
			КонецЦикла;			
		КонецЕсли;		
		СтруктураПользователиТСД.Вставить("Узел_"+Строка.ID_Узла,ПользователиТСД);
		
	КонецЦикла;
	
	СтруктураДляВыгрузки = Новый Массив;
	
	Для каждого Строка Из ТаблицаУзлов Цикл
	
		НоваяСтрока = _ЛокКонтекст.ЛокЯдро_СтруктураСтрокиНастроек_Узлы();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Ид 						= Строка.ID_Узла;
		НоваяСтрока.Наименование 			= Строка.Наименование;
		НоваяСтрока.Код 					= Строка.ID_Узла;
		НоваяСтрока.ШК						= "";
		НоваяСтрока.ЭтоПапка 				= Ложь;
		НоваяСтрока.ИдРодителя 				= "";
		НоваяСтрока.НаименованиеДляПоиска 	= НРег(Строка.Наименование);
		
		ПользователиУзла = СтруктураПользователиТСД["Узел_" + Строка.ID_Узла];
		СтрокаПользователейИГрупп = "";
		Если ТипЗнч(ПользователиУзла) = Тип("Массив") Тогда
			Для каждого Пользователь Из ПользователиУзла Цикл							
				СимволВНачалеСтроки = ?(СтрокаПользователейИГрупп = "", "", ",");
				СтрокаПользователейИГрупп = СтрокаПользователейИГрупп + СимволВНачалеСтроки + """" + СокрЛП(Пользователь.ID_Пользователя) + """";			
			КонецЦикла;
		КонецЕсли;
		
		НоваяСтрока.Вставить("Владелец", СтрокаПользователейИГрупп);
		
		СтруктураДляВыгрузки.Добавить(НоваяСтрока);	
		
	КонецЦикла;
	
	Возврат СтруктураДляВыгрузки;
	
КонецФункции

// Получает идентификаторы подключенных баз SMARTS
// 
// Параметры:
// Возвращаемое значение:
// 	Массив - Массив идентификаторов
&НаКлиенте
Функция ПолучитьМассивIDБазMS()
	
	Перем МассивIDБазMS;
	Перем Узел;
	Перем IDБазыMS;
	
	МассивIDБазMS = Новый Массив;
	
	Для каждого Узел Из ТаблицаУзлов Цикл
		Если Узел.ИспользоватьЧастнуюБазу Тогда
			IDБазыMS = СокрЛП(Узел.ЧастнаяБазаMS);
			Если IDБазыMS <> "" И МассивIDБазMS.Найти(IDБазыMS) = Неопределено Тогда
				МассивIDБазMS.Добавить(Узел.ID_Узла);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат МассивIDБазMS;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура Настройки_УзелЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ЭтоНовыйТО = Ложь;
		
		Отбор = Новый Структура("ID_Узла", РезультатРедактирования.ID_Узла);
		Строки = ТаблицаУзлов.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			НоваяСтрока = Строки[0];
		Иначе
			НоваяСтрока = ТаблицаУзлов.Добавить();	
			ЭтоНовыйТО = Истина;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатРедактирования);	
		
		Если ЭтоНовыйТО Тогда
			_ЛокКонтекст.ЛокЯдро_СоздатьУзел(РезультатРедактирования);
		Иначе
			_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("Узлы", Отбор, РезультатРедактирования,,Истина);		
			ТаблицаДляСохранения = ПолучитьСтруктуруУзловДляСохранения();
			_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("Узлы", ТаблицаДляСохранения);
			ВыгрузитьУзлы();
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	 
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьУзлыПослеПодключения(СерверДоступен,ДопПараметры) Экспорт	
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	МассивУзлов = ПолучитьСтруктуруУзловДляСохранения();
	_ЛокКонтекст.ЛокЯдро_ВыгрузитьТаблицуУзловСобытиеФормы(МассивУзлов);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьУзелВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		_ЛокКонтекст.ЛокЯдро_СоздатьУзел(, ДополнительныеПараметры.ID_УзлаОснование);
		ОбновитьТаблицуУзлов();
	КонецЕсли;
	
КонецПроцедуры 


