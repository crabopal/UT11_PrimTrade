																	|en = 'Search by Name (for reference books)'; be = 'Пошук па Найменні (для даведнікаў)'; es = 'Búsqueda por Nombre (para referencias)'; ka = 'ძიება სახელით (საცნობარო წიგნებისთვის)'; kk = 'Атауы бойынша іздеу (анықтамалықтар үшін)'; ro = 'Căutare după nume (pentru cărți de referință)'; tr = 'İsme göre ara (dizinler için)'; uk = 'Пошук по найменуванню (для довідників)'; uz = 'Ism bo''yicha qidirish (ma''lumotnomalar uchun)'"));
	СписокСпособовСопоставления.Добавить("Код",              НСтр("ru = 'Поиск по Коду (для справочников)';
																	|en = 'Code Search (for reference books)'; be = 'Пошук па Коду (для даведнікаў)'; es = 'Búsqueda por Código (para referencias)'; ka = 'კოდის ძებნა (საცნობარო წიგნებისთვის)'; kk = 'Код бойынша іздеу (анықтамалықтар үшін)'; ro = 'Căutare cod (pentru cărți de referință)'; tr = 'Koda göre ara (dizinler için)'; uk = 'Пошук за кодом (для довідників)'; uz = 'Kodni qidirish (ma''lumotnomalar uchun)'"));
	СписокСпособовСопоставления.Добавить("КакЕсть",          НСтр("ru = 'Как есть (любой тип)';
																	|en = 'As is (any type)'; be = 'Як ёсць (любы тып)'; es = 'Como es (cualquier tipo)'; ka = 'როგორც არის (ნებისმიერი ტიპის)'; kk = 'Қалай (кез келген түрі)'; ro = 'Așa cum este (orice tip)'; tr = 'Olduğu gibi (her tür)'; uk = 'Як є (будь-який тип)'; uz = 'Qanday bo''lsa (har qanday turdagi)'"));
	СписокСпособовСопоставления.Добавить("ПодборКоличества", НСтр("ru = 'Подбор количества';
																	|en = 'Quantity selection'; be = 'Падбор колькасці'; es = 'Selección de la cantidad'; ka = 'რაოდენობის შერჩევა'; kk = 'Санын таңдау'; ro = 'Selectarea cantității'; tr = 'Miktar seçimi'; uk = 'Підбір кількості'; uz = 'Miqdorni tanlash'"));
	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипПриемникаСиноним,СписокТиповПриемника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипИсточникаСиноним,СписокТиповИсточника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСинонимПриемника,СписокРеквизитов1С);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним,СписокСпособовСопоставления);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПравилоПоискаСиноним,СписокПравилПоиска);
	
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОткрытияФормыДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	// Видимость и значения элементов
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НадписьТабличнаяЧасть1С.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
		Элементы.НадписьТабличнаяЧастьMS.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";	
	#КонецЕсли
	Элементы.ИмяТабличнойЧасти1ССиноним.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
	Элементы.ИмяТабличнойЧастиMSСиноним.Видимость = КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента";
	
	ЗаполнитьТаблицуРеквизитов(ТаблицаРеквизитовИсходная);
	
	Если ТипЗнч(ТаблицаРеквизитовДополнительная) = Тип("Массив") Тогда
		ТаблицаРеквизитовДополнительнаяНовая = Новый Массив();
		ТаблицаРеквизитовДополнительнаяНовая.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Загружать,ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,ПравилоПоискаСиноним,Группировать,ОчищатьПередЗагрузкой,ОбработчикПодбораКоличества,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,ПравилоПоиска"));
		
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовДополнительная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Новый Структура("Загружать,ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,ПравилоПоискаСиноним,Группировать,ОчищатьПередЗагрузкой,ОбработчикПодбораКоличества,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,ПравилоПоиска");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
			
			ТаблицаРеквизитовДополнительнаяНовая.Добавить(НоваяСтрока);
		КонецЦикла;
		ТаблицаРеквизитовДополнительная = ТаблицаРеквизитовДополнительнаяНовая;
	КонецЕсли;
	
	ВидОбработчика_ЗаполнениеПоУмолчанию();
	ЗаполнениеСоответствияВидовОбработчиковЗагрузки();
	
	ОбновитьОтображениеПриОткрытии();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если Не ПроверитьКорректностьДобавленныхОбработчиков() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьКорректностьЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	Результат.Вставить("ТаблицаНастроек", _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов));
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемДокумента", 		ВидОбработчика_ПередЗаполнениемДокумента);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияДокумента",  		ВидОбработчика_ПослеЗаполненияДокумента);
		Результат.Вставить("ВидОбработчика_ПослеОткрытияФормыДокумента",  	ВидОбработчика_ПослеОткрытияФормыДокумента);
		Результат.Вставить("Обработчик_ПередЗаполнениемДокумента", 			Обработчик_ПередЗаполнениемДокумента);
		Результат.Вставить("Обработчик_ПослеЗаполненияДокумента",  			Обработчик_ПослеЗаполненияДокумента);
		Результат.Вставить("Обработчик_ПослеОткрытияФормыДокумента",  		Обработчик_ПослеОткрытияФормыДокумента);
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемТабличнойЧасти",       	ВидОбработчика_ПередЗаполнениемТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти", 	ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеЗаполненияТабличнойЧасти",        	ВидОбработчика_ПослеЗаполненияТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередЗаполнениемТабличнойЧасти",       		Обработчик_ПередЗаполнениемТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти", 		Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти",  		Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеЗаполненияТабличнойЧасти",        		Обработчик_ПослеЗаполненияТабличнойЧасти);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	пРазрешитьЗакрытие = Истина;
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицуРеквизитов(Команда)
	
	пЗаголовок = НСтр("ru = 'Очистить таблицу сопоставления полей?'");
	
	Если ЭтоТиповаяНастройка Тогда
		пСообщение = НСтр("ru = 'Будут удалены только пользовательские поля.'");
	Иначе
		пСообщение = "";
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ВопросОчиститьТаблицуРеквизитовЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповыеНастройки(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки обработчиков и таблица полей будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповыеНастройкиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповуюТаблицуРеквизитов(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить таблицу полей настройками по умолчанию?'");
	пСообщение = НСтр("ru = 'Таблица полей будет сброшена к значениям по умолчанию. Пользовательские поля будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповуюТаблицуРеквизитовЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ") + ?(Не ПустаяСтрока(ИмяТабличнойЧасти1С), "_" + ИмяТабличнойЧасти1С, "");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаЗагрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаПриИзменении(Элемент)
	
	ИмяОбработчика = СтрЗаменить(Элемент.Имя, "Обработчик_", "");
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаЗаполнения(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаЗаполнения(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьПользовательскуюНастройкуНажатие(Элемент)
	
	ВидОбработчика = СтрЗаменить(Элемент.Имя, "Сбросить", "");
	
	пЗаголовок = НСтр("ru = 'Восстановить настройку обработчика по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройка обработчика будет сброшена к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение", ЭтаФорма, ВидОбработчика);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура Подсказки_ЗакрытьПодсказку(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_Подсказки_ЗакрытьПодсказку(ЭтаФорма, Элемент);
	
КонецПроцедуры

#КонецОбласти

