&НаКлиенте
Процедура ТаблицаРеквизитовПриИзменении(Элемент)
	
	УстановитьНомераСтрокТаблицыРеквизитов();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные.Типовой Тогда
		
		ИменаДоступныхКолонок = ПолучитьИменаДоступныхКолонокКИзменению();
		Если ИменаДоступныхКолонок.Найти(Поле.Имя) = Неопределено Тогда
			
			пЗаголовок = НСтр("ru = 'Скопировать поле и отключить использование типового?'");
			пСообщение = НСтр("ru = 'Это типовое поле, и его изменение ограничено. Чтобы изменить его, необходимо создать копию и отключить использование типового.'");
			
			ОП = Новый ОписаниеОповещения("ВопросСкопироватьТиповоеПолеЗавершение", ЭтаФорма, ТекДанные);
			ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПриАктивизацииСтроки(Элемент)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДоступностьИзменения = Истина;
		
		Если ЭтоТиповаяНастройка Тогда
			// Т.к доступно множественное выделение, то проверяем каждую строку
			Для каждого ИдСтроки Из Элемент.ВыделенныеСтроки Цикл
				Если ТаблицаРеквизитов.НайтиПоИдентификатору(ИдСтроки).Типовой Тогда
					ДоступностьИзменения = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Элементы.ТаблицаРеквизитовУдалить.Доступность = ДоступностьИзменения;
		Элементы.ТаблицаРеквизитов.ИзменятьПорядокСтрок = ДоступностьИзменения;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПриАктивизацииЯчейки(Элемент)
	ТекДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним.ТолькоПросмотр = ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	КонецЕсли;
КонецПроцедуры

