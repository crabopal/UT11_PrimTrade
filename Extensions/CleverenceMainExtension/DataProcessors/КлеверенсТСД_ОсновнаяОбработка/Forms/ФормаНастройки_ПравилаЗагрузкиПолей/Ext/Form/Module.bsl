		КонецЕсли;		
		
		// ************************** ИдЕдиницыИзмерения -> ЕдиницаИзмерения ***************************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("ЕдиницаИзмерения") <> Неопределено
