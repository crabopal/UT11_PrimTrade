&НаКлиенте
Процедура ТаблицаРеквизитовТипПриемникаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповПриемника.НайтиПоЗначению(ТекущаяСтрока.ТипПриемникаСиноним);
	
	ТекущаяСтрока.ТипПриемникаСиноним = НайденныйЭлементСписка.Представление;
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипПриемника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимПриемника = "";
		ТекущаяСтрока.ИмяПриемника = "";
		Если ТекущаяСтрока.ТипПриемника = "НовыйРеквизит" Тогда
			ТекущаяСтрока.Загружать = Ложь;
		КонецЕсли;
	КонецЕсли;
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	ОбновитьВидимостьЭлементовСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипПриемникаСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипПриемника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПрЗначениеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	НайденныйЭлементСписка = Неопределено;
	Если ТекущаяСтрока.ТипПриемника = "Реквизит1С" Тогда
		НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(ТекущаяСтрока.ПрЗначение);
		Если НайденныйЭлементСписка = Неопределено Тогда
			ТекущаяСтрока.ИмяПриемника = "";
			ТекущаяСтрока.ПрЗначение = "";
		Иначе
			ТекущаяСтрока.СинонимПриемника = НайденныйЭлементСписка.Представление;
			ТекущаяСтрока.ИмяПриемника = НайденныйЭлементСписка.Значение;
			ТекущаяСтрока.ПрЗначение = НайденныйЭлементСписка.Представление;
		КонецЕсли;
	Иначе
		ТекущаяСтрока.ИмяПриемника = ТекущаяСтрока.ПрЗначение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПрЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипИсточникаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповИсточника.НайтиПоЗначению(ТекущаяСтрока.ТипИсточникаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипИсточникаСиноним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ТипИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = Неопределено;
	КонецЕсли;
	
	// Способ сопоставления
	Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
		ТекущаяСтрока.СпособСопоставления = "";
		ТекущаяСтрока.СпособСопоставленияСиноним = "";
	Иначе
		ТекущаяСтрока.СпособСопоставления = "КакЕсть";
		ТекущаяСтрока.СпособСопоставленияСиноним = "Как есть (любой тип)";
	КонецЕсли;
	
	// Правило поиска
	Если ТекущаяСтрока.ТипИсточника <> "РеквизитMS" Тогда
		ТекущаяСтрока.ПравилоПоиска = "";
		ТекущаяСтрока.ПравилоПоискаСиноним = "";
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним.ТолькоПросмотр = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	
	ТекущаяСтрока.ОбработчикПодбораКоличества = "";
	
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	ОбновитьВидимостьЭлементовСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовТипИсточникаСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипИсточника;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" Тогда
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = ТекущаяСтрока.ИсЗначение;
		ОбновитьВидимостьЭлементовСтроки();
	Иначе	
		НайденныйЭлементСписка = Неопределено;
		Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
			НайденныйЭлементСписка = Неопределено;
			Для каждого РеквизитMS из СписокРеквизитовMS Цикл
				Если РеквизитMS.Значение = ТекущаяСтрока.ИсЗначение
					ИЛИ РеквизитMS.Имя = ТекущаяСтрока.ИсЗначение Тогда
					НайденныйЭлементСписка = Новый Структура("Значение,Представление",РеквизитMS.Имя,РеквизитMS.Ключ);	
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
			НайденныйЭлементСписка = СписокГлобальныхПараметров.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		КонецЕсли;
		Если НайденныйЭлементСписка = Неопределено Тогда
			ТекущаяСтрока.СинонимИсточника = "";
			ТекущаяСтрока.ИмяИсточника = "";
			ТекущаяСтрока.ЗначениеИсточника = Неопределено;
			ТекущаяСтрока.ИсЗначение = Неопределено;
		Иначе
			Если НайденныйЭлементСписка.Значение = ПредыдущееЗначение Тогда
				ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
			Иначе
				ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
				ТекущаяСтрока.ИмяИсточника = НайденныйЭлементСписка.Значение;
				ТекущаяСтрока.ЗначениеИсточника = Неопределено;
			КонецЕсли;
			ТекущаяСтрока.ИсЗначение = НайденныйЭлементСписка.Представление;
		КонецЕсли;
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		
		ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
		
		СтандартнаяОбработка = Ложь;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеКоды",ЭтаФорма);
		#Иначе
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеКоды", , ЭтаФорма, ЭтаФорма);
			ФормаСписка_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаСписка_ПроизвольныеКоды._ЛокКонтекст = _ЛокКонтекст;
		ФормаСписка_ПроизвольныеКоды.КлючНастройки = КлючНастройки;
		ФормаСписка_ПроизвольныеКоды.ТипИсходногоДокумента1С = ТипДокумента1С;
		ФормаСписка_ПроизвольныеКоды.ИмяТабличнойЧасти1С = ИмяТабличнойЧасти1С;
		
		АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
		
		Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = ТаблицаРеквизитовДополнительная;
		ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = ТаблицаРеквизитовДополнительная;
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		КонецЕслИ;
		ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыЗакрытие",ЭтаФорма,ПредыдущееЗначение);
		ФормаСписка_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды.ОткрытьМодально();
		#Иначе
			ФормаСписка_ПроизвольныеКоды.Открыть();		
		#КонецЕсли
		
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" И ТекущаяСтрока.ИсЗначение = Неопределено; 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();	
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	
	Если ТекущаяСтрока.ТипИсточника = "РеквизитMS" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокРеквизитовMS);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокПроизвольныхКодов);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокГлобальныхПараметров);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеОчистка(Элемент, СтандартнаяОбработка)
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ЗначениеИсточника = Неопределено;
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ИсЗначение = Неопределено;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовСпособСопоставленияСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.СпособСопоставленияСиноним = "ПодборКоличества" Тогда
		ИмяОбработчикаПодбораКоличества = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика("ПодборКоличества", ТипДокумента1С);
		РезультатПроверки = ПроверитьДоступностьОбработчика(ИмяОбработчикаПодбораКоличества, ТекущаяСтрока.ИмяПриемника);
		Если РезультатПроверки.Статус Тогда
			ТекущаяСтрока.ОбработчикПодбораКоличества = ИмяОбработчикаПодбораКоличества;
			НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ТекущаяСтрока.СпособСопоставленияСиноним);
		Иначе
			ТекущаяСтрока.ОбработчикПодбораКоличества = "";
			НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ПредыдущееЗначение);
		КонецЕсли;
		Сообщить(РезультатПроверки.Сообщение); 
		ТекущаяСтрока.ПравилоПоиска = "";
		ТекущаяСтрока.ПравилоПоискаСиноним = "";
		ТекущаяСтрока.Группировать = Ложь;
	Иначе
		ТекущаяСтрока.ОбработчикПодбораКоличества = "";
		НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ТекущаяСтрока.СпособСопоставленияСиноним);
	КонецЕсли;
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.СпособСопоставления = "";
		ТекущаяСтрока.СпособСопоставленияСиноним = "";
	Иначе
		ТекущаяСтрока.СпособСопоставления = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СпособСопоставленияСиноним = НайденныйЭлементСписка.Представление;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовСпособСопоставленияСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.СпособСопоставления;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПравилоПоискаСинонимПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокПравилПоиска.НайтиПоЗначению(ТекущаяСтрока.ПравилоПоискаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ПравилоПоискаСиноним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ПравилоПоиска = НайденныйЭлементСписка.Значение;
	ИначеЕсли НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ПравилоПоиска = "";
	КонецЕсли;
	
	// Группировка
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПравилоПоиска) Тогда
		ТекущаяСтрока.Группировать = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПравилоПоискаСинонимОчистка(Элемент, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;

	ТекущаяСтрока.ПравилоПоискаСиноним = "";
	ТекущаяСтрока.ПравилоПоиска = "";
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Для каждого КлючЗначение Из СтруктураВидовОбработчиков Цикл
			УстановитьВидимостьКнопкиСброситьОбработчик(КлючЗначение.Значение.Тип);
		КонецЦикла;
		
		Элементы.ДекорацияПредупреждение.Видимость 					= ЭтоТиповаяНастройка;
		Элементы.ВосстановитьТиповыеНастройки.Видимость 			= ЭтоТиповаяНастройка;
		Элементы.ВосстановитьТиповуюТаблицуРеквизитов.Видимость 	= ЭтоТиповаяНастройка;
	#КонецЕсли
	
	Подсказки_УстановитьВидимостьПодсказок();
	УстановитьНомераСтрокТаблицыРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура Подсказки_УстановитьВидимостьПодсказок()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	// Подсказка: ПереопределениеТиповыхПолей
	ГруппаПодсказка_ПереопределениеТиповыхПолей = Элементы.Найти("ГруппаПодсказка_ПереопределениеТиповыхПолей");
	Если ГруппаПодсказка_ПереопределениеТиповыхПолей <> Неопределено Тогда
		// Если это пользовательский БП, то скрываем подсказку о типовых полях
		Если НЕ ЭтоТиповаяНастройка Тогда
			ГруппаПодсказка_ПереопределениеТиповыхПолей.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Скрываем группу подсказок, если подсказок нет
	ВидимостьГруппыПодсказки = Ложь;
	Для каждого Подсказка Из Элементы.ГруппаПодсказкиТаблицаРеквизитов_Тело.ПодчиненныеЭлементы Цикл
		Если Подсказка.Видимость Тогда
			ВидимостьГруппыПодсказки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Элементы.ГруппаПодсказкиТаблицаРеквизитов.Видимость = ВидимостьГруппыПодсказки;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	
	ЭлементТиповой = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ИменаДоступныхКолонок = ПолучитьИменаДоступныхКолонокКИзменению();
	
	Для каждого Колонка Из Элементы.ТаблицаРеквизитов.ПодчиненныеЭлементы Цикл
		
		Если ИменаДоступныхКолонок.Найти(Колонка.Имя) = Неопределено Тогда
			
			ПолеЭлемента = ЭлементТиповой.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОтборЭлемента = ЭлементТиповой.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаРеквизитов.Типовой");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементТиповой.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементТиповой.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(140, 140, 140));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопкиСброситьОбработчик(ТипОбработчика)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	ВидОбработчика = "ВидОбработчика_" + ТипОбработчика;
	
	СтруктураОбработчика = СтруктураВидовОбработчиков[ВидОбработчика];
	ИмяОбработчика = СтруктураОбработчика.Обработчик;
	
	ЭлементКнопки = Элементы.Найти(ВидОбработчика + "Сбросить");
	Если ЭлементКнопки <> Неопределено Тогда
		
		ЭлементКнопки.Видимость = Ложь;
		
		Если ЭтоТиповаяНастройка Тогда
			
			ТиповыеНастройки = Новый Структура;
			ТиповыеНастройки.Вставить(ВидОбработчика);
			ТиповыеНастройки.Вставить(ИмяОбработчика);
			ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
			
			// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
			Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
				Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
					ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
				КонецЕсли;
			Иначе
				ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
			КонецЕсли;
			
			ТекущиеНастройки = Новый Структура;
			ТекущиеНастройки.Вставить(ВидОбработчика, ЭтаФорма[ВидОбработчика]);
			ТекущиеНастройки.Вставить(ИмяОбработчика, ЭтаФорма[ИмяОбработчика]);
			
			РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(ТиповыеНастройки, ТекущиеНастройки);
			ЭлементКнопки.Видимость = РезультатСравнения.Изменено;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьТаблицуРеквизитов(ДанныеТаблицаРеквизитов)
	
	Если ТипЗнч(ДанныеТаблицаРеквизитов) = Тип("Массив") Тогда
		Для Каждого СтрокаИсходнойТаблицы Из ДанныеТаблицаРеквизитов Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);	
			
			Если ЭтоТиповаяНастройка
				И (НЕ СтрокаИсходнойТаблицы.Свойство("Типовой")
				ИЛИ СтрокаИсходнойТаблицы.Типовой <> Ложь) Тогда
				НоваяСтрока.Типовой = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	// Временное решение. Окончание.
	Для Каждого Элем Из ТаблицаРеквизитов Цикл
		Элем.ПрЗначение = ?(Элем.ТипПриемника = "НовыйРеквизит",Элем.ИмяПриемника,Элем.СинонимПриемника);
		Элем.ИсЗначение = ?(Элем.ТипИсточника = "ПроизвольноеЗначение",Элем.ЗначениеИсточника,Элем.СинонимИсточника);
	КонецЦикла;
	
	УстановитьНомераСтрокТаблицыРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНомераСтрокТаблицыРеквизитов()
	
	Для каждого СтрокаПоля Из ТаблицаРеквизитов Цикл
        СтрокаПоля.НомерСтроки = ТаблицаРеквизитов.Индекс(СтрокаПоля)+1;    
    КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ОбновитьСписокПроизвольныхКодов(ДопТипОбработки = "")
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Направление = "Загрузка";
		ТипОбъекта = "Шапка";		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Направление = "Загрузка";
		ТипОбъекта = "ТабличнаяЧасть";
	КонецЕсли;	
	
	// Формируем список произвольных кодов без обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ТипОбъекта);
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодов", Отбор);
	
	// Формируем список произвольных кодов для обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ?(ПустаяСтрока(ДопТипОбработки), ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков(), ДопТипОбработки));
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодовОбработчиков", Отбор);	
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьСписокПроизвольныхКодов(ИмяСписка, Отбор)
		
	ЭтаФорма[ИмяСписка].Очистить();
	
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЭтаФорма[ИмяСписка].Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	Если ЭтаФорма[ИмяСписка].Количество() = 0 Тогда
		ЭтаФорма[ИмяСписка].Добавить("");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент,Список)
	
	Приемник = Элемент.СписокВыбора;
	Если ТипЗнч(Список) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем.Значение,Элем.Ключ);	
		КонецЦикла;
		Приемник.СортироватьПоЗначению();
	Иначе
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем.Значение,Элем.Представление);	
		КонецЦикла;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ТипЗнч(Элемент) = Тип("ПолеВыбора") Тогда
			Элемент.РежимВыбораИзСписка = Истина;
			Элемент.КнопкаСпискаВыбора = Истина;
		КонецЕсли;		
	#Иначе
		Элемент.РежимВыбораИзСписка = Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;		
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДоступностьОбработчика(ИмяОбработчика, ИмяПоля)
	
	СтруктураПараметров = Новый Структура("ПодборКоличества_Колонка1С", ИмяПоля);
	
	Возврат _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ИмяОбработчика, СтруктураПараметров);
	
КонецФункции

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	ТаблицаРеквизитов.Сортировать("Типовой Убыв"); // Сортируем, т.к типовые поля всегда должны быть сверху
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаРеквизитов.Скопировать();
	#Иначе
		ТЗ = ТаблицаРеквизитов.Выгрузить();
	#КонецЕсли
	
	ТЗ.Колонки.Удалить("НомерСтроки");
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(ТЗ);
	#Иначе
		Возврат ПоместитьВоВременноеХранилище(ТЗ, ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовСтроки()
	ТекДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	Элементы.ТаблицаРеквизитовИсЗначение.РежимВыбораИзСписка = ?(НЕ (ТекДанные.ТипИсточника = "ПроизвольноеЗначение"),Истина,Ложь);
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	Если ТекДанные.ТипИсточника = "РеквизитMS" Тогда
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокРеквизитовMS);
	ИначеЕсли ТекДанные.ТипИсточника = "ПроизвольныйКод" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокПроизвольныхКодов);
	ИначеЕсли ТекДанные.ТипИсточника = "ГлобальныйПараметр" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокГлобальныхПараметров);		
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаСпискаВыбора = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#Иначе
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаВыпадающегоСписка = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
		Элементы.ТаблицаРеквизитовПрЗначение.РежимВыбораИзСписка 	 = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#КонецЕсли
		
	Если ТекДанные.ТипПриемника = "НовыйРеквизит" Тогда
		Элементы.ТаблицаРеквизитовПрЗначение.СписокВыбора.Очистить();
	Иначе
		Элементы.ТаблицаРеквизитовПрЗначение.СписокВыбора.Очистить();
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПрЗначение,СписокРеквизитов1С);
	КонецЕсли;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекДанные.ТипИсточника = "ПроизвольноеЗначение" И ТекДанные.ИсЗначение = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиПоУмолчанию()

	Если ТаблицаРеквизитов.Количество() Тогда
		
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ВосстановитьНастройкиЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Текущие настройки будут утеряны! Перезаписать их?';
								|en = 'The current settings will be lost! Overwrite them?'; be = 'Бягучыя налады будуць згубленыя! Перазапісаць іх?'; es = '¡La configuración actual se perderá! ¿Sobrescribirlos?'; ka = 'მიმდინარე პარამეტრები დაიკარგება! გადაწერეთ ისინი?'; kk = 'Ағымдағы параметрлер жоғалады! Оларды қайта жазасыз ба?'; ro = 'Setările curente vor fi pierdute! Le suprascrieți?'; tr = 'Mevcut ayarlar kaybolacak! Bunların üzerine yazmak mı?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Joriy Sozlamalar yo''qoladi! Ularni ustiga yozish?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		
	Иначе
		ВосстановитьНастройкиЗавершение(КодВозвратаДиалога.Да,Ложь);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, ИмяФормыПК, ТекущееЗначение, ЭтоФормаЭлемента = Ложь) 
	
	ЭтоОбработчикЗаполнения = Ложь;
	ДопКлючНастройки 		= "";
	ДопТипОбработки			= "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды = ПолучитьФорму("ОФ_" + ИмяФормыПК, ЭтаФорма);
	#Иначе
		Форма_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма." + ИмяФормыПК, , ЭтаФорма, ЭтаФорма);
		Форма_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	Форма_ПроизвольныеКоды._ЛокКонтекст 			= _ЛокКонтекст;
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ВРЕГ(ИмяЭлементаОбработки), "ОБРАБОТЧИК_") <> 0 Тогда			
		ДопКлючНастройки							= ПолучитьКлючНастройкиОбработчикаЗаполнения(ИмяЭлементаОбработки);
		ДопТипОбработки								= СтрЗаменить(ДопКлючНастройки, "Загрузка_", "");
		Форма_ПроизвольныеКоды.КлючНастройки 		= ДопКлючНастройки;			
		ЭтоОбработчикЗаполнения						= Истина;			
	Иначе
		Форма_ПроизвольныеКоды.КлючНастройки 		= КлючНастройки;
	КонецЕсли;
	Форма_ПроизвольныеКоды.ТипИсходногоДокумента1С 	= ТипДокумента1С;
	Форма_ПроизвольныеКоды.ИмяТабличнойЧасти1С 		= ИмяТабличнойЧасти1С;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= ТаблицаРеквизитовДополнительная;
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= ТаблицаРеквизитовДополнительная;
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	КонецЕслИ;
	
	Если ЭтоФормаЭлемента Тогда
		Форма_ПроизвольныеКоды.ЭтоНоваяНастройка	= Ложь;				
		
		ТаблицаПроизвольныхКодов	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды", Истина);
		ДанныеПроизвольногоКода 	= _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТаблицаПроизвольныхКодов, "ID_ПроизвольногоКода", ТекущееЗначение);
		
		ЗаполнитьЗначенияСвойств(Форма_ПроизвольныеКоды, ДанныеПроизвольногоКода);
	КонецЕсли; 
	
	ДопПараметрыОповещения = Новый Структура("ПредыдущееЗначение, СтрокаОбработчика, ДопТипОбработки, ЭтоОбработчикЗаполнения", 
		ТекущееЗначение, 
		ИмяЭлементаОбработки, 
		ДопТипОбработки,
		ЭтоОбработчикЗаполнения);
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие", ЭтаФорма, ДопПараметрыОповещения);
	Форма_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		Форма_ПроизвольныеКоды.Открыть();		
	#КонецЕсли 	

КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ЗаполнениеПоУмолчанию()
	
	// Для корректной интеграции в существующие настройки в случае заполненности обработчика устанавливаем его вид как "Свой обработчик"
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеОткрытияФормыДокумента");
		
		ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов);
		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеЗаполненияТабличнойЧасти");
		
		ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеСоответствияВидовОбработчиковЗагрузки()
		
	СтруктураВидовОбработчиков = Новый Структура;
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
	
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередЗаполнениемДокумента", 				
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередЗаполнениемДокумента", 
				"ПередЗаполнениемДокумента"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеЗаполненияДокумента", 				
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеЗаполненияДокумента", 
				"ПослеЗаполненияДокумента"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеОткрытияФормыДокумента", 			
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеОткрытияФормыДокумента", 
				"ПослеОткрытияФормыДокумента"));
		
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти", 	
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти",
				"ПередЗаполнениемСтрокиТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередЗаполнениемТабличнойЧасти",
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередЗаполнениемТабличнойЧасти", 
				"ПередЗаполнениемТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти",
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти", 
				"ПослеЗаполненияСтрокиТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеЗаполненияТабличнойЧасти",
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеЗаполненияТабличнойЧасти", 
				"ПослеЗаполненияТабличнойЧасти"));
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненныхОбработчиковЗагрузки(МассивИменРеквизитов)
	
	Для Каждого РеквизитОбработчика Из МассивИменРеквизитов Цикл
		
		РеквизитВидаОбработчика = СтрЗаменить(РеквизитОбработчика, "Обработчик", "ВидОбработчика");
		Если Не ПустаяСтрока(ЭтаФорма[РеквизитОбработчика]) Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма[РеквизитВидаОбработчика]) Тогда
				ЭтаФорма[РеквизитВидаОбработчика] = 2; // "Свой обработчик"
			КонецЕсли;
		Иначе
			ЭтаФорма[РеквизитВидаОбработчика] = 0; // "Без обработчика"
		КонецЕсли;
		
		Если ЭтаФорма[РеквизитВидаОбработчика] = 3 Тогда // "Произвольный код"
			
			// В обычных формах подменяем поле ввода обарботчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[РеквизитОбработчика].Видимость 			= Ложь;				
				Элементы[РеквизитОбработчика + "Выбор"].Видимость 	= Истина;					
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика + "Выбор"], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика + "Выбор"], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#Иначе
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#КонецЕсли
		Иначе 
			УстановкаОформленияСтрокиОбработчикаЗагрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
		КонецЕсли;		

		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы[РеквизитВидаОбработчика].Значение = ЭтаФорма[РеквизитВидаОбработчика];
		#КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОформленияСтрокиОбработчикаЗагрузки(ЭлементСтрокаОбработчика, ЗначениеСтрокаОбработчика, КодВидаОбработчика)
	
	БезЗаполнения	= КодВидаОбработчика = 0;
	ПоУмолчанию		= КодВидаОбработчика = 1;
	СвойОбработчик	= КодВидаОбработчика = 2;	
	ПроизвольныйКод	= КодВидаОбработчика = 3;

	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСтрокаОбработчика.РежимВыбораИзСписка	= ПроизвольныйКод;				
		ЭлементСтрокаОбработчика.КнопкаВыбора 			= ПроизвольныйКод;		    		
		ЭлементСтрокаОбработчика.КнопкаВыпадающегоСписка= Ложь;
	#Иначе
		ЭлементСтрокаОбработчика.Значение				= ЗначениеСтрокаОбработчика;
	#КонецЕсли                                          
	ЭлементСтрокаОбработчика.ТолькоПросмотр 			= ПоУмолчанию Или БезЗаполнения;     				
	ЭлементСтрокаОбработчика.ЦветТекста 				= ?(ПоУмолчанию, WebЦвета.Серый, Новый Цвет(51, 51, 51));
	ЭлементСтрокаОбработчика.Шрифт 						= Новый Шрифт(ЭлементСтрокаОбработчика.Шрифт,,,, ПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьДобавленныхОбработчиков()
	
	КонтрольПройден = Истина;
	
	МассивВидовОбработчиков = Новый Массив;
	
	Если КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемДокумента, "ВидОбработчика_ПередЗаполнениемДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияДокумента, "ВидОбработчика_ПослеЗаполненияДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеОткрытияФормыДокумента, "ВидОбработчика_ПослеОткрытияФормыДокумента"));
	ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемТабличнойЧасти, "ВидОбработчика_ПередЗаполнениемТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти, "ВидОбработчика_ПередЗаполнениемСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти, "ВидОбработчика_ПослеЗаполненияСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеЗаполненияТабличнойЧасти, "ВидОбработчика_ПослеЗаполненияТабличнойЧасти"));
	КонецЕсли;

	Для Каждого ВидОбработчика Из МассивВидовОбработчиков Цикл
		
		ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Обработчик;
		ТипОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Тип;
		
		// Проверка своего обработчика и произвольного кода на пустоту
		Если ВидОбработчика.Значение = 2 Или ВидОбработчика.Значение = 3 Тогда 						
			Если ПустаяСтрока(ЭтаФорма[ИмяОбработчика]) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не заполнен!';
											|en = 'The handler is not full!'; be = 'Апрацоўшчык не запоўнены!'; es = '¡El controlador no está lleno!'; ka = 'დამმუშავებელი არ არის სავსე!'; kk = 'Өңдеуші толық емес!'; ro = 'Manipulatorul nu este plin!'; tr = 'İşleyici dolu değil!'; uk = 'Обробник не заповнений!'; uz = 'Ishlov beruvchi to''ldirilmagan!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не заполнен свой обработчик <%1>!';
												|en = 'Your handler is not filled in <%1>!'; be = 'Ня запоўнены свой апрацоўшчык <%1>!'; es = '¡Su controlador <%1>no está lleno!'; ka = 'თქვენი დამმუშავებელი არ არის შევსებული <%1>!'; kk = 'Сіздің өңдеушіңіз <%1 > толтырылмаған!'; ro = 'Operatorul dvs. nu este completat <%1>!'; tr = 'işleyiciniz <%1> dolu değil!'; uk = 'Не заповнений свій обробник <%1>!'; uz = 'Sizning ishlovchingiz <%1>bilan to''ldirilmagan!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 					
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка своего обработчика на наличие в интеграционной обработке
		Если ВидОбработчика.Значение = 2 Тогда
			Если ВидОбработчика.Имя = "ВидОбработчика_ПослеОткрытияФормыДокумента" Тогда
				РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчикаФормы(ЭтаФорма[ИмяОбработчика]);
			Иначе
				СтруктураПараметров = Новый Структура("АдресаПеременных, ДанныеДляЗагрузки_Строка, ДанныеДокументаMS, Док1СОснование, Док1СРезультат, ДокументТСД, СтрокаДокумента, СтрокаНастройки, СтруктураПоискаКлючаСвязи, ТЧ, ТекущиеНастройкиMS");
				РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ЭтаФорма[ИмяОбработчика], СтруктураПараметров);
			КонецЕсли;
			
			Если Не РезультатПроверки.Статус Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не найден в подключенной интеграционной обработке!';
											|en = 'The handler was not found in the enabled integration processing!';
											|be = 'Апрацоўшчык не знойдзены ў падключанай інтэграцыйнай апрацоўцы!'; es = '¡El controlador no se encuentra en el procesamiento de integración conectado!'; ka = 'დამმუშავებელი არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде өңдеуші табылмады!'; ro = 'Handler-ul nu a fost găsit în procesarea integrării activate!'; tr = 'Bağlı entegrasyon işlemede işleyici bulunamadı!'; uk = 'Обробник не знайдений у підключеній інтеграційній обробці!'; uz = 'Ishlov beruvchi ulangan integratsiyani qayta ishlashda topilmadi!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не найден свой обработчик <%1> в подключенной интеграционной обработке!';
												|en = 'My handler <%1> was not found in the enabled integration processing!';
												|be = 'Не знойдзены свой апрацоўшчык <%1 > у падключанай інтэграцыйнай апрацоўцы!'; es = '¡No se encontró su controlador <%1 > en el procesamiento de integración conectado!'; ka = 'ჩემი handler <%1> არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде <%1> өңдегіші табылмады!'; ro = 'Handlerul meu <%1> nu a fost găsit în procesarea de integrare activată!'; tr = 'Bağlı entegrasyon işlemede işleyiciniz <%1> bulunamadı!'; uk = 'Не знайдено свого обробника <%1 > у підключеній інтеграційній обробці!'; uz = 'Yoqilgan integratsiyani qayta ishlashda mening ishlovchim <%1 > topilmadi!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли; 			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКлючНастройкиОбработчикаЗаполнения(ИмяЭлемента)
	
	ИмяКлючаНастройки = "";
	
	Если ИмяЭлемента = "Обработчик_ПослеОткрытияФормыДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеОткрытияФормы";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗагрузкойДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияДокумента" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗагрузкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗаполнениемТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗаполненияТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередЗаполнениемСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПередЗаполнениемСтрокиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеЗаполненияСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Загрузка_ПослеЗаполненияСтрокиТЧ";
	КонецЕсли;		
	
	Возврат ИмяКлючаНастройки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияСпискаДокументов1С()
	
	Для каждого Реквизит1С ИЗ СписокРеквизитов1С Цикл
		Если ЗначениеЗаполнено(Реквизит1С.Значение) И НЕ ЗначениеЗаполнено(Реквизит1С.Представление) Тогда
			Реквизит1С.Представление = Реквизит1С.Значение;					
		КонецЕсли;					
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков()
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередЗагрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеЗагрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОткрытияФормы");
	МассивТиповОбъектов.Добавить("ПередЗаполнениемТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияТЧ");
	МассивТиповОбъектов.Добавить("ПередЗаполнениемСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеЗаполненияСтрокиТЧ");

	Возврат МассивТиповОбъектов;
	
КонецФункции

&НаКлиенте
Функция ПроверитьКорректностьЗаполненияПолей()

	КонтрольПройден = Истина;
	
	МассивПроверяемыхКолонок = Новый Массив;
	МассивПроверяемыхКолонок.Добавить("ТипПриемникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ПрЗначение");
	МассивПроверяемыхКолонок.Добавить("ТипИсточникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ИсЗначение");
	
	ИндексыПроверенныхСтрок = Новый Массив;
	Индекс = ТаблицаРеквизитов.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		ОтмеченнаяСтрока = ТаблицаРеквизитов[Индекс];
		
		Если ОтмеченнаяСтрока.Загружать Тогда
			
			// Проверка заполнения полей
			Для Каждого ПроверяемаяКолонка Из МассивПроверяемыхКолонок Цикл
				
				ПроверяемоеЗначение = ОтмеченнаяСтрока[ПроверяемаяКолонка];
				Если Не ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда
					
					#Если Не ТолстыйКлиентОбычноеПриложение Тогда
						
						ЭлементФормы = ЭтаФорма.Элементы.Найти("ТаблицаРеквизитов" + ПроверяемаяКолонка);
						Если ЭлементФормы <> Неопределено Тогда
							ЗаголовокКолонки = ЭлементФормы.Заголовок;
						Иначе
							ЗаголовокКолонки = ПроверяемаяКолонка;
						КонецЕсли;
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Не заполнено значение в колонке %2'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ЗаголовокКолонки);
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = Текст;
						Сообщение.Поле = "ТаблицаРеквизитов[" + Индекс + "]." + ПроверяемаяКолонка;
						Сообщение.УстановитьДанные(ЭтаФорма);
						Сообщение.Сообщить(); 
						
					#Иначе
						
						ЗаголовокКолонки = ТаблицаРеквизитов.Колонки[ПроверяемаяКолонка].Заголовок;
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Не заполнено значение в колонке %2'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ЗаголовокКолонки);
						ПоказатьПредупреждение(, Текст); 
						
					#КонецЕсли
					
					КонтрольПройден = Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
			
			// Проверка дублей
			Если ИндексыПроверенныхСтрок.Найти(Индекс) = Неопределено Тогда
				
				ДублиСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Загружать, ИмяПриемника", Истина,  ОтмеченнаяСтрока.ИмяПриемника));
				Если ДублиСтроки.Количество() > 1 Тогда
					
					КонтрольПройден = Ложь;
					НомераСтрок = "";
					Для каждого ДубльСтроки Из ДублиСтроки Цикл
						
						ИндексДубля = ТаблицаРеквизитов.Индекс(ДубльСтроки);
						ИндексыПроверенныхСтрок.Добавить(ИндексДубля);
						
						Если ИндексДубля <> Индекс Тогда
							
							Если НомераСтрок = "" Тогда
								НомераСтрок = НомераСтрок + (ИндексДубля + 1);
							Иначе
								НомераСтрок = НомераСтрок + ", " + (ИндексДубля + 1);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					#Если Не ТолстыйКлиентОбычноеПриложение Тогда
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Имя приемника «%2» уже используется в строках: %3. Отключите или удалетие дублирующие строки.'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ОтмеченнаяСтрока.ИмяПриемника, НомераСтрок);
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = Текст;
						Сообщение.Поле = "ТаблицаРеквизитов[" + Индекс + "].ПрЗначение";
						Сообщение.УстановитьДанные(ЭтаФорма);
						Сообщение.Сообщить();
						
					#Иначе
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Имя приемника «%2» уже используется в строках: %3. Отключите или удалетие дублирующие строки.'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ОтмеченнаяСтрока.ИмяПриемника, НомераСтрок);
						
						ПоказатьПредупреждение(, Текст); 
						
					#КонецЕсли
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьТиповоеЗначениеНастройки(ИмяНастройки)
	
	ВидОбработчика = ИмяНастройки;
	ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика].Обработчик;
	
	ТиповыеНастройки = Новый Структура;
	ТиповыеНастройки.Вставить(ВидОбработчика);
	ТиповыеНастройки.Вставить(ИмяОбработчика);
	ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
	
	Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		ТиповыеНастройки[ИмяОбработчика] = "";
	КонецЕсли;
	
	// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
	Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
			ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
		КонецЕсли;
	Иначе
		ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
	КонецЕсли;
	
	ЭтаФорма[ВидОбработчика] = ТиповыеНастройки[ВидОбработчика];
	ЭтаФорма[ИмяОбработчика] = ТиповыеНастройки[ИмяОбработчика];
	
	Обработчик_ИзменитьЗначение = Ложь;
	
	ВидОбработчика_ОбработкаПриИзменении(Элементы[ВидОбработчика]);
	Обработчик_ОбработкаПриИзменении(Элементы[ИмяОбработчика]);
	
	Модифицированность = Истина;
	
КонецПроцедуры 

