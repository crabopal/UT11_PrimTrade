	СписокВариантовОбработчиков.Добавить(2, НСтр("ru = 'Свой обработчик';
													|en = 'Your handler'; be = 'Свой апрацоўшчык'; es = 'Su procesador'; ka = 'თქვენი დამმუშავებელი'; kk = 'Оның өңдеушісі'; ro = 'Manipulatorul tău'; tr = 'İşleyicinizi'; uk = 'Свій обробник'; uz = 'Sizning ishlov beruvchingiz'"));
	СписокВариантовОбработчиков.Добавить(3, НСтр("ru = 'Произвольный код';
													|en = 'Custom code'; be = 'Адвольны код'; es = 'Código arbitrario'; ka = 'საბაჟო კოდი'; kk = 'Еркін код'; ro = 'Cod personalizat'; tr = 'Rastgele kod'; uk = 'Довільний код'; uz = 'O''zboshimchalik bilan kod'"));
	
