														|en = 'Fixed 1C banking details'; be = 'Фіксаваны рэквізіт 1С'; es = 'Apoyos fijos 1C'; ka = 'ფიქსირებული 1c საბანკო დეტალები'; kk = '1С бекітілген деректеме'; ro = 'Detalii bancare fixe 1C'; tr = 'Sabit sahne 1C'; uk = 'Фіксований реквізит 1С'; uz = 'Ruxsat etilgan rekvizitlar 1C'"));
