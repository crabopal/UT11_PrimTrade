			НоваяСтрока.СпособСопоставленияСиноним 	= "Поиск по GUID";
			
			НоваяСтрока.ПравилоПоиска			 	= "Равно";
			НоваяСтрока.ПравилоПоискаСиноним		= "Равно или оба пустые";
			НоваяСтрока.ОчищатьПередЗагрузкой		= Ложь;
