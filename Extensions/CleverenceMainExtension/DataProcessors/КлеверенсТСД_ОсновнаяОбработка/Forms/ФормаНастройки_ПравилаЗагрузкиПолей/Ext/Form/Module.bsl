							|en = 'Cleverence: Configuring the loading of fields in the tabular part of the document';
							|be = 'Cleverence: Налада загрузкі палёў таблічнай часткі дакумента'; es = 'Cleverence: configurar la carga de campos de la parte de tabla del documento'; ka = 'კლევერენცია: დოკუმენტის ცხრილის ნაწილში ველების დატვირთვის კონფიგურაცია'; kk = 'Cleverence: құжаттың кестелік бөлігінің өрістерін жүктеуді орнату'; ro = 'Cleverence: Configurarea încărcării câmpurilor în partea tabelară a documentului'; tr = 'Cleverence: Belgenin tablo bölümündeki alanların yüklenmesini yapılandırma'; uk = 'Cleverence: налаштування завантаження полів табличній частині документа'; uz = 'Aniqlik: hujjatning jadval qismining maydonlarini yuklashni Sozlash'");
