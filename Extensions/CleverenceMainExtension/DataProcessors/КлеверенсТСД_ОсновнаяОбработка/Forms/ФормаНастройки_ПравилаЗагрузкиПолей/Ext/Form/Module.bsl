			Для Каждого ЭлементСписка Из СписокТаблицДляСвязиПоКлючу Цикл
				мСписокРеквизитовMS.Добавить(Новый Структура("Значение,Ключ,Uni,Имя",ЭлементСписка.Представление, "Ключ связи для """+ЭлементСписка.Представление+"""","", ЭлементСписка.Представление));
			КонецЦикла;
			// - ZHKN 03.10.2017
			СписокРеквизитовMS = Новый ФиксированныйМассив(мСписокРеквизитовMS);
		Иначе	
			СписокРеквизитовMS = Новый ФиксированныйМассив(ДополнительнаяТаблица.Значение);	
		КонецЕсли;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
			Элементы.ПанельОбработчикПослеОткрытияФормыДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
		#Иначе	
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;
			Элементы.РамкаОбработчикПослеОткрытияФормыДокумента.Видимость = Ложь;
		#КонецЕсли
		
		ИмяТабличнойЧасти1ССиноним = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].ТабличныеЧасти[ИмяТабличнойЧасти1С].Синоним;
		ИмяТабличнойЧастиMSСиноним = ИмяТабличнойЧастиMS;
		
		СписокПравилПоиска.Добавить("Равно", НСтр("ru = 'Равно или оба пустые';
													|en = 'Equal or both are empty'; be = 'Роўна або абодва пустыя'; es = 'Igual o ambos vacíos'; ka = 'თანაბარი ან ორივე ცარიელია'; kk = 'Тең немесе екеуі де бос'; ro = 'Egal sau ambele sunt goale'; tr = 'Eşit mi yoksa her ikisi de boş mu'; uk = 'Дорівнює або обидва порожні'; uz = 'Teng yoki ikkalasi ham bo''sh'"));
		СписокПравилПоиска.Добавить("РавноПусто1С", НСтр("ru = 'Равно или в 1С пусто';
															|en = 'Equal to or empty in 1C'; be = 'Роўна або ў 1С пуста'; es = 'Igual o en 1C está vacío'; ka = 'ტოლი ან ცარიელი 1C-ში'; kk = 'Тең немесе 1С бос'; ro = 'Egal sau gol în 1C'; tr = 'Eşit veya 1c''de boş'; uk = 'Дорівнює або в 1С порожньо'; uz = 'Teng yoki 1C bo''sh'"));
		СписокПравилПоиска.Добавить("РавноПустоТСД", НСтр("ru = 'Равно или на ТСД пусто';
															|en = 'Equal to or to the Mobile device is empty'; be = 'Роўна або на мабільную прыладу пуста'; es = 'Igual o en el dispositivo Móvil está vacío'; ka = 'ტოლია ან მობილური მოწყობილობის ცარიელია'; kk = 'Тең немесе мобильді құрылғы бос'; ro = 'Egal cu sau la dispozitivul mobil este gol'; tr = 'Mobil cihaza eşit veya boş'; uk = 'Дорівнює або на мобільний пристрій порожньо'; uz = 'Mobil qurilmaga teng yoki bo''sh'"));
		
	КонецЕсли;
	
	ОбновитьПредставленияСпискаДокументов1С();
	
	ОбновитьСписокПроизвольныхКодов();
	
	// Список Глобальных параметров
	ТаблицаГлобальныхПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ГлобальныеПараметры", Новый Структура());
	
