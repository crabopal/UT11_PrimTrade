/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ДанныеДокументаMS Экспорт,
	РеквизитыСерий Экспорт,
	СписокДокументовТСД Экспорт,
	ТаблицаДляПечати Экспорт,
	ТаблицаНовыхШтрихкодов Экспорт,
	ПараметрыПорционнойВыгрузки,
	ШапкаДокументаСписка Экспорт;
	
&НаКлиенте
Перем МетаданныеДокументаMS;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии()
	
	СтруктураМетаданных = _ЛокКонтекст.СтруктураМетаданных;
	МетаданныеДокументаMS = СтруктураМетаданных.ДокументыMS[ТипДокументаMS];
	
	ДанныеДокументаMS = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеДокументаMS(Ид, ТипДокументаMS);
	ПараметрыПорционнойВыгрузки = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыСправочниковДляПорционнойВыгрузки();
	
	СоздатьТаблицуНовыхШтрихкодов();
	СоздатьДополнительныеКолонкиТаблицДокумента(ДанныеДокументаMS);
	
	Заполнить_ШапкуДокумента();
	ЗаполнитьТаблицыДокумента();
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаСтраницы.Страницы.ГруппаСерийныеНомера.Видимость = ТаблицаСерийныеНомера.Количество() > 1;
		Если СтрокиФакт.Количество() > 1 Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.Страницы.ГруппаФакт;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаСерийныеНомера.Видимость = ТаблицаСерийныеНомера.Количество() > 1;
		Если СтрокиФакт.Количество() > 1 Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаФакт;
		КонецЕсли;
	#КонецЕсли
	ВывестиДопТаблицы();
	
	Для Каждого СтрокаТЧ Из СтрокиФакт Цикл
		СтрокаТЧ.Флаг = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФорм

// Запрашивает подтверждение возврата просматриваемого документа SMARTS в работу.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура ВернутьДокументВРаботу(Команда)
	
	Если ШапкаДокументаСписка <> Неопределено Тогда
		ШапкаДляВозврата = ШапкаДокументаСписка;
	Иначе
		ШапкаДляВозврата = ДанныеДокументаMS.ШапкаДокумента;
	КонецЕсли;
	
	ПараметрыВозврата = _ЛокКонтекст.ЛокЯдро_ВозвратДокументаВРаботу_СтруктураПараметровВызова();
	ПараметрыВозврата.ИдДокумента = Ид;
	ПараметрыВозврата.ШапкаДокумента = ШапкаДляВозврата;
	ПараметрыВозврата.ТипБазы = Неопределено;
	ПараметрыВозврата.ОповещениеОбработкиЗавершения = Новый ОписаниеОповещения("ВозвратДокументаВРаботу_Завершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ВозвратДокументаВРаботу_Начало(ПараметрыВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДокумент(Команда)
	
	ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельФормыПросмотретьШапку(Кнопка)
	
	ПоказатьДанныеДокументаMS("Шапка документа Клеверенс", ДанныеДокументаMS.ШапкаДокумента)	
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПросмотретьНовыеТоварыИШтрихКодыНажатие(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ЗагрузкаНовыхШтрихкодов = ПолучитьФорму("ОФ_ФормаСлужебная_ЗагрузкаНовыхШтрихкодов",ЭтаФорма);
	#Иначе
		ФормаСлужебная_ЗагрузкаНовыхШтрихкодов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ЗагрузкаНовыхШтрихкодов", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ЗагрузкаНовыхШтрихкодов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаСлужебная_ЗагрузкаНовыхШтрихкодов.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ЗагрузкаНовыхШтрихкодов._ЛокКонтекст = _ЛокКонтекст;
	
	ОП = Новый ОписаниеОповещения("ЗагрузкаНовыхШтрихкодовЗакрытие", ЭтаФорма);
	ФормаСлужебная_ЗагрузкаНовыхШтрихкодов.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ЗагрузкаНовыхШтрихкодов.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ЗагрузкаНовыхШтрихкодов.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПланВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекДанные = ВыбраннаяСтрока;
	#Иначе
		ТекДанные = СтрокиПлан.НайтиПоИдентификатору(ВыбраннаяСтрока);
	#КонецЕсли
	ПоказатьДанныеДокументаMS("Строка-план документа Клеверенс", _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ДанныеДокументаMS.СтрокиПлан,"КлючСвязиСтроки",ТекДанные.КлючСвязиСтроки));	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиФактВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекДанные = ВыбраннаяСтрока;
	#Иначе
		ТекДанные = СтрокиФакт.НайтиПоИдентификатору(ВыбраннаяСтрока);
	#КонецЕсли
	ПоказатьДанныеДокументаMS("Строка-факт документа Клеверенс", _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ДанныеДокументаMS.СтрокиФакт,"КлючСвязиСтроки",ТекДанные.КлючСвязиСтроки));	
КонецПроцедуры

&НаКлиенте
Процедура СовмещенныеСтрокиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекДанные = ВыбраннаяСтрока;
	#Иначе
		ТекДанные = СовмещенныеСтроки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	#КонецЕсли
	ПоказатьДанныеДокументаMS("Совмещенная строка документа Клеверенс", _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ДанныеДокументаMS.СовмещенныеСтроки,"КлючСвязиСтроки",ТекДанные.КлючСвязиСтроки));	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСерийныеНомераВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТекДанные = ВыбраннаяСтрока;
	#Иначе
		ТекДанные = ТаблицаСерийныеНомера.НайтиПоИдентификатору(ВыбраннаяСтрока);
	#КонецЕсли
	ПоказатьДанныеДокументаMS("Строка-план документа Клеверенс", _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ДанныеДокументаMS.СтрокиСерийныеНомера,"КлючСвязиСтроки",ТекДанные.КлючСвязиСтроки));
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена(ЗагрузитьВОдин = Ложь, ВыбратьБизнесПроцесс = Ложь)
	
	Если ШапкаДокументаСписка = Неопределено Тогда
		ВызватьИсключение("Не удалось получить данные документа.
		|Откройте просмотр документа повторно.");
	КонецЕсли;
	
	СтрокиДокументов = Новый Массив;
	СтрокиДокументов.Добавить(ШапкаДокументаСписка);
	
	ОП = Новый ОписаниеОповещения("ЗагрузкаДокументов_ОповещениеОбработкиЗавершения", ЭтаФорма);
	
	ПараметрыВызова 								= _ЛокКонтекст.ЛокЯдро_ЗагрузкаДокументов_СтруктураПараметровВызова();
	ПараметрыВызова.ID_Узла 						= ID_Узла;
	ПараметрыВызова.ЗагрузитьВОдин 					= ЗагрузитьВОдин;
	ПараметрыВызова.ВыбратьБизнесПроцесс 			= ВыбратьБизнесПроцесс;
	ПараметрыВызова.ОповещениеОбработкиЗавершения 	= ОП;
	ПараметрыВызова.ОповещениеОбработкиОшибки 		= ОП;
	ПараметрыВызова.Форма 							= ЭтаФорма;
	
	_ЛокКонтекст.ЛокЯдро_ЗагрузкаДокументов_ЗагрузитьИзОкнаОбмена(СтрокиДокументов, ПараметрыВызова);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаДокументов_ОповещениеОбработкиЗавершения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив")
		И Результат.Количество() = 1 Тогда
		
		РезультатЗагрузки = Результат[0].Результат;
		
		Если РезультатЗагрузки.Свойство("Статус") 
			И РезультатЗагрузки.Статус = Истина Тогда
			Оповестить("ЗаполнитьТаблицуДокументовSMARTS");
			Закрыть();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

// Завершает обновление формы просмотра после возврата SMARTS-документа в работу.
//
// Параметры:
//  ДокументВозвращен - Булево - Истина, если шапка документа обновлена.
//  ДополнительныеПараметры - Структура, Неопределено - прочие параметры
//
&НаКлиенте
Процедура ВозвратДокументаВРаботу_Завершение(ДокументВозвращен, ДополнительныеПараметры) Экспорт
	
	Если ДокументВозвращен Тогда
		Если ШапкаДокументаСписка <> Неопределено Тогда
			ШапкаДокументаСписка.Вставить("Завершен", Ложь);
			ШапкаДокументаСписка.Вставить("ВОбработке", Ложь);
		КонецЕсли;
		
		Если ДанныеДокументаMS <> Неопределено
			И ДанныеДокументаMS.Свойство("ШапкаДокумента") Тогда
			ДанныеДокументаMS.ШапкаДокумента.Вставить("Завершен", Ложь);
			ДанныеДокументаMS.ШапкаДокумента.Вставить("ВОбработке", Ложь);
		КонецЕсли;
		
		Заполнить_ШапкуДокумента();
		Оповестить("ЗаполнитьТаблицуДокументовSMARTS");
	Иначе
		пСообщение = НСтр("ru = 'Не удалось вернуть документ в работу.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитДанныеПослеПривязкиШК()
	
	ОбновитьДанныеПослеПривязкиШКвТаблице(СтрокиПлан);
	ОбновитьДанныеПослеПривязкиШКвТаблице(СтрокиФакт);
	ОбновитьДанныеПослеПривязкиШКвТаблице(СовмещенныеСтроки);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПослеПривязкиШКвТаблице(Таблица)
		
	Для Каждого СтрокаТаблицы Из Таблица Цикл	
		
		Если СтрокаТаблицы.ИдТовара <> "*" И Лев(ВРег(СтрокаТаблицы.ИдУпаковки), 3) <> "NEW" Тогда
			Продолжить;	
		КонецЕсли;
		
		ДанныеШК = _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеШтрихКода(СтрокаТаблицы.ШК);
		
		Если Не ЗначениеЗаполнено(ДанныеШК) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеШК.Свойство("Владелец") 
			И ДанныеШК.Владелец <> Неопределено Тогда
			СтрокаТаблицы.Номенклатура = ДанныеШК.Владелец;
			СтрокаТаблицы.ИдТовара = Строка(ДанныеШК.Владелец.УникальныйИдентификатор());	
		КонецЕсли;
		
		Если ДанныеШК.Свойство("ЕдиницаИзмерения")
			И ДанныеШК.ЕдиницаИзмерения <> Неопределено Тогда
			СтрокаТаблицы.ИдУпаковки = ДанныеШК.ЕдиницаИзмерения.Наименование;	
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Заполнить_ШапкуДокумента()
	
	Если ДанныеДокументаMS = Неопределено Тогда
		ВызватьИсключение("Не удалось получить данные документа.
		|Проверьте подключение к базе Клеверенс.");
	КонецЕсли;
	
	Для Каждого РеквизитШапки Из ДанныеДокументаMS.ШапкаДокумента Цикл
		Если Элементы.Найти(РеквизитШапки.Ключ) <> Неопределено Тогда
			ЭтаФорма[РеквизитШапки.Ключ] = РеквизитШапки.Значение;
		КонецЕсли;
	КонецЦикла;
	
	пШапкаДокумента = Новый Структура("Завершен,ВОбработке,СозданНаТСД,СтрокиФактКоличество,КонтрольКоличества,ЕстьПереполнениеИлиНедобор");
	
	Если ШапкаДокументаСписка <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(пШапкаДокумента, ШапкаДокументаСписка);
	Иначе
		ЗаполнитьЗначенияСвойств(пШапкаДокумента, ДанныеДокументаMS.ШапкаДокумента);
	КонецЕсли;
	
	СостояниеДокументаВРаботе = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(80, 70, 160),
		Новый Цвет(230, 230, 250),
		НСтр("ru = 'В работе';
				|en = 'At work'; be = 'У працы'; es = 'En el trabajo'; ka = 'სამსახურში'; kk = 'Жұмыста'; ro = 'La locul de muncă'; tr = 'İş yerinde'; uk = 'В роботі'; uz = 'Ishda'"));
				
	СостояниеДокументаВыгружен = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(51, 51, 51),
		Новый Цвет(240, 240, 240),
		НСтр("ru = 'Выгружен';
				|en = 'Uploaded'; be = 'Выгружаць'; es = 'Descargaste'; ka = 'ატვირთული'; kk = 'Түсірілді'; ro = 'Încărcat'; tr = 'Boşaltılırdı'; uk = 'Вивантажувати'; uz = 'Yuklangan'"));
				
	СостояниеДокументаЗавершен = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(46, 125, 50),
		Новый Цвет(216, 251, 216),
		НСтр("ru = 'Завершен';
				|en = 'Completed'; be = 'Завершаны'; es = 'Completo'; ka = 'დასრულდა'; kk = 'Аяқталды'; ro = 'Finalizat'; tr = 'Tamamlandı'; uk = 'Завершений'; uz = 'Tugallandi'"));
				
	СостояниеДокументаЗавершенНеИзменен = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(117, 92, 0),
		Новый Цвет(255, 255, 222),
		НСтр("ru = 'Завершен, не изменен';
				|en = 'Completed, not modified'; be = 'Завершаны, ня зменены'; es = 'Completado, no modificado'; ka = 'დასრულდა, არ შეცვლილა'; kk = 'Аяқталған, өзгертілмеген'; ro = 'Completat, nemodificat'; tr = 'Tamamlandı, değiştirilmedi'; uk = 'Завершено, не змінено'; uz = 'Tugallangan, o''zgartirilmagan'"));
				
	СостояниеДокументаЗавершенЕстьРасхождения = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(198, 40, 40),
		Новый Цвет(255, 227, 227),
		НСтр("ru = 'Завершен, есть расхождения';
				|en = 'Completed, there are discrepancies'; be = 'Завершаны, ёсць разыходжанні'; es = 'Terminado, hay discrepancias'; ka = 'დასრულდა, არსებობს შეუსაბამობები'; kk = 'Аяқталды, сәйкессіздіктер бар'; ro = 'Finalizat, există discrepanțe'; tr = 'Tamamlandı, tutarsızlıklar var'; uk = 'Завершено, є розбіжності'; uz = 'Tugallangan, farqlar mavjud'"));
				
	СостояниеДокументаЗавершенБезРасхождений = Новый Структура("ЦветТекста,ЦветФона,Состояние",
		Новый Цвет(46, 125, 50),
		Новый Цвет(216, 251, 216),
		НСтр("ru = 'Завершен, без расхождений';
				|en = 'Completed, no discrepancies'; be = 'Завершаны, без разыходжанняў'; es = 'Completado, sin discrepancias'; ka = 'დასრულდა, შეუსაბამობები არ არის'; kk = 'Аяқталды, сәйкессіздіктер жоқ'; ro = 'Finalizat, fără discrepanțe'; tr = 'Tutarsızlık olmadan tamamlandı'; uk = 'Завершено, без розбіжностей'; uz = 'To''liq, kelishmovchiliklarsiz'"));
		
	Элементы.ВернутьДокументВРаботу.Доступность = Истина;
	Элементы.ЗагрузитьДокумент.Доступность = Истина;
	
	// Состояние
	Если пШапкаДокумента.Завершен = Истина Тогда
		Если пШапкаДокумента.СозданНаТСД = Истина Тогда
			СостояниеДокумента = СостояниеДокументаЗавершен;
		Иначе
			Если пШапкаДокумента.СтрокиФактКоличество = 0 Тогда
				СостояниеДокумента = СостояниеДокументаЗавершенНеИзменен;
			Иначе
				Если пШапкаДокумента.КонтрольКоличества = Истина Тогда
					Если пШапкаДокумента.ЕстьПереполнениеИлиНедобор = Истина Тогда
						СостояниеДокумента = СостояниеДокументаЗавершенЕстьРасхождения;
					Иначе
						СостояниеДокумента = СостояниеДокументаЗавершенБезРасхождений;
					КонецЕсли;
				Иначе
					СостояниеДокумента = СостояниеДокументаЗавершен;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли пШапкаДокумента.ВОбработке = Истина Тогда
		СостояниеДокумента = СостояниеДокументаВРаботе;
		Элементы.ЗагрузитьДокумент.Доступность = Ложь;
	Иначе
		СостояниеДокумента = СостояниеДокументаВыгружен;
		Элементы.ВернутьДокументВРаботу.Доступность = Ложь;
		Элементы.ЗагрузитьДокумент.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.Состояние.Заголовок = СостояниеДокумента.Состояние;
	Элементы.Состояние.ЦветТекста = СостояниеДокумента.ЦветТекста;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.СостояниеФон.ЦветФона = СостояниеДокумента.ЦветФона;
	#Иначе
		Элементы.ГруппаСостояние.ЦветФона = СостояниеДокумента.ЦветФона;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицыДокумента()
	
	МетаданныеНСИ = _ЛокКонтекст.ЛокЯдро_ПолучитьМетаданныеНСИ();
	
	Если МетаданныеНСИ = Неопределено Тогда
		ВызватьИсключение("Не удалось получить метаданные конфигурации.
		|Проверьте подключение интеграционной обработки.");
	КонецЕсли;
	
	НоменклатураИменаСправочников = Новый Массив;
	НоменклатураИменаСправочников.Добавить(МетаданныеНСИ.Номенклатура.ИмяСправочника);
	Если ПараметрыПорционнойВыгрузки <> Неопределено Тогда
		ПараметрыНоменклатуры = ПараметрыПорционнойВыгрузки.Получить("Номенклатура");
		Если ПараметрыНоменклатуры <> Неопределено Тогда
			НоменклатураИменаСправочников = ПараметрыНоменклатуры.ИменаСправочников;
		КонецЕсли;
	КонецЕсли;
	
	ИмяСправочникаЕИ = МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника;
	
	Если МетаданныеНСИ.Номенклатура.Свойство("БазоваяЕдиницаИзмерения") Тогда
		МассивЕИ = Новый Массив;
		МассивЕИ.Добавить(ИмяСправочникаЕИ);
		МассивЕИ.Добавить(МетаданныеНСИ.Номенклатура.БазоваяЕдиницаИзмерения.ИмяСправочника);
		ИмяСправочникаЕИ = МассивЕИ;
	КонецЕсли;	
	
	_ЛокКонтекст.КэшЗначенийПолученныхПоID = Новый Соответствие;
	
	////////////////////////////////////////////////////////////////////////////////
	//СтрокиПлан
	Для Каждого СтрокаДокумента Из ДанныеДокументаMS.СтрокиПлан Цикл
		Если СтрокаДокумента.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьСтрокуТаблицыДокумента(СтрокаДокумента, МетаданныеНСИ, ИмяСправочникаЕИ, НоменклатураИменаСправочников);
		ЗаполнитьЗначенияСвойств(СтрокиПлан.Добавить(), СтрокаДокумента);
	КонецЦикла;

	////////////////////////////////////////////////////////////////////////////////
	//СтрокиФакт
	Для Каждого СтрокаДокумента Из ДанныеДокументаMS.СтрокиФакт Цикл
		Если СтрокаДокумента.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьСтрокуТаблицыДокумента(СтрокаДокумента, МетаданныеНСИ, ИмяСправочникаЕИ, НоменклатураИменаСправочников);
		ЗаполнитьЗначенияСвойств(СтрокиФакт.Добавить(), СтрокаДокумента);

		Если СтрокаДокумента.ИдТовара = "*"
			ИЛИ Лев(ВРег(СтрокаДокумента.ИдУпаковки), 3) = "NEW" Тогда
			
			ЯзыкПлатформыMS =
				_ЛокКонтекст.ЛокЯдро_ЯзыкПлатформыMS();
			Если ЯзыкПлатформыMS = "EN" Тогда
				ИмяПоляИмяНеизвестного = "UnknownName";
			Иначе
				ИмяПоляИмяНеизвестного = "ИмяНеизвестного";
			КонецЕсли;
			
			СтрокаШК = Новый Структура();
			СтрокаШК.Вставить("Штрихкод", 			ШтрихкодТСД(СтрокаДокумента, ЯзыкПлатформыMS));
			СтрокаШК.Вставить("ИмяНеизвестного", 	СтрокаДокумента[ИмяПоляИмяНеизвестного]);
			СтрокаШК.Вставить("Номенклатура", 		СтрокаДокумента.Номенклатура);
			СтрокаШК.Вставить("Упаковка", 			СтрокаДокумента.Упаковка);
			СтрокаШК.Вставить("Характеристика", 	СтрокаДокумента.Характеристика);

			ТаблицаНовыхШтрихкодов.Добавить(СтрокаШК);

		КонецЕсли;
	КонецЦикла;

	////////////////////////////////////////////////////////////////////////////////
	//СовмещенныеСтроки
	Для Каждого СтрокаДокумента Из ДанныеДокументаMS.СовмещенныеСтроки Цикл
		Если СтрокаДокумента.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьСтрокуТаблицыДокумента(СтрокаДокумента, МетаданныеНСИ, ИмяСправочникаЕИ, НоменклатураИменаСправочников);
		ЗаполнитьЗначенияСвойств(СовмещенныеСтроки.Добавить(), СтрокаДокумента);
	КонецЦикла;	

	_ЛокКонтекст.КэшЗначенийПолученныхПоID = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокуТаблицыДокумента(СтрокаДокумента, МетаданныеНСИ, ИмяСправочникаЕИ, НоменклатураИменаСправочников)
	
	СтрокаДокумента.Вставить("КлючСвязиСтроки", Строка(Новый УникальныйИдентификатор()));
	
	Если СтрокаДокумента.ИдТовара <> "*" Тогда
		Попытка
			СтрокаДокумента.Вставить("Номенклатура", _ЛокКонтекст.ЛокЯдро_ПолучитьЗначениеСправочникаПоID(НоменклатураИменаСправочников, СтрокаДокумента.ИдТовара));
		Исключение
		КонецПопытки;
	Иначе
		СтрокаДокумента.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник."
		+ МетаданныеНСИ.Номенклатура.ИмяСправочника + ".ПустаяСсылка"));
	КонецЕсли;
	
	Попытка			
		Если ЗначениеЗаполнено(СтрокаДокумента.ИдЕдиницыИзмерения) И СтрДлина(СтрокаДокумента.ИдЕдиницыИзмерения) = 36 Тогда
			пУпаковка = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаЕИ, СтрокаДокумента.ИдЕдиницыИзмерения);
		ИначеЕсли ТипЗнч(СтрокаДокумента.ИдУпаковки) = Тип("Строка") И СтрДлина(СтрокаДокумента.ИдУпаковки) = 36 Тогда
			пУпаковка = _ЛокКонтекст.ЛокЯдро_ПолучитьЗначениеСправочникаПоID(ИмяСправочникаЕИ, СтрокаДокумента.ИдУпаковки);				
		Иначе
			пУпаковка = ПредопределенноеЗначение("Справочник." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника + ".ПустаяСсылка");
		КонецЕсли;
	Исключение
		пУпаковка = ПредопределенноеЗначение("Справочник." + МетаданныеНСИ.ЕдиницыИзмерения.ИмяСправочника + ".ПустаяСсылка");
	КонецПопытки;
	СтрокаДокумента.Вставить("Упаковка", пУпаковка);
	
	Если МетаданныеНСИ.Свойство("Характеристики") Тогда
		Если СтрокаДокумента.Свойство("ИдХарактеристики") И ЗначениеЗаполнено(СтрокаДокумента.ИдХарактеристики) Тогда
			Попытка
				СтрокаДокумента.Вставить("Характеристика", _ЛокКонтекст.ЛокЯдро_ПолучитьЗначениеСправочникаПоID(МетаданныеНСИ.Характеристики.ИмяСправочника, СтрокаДокумента.ИдХарактеристики));
			Исключение
			КонецПопытки
		Иначе
			СтрокаДокумента.Вставить("Характеристика", ПредопределенноеЗначение("Справочник."
			+ МетаданныеНСИ.Характеристики.ИмяСправочника + ".ПустаяСсылка"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанныеДокументаMS(ДанныеЗаголовка, ДанныеДляПоказа) 
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаПросмотра_РазделДокументаMS = ПолучитьФорму("ОФ_ФормаПросмотра_РазделДокументаMS", ЭтаФорма);
	#Иначе
		ФормаПросмотра_РазделДокументаMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаПросмотра_РазделДокументаMS", , ЭтаФорма, ЭтаФорма);
		ФормаПросмотра_РазделДокументаMS.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаПросмотра_РазделДокументаMS.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаПросмотра_РазделДокументаMS.ДанныеЗаголовка = ДанныеЗаголовка;
	ФормаПросмотра_РазделДокументаMS.ДанныеДляПоказа = ДанныеДляПоказа;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаПросмотра_РазделДокументаMS.ОткрытьМодально();
	#Иначе
		ФормаПросмотра_РазделДокументаMS.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТаблицуНовыхШтрихкодов()
	
	ТаблицаНовыхШтрихкодов = Новый Массив;
	ТаблицаНовыхШтрихкодов.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Штрихкод,Номенклатура,Характеристика,Упаковка,Записывать,ТипШтрихкода,ИмяНеизвестного"));			
	
КонецПроцедуры	

&НаКлиенте
Процедура ПечатьЦенниковНажатие(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница 		= Элементы.ГруппаСтраницы.Страницы.ГруппаПлан Тогда
