// Возвращает значение штрихкода из строки документа ТСД
&НаКлиентеНаСервереБезКонтекста
Функция ШтрихкодТСД(СтрокаТСД, ЯзыкПлатформыMS = "RU") 

	Перем ШтрихкодТСД;
	
	Если ТипЗнч(СтрокаТСД) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЯзыкПлатформыMS = "EN" Тогда
		ИмяПоля = "NewBarcode";
	Иначе
		ИмяПоля = "НовШК";
	КонецЕсли;
		
	ШтрихкодТСД = ?(СтрокаТСД.Свойство(ИмяПоля, ШтрихкодТСД), ШтрихкодТСД, "");
	
	Возврат СокрЛП(ШтрихкодТСД);
	
КонецФункции

&НаКлиенте
Процедура ВывестиДопТаблицы()
	
	//Получение значений доп таблиц
	СтруктураАдресовТаблиц = ПолучитьДопТаблицы();
	
	//Создание реквизитов и элементов формы
	СоздатьЭлементыОтображенияДопТаблиц(СтруктураАдресовТаблиц);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДопТаблицы()
	
	СтруктураМетаданных 	= _ЛокКонтекст.СтруктураМетаданных;
	СтруктураТаблицMS		= СтруктураМетаданных.Tables;
	СтруктураДокументаMS 	= СтруктураМетаданных.ДокументыMS[ТипДокументаMS];
	
	МассивИменДопТаблиц = Новый Массив;

	//Сначала проверяем наличие в документе таблиц с такими же именами, как и в таблицах Клеверенс 
	Для Каждого ТаблицаMS Из СтруктураТаблицMS Цикл
		
		ИмяТаблицыMS = ТаблицаMS.Представление;
		Если ДанныеДокументаMS.Свойство(ИмяТаблицыMS) Тогда
			МассивИменДопТаблиц.Добавить(ИмяТаблицыMS);		
		КонецЕсли;
		
	КонецЦикла;
	
	//Затем проверяем наличие доп таблиц документа
	Для каждого ДопТаблица Из СтруктураДокументаMS.ДополнительныеТаблицы Цикл
		
		ИмяДопТаблицы = ДопТаблица.Представление;
		МассивИменДопТаблиц.Добавить(ИмяДопТаблицы);
		
	КонецЦикла;
	
	СтруктураАдресовТаблиц = Новый Структура;
	
	Для каждого ИмяДопТаблицы Из МассивИменДопТаблиц Цикл
	
		МассивСтрокДопТаблицы 	= ДанныеДокументаMS[ИмяДопТаблицы];		
		
		СтруктураВызова = Новый Структура;
		СтруктураВызова.Вставить("ТипМетода", "Функция");
		СтруктураВызова.Вставить("ИмяМетода", "МассивСтруктурВТаблицуЗначений");
		СтруктураВызова.Вставить("ПараметрыМетода", Новый Структура("МассивСтруктур", МассивСтрокДопТаблицы));
		
		//Преобразование массива структур в таблицу значений
		Попытка
			АдресТаблицыВХранилище = _ЛокКонтекст.Транзит_ВызватьГлобальныйМетодНаКлиенте(СтруктураВызова, Истина);
		Исключение
			АдресТаблицыВХранилище = "";
			Сообщение = НСтр("ru = 'Не удалось отобразить данные доп таблицы';
								|en = 'Additional table data could not be displayed'; be = 'Не ўдалося адлюстраваць дадзеныя доп табліцы'; es = 'No se pueden Mostrar los datos de la tabla DOP'; ka = 'დამატებითი ცხრილის მონაცემების ჩვენება ვერ მოხერხდა'; kk = 'Қосымша кесте деректерін көрсету мүмкін болмады'; ro = 'Datele suplimentare din tabel nu au putut fi afișate'; tr = 'Ek tablo verileri görüntülenemedi'; uk = 'Не вдалося відобразити дані доп таблиці'; uz = 'Qo''shimcha jadval ma''lumotlarini ko''rsatish mumkin emas'");
			Сообщить(Сообщение); 
		КонецПопытки;

		СтруктураАдресовТаблиц.Вставить(ИмяДопТаблицы, АдресТаблицыВХранилище);
				
	КонецЦикла;
	
	Возврат СтруктураАдресовТаблиц;
	
КонецФункции

&НаСервере
Процедура СоздатьЭлементыОтображенияДопТаблиц(СтруктураАдресовТаблиц)
	
	ИмяСобытия = "СоздатьЭлементыОтображенияДопТаблиц";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		СтруктураДопТаблиц 				= Новый Структура;
		МассивРеквизитов 				= Новый Массив;
		УстановитьТекущуюСтраницуПанели = Ложь;
		
		Для Каждого ЭлементСтруктуры Из СтруктураАдресовТаблиц Цикл

			ИмяДопТаблицы = ЭлементСтруктуры.Ключ;
			АдресДопТаблицы = ЭлементСтруктуры.Значение;
			Если Не ЭтоАдресВременногоХранилища(АдресДопТаблицы) Тогда
				Продолжить;
			КонецЕсли;
			
			ДопТаблицаЗначений = ПолучитьИзВременногоХранилища(АдресДопТаблицы);
			
			Если Не ЗначениеЗаполнено(ДопТаблицаЗначений) Тогда
				Продолжить;
			КонецЕсли;

			НоваяГруппа = ЭлементыФормы.ГруппаСтраницы.Страницы.Добавить("Группа" + ИмяДопТаблицы, ИмяДопТаблицы);
			
			ЭлементыФормы.ГруппаСтраницы.ТекущаяСтраница = НоваяГруппа;
						
			НовоеТабличноеПоле	= ЭлементыФормы.Добавить(Тип("ТабличноеПоле"), "Таблица" + ИмяДопТаблицы, Истина, ЭлементыФормы.ГруппаСтраницы);
			
			НовоеТабличноеПоле.Верх 	= 6;
			НовоеТабличноеПоле.Лево 	= 6;
			НовоеТабличноеПоле.Ширина 	= ЭлементыФормы.ГруппаСтраницы.Ширина - 1;
			НовоеТабличноеПоле.Высота 	= ЭлементыФормы.ГруппаСтраницы.Высота - 1;

			НовоеТабличноеПоле.УстановитьПривязку(
				ГраницаЭлементаУправления.Право,
				ЭлементыФормы.ГруппаСтраницы,
				ГраницаЭлементаУправления.Право);
				
			НовоеТабличноеПоле.УстановитьПривязку(
				ГраницаЭлементаУправления.Низ,
				ЭлементыФормы.ГруппаСтраницы,
				ГраницаЭлементаУправления.Низ);

			НовоеТабличноеПоле.Значение = ДопТаблицаЗначений;
			НовоеТабличноеПоле.СоздатьКолонки();
			
			УстановитьТекущуюСтраницуПанели = Истина;
			
		КонецЦикла;
		
		Если УстановитьТекущуюСтраницуПанели Тогда
			ЭлементыФормы.ГруппаСтраницы.ТекущаяСтраница = ЭлементыФормы.ГруппаСтраницы.Страницы.Получить(0);
		КонецЕсли;
		
	#Иначе
		
		СтруктураДопТаблиц = Новый Структура;
		МассивРеквизитов = Новый Массив;
		
		Для Каждого ЭлементСтруктуры Из СтруктураАдресовТаблиц Цикл
			
			ИмяДопТаблицы 	= ЭлементСтруктуры.Ключ;
			АдресДопТаблицы = ЭлементСтруктуры.Значение;
			Если Не ЭтоАдресВременногоХранилища(АдресДопТаблицы) Тогда
				Продолжить;
			КонецЕсли;
			
			ДопТаблицаЗначений = ПолучитьИзВременногоХранилища(АдресДопТаблицы);
			
			Если Не ЗначениеЗаполнено(ДопТаблицаЗначений) Тогда
				Продолжить;
			КонецЕсли;
			
			//Поместим в значение элемента структуры полученную из хранилища таблицу значений
			СтруктураДопТаблиц.Вставить(ИмяДопТаблицы, ДопТаблицаЗначений);
			
			НовыйРеквизитТаблица = Новый РеквизитФормы(ИмяДопТаблицы, Новый ОписаниеТипов("ТаблицаЗначений"));
			МассивРеквизитов.Добавить(НовыйРеквизитТаблица);
			
			//МассивРеквизитовДопТаблиц.Добавить(НовыйРеквизитТаблица);
			
			Для Каждого Колонка Из ДопТаблицаЗначений.Колонки Цикл
				
				МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ИмяДопТаблицы, Колонка.Имя));
				
			КонецЦикла;
			
		КонецЦикла;
		
		ИзменитьРеквизиты(МассивРеквизитов);
		
		//Элементы = ЭтаФорма.Элементы;
		
		Для Каждого ЭлементСтруктуры Из СтруктураДопТаблиц Цикл
			
			ИмяДопТаблицы = ЭлементСтруктуры.Ключ;
			ДопТаблицаЗначений = ЭлементСтруктуры.Значение;
			
			ИмяГруппы 	= "Группа" + ИмяДопТаблицы;
			ИмяТаблицы 	= "Таблица" + ИмяДопТаблицы;
			
			Если Элементы.Найти(ИмяГруппы) <> Неопределено
				Или Элементы.Найти(ИмяТаблицы) <> Неопределено Тогда
				Комментарий = НСтр("ru = 'Ошибка отображения данных доп таблицы %1, т.к. создан элемент формы с аналогичным именем';
									|en = 'Error in displaying additional table data %1, because a form element with the same name was created';
									|be = 'Памылка адлюстравання дадзеных доп табліцы %1, бо створаны элемент формы з аналагічным імем'; es = 'Error al Mostrar los datos de la tabla %1 porque se ha creado un elemento de formulario con el mismo nombre'; ka = 'შეცდომა დამატებითი ცხრილის მონაცემების ჩვენებაში %1, რადგან შეიქმნა ფორმის ელემენტი იგივე სახელით'; kk = 'Қосымша кесте деректерін көрсету қатесі %1, себебі ұқсас атаумен пішін элементі жасалған'; ro = 'Eroare la afișarea datelor suplimentare din tabel %1, deoarece a fost creat un element de formular cu același nume'; tr = 'Tablo ek verilerinin görüntülenmesi %1 hatası, çünkü aynı ada sahip bir form öğesi oluşturuldu'; uk = 'Помилка відображення даних доп таблиці %1, тому що створений елемент форми з аналогічним ім''ям'; uz = '%1 jadvalining qo''shimcha ma''lumotlarini ko''rsatishda xato, chunki shunga o''xshash nomdagi shakl elementi yaratilgan'");
				Комментарий = РеквизитФормыВЗначение("Объект").ГлЯдро_СтрШаблон(Комментарий, ИмяДопТаблицы);
				Сообщить(Комментарий); 
				Продолжить;
			КонецЕсли;
			
			НоваяСтраница = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаСтраницы);
			НоваяСтраница.Вид 		= ВидГруппыФормы.Страница;
			НоваяСтраница.Заголовок = ИмяДопТаблицы;
			
			НоваяТаблицаФормы = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), НоваяСтраница);		
			НоваяТаблицаФормы.ПутьКДанным = ИмяДопТаблицы;
			
			Для Каждого Колонка Из ДопТаблицаЗначений.Колонки Цикл
				
				ИмяКолонки = ИмяДопТаблицы + Колонка.Имя;
				Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
					Комментарий = НСтр("ru = 'Ошибка отображения колонки доп таблицы %1, т.к. создан элемент формы с аналогичным именем';
										|en = 'Error displaying the column of the additional table %1, because a form element with the same name was created';
										|be = 'Памылка адлюстравання калонкі доп табліцы %1, бо створаны элемент формы з аналагічным імем'; es = 'Error al Mostrar la columna DOP de la tabla %1 porque se creó un elemento de formulario con el mismo nombre'; ka = 'შეცდომა ჩვენებისას სვეტი დამატებითი მაგიდა %1, რადგან ფორმა ელემენტს იგივე სახელი შეიქმნა'; kk = 'Қосымша кесте бағанын көрсету қатесі %1, себебі ұқсас атаумен пішін элементі жасалған'; ro = 'Eroare la afișarea coloanei din tabelul suplimentar %1, deoarece a fost creat un element de formular cu același nume'; tr = '%1 tablosunun ek sütunu görüntülenirken hata oluştu, çünkü aynı ada sahip bir form öğesi oluşturuldu'; uk = 'Помилка відображення колонки доп таблиці %1, тому що створений елемент форми з аналогічним ім''ям'; uz = '%1 jadvalining qo''shimcha ustunini ko''rsatishda xato, chunki shunga o''xshash nomdagi shakl elementi yaratilgan'");
					Комментарий = РеквизитФормыВЗначение("Объект").ГлЯдро_СтрШаблон(Комментарий, ИмяКолонки);
					Сообщить(Комментарий); 
					Продолжить;
				КонецЕсли;

				НоваяКолонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), НоваяТаблицаФормы); 
				НоваяКолонка.Заголовок = Колонка.Заголовок; 
				НоваяКолонка.ПутьКДанным = ИмяДопТаблицы + "." + Колонка.Имя;
				НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
				
			КонецЦикла;
			
			ЗначениеВРеквизитФормы(ДопТаблицаЗначений, ИмяДопТаблицы);
			
		КонецЦикла;
		
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаНовыхШтрихкодовЗакрытие(Результат, ДопПараметры) Экспорт
	
	ОбновитДанныеПослеПривязкиШК();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДополнительныеКолонкиТаблицДокумента(ДанныеДокументаMS)
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить(ДанныеДокументаMS.СтрокиПлан[0].КолонкиТаблицыЗначений);
	МассивКолонок.Добавить(ДанныеДокументаMS.СтрокиФакт[0].КолонкиТаблицыЗначений);
	МассивКолонок.Добавить(ДанныеДокументаMS.СовмещенныеСтроки[0].КолонкиТаблицыЗначений);
	МассивКолонок = _ЛокКонтекст.ЛокЯдро_СтрРазделить(_ЛокКонтекст.ЛокЯдро_СтрСоединить(МассивКолонок, ","), ",", Ложь);
	
	СоздатьДополнительныеКолонкиТаблицДокументаНаСервере(МассивКолонок);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДополнительныеКолонкиТаблицДокументаНаСервере(МассивКолонок)
	
	ИсключаемыеКолонки = ИсключаемыеКолонкиОтображения();
	ДобавляемыеКолонки = Новый Массив;
	
	Для каждого РеквизитИмя Из МассивКолонок Цикл
		Если ДобавляемыеКолонки.Найти(РеквизитИмя) = Неопределено
			И ИсключаемыеКолонки.Найти(РеквизитИмя) = Неопределено Тогда
			ДобавляемыеКолонки.Добавить(РеквизитИмя);
		КонецЕсли;
	КонецЦикла;
	
	СортировкаКолонок = Новый СписокЗначений;
	СортировкаКолонок.ЗагрузитьЗначения(ДобавляемыеКолонки);
	СортировкаКолонок.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	ДобавляемыеКолонки = СортировкаКолонок.ВыгрузитьЗначения();
	
	СоздатьЭлементыОтображенияДопКолонок("СтрокиПлан", ДобавляемыеКолонки);
	СоздатьЭлементыОтображенияДопКолонок("СтрокиФакт", ДобавляемыеКолонки);
	СоздатьЭлементыОтображенияДопКолонок("СовмещенныеСтроки", ДобавляемыеКолонки);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыОтображенияДопКолонок(ИмяТаблицы, ДобавляемыеКолонки)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда		
		ТаблицаФормы = ЭлементыФормы[ИмяТаблицы];
		Для Каждого ИмяКолонки Из ДобавляемыеКолонки Цикл
			НоваяКолонка = ТаблицаФормы.Колонки.Добавить(ИмяКолонки, ИмяКолонки);
			НоваяКолонка.Данные = ИмяКолонки;
			НоваяКолонка.УстановитьЭлементУправления(Тип("ПолеВвода"));
		КонецЦикла;		
	#Иначе
		МассивРеквизитов = Новый Массив;
		Для Каждого ИмяКолонки Из ДобавляемыеКолонки Цикл
			МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяКолонки, Новый ОписаниеТипов, ИмяТаблицы, ИмяКолонки));
		КонецЦикла;
		ИзменитьРеквизиты(МассивРеквизитов);
		
		Для Каждого ИмяКолонки Из ДобавляемыеКолонки Цикл
			НоваяКолонка = Элементы.Добавить(ИмяТаблицы + ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы]); 
			НоваяКолонка.Заголовок = ИмяКолонки; 
			НоваяКолонка.ПутьКДанным = ИмяТаблицы + "." + ИмяКолонки;
			НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
			НоваяКолонка.ТолькоПросмотр = Истина;
		КонецЦикла;
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ИсключаемыеКолонкиОтображения()
	
	// Внутренние идентификаторы реквизитов
	ИсключаемыеКолонки = Новый Массив;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СтрокиПланКолонки = СтрокиПлан.Колонки;
		СтрокиФактКолонки = СтрокиФакт.Колонки;
		СовмещенныеСтрокиКолонки = СовмещенныеСтроки.Колонки;
	#Иначе
		СтрокиПланКолонки = СтрокиПлан.Выгрузить(Новый Массив).Колонки;
		СтрокиФактКолонки = СтрокиФакт.Выгрузить(Новый Массив).Колонки;
		СовмещенныеСтрокиКолонки = СовмещенныеСтроки.Выгрузить(Новый Массив).Колонки;
	#КонецЕсли
	
	Для каждого Колонка Из СтрокиПланКолонки Цикл
		Если ИсключаемыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			ИсключаемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Колонка Из СтрокиФактКолонки Цикл
		Если ИсключаемыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			ИсключаемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Колонка Из СовмещенныеСтрокиКолонки Цикл
		Если ИсключаемыеКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			ИсключаемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИсключаемыеКолонки;
	
КонецФункции

