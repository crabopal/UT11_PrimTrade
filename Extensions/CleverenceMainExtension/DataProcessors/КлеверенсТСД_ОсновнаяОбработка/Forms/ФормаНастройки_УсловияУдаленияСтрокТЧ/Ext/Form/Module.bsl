/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте 
Перем пРазрешитьЗакрытие;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодготовитьКомпоновщикНастроек();
	
	УдалятьСтрокиПоУсловиюФлагПриИзменении(Неопределено);
	
	ОбновитьОтображениеПриОткрытии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	КомпоновщикНастроекСтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(КомпоновщикНастроек.Настройки);
	Результат = Новый Структура("УдалятьСтрокиПоУсловиюСтрокой,УдалятьСтрокиПоУсловиюФлаг",КомпоновщикНастроекСтрокой,УдалятьСтрокиПоУсловиюФлаг);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	пРазрешитьЗакрытие = Истина;
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповыеНастройки(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки отборов будут возвращены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповыеНастройкиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УдалятьСтрокиПоУсловиюФлагПриИзменении(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.УдалятьСтрокиПоУсловиюФлаг.ЦветТекста = ?(УдалятьСтрокиПоУсловиюФлаг = Истина,WebЦвета.Зеленый,WebЦвета.Красный);
	#Иначе
		Элементы.УдалятьСтрокиПоУсловиюФлаг.ЦветТекстаЗаголовка = ?(УдалятьСтрокиПоУсловиюФлаг = Истина,WebЦвета.Зеленый,WebЦвета.Красный);
	#КонецЕсли
	Элементы.УдалятьСтрокиПоУсловиюФлаг.Заголовок =  ?(УдалятьСтрокиПоУсловиюФлаг = Истина,
		НСтр("ru = 'Включено';
				|en = 'Enabled'; be = 'Уключаны'; es = 'Incorporado'; ka = 'ჩართულია'; kk = 'Қосылған'; ro = 'Activat'; tr = 'Etkin'; uk = 'Включений'; uz = 'Kiritilgan'"),
		НСтр("ru = 'Выключено';
				|en = 'Turned off'; be = 'Выключаны'; es = 'Apagado'; ka = 'გამორთულია'; kk = 'Өшірулі'; ro = 'Oprit'; tr = 'Kapalı'; uk = 'Вимкнений'; uz = 'O''chirilgan'")
	);
	
	Если Элемент <> Неопределено Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ВосстановитьТиповыеНастройки.Видимость 			= ЭтоТиповаяНастройка;
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьКомпоновщикНастроек()
	
	СКД = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	ТекущийНаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	ТекущийНаборДанных.Имя = "ОсновнойНабор";
	ТекущийНаборДанных.ИмяОбъекта = "ТаблицаИсточник";	
	ТекущийНаборДанных.ИсточникДанных = "ИсточникДанных";			
	ТипНабора = "Объект";	
	
	КоллекцияКолонок = Новый ТаблицаЗначений;
	КоллекцияКолонок.Колонки.Добавить("Имя");
	КоллекцияКолонок.Колонки.Добавить("ТипЗначения");
	КоллекцияКолонок.Колонки.Добавить("Заголовок");
	
	Для каждого Колонка Из Метаданные.Документы[ТипДокумента1С].ТабличныеЧасти[ИмяТабличнойЧасти1С].Реквизиты Цикл			
		НоваяКолонка = КоллекцияКолонок.Добавить();
		НоваяКолонка.Имя = Колонка.Имя;
		НоваяКолонка.ТипЗначения = Колонка.Тип;
		НоваяКолонка.Заголовок = Колонка.Синоним;									
	КонецЦикла;
	
	Для каждого НоваяКолонка Из КоллекцияКолонок Цикл			
		ПолеНабора = ТекущийНаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Заголовок = СокрЛП(НоваяКолонка.Заголовок);
		ПолеНабора.Поле = СокрЛП(НоваяКолонка.Имя);
		ПолеНабора.ПутьКДанным = СокрЛП(НоваяКолонка.Имя);
		
		Массив = Новый Массив;
		Для каждого ТекущийТип Из НоваяКолонка.ТипЗначения.Типы() Цикл
			Если ТекущийТип = Тип("Неопределено") или ТекущийТип = Тип("NULL") или ТекущийТип = Неопределено или ТекущийТип = Null Тогда 
				Продолжить; 
			КонецЕсли;
			Массив.Добавить(ТекущийТип);
		КонецЦикла;
		ПолеНабора.ТипЗначения = Новый ОписаниеТипов(Массив,НоваяКолонка.ТипЗначения.КвалификаторыЧисла,НоваяКолонка.ТипЗначения.КвалификаторыСтроки,НоваяКолонка.ТипЗначения.КвалификаторыДаты);
		
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор();
	#КонецЕсли
	АдресСхемыСКД = ПоместитьВоВременноеХранилище(СКД, УникальныйИдентификатор);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыСКД));	
	
	пНастройкиКомпоновки = Неопределено;
	Если ЗначениеЗаполнено(КомпоновщикНастроекСтрокой) Тогда		
		пКомпоновщикНастроекСтрокой = СтрЗаменить(КомпоновщикНастроекСтрокой, Символы.ВК, "");
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(пКомпоновщикНастроекСтрокой);
		
		Попытка
			пНастройкиКомпоновки = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
		Исключение
			пНастройкиКомпоновки = ЗначениеИзСтрокиВнутр(пКомпоновщикНастроекСтрокой);
		КонецПопытки;
	КонецЕсли; 	
	
	Если пНастройкиКомпоновки <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(пНастройкиКомпоновки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		КомпоновщикНастроекСтрокой = "";
		
		Если СтруктураНастроекТиповая.Свойство("ВыгружатьСтрокиПоУсловиюСтрокой") Тогда
			КомпоновщикНастроекСтрокой = СтруктураНастроекТиповая.ВыгружатьСтрокиПоУсловиюСтрокой;	
		КонецЕсли;
		Если СтруктураНастроекТиповая.Свойство("УдалятьСтрокиПоУсловиюСтрокой") Тогда
			КомпоновщикНастроекСтрокой = СтруктураНастроекТиповая.УдалятьСтрокиПоУсловиюСтрокой;	
		КонецЕсли;
		
		УдалятьСтрокиПоУсловиюФлаг = Ложь;
		Если СтруктураНастроекТиповая.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") Тогда
			УдалятьСтрокиПоУсловиюФлаг = СтруктураНастроекТиповая.ВыгружатьСтрокиПоУсловиюФлаг;	
		КонецЕсли;
		Если СтруктураНастроекТиповая.Свойство("УдалятьСтрокиПоУсловиюФлаг") Тогда
			УдалятьСтрокиПоУсловиюФлаг = СтруктураНастроекТиповая.УдалятьСтрокиПоУсловиюФлаг;	
		КонецЕсли;
		
		ПриОткрытии(Ложь);
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли