/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли


	
#Область ОбработчикиСобытийФормы
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	ОбновитьТаблицуТаймаутов();	
КонецПроцедуры

#КонецОбласти
	
#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	Сохранить("");
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,Ложь,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("НастройкиТаймаутов",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов"));
	СтруктураНастройки.Вставить("ВерсияОбработкиНастроек",_ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВерсияОбработкиНастроек"));
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастройки, "НастройкиТаймаутов");
КонецПроцедуры
	
&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтаФорма);
	
	_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("НастройкиТаймаутов", ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт

	Если СтруктураНастроек <> Неопределено 
		И ТипЗнч(СтруктураНастроек) = Тип("Структура") 
		И СтруктураНастроек.Свойство("НастройкиТаймаутов") Тогда
		
		НастройкиТаймаутов = СтруктураНастроек.НастройкиТаймаутов;
		
		ТаблицаТаймаутов.Очистить();																 // 1.Очищаем текущие
		
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиТаймаутов", НастройкиТаймаутов);	 // 2.Записываем в кэш настройки из файла
		_ЛокКонтекст.ЛокЯдро_ПроверитьНастройкиТаймаутов();											 // 3.Проверяем, обновляем
		
		ОбновитьТаблицуТаймаутов();																	 // 4.Обновляем на форме
		
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиТаймаутов", НастройкиТаймаутов);// 5.Сохраняем в настройки МС
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройки(Команда)
	ОповещениеВосстановитьНастройки = Новый ОписаниеОповещения("ВосстановитьНастройкиЗавершение", ЭтаФорма);
	
	ТекстВопроса = НСтр("ru = 'Текущие настройки таймаутов будут утеряны! Будут восстановлены значения по умолчанию. Продолжить?';
							|en = 'The current timeout settings will be lost! The default values will be restored. Continue?';
							|be = 'Бягучыя налады таймаўту будуць згубленыя! Значэнні па змаўчанні будуць адноўлены. Працягнуць?'; es = '¡Los ajustes de tiempo de espera actuales se perderán! Se restaurarán los valores predeterminados. ¿Continuar?'; ka = 'მიმდინარე timeout პარამეტრები დაიკარგება! ნაგულისხმევი მნიშვნელობები აღდგება. გაგრძელება?'; kk = 'Ағымдағы күту уақыты параметрлері жоғалады! Әдепкі мәндер қалпына келтіріледі. Жалғастыру?'; ro = 'Setările actuale de expirare vor fi pierdute! Valorile implicite vor fi restaurate. Continuați?'; tr = 'Mevcut zaman aşımı ayarları kaybolacaktır! Varsayılanlara geri yüklenecektir. Devam etmek mi?'; uk = 'Поточні налаштування таймаутів будуть втрачені! Будуть відновлені значення за замовчуванням. Продовжити?'; uz = 'Joriy vaqt sozlamalari yo''qoladi! Standart qiymatlar tiklanadi. Davom etasizmi?'");
	ПоказатьВопрос(ОповещениеВосстановитьНастройки, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТаймаутов.Очистить();
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиТаймаутов", Ложь);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиТаймаутов", Ложь);
	_ЛокКонтекст.ЛокЯдро_ПроверитьНастройкиТаймаутов();
	
	ОбновитьТаблицуТаймаутов();
				
КонецПроцедуры

#КонецОбласти
	
#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ОбновитьТаблицуТаймаутов()
	
	ТаблицаТаймаутов.Очистить();
	НастройкиТаймаутов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиТаймаутов");
	Если НЕ НастройкиТаймаутов = Ложь И ТипЗнч(НастройкиТаймаутов) = Тип("Массив")  Тогда
		Для Каждого СтрокаТаймаута Из НастройкиТаймаутов Цикл
			Если ТипЗнч(СтрокаТаймаута) = Тип("Структура") И СтрокаТаймаута.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(ТаблицаТаймаутов.Добавить(), СтрокаТаймаута);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти	

#Область ОбщиеМеханизмы

&НаКлиенте
Процедура СохранитьНастройки()
	
	МассивТаймаутов = ПолучитьМассивТаймаутов();
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиТаймаутов", МассивТаймаутов);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиТаймаутов", МассивТаймаутов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	 
	СохранитьВФайл("");
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивТаймаутов()
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"ТипЗапроса,ТипЗапросаСиноним,Значение,Комментарий"));
	Для Каждого Строка Из ТаблицаТаймаутов Цикл
		Параметр = Новый Структура("ТипЗапроса,ТипЗапросаСиноним,Значение,Комментарий",Строка.ТипЗапроса,Строка.ТипЗапросаСиноним,Строка.Значение,Строка.Комментарий);	
		МассивПараметров.Добавить(Параметр);
	КонецЦикла;
	Возврат МассивПараметров;
КонецФункции

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда 	
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Объект = ЭтотОбъект;
#КонецЕсли

