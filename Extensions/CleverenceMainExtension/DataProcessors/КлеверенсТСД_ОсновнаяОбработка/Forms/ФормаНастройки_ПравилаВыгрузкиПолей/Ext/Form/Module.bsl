/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте 
Перем ПредыдущееЗначение,
	  ТаблицаРеквизитовИсходная Экспорт,
	  ТаблицаРеквизитовДополнительная Экспорт,
	  пРазрешитьЗакрытие; 


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		
		РеквизитОбъект = РеквизитФормыВЗначение("Объект");
		УстановитьУсловноеОформление();
		
		// Общий обработчик
		РеквизитОбъект.ГлЯдро_ПриСозданииНаСервере(ЭтаФорма, Параметры);
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СтруктураНастроекТиповая = Неопределено Тогда
		СтруктураНастроекТиповая = Новый Структура;
	КонецЕсли;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Настройка выгрузки полей шапки документа';
							|en = 'Cleverence: Setting up the unloading of document header fields';
							|be = 'Cleverence: Налада выгрузкі палёў шапкі дакумента'; es = 'Cleverence: configurar la descarga de campos de tapa de documento'; ka = 'Cleverence: შექმნის გადმოტვირთვის დოკუმენტის header სფეროებში'; kk = 'Cleverence: құжат қақпағының өрістерін түсіруді орнату'; ro = 'Cleverence: Configurarea descărcării câmpurilor antetului documentului'; tr = 'Cleverence: Belge başlığı alanlarının boşaltılmasını ayarlama'; uk = 'Cleverence: Налаштування вивантаження полів шапки документа'; uz = 'Aniqlik: hujjat sarlavhasi maydonlarini yuklashni Sozlash'");
		СписокРеквизитов1С = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].Реквизиты;
		СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].Реквизиты);
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковТабличнойЧасти.Свертка = РежимСверткиЭлементаУправления.Верх;			
		#Иначе	
			Элементы.РамкаОбработчикиТЧ.Видимость = Ложь;			
		#КонецЕсли
	ИначеЕсли КлючНастройки = "Выгрузка_Справочник" Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Настройка выгрузки полей справочника';
							|en = 'Cleverence: Configuring the unloading of directory fields'; be = 'Cleverence: Налада выгрузкі палёў даведніка'; es = 'Cleverence: configurar la descarga de campos de referencia'; ka = 'Cleverence: კონფიგურაცია გადმოტვირთვის დირექტორია სფეროებში'; kk = 'Cleverence: анықтамалық өрістерді жүктеуді орнату'; ro = 'Cleverence: Configurarea descărcării câmpurilor de directoare'; tr = 'Cleverence: Dizin alanlarının boşaltılmasını ayarlama'; uk = 'Cleverence: Налаштування вивантаження полів довідника'; uz = 'Aniqlik: katalog maydonlarini yuklashni Sozlash'");
		Если Найти(ТипДокумента1С, "Запрос") Тогда
			Если ЗначениеЗаполнено(ТекстЗапросаВыгрузкиНаТСД) Тогда
				СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);			
			КонецЕсли;
		КонецЕсли;
		Если ТипДокументаMS = "Номенклатура" Тогда
			СписокРеквизитовMS = Новый СписокЗначений;
			СписокРеквизитовMS.ЗагрузитьЗначения(_ЛокКонтекст.СтруктураМетаданных.ВыгружаемыеПоляНоменклатурыMS);
		ИначеЕсли ТипДокументаMS = "Ячейки" Тогда
			СписокРеквизитовMS = Новый СписокЗначений;
			СписокРеквизитовMS.ЗагрузитьЗначения(_ЛокКонтекст.СтруктураМетаданных.ВыгружаемыеПоляЯчеекMS);
		Иначе
			Для каждого Таблица Из _ЛокКонтекст.СтруктураМетаданных.Tables Цикл
				Если Таблица.Представление = ТипДокументаMS Тогда
					МассивРеквизитовMS = Таблица.Значение;
					СписокРеквизитовMS = Новый ФиксированныйМассив(МассивРеквизитовMS);
					Прервать;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковТабличнойЧасти.Свертка = РежимСверткиЭлементаУправления.Верх;
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;
		#Иначе	
			Элементы.РамкаОбработчикиТЧ.Видимость = Ложь;
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;			
		#КонецЕсли
	Иначе
	    Заголовок = НСтр("ru = 'Клеверенс: Настройка выгрузки полей табличной части документа';
							|en = 'Cleverence: Setting up the unloading of fields in the tabular part of the document';
							|be = 'Cleverence: Налада выгрузкі палёў таблічнай часткі дакумента'; es = 'Cleverence: configurar la descarga de campos de la parte de tabla del documento'; ka = 'კლევერენცია: დოკუმენტის ცხრილის ნაწილში ველების გადმოტვირთვის დაყენება'; kk = 'Cleverence: құжаттың кестелік бөлігінің өрістерін жүктеуді орнату'; ro = 'Inteligență: Configurarea descărcării câmpurilor în partea tabelară a documentului'; tr = 'Cleverence: Belgenin tablo bölümünün alanlarının boşaltılmasını ayarlama'; uk = 'Cleverence: Налаштування вивантаження полів табличній частині документа'; uz = 'Aniqlik: hujjatning jadval qismining maydonlarini yuklashni Sozlash'");
		Если Найти(ИмяТабличнойЧасти1С, "Запрос") Тогда
			Если ЗначениеЗаполнено(ТекстЗапросаВыгрузкиНаТСД) Тогда
				СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);			
			КонецЕсли;
		Иначе
			СписокРеквизитов1С = Новый СписокЗначений;
			СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
			Если СписокДополнительныхОбработчиков <> Неопределено
				И СписокДополнительныхОбработчиков.Получить(ИмяТабличнойЧасти1С) <> Неопределено Тогда
				СписокРеквизитов1С = СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].СписокКолонок;
				Синоним = ?(СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].Свойство("Синоним"),СписокДополнительныхОбработчиков[ИмяТабличнойЧасти1С].Синоним,ИмяТабличнойЧасти1С);
				Элементы.ИмяТабличнойЧасти1С.Заголовок = Синоним;
			КонецЕсли;
			ТабличныеЧасти = _ЛокКонтекст.СтруктураМетаданных.Документы1С[ТипДокумента1С].ТабличныеЧасти;
			Если СписокРеквизитов1С.Количество() = 0 
				И ТабличныеЧасти.Свойство(ИмяТабличнойЧасти1С) <> Неопределено Тогда
				СписокРеквизитов1С = ТабличныеЧасти[ИмяТабличнойЧасти1С].Реквизиты;
				Элементы.ИмяТабличнойЧасти1С.Заголовок = ТабличныеЧасти[ИмяТабличнойЧасти1С].Синоним;
			КонецЕсли;
		КонецЕсли;
		
		Если 	ИмяТабличнойЧастиMS = "СтрокиПлан" 
			ИЛИ ИмяТабличнойЧастиMS = "СтрокиФакт" 
			ИЛИ ИмяТабличнойЧастиMS = "СовмещенныеСтроки" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыТЧ);							
			
		ИначеЕсли ИмяТабличнойЧастиMS = "СерииПлан" 
			ИЛИ   ИмяТабличнойЧастиMS = "СерииФакт" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыСерии);							
			
		ИначеЕсли ИмяТабличнойЧастиMS = "СерийныеНомераПлан" 
			ИЛИ   ИмяТабличнойЧастиMS = "СерийныеНомераФакт" Тогда
			СписокРеквизитовMS = Новый ФиксированныйМассив(_ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].РеквизитыСерийныеНомера);							
			
		Иначе
			СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
			Для Каждого ДопТаблица Из СписокДопТаблиц Цикл
				Если ДопТаблица.Представление = ИмяТабличнойЧастиMS Тогда
					СписокРеквизитовMS = Новый ФиксированныйМассив(ДопТаблица.Значение);
					Прервать;
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ПанельОбработчиковДокумента.Свертка = РежимСверткиЭлементаУправления.Верх;			
		#Иначе	
			Элементы.РамкаОбработчикиДокументов.Видимость = Ложь;			
		#КонецЕсли		
	КонецЕсли;
	
	ОбновитьПредставленияСпискаДокументов1С();
	
	ОбновитьСписокПроизвольныхКодов();
	
	// Список Глобальных параметров
	ТаблицаГлобальныхПараметров = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ГлобальныеПараметры", Новый Структура());
	
	Если ТипЗнч(ТаблицаГлобальныхПараметров) = Тип("Массив") Тогда 
		Для Каждого СтрокаПараметра Из ТаблицаГлобальныхПараметров Цикл
		    Если СтрокаПараметра.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			СписокГлобальныхПараметров.Добавить(СтрокаПараметра.ID_Параметра, СтрокаПараметра.Наименование);
		КонецЦикла;
	КонецЕсли;	
	
	// Список вариантов обработчиков загрузки
	СписокВариантовОбработчиков.Добавить(0, НСтр("ru = 'Без обработчика';
													|en = 'Without a handler'; be = 'Без апрацоўшчыка'; es = 'Sin controlador'; ka = 'დამმუშავებლის გარეშე'; kk = 'Өңдегіш жоқ'; ro = 'Fără un handler'; tr = 'İşleyici olmadan'; uk = 'Без обробника'; uz = 'Ishlov beruvchisiz'"));
	СписокВариантовОбработчиков.Добавить(1, НСтр("ru = 'Обработчик по умолчанию';
													|en = 'Default handler'; be = 'Апрацоўшчык па змаўчанні'; es = 'Controlador predeterminado'; ka = 'ნაგულისხმევი მმართველი'; kk = 'Әдепкі өңдегіш'; ro = 'Handler implicit'; tr = 'Varsayılan işleyici'; uk = 'Обробник за замовчуванням'; uz = 'Standart ishlov beruvchi'"));
	СписокВариантовОбработчиков.Добавить(2, НСтр("ru = 'Свой обработчик';
													|en = 'Your handler'; be = 'Свой апрацоўшчык'; es = 'Su procesador'; ka = 'თქვენი დამმუშავებელი'; kk = 'Оның өңдеушісі'; ro = 'Manipulatorul tău'; tr = 'İşleyicinizi'; uk = 'Свій обробник'; uz = 'Sizning ishlov beruvchingiz'"));
	СписокВариантовОбработчиков.Добавить(3, НСтр("ru = 'Произвольный код';
													|en = 'Custom code'; be = 'Адвольны код'; es = 'Código arbitrario'; ka = 'საბაჟო კოდი'; kk = 'Еркін код'; ro = 'Cod personalizat'; tr = 'Rastgele kod'; uk = 'Довільний код'; uz = 'O''zboshimchalik bilan kod'"));
	
	// Список категорий приемника
	СписокТиповПриемника.Добавить("РеквизитMS", 		НСтр("ru = 'Фиксированный реквизит Mobile SMARTS';
															|en = 'Fixed Cleverence Props'; be = 'Фіксаваны рэквізіт Cleverence'; es = 'Accesorios fijos Cleverence'; ka = 'ფიქსირებული Cleverence Props'; kk = 'Cleverence бекітілген реквизиттері'; ro = 'Recuzită Inteligentă Fixă'; tr = 'Cleverence sabit sahne'; uk = 'Фіксований реквізит Cleverence'; uz = 'Cleverence sobit rekvizitlari'"));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокТиповПриемника.Добавить("НовыйРеквизит", 	НСтр("ru = 'Новый реквизит Mobile SMARTS';
																|en = 'New Cleverence props'; be = 'Новы рэквізіт Cleverence'; es = 'Nuevos accesorios Cleverence'; ka = 'ახალი Cleverence props'; kk = 'Cleverence жаңа реквизиттері'; ro = 'Noi recuzită de inteligență'; tr = 'Yeni Cleverence Sahne Donanımı'; uk = 'Новий реквізит Cleverence'; uz = 'Yangi Cleverence rekvizitlari'"));
	КонецЕсли;
	
	// Список категорий источника
	СписокТиповИсточника.Добавить("Реквизит1С", 			 НСтр("ru = 'Реквизит 1С';
																|en = '1C banking details'; be = 'Рэквізіт 1С'; es = 'Apoyos 1C'; ka = '1c საბანკო დეტალები'; kk = '1С деректемесі'; ro = '1C detalii bancare'; tr = 'Sahne 1C'; uk = 'Реквізит 1С'; uz = '1C rekvizitlari'"));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокТиповИсточника.Добавить("ГлобальныйПараметр",  НСтр("ru = 'Глобальный параметр';
																	|en = 'Global parameter'; be = 'Глабальны параметр'; es = 'Parámetro global'; ka = 'გლობალური პარამეტრი'; kk = 'Жаһандық параметр'; ro = 'Parametru Global'; tr = 'Genel parametre'; uk = 'Глобальний параметр'; uz = 'Global parametr'"));	
		СписокТиповИсточника.Добавить("ПроизвольноеЗначение",НСтр("ru = 'Произвольное значение';
																	|en = 'Any value'; be = 'Адвольнае значэнне'; es = 'Valor arbitrario'; ka = 'ნებისმიერი მნიშვნელობა'; kk = 'Ерікті мән'; ro = 'Orice valoare'; tr = 'Keyfi değer'; uk = 'Довільне значення'; uz = 'Har qanday qiymat'"));	
		СписокТиповИсточника.Добавить("ПроизвольныйКод", 	 НСтр("ru = 'Произвольный код';
																	|en = 'Custom code'; be = 'Адвольны код'; es = 'Código arbitrario'; ka = 'საბაჟო კოდი'; kk = 'Еркін код'; ro = 'Cod personalizat'; tr = 'Rastgele kod'; uk = 'Довільний код'; uz = 'O''zboshimchalik bilan kod'"));	
	КонецЕсли;
	
	// Список правил сопоставления для ссылочных типов
	СписокСпособовСопоставления.Добавить("СтрокаGUID",   	 НСтр("ru = 'Ссылка (строка GUID)';
																	|en = 'Link (GUID string)'; be = 'Спасылка (радок GUID)'; es = 'Enlace (cadena GUID)'; ka = 'ბმული (GUID string)'; kk = 'Сілтеме (GUID жолы)'; ro = 'Legătură (șir GUID)'; tr = 'Referans (GUID dizesi)'; uk = 'Посилання (рядок GUID)'; uz = 'Havola (GUID qatori)'"));
	Если КлючНастройки <> "Выгрузка_Справочник" Тогда
		СписокСпособовСопоставления.Добавить("Наименование", НСтр("ru = 'Наименование (для справочников)';
																	|en = 'Name (for reference books)'; be = 'Найменне (для даведнікаў)'; es = 'Nombre (para referencias)'; ka = 'სახელი (საცნობარო წიგნებისთვის)'; kk = 'Атауы (анықтамалықтар үшін)'; ro = 'Nume (pentru cărți de referință)'; tr = 'İsim (referans kitaplar için)'; uk = 'Найменування (для довідників)'; uz = 'Nomi (ma''lumotnomalar uchun)'"));
		СписокСпособовСопоставления.Добавить("Код",          НСтр("ru = 'Код (для справочников)';
																	|en = 'Code (for reference books)'; be = 'Код (для даведнікаў)'; es = 'Código (para referencias)'; ka = 'კოდი (საცნობარო წიგნებისთვის)'; kk = 'Код (анықтамалықтар үшін)'; ro = 'Cod (pentru cărți de referință)'; tr = 'Kod (referans kitapları için)'; uk = 'Код (для довідників)'; uz = 'Kod (ma''lumotnomalar uchun)'"));
	КонецЕсли;
	СписокСпособовСопоставления.Добавить("КакЕсть", 		 НСтр("ru = 'Как есть (простой тип)';
																|en = 'As it is (simple type)'; be = 'Як ёсць (просты тып)'; es = 'Como es (tipo simple)'; ka = 'როგორც ეს არის (მარტივი ტიპი)'; kk = 'Қалай (қарапайым түрі)'; ro = 'Așa cum este (tip simplu)'; tr = 'Olduğu gibi (basit tip)'; uk = 'Як є (простий тип)'; uz = 'Qanday ovqatlanish kerak (oddiy tur)'"));
	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипПриемникаСиноним,СписокТиповПриемника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовТипИсточникаСиноним,СписокТиповИсточника);
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПрЗначение,СписокРеквизитовMS, "Ключ", "Ключ");	
	ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовСпособСопоставленияСиноним,СписокСпособовСопоставления);

	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОтправкиДокумента, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	// Видимость и значения элементов
	Элементы.ИмяТабличнойЧасти1С.Видимость     	= КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента";
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.НадписьТабличнаяЧасть1С.Видимость     	= КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента";	
	#КонецЕсли
	Элементы.НадписьТекстЗапроса.Видимость     	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
	Элементы.РедактироватьТекстЗапроса.Видимость 	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
	Элементы.ПараметрыЗапроса.Видимость 	= (Найти(ИмяТабличнойЧасти1С, "Запрос") > 0);
		
	// В дальнейшем таблица должна передаваться напрямую
	Если ЗначениеЗаполнено(ТаблицаРеквизитовИсходная) Тогда
		ЗаполнитьТаблицуРеквизитов(ТаблицаРеквизитовИсходная);
	ИначеЕсли КлючНастройки = "Выгрузка_Справочник" Тогда
		ЗаполнитьТаблицуРеквизитовПоУмолчанию();		
	КонецЕсли;
	Если ТаблицаРеквизитовДополнительная <> Неопределено Тогда
		ТаблицаРеквизитовДополнительнаяНовая = Новый Массив();
		ТаблицаРеквизитовДополнительнаяНовая.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,Выгружать,ПрЗначение,ИсЗначение"));
		Для Каждого СтрокаИсходнойТаблицы Из ТаблицаРеквизитовДополнительная Цикл
			Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Новый Структура("ТипПриемникаСиноним,ИмяЗначениеПриемника,СинонимПриемника,ИмяПриемника,ТипИсточникаСиноним,ИмяЗначениеИсточника,СинонимИсточника,ЗначениеИсточника,СпособСопоставленияСиноним,Комментарий,ТипПриемника,ТипИсточника,ИмяИсточника,СпособСопоставления,Выгружать,ПрЗначение,ИсЗначение");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
			
			// Загрузка старых настроек
			Если СтрокаИсходнойТаблицы.Свойство("ИмяMS") Тогда
				НоваяСтрока.ИмяПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				НайденныйЭлементИмениПриемника = Неопределено;
				Для каждого РеквизитMS из СписокРеквизитовMS Цикл
					Если РеквизитMS.Значение = НоваяСтрока.ИмяПриемника Тогда
						НайденныйЭлементИмениПриемника = Новый Структура("Значение,Представление",РеквизитMS.Значение,РеквизитMS.Ключ);	
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НайденныйЭлементИмениПриемника <> Неопределено Тогда
					НоваяСтрока.СинонимПриемника = НайденныйЭлементИмениПриемника.Представление;
				Иначе
					НоваяСтрока.СинонимПриемника = СтрокаИсходнойТаблицы.ИмяMS;
				КонецЕсли;
				НоваяСтрока.ТипПриемника = "РеквизитMS";
				НоваяСтрока.ТипПриемникаСиноним = "Фиксированный реквизит Mobile SMARTS";
			КонецЕсли;
			
			Если СтрокаИсходнойТаблицы.Свойство("Имя1С") <> Неопределено Тогда
				
				Если СтрокаИсходнойТаблицы.Свойство("Тип") И СтрокаИсходнойТаблицы.Тип = "Реквизит 1С" Тогда
					// ищем в реквизитах
					НайденныйЭлементИмениИсточника = СписокРеквизитов1С.НайтиПоЗначению(СтрокаИсходнойТаблицы.Имя1С);
					Если НайденныйЭлементИмениИсточника <> Неопределено Тогда
						НоваяСтрока.ИмяИсточника = НайденныйЭлементИмениИсточника.Значение;
						НоваяСтрока.СинонимИсточника = НайденныйЭлементИмениИсточника.Представление;
						НоваяСтрока.ТипИсточника = "Реквизит1С";
						НоваяСтрока.ТипИсточникаСиноним = "Реквизит 1С";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(НоваяСтрока.ИмяИсточника) Тогда
						Если СтрокаИсходнойТаблицы.Свойство("ВыгружатьКакUID") Тогда
							Если СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка (GUID)" ИЛИ СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка(GUID)" Тогда
								НоваяСтрока.СпособСопоставления = "СтрокаGUID";
								НоваяСтрока.СпособСопоставленияСиноним = "Ссылка (строка GUID)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "По наименованию" Тогда
								НоваяСтрока.СпособСопоставления = "Наименование";
								НоваяСтрока.СпособСопоставленияСиноним = "Наименование (для справочников)";
							ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Код" Тогда
								НоваяСтрока.СпособСопоставления = "Код";
								НоваяСтрока.СпособСопоставленияСиноним = "Код (для справочников)";
							Иначе
								НоваяСтрока.СпособСопоставления = "КакЕсть";
								НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли СтрокаИсходнойТаблицы.Свойство("Тип") И (СтрокаИсходнойТаблицы.Тип = "Дата" ИЛИ СтрокаИсходнойТаблицы.Тип = "Число" ИЛИ СтрокаИсходнойТаблицы.Тип = "Строка" ИЛИ СтрокаИсходнойТаблицы.Тип = "Булево") Тогда
					НоваяСтрока.ТипИсточника = "ПроизвольноеЗначение";
					НоваяСтрока.ТипИсточникаСиноним = "Произвольное значение";
					НоваяСтрока.СпособСопоставления = "КакЕсть";
					НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
					НоваяСтрока.ЗначениеИсточника = СтрокаИсходнойТаблицы.Имя1С;
				КонецЕсли;
				
			КонецЕсли;			
			ТаблицаРеквизитовДополнительнаяНовая.Добавить(НоваяСтрока);
		КонецЦикла;
		ТаблицаРеквизитовДополнительная = ТаблицаРеквизитовДополнительнаяНовая;
	КонецЕсли;
	
	Для Каждого Элем Из ТаблицаРеквизитов Цикл
		Элем.ПрЗначение = ?(Элем.ТипПриемника = "НовыйРеквизит",Элем.ИмяПриемника,Элем.СинонимПриемника);
		Элем.ИсЗначение = ?(Элем.ТипИсточника = "ПроизвольноеЗначение",Элем.ЗначениеИсточника,Элем.СинонимИсточника);
	КонецЦикла;
	
	УстановитьЦветаЭлементов();	
	
	ВидОбработчика_ЗаполнениеПоУмолчанию();
	ЗаполнениеСоответствияВидовОбработчиковВыгрузки();
	
	ОбновитьОтображениеПриОткрытии();
	
	ОбновитьШаблон();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если Не ПроверитьКорректностьДобавленныхОбработчиков() Тогда
		Возврат;
	КонецЕсли;	

	Если Не ПроверитьКорректностьЗаполненияПолей() Тогда
		Возврат;
	КонецЕсли;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаНастроек", 			_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов));
	Результат.Вставить("ТекстЗапросаВыгрузкиНаТСД", ТекстЗапросаВыгрузкиНаТСД);
	Результат.Вставить("ТекстКодаПолучениеПараметров", ТекстКодаПолучениеПараметров);
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойДокумента", 		ВидОбработчика_ПередВыгрузкойДокумента);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиДокумента",  		ВидОбработчика_ПослеВыгрузкиДокумента);
		Результат.Вставить("ВидОбработчика_ПослеОтправкиДокумента",  		ВидОбработчика_ПослеОтправкиДокумента);
		
		Результат.Вставить("Обработчик_ПередВыгрузкойДокумента", 			Обработчик_ПередВыгрузкойДокумента);
		Результат.Вставить("Обработчик_ПослеВыгрузкиДокумента",  			Обработчик_ПослеВыгрузкиДокумента);		
		Результат.Вставить("Обработчик_ПослеОтправкиДокумента",  			Обработчик_ПослеОтправкиДокумента);		
		
		Результат.Вставить("ЗаменитьПредставлениеДокументаПриВыгрузке",		ЗаменитьПредставлениеДокументаПриВыгрузке);
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойТабличнойЧасти",       	ВидОбработчика_ПередВыгрузкойТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти", 	ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти);
		Результат.Вставить("ВидОбработчика_ПослеВыгрузкиТабличнойЧасти",        	ВидОбработчика_ПослеВыгрузкиТабличнойЧасти);
		
		Результат.Вставить("Обработчик_ПередВыгрузкойТабличнойЧасти",       		Обработчик_ПередВыгрузкойТабличнойЧасти);
		Результат.Вставить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти", 		Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти",  		Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти);
		Результат.Вставить("Обработчик_ПослеВыгрузкиТабличнойЧасти",        		Обработчик_ПослеВыгрузкиТабличнойЧасти);
		
	КонецЕсли;
	
	пРазрешитьЗакрытие = Истина;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
		Закрыть();
	#Иначе
		Закрыть(Результат);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьЗначениеФлажков(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьЗначениеФлажков(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицуРеквизитов(Команда)
	
	пЗаголовок = НСтр("ru = 'Очистить таблицу сопоставления полей?'");
	
	Если ЭтоТиповаяНастройка Тогда
		пСообщение = НСтр("ru = 'Будут удалены только пользовательские поля.'");
	Иначе
		пСообщение = "";
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ВопросОчиститьТаблицуРеквизитовЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповыеНастройки(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки обработчиков и таблица полей будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповыеНастройкиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповуюТаблицуРеквизитов(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить таблицу полей настройками по умолчанию?'");
	пСообщение = НСтр("ru = 'Таблица полей будет сброшена к значениям по умолчанию. Пользовательские поля будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповуюТаблицуРеквизитовЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПараметрыЗапросаНажатие(Элемент)
	ОповещениеВводаТекстаЗапроса = Новый ОписаниеОповещения("ВведитеТекстКодаПолучениеПараметров", ЭтаФорма, );
	Если Не ЗначениеЗаполнено(ТекстКодаПолучениеПараметров) Тогда
		ТекстКодаПолучениеПараметров = НСтр("ru = '//Все параметры запроса, кроме ссылки на выгружаемый документ,%//должны быть включены в структуру ПараметрыЗапроса.%//Ключ элемента структуры должен соответствовать имени параметра запроса.%//Структуру ПараметрыЗапроса отдельно объявлять не нужно.%//Пример добавления параметра:%//ПараметрыЗапроса.Вставить(""ИмяПараметраЗапроса"", ЗначениеПараметра); %//Доступна ссылка на выгружаемый документ: ДокументДляВыгрузки.';
												|en = '//All request parameters, except the link to the uploaded document, %//must be included in the request parameter structure.%//The key of the structure element must match the name of the request parameter.%//The query parameter structure does not need to be declared separately.%//Example of adding a parameter:%//Query parameters.Insert(""Query parameter name"", parameter values); %//A link to the document being uploaded is available: A document for uploading.';
												|be = '// Усе параметры запыту, акрамя спасылкі на выгружае дакумент,% / / павінны быць уключаны ў структуру ПараметрыЗапроса.% / / Ключ элемента структуры павінен адпавядаць імя параметру запыту.% / / Структуру ПараметрыЗапроса асобна аб''яўляць ня трэба.% / / Прыклад дадання параметру:% / / ПараметрыЗапроса.Уставіць (""ИмяПараметраЗапроса"", ЗначениеПараметра); %//даступная спасылка на выгружае дакумент: ДокументДляВыгрузки.'; es = '//Todos los parámetros de consulta, excepto la referencia al documento que se está descargando,%/ / deben incluirse en la estructura de parámetros de la Consulta.% / / La clave del elemento de estructura debe coincidir con el nombre del parámetro de consulta.% / / No es necesario declarar la estructura de parámetros de la Consulta por separado.% / / Ejemplo de agregar un parámetro: % / / parámetro de Consulta.Insertar (""nombreparámetro de Consulta"", el valor Delparámetro); %//enlace al documento que se está descargando está Disponible: documento de Carga.'; ka = '// მოთხოვნის ყველა პარამეტრი, ატვირთული დოკუმენტის ბმულის გარდა, % / / უნდა იყოს შეტანილი მოთხოვნის პარამეტრის სტრუქტურაში.% / / სტრუქტურის ელემენტის გასაღები უნდა შეესაბამებოდეს მოთხოვნის პარამეტრის სახელს.%//შეკითხვის პარამეტრის სტრუქტურა არ უნდა გამოცხადდეს ცალკე.%//პარამეტრის დამატების მაგალითი:%//შეკითხვის პარამეტრები.ჩასმა (""შეკითხვის პარამეტრის სახელი"", პარამეტრის მნიშვნელობები); %//ხელმისაწვდომია ბმული ატვირთული დოკუმენტისთვის: დოკუმენტი ატვირთვისთვის.'; kk = '// Жүктелетін құжатқа сілтемеден басқа барлық сұрау параметрлері% / / сұрау параметрлерінің құрылымына қосылуы керек.% / / Құрылым элементінің кілті сұрау параметрінің атауына сәйкес келуі керек.% / / Параметрлердің құрылымын бөлек жариялаудың қажеті жоқ.% / / Параметрді қосу мысалы:%//сұраудың параметрлері.Кірістіру (""сұраныс параметрінің атауы"", параметрдің мәні); %//жүктелетін құжатқа сілтеме қол жетімді: Құжатжүктеу.'; ro = '// Toți parametrii cererii, cu excepția linkului către documentul încărcat, % / / trebuie să fie incluși în structura parametrilor cererii.% / / Cheia elementului de structură trebuie să se potrivească cu numele parametrului de solicitare.% / / Structura parametrilor de interogare nu trebuie declarată separat.% / / Exemplu de adăugare a unui parametru: % / / parametri de interogare.Inserare (""nume parametru interogare"", valori parametru); %//este disponibil un link către documentul încărcat: documentul de încărcat.'; tr = '//Yüklenmekte olan belgeye bağlantı dışındaki tüm sorgu parametreleri,%//Sorgu parametresi yapısına dahil edilmelidir.%//Yapı öğesi anahtarı, sorgu parametresinin adıyla eşleşmelidir.%//Sorgu parametrelerinin yapısının ayrı ayrı bildirilmesine gerek yoktur.%//Parametre ekleme örneği:%//Sorgu parametresidir.Ekle(""Sorgu parametresinin adı"", Parametrenin değeri); %//Yüklenecek belgeye bir bağlantı mevcuttur: Yükleme için belge.'; uk = '// Всі параметри запиту, крім посилання на вивантажуваний документ,% / / повинні бути включені в структуру Параметризапиту.% / / Ключ елемента структури повинен відповідати імені параметра запиту.% / / Структуру Параметризапиту окремо оголошувати не потрібно.%//Приклад додавання параметра: % / / Параметризапитання.Вставити (""Імяпараметразапроса"", Значеніепараметра); %//Доступна посилання на вивантажується документ: Документдлявигрузкі.'; uz = '// Barcha so''rov parametrlari, yuklanayotgan hujjatga havoladan tashqari,% / / so''rov parametrlari tarkibiga kiritilishi kerak.% / / Tuzilish elementining kaliti so''rov parametrining nomiga mos kelishi kerak.% / / So''rov parametrining tuzilishini alohida e''lon qilishning hojati yo''q.% / / Parametr qo''shish misoli:% / / parametr so''rov.Qo''shish (""parametr so''rovining nomi"", parametrning qiymati); %//yuklanadigan hujjatga havola mavjud: hujjat Yuklamalar.'");
		ТекстКодаПолучениеПараметров = СтрЗаменить(ТекстКодаПолучениеПараметров, "%", Символы.ПС);
	Конецесли;
	Подсказка = НСтр("ru = 'Введите код для получения параметров запроса';
						|en = 'Enter the code to get the request parameters'; be = 'Увядзіце код для атрымання параметраў запыту'; es = 'Introduzca el código para obtener los parámetros de consulta'; ka = 'შეიყვანეთ კოდი მოთხოვნის პარამეტრების მისაღებად'; kk = 'Сұрау параметрлерін алу үшін кодты енгізіңіз'; ro = 'Introduceți codul pentru a obține parametrii de solicitare'; tr = 'Sorgu parametrelerini almak için kodu girin'; uk = 'Введіть код для отримання параметрів запиту'; uz = 'So''rov parametrlarini olish uchun kodni kiriting'");
	ПоказатьВводСтроки(ОповещениеВводаТекстаЗапроса, ТекстКодаПолучениеПараметров, Подсказка, , Истина); 
КонецПроцедуры

&НаКлиенте 
Процедура РедактироватьТекстЗапросаНажатие(Элемент)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_РедактированиеТекстаЗапроса = ПолучитьФорму("ОФ_ФормаСлужебная_РедактированиеТекстаЗапроса", ЭтаФорма);
	#Иначе
		ФормаСлужебная_РедактированиеТекстаЗапроса = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_РедактированиеТекстаЗапроса", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_РедактированиеТекстаЗапроса.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;	
	#КонецЕсли
	
	ФормаСлужебная_РедактированиеТекстаЗапроса.ТекстЗапроса = ТекстЗапросаВыгрузкиНаТСД;
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_РедактированиеТекстаЗапросаЗакрытие",ЭтаФорма);
	ФормаСлужебная_РедактированиеТекстаЗапроса.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		РезультатРедактирования = ФормаСлужебная_РедактированиеТекстаЗапроса.ОткрытьМодально();
		ФормаСлужебная_РедактированиеТекстаЗапросаЗакрытие(РезультатРедактирования,"");
	#Иначе
		ФормаСлужебная_РедактированиеТекстаЗапроса.Открыть();
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ") + ?(Не ПустаяСтрока(ИмяТабличнойЧасти1С), "_" + ?(ИмяТабличнойЧасти1С = "(Запрос)", "Запрос", ИмяТабличнойЧасти1С), "");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаПриИзменении(Элемент)
	
	ИмяОбработчика = СтрЗаменить(Элемент.Имя, "Обработчик_", "");
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаВыгрузки(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаВыгрузки(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьПредставлениеДокументаПриВыгрузкеПриИзменении(Элемент)
	ОбновитьШаблон();
КонецПроцедуры

&НаКлиенте
Процедура СброситьПользовательскуюНастройкуНажатие(Элемент)
	
	ВидОбработчика = СтрЗаменить(Элемент.Имя, "Сбросить", "");
	
	пЗаголовок = НСтр("ru = 'Восстановить настройку обработчика по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройка обработчика будет сброшена к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение", ЭтаФорма, ВидОбработчика);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура Подсказки_ЗакрытьПодсказку(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_Подсказки_ЗакрытьПодсказку(ЭтаФорма, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаРеквизитов

// Обработчики ТЧ

&НаКлиенте
Процедура ТаблицаРеквизитовПриИзменении(Элемент)
	
	УстановитьНомераСтрокТаблицыРеквизитов();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные.Типовой Тогда
		
		ИменаДоступныхКолонок = ПолучитьИменаДоступныхКолонокКИзменению();
		Если ИменаДоступныхКолонок.Найти(Поле.Имя) = Неопределено Тогда
			
			пЗаголовок = НСтр("ru = 'Скопировать поле и отключить использование типового?'");
			пСообщение = НСтр("ru = 'Это типовое поле, и его изменение ограничено. Чтобы изменить его, необходимо создать копию и отключить использование типового.'");
			
			ОП = Новый ОписаниеОповещения("ВопросСкопироватьТиповоеПолеЗавершение", ЭтаФорма, ТекДанные);
			ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПриАктивизацииСтроки(Элемент)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДоступностьИзменения = Истина;
		
		Если ЭтоТиповаяНастройка Тогда
			// Т.к доступно множественное выделение, то проверяем каждую строку
			Для каждого ИдСтроки Из Элемент.ВыделенныеСтроки Цикл
				Если ТаблицаРеквизитов.НайтиПоИдентификатору(ИдСтроки).Типовой Тогда
					ДоступностьИзменения = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Элементы.ТаблицаРеквизитовУдалить.Доступность = ДоступностьИзменения;
		Элементы.ТаблицаРеквизитов.ИзменятьПорядокСтрок = ДоступностьИзменения;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПередНачаломИзменения(Элемент, Отказ)
	
	ТекДанные = Элемент.ТекущиеДанные;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяКолонки = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		ИмяКолонки = Элемент.ТекущийЭлемент.Имя;
	#КонецЕсли
	
	Если ИмяКолонки = "ТаблицаРеквизитовСпособСопоставленияСиноним" И НЕ ТекДанные.ТипИсточника = "Реквизит1С" Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ОбновитьВидимостьЭлементовСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.Типовой = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПослеУдаления(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

Процедура ТаблицаРеквизитовПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
	ДанныеСтроки.НомерСтроки = ТаблицаРеквизитов.Индекс(ДанныеСтроки) + 1;
КонецПроцедуры

// Обработчики колонок

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" Тогда
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = ТекущаяСтрока.ИсЗначение;
		ОбновитьВидимостьЭлементовСтроки();
	Иначе	
		НайденныйЭлементСписка = Неопределено;
		Если ТекущаяСтрока.ТипИсточника = "Реквизит1С" Тогда
			НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);
		ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
			НайденныйЭлементСписка = СписокГлобальныхПараметров.НайтиПоЗначению(ТекущаяСтрока.ИсЗначение);			
		КонецЕсли;
		Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение = ПредыдущееЗначение Тогда
			ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
		Иначе
			ТекущаяСтрока.СинонимИсточника = ?(НайденныйЭлементСписка <> Неопределено,НайденныйЭлементСписка.Представление,"");
			ТекущаяСтрока.ИмяИсточника = ?(НайденныйЭлементСписка <> Неопределено,НайденныйЭлементСписка.Значение,"");
			ТекущаяСтрока.ЗначениеИсточника = Неопределено;
		КонецЕсли;
		ТекущаяСтрока.ИсЗначение = ?(НайденныйЭлементСписка <> Неопределено,НайденныйЭлементСписка.Представление,"");
		
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда		
		ТекущаяСтрока.КолонкаВывода = ?(ТекущаяСтрока.ТипИсточника = "Реквизит1С",ТекущаяСтрока.ИмяИсточника,"");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		СтандартнаяОбработка = Ложь;
		ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеКоды", ЭтаФорма);
		#Иначе
			ФормаСписка_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеКоды", , ЭтаФорма, ЭтаФорма);
			ФормаСписка_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаСписка_ПроизвольныеКоды._ЛокКонтекст = _ЛокКонтекст;
		ФормаСписка_ПроизвольныеКоды.КлючНастройки = КлючНастройки;
		ФормаСписка_ПроизвольныеКоды.ТипИсходногоДокумента1С = ТипДокумента1С;
		ФормаСписка_ПроизвольныеКоды.ИмяТабличнойЧасти1С = ИмяТабличнойЧасти1С;
		
		АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
		
		Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = ТаблицаРеквизитовДополнительная;
		ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаШапка = ТаблицаРеквизитовДополнительная;
			ФормаСписка_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		КонецЕслИ;
		ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыЗакрытие",ЭтаФорма,ПредыдущееЗначение);
		ФормаСписка_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаСписка_ПроизвольныеКоды.ОткрытьМодально();
		#Иначе
			ФормаСписка_ПроизвольныеКоды.Открыть();
		#КонецЕсли
				
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение" Тогда
		 Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекущаяСтрока.ИсЗначение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
		
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
	Элемент.СписокВыбора.Очистить();
	
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = ?(НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекущаяСтрока.ТипИсточника = "ПроизвольноеЗначение";
	
	Если ТекущаяСтрока.ТипИсточника = "Реквизит1С" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокРеквизитов1С);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ПроизвольныйКод" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокПроизвольныхКодов);
	ИначеЕсли ТекущаяСтрока.ТипИсточника = "ГлобальныйПараметр" Тогда
		ЗаполнитьСписокВыбора(Элемент,СписокГлобальныхПараметров);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИсЗначениеОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ЗначениеИсточника = Неопределено;
	Элементы.ТаблицаРеквизитов.ТекущиеДанные.ИсЗначение = Неопределено;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПрЗначениеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;	
	Если ТекущаяСтрока.ТипПриемника = "НовыйРеквизит" Тогда
		ТекущаяСтрока.ИмяПриемника = ТекущаяСтрока.ПрЗначение;
	ИначеЕсли ТекущаяСтрока.ТипПриемника = "РеквизитMS" Тогда
		НайденныйЭлементСписка = Неопределено;
		Для каждого РеквизитMS из СписокРеквизитовMS Цикл
			Если РеквизитMS.Ключ = ТекущаяСтрока.ПрЗначение Тогда
				Если ТипЗнч(РеквизитMS) = Тип("Структура")
					И РеквизитMS.Свойство("Ключ") Тогда
					НайденныйЭлементСписка = Новый Структура("Значение,Представление, Имя",РеквизитMS.Значение,РеквизитMS.Ключ, РеквизитMS.Имя);
				Иначе
					НайденныйЭлементСписка = РеквизитMS;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НайденныйЭлементСписка = Неопределено Тогда
			ТекущаяСтрока.ИмяПриемника = "";
		Иначе
			ТекущаяСтрока.СинонимПриемника = НайденныйЭлементСписка.Представление;
			ТекущаяСтрока.ИмяПриемника = НайденныйЭлементСписка.Имя;
		КонецЕсли;
	КонецЕсли;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		ТаблицаРеквизитовИспользоватьВПредставленииПриИзменении(Элемент);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовТипПриемникаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповПриемника.НайтиПоЗначению(ТекущаяСтрока.ТипПриемникаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипПриемникаСиноним = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ТипПриемника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимПриемника = "";
		ТекущаяСтрока.ИмяПриемника = "";
		ТекущаяСтрока.ПрЗначение = "";
	КонецЕсли;
	
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	ОбновитьВидимостьЭлементовСтроки();
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовТипПриемникаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипПриемника;
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовСинонимПриемникаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	НайденныйЭлементСписка = Неопределено;
	Если ТекущаяСтрока.ТипПриемника = "РеквизитMS" Тогда
		НайденныйЭлементСписка = Неопределено;
		Для каждого РеквизитMS из СписокРеквизитовMS Цикл
			Если РеквизитMS.Значение = ТекущаяСтрока.СинонимПриемника Тогда
				НайденныйЭлементСписка = Новый Структура("Значение,Представление",РеквизитMS.Значение,РеквизитMS.Ключ);	
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ИмяПриемника = "";
	Иначе
		ТекущаяСтрока.СинонимПриемника = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ИмяПриемника = НайденныйЭлементСписка.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовСинонимПриемникаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ИмяИсточника;
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовТипИсточникаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокТиповИсточника.НайтиПоЗначению(ТекущаяСтрока.ТипИсточникаСиноним);
	
	Если НайденныйЭлементСписка <> Неопределено Тогда
		ТекущаяСтрока.ТипИсточникаСиноним = НайденныйЭлементСписка.Представление;
	КонецЕсли;
	
	Если НайденныйЭлементСписка <> Неопределено И НайденныйЭлементСписка.Значение <> ПредыдущееЗначение Тогда
		ТекущаяСтрока.ТипИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.ЗначениеИсточника = Неопределено;
		ТекущаяСтрока.ИсЗначение = Неопределено;
	КонецЕсли;
	
	// Способ сопоставления
	Если ТекущаяСтрока.ТипИсточника = "Реквизит1С" Тогда
		ТекущаяСтрока.СпособСопоставления = "";
		ТекущаяСтрока.СпособСопоставленияСиноним = "";
	Иначе
		ТекущаяСтрока.СпособСопоставления = "КакЕсть";
		ТекущаяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
	КонецЕсли;	
	
	текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
	#Иначе
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
	#КонецЕсли
	
	ОбновитьВидимостьЭлементовСтроки();	
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовТипИсточникаСинонимНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ПредыдущееЗначение = ТекущаяСтрока.ТипИсточника;
	
КонецПроцедуры

&НаКлиенте 
Процедура ТаблицаРеквизитовСпособСопоставленияСинонимПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	НайденныйЭлементСписка = СписокСпособовСопоставления.НайтиПоЗначению(ТекущаяСтрока.СпособСопоставленияСиноним);
	
	ТекущаяСтрока.СпособСопоставления = НайденныйЭлементСписка.Значение;
	ТекущаяСтрока.СпособСопоставленияСиноним = НайденныйЭлементСписка.Представление;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИспользоватьВПредставленииПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущаяСтрока.ИспользоватьВПредставлении = Истина Тогда
			
			UniРеквизита = "";
			Для Каждого РеквизитМС Из СписокРеквизитовMS Цикл
				Если РеквизитМС.Значение = ТекущаяСтрока.ИмяПриемника Тогда
					UniРеквизита = РеквизитМС.Uni;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если UniРеквизита = "" Тогда 
				UniРеквизита = _ЛокКонтекст.ЛокЯдро_СтрокуВТранслитENG(ТекущаяСтрока.ИмяПриемника);
			КонецЕсли;
			
			ШаблонРеквизита = "{item."+UniРеквизита+"}";
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ШаблонВПредставлении) 
				Или _ЛокКонтекст.ЛокЯдро_СтрНайти(ТекущаяСтрока.ШаблонВПредставлении,ШаблонРеквизита) = 0 Тогда
				ТекущаяСтрока.ШаблонВПредставлении = ШаблонРеквизита;
			КонецЕсли;
		КонецЕсли;
	ОбновитьШаблон();
КонецПроцедуры

