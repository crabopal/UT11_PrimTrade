&НаКлиенте
Процедура ОбновитьОтображениеПриОткрытии()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Для каждого КлючЗначение Из СтруктураВидовОбработчиков Цикл
			УстановитьВидимостьКнопкиСброситьОбработчик(КлючЗначение.Значение.Тип);
		КонецЦикла;
		
		Элементы.ДекорацияПредупреждение.Видимость 					= ЭтоТиповаяНастройка;
		Элементы.ВосстановитьТиповыеНастройки.Видимость 			= ЭтоТиповаяНастройка;
		Элементы.ВосстановитьТиповуюТаблицуРеквизитов.Видимость 	= ЭтоТиповаяНастройка;
		Элементы.РедактироватьТекстЗапроса.Доступность 				= НЕ ЭтоТиповаяНастройка;
		Элементы.ПараметрыЗапроса.Доступность 						= НЕ ЭтоТиповаяНастройка;
		
		Элементы.ТаблицаРеквизитовПредставлениеРеквизита.Видимость 		= КлючНастройки = "Выгрузка_ШапкаДокумента";
		Элементы.ТаблицаРеквизитовИспользоватьВПредставлении.Видимость 	= КлючНастройки = "Выгрузка_ШапкаДокумента";
		Элементы.ТаблицаРеквизитовШаблонВПредставлении.Видимость 		= КлючНастройки = "Выгрузка_ШапкаДокумента";
		
	#КонецЕсли
	
	Подсказки_УстановитьВидимостьПодсказок();
	УстановитьНомераСтрокТаблицыРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура Подсказки_УстановитьВидимостьПодсказок()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	// Подсказка: ПереопределениеТиповыхПолей
	ГруппаПодсказка_ПереопределениеТиповыхПолей = Элементы.Найти("ГруппаПодсказка_ПереопределениеТиповыхПолей");
	Если ГруппаПодсказка_ПереопределениеТиповыхПолей <> Неопределено Тогда
		// Если это пользовательский БП, то скрываем подсказку о типовых полях
		Если НЕ ЭтоТиповаяНастройка Тогда
			ГруппаПодсказка_ПереопределениеТиповыхПолей.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Скрываем группу подсказок, если подсказок нет
	ВидимостьГруппыПодсказки = Ложь;
	Для каждого Подсказка Из Элементы.ГруппаПодсказкиТаблицаРеквизитов_Тело.ПодчиненныеЭлементы Цикл
		Если Подсказка.Видимость Тогда
			ВидимостьГруппыПодсказки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Элементы.ГруппаПодсказкиТаблицаРеквизитов.Видимость = ВидимостьГруппыПодсказки;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭтаФорма.УсловноеОформление.Элементы.Очистить();
	
	ЭлементТиповой = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ИменаДоступныхКолонок = ПолучитьИменаДоступныхКолонокКИзменению();
	
	Для каждого Колонка Из Элементы.ТаблицаРеквизитов.ПодчиненныеЭлементы Цикл
		
		Если ИменаДоступныхКолонок.Найти(Колонка.Имя) = Неопределено Тогда
			ПолеЭлемента = ЭлементТиповой.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	ОтборЭлемента = ЭлементТиповой.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаРеквизитов.Типовой");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементТиповой.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементТиповой.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(140, 140, 140));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопкиСброситьОбработчик(ТипОбработчика)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат;
	#КонецЕсли
	
	ВидОбработчика = "ВидОбработчика_" + ТипОбработчика;
	
	СтруктураОбработчика = СтруктураВидовОбработчиков[ВидОбработчика];
	ИмяОбработчика = СтруктураОбработчика.Обработчик;
	
	ЭлементКнопки = Элементы.Найти(ВидОбработчика + "Сбросить");
	Если ЭлементКнопки <> Неопределено Тогда
		
		ЭлементКнопки.Видимость = Ложь;
		
		Если ЭтоТиповаяНастройка Тогда
			
			ТиповыеНастройки = Новый Структура;
			ТиповыеНастройки.Вставить(ВидОбработчика);
			ТиповыеНастройки.Вставить(ИмяОбработчика);
			ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
			
			// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
			Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
				Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
					ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
				КонецЕсли;
			Иначе
				ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
			КонецЕсли;
			
			ТекущиеНастройки = Новый Структура;
			ТекущиеНастройки.Вставить(ВидОбработчика, ЭтаФорма[ВидОбработчика]);
			ТекущиеНастройки.Вставить(ИмяОбработчика, ЭтаФорма[ИмяОбработчика]);
			
			РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(ТиповыеНастройки, ТекущиеНастройки);
			ЭлементКнопки.Видимость = РезультатСравнения.Изменено;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНомераСтрокТаблицыРеквизитов()
	
	Для каждого СтрокаПоля Из ТаблицаРеквизитов Цикл
        СтрокаПоля.НомерСтроки = ТаблицаРеквизитов.Индекс(СтрокаПоля)+1;    
    КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ОбновитьСписокПроизвольныхКодов(ДопТипОбработки = "")
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Направление = "Выгрузка";
		ТипОбъекта = "Шапка";
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда 
		Направление = "Выгрузка";
		ТипОбъекта = "ТабличнаяЧасть";
	КонецЕсли;
	
	// Формируем список произвольных кодов без обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ТипОбъекта);
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодов", Отбор);
	
	// Формируем список произвольных кодов для обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ?(ПустаяСтрока(ДопТипОбработки), ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков(), ДопТипОбработки));
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодовОбработчиков", Отбор);	
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьСписокПроизвольныхКодов(ИмяСписка, Отбор)
		
	ЭтаФорма[ИмяСписка].Очистить();
	
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЭтаФорма[ИмяСписка].Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтаФорма[ИмяСписка].Количество() = 0 Тогда
		ЭтаФорма[ИмяСписка].Добавить("");
	КонецЕсли;
		
КонецПроцедуры

