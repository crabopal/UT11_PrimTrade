&НаКлиенте
Функция ПроверитьКорректностьЗаполненияПолей()

	КонтрольПройден = Истина;
	
	МассивПроверяемыхКолонок = Новый Массив;
	МассивПроверяемыхКолонок.Добавить("ТипПриемникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ПрЗначение");
	МассивПроверяемыхКолонок.Добавить("ТипИсточникаСиноним");
	МассивПроверяемыхКолонок.Добавить("ИсЗначение");
	
	ИндексыПроверенныхСтрок = Новый Массив;
	Индекс = ТаблицаРеквизитов.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		ОтмеченнаяСтрока = ТаблицаРеквизитов[Индекс];
		
		Если ОтмеченнаяСтрока.Выгружать Тогда
			
			// Проверка заполнения полей
			Для Каждого ПроверяемаяКолонка Из МассивПроверяемыхКолонок Цикл
				
				ПроверяемоеЗначение = ОтмеченнаяСтрока[ПроверяемаяКолонка];
				Если Не ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда
					
					#Если Не ТолстыйКлиентОбычноеПриложение Тогда
						
						ЭлементФормы = ЭтаФорма.Элементы.Найти("ТаблицаРеквизитов" + ПроверяемаяКолонка);
						Если ЭлементФормы <> Неопределено Тогда
							ЗаголовокКолонки = ЭлементФормы.Заголовок;
						Иначе
							ЗаголовокКолонки = ПроверяемаяКолонка;
						КонецЕсли;
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Не заполнено значение в колонке %2'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ЗаголовокКолонки);
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = Текст;
						Сообщение.Поле = "ТаблицаРеквизитов[" + Индекс + "]." + ПроверяемаяКолонка;
						Сообщение.УстановитьДанные(ЭтаФорма);
						Сообщение.Сообщить(); 
						
					#Иначе
						
						ЗаголовокКолонки = ТаблицаРеквизитов.Колонки[ПроверяемаяКолонка].Заголовок;
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Не заполнено значение в колонке %2'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ЗаголовокКолонки);
						ПоказатьПредупреждение(, Текст); 
						
					#КонецЕсли
					
					КонтрольПройден = Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
			
			// Проверка дублей
			// Пропускаем проверку для ключей связи, они могут дублироваться
			Если НЕ (ОтмеченнаяСтрока.ТипИсточника = "РеквизитMS" И Найти(ОтмеченнаяСтрока.СинонимИсточника, "Ключ связи для """) > 0) 
				И ИндексыПроверенныхСтрок.Найти(Индекс) = Неопределено Тогда
				
				ДублиСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Выгружать, ИмяПриемника", Истина,  ОтмеченнаяСтрока.ИмяПриемника));
				Если ДублиСтроки.Количество() > 1 Тогда
					
					КонтрольПройден = Ложь;
					НомераСтрок = "";
					Для каждого ДубльСтроки Из ДублиСтроки Цикл
						
						ИндексДубля = ТаблицаРеквизитов.Индекс(ДубльСтроки);
						ИндексыПроверенныхСтрок.Добавить(ИндексДубля);
						
						Если ИндексДубля <> Индекс Тогда
							
							Если НомераСтрок = "" Тогда
								НомераСтрок = НомераСтрок + (ИндексДубля + 1);
							Иначе
								НомераСтрок = НомераСтрок + ", " + (ИндексДубля + 1);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					#Если Не ТолстыйКлиентОбычноеПриложение Тогда
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Имя приемника «%2» уже используется в строках: %3. Отключите или удалетие дублирующие строки.'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ОтмеченнаяСтрока.ИмяПриемника, НомераСтрок);
						
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = Текст;
						Сообщение.Поле = "ТаблицаРеквизитов[" + Индекс + "].ПрЗначение";
						Сообщение.УстановитьДанные(ЭтаФорма);
						Сообщение.Сообщить();
						
					#Иначе
						
						НомерСтроки = Индекс + 1;
						Текст = НСтр("ru = 'Строка %1. Имя приемника «%2» уже используется в строках: %3. Отключите или удалетие дублирующие строки.'");
						Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, НомерСтроки, ОтмеченнаяСтрока.ИмяПриемника, НомераСтрок);
						
						ПоказатьПредупреждение(, Текст); 
						
					#КонецЕсли
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
		
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков()
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПередВыгрузкойДокумента");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиДокумента");
	МассивТиповОбъектов.Добавить("ПослеОтправкиДокумента");
	МассивТиповОбъектов.Добавить("ПередВыгрузкойТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиТЧ");	
	МассивТиповОбъектов.Добавить("ПередВыгрузкойСтрокиТЧ");
	МассивТиповОбъектов.Добавить("ПослеВыгрузкиСтрокиТЧ");	

	Возврат МассивТиповОбъектов;
	
КонецФункции

&НаКлиенте
Процедура ВидОбработчика_ЗаполнениеПоУмолчанию()
	
	// Для корректной интеграции в существующие настройки в случае заполненности обработчика устанавливаем его вид как "Свой обработчик"
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойДокумента");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиДокумента");		
		МассивИменРеквизитов.Добавить("Обработчик_ПослеОтправкиДокумента");		
		
		ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);
		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		
		МассивИменРеквизитов = Новый Массив;
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти");
		МассивИменРеквизитов.Добавить("Обработчик_ПослеВыгрузкиТабличнойЧасти");
		
		ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов)
	
	Для Каждого РеквизитОбработчика Из МассивИменРеквизитов Цикл
		
		РеквизитВидаОбработчика = СтрЗаменить(РеквизитОбработчика, "Обработчик", "ВидОбработчика");
		Если Не ПустаяСтрока(ЭтаФорма[РеквизитОбработчика]) Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма[РеквизитВидаОбработчика]) Тогда
				ЭтаФорма[РеквизитВидаОбработчика] = 2; // "Свой обработчик"
			КонецЕсли;
		Иначе
			ЭтаФорма[РеквизитВидаОбработчика] = 0; // "Без обработчика"
		КонецЕсли;
		
		Если ЭтаФорма[РеквизитВидаОбработчика] = 3 Тогда // "Произвольный код"
			
			// В обычных формах подменяем поле ввода обарботчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[РеквизитОбработчика].Видимость 			= Ложь;				
				Элементы[РеквизитОбработчика + "Выбор"].Видимость 	= Истина;					
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика + "Выбор"], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика + "Выбор"], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#Иначе
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#КонецЕсли
		Иначе 
			УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
		КонецЕсли;		

		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы[РеквизитВидаОбработчика].Значение = ЭтаФорма[РеквизитВидаОбработчика];
		#КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокаОбработчика, ЗначениеСтрокаОбработчика, КодВидаОбработчика)
	
	БезЗаполнения	= КодВидаОбработчика = 0;
	ПоУмолчанию		= КодВидаОбработчика = 1;
	СвойОбработчик	= КодВидаОбработчика = 2;	
	ПроизвольныйКод	= КодВидаОбработчика = 3;

	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСтрокаОбработчика.РежимВыбораИзСписка	= ПроизвольныйКод;				
		ЭлементСтрокаОбработчика.КнопкаВыбора 			= ПроизвольныйКод;		    		
		ЭлементСтрокаОбработчика.КнопкаВыпадающегоСписка= Ложь;
	#Иначе
		ЭлементСтрокаОбработчика.Значение				= ЗначениеСтрокаОбработчика;
	#КонецЕсли                                          
	ЭлементСтрокаОбработчика.ТолькоПросмотр 			= ПоУмолчанию Или БезЗаполнения;     				
	ЭлементСтрокаОбработчика.ЦветТекста 				= ?(ПоУмолчанию, WebЦвета.Серый, Новый Цвет(51, 51, 51));
	ЭлементСтрокаОбработчика.Шрифт 						= Новый Шрифт(ЭлементСтрокаОбработчика.Шрифт,,,, ПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеСоответствияВидовОбработчиковВыгрузки()
	
	СтруктураВидовОбработчиков = Новый Структура;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередВыгрузкойДокумента", 				
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередВыгрузкойДокумента", 
				"ПередВыгрузкойДокумента"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеВыгрузкиДокумента", 				
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеВыгрузкиДокумента", 
				"ПослеВыгрузкиДокумента"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеОтправкиДокумента", 				
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеОтправкиДокумента", 
				"ПослеОтправкиДокумента"));
		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти", 	
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти",
				"ПередВыгрузкойСтрокиТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПередВыгрузкойТабличнойЧасти",
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПередВыгрузкойТабличнойЧасти", 
				"ПередВыгрузкойТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти",
			Новый Структура("Обработчик, Тип", 
				"Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти", 
				"ПослеВыгрузкиСтрокиТабличнойЧасти"));
		СтруктураВидовОбработчиков.Вставить(
			"ВидОбработчика_ПослеВыгрузкиТабличнойЧасти",
			Новый Структура("Обработчик, Тип",
				"Обработчик_ПослеВыгрузкиТабличнойЧасти", 
				"ПослеВыгрузкиТабличнойЧасти"));
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьДобавленныхОбработчиков()
	
	КонтрольПройден = Истина;
	
	МассивВидовОбработчиков = Новый Массив;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойДокумента, "ВидОбработчика_ПередВыгрузкойДокумента"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиДокумента, "ВидОбработчика_ПослеВыгрузкиДокумента"));		
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеОтправкиДокумента, "ВидОбработчика_ПослеОтправкиДокумента"));		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойТабличнойЧасти, "ВидОбработчика_ПередВыгрузкойТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти, "ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти, "ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти"));
		МассивВидовОбработчиков.Добавить(
			Новый Структура("Значение, Имя", ВидОбработчика_ПослеВыгрузкиТабличнойЧасти, "ВидОбработчика_ПослеВыгрузкиТабличнойЧасти"));
	КонецЕсли;

	Для Каждого ВидОбработчика Из МассивВидовОбработчиков Цикл
		
		ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Обработчик;
		ТипОбработчика = СтруктураВидовОбработчиков[ВидОбработчика.Имя].Тип;
		
		// Проверка своего обработчика и произвольного кода на пустоту
		Если ВидОбработчика.Значение = 2 Или ВидОбработчика.Значение = 3 Тогда 						
			Если ПустаяСтрока(ЭтаФорма[ИмяОбработчика]) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не заполнен!';
											|en = 'The handler is not full!'; be = 'Апрацоўшчык не запоўнены!'; es = '¡El controlador no está lleno!'; ka = 'დამმუშავებელი არ არის სავსე!'; kk = 'Өңдеуші толық емес!'; ro = 'Manipulatorul nu este plin!'; tr = 'İşleyici dolu değil!'; uk = 'Обробник не заповнений!'; uz = 'Ishlov beruvchi to''ldirilmagan!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не заполнен свой обработчик <%1>!';
												|en = 'Your handler is not filled in <%1>!'; be = 'Ня запоўнены свой апрацоўшчык <%1>!'; es = '¡Su controlador <%1>no está lleno!'; ka = 'თქვენი დამმუშავებელი არ არის შევსებული <%1>!'; kk = 'Сіздің өңдеушіңіз <%1 > толтырылмаған!'; ro = 'Operatorul dvs. nu este completat <%1>!'; tr = 'işleyiciniz <%1> dolu değil!'; uk = 'Не заповнений свій обробник <%1>!'; uz = 'Sizning ishlovchingiz <%1>bilan to''ldirilmagan!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 					
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка своего обработчика на наличие в интеграционной обработке
		Если ВидОбработчика.Значение = 2 Тогда
			СтруктураПараметров = Новый Структура("АдресаПеременных, ДанныеДляЗагрузки_Строка, ДанныеДокументаMS, Док1СОснование, Док1СРезультат, ДокументТСД, СтрокаДокумента, СтрокаНастройки, СтруктураПоискаКлючаСвязи, ТЧ, ТекущиеНастройкиMS");
			РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ЭтаФорма[ИмяОбработчика], СтруктураПараметров);
			
			Если Не РезультатПроверки.Статус Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не найден в подключенной интеграционной обработке!';
											|en = 'The handler was not found in the enabled integration processing!';
											|be = 'Апрацоўшчык не знойдзены ў падключанай інтэграцыйнай апрацоўцы!'; es = '¡El controlador no se encuentra en el procesamiento de integración conectado!'; ka = 'დამმუშავებელი არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде өңдеуші табылмады!'; ro = 'Handler-ul nu a fost găsit în procesarea integrării activate!'; tr = 'Bağlı entegrasyon işlemede işleyici bulunamadı!'; uk = 'Обробник не знайдений у підключеній інтеграційній обробці!'; uz = 'Ishlov beruvchi ulangan integratsiyani qayta ishlashda topilmadi!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не найден свой обработчик <%1> в подключенной интеграционной обработке!';
												|en = 'My handler <%1> was not found in the enabled integration processing!';
												|be = 'Не знойдзены свой апрацоўшчык <%1 > у падключанай інтэграцыйнай апрацоўцы!'; es = '¡No se encontró su controlador <%1 > en el procesamiento de integración conectado!'; ka = 'ჩემი handler <%1> არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде <%1> өңдегіші табылмады!'; ro = 'Handlerul meu <%1> nu a fost găsit în procesarea de integrare activată!'; tr = 'Bağlı entegrasyon işlemede işleyiciniz <%1> bulunamadı!'; uk = 'Не знайдено свого обробника <%1 > у підключеній інтеграційній обробці!'; uz = 'Yoqilgan integratsiyani qayta ishlashda mening ishlovchim <%1 > topilmadi!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли; 			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлемента)
	
	ИмяКлючаНастройки = "";
	
	Если ИмяЭлемента = "Обработчик_ПередВыгрузкойДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеОтправкиДокумента" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеОтправкиДокумента";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередВыгрузкойТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПередВыгрузкойСтрокиТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеВыгрузкиСтрокиТЧ";
	КонецЕсли;		
	
	Возврат ИмяКлючаНастройки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставленияСпискаДокументов1С()
	
	Для каждого Реквизит1С ИЗ СписокРеквизитов1С Цикл
		Если ЗначениеЗаполнено(Реквизит1С.Значение) И НЕ ЗначениеЗаполнено(Реквизит1С.Представление) Тогда
			Реквизит1С.Представление = Реквизит1С.Значение;					
		КонецЕсли;					
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьШаблон()
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		ШаблонИмени = "";
		
		Если ЗаменитьПредставлениеДокументаПриВыгрузке Тогда
			СтрокаШаблона = "";
			ВключенныеРеквизиты = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Выгружать,ИспользоватьВПредставлении", Истина,Истина));
			Для Каждого ВключенныйРеквизит Из ВключенныеРеквизиты Цикл
				СтрокаШаблона = СтрокаШаблона+?(СтрокаШаблона = "",""," ")+ВключенныйРеквизит.ШаблонВПредставлении;
			КонецЦикла;
			ШаблонИмени  = СтрокаШаблона;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, ИмяФормыПК, ТекущееЗначение, ЭтоФормаЭлемента = Ложь) 
	
	ЭтоОбработчикЗаполнения = Ложь;
	ДопКлючНастройки 		= "";
	ДопТипОбработки			= "";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды = ПолучитьФорму("ОФ_" + ИмяФормыПК, ЭтаФорма);
	#Иначе
		Форма_ПроизвольныеКоды = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма." + ИмяФормыПК, , ЭтаФорма, ЭтаФорма);
		Форма_ПроизвольныеКоды.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	Форма_ПроизвольныеКоды._ЛокКонтекст 			= _ЛокКонтекст;
	Если _ЛокКонтекст.ЛокЯдро_СтрНайти(ВРЕГ(ИмяЭлементаОбработки), "ОБРАБОТЧИК_") <> 0 Тогда			
		ДопКлючНастройки							= ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлементаОбработки);
		ДопТипОбработки								= СтрЗаменить(ДопКлючНастройки, "Выгрузка_", "");
		Форма_ПроизвольныеКоды.КлючНастройки 		= ДопКлючНастройки;			
		ЭтоОбработчикЗаполнения						= Истина;			
	Иначе
		Форма_ПроизвольныеКоды.КлючНастройки 		= КлючНастройки;
	КонецЕсли;
	Форма_ПроизвольныеКоды.ТипИсходногоДокумента1С 	= ТипДокумента1С;
	Форма_ПроизвольныеКоды.ИмяТабличнойЧасти1С 		= ИмяТабличнойЧасти1С;
	
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= ТаблицаРеквизитовДополнительная;
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
		Форма_ПроизвольныеКоды.ПравилаОбменаШапка 			= ТаблицаРеквизитовДополнительная;
		Форма_ПроизвольныеКоды.ПравилаОбменаТабличнаяЧасть 	= _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(АдресТаблицыРеквизитов);
	КонецЕслИ;
	
	Если ЭтоФормаЭлемента Тогда
		Форма_ПроизвольныеКоды.ЭтоНоваяНастройка	= Ложь;				
		
		ТаблицаПроизвольныхКодов	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды", Истина);
		ДанныеПроизвольногоКода 	= _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(ТаблицаПроизвольныхКодов, "ID_ПроизвольногоКода", ТекущееЗначение);
		
		ЗаполнитьЗначенияСвойств(Форма_ПроизвольныеКоды, ДанныеПроизвольногоКода);
	КонецЕсли; 
	
	ДопПараметрыОповещения = Новый Структура("ПредыдущееЗначение, СтрокаОбработчика, ДопТипОбработки, ЭтоОбработчикЗаполнения", 
		ТекущееЗначение, 
		ИмяЭлементаОбработки, 
		ДопТипОбработки,
		ЭтоОбработчикЗаполнения);
	
	ОП = Новый ОписаниеОповещения("ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие", ЭтаФорма, ДопПараметрыОповещения);
	Форма_ПроизвольныеКоды.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Форма_ПроизвольныеКоды.ОткрытьМодально();
	#Иначе
		Форма_ПроизвольныеКоды.Открыть();		
	#КонецЕсли 	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуРеквизитов(ДанныеТаблицаРеквизитов)
	
	Для Каждого СтрокаИсходнойТаблицы Из ДанныеТаблицаРеквизитов Цикл
		Если СтрокаИсходнойТаблицы.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
		
		Если ЭтоТиповаяНастройка
			И (НЕ СтрокаИсходнойТаблицы.Свойство("Типовой")
			ИЛИ СтрокаИсходнойТаблицы.Типовой <> Ложь) Тогда
			НоваяСтрока.Типовой = Истина;
		КонецЕсли;
		
		РеквизитMS = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(СписокРеквизитовMS, Новый Структура("Значение", НоваяСтрока.ИмяПриемника), Истина);
		Если РеквизитMS <> Неопределено Тогда
			НоваяСтрока.СинонимПриемника = НоваяСтрока.Ключ;
			НоваяСтрока.ПрЗначение = НоваяСтрока.Ключ;
		КонецЕсли;
		
		// Загрузка старых настроек
		Если СтрокаИсходнойТаблицы.Свойство("ИмяMS") Тогда
			НоваяСтрока.ИмяПриемника = СтрокаИсходнойТаблицы.ИмяMS;
			НайденныйЭлементИмениПриемника = Неопределено;
			Для каждого РеквизитMS из СписокРеквизитовMS Цикл
				Если РеквизитMS.Значение = НоваяСтрока.ИмяПриемника Тогда
					НайденныйЭлементИмениПриемника = Новый Структура("Значение,Представление",РеквизитMS.Значение,РеквизитMS.Ключ);	
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НайденныйЭлементИмениПриемника <> Неопределено Тогда
				НоваяСтрока.СинонимПриемника = НайденныйЭлементИмениПриемника.Представление;
			Иначе
				НоваяСтрока.СинонимПриемника = СтрокаИсходнойТаблицы.ИмяMS;
			КонецЕсли;
			НоваяСтрока.ТипПриемника = "РеквизитMS";
			НоваяСтрока.ТипПриемникаСиноним = "Фиксированный реквизит Mobile SMARTS";
		КонецЕсли;
		
		Если СтрокаИсходнойТаблицы.Свойство("Имя1С") <> Неопределено Тогда
			
			Если СтрокаИсходнойТаблицы.Свойство("Тип") И СтрокаИсходнойТаблицы.Тип = "Реквизит 1С" Тогда
				// ищем в реквизитах
				НайденныйЭлементИмениИсточника = СписокРеквизитов1С.НайтиПоЗначению(СтрокаИсходнойТаблицы.Имя1С);
				Если НайденныйЭлементИмениИсточника <> Неопределено Тогда
					НоваяСтрока.ИмяИсточника = НайденныйЭлементИмениИсточника.Значение;
					НоваяСтрока.СинонимИсточника = НайденныйЭлементИмениИсточника.Представление;
					НоваяСтрока.ТипИсточника = "Реквизит1С";
					НоваяСтрока.ТипИсточникаСиноним = "Реквизит 1С";
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НоваяСтрока.ИмяИсточника) Тогда
					Если СтрокаИсходнойТаблицы.Свойство("ВыгружатьКакUID") Тогда
						Если СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка (GUID)" ИЛИ СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Ссылка(GUID)" Тогда
							НоваяСтрока.СпособСопоставления = "СтрокаGUID";
							НоваяСтрока.СпособСопоставленияСиноним = "Ссылка (строка GUID)";
						ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "По наименованию" Тогда
							НоваяСтрока.СпособСопоставления = "Наименование";
							НоваяСтрока.СпособСопоставленияСиноним = "Наименование (для справочников)";
						ИначеЕсли СтрокаИсходнойТаблицы.ВыгружатьКакUID = "Код" Тогда
							НоваяСтрока.СпособСопоставления = "Код";
							НоваяСтрока.СпособСопоставленияСиноним = "Код (для справочников)";
						Иначе
							НоваяСтрока.СпособСопоставления = "КакЕсть";
							НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли СтрокаИсходнойТаблицы.Свойство("Тип") И (СтрокаИсходнойТаблицы.Тип = "Дата" ИЛИ СтрокаИсходнойТаблицы.Тип = "Число" ИЛИ СтрокаИсходнойТаблицы.Тип = "Строка" ИЛИ СтрокаИсходнойТаблицы.Тип = "Булево") Тогда
				НоваяСтрока.ТипИсточника = "ПроизвольноеЗначение";
				НоваяСтрока.ТипИсточникаСиноним = "Произвольное значение";
				НоваяСтрока.СпособСопоставления = "КакЕсть";
				НоваяСтрока.СпособСопоставленияСиноним = "Как есть (простой тип)";
				НоваяСтрока.ЗначениеИсточника = СтрокаИсходнойТаблицы.Имя1С;
			КонецЕсли;
		КонецЕсли;			
		
	КонецЦикла;
	
	УстановитьНомераСтрокТаблицыРеквизитов();
	
КонецПроцедуры 

&НаКлиенте
Процедура ВосстановитьТиповоеЗначениеНастройки(ИмяНастройки)
	
	ВидОбработчика = ИмяНастройки;
	ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика].Обработчик;
	
	ТиповыеНастройки = Новый Структура;
	ТиповыеНастройки.Вставить(ВидОбработчика);
	ТиповыеНастройки.Вставить(ИмяОбработчика);
	ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
	
	Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		ТиповыеНастройки[ИмяОбработчика] = "";
	КонецЕсли;
	
	// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
	Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
			ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
		КонецЕсли;
	Иначе
		ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
	КонецЕсли;
	
	ЭтаФорма[ВидОбработчика] = ТиповыеНастройки[ВидОбработчика];
	ЭтаФорма[ИмяОбработчика] = ТиповыеНастройки[ИмяОбработчика];
	
	Обработчик_ИзменитьЗначение = Ложь;
	
	ВидОбработчика_ОбработкаПриИзменении(Элементы[ВидОбработчика]);
	Обработчик_ОбработкаПриИзменении(Элементы[ИмяОбработчика]);
	
	Модифицированность = Истина;
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИменаДоступныхКолонокКИзменению()
	
	ДоступныеЭлементы = Новый Массив;
	ДоступныеЭлементы.Добавить("ТаблицаРеквизитовВыгружать");
	ДоступныеЭлементы.Добавить("ТаблицаРеквизитовИспользоватьВПредставлении");
	ДоступныеЭлементы.Добавить("ТаблицаРеквизитовШаблонВПредставлении");
	
	Возврат ДоступныеЭлементы;
	
КонецФункции 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ВведитеТекстКодаПолучениеПараметров(Текст, Контекст) Экспорт
	
	Если ЗначениеЗаполнено(Текст) Тогда
		ТекстКодаПолучениеПараметров = Текст;
	КонецЕсли; 
	
	УстановитьЦветаЭлементов();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСлужебная_РедактированиеТекстаЗапросаЗакрытие(РезультатРедактирования,СтрокаНастройки) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		ТекстЗапросаВыгрузкиНаТСД = СокрЛП(РезультатРедактирования.ТекстЗапроса);
	КонецЕсли;		
	
	СписокРеквизитов1С = фЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);	
	
	УстановитьЦветаЭлементов();	
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыЗакрытие(ВыбранноеЗначение,ПредыдущееЗначение) Экспорт
	ОбновитьСписокПроизвольныхКодов();
	
	Если ВыбранноеЗначение = Неопределено Тогда
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ПредыдущееЗначение);
	Иначе 
		НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ВыбранноеЗначение);
	КонецЕсли;
	ТекущаяСтрока = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ТекущаяСтрока.ИмяИсточника = "";
		ТекущаяСтрока.СинонимИсточника = "";
		ТекущаяСтрока.ИсЗначение = Неопределено;
	Иначе
		ТекущаяСтрока.ИмяИсточника = НайденныйЭлементСписка.Значение;
		ТекущаяСтрока.СинонимИсточника = НайденныйЭлементСписка.Представление;
		ТекущаяСтрока.ИсЗначение = НайденныйЭлементСписка.Представление;
		текСтрока = Элементы.ТаблицаРеквизитов.ТекущаяСтрока;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
		#Иначе
			Элемент = Элементы.ТаблицаРеквизитов.ТекущийЭлемент;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = Неопределено;
			Элементы.ТаблицаРеквизитов.ТекущаяСтрока = текСтрока;
			Элементы.ТаблицаРеквизитов.ТекущийЭлемент = Элемент;
		#КонецЕсли
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ОбновитьСписокПроизвольныхКодов(ДопПараметры.ДопТипОбработки);
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика + "Выбор";
	#Иначе
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	#КонецЕсли      	
	ИмяОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	
	Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.Очистить();
	
	ЗаполнитьСписокВыбора(Элементы[ИмяПоляОбработчикаСобытия], ?(ДопПараметры.ЭтоОбработчикЗаполнения, СписокПроизвольныхКодовОбработчиков, СписокПроизвольныхКодов));	
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	Иначе 
		Если ДопПараметры.ЭтоОбработчикЗаполнения Тогда
			НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ВыбранноеЗначение);
		Иначе
			НайденныйЭлементСписка = СписокПроизвольныхКодов.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;		
	ИначеЕсли Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.НайтиПоЗначению(НайденныйЭлементСписка.Значение) = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;
	Иначе
		ЭтаФорма[ИмяОбработчикаСобытия] = НайденныйЭлементСписка.Значение;
	КонецЕсли;	
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуРеквизитовПоУмолчанию();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьТаблицуРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Индекс = ТаблицаРеквизитов.Количество() - 1;
		Пока Индекс >= 0 Цикл
			
			СтрокаПоля = ТаблицаРеквизитов[Индекс];
			Если НЕ СтрокаПоля.Типовой Тогда		
				ТаблицаРеквизитов.Удалить(Индекс);		
			КонецЕсли;
			
			Индекс = Индекс - 1;
			
		КонецЦикла;
		
		УстановитьНомераСтрокТаблицыРеквизитов();
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросВосстановитьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
			
			ЗаменитьПредставлениеДокументаПриВыгрузке 	= СтруктураНастроекТиповая.ЗаменитьПредставлениеДокументаПриВыгрузке;
			
		ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
			
			ТекстЗапросаВыгрузкиНаТСД        = СтруктураНастроекТиповая.ТекстЗапросаВыгрузкиНаТСД;
			ТекстКодаПолучениеПараметров     = СтруктураНастроекТиповая.ТекстКодаПолучениеПараметров;
			
		КонецЕсли;
		
		Для каждого КлючЗначение Из СтруктураВидовОбработчиков Цикл
			ВосстановитьТиповоеЗначениеНастройки(КлючЗначение.Ключ);
		КонецЦикла;
		
		ВопросВосстановитьТиповуюТаблицуРеквизитовЗавершение(КодВозвратаДиалога.Да, Неопределено);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение(Результат, ИмяНастройки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВосстановитьТиповоеЗначениеНастройки(ИмяНастройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповуюТаблицуРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТаблицаРеквизитов.Очистить();
		
		Если КлючНастройки = "Выгрузка_ШапкаДокумента"
			И СтруктураНастроекТиповая.Свойство("НастройкаВыгрузкиПолей") 
			И ТипЗнч(СтруктураНастроекТиповая.НастройкаВыгрузкиПолей) = Тип("Массив") Тогда
			
			ЗаполнитьТаблицуРеквизитов(СтруктураНастроекТиповая.НастройкаВыгрузкиПолей);
			
		ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента"
			И СтруктураНастроекТиповая.Свойство("ТабличнаяЧастьДокумента1С") 
			И ТипЗнч(СтруктураНастроекТиповая.ТабличнаяЧастьДокумента1С) = Тип("Массив")Тогда
			
			ЗаполнитьТаблицуРеквизитов(СтруктураНастроекТиповая.ТабличнаяЧастьДокумента1С);
			
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСкопироватьТиповоеПолеЗавершение(Результат, ТекущиеДанные) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
		НоваяСтрока.Типовой = Ложь;
		НоваяСтрока.Выгружать = Истина;
		Элементы.ТаблицаРеквизитов.ТекущаяСтрока = ТаблицаРеквизитов.Количество()-1;
		
		ТекущиеДанные.Выгружать = Ложь;
		УстановитьНомераСтрокТаблицыРеквизитов();
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

