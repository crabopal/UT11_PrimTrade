&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент,Список, ПолеЗначения = "Значение", ПолеПредставления = "Ключ")
	
	Приемник = Элемент.СписокВыбора;
	Если ТипЗнч(Список) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем[ПолеЗначения], Элем[ПолеПредставления]);	
		КонецЦикла;
		Приемник.СортироватьПоЗначению();
	Иначе
		Для Каждого Элем Из Список Цикл
			Приемник.Добавить(Элем.Значение, Элем.Представление);
		КонецЦикла;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ТипЗнч(Элемент) = Тип("ПолеВыбора") Тогда
			Элемент.РежимВыбораИзСписка = Истина;
			Элемент.КнопкаСпискаВыбора = Истина;
		КонецЕсли;		
	#Иначе
		Элемент.РежимВыбораИзСписка = Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;		
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	ТаблицаРеквизитов.Сортировать("Типовой Убыв"); // Сортируем, т.к типовые поля всегда должны быть сверху
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = ТаблицаРеквизитов.Скопировать();
	#Иначе
		ТЗ = ТаблицаРеквизитов.Выгрузить();
	#КонецЕсли
	
	ТЗ.Колонки.Удалить("НомерСтроки");
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(ТЗ);
	#Иначе
		Возврат ПоместитьВоВременноеХранилище(ТЗ, ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовСтроки()
	ТекДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Элементы.ТаблицаРеквизитовИсЗначение.СписокВыбора.Очистить();
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаСпискаВыбора = ?(НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение",Истина,Ложь);
	#Иначе
		Элементы.ТаблицаРеквизитовИсЗначение.КнопкаВыпадающегоСписка = ?(НЕ ТекДанные.ТипИсточника = "ПроизвольноеЗначение",Истина,Неопределено);
	#КонецЕсли
	
	Элементы.ТаблицаРеквизитовИсЗначение.РежимВыбораИзСписка = ?(НЕ (ТекДанные.ТипИсточника = "ПроизвольноеЗначение"),Истина,Ложь);
	Элементы.ТаблицаРеквизитовИсЗначение.КнопкаОчистки = ТекДанные.ТипИсточника = "ПроизвольноеЗначение";
	Если ТекДанные.ТипИсточника = "Реквизит1С" Тогда
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокРеквизитов1С);
	ИначеЕсли ТекДанные.ТипИсточника = "ПроизвольныйКод" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокПроизвольныхКодов);
	ИначеЕсли ТекДанные.ТипИсточника = "ГлобальныйПараметр" Тогда 
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовИсЗначение,СписокГлобальныхПараметров);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаСпискаВыбора = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#Иначе
		Элементы.ТаблицаРеквизитовПрЗначение.КнопкаВыпадающегоСписка = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
		Элементы.ТаблицаРеквизитовПрЗначение.РежимВыбораИзСписка 	 = НЕ ТекДанные.ТипПриемника = "НовыйРеквизит";
	#КонецЕсли

	Элементы.ТаблицаРеквизитовПрЗначение.СписокВыбора.Очистить();
	
	Если ТекДанные.ТипПриемника = "НовыйРеквизит" Тогда
		
	Иначе
		ЗаполнитьСписокВыбора(Элементы.ТаблицаРеквизитовПрЗначение,СписокРеквизитовMS, "Ключ", "Ключ");
	КонецЕсли;
	Элементы.ТаблицаРеквизитовИсЗначение.ВыбиратьТип = ТекДанные.ИсЗначение = Неопределено И ТекДанные.ТипИсточника = "ПроизвольныйКод";
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуРеквизитовПоУмолчанию()
		
	ТаблицаРеквизитов.Очистить();
	
	ЕстьЭлементИд = Ложь;
	ЕстьЭлементИдСклада = Ложь;
	ЕстьЭлементВыдаватьПоШтрихкоду = Ложь;
	ЕстьЭлементИдКонтрагента = Ложь;
	ЕстьЭлементИдСклада1С = Ложь;    
	ЕстьЭлементИдСклада1СОткуда = Ложь; 
	ЕстьЭлементИдСклада1СКуда = Ложь;
	ЕстьЭлементИдТовара = Ложь;
	ЕстьЭлементИдУпаковки = Ложь;
	ЕстьЭлементИдЕдиницыИзмерения = Ложь;
	ЕстьЭлементИдХарактеристики = Ложь;
	ЕстьЭлементИдСерии = Ложь;
	ЕстьЭлементИмяСерии = Ложь;
	ЕстьЭлементКоличествоПлан = Ложь;
	ЕстьЭлементЦена = Ложь;
	Для каждого РеквизитMS из СписокРеквизитовMS Цикл
		Если РеквизитMS.Значение = "Ид" Тогда
			ЕстьЭлементИд = Истина;	
		ИначеЕсли РеквизитMS.Значение = "ИдСклада" Тогда
			ЕстьЭлементИдСклада = Истина;
		ИначеЕсли РеквизитMS.Значение = "ВыдаватьПоШтрихкоду" Тогда
			ЕстьЭлементВыдаватьПоШтрихкоду = Истина;
		ИначеЕсли РеквизитMS.Значение = "ИдКонтрагента" Тогда
			ЕстьЭлементИдКонтрагента = Истина;
		ИначеЕсли РеквизитMS.Значение = "ИдСклада1С" Тогда
			ЕстьЭлементИдСклада1С = Истина;
		ИначеЕсли РеквизитMS.Значение = "ИдСклада1СОткуда" Тогда
			ЕстьЭлементИдСклада1СОткуда = Истина;  
		ИначеЕсли РеквизитMS.Значение = "ИдСклада1СКуда" Тогда
			ЕстьЭлементИдСклада1СКуда = Истина;    
		ИначеЕсли РеквизитMS.Значение = "ИдТовара" Тогда
			ЕстьЭлементИдТовара = Истина;              
		ИначеЕсли РеквизитMS.Значение = "ИдУпаковки" Тогда
			ЕстьЭлементИдУпаковки = Истина;    
		ИначеЕсли РеквизитMS.Значение = "ИдЕдиницыИзмерения" Тогда
			ЕстьЭлементИдЕдиницыИзмерения = Истина; 
		ИначеЕсли РеквизитMS.Значение = "ИдХарактеристики" Тогда
			ЕстьЭлементИдХарактеристики = Истина;
		ИначеЕсли РеквизитMS.Значение = "ИдСерии" Тогда
			ЕстьЭлементИдСерии = Истина;
		ИначеЕсли РеквизитMS.Значение = "ИмяСерии" Тогда
			ЕстьЭлементИмяСерии = Истина;   
		ИначеЕсли РеквизитMS.Значение = "КоличествоПлан" Тогда
			ЕстьЭлементКоличествоПлан = Истина;
		ИначеЕсли РеквизитMS.Значение = "Цена" Тогда
			ЕстьЭлементЦена = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда // заполнить реквизиты шапки									
		
		// ************************** Ссылка -> Ид ***************************************
		Если СписокРеквизитов1С.НайтиПоЗначению("Ссылка") <> Неопределено
			И ЕстьЭлементИд Тогда
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "Ид";
			НоваяСтрока.СинонимПриемника 			= "Ид";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";
			НоваяСтрока.ИмяИсточника 				= "Ссылка";
			НоваяСтрока.СинонимИсточника 			= "Ссылка";		
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";		
			
		КонецЕсли;
		
		// ************************** 1 -> ИдСклада ***************************************
		
		Если ЕстьЭлементИдСклада Тогда
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдСклада";
			НоваяСтрока.СинонимПриемника 			= "ИдСклада";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "ПроизвольноеЗначение";
			НоваяСтрока.ТипИсточникаСиноним			= "Произвольное значение";
			НоваяСтрока.ИмяИсточника 				= "";
			НоваяСтрока.СинонимИсточника 			= "";		
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "1";		
			
			НоваяСтрока.СпособСопоставления			= "КакЕсть";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Как есть (простой тип)";
			
			НоваяСтрока.Комментарий 				= "";			
			
		КонецЕсли;
		
		// ************************** Истина -> ВыдаватьПоШтрихкоду ***************************************
		
		Если ЕстьЭлементВыдаватьПоШтрихкоду Тогда
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ВыдаватьПоШтрихкоду";
			НоваяСтрока.СинонимПриемника 			= "ВыдаватьПоШтрихкоду";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "ПроизвольноеЗначение";
			НоваяСтрока.ТипИсточникаСиноним			= "Произвольное значение";
			НоваяСтрока.ИмяИсточника 				= "";
			НоваяСтрока.СинонимИсточника 			= "";		
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= Истина;		
			
			НоваяСтрока.СпособСопоставления			= "КакЕсть";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Как есть (простой тип)";
			
			НоваяСтрока.Комментарий 				= "";					
			
		КонецЕсли;
		
		// ************************** Контрагент -> ИдКонтрагента ***************************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("Контрагент") <> Неопределено
			И ЕстьЭлементИдКонтрагента Тогда
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдКонтрагента";
			НоваяСтрока.СинонимПриемника 			= "ИдКонтрагента";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";
			НоваяСтрока.ИмяИсточника 				= "Контрагент";
			НоваяСтрока.СинонимИсточника 			= "Контрагент";		
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";							
			
		КонецЕсли;
		
		// ************************** Склад -> ИдСклада1С ***************************************
		
		Если (СписокРеквизитов1С.НайтиПоЗначению("Склад") <> Неопределено ИЛИ СписокРеквизитов1С.НайтиПоЗначению("СкладОрдер") <> Неопределено)
			И ЕстьЭлементИдСклада1С Тогда		
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдСклада1С";
			НоваяСтрока.СинонимПриемника 			= "ИдСклада1С";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";
			
			Если СписокРеквизитов1С.НайтиПоЗначению("Склад") <> Неопределено Тогда		
				НоваяСтрока.ИмяИсточника 			= "Склад";
				НоваяСтрока.СинонимИсточника 		= "Склад";		
			ИначеЕсли СписокРеквизитов1С.НайтиПоЗначению("СкладОрдер") <> Неопределено Тогда
				НоваяСтрока.ИмяИсточника 			= "СкладОрдер";
				НоваяСтрока.СинонимИсточника 		= "Склад-ордер";		
			КонецЕсли;	
			
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";		
			
		КонецЕсли;
		
		// ************************** СкладОтправитель -> ИдСклада1СОткуда ***************************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("СкладОтправитель") <> Неопределено
			И ЕстьЭлементИдСклада1СОткуда Тогда		
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдСклада1СОткуда";
			НоваяСтрока.СинонимПриемника 			= "ИдСклада1СОткуда";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";		
			НоваяСтрока.ИмяИсточника 				= "СкладОтправитель";
			НоваяСтрока.СинонимИсточника 			= "Склад отправитель";			
			
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";		
			
		КонецЕсли;		
		
		// ************************** СкладПолучатель -> ИдСклада1СКуда ***************************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("СкладПолучатель") <> Неопределено
			И ЕстьЭлементИдСклада1СКуда Тогда		
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдСклада1СКуда";
			НоваяСтрока.СинонимПриемника 			= "ИдСклада1СКуда";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";		
			НоваяСтрока.ИмяИсточника 				= "СкладПолучатель";
			НоваяСтрока.СинонимИсточника 			= "Склад получатель";			
			
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";		
			
		КонецЕсли;
		
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда // заполнить реквизиты ТЧ
		
		// ************************** Номенклатура -> ИдТовара ***************************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("Номенклатура") <> Неопределено
			И ЕстьЭлементИдТовара Тогда
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			
			НоваяСтрока.Выгружать 					= Истина;
			
			НоваяСтрока.ТипПриемника				= "РеквизитMS";		
			НоваяСтрока.ТипПриемникаСиноним 		= "Фиксированный реквизит Mobile SMARTS";				
			НоваяСтрока.ИмяПриемника 				= "ИдТовара";
			НоваяСтрока.СинонимПриемника 			= "ИдТовара";
			НоваяСтрока.ИмяЗначениеПриемника 		= "";
			
			НоваяСтрока.ТипИсточника 				= "Реквизит1С";
			НоваяСтрока.ТипИсточникаСиноним			= "Реквизит 1С";
			НоваяСтрока.ИмяИсточника 				= "Номенклатура";
			НоваяСтрока.СинонимИсточника 			= "Номенклатура";		
			НоваяСтрока.ИмяЗначениеИсточника 		= "";		
			НоваяСтрока.ЗначениеИсточника			= "";		
			
			НоваяСтрока.СпособСопоставления			= "СтрокаGUID";		
			НоваяСтрока.СпособСопоставленияСиноним 	= "Ссылка (строка GUID)";
			
			НоваяСтрока.Комментарий 				= "";		
			
		КонецЕсли;				
		
		// ********************* ЕдиницаИзмерения -> ИдУпаковки, ИдЕдиницыИзмерения **************************
		
		Если СписокРеквизитов1С.НайтиПоЗначению("ЕдиницаИзмерения") <> Неопределено Тогда						
			
			Если ЕстьЭлементИдУпаковки Тогда
				
				НоваяСтрока = ТаблицаРеквизитов.Добавить();
				
				НоваяСтрока.Выгружать 					= Истина;
				
