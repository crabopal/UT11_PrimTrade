/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
 	СохраненныйРежимОтладки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РежимОтладки");
	Если  СохраненныйРежимОтладки <> Ложь
		И СохраненныйРежимОтладки <> Неопределено Тогда
		РежимОтладки = СохраненныйРежимОтладки;
	Иначе
		РежимОтладки = "ТолькоОшибки";
	КонецЕсли;
	
	ЛогРежимОтладкиES = _ЛокКонтекст.Логирование_ПолучитьРежимОтладкиES();
	
	ОбновитьЦветРежимаОтладки();
	РаботаБезАлкоголя 					= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РаботаБезАлкоголя");
	НеУдалятьДокументПослеЗавершения 	= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НеУдалятьДокументПослеЗавершения");
	
	// Закомментировано. Сжатие используем всегда
	// ОтключитьСжатиеДанных = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("ОтключитьСжатиеДанных");
	// _ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьСжатиеДанных", ОтключитьСжатиеДанных);
	
	ОтключитьРаботуВФоне = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ОтключитьРаботуВФоне");
	
	ОтключитьОбновление_ОсновнаяОбработка 		= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ОсновнаяОбработка");
	ОтключитьОбновление_ИнтеграционнаяОбработка = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка");
	ОтключитьРаботуСКнопкамиОбмена				= _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ОтключитьРаботуСКнопкамиОбмена",,, Истина);
	ВключитьРаботуСКнопкамиОбмена = Не ОтключитьРаботуСКнопкамиОбмена;
	
	СохраненныйВыводитьСообщенияНаТСД = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов");
	Если СохраненныйВыводитьСообщенияНаТСД <> Ложь 
		и Не ПустаяСтрока(СохраненныйВыводитьСообщенияНаТСД) Тогда
		ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = СохраненныйВыводитьСообщенияНаТСД;
	Иначе
		ВыводитьСообщенияНаТСДПослеЗагрузкиДокументов = "ТолькоОшибки";
	КонецЕсли;
	ОбновитьЦветОтправкиСообщений();
	
	//ЗаполнитьИнформациюОбОсновнойОбработке();
	
	//Элементы.СкопироватьНастройкиПодключенияДругимПользователям1С.Доступность = ЕстьПравоАдминистрированияДанных();
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЦветРежимаОтладки()
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Если РежимОтладки = "Выключена" Тогда
			Элементы.РежимОтладки.ЦветТекста = WebЦвета.Красный;
		ИначеЕсли РежимОтладки = "ТолькоОшибки" Тогда
			Элементы.РежимОтладки.ЦветТекста = WebЦвета.Золотистый;
		ИначеЕсли РежимОтладки = "ВсяИнформация" Тогда
			Элементы.РежимОтладки.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
		
		Если ЛогРежимОтладкиES = "Выключено" Тогда
			Элементы.ЛогРежимОтладкиES.ЦветТекста = WebЦвета.Красный;
		ИначеЕсли ЛогРежимОтладкиES = "ТолькоОшибки" Тогда
			Элементы.ЛогРежимОтладкиES.ЦветТекста = WebЦвета.Золотистый;
		ИначеЕсли ЛогРежимОтладкиES = "ВсяИнформация" Тогда
			Элементы.ЛогРежимОтладкиES.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСпискаПроизвольныхКодов(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСпискаПроизвольныхКодов = ПолучитьФорму("ОФ_ФормаСписка_ПроизвольныеКоды", ЭтаФорма);
	#Иначе
		ФормаСпискаПроизвольныхКодов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ПроизвольныеКоды", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСпискаПроизвольныхКодов.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСпискаПроизвольныхКодов._ЛокКонтекст = _ЛокКонтекст;
	ФормаСпискаПроизвольныхКодов.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтладкиПриИзменении(Элемент)
	
	ОбновитьЦветРежимаОтладки();

	Если РежимОтладки <>   _ЛокКонтекст. ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("РежимОтладки") Тогда
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("РежимОтладки", РежимОтладки);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("РежимОтладки", РежимОтладки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогРежимОтладкиESПриИзменении(Элемент)
	
	ОбновитьЦветРежимаОтладки();
	
	Если ЛогРежимОтладкиES <> _ЛокКонтекст.Логирование_ПолучитьРежимОтладкиES() Тогда
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ЛогРежимОтладкиES", ЛогРежимОтладкиES);
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ЛогРежимОтладкиES", ЛогРежимОтладкиES);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаСАлкоголемПриИзменении(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("РаботаБезАлкоголя", РаботаБезАлкоголя);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("РаботаБезАлкоголя", 	РаботаБезАлкоголя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьСжатиеДанныхПриИзменении(Элемент)

    //_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ОтключитьСжатиеДанных", ОтключитьСжатиеДанных);
	//_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьСжатиеДанных", ОтключитьСжатиеДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура НеУдалятьДокументПослеЗавершенияПриИзменении(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НеУдалятьДокументПослеЗавершения", НеУдалятьДокументПослеЗавершения);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НеУдалятьДокументПослеЗавершения", НеУдалятьДокументПослеЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьРаботуВФонеПриИзменении(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ОтключитьРаботуВФоне", ОтключитьРаботуВФоне);
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ОтключитьРаботуВФоне", ОтключитьРаботуВФоне);
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ОтключитьРаботуВФоне", ОтключитьРаботуВФоне);
	
	// Передаем признак в лок контекст
	Если _ЛокКонтекст.ДоступноВыполнениеВФоне ИЛИ ОтключитьРаботуВФоне Тогда
		_ЛокКонтекст.ДоступноВыполнениеВФоне = Не ОтключитьРаботуВФоне;
	Иначе
		_ЛокКонтекст.ДоступноВыполнениеВФоне = Не ОтключитьРаботуВФоне
			И _ЛокКонтекст.ЛокЯдро_ДоступноВыполнениеВФоне();
	КонецЕсли;
	
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ДоступноВыполнениеВФоне", _ЛокКонтекст.ДоступноВыполнениеВФоне); // Записываем в кэш
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбновление_ОсновнаяОбработкаПриИзменении(Элемент)
	
 	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ОтключитьОбновление_ОсновнаяОбработка", ОтключитьОбновление_ОсновнаяОбработка);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьОбновление_ОсновнаяОбработка", 	ОтключитьОбновление_ОсновнаяОбработка);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбновление_ИнтеграционнаяОбработкаПриИзменении(Элемент)
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка", ОтключитьОбновление_ИнтеграционнаяОбработка);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьОбновление_ИнтеграционнаяОбработка",	  ОтключитьОбновление_ИнтеграционнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьРаботуСКнопкамиОбменаПриИзменении(Элемент)

	ОтключитьРаботуСКнопкамиОбмена = Не ВключитьРаботуСКнопкамиОбмена;
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ОтключитьРаботуСКнопкамиОбмена", ОтключитьРаботуСКнопкамиОбмена);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ОтключитьРаботуСКнопкамиОбмена",	 ОтключитьРаботуСКнопкамиОбмена);
	
	ПараметрыПодключенияMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("ПараметрыПодключенияMS");
	Если ПараметрыПодключенияMS = Неопределено ИЛИ ПараметрыПодключенияMS = Ложь Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
	
	ПараметрыПодключенияMS.Вставить("ОтключитьРаботуСКнопкамиОбмена", ОтключитьРаботуСКнопкамиОбмена);
	
	_ЛокКонтекст.ЛокЯдро_СохранитьПараметрыПодключенияMS(ПараметрыПодключенияMS);
	_ЛокКонтекст.КомЯдро_СохранитьЗначениеПеременной("ПараметрыПодключенияMS",			  ПараметрыПодключенияMS);
	
	Попытка
		_ЛокКонтекст.ЛокЯдро_ОбщийМодуль("Клеверенс_ОбщегоНазначенияВызовСервера").Клеверенс_Инициализация();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиТаймаутов(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСпискаНастройкиТаймаутов = ПолучитьФорму("ОФ_ФормаСписка_ТаймаутыИПорции", ЭтаФорма);
	#Иначе
		ФормаСпискаНастройкиТаймаутов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСписка_ТаймаутыИПорции", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСпискаНастройкиТаймаутов.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСпискаНастройкиТаймаутов._ЛокКонтекст = _ЛокКонтекст;
	ФормаСпискаНастройкиТаймаутов.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМетаданныеДокументов1С(Команда)
	
	_ЛокКонтекст.ЛокЯдро_ОбновлениеМетаданныхДокументов1С(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМетаданныеДокументовMS(Команда)
	
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДанныеУстройствMS",   Неопределено);
	_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_ДатаЗапросаЛицензий", Неопределено);
	
	пСтруктураМетаданных = _ЛокКонтекст.ЛокЯдро_ОбновитьМетаданныеДокументовMS(Ложь, Истина);
	
	_ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройкиMobileSMARTS(Команда)
	
	ПараметрыПодключенияMS = _ЛокКонтекст.ПараметрыПодключенияMS;
	Если ПараметрыПодключенияMS = Неопределено Тогда
		ПараметрыПодключенияMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенияMS();
	КонецЕсли;
		
	ИдентификаторБазыMS = "";
	Если ТипЗнч(ПараметрыПодключенияMS) = Тип("Структура") Тогда
		ИдентификаторБазыMS = ?(ПараметрыПодключенияMS.Свойство("Ид"), ПараметрыПодключенияMS.Ид, "");
		ИдентификаторБазыMS = СтрЗаменить(ИдентификаторБазыMS, "-", "_");
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторБазыMS) Тогда
		Сообщение = НСтр("ru = 'Не удалось определить идентификатор подключенной базы Клеверенс!';
							|en = 'The ID of the connected Cleverence database could not be determined!';
							|be = 'Не ўдалося вызначыць ідэнтыфікатар падключанай базы Cleverence!'; es = '¡No se pudo determinar el id de base de Cleverence conectada!'; ka = 'დაკავშირებული Cleverence მონაცემთა ბაზის ID ვერ განისაზღვრა!'; kk = 'Қосылған Cleverence базасының идентификаторын анықтау мүмкін болмады!'; ro = 'ID-ul bazei de date connected Cleverence nu a putut fi determinat!'; tr = 'Bağlı Cleverence veritabanının kimliği belirlenemedi!'; uk = 'Не вдалося визначити ідентифікатор підключеної бази Cleverence!'; uz = 'Ulangan Cleverence ma''lumotlar bazasi identifikatorini aniqlab bo''lmadi!'");
		Сообщить(Сообщение); 
		Возврат;		
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ОчиститьКэшируемыеНастройки(ИдентификаторБазыMS);
	
	ИнициализацияВФоне = _ЛокКонтекст.ДоступноВыполнениеВФоне И НЕ _ЛокКонтекст.РасположениеКомпоненты = "НаКлиенте";
		
	ОписаниеОповещения = Неопределено;
	Если ИнициализацияВФоне Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПроверкуБизнесПроцессовПослеИнициализации", ЭтаФорма);
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ИнициализацияНастроек_ИнициализироватьНастройкиПоУмолчанию(ПараметрыПодключенияMS);
	
	_ЛокКонтекст.ЛокЯдро_Инициализация(ПараметрыПодключенияMS, ОписаниеОповещения);
	
	Если НЕ ИнициализацияВФоне Тогда
		ВыполнитьПроверкуБизнесПроцессовПослеИнициализации(, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуБизнесПроцессовПослеИнициализации(Результат = Неопределено, ДополнительныеПараметры) Экспорт
	
	Если Результат = "ОшибкаИнициализации" Тогда
		Возврат;
	КонецЕсли;
	
	_ЛокКонтекст.ЛокЯдро_ВыполнитьПроверкуБизнесПроцессовПоМетаданнымMS();	
	
КонецПроцедуры

