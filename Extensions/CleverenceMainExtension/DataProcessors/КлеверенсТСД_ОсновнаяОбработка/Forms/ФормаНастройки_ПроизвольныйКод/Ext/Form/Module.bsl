&НаКлиенте
Процедура ВопросСохранитьВнесенныеИзмененияЗавершение(РезультатВопроса, ТекущиеДанные) Экспорт
	ЗакрытьФорму = Истина;
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьНастройку();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		ЗакрытьФорму = Ложь;
	Иначе
		ЕстьИзмененияНаФорме = Ложь;
	КонецЕсли;
	
	Если ЗакрытьФорму Тогда
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,РезультатРедактирования);
			КонецЕсли;
		#КонецЕсли

		Закрыть(РезультатРедактирования);	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройку()
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ID_ПроизвольногоКода",			ID_ПроизвольногоКода);
	СтруктураНастройки.Вставить("Наименование",					Наименование);
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		СтруктураНастройки.Вставить("ТекстПроизвольногоКода",	Элементы.ТекстовыйДокумент.ПолучитьТекст());
	#Иначе
		СтруктураНастройки.Вставить("ТекстПроизвольногоКода",	ТекстПроизвольногоКода);
	#КонецЕсли
	СтруктураНастройки.Вставить("Описание",						Описание);
	СтруктураНастройки.Вставить("Направление",					Направление);
	СтруктураНастройки.Вставить("ТипОбъекта",					ТипОбъекта);
	
	Отбор = Новый Структура("ID_ПроизвольногоКода", ID_ПроизвольногоКода);
	Если ЭтоБылТиповой Тогда
		_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("ПроизвольныеКоды_ПоУмолчанию", Отбор, СтруктураНастройки);
	Иначе
		_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("ПроизвольныеКоды_Пользовательские", Отбор, СтруктураНастройки);
	КонецЕсли;
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(Ложь);
	РезультатРедактирования = ID_ПроизвольногоКода;
	ЕстьИзмененияНаФорме = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПолеПеременных()
	МакетПеременных = _ЛокКонтекст.ЛокЯдро_ПолучитьМакетОбработки("ОписаниеПеременныхДляПроизвольныхКодов");	
	ЗаполнитьПолеПеременныхСервер(МакетПеременных);	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолеПеременныхСервер(МакетПеременных)
	
	Если ЗначениеЗаполнено(КлючНастройки)  Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ОписаниеПеременных = Элементы.ОписаниеПеременных;
		#КонецЕсли
		
		ОписаниеПеременных.Очистить();
		
		Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
			ПрефиксОбласти = "ВШ_";
		ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда
			ПрефиксОбласти = "ВТЧ_";
		ИначеЕсли КлючНастройки = "Загрузка_ШапкаДокумента" Тогда
			ПрефиксОбласти = "ЗШ_";
		ИначеЕсли КлючНастройки = "Загрузка_ТабличнаяЧастьДокумента" Тогда
			ПрефиксОбласти = "ЗТЧ_";
		ИначеЕсли КлючНастройки = "Выгрузка_Документ" Тогда
			ПрефиксОбласти = "ВД_";   			
		ИначеЕсли (КлючНастройки = "Выгрузка_ПередВыгрузкойДокумента" 
			Или КлючНастройки = "Выгрузка_ПослеВыгрузкиДокумента"
			Или КлючНастройки = "Выгрузка_ПослеОтправкиДокумента") Тогда
			ПрефиксОбласти = "ВШО_";
		ИначеЕсли (КлючНастройки = "Выгрузка_ПередВыгрузкойТЧ" 
			Или КлючНастройки = "Выгрузка_ПослеВыгрузкиТЧ") Тогда
			ПрефиксОбласти = "ВТЧО_";
		ИначеЕсли (КлючНастройки = "Выгрузка_ПередВыгрузкойСтрокиТЧ" 
			Или КлючНастройки = "Выгрузка_ПослеВыгрузкиСтрокиТЧ") Тогда
			ПрефиксОбласти = "ВСТЧО_";			
		ИначеЕсли КлючНастройки = "Загрузка_Документ" Тогда
			ПрефиксОбласти = "ЗД_";
		ИначеЕсли КлючНастройки = "Загрузка_ПослеОткрытияФормы" Тогда
			ПрефиксОбласти = "ЗФО_";
		ИначеЕсли (КлючНастройки = "Загрузка_ПередЗагрузкойДокумента" 
			Или КлючНастройки = "Загрузка_ПослеЗагрузкиДокумента") Тогда
			ПрефиксОбласти = "ЗШО_";
		ИначеЕсли (КлючНастройки = "Загрузка_ПередЗаполнениемТЧ" 
			Или КлючНастройки = "Загрузка_ПослеЗаполненияТЧ") Тогда
			ПрефиксОбласти = "ЗТЧО_";
		ИначеЕсли (КлючНастройки = "Загрузка_ПередЗаполнениемСтрокиТЧ" 
			Или КлючНастройки = "Загрузка_ПослеЗаполненияСтрокиТЧ") Тогда
			ПрефиксОбласти = "ЗСТЧО_";
		ИначеЕсли (КлючНастройки = "Выгрузка_ПослеОбъединенияТЧ" 
			Или КлючНастройки = "Выгрузка_ПослеОбъединенияТЧ") Тогда
			ПрефиксОбласти = "ВТЧО_";
		ИначеЕсли (КлючНастройки = "Выгрузка_ПередВыгрузкойСтрокиТЧ" 
			Или КлючНастройки = "Выгрузка_ПослеВыгрузкиСтрокиТЧ") Тогда
			ПрефиксОбласти = "ВСТЧО_";
		ИначеЕсли (КлючНастройки = "Настройка_ПечатьЭтикеток") Тогда
			ПрефиксОбласти = "НПЭ_";
		ИначеЕсли КлючНастройки = "Настройка_УсловиеВыполненияБизнесПроцесса" Тогда
			ПрефиксОбласти = "НБП_";
		Иначе
			Возврат;
		КонецЕсли;
		ОбластьВывода = МакетПеременных.ПолучитьОбласть(ПрефиксОбласти + "Общие");
		ОписаниеПеременных.Вывести(ОбластьВывода);
		
		Если КлючНастройки <> "Выгрузка_Документ" И КлючНастройки <> "Загрузка_Документ" Тогда
			Если ПрефиксОбласти = "ЗФО_" ИЛИ ПрефиксОбласти = "ЗШО_" ИЛИ ПрефиксОбласти = "ЗТЧО_" ИЛИ ПрефиксОбласти = "ЗСТЧО_" 
				ИЛИ ПрефиксОбласти = "ВШО_" ИЛИ ПрефиксОбласти = "ВТЧО_" ИЛИ ПрефиксОбласти = "ВСТЧО_" ИЛИ ПрефиксОбласти = "НБП_" Тогда
				Если ПрефиксОбласти = "ЗСТЧО_" Тогда
					ОбластьВывода = МакетПеременных.ПолучитьОбласть(ПрефиксОбласти + "Строка");
					ОписаниеПеременных.Вывести(ОбластьВывода);
				КонецЕсли;
			Иначе
				ОбластьВывода = МакетПеременных.ПолучитьОбласть(ПрефиксОбласти + "Шапка");
				ОписаниеПеременных.Вывести(ОбластьВывода);
				ВывестиПодстрокиВПолеПеременных(МакетПеременных, ПрефиксОбласти, "ПравилаОбменаШапка");
				Если ПрефиксОбласти = "ВТЧ_" ИЛИ ПрефиксОбласти = "ЗТЧ_" Тогда
					ОбластьВывода = МакетПеременных.ПолучитьОбласть(ПрефиксОбласти + "Строка");
					ОписаниеПеременных.Вывести(ОбластьВывода);
					ВывестиПодстрокиВПолеПеременных(МакетПеременных, ПрефиксОбласти, "ПравилаОбменаТабличнаяЧасть");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ОписаниеПеременных.ФиксацияСверху = 1;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ВывестиПодстрокиВПолеПеременных(МакетПеременных, ПрефиксОбласти, ИмяТаблицы)
	
	ТаблицаДляВывода = ПолучитьТаблицуДоступныхРеквизитов(ИмяТаблицы);
	
	Если ИмяТаблицы = "ПравилаОбменаШапка" Тогда
		ИмяОбластиРеквизитов = ПрефиксОбласти + "РеквизитШапки";
	ИначеЕсли ИмяТаблицы = "ПравилаОбменаТабличнаяЧасть" Тогда
		ИмяОбластиРеквизитов = ПрефиксОбласти + "РеквизитСтроки";
	КонецЕсли;
	
	ОписаниеПеременных.НачатьГруппуСтрок();
	Если ТаблицаДляВывода.Количество() = 0 Тогда
		ОбластьВывода = МакетПеременных.ПолучитьОбласть(ПрефиксОбласти + "НетДанных");
		ОписаниеПеременных.Вывести(ОбластьВывода);
	Иначе
		НомерСтроки = 0;
		Для Каждого СтрокаРеквизита Из ТаблицаДляВывода Цикл
			НомерСтроки = НомерСтроки + 1;
			ОбластьВывода = МакетПеременных.ПолучитьОбласть(ИмяОбластиРеквизитов);
			ОбластьВывода.Параметры.Заполнить(СтрокаРеквизита);
			ОбластьВывода.Параметры.НомерСтроки = СтрЗаменить(Строка(НомерСтроки), Символы.НПП, "") + ".";
			ОписаниеПеременных.Вывести(ОбластьВывода);
		КонецЦикла;
	КонецЕсли;
	ОписаниеПеременных.ЗакончитьГруппуСтрок();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуДоступныхРеквизитов(ИмяТаблицы)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ИмяПриемника");
	ТаблицаРезультат.Колонки.Добавить("Тип");
	ТаблицаРезультат.Колонки.Добавить("Описание");
	ТаблицаИсточник = Неопределено;
	
	#Область НесовместимыйКодFresh
	Выполнить("ТаблицаИсточник = ПолучитьИзВременногоХранилища("+ИмяТаблицы+"Адрес);");
	#КонецОбласти //НесовместимыйКодFresh
	#Область СовместимыйКодFresh
	//СтрокаВызова = "ТаблицаИсточник = ПолучитьИзВременногоХранилища("+ИмяТаблицы+"Адрес);";
	//СтрокаВызова = СтрЗаменить(СтрокаВызова, "ТаблицаИсточник", "Параметры.ТаблицаИсточник");
	//СтрокаВызова = СтрЗаменить(СтрокаВызова, ИмяТаблицы, "Параметры." + ИмяТаблицы);
	//ПараметрыАлгоритма = Новый Структура;
	//ПараметрыАлгоритма.Вставить("ТаблицаИсточник", 	ТаблицаИсточник);
	//ПараметрыАлгоритма.Вставить(ИмяТаблицы + "Адрес", 	ЭтаФорма[ИмяТаблицы + "Адрес"]);
	//ОбщегоНазначения.ВыполнитьВБезопасномРежиме(СтрокаВызова, ПараметрыАлгоритма);
	//ТаблицаИсточник = ПараметрыАлгоритма.ТаблицаИсточник;
	#КонецОбласти //СовместимыйКодFresh
	
	ДобавлятьПроизвольныеКоды = Истина;
	Если ТаблицаИсточник <> Неопределено Тогда
		Для Каждого СтрокаПравила Из ТаблицаИсточник Цикл
			Если СтрокаПравила.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаПравила.ИмяПриемника) И ЗначениеЗаполнено(СтрокаПравила.ТипИсточника) Тогда
				Если СтрокаПравила.ТипИсточника = "Реквизит1С" И ЗначениеЗаполнено(СтрокаПравила.ИмяИсточника) Тогда
					НоваяСтрока = ТаблицаРезультат.Добавить();
					НоваяСтрока.ИмяПриемника = СтрокаПравила.ИмяПриемника;
					НоваяСтрока.Тип = "Значение реквизита 1С";
					НоваяСтрока.Описание = "Значение, загружаемое из реквизита 1С [" + СтрокаПравила.СинонимИсточника + "] по способу сопоставления [" +  СтрокаПравила.СпособСопоставленияСиноним + "].";
				ИначеЕсли СтрокаПравила.ТипИсточника = "РеквизитMS" И ЗначениеЗаполнено(СтрокаПравила.ИмяИсточника) Тогда
					НоваяСтрока = ТаблицаРезультат.Добавить();
					НоваяСтрока.ИмяПриемника = СтрокаПравила.ИмяПриемника;
					НоваяСтрока.Тип = "Значение реквизита Mobile SMARTS";
					НоваяСтрока.Описание = "Значение, загружаемое из реквизита Клеверенс [" + СтрокаПравила.СинонимИсточника + "] по способу сопоставления [" +  СтрокаПравила.СпособСопоставленияСиноним + "].";
				ИначеЕсли СтрокаПравила.ТипИсточника = "ГлобальныйПараметр" И ЗначениеЗаполнено(СтрокаПравила.ИмяИсточника) Тогда
					НоваяСтрока = ТаблицаРезультат.Добавить();
					НоваяСтрока.ИмяПриемника = СтрокаПравила.ИмяПриемника;
					НоваяСтрока.Тип = "Значение глобального параметр";
					НоваяСтрока.Описание = "Значение глобального параметра [" + СтрокаПравила.СинонимИсточника + "], полученное для используемого узла.";
				ИначеЕсли СтрокаПравила.ТипИсточника = "ПроизвольноеЗначение" Тогда
					НоваяСтрока = ТаблицаРезультат.Добавить();
					НоваяСтрока.ИмяПриемника = СтрокаПравила.ИмяПриемника;
					НоваяСтрока.Тип = "Произвольное значение";
					НоваяСтрока.Описание = "Произвольное значение, установленное в правилах обмена";
				ИначеЕсли СтрокаПравила.ТипИсточника = "ПроизвольныйКод" И ДобавлятьПроизвольныеКоды И ЗначениеЗаполнено(СтрокаПравила.ИмяИсточника) Тогда
					Если СтрокаПравила.ИмяИсточника = ID_ПроизвольногоКода Тогда
						ДобавлятьПроизвольныеКоды = Ложь;	// не добавляем в таблицу коды, рассчитываемые позднее текущего
						Продолжить;
					КонецЕсли;
					НоваяСтрока = ТаблицаРезультат.Добавить();
					НоваяСтрока.ИмяПриемника = СтрокаПравила.ИмяПриемника;
					НоваяСтрока.Тип = "Произвольный код";
					НоваяСтрока.Описание = "Значение, рассчитанное по произвольному коду ["+ СтрокаПравила.СинонимИсточника +"].";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ТаблицаРезультат;
	
КонецФункции

