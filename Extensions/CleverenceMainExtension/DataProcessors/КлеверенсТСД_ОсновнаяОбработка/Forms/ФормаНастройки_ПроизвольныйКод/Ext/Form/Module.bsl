	Попытка
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			#Область НесовместимыйКодFresh
			Выполнить(Элементы.ТекстовыйДокумент.ПолучитьТекст());
			#КонецОбласти //НесовместимыйКодFresh
		#Иначе	         
			#Область НесовместимыйКодFresh
			Выполнить(ТекстПроизвольногоКода);	
			#КонецОбласти //НесовместимыйКодFresh
			#Область СовместимыйКодFresh
			ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
			Модуль = ОбработкаОбъект.ГлЯдро_ОбщийМодуль("ОбщегоНазначения");
			Если Модуль <> Неопределено Тогда
				Модуль.ВыполнитьВБезопасномРежиме(ТекстПроизвольногоКода);
			Иначе
				Модуль = ОбработкаОбъект.ГлЯдро_ОбщийМодуль("Common");
				Если Модуль <> Неопределено Тогда
					Модуль.ExecuteInSafeMode(ТекстПроизвольногоКода);
				КонецЕсли
			КонецЕсли;
			#КонецОбласти //СовместимыйКодFresh
		#КонецЕсли
		 					
		Результат = НСтр("ru = 'Ошибок не найдено!';
							|en = 'No errors found!'; be = 'Памылак не знойдзена!'; es = '¡No se encontraron errores!'; ka = 'შეცდომები არ არის ნაპოვნი!'; kk = 'Қателер табылмады!'; ro = 'Nu s-au găsit erori!'; tr = 'Hata bulunamadı!'; uk = 'Помилок не знайдено!'; uz = 'Hech qanday xato topilmadi!'");		
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Найти(ВРег(Результат), ВРег("Переменная не определена")) Тогда
			Результат = НСтр("ru = 'Синтаксических ошибок не обнаружено!';
								|en = 'No syntax errors found!'; be = 'Сінтаксічных памылак не выяўлена!'; es = '¡No se encontraron errores de sintaxis!'; ka = 'სინტაქსის შეცდომები არ არის ნაპოვნი!'; kk = 'Синтаксистік қателер табылған жоқ!'; ro = 'Nu s-au găsit erori de sintaxă!'; tr = 'Sözdizimi hatası bulunamadı!'; uk = 'Синтаксичних помилок не виявлено!'; uz = 'Sintaktik xatolar topilmadi!'");					
		КонецЕсли; 
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

