&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ОткрытьФормуРедактированияНастройки(Истина, Копирование);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ОткрытьФормуРедактированияНастройки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если  Не (Направление = "" Или ТипОбъекта = "" ) Тогда
		ЗакрытьФормуСВыборомЭлемента();
	Иначе
		ОткрытьФормуРедактированияНастройки(Ложь);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ЗакрытьФормуСВыборомЭлемента();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизвольныхКодовПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоТиповой = Истина Тогда
		Сообщение = НСтр("ru = 'Типовые произвольные коды удалять запрещено!';
							|en = 'It is forbidden to delete standard arbitrary codes!'; be = 'Тыпавыя адвольныя коды выдаляць забаронена!'; es = '¡Está Prohibido eliminar códigos arbitrarios típicos!'; ka = 'აკრძალულია სტანდარტული თვითნებური კოდების წაშლა!'; kk = 'Әдеттегі ерікті кодтарды жоюға тыйым салынады!'; ro = 'Este interzisă ștergerea codurilor arbitrare standard!'; tr = 'Tipik keyfi kodları silmek yasaktır!'; uk = 'Типові довільні коди видаляти заборонено!'; uz = 'Oddiy o''zboshimchalik kodlarini olib tashlash taqiqlanadi!'");
		Сообщить(Сообщение); 
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
	ПроизвольныеКоды_Пользовательские = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды_Пользовательские");
	Индекс = 0;
	Для каждого СтрокаПК из ПроизвольныеКоды_Пользовательские Цикл
		Если СтрокаПК.Свойство("ID_ПроизвольногоКода") И СтрокаПК.ID_ПроизвольногоКода = ТекущиеДанные.ID_ПроизвольногоКода Тогда
			ПроизвольныеКоды_Пользовательские.Удалить(Индекс);
			Прервать;
		КонецЕсли;
		Индекс = Индекс+1;
	КонецЦикла;
	
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
	_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("ПроизвольныеКоды_Пользовательские", ПроизвольныеКоды_Пользовательские);
	_ЛокКонтекст.ЛокЯдро_СобратьОбщуюСтруктуруПроизвольныхКодов(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВОдинКлюч(Команда)
	ПроизвольныеКоды = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды");
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("ПроизвольныеКоды", _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ПроизвольныеКоды));
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСлужебныеКолонки(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ТаблицаПроизвольныхКодов.Колонки.ТаблицаПроизвольныхКодовID_ПроизвольногоКода.Видимость = Истина;
	#Иначе
		Элементы.ТаблицаПроизвольныхКодовID_ПроизвольногоКода.Видимость = Истина;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Импорт");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЭкспортаНастроек(Команда)
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
КонецПроцедуры

#КонецОбласти
	
#Область ВспомогательныеМеханизмы

&НаКлиенте
Процедура ОткрытьФормуРедактированияНастройки(ЭтоНоваяНастройка, ЭтоКопирование = Ложь)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПроизвольныйКод = ПолучитьФорму("ОФ_ФормаНастройки_ПроизвольныйКод", ЭтаФорма);
	#Иначе
		ФормаНастройки_ПроизвольныйКод = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ПроизвольныйКод", , ЭтаФорма, ЭтаФорма);
		ФормаНастройки_ПроизвольныйКод.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаНастройки_ПроизвольныйКод._ЛокКонтекст 							= _ЛокКонтекст;
	ФормаНастройки_ПроизвольныйКод.ЭтоНоваяНастройка 						= ЭтоНоваяНастройка;
	ФормаНастройки_ПроизвольныйКод.КлючНастройки 							= КлючНастройки;
	ФормаНастройки_ПроизвольныйКод.ТипИсходногоДокумента1С 					= ТипИсходногоДокумента1С;
	ФормаНастройки_ПроизвольныйКод.ИмяТабличнойЧасти1С 						= ИмяТабличнойЧасти1С;
	ФормаНастройки_ПроизвольныйКод.ПравилаОбменаШапка 						= ПравилаОбменаШапка;
	ФормаНастройки_ПроизвольныйКод.ПравилаОбменаТабличнаяЧасть 				= ПравилаОбменаТабличнаяЧасть;
	ФормаНастройки_ПроизвольныйКод.Направление 								= Направление;
	ФормаНастройки_ПроизвольныйКод.ТипОбъекта 								= ТипОбъекта;	
	ФормаНастройки_ПроизвольныйКод.ЗапретитьИзменятьНаправлениеТипОбъекта 	= ЗапретитьИзменятьНаправлениеТипОбъекта;
		
	Если НЕ ЭтоНоваяНастройка ИЛИ ЭтоКопирование Тогда
		ТекущаяСтрока = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ФормаНастройки_ПроизвольныйКод, ТекущаяСтрока);
		Если ЭтоКопирование Тогда
			ФормаНастройки_ПроизвольныйКод.ЭтоТиповой = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ОП = Новый ОписаниеОповещения("ФормаНастройки_ПроизвольныйКодЗакрытие",ЭтаФорма);
	ФормаНастройки_ПроизвольныйКод.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройки_ПроизвольныйКод.ОткрытьМодально();	
	#Иначе
		ФормаНастройки_ПроизвольныйКод.Открыть();
	#КонецЕсли	

КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ПроизвольныйКодЗакрытие(ID_РедактируемойНастройки,ДопПараметры) Экспорт
	Если ЗначениеЗаполнено(ID_РедактируемойНастройки) Тогда
		ОбновитьТаблицуПроизвольныхКодов(ID_РедактируемойНастройки);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуПроизвольныхКодов(ID_ТекущейСтроки = "")
	
	ТаблицаПроизвольныхКодов.Очистить();
	пТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("ПроизвольныеКоды",ИСТИНА);
	
	Индекс=Неопределено;Икс=0;
	
	Если Не (Направление = "" Или ТипОбъекта = "" ) Тогда
		Если ТипЗнч(пТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
			Для Каждого СтрокаМассива Из пТаблицаПроизвольныхКодов Цикл
				Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений")
					ИЛИ НЕ СтрокаМассива.Направление = Направление 
					ИЛИ НЕ СтрокаМассива.ТипОбъекта = ТипОбъекта Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ID_ТекущейСтроки) И СтрокаМассива.ID_ПроизвольногоКода = ID_ТекущейСтроки Тогда
					Индекс = Икс;
				КонецЕсли;
				НоваяСтрока = ТаблицаПроизвольныхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаМассива);
				
				Если СтрокаМассива.Свойство("ЭтоТиповой") И СтрокаМассива.ЭтоТиповой = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
				КонецЕсли;
				
				Икс = Икс+1;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если ТипЗнч(пТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
			Для Каждого СтрокаМассива Из пТаблицаПроизвольныхКодов Цикл
				Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ID_ТекущейСтроки) И СтрокаМассива.ID_ПроизвольногоКода = ID_ТекущейСтроки Тогда
					Индекс = Икс;
				КонецЕсли;
				НоваяСтрока = ТаблицаПроизвольныхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаМассива);
				
				Если СтрокаМассива.Свойство("ЭтоТиповой") И СтрокаМассива.ЭтоТиповой = Истина Тогда
					НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
				Иначе
					НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
				КонецЕсли;
				
				Икс = Икс+1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда	
		Если Индекс <> Неопределено Тогда
			Элементы.ТаблицаПроизвольныхКодов.ТекущаяСтрока = Индекс;
		КонецЕсли;
	#КонецЕсли
	
	Элементы.ТаблицаПроизвольныхКодовНаправление.Видимость	= Не ЗапретитьИзменятьНаправлениеТипОбъекта;
	Элементы.ТаблицаПроизвольныхКодовТипОбъекта.Видимость 	= Не ЗапретитьИзменятьНаправлениеТипОбъекта;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуСВыборомЭлемента()
	
	Если Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные <> Неопределено Тогда
		Результат = Элементы.ТаблицаПроизвольныхКодов.ТекущиеДанные.ID_ПроизвольногоКода;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
		Закрыть();	
	#Иначе
		Закрыть(Результат);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры 

#КонецОбласти	
	
#Если ТолстыйКлиентОбычноеПриложение Тогда 
	
	Процедура ТаблицаПроизвольныхКодовПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		
		ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.ОтображатьКартинку = Истина;
		ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.ОтображатьТекст = Ложь;
		Если ДанныеСтроки.ЭтоТиповой = Истина Тогда
			ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
		Иначе
			ОформлениеСтроки.Ячейки.ТаблицаПроизвольныхКодовКартинка.Картинка = БиблиотекаКартинок.Пользователь;
		КонецЕсли;
		
	КонецПроцедуры
	
	Процедура КомПанельТаблицыВыбрать(Кнопка)
		ЗакрытьФормуСВыборомЭлемента();
	КонецПроцедуры

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Объект = ЭтотОбъект;
#КонецЕсли

