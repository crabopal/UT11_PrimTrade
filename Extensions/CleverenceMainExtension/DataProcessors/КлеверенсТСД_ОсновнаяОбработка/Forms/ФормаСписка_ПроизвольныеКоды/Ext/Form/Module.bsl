									|en = 'Section: After merging, the Tabular part'; be = 'Раздзел: пасля аб''яднання Таблічная частка'; es = 'Sección: después de combinar la parte de Tabla'; ka = 'განყოფილება: შერწყმის შემდეგ, ცხრილის ნაწილი'; kk = 'Бөлім: біріктірілгеннен кейін кесте бөлігі'; ro = 'Secțiune: după fuziune, partea tabelară'; tr = 'Bölüm: Birleştirildikten sonra Tablo kısmı'; uk = 'Розділ: після об''єднання таблична частина'; uz = 'Bo''lim: birlashtirilgandan so''ng jadval qismi'");
	ИначеЕсли КлючНастройки = "Выгрузка_ПослеОбъединенияСтрокиТЧ" Тогда
		Направление = "Выгрузка";
		ТипОбъекта = "ПослеОбъединенияСтрокиТЧ";
		УточнениеЗаголовка = НСтр("ru = 'Раздел: После объединения строки ТЧ';
									|en = 'Section: After combining the row, the tabular part'; be = 'Раздзел: пасля аб''яднання радкі Таблічная частка'; es = 'Sección: después de combinar la fila, la parte de Tabla'; ka = 'განყოფილება: რიგის შერწყმის შემდეგ, ცხრილის ნაწილი'; kk = 'Бөлім: кесте бөлігі жолын біріктіргеннен кейін'; ro = 'Secțiune: după combinarea rândului, partea tabelară'; tr = 'Bölüm: Dizeyi birleştirdikten sonra Tablo kısmı'; uk = 'Розділ: після об''єднання рядка таблична частина'; uz = 'Bo''lim: satr birlashtirilgandan so''ng jadval qismi'");
	ИначеЕсли КлючНастройки = "Настройка_ПечатьЭтикеток" Тогда
		Направление = "Настройка";
		ТипОбъекта = "ПечатьЭтикеток";
		УточнениеЗаголовка = НСтр("ru = 'Раздел: Настройка печати этикеток';
									|en = 'Section: Label Printing Settings'; be = 'Раздзел: Налада друку этыкетак'; es = 'Sección: configuración de impresión de etiquetas'; ka = 'განყოფილება: ეტიკეტის ბეჭდვის პარამეტრები'; kk = 'Бөлім: жапсырмаларды басып шығаруды теңшеу'; ro = 'Secțiune: Setări De Imprimare A Etichetelor'; tr = 'Bölüm: Etiket yazdırmayı özelleştirme'; uk = 'Розділ: Налаштування друку етикеток'; uz = 'Bo''lim: yorliqlarni chop etishni Sozlash'");
	ИначеЕсли КлючНастройки = "Настройка_УсловиеВыполненияБизнесПроцесса" Тогда
		Направление = "Настройка";
		ТипОбъекта = "УсловиеВыполненияБизнесПроцесса";
		УточнениеЗаголовка = НСтр("ru = 'Раздел: Условие выполнения бизнес процесса';
									|en = 'Section: Business Process Execution Condition'; be = 'Раздзел: ўмова выканання бізнес працэсу'; es = 'Sección: Condición de ejecución del proceso de negocio'; ka = 'განყოფილება: ბიზნეს პროცესის შესრულების მდგომარეობა'; kk = 'Бөлім: бизнес-процестің шарты'; ro = 'Secțiune: Starea De Execuție A Procesului De Afaceri'; tr = 'Bölüm: İş sürecinin yürütülmesi koşulu'; uk = 'Розділ: умова виконання бізнес процесу'; uz = 'Bo''lim: biznes jarayonini bajarish sharti'");
	КонецЕсли;
	
	Если Не ПустаяСтрока(УточнениеЗаголовка) Тогда
		Заголовок = Заголовок + " (" + УточнениеЗаголовка + ")";	
	КонецЕсли;
	
	Если  ЗначениеЗаполнено(ПравилаОбменаШапка) ИЛИ  ЗначениеЗаполнено(ПравилаОбменаТабличнаяЧасть) 
		ИЛИ КлючНастройки = "Выгрузка_ПослеОбъединенияТЧ" ИЛИ КлючНастройки = "Выгрузка_ПослеОбъединенияСтрокиТЧ" Тогда
		ЗапретитьИзменятьНаправлениеТипОбъекта = Истина;
	КонецЕсли;
	
	ОбновитьТаблицуПроизвольныхКодов();
	
КонецПроцедуры

#КонецОбласти
	
