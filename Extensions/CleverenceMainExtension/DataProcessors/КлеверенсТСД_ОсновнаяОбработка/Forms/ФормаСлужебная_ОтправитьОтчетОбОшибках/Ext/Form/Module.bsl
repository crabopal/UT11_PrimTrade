/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ФИО 							= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_ФИОПользователя");
	Почта 							= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_АдресЭлектроннойПочты");
	НомерТелефона 					= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_НомерТелефона");
	НомерОбращения			 		= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_НомерПоследнегоОбращения");
	ДатаСледующегоОбращения 		= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_SD_ДатаСледующегоОбращения");
	СогласиеНаОбработкуПерсДанных 	= Истина;
	
	ИзменитьОтображениеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗакрытиеФормыСРезультатом(?(ОтчетОтправлен ИЛИ РучноеФормирование, "", "Отложить"));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СсылкаНаПорталТПКлеверенсНажатие(Элемент)
	
	#Если ВебКлиент Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("УстановитьЕслиНеПодключено", Истина);
		ДополнительныеПараметры.Вставить("ВыборЗавершение", Новый ОписаниеОповещения("ОткрытьПорталТПКлеверенс", ЭтаФорма));
		
		_ЛокКонтекст.ЛокЯдро_ПередПодключениемРасширенияРаботыСФайлами(ДополнительныеПараметры);		
	#Иначе
		ОткрытьПорталТПКлеверенс();
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьОтчет(Команда)
	
	Если ПроверитьЗаполнениеРеквизитов() Тогда
		
		_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_SD_ФИОПользователя", ФИО);
		_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_SD_АдресЭлектроннойПочты", Почта);
		_ЛокКонтекст.ЛокЯдро_СохранитьДанныеВХранилище1С("Cleverence_SD_НомерТелефона", НомерТелефона);
		
		ДанныеПользователя = Новый Структура;
		ДанныеПользователя.Вставить("ФИО", ФИО);
		ДанныеПользователя.Вставить("Почта", Почта);
		ДанныеПользователя.Вставить("НомерТелефона", НомерТелефона);
		ДанныеПользователя.Вставить("Описание", Описание);
		
		ДопПараметры.Вставить("ДанныеПользователя", ДанныеПользователя);
		
		СтруктураРезультата = _ЛокКонтекст.ЛокЯдро_СерверКачества_ОтправитьОтчетОбОшибкахНаСервер(ДопПараметры, РучноеФормирование);
		
		ОтчетОтправлен = СтруктураРезультата.ОтчетОтправлен;
		НомерОбращения = СтруктураРезультата.НомерОбращения;
		
		ОбновитьОтображениеФормы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отложить(Команда)
	ЗакрытиеФормыСРезультатом("Отложить");
КонецПроцедуры

&НаКлиенте
Процедура БольшеНеСпрашивать(Команда)
	ЗакрытиеФормыСРезультатом("БольшеНеСпрашивать");
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьНомерОбращения(Команда)
	
	Попытка
		ОбъектКопирования = Новый COMОбъект("htmlfile"); 
		ОбъектКопирования.ParentWindow.ClipboardData.SetData("Text", НомерОбращения);
	Исключение
		Сообщить(НСтр("ru = 'Не удалось скопировать';
						|en = 'Couldn''t copy'; be = 'Не ўдалося скапіяваць'; es = 'No se pudo copiar'; ka = 'ვერ დააკოპირა'; kk = 'Көшіру мүмкін болмады'; ro = 'Nu am putut copia'; tr = 'Kopyalanamadı'; uk = 'Не вдалося скопіювати'; uz = 'Nusxa ko''chirilmadi'"));
		Возврат;
	КонецПопытки;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Номер обращения скопирован в буфер обмена.';
											|en = 'The request number has been copied to the clipboard.'; be = 'Нумар звароту скапіяваны ў буфер абмену.'; es = 'El número de caso se ha copiado en el portapapeles.'; ka = 'მოთხოვნის ნომერი გადაწერილია ბუფერში.'; kk = 'Өтініш нөмірі алмасу буферіне көшірілді.'; ro = 'Numărul cererii a fost copiat în clipboard.'; tr = 'Adres numarası panoya kopyalandı.'; uk = 'Номер звернення скопійований в буфер обміну.'; uz = 'Manzil raqami clipboardga ko''chirilgan.'"),, НомерОбращения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьФайлДляТехПоддержкиНажатие(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьЛогиВКаталогЗавершение", ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_Автотесты_СохранитьЛогиВКаталог(ОП);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьЛогиВКаталогЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтображениеФормы()
	
	Если РучноеФормирование И ДатаСледующегоОбращения > ДопПараметры.ДатаТекущейПроверки Тогда
		ПревышенЛимитОбращений = Истина;
		ОтчетОтправлен = Истина;
		Заголовок = НСтр("ru = 'Клеверенс: Обращение [';
							|en = 'Cleverence: Appeal ['; be = 'Cleverence: Зварот ['; es = 'Cleverence: Tratamiento ['; ka = 'Cleverence: მიმართვა ['; kk = 'Cleverence: Үндеу ['; ro = 'Cleverence: Apel ['; tr = 'Cleverence: İtiraz ['; uk = 'Cleverence: Звернення ['; uz = 'Aniqlik: Murojaat ['") +  НомерОбращения + НСтр("be = '] ужо заведзена!'; en = ""] it's already started!""; es = '] ¡ya está hecho!'; ka = '] ეს უკვე დაწყებულია!'; kk = '] қазірдің өзінде құрылған!'; ro = ' a început deja!'; ru = '] уже заведено!'; tr = '] çoktan başladı!'; uk = '] вже заведено!'; uz = '] allaqachon ishga tushirilgan!'");
		Элементы.ОписаниеПослеОтправки.Заголовок = НСтр("ru = 'Вы недавно уже заводили обращение в техническую поддержку, проверьте свою почту в папке ""Входящие"" или в папке ""Спам"". В почте должны быть сообщения о ходе работы над вашим обращением. Если уведомления на почту не приходят, зайдите на портал технической поддержки Клеверенс.';
															|en = 'You have already contacted technical support recently, check your email in the Inbox or Spam folder. The mail should contain messages about the progress of work on your request. If you do not receive notifications by email, log in to the Cleverence technical support portal.';
															|be = 'Вы нядаўна ўжо заводзілі зварот у тэхнічную падтрымку, Праверце сваю пошту ў тэчцы ""Уваходныя"" або ў тэчцы ""Спам"". У пошце павінны быць паведамленні аб ходзе работы над вашым зваротам. Калі паведамлення на пошту не прыходзяць, зайдзіце на партал тэхнічнай падтрымкі Cleverence.'; es = 'Recientemente ya ha comenzado a ponerse en contacto con el soporte técnico, verifique su correo en la bandeja de Entrada o en la carpeta Spam. En el correo debe haber mensajes sobre el progreso en su solicitud. Si no recibes ninguna notificación por correo electrónico, visita el portal de soporte técnico de Cleverence.'; ka = 'თქვენ უკვე დაუკავშირდით ტექნიკურ მხარდაჭერას ცოტა ხნის წინ, შეამოწმეთ თქვენი ელ.ფოსტა შემოსულებში ან სპამის საქაღალდეში. ფოსტა უნდა შეიცავდეს შეტყობინებებს თქვენს მოთხოვნაზე მუშაობის მიმდინარეობის შესახებ. თუ არ მიიღებთ შეტყობინებებს ელ.ფოსტით, შედით Cleverence ტექნიკური მხარდაჭერის პორტალზე.'; kk = 'Сіз жақында техникалық қолдауды іздедіңіз, кіріс жәшігінде немесе Спам қалтасында поштаңызды тексеріңіз. Поштада Сіздің өтінішіңіз бойынша жұмыс барысы туралы хабарламалар болуы керек. Егер хабарламалар поштаға келмесе, Cleverence техникалық қолдау порталына өтіңіз.'; ro = 'Ați contactat deja asistența tehnică recent, verificați-vă e-mailul în dosarul Inbox sau Spam. E-mailul trebuie să conțină mesaje despre progresul lucrărilor la cererea dvs. Dacă nu primiți notificări prin e-mail, conectați-vă la portalul de asistență tehnică Cleverence.'; tr = 'Yakın zamanda teknik destekle iletişime geçtiniz, gelen kutunuzdaki veya Spam klasörünüzdeki postalarınızı kontrol edin. Postada, itirazınız üzerindeki ilerlemeyle ilgili mesajlar bulunmalıdır. E-postaya bildirim gelmezse, Cleverence teknik destek portalına gidin.'; uk = 'Ви недавно вже заводили звернення в технічну підтримку, перевірте свою пошту в папці ""Вхідні"" або в папці ""Спам"". У пошті повинні бути повідомлення про хід роботи над вашим зверненням. Якщо повідомлення на пошту не приходять, зайдіть на портал технічної підтримки Cleverence.'; uz = 'Siz yaqinda texnik yordamga murojaat qildingiz, pochta qutingizni kirish qutisida yoki spam papkasida tekshiring. Pochtada sizning murojaatingiz bo''yicha ishlarning borishi to''g''risida xabarlar bo''lishi kerak. Agar pochta xabarnomalari kelmasa, Cleverence texnik qo''llab-quvvatlash portaliga o''ting.'");
		
		ОбновитьОтображениеФормы();
		Возврат;
	КонецЕсли;
	
	Если РучноеФормирование Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Формирование обращения для технической поддержки';
							|en = 'Cleverence: Forming a request for technical support';
							|be = 'Cleverence: Фарміраванне звароту для тэхнічнай падтрымкі'; es = 'Cleverence: creación de un caso de soporte técnico'; ka = 'კლევერენცია: ტექნიკური მხარდაჭერის მოთხოვნის ჩამოყალიბება'; kk = 'Cleverence: техникалық қолдау үшін өтінішті қалыптастыру'; ro = 'Cleverence: formarea unei cereri de asistență tehnică'; tr = 'Cleverence: Teknik destek için başvurunun oluşturulması'; uk = 'Cleverence: формування звернення для технічної підтримки'; uz = 'Cleverence: texnik qo''llab-quvvatlash uchun murojaatni shakllantirish'");
	КонецЕсли;
	
	пСообщение = НСтр("ru = 'Отложить на %1 дня';
						|en = 'Set aside for %1 days'; be = 'Адкласці на %1 дня'; es = 'Posponer %1 día'; ka = 'გათვალისწინებულია %1 დღის განმავლობაში'; kk = '%1 күнге кейінге қалдырыңыз'; ro = 'Puneți deoparte %1 zi'; tr = '% 1 gün ertele'; uk = 'Відкласти на %1 дня'; uz = '%1 kunga qoldiring'");
	пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, ГлубинаОтбораОшибок);
	Элементы.Отложить.Заголовок = пСообщение;
	Элементы.Отложить.Видимость = НЕ РучноеФормирование;
	Элементы.БольшеНеСпрашивать.Видимость = НЕ РучноеФормирование;
	
	ОбновитьОтображениеФормы();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеФормы()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаТелоФормы.Страницы.ГруппаФормированиеОтчета.Видимость				= НЕ ОтчетОтправлен;	
		Элементы.ГруппаТелоФормы.Страницы.ГруппаПослеУспешнойОтправкиОтчета.Видимость	= ОтчетОтправлен;
	#Иначе
		Элементы.ГруппаФормированиеОтчета.Видимость				= НЕ ОтчетОтправлен;	
		Элементы.ГруппаПослеУспешнойОтправкиОтчета.Видимость	= ОтчетОтправлен;
	#КонецЕсли
	
	Элементы.ПочтаПоследнегоОбращения.Видимость = ОтчетОтправлен;
	
	Если ОтчетОтправлен И НЕ ПревышенЛимитОбращений Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Обращение успешно зарегистрировано!';
							|en = 'Cleverence: The appeal was successfully registered!'; be = 'Cleverence: зварот паспяхова зарэгістравана!'; es = 'Cleverence: ¡Apelación registrada con éxito!'; ka = 'კლევერენცია: მიმართვა წარმატებით დარეგისტრირდა!'; kk = 'Cleverence: өтініш сәтті тіркелді!'; ro = 'Cleverence: cererea a fost înregistrată cu succes!'; tr = 'Cleverence: İtiraz başarıyla kaydedildi!'; uk = 'Cleverence: звернення успішно зареєстровано!'; uz = 'Cleverence: murojaat muvaffaqiyatli ro''yxatdan o''tkazildi!'");
	КонецЕсли;
	
	// Отображение кнопок
	Элементы.Отложить.Видимость 										= НЕ ОтчетОтправлен И НЕ РучноеФормирование;
	Элементы.БольшеНеСпрашивать.Видимость 						= НЕ ОтчетОтправлен И НЕ РучноеФормирование;
	Элементы.ОтправитьОтчет.Видимость								= НЕ ОтчетОтправлен;
	Элементы.КнопкаЗакрыть.Видимость								= РучноеФормирование ИЛИ ОтчетОтправлен;
	//Элементы.ПолучитьФайлДляТехПоддержки.Видимость 			= ПревышенЛимитОбращений;
	Элементы.ОтправитьОтчет.КнопкаПоУмолчанию						= НЕ ОтчетОтправлен;
	Элементы.КнопкаЗакрыть.КнопкаПоУмолчанию						= ОтчетОтправлен;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ПолучитьФайлДляТехПоддержки.Видимость 			= НЕ Элементы.КнопкаЗакрыть.Видимость;
		Элементы.ПолучитьФайлДляТехПоддержкиОФ.Видимость 		= Элементы.КнопкаЗакрыть.Видимость;
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗакрытиеФормыСРезультатом(РезультатВопроса)
	
	РезультатЗакрытия = Новый Структура("РезультатВопроса", РезультатВопроса);
	Если РезультатВопроса = "Отложить" Тогда
		РезультатЗакрытия.Вставить("СрокДоСледующейПроверки", ГлубинаОтбораОшибок);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезультатЗакрытия);
		КонецЕсли;
	#Иначе
		Закрыть(РезультатЗакрытия);
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьПорталТПКлеверенс(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьПорталТПКлеверенсЗавершение", ЭтаФорма);
	НачатьЗапускПриложения(ОписаниеОповещения, Элементы.СсылкаНаПорталТПКлеверенс.Подсказка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПорталТПКлеверенсЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	Результат = Истина;
	ОчиститьСообщения();
	
	Если НомерТелефона <> "" И _ЛокКонтекст.ЛокЯдро_СтрРазделить(НомерТелефона, " ").Количество() > 3 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Некорректный номер телефона';
								|en = 'Incorrect phone number'; be = 'Некарэктны нумар тэлефона'; es = 'Número de Teléfono incorrecto'; ka = 'არასწორი ტელეფონის ნომერი'; kk = 'Дұрыс емес телефон нөмірі'; ro = 'Număr de telefon incorect'; tr = 'Yanlış telefon numarası'; uk = 'Некоректний номер телефону'; uz = 'Noto''g''ri telefon raqami'");
		Сообщение.Поле = "НомерТелефона";
		Сообщение.УстановитьДанные(НомерТелефона);
		Сообщение.Сообщить();
		
		Результат = Ложь;
	КонецЕсли;
	
	Почта = СтрЗаменить(СокрЛП(Почта), " ", "");
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Если Почта <> "" И НЕ _ЛокКонтекст.ЛокЯдро_ПроверитьКорректностьEmail(Почта) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Некорректный адрес электронный почты';
								|en = 'Incorrect email address'; be = 'Некарэктны адрас электроннай пошты'; es = 'Dirección de correo electrónico incorrecta'; ka = 'არასწორი ელექტრონული ფოსტის მისამართი'; kk = 'Электрондық пошта мекенжайы дұрыс емес'; ro = 'Adresă de e-mail incorectă'; tr = 'Yanlış e-posta adresi'; uk = 'Некоректна адреса електронної пошти'; uz = 'Noto''g''ri elektron pochta manzili'");
		Сообщение.Поле = "Почта";
		Сообщение.УстановитьДанные(Почта);
		Сообщение.Сообщить();
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

