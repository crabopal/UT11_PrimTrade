/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем пЭлементы,
	РезультатПодключения;
	
	
&НаКлиенте
Процедура Авторизоваться(Команда)
	
	АвторизацияТокен 	   = Неопределено;
	АвторизацияРефрешТокен = Неопределено;
	
	РезультатАвторизации = _ЛокКонтекст.ЛокЯдро_ПолучитьТокенSMARTS(СтрокаПодключения, Логин, Пароль, ТипБазы, ТипИнтерфейса, Компонента);
	
	Если ТипЗнч(РезультатАвторизации) = Тип("Структура") Тогда
		АвторизацияТокен 	   = РезультатАвторизации.Access_token;
		АвторизацияРефрешТокен = РезультатАвторизации.Refresh_token;
	ИначеЕсли ТипЗнч(РезультатАвторизации) = Тип("Строка") И НЕ ПустаяСтрока(РезультатАвторизации) Тогда
		АвторизацияТокен	   = РезультатАвторизации;
		АвторизацияРефрешТокен = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АвторизацияТокен) И НЕ АвторизацияТокен = Ложь Тогда
		КлючШифрования 	  = _ЛокКонтекст.ЛокЯдро_ПолучитьКлючШифрования(Логин, СтрДлина(Пароль), Компонента);
		АвторизацияПароль = _ЛокКонтекст.ЛокЯдро_ЗашифроватьСтроку(Пароль, КлючШифрования, Компонента);
		
		СтруктураРезультата = Новый Структура;
		СтруктураРезультата.Вставить("АвторизацияТокен", 	   АвторизацияТокен);
		СтруктураРезультата.Вставить("АвторизацияРефрешТокен", АвторизацияРефрешТокен);
		СтруктураРезультата.Вставить("АвторизацияТип",		   "login");
		
		ДопПараметры.Вставить("СтрокаПодключения", СтрокаПодключения);
		
		РезультатПодключения = _ЛокКонтекст.КомЯдро_ПодключитьсяКБазеSMARTSНаСервереЗавершение(СтруктураРезультата, ДопПараметры);
		СтруктураРезультата.Вставить("ПодключениеДоступно",		РезультатПодключения);
		Если РезультатПодключения = Ложь Тогда
			ТекстОшибки = 
				НСтр("ru = 'У данного пользователя Клеверенс недостаточно прав для подключения к базе!';
						|en = 'This Cleverence user does not have enough rights to connect to the database!';
						|be = 'У дадзенага карыстальніка Cleverence недастаткова правоў для падлучэння да базы!'; es = '¡Este usuario de Cleverence no tiene permisos suficientes para conectarse a la base de Datos!'; ka = 'ამ Cleverence მომხმარებელს არ აქვს საკმარისი უფლებები მონაცემთა ბაზასთან დასაკავშირებლად!'; kk = 'Бұл Cleverence пайдаланушысының базаға қосылу құқығы жеткіліксіз!'; ro = 'Acest utilizator inteligent nu are suficiente drepturi pentru a se conecta la baza de date!'; tr = 'Bu Cleverence kullanıcısının veritabanına bağlanmak için yeterli hakkı yok!'; uk = 'У даного користувача Cleverence недостатньо прав для підключення до бази!'; uz = 'Ushbu Cleverence foydalanuvchisi ma''lumotlar bazasiga ulanish uchun etarli huquqlarga ega emas!'") 
				+ Символы.ПС
				+ НСтр("ru = 'Пользователь должен находиться в группе ""Администраторы"" или ""Внешние подключения"".';
						|en = 'The user must be in the Administrators or External Connections group.';
						|be = 'Карыстальнік павінен знаходзіцца ў групе ""Адміністратары"" або ""Знешнія падлучэння"".'; es = 'El usuario debe estar en el grupo Administradores o conexiones Externas.'; ka = 'მომხმარებელი უნდა იყოს ადმინისტრატორების ან გარე კავშირების ჯგუფში.'; kk = 'Пайдаланушы ""әкімшілер"" немесе ""сыртқы байланыстар"" тобында болуы керек.'; ro = 'Utilizatorul trebuie să fie în grupul Administratori sau conexiuni externe.'; tr = 'Kullanıcının ""Yöneticiler"" veya ""Harici Bağlantılar"" grubunda olması gerekir.'; uk = 'Користувач повинен перебувати в групі ""адміністратори""або"" зовнішні підключення"".'; uz = 'Foydalanuvchi Administratorlar yoki tashqi ulanishlar guruhida bo''lishi kerak.'");
		Иначе
			Оповестить("ФормаСлужебная_АвторизацииSMARTSЗакрытие", СтруктураРезультата, ЭтаФорма);
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, СтруктураРезультата);
				Закрыть();	
			#Иначе
				Закрыть(СтруктураРезультата);
			#КонецЕсли
		КонецЕсли;
	Иначе
		ТекстОшибки = НСтр("ru = 'Введены неверные логин и/или пароль!';
							|en = 'Incorrect username and/or password have been entered!'; be = 'Ўведзеныя няслушныя лагін і / або пароль!'; es = 'Nombre de usuario y/o contraseña incorrectos introducidos!'; ka = 'არასწორი მომხმარებლის სახელი და / ან პაროლი შეყვანილია!'; kk = 'Логин және / немесе пароль қате енгізілді!'; ro = 'Numele de utilizator și/sau parola incorecte au fost introduse!'; tr = 'Yanlış kullanıcı adı ve / veya şifre girildi!'; uk = 'Введені невірні логін і / або пароль!'; uz = 'Noto''g''ri foydalanuvchi nomi va/yoki parol kiritildi!'");
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезультатПодключения);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()

	#Если ТолстыйКлиентОбычноеПриложение Тогда
		пЭлементы.ТекстОшибки.Видимость = ЗначениеЗаполнено(ТекстОшибки);
		пЭлементы.ТекстОшибки.Заголовок = ТекстОшибки;
	#Иначе
		пЭлементы.ДекорацияТекстОшибки.Видимость = ЗначениеЗаполнено(ТекстОшибки);
		пЭлементы.ДекорацияТекстОшибки.Заголовок = ТекстОшибки;
	#КонецЕсли
	
КонецПроцедуры

#Если ТолстыйКлиентОбычноеПриложение Тогда
	пЭлементы = ЭлементыФормы;
#Иначе
	КлючСохраненияПоложенияОкна = Новый УникальныйИдентификатор();
	пЭлементы = Элементы;
#КонецЕсли
