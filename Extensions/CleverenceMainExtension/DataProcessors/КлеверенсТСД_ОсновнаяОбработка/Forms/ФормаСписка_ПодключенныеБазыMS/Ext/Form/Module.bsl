/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ОткрытьФормуПодключения Экспорт;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УсловноеОформление.Элементы.Очистить();
	
	// Поддерживаемые конфигурации
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Для каждого ЭлементКолонки Из Элементы.ТаблицаПодключеныхБазMS.ПодчиненныеЭлементы Цикл	
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементКолонки.Имя);	
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаПодключеныхБазMS.ЭтоТекущаяБаза");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВнешниеКартинки();
	ОбновитьОтображениеПослеПодключения();
	ЗаполнитьТаблицуПодключенныхБаз();
	
	Если ОткрытьФормуПодключения = Истина Тогда
		ПодключитьОбработчикОжидания("ОткрытьФормуНастройкиПодключенияПослеОжидания", 0.1, Истина);
	КонецЕсли;
	ОткрытьФормуПодключения = Ложь;
	
	ОбновитьОтображениеСобытиеЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	Если ОткрытьФормуПодключения = Истина Тогда
		ОткрытьФормуНастройкиПодключения(Неопределено);
	КонецЕсли;
	ОткрытьФормуПодключения = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "УстановленыНастройкиПодключения" Тогда
		ЗаполнитьТаблицуПодключенныхБаз();
		ОбновитьОтображениеПослеПодключения();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьНастройкиПодключения(Команда)
	
	Если Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные = Неопределено Тогда
		ОткрытьФормуНастройкиПодключения(Неопределено);
	Иначе
		ОткрытьФормуНастройкиПодключения(Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.ПараметрыПодключенияMS);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьБазу(Команда)
	
	ОткрытьФормуНастройкиПодключения(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьБазу(Команда)
	
	Если Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные = Неопределено Тогда
		
		пСообщение = НСтр("ru = 'Не выбрана база для удаления'");
		Сообщить(пСообщение);
		
	ИначеЕсли Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.ЭтоТекущаяБаза Тогда
		
		пСообщение = НСтр("ru = 'Невозможно удалить текущую базу. Сначала переключитесь на другую в основной форме.';
							|en = 'The current database cannot be deleted. First, switch to another one in the main form.';
							|be = 'Немагчыма выдаліць бягучую базу. Спачатку пераключыцеся на іншую ў асноўнай форме.'; es = 'No se puede eliminar la base de datos actual. Primero cambie a otro en el formulario principal.'; ka = 'მიმდინარე მონაცემთა ბაზის წაშლა შეუძლებელია. პირველი, გადახვიდეთ მეორეზე ძირითადი ფორმით.'; kk = 'Ағымдағы базаны жою мүмкін емес. Алдымен негізгі пішінде екіншісіне ауысыңыз.'; ro = 'Baza de date curentă nu poate fi ștearsă. Mai întâi, treceți la altul în formularul principal.'; tr = 'Mevcut veritabanını silemezsiniz. Önce temel formda diğerine geçin.'; uk = 'Неможливо видалити поточну базу. Спочатку перейдіть на іншу в основній формі.'; uz = 'Joriy bazani olib tashlash mumkin emas. Avval asosiy shaklda boshqasiga o''ting.'");
		Сообщить(пСообщение);
		
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ПодтверждениеОтключенияБазыЗавершение", ЭтаФорма);
		
		пСообщение = НСтр("ru = 'Удалить базу «%1» из списка?';
							|en = 'Remove the ""%1"" database from the list?'; be = 'Выдаліць базу ""%1 "" з спісу?'; es = '¿Eliminar la base de datos ""%1 "" de la lista?'; ka = 'ამოიღეთ"" %1 "" მონაცემთა ბაზა სიიდან?'; kk = 'Тізімнен ""%1 "" базасын жою керек пе?'; ro = 'Eliminați baza de date ""%1 "" din listă?'; tr = '«%1» tabanını listeden kaldırıyor musunuz?'; uk = 'Видалити базу ""%1 "" зі списку?'; uz = '""%1 "" ma''lumotlar bazasini ro''yxatdan olib tashlaysizmi?'");
		пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.Имя);
		
		ПоказатьВопрос(Оповещение, пСообщение, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ТаблицаПодключеныхБазMSПриАктивизацииСтроки(Элемент)
	
	ОбновитьОтображениеСобытиеЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПодключеныхБазMSВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьФормуНастройкиПодключения(Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.ПараметрыПодключенияMS);
	
КонецПроцедуры

#КонецОбласти

#Область Оформление

&НаКлиенте
Процедура ОбновитьОтображениеПослеПодключения(ПараметрыВыполнения = Неопределено)
	
	_ЛокКонтекст.ЛокЯдро_Оформление_УстановитьСтильОсновнойКнопки(Элементы.ДобавитьБазу);
	
КонецПроцедуры

// Внешние картинки необходимо устанавливать программно, чтобы не создавать множество копий картинок.
// 	При выгрузке обработки в файлы, внешние картинки дублируются для каждого отдельного элемента.
//	Поэтому загружаем картинку только для одного элемента и далее присваиваем её программно.
// Для загрузки картинки необходимо создать элемент декорации картинка в группе ГруппаКартинкиСлужебный в форме ГлавнаяФорма
//	Загрузить в неё картинку и далее прописать элементы в СоответствиеЭлементов, которые будут использовать эту картинку.
&НаКлиенте
Процедура УстановитьВнешниеКартинки()
	
	// Пишем имена картинок без приписки "Картинка"
	СоответствиеЭлементов = Новый Соответствие;
	
	СоответствиеЭлементов.Вставить("ДобавитьБазу",					"ДобавитьБелый");
	СоответствиеЭлементов.Вставить("УдалитьБазу",					"УдалитьЧерный");
	СоответствиеЭлементов.Вставить("ИзменитьНастройкиПодключения",	"ЧекЛистЧерный");
	
	Для каждого КлючЗначение Из СоответствиеЭлементов Цикл
		Элементы[КлючЗначение.Ключ].Картинка = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку(КлючЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеСобытиеЭлементов()
	
	Элементы.УдалитьБазу.Доступность = НЕ Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные = Неопределено
		И НЕ Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.ЭтоТекущаяБаза;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодтверждениеОтключенияБазыЗавершение(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		_ЛокКонтекст.ЛокЯдро_УдалитьБазуИзСпискаПодключенныхБазMS(Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные.Ид);
		ТаблицаПодключеныхБазMS.Удалить(Элементы.ТаблицаПодключеныхБазMS.ТекущиеДанные);
		ЗаполнитьТаблицуПодключенныхБаз();
		Оповестить("ИзменениеСпискаПодключенныхБазMS");
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьТаблицуПодключенныхБаз()
	
	ID_ТекущейБазы = _ЛокКонтекст.ВладелецФормы.ID_ТекущейБазы;
	ТаблицаПодключеныхБазMS.Очистить();
	ПодключенныеБазыMS = _ЛокКонтекст.ЛокЯдро_ПолучитьПараметрыПодключенныхБазMS();
	Если НЕ ПодключенныеБазыMS = Ложь И ТипЗнч(ПодключенныеБазыMS) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из ПодключенныеБазыMS Цикл
			
			ПараметрыПодключенияMS = КлючЗначение.Значение;
			
			НоваяСтрока = ТаблицаПодключеныхБазMS.Добавить();
			НоваяСтрока.Ид 						= КлючЗначение.Ключ;
			НоваяСтрока.Имя 					= ПараметрыПодключенияMS.Имя;
			НоваяСтрока.ВерсияПриложения 		= ПараметрыПодключенияMS.ВерсияПриложения;
			НоваяСтрока.ПараметрыПодключенияMS 	= ПараметрыПодключенияMS;
			
			Если НоваяСтрока.Ид = ID_ТекущейБазы Тогда
				НоваяСтрока.ТекущаяБаза = НСтр("ru = 'Текущая';
												|en = 'Current'; be = 'Бягучы'; es = 'Actual'; ka = 'მიმდინარე'; kk = 'Ағымдағы'; ro = 'Curent'; tr = 'Cari'; uk = 'Поточний'; uz = 'Hozirgi'");
				НоваяСтрока.ЭтоТекущаяБаза = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаПодключеныхБазMS.Сортировать("Имя");
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуНастройкиПодключенияПослеОжидания()
	
	ОткрытьФормуНастройкиПодключения(Неопределено);
	
КонецПроцедуры 

// Открывает форму настройки подключения к базе SMARTS
&НаКлиенте
Процедура ОткрытьФормуНастройкиПодключения(ПараметрыПодключения = Неопределено)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения = ПолучитьФорму("ОФ_ФормаСлужебная_НастройкиПодключения",ЭтаФорма);
	#Иначе
		СтруктураПараметров = Новый Структура;
		ЭтоВебКлиент = Ложь;
		#Если ВебКлиент Тогда
			ЭтоВебКлиент = Истина;
		#КонецЕсли
		СтруктураПараметров.Вставить("ЭтоВебКлиент", ЭтоВебКлиент);
		
		ФормаНастройкиПодключения = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_НастройкиПодключения", СтруктураПараметров, ЭтаФорма, ЭтаФорма);
		ФормаНастройкиПодключения.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаНастройкиПодключения.ДоступноВыполнениеВФоне = ВладелецФормы.ДоступноВыполнениеВФоне;
	#КонецЕсли
	
	ФормаНастройкиПодключения.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаНастройкиПодключения._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаНастройкиПодключения.ТипБазы						= "Основная";
	ФормаНастройкиПодключения.ПараметрыПодключения			= ПараметрыПодключения;
	ФормаНастройкиПодключения.Компонента					= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РасположениеКомпоненты");
	ФормаНастройкиПодключения.ТипИнтерфейса					= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_ТипИнтерфейса");
	ФормаНастройкиПодключения.РежимВыбораБазы				= _ЛокКонтекст.ЛокЯдро_ПолучитьДанныеИзХранилища1С("Cleverence_РежимВыбораБазы");
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаНастройкиПодключения.ОткрытьМодально();
	#Иначе
		ФормаНастройкиПодключения.Открыть();
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область УниверсальныеМеханизмы


#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	//Элементы = ЭлементыФормы;
	
#КонецЕсли