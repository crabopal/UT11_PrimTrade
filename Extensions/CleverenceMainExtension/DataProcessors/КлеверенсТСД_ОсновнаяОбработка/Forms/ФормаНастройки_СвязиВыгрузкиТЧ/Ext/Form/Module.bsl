&НаКлиенте
Процедура ФормаСписка_ПроизвольныеКодыОбработчиковЗакрытие(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	ОбновитьСписокПроизвольныхКодов(ДопПараметры.ДопТипОбработки);
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика + "Выбор";
	#Иначе
		ИмяПоляОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	#КонецЕсли      	
	ИмяОбработчикаСобытия = ДопПараметры.СтрокаОбработчика;
	
	Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.Очистить();
	
	ЗаполнитьСписокВыбора(Элементы[ИмяПоляОбработчикаСобытия], СписокПроизвольныхКодовОбработчиков);	
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ДопПараметры.ПредыдущееЗначение);		
	Иначе 
		НайденныйЭлементСписка = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ВыбранноеЗначение);		
	КонецЕсли;
	
	Если НайденныйЭлементСписка = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;		
	ИначеЕсли Элементы[ИмяПоляОбработчикаСобытия].СписокВыбора.НайтиПоЗначению(НайденныйЭлементСписка.Значение) = Неопределено Тогда
		ЭтаФорма[ИмяОбработчикаСобытия] = Неопределено;
	Иначе
		ЭтаФорма[ИмяОбработчикаСобытия] = НайденныйЭлементСписка.Значение;
	КонецЕсли;	
	
	ИмяОбработчика = СтрЗаменить(ИмяОбработчикаСобытия, "Обработчик_", "");
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастей1С()
	
	СписокТЧ = Новый СписокЗначений;
	Для Каждого ЭлементТЧ Из СтруктураДокумента1С.ТабличныеЧасти Цикл
		СписокТЧ.Добавить(ЭлементТЧ.Значение.Имя, ЭлементТЧ.Значение.Синоним);
	КонецЦикла;
	Если СписокТЧ.НайтиПоЗначению("(Запрос)") = Неопределено Тогда
		СписокТЧ.Добавить("(Запрос)", "(Запрос)");
	КонецЕсли;
	
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено Тогда
		Для Каждого КлючЗначение Из СписокДополнительныхОбработчиков Цикл
			Синоним = ?(КлючЗначение.Значение.Свойство("Синоним"),КлючЗначение.Значение.Синоним,КлючЗначение.Ключ);
			СписокТЧ.Добавить(КлючЗначение.Ключ,Синоним);	
		КонецЦикла;
	КонецЕсли;

	
	СписокТЧ.СортироватьПоПредставлению();
	
	Возврат СписокТЧ;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТабличныхЧастейMS()
	
	СписокТЧ = Новый СписокЗначений;
	
	СписокТЧ.Добавить("СтрокиФакт");
	СписокТЧ.Добавить("СтрокиПлан");
	СписокТЧ.Добавить("СерииПлан");
	СписокТЧ.Добавить("СерииФакт");
	СписокТЧ.Добавить("СерийныеНомераПлан");
	СписокТЧ.Добавить("СерийныеНомераФакт");
		
	СписокДопТаблиц = _ЛокКонтекст.СтруктураМетаданных.ДокументыMS[ТипДокументаMS].ДополнительныеТаблицы;
	
	Для Каждого ДопТаблица Из СписокДопТаблиц Цикл		
		СписокТЧ.Добавить(ДопТаблица.Представление);		
	КонецЦикла;	
	
	Возврат СписокТЧ;
	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент, Список)
	
	Приемник = Элемент.СписокВыбора;
	Для Каждого Элем Из Список Цикл
		Приемник.Добавить(Элем.Значение, Элем.Представление);	
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Не ТипЗнч(Элемент) = Тип("ПолеВыбора") Тогда
			Элемент.РежимВыбораИзСписка = Истина;
			Элемент.КнопкаСпискаВыбора 	= Истина;
		КонецЕсли;		
	#Иначе
		Элемент.РежимВыбораИзСписка 	= Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПолеПодчиненнойТаблицы()
	ТекущаяСтрока = Элементы.СвязиТабличныхЧастей.ТекущиеДанные;	
	СписокРеквизитов1С = Новый СписокЗначений;
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено
		И ЗначениеЗаполнено(ТекущаяСтрока.ПодчиненнаяТаблица)
		И СписокДополнительныхОбработчиков.Получить(ТекущаяСтрока.ПодчиненнаяТаблица) <> Неопределено Тогда
		СписокРеквизитов1С = СписокДополнительныхОбработчиков[ТекущаяСтрока.ПодчиненнаяТаблица].СписокКолонок;
	КонецЕсли;
	
	Если СписокРеквизитов1С.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ПодчиненнаяТаблица) Тогда
			Если ТекущаяСтрока.ПодчиненнаяТаблица = "(Запрос)" Тогда
				ТЧЗапрос = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой","(Запрос)"));
				Если ТЧЗапрос.Количество() = 0 Тогда
					Сообщение = НСтр("ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.';
										|en = 'The list of fields could not be retrieved due to a request execution error.';
										|be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; es = 'No se pudo obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სია ვერ მოიძებნა მოთხოვნის შესრულების შეცდომის გამო.'; kk = 'Сұрауды орындау қатесі себебінен өрістер тізімін алу мүмкін болмады.'; ro = 'Lista câmpurilor nu a putut fi recuperată din cauza unei erori de execuție a cererii.'; tr = 'Sorgu yürütme hatası nedeniyle alanların listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = 'So''rovni bajarish xatosi tufayli maydonlar ro''yxatini olishning iloji bo''lmadi.'");
					Сообщить(Сообщение); 
					СписокРеквизитов1С = Новый СписокЗначений;
				Иначе
					ТекстЗапросаВыгрузкиНаТСД = ТЧЗапрос[0].ТекстЗапросаВыгрузкиНаТСД;
					СписокРеквизитов1С = ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);
				КонецЕсли;
			Иначе
				СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекущаяСтрока.ПодчиненнаяТаблица].Реквизиты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПолеПодчиненнойТаблицыСиноним,СписокРеквизитов1С);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапроса);
	
	СписокПолей = Новый СписокЗначений;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документы[ТипДокумента1С].ПустаяСсылка());
	
	ПараметрыЗапроса = Запрос.НайтиПараметры();
	Для каждого ПараметрЗапроса ИЗ ПараметрыЗапроса Цикл
		Если ПараметрЗапроса.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр(ПараметрЗапроса.Имя, Ложь);
	КонецЦикла;
	
	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
		Для Каждого Колонка из Результат.Колонки Цикл
			СписокПолей.Добавить(Колонка.Имя, Колонка.Имя);
		КонецЦикла;
	Исключение
		Сообщение = НСтр("ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.';
							|en = 'The list of fields could not be retrieved due to a request execution error.';
							|be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; es = 'No se pudo obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სია ვერ მოიძებნა მოთხოვნის შესრულების შეცდომის გამო.'; kk = 'Сұрауды орындау қатесі себебінен өрістер тізімін алу мүмкін болмады.'; ro = 'Lista câmpurilor nu a putut fi recuperată din cauza unei erori de execuție a cererii.'; tr = 'Sorgu yürütme hatası nedeniyle alanların listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = 'So''rovni bajarish xatosi tufayli maydonlar ro''yxatini olishning iloji bo''lmadi.'");
		Сообщить(Сообщение); 
	КонецПопытки;
	
	Возврат СписокПолей;

КонецФункции

