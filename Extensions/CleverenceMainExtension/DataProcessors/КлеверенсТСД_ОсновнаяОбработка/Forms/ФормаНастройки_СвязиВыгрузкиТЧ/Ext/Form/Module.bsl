/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем СтруктураДокумента1С Экспорт,
	СтруктураДокументаMS Экспорт,
	ТаблицаРеквизитовДополнительная Экспорт,
	пТабличныеЧасти Экспорт,
	пСвязиТабличныхЧастей Экспорт,
	пРазрешитьЗакрытие;	


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		УстановитьУсловноеОформление();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СтруктураНастроекТиповая = Неопределено Тогда
		СтруктураНастроекТиповая = Новый Структура;
	КонецЕсли;
	
	ЗаполнитьТабличныеНастройки();
	
	// Список вариантов обработчиков загрузки
	СписокВариантовОбработчиков.Добавить(0, "Без обработчика");
	СписокВариантовОбработчиков.Добавить(1, "Обработчик по умолчанию");
	СписокВариантовОбработчиков.Добавить(2, "Свой обработчик");
	СписокВариантовОбработчиков.Добавить(3, "Произвольный код");
	
	СписокТабличныхЧастей1С = ПолучитьСписокТабличныхЧастей1С();
	СписокТабличныхЧастейMS = ПолучитьСписокТабличныхЧастейMS();
	
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиТабличнаяЧастьДокументаMS,СписокТабличныхЧастейMS); 		
	ЗаполнитьСписокВыбора(Элементы.ТабличныеЧастиНастройкаТЧСтрокой,СписокТабличныхЧастей1С);
	
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейГлавнаяТаблица,СписокТабличныхЧастей1С); 	
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПодчиненнаяТаблица,СписокТабличныхЧастей1С); 		
	ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейТабличнаяЧастьДокументаMS,СписокТабличныхЧастейMS);
	
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОбъединенияТабличнойЧасти, СписокВариантовОбработчиков);
	ЗаполнитьСписокВыбора(Элементы.ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти, СписокВариантовОбработчиков);
	
	МассивИменРеквизитов = Новый Массив;
	МассивИменРеквизитов.Добавить("Обработчик_ПослеОбъединенияТабличнойЧасти");
	МассивИменРеквизитов.Добавить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти");
	
	ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов);
	
	ЗаполнениеСоответствияВидовОбработчиковВыгрузки();
	
	ОбновитьОтображениеПриОткрытии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И пРазрешитьЗакрытие <> Истина Тогда
		
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Сохранить внесенные изменения?';
								|en = 'Save your changes?'; be = 'Захаваць унесеныя змены?'; es = '¿Guardar los cambios realizados?'; ka = 'შეინახეთ თქვენი ცვლილებები?'; kk = 'Енгізілген өзгерістерді сақтау керек пе?'; ro = 'Salvați modificările?'; tr = 'Yaptığınız değişiklikleri kaydetmek mi istiyorsunuz?'; uk = 'Зберегти внесені зміни?'; uz = 'Kiritilgan o''zgarishlarni saqlaysizmi?'");
		ОповещениеСохранитьВнесенныеИзменения = Новый ОписаниеОповещения("ВопросСохранитьИзмененияЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОповещениеСохранитьВнесенныеИзменения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Если НЕ ПроверитьКорректностьДобавленныхОбработчиков() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьДоступностьСохранения() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТабличныеЧасти", 										_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("ТабличныеЧасти")));
	Результат.Вставить("СвязиТабличныхЧастей", 									_ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПоместитьТЧВоВременноеХранилище("СвязиТабличныхЧастей")));
	Результат.Вставить("Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти",  		Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти);
	Результат.Вставить("Обработчик_ПослеОбъединенияТабличнойЧасти",        		Обработчик_ПослеОбъединенияТабличнойЧасти);
	Результат.Вставить("ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",  	ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти);
	Результат.Вставить("ВидОбработчика_ПослеОбъединенияТабличнойЧасти",        	ВидОбработчика_ПослеОбъединенияТабличнойЧасти);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии,Результат);
		КонецЕсли;
	#КонецЕсли
	
	пРазрешитьЗакрытие = Истина;
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТиповыеНастройки(Команда)
	
	пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройки таблиц будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповыеНастройкиЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбработчика_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки = Элемент.Имя;
	Обработчик_ИзменитьЗначение = ЭтаФорма[ИмяЭлементаОбработки] <> ВыбранноеЗначение;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработчика_ОбработкаПриИзменении(Элемент)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	СтруктураОбработчика	= СтруктураВидовОбработчиков[ИмяЭлементаОбработки];
	ИмяОбработчика			= СтруктураОбработчика.Тип; 
	СтрокаОбработчика		= СтруктураОбработчика.Обработчик;
	
	Элементы[СтрокаОбработчика].СписокВыбора.Очистить();
	
	БезЗаполнения	= ЭтаФорма[ИмяЭлементаОбработки] = 0;
	ПоУмолчанию		= ЭтаФорма[ИмяЭлементаОбработки] = 1;
	СвойОбработчик	= ЭтаФорма[ИмяЭлементаОбработки] = 2;	
	ПроизвольныйКод	= ЭтаФорма[ИмяЭлементаОбработки] = 3;
	
	Если ПоУмолчанию Тогда 		
		
		// Формируем стандартное имя процедуры
		ТипОбработчика = СтрЗаменить(ИмяОбработчика, "ТабличнойЧасти", "ТЧ");
		ЭтаФорма[СтрокаОбработчика] = _ЛокКонтекст.ЛокЯдро_ПолучитьУниверсальноеИмяОбработчика(ТипОбработчика, ТипДокумента1С);
		
	ИначеЕсли СвойОбработчик Тогда
		
		// Оставляем пустое строковое поле для ручного ввода имени процедуры, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
		КонецЕсли;
		
	ИначеЕсли ПроизвольныйКод Тогда
		
		// Очищаем строку обработчика и предоставляем возможность выбора из списка подходящих кодов, если вид обработчика изменился
		Если Обработчик_ИзменитьЗначение Тогда
			ЭтаФорма[СтрокаОбработчика] = "";	
			
			// В обычных формах подменяем поле ввода обработчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[СтрокаОбработчика].Видимость = Ложь;
				Элементы[СтрокаОбработчика + "Выбор"].Видимость = Истина;
				Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Очистить();
				Элементы[СтрокаОбработчика + "Выбор"].ВыделенныйТекст = "";
			#КонецЕсли
			
			Элементы[СтрокаОбработчика].ВыделенныйТекст = "";					
		Иначе
			ТекЗначение = СписокПроизвольныхКодовОбработчиков.НайтиПоЗначению(ЭтаФорма[СтрокаОбработчика]);
			Если ТекЗначение <> Неопределено Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Элементы[СтрокаОбработчика + "Выбор"].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#Иначе
					Элементы[СтрокаОбработчика].СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
				#КонецЕсли
			КонецЕсли;                                                                                             			
		КонецЕсли;					
		
	ИначеЕсли БезЗаполнения Тогда
		
		ЭтаФорма[СтрокаОбработчика] = "";	
		
	КонецЕсли;
	
	ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		// Возвращаем видимость поля ввода обработчика, если выбран не произвольный код
		Если Не ПроизвольныйКод Тогда
			Элементы[СтрокаОбработчика].Видимость = Истина;
			Элементы[СтрокаОбработчика + "Выбор"].Видимость = Ложь;							
		Иначе
			ЭлементСтрокиОбработчика = Элементы[СтрокаОбработчика + "Выбор"];		
		КонецЕсли;                                                                                                                             		    		
	#КонецЕсли
	
	УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокиОбработчика, ЭтаФорма[СтрокаОбработчика], ЭтаФорма[ИмяЭлементаОбработки]);
	
	Если Обработчик_ИзменитьЗначение Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаПриИзменении(Элемент)
	
	ИмяОбработчика = СтрЗаменить(Элемент.Имя, "Обработчик_", "");
	УстановитьВидимостьКнопкиСброситьОбработчик(ИмяОбработчика);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаНачалоВыбораОбработчикаВыгрузки(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
		
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
	
		ПредыдущееЗначение 		= ЭтаФорма[ИмяЭлементаОбработки];		
		СтандартнаяОбработка 	= Ложь;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаСписка_ПроизвольныеКоды", ПредыдущееЗначение); 
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ОбработкаОткрытиеОбработчикаВыгрузки(Элемент, СтандартнаяОбработка)
		
	ИмяЭлементаОбработки	= Элемент.Имя;
	// В обычных формах заменяем имя поля выбора произвольного кода на имя поля ввода обработчика
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяЭлементаОбработки = СтрЗаменить(ИмяЭлементаОбработки, "Выбор", "");
	#КонецЕсли      
	ИмяОбработчика 			= СтрЗаменить(ИмяЭлементаОбработки, "Обработчик_", "");
	СтрокаВидаОбработчика	= "ВидОбработчика_" + ИмяОбработчика;
	
	Если ЭтаФорма[СтрокаВидаОбработчика] = 3 Тогда
				
		СтандартнаяОбработка 	= Ложь;
		Если ПустаяСтрока(ЭтаФорма[ИмяЭлементаОбработки]) Тогда
			Возврат;
		КонецЕсли;
		
		Обработчик_ОткрытиеФормыПроизвольногоКода(ИмяЭлементаОбработки, "ФормаНастройки_ПроизвольныйКод", ЭтаФорма[ИмяЭлементаОбработки], Истина); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьПользовательскуюНастройкуНажатие(Элемент)
	
	ВидОбработчика = СтрЗаменить(Элемент.Имя, "Сбросить", "");
	
	пЗаголовок = НСтр("ru = 'Восстановить настройку обработчика по умолчанию?'");
	пСообщение = НСтр("ru = 'Настройка обработчика будет сброшена к значениям по умолчанию. Пользовательские изменения будут удалены.'");
	
	ОП = Новый ОписаниеОповещения("ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение", ЭтаФорма, ВидОбработчика);
	ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФорм

//////////////////////////////////////////
// ТабличныеЧасти
//////////////////////////////////////////

&НаКлиенте
Процедура ТабличныеЧастиПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиПриАктивизацииСтроки(Элемент)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		ДоступностьИзменения = Элементы.ТабличныеЧасти.ТекущиеДанные <> Неопределено И НЕ Элементы.ТабличныеЧасти.ТекущиеДанные.Типовой;
		
		Элементы.ТабличныеЧастиУдалить.Доступность = ДоступностьИзменения;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
		
	НоваяСтрока = ТабличныеЧасти.Добавить();	
	НоваяСтрока.ТабличнаяЧастьДокументаMS = ТабличнаяЧастьДокументаMS;	
	
	НоваяСтрока.Настроить 					  = "Настроить";
	НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = Ложь;
	НоваяСтрока.ВыгружатьСтрокиПоУсловию 	  = "Выключено";
	
	Если Копирование Тогда
		ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, , "ТабличнаяЧастьДокументаMS, ТабличнаяЧастьДокумента1ССтрокой");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой) Тогда
		ТабличнаяЧастьДокумента1С = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой);
		НоваяСтрока.Настроить = ?(НоваяСтрока.ТабличнаяЧастьДокумента1С.Количество(), "Настроено", "Настроить");
	КонецЕсли;
	
	НоваяСтрока.Типовой = Ложь;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиНастройкаТЧСтрокойПриИзменении(Элемент)
		
	ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(ТекущаяСтрока.НастройкаТЧСтрокой, 1) = "(", Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(ТекущаяСтрока.НастройкаТЧСтрокой));
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловию		  = "Выключено";
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = Ложь;
	ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = "";	
		
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КолонкаИмя = Элемент.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элемент.ТекущийЭлемент.Имя;	
	#КонецЕсли
	
	ИмяКолонкиНастройкаПолей  = ВРег(СокрЛП("ТабличныеЧастиНастроить"));
	ИмяКолонкиУсловияВыгрузки = ВРег(СокрЛП("ТабличныеЧастиВыгружатьСтрокиПоУсловию"));
	
	ТекущаяСтрока = Элементы.ТабличныеЧасти.ТекущиеДанные;
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиНастройкаПолей
		ИЛИ ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.НастройкаТЧСтрокой) Тогда
			ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа 1С';
										|en = 'The tabular part of the 1C document is not selected'; be = 'Ня абраная Таблічная частка дакумента 1С'; es = 'No se ha seleccionado la parte de tabla del documento 1C'; ka = '1c დოკუმენტის ცხრილის ნაწილი არ არის შერჩეული'; kk = '1С құжатының кестелік бөлігі таңдалмаған'; ro = 'Partea tabelară a documentului 1C nu este selectată'; tr = '1C belgesinin tablo kısmı seçilmedi'; uk = 'Не вибрано табличну частину документа 1С'; uz = '1C hujjatining jadval qismi tanlanmagan'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ВРег(СокрЛП(КолонкаИмя)) = ИмяКолонкиУсловияВыгрузки Тогда
		
		Если НЕ ТекущаяСтрока.ТабличнаяЧастьЕстьВМетаданных Тогда
			ТекстПредупреждения = НСтр("ru = 'Настройка доступна только для табличных частей из метаданных конфигурации 1С';
										|en = 'The configuration is only available for the tabular parts from the metadata of the 1C configuration';
										|be = 'Налада даступная толькі для таблічных частак з метададзеных канфігурацыі 1С'; es = 'La configuración solo está disponible para las partes de tabla de los metadatos de configuración 1C'; ka = 'კონფიგურაცია ხელმისაწვდომია მხოლოდ ცხრილის ნაწილებისთვის 1c კონფიგურაციის მეტამონაცემებიდან'; kk = 'Орнату тек 1С конфигурациясының метадеректерінен кестелік бөліктер үшін қол жетімді'; ro = 'Configurația este disponibilă numai pentru părțile tabulare din metadatele configurației 1C'; tr = 'Yapılandırma, yalnızca 1C yapılandırma meta verilerindeki tablo bölümleri için kullanılabilir'; uk = 'Налаштування доступна тільки для табличних частин з метаданих конфігурації 1С'; uz = 'Sozlash faqat 1C konfiguratsiya metama''lumotlaridan jadval qismlari uchun mavjud'");
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			Возврат;
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму("ОФ_ФормаНастройки_УсловияУдаленияСтрокТЧ", ЭтаФорма);
		#Иначе
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_УсловияУдаленияСтрокТЧ",, ЭтаФорма, ЭтаФорма);
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ._ЛокКонтекст 		  = _ЛокКонтекст;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ТипДокумента1С 	  = ТипДокумента1С;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
				
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.КомпоновщикНастроекСтрокой = ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой;
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.УдалятьСтрокиПоУсловиюФлаг = ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг;
		
		Если ТекущаяСтрока.Типовой Тогда
			
			пСтруктураНастроекТиповая = Новый Структура("ВыгружатьСтрокиПоУсловиюСтрокой, ВыгружатьСтрокиПоУсловиюФлаг");
			ТиповаяСтрока = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ, "ТабличнаяЧастьДокументаMS", ТекущаяСтрока.ТабличнаяЧастьДокументаMS);
			ЗаполнитьЗначенияСвойств(пСтруктураНастроекТиповая, ТиповаяСтрока);
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ЭтоТиповаяНастройка = Истина;
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.СтруктураНастроекТиповая = пСтруктураНастроекТиповая;
			
		КонецЕсли;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие", ЭтаФорма, Новый Структура("ТекущаяСтрока", ТекущаяСтрока));
		ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.Заголовок = 
				НСтр("ru = 'Клеверенс: Настройка условия выгрузки строк';
						|en = 'Cleverence: Setting up the condition for uploading rows'; be = 'Cleverence: Налада ўмовы выгрузкі радкоў'; es = 'Cleverence: configuración de la condición de descarga de fila'; ka = 'კლევერენცია: რიგების ატვირთვის პირობის დაყენება'; kk = 'Cleverence: жолдарды жүктеу шарттарын орнату'; ro = 'Cleverence: Configurarea condiției pentru încărcarea rândurilor'; tr = 'Cleverence: Satır boşaltma koşulunu ayarlama'; uk = 'Cleverence: Налаштування умови вивантаження рядків'; uz = 'Aniqlik: satrlarni yuklash shartlarini Sozlash'");
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ЭлементыФормы.ТекстПодсказки.Заголовок = 
				НСтр("ru = 'Настройте условие выгрузки строк табличной части. Будут выгружены только те строки, которые удовлетворяют заданному условию';
						|en = 'Set up the condition for unloading rows of the tabular part. Only those rows that meet the specified condition will be unloaded';
						|be = 'Наладзьце ўмова выгрузкі радкоў таблічнай часткі. Будуць высаджаны толькі тыя радкі, якія задавальняюць зададзеным умове'; es = 'Configure la condición de descarga de filas de la parte de tabla. Solo se descargarán las filas que cumplan la condición especificada'; ka = 'დააყენეთ ცხრილის ნაწილის რიგების გადმოტვირთვის პირობა. გადმოტვირთული იქნება მხოლოდ ის რიგები, რომლებიც აკმაყოფილებენ მითითებულ პირობას'; kk = 'Кесте бөлігінің жолдарды жүктеу шартын реттеңіз. Берілген шартты қанағаттандыратын жолдар ғана түсіріледі'; ro = 'Configurați condiția pentru descărcarea rândurilor din partea tabelului. Numai acele rânduri care îndeplinesc condiția specificată vor fi descărcate'; tr = 'Tablo bölümünün satırlarını boşaltma koşulunu ayarlayın. Yalnızca belirli bir koşulu karşılayan satırlar boşaltılacaktır'; uk = 'Налаштуйте умову вивантаження рядків табличній частині. Будуть вивантажені тільки ті рядки, які задовольняють заданій умові'; uz = 'Jadval qismining satrlarini tushirish holatini sozlang. Faqat berilgan shartni qondiradigan satrlar tushiriladi'");	
				
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.ОткрытьМодально();
		#Иначе
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.Заголовок = 
				НСтр("ru = 'Клеверенс: Настройка условия выгрузки строк';
						|en = 'Cleverence: Setting up the condition for uploading rows'; be = 'Cleverence: Налада ўмовы выгрузкі радкоў'; es = 'Cleverence: configuración de la condición de descarga de fila'; ka = 'კლევერენცია: რიგების ატვირთვის პირობის დაყენება'; kk = 'Cleverence: жолдарды жүктеу шарттарын орнату'; ro = 'Cleverence: Configurarea condiției pentru încărcarea rândurilor'; tr = 'Cleverence: Satır boşaltma koşulunu ayarlama'; uk = 'Cleverence: Налаштування умови вивантаження рядків'; uz = 'Aniqlik: satrlarni yuklash shartlarini Sozlash'");
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.Элементы.ТекстПодсказки.Заголовок = 
				НСтр("ru = 'Настройте условие выгрузки строк табличной части. Будут выгружены только те строки, которые удовлетворяют заданному условию';
						|en = 'Set up the condition for unloading rows of the tabular part. Only those rows that meet the specified condition will be unloaded';
						|be = 'Наладзьце ўмова выгрузкі радкоў таблічнай часткі. Будуць высаджаны толькі тыя радкі, якія задавальняюць зададзеным умове'; es = 'Configure la condición de descarga de filas de la parte de tabla. Solo se descargarán las filas que cumplan la condición especificada'; ka = 'დააყენეთ ცხრილის ნაწილის რიგების გადმოტვირთვის პირობა. გადმოტვირთული იქნება მხოლოდ ის რიგები, რომლებიც აკმაყოფილებენ მითითებულ პირობას'; kk = 'Кесте бөлігінің жолдарды жүктеу шартын реттеңіз. Берілген шартты қанағаттандыратын жолдар ғана түсіріледі'; ro = 'Configurați condiția pentru descărcarea rândurilor din partea tabelului. Numai acele rânduri care îndeplinesc condiția specificată vor fi descărcate'; tr = 'Tablo bölümünün satırlarını boşaltma koşulunu ayarlayın. Yalnızca belirli bir koşulu karşılayan satırlar boşaltılacaktır'; uk = 'Налаштуйте умову вивантаження рядків табличній частині. Будуть вивантажені тільки ті рядки, які задовольняють заданій умові'; uz = 'Jadval qismining satrlarini tushirish holatini sozlang. Faqat berilgan shartni qondiradigan satrlar tushiriladi'");	
			
			ФормаНастройки_УсловияВыгрузкиСтрокТЧ.Открыть();
		#КонецЕсли
		
	ИначеЕсли КолонкаИмя = "ТабличныеЧастиВосстановить" И ТекущаяСтрока.Типовой Тогда
		
		пЗаголовок = НСтр("ru = 'Восстановить настройки по умолчанию для таблицы %1?'");
		пЗаголовок =  _ЛокКонтекст.ЛокЯдро_СтрШаблон(пЗаголовок, ТекущаяСтрока.НастройкаТЧСтрокой);
		пСообщение = НСтр("ru = 'Настройки таблицы будут сброшены к значениям по умолчанию. Пользовательские изменения будут удалены.'");
		
		ОП = Новый ОписаниеОповещения("ВопросВосстановитьНастройкиТЧЗавершение", ЭтаФорма, ТекущаяСтрока);
		ПоказатьВопрос(ОП, пСообщение, РежимДиалогаВопрос.ДаНет,,, пЗаголовок);
		
	ИначеЕсли КолонкаИмя = "ТабличныеЧастиНастроить" Тогда
		
		ФормаНастройки_ПравилаВыгрузкиПолей = _ЛокКонтекст.ЛокЯдро_ПолучитьФорму("ФормаНастройки_ПравилаВыгрузкиПолей", ЭтаФорма, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ФормаНастройки_ПравилаВыгрузкиПолей._ЛокКонтекст = _ЛокКонтекст;
		ФормаНастройки_ПравилаВыгрузкиПолей.КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента";
		ФормаНастройки_ПравилаВыгрузкиПолей.ТипДокумента1С = ТипДокумента1С;
		ФормаНастройки_ПравилаВыгрузкиПолей.ТипДокументаMS = ТипДокументаMS;
		ФормаНастройки_ПравилаВыгрузкиПолей.ИмяТабличнойЧастиMS = ТабличнаяЧастьДокументаMS;
		ФормаНастройки_ПравилаВыгрузкиПолей.ИмяТабличнойЧасти1С = ТекущаяСтрока.НастройкаТЧСтрокой;
		ФормаНастройки_ПравилаВыгрузкиПолей.ТекстЗапросаВыгрузкиНаТСД        = ТекущаяСтрока.ТекстЗапросаВыгрузкиНаТСД;
		ФормаНастройки_ПравилаВыгрузкиПолей.ТекстКодаПолучениеПараметров     = ТекущаяСтрока.ТекстКодаПолучениеПараметров;
		
		ФормаНастройки_ПравилаВыгрузкиПолей.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти 	= ТекущаяСтрока.ВидОбработчика_ПередВыгрузкойСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.ВидОбработчика_ПередВыгрузкойТабличнойЧасти 		= ТекущаяСтрока.ВидОбработчика_ПередВыгрузкойТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти 	= ТекущаяСтрока.ВидОбработчика_ПослеВыгрузкиСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти 			= ТекущаяСтрока.ВидОбработчика_ПослеВыгрузкиТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.Обработчик_ПередВыгрузкойТабличнойЧасти 			= ТекущаяСтрока.Обработчик_ПередВыгрузкойТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти 		= ТекущаяСтрока.Обработчик_ПередВыгрузкойСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти		= ТекущаяСтрока.Обработчик_ПослеВыгрузкиСтрокиТабличнойЧасти;
		ФормаНастройки_ПравилаВыгрузкиПолей.Обработчик_ПослеВыгрузкиТабличнойЧасти 				= ТекущаяСтрока.Обработчик_ПослеВыгрузкиТабличнойЧасти;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой) Тогда
			ФормаНастройки_ПравилаВыгрузкиПолей.ТаблицаРеквизитовИсходная	= _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой);
		КонецЕсли;	
		
		ФормаНастройки_ПравилаВыгрузкиПолей.ТаблицаРеквизитовДополнительная  = ТаблицаРеквизитовДополнительная;	
		
		Если ТекущаяСтрока.Типовой Тогда
			
			пСтруктураНастроекТиповая = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ, "НастройкаТЧСтрокой", ТекущаяСтрока.НастройкаТЧСтрокой);
			Если пСтруктураНастроекТиповая <> Неопределено Тогда
				ФормаНастройки_ПравилаВыгрузкиПолей.СтруктураНастроекТиповая = пСтруктураНастроекТиповая;
				ФормаНастройки_ПравилаВыгрузкиПолей.ЭтоТиповаяНастройка = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие",ЭтаФорма,ТекущаяСтрока);
		ФормаНастройки_ПравилаВыгрузкиПолей.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ПравилаВыгрузкиПолей.ОткрытьМодально();	
		#Иначе
