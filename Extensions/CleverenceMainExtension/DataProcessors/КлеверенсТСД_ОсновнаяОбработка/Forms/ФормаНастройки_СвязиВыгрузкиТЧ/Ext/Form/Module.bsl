					СписокРеквизитов1С = Новый СписокЗначений;
				Иначе
					ТекстЗапросаВыгрузкиНаТСД = ТЧЗапрос[0].ТекстЗапросаВыгрузкиНаТСД;
					СписокРеквизитов1С = ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);
				КонецЕсли;
			Иначе
				СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекущаяСтрока.ГлавнаяТаблица].Реквизиты;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьСписокВыбора(Элементы.СвязиТабличныхЧастейПолеГлавнойТаблицыСиноним,СписокРеквизитов1С);	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПоместитьТЧВоВременноеХранилище(ИмяТЧ)
	
	Таблица = ЭтаФорма[ИмяТЧ];
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ТЗ = Таблица.Скопировать();
	#Иначе
		ТЗ = Таблица.Выгрузить();
	#КонецЕсли
	
	ТЗ.Сортировать("Типовой Убыв"); // Сортируем, т.к типовые поля всегда должны быть сверху
	
	Если ИмяТЧ = "ТабличныеЧасти" Тогда
		ТЗ.Колонки.Удалить("Восстановить");
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТЗ, Новый УникальныйИдентификатор());
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗаполненныхОбработчиковВыгрузки(МассивИменРеквизитов)
	
	Для Каждого РеквизитОбработчика Из МассивИменРеквизитов Цикл
		
		РеквизитВидаОбработчика = СтрЗаменить(РеквизитОбработчика, "Обработчик", "ВидОбработчика");
		Если Не ПустаяСтрока(ЭтаФорма[РеквизитОбработчика]) Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма[РеквизитВидаОбработчика]) Тогда
				ЭтаФорма[РеквизитВидаОбработчика] = 2; // "Свой обработчик"
			КонецЕсли;
		Иначе
			ЭтаФорма[РеквизитВидаОбработчика] = 0; // "Без обработчика"
		КонецЕсли;
		
		Если ЭтаФорма[РеквизитВидаОбработчика] = 3 Тогда // "Произвольный код"
			
			// В обычных формах подменяем поле ввода обарботчика на поле выбора, т.к. иначе не выводится представление выбранного значения
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Элементы[РеквизитОбработчика].Видимость 			= Ложь;				
				Элементы[РеквизитОбработчика + "Выбор"].Видимость 	= Истина;					
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика + "Выбор"], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика + "Выбор"], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#Иначе
				ЗаполнитьСписокВыбора(Элементы[РеквизитОбработчика], СписокПроизвольныхКодовОбработчиков);
				УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
			#КонецЕсли
		Иначе 
			УстановкаОформленияСтрокиОбработчикаВыгрузки(Элементы[РеквизитОбработчика], ЭтаФорма[РеквизитОбработчика], ЭтаФорма[РеквизитВидаОбработчика]);
		КонецЕсли;		

		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы[РеквизитВидаОбработчика].Значение = ЭтаФорма[РеквизитВидаОбработчика];
		#КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОформленияСтрокиОбработчикаВыгрузки(ЭлементСтрокаОбработчика, ЗначениеСтрокаОбработчика, КодВидаОбработчика)
	
	БезЗаполнения	= КодВидаОбработчика = 0;
	ПоУмолчанию		= КодВидаОбработчика = 1;
	СвойОбработчик	= КодВидаОбработчика = 2;	
	ПроизвольныйКод	= КодВидаОбработчика = 3;

	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ЭлементСтрокаОбработчика.РежимВыбораИзСписка	= ПроизвольныйКод;				
		ЭлементСтрокаОбработчика.КнопкаВыбора 			= ПроизвольныйКод;		    		
		ЭлементСтрокаОбработчика.КнопкаВыпадающегоСписка= Ложь;
	#Иначе
		ЭлементСтрокаОбработчика.Значение				= ЗначениеСтрокаОбработчика;
	#КонецЕсли                                          
	ЭлементСтрокаОбработчика.ТолькоПросмотр 			= ПоУмолчанию Или БезЗаполнения;     				
	ЭлементСтрокаОбработчика.ЦветТекста 				= ?(ПоУмолчанию, WebЦвета.Серый, Новый Цвет(51, 51, 51));
	ЭлементСтрокаОбработчика.Шрифт 						= Новый Шрифт(ЭлементСтрокаОбработчика.Шрифт,,,, ПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеСоответствияВидовОбработчиковВыгрузки()
	
	СтруктураВидовОбработчиков = Новый Структура;
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеОбъединенияСтрокиТабличнойЧасти",
		Новый Структура("Обработчик, Тип", 
			"Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти", 
			"ПослеОбъединенияСтрокиТабличнойЧасти"));
	СтруктураВидовОбработчиков.Вставить(
		"ВидОбработчика_ПослеОбъединенияТабличнойЧасти",
		Новый Структура("Обработчик, Тип",
			"Обработчик_ПослеОбъединенияТабличнойЧасти", 
			"ПослеОбъединенияТабличнойЧасти"));
	
КонецПроцедуры

&НаКлиенте 
Процедура ОбновитьСписокПроизвольныхКодов(ДопТипОбработки = "")
	
	Если КлючНастройки = "Выгрузка_ШапкаДокумента" Тогда
		Направление = "Выгрузка";
		ТипОбъекта = "Шапка";
	ИначеЕсли КлючНастройки = "Выгрузка_ТабличнаяЧастьДокумента" Тогда 
		Направление = "Выгрузка";
		ТипОбъекта = "ТабличнаяЧасть";
	КонецЕсли;
	
	// Формируем список произвольных кодов без обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ТипОбъекта);
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодов", Отбор);
	
	// Формируем список произвольных кодов для обработчиков
	Отбор = Новый Структура("Направление,ТипОбъекта", Направление, ?(ПустаяСтрока(ДопТипОбработки), ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков(), ДопТипОбработки));
	ЗаполнитьСписокПроизвольныхКодов("СписокПроизвольныхКодовОбработчиков", Отбор);	
	
КонецПроцедуры

&НаКлиенте 
Процедура ЗаполнитьСписокПроизвольныхКодов(ИмяСписка, Отбор)
		
	ЭтаФорма[ИмяСписка].Очистить();
	
	ТаблицаПроизвольныхКодов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаЗначениеТабличнойНастройкиSMARTS("ПроизвольныеКоды", Отбор);
	
	Если ТаблицаПроизвольныхКодов <> Ложь И ТипЗнч(ТаблицаПроизвольныхКодов) = Тип("Массив") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаПроизвольныхКодов Цикл
			Если СтрокаТЗ.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			ЭтаФорма[ИмяСписка].Добавить(СтрокаТЗ.ID_ПроизвольногоКода, СтрокаТЗ.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтаФорма[ИмяСписка].Количество() = 0 Тогда
		ЭтаФорма[ИмяСписка].Добавить("");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКлючНастройкиОбработчикаВыгрузки(ИмяЭлемента)
	
	ИмяКлючаНастройки = "";
	
	Если ИмяЭлемента = "Обработчик_ПослеОбъединенияТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеОбъединенияТЧ";
	ИначеЕсли ИмяЭлемента = "Обработчик_ПослеОбъединенияСтрокиТабличнойЧасти" Тогда
		ИмяКлючаНастройки = "Выгрузка_ПослеОбъединенияСтрокиТЧ";
	КонецЕсли;		
	
	Возврат ИмяКлючаНастройки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокТиповПроизвольныхКодовДляОбработчиков()
	
	МассивТиповОбъектов = Новый Массив;
	МассивТиповОбъектов.Добавить("ПослеОбъединенияТЧ");
	МассивТиповОбъектов.Добавить("ПослеОбъединенияСтрокиТЧ");

	Возврат МассивТиповОбъектов;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьКнопкиСброситьОбработчик(ТипОбработчика)
	
	ВидОбработчика = "ВидОбработчика_" + ТипОбработчика;
	
	СтруктураОбработчика = СтруктураВидовОбработчиков[ВидОбработчика];
	ИмяОбработчика = СтруктураОбработчика.Обработчик;
	
	ЭлементКнопки = Элементы.Найти(ВидОбработчика + "Сбросить");
	Если ЭлементКнопки <> Неопределено Тогда
		
		ЭлементКнопки.Видимость = Ложь;
		
		Если ЭтоТиповаяНастройка Тогда
			
			ТиповыеНастройки = Новый Структура;
			ТиповыеНастройки.Вставить(ВидОбработчика);
			ТиповыеНастройки.Вставить(ИмяОбработчика);
			ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
			
			// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
			Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
				Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
					ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
				КонецЕсли;
			Иначе
				ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
			КонецЕсли;
			
			ТекущиеНастройки = Новый Структура;
			ТекущиеНастройки.Вставить(ВидОбработчика, ЭтаФорма[ВидОбработчика]);
			ТекущиеНастройки.Вставить(ИмяОбработчика, ЭтаФорма[ИмяОбработчика]);
			
			РезультатСравнения = _ЛокКонтекст.ЛокЯдро_СравнитьСтруктуруНастроек(ТиповыеНастройки, ТекущиеНастройки);
			ЭлементКнопки.Видимость = РезультатСравнения.Изменено;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьДобавленныхОбработчиков()
	
	КонтрольПройден = Истина;
	
	Для Каждого КлючЗначение Из СтруктураВидовОбработчиков Цикл
		
		ЗначениеВидаОбработчика = ЭтаФорма[КлючЗначение.Ключ];
		
		ИмяОбработчика = СтруктураВидовОбработчиков[КлючЗначение.Ключ].Обработчик;
		ТипОбработчика = СтруктураВидовОбработчиков[КлючЗначение.Ключ].Тип;
		
		// Проверка своего обработчика и произвольного кода на пустоту
		Если ЗначениеВидаОбработчика = 2 Или ЗначениеВидаОбработчика = 3 Тогда 						
			Если ПустаяСтрока(ЭтаФорма[ИмяОбработчика]) Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не заполнен!';
											|en = 'The handler is not full!'; be = 'Апрацоўшчык не запоўнены!'; es = '¡El controlador no está lleno!'; ka = 'დამმუშავებელი არ არის სავსე!'; kk = 'Өңдеуші толық емес!'; ro = 'Manipulatorul nu este plin!'; tr = 'İşleyici dolu değil!'; uk = 'Обробник не заповнений!'; uz = 'Ishlov beruvchi to''ldirilmagan!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не заполнен свой обработчик <%1>!';
												|en = 'Your handler is not filled in <%1>!'; be = 'Ня запоўнены свой апрацоўшчык <%1>!'; es = '¡Su controlador <%1>no está lleno!'; ka = 'თქვენი დამმუშავებელი არ არის შევსებული <%1>!'; kk = 'Сіздің өңдеушіңіз <%1 > толтырылмаған!'; ro = 'Operatorul dvs. nu este completat <%1>!'; tr = 'işleyiciniz <%1> dolu değil!'; uk = 'Не заповнений свій обробник <%1>!'; uz = 'Sizning ishlovchingiz <%1>bilan to''ldirilmagan!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 					
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		// Проверка своего обработчика на наличие в интеграционной обработке
		Если ЗначениеВидаОбработчика = 2 Тогда
			СтруктураПараметров = Новый Структура("АдресаПеременных, ДанныеДляЗагрузки_Строка, ДанныеДокументаMS, Док1СОснование, Док1СРезультат, ДокументТСД, СтрокаДокумента, СтрокаНастройки, СтруктураПоискаКлючаСвязи, ТЧ, ТекущиеНастройкиMS");
			РезультатПроверки = _ЛокКонтекст.ЛокЯдро_ПроверитьДоступностьОбработчика(ЭтаФорма[ИмяОбработчика], СтруктураПараметров);
			
			Если Не РезультатПроверки.Статус Тогда
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'Обработчик не найден в подключенной интеграционной обработке!';
											|en = 'The handler was not found in the enabled integration processing!';
											|be = 'Апрацоўшчык не знойдзены ў падключанай інтэграцыйнай апрацоўцы!'; es = '¡El controlador no se encuentra en el procesamiento de integración conectado!'; ka = 'დამმუშავებელი არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде өңдеуші табылмады!'; ro = 'Handler-ul nu a fost găsit în procesarea integrării activate!'; tr = 'Bağlı entegrasyon işlemede işleyici bulunamadı!'; uk = 'Обробник не знайдений у підключеній інтеграційній обробці!'; uz = 'Ishlov beruvchi ulangan integratsiyani qayta ishlashda topilmadi!'");
					Сообщение.Поле = ИмяОбработчика;
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить(); 
				#Иначе
					ТекстПредупреждения = НСтр("ru = 'Не найден свой обработчик <%1> в подключенной интеграционной обработке!';
												|en = 'My handler <%1> was not found in the enabled integration processing!';
												|be = 'Не знойдзены свой апрацоўшчык <%1 > у падключанай інтэграцыйнай апрацоўцы!'; es = '¡No se encontró su controlador <%1 > en el procesamiento de integración conectado!'; ka = 'ჩემი handler <%1> არ იქნა ნაპოვნი ჩართული ინტეგრაციის დამუშავება!'; kk = 'Қосылған интеграциялық өңдеуде <%1> өңдегіші табылмады!'; ro = 'Handlerul meu <%1> nu a fost găsit în procesarea de integrare activată!'; tr = 'Bağlı entegrasyon işlemede işleyiciniz <%1> bulunamadı!'; uk = 'Не знайдено свого обробника <%1 > у підключеній інтеграційній обробці!'; uz = 'Yoqilgan integratsiyani qayta ishlashda mening ishlovchim <%1 > topilmadi!'");
					ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, ТипОбработчика);
					ПоказатьПредупреждение(, ТекстПредупреждения); 
				#КонецЕсли
				
				КонтрольПройден = Ложь;
			КонецЕсли; 			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

&НаКлиенте
Функция ПроверитьДоступностьСохранения()
	
	КонтрольПройден = Истина;
	
	Индекс = ТабличныеЧасти.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		СтрокаТЧ = ТабличныеЧасти[Индекс];
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НастройкаТЧСтрокой) Тогда
			
			// Проверка заполнения ТЧ источника
			#Если Не ТолстыйКлиентОбычноеПриложение Тогда
				Сообщение = Новый СообщениеПользователю;
				Текст = НСтр("ru = 'Не выбрана табличная часть документа 1С'");
				
				Сообщение.Текст = Текст;
				Сообщение.Поле = "ТабличныеЧасти[" + Индекс + "].НастройкаТЧСтрокой";
				Сообщение.УстановитьДанные(ЭтаФорма);
				Сообщение.Сообщить(); 
			#Иначе
				НомерСтроки = Индекс + 1;
				ТекстПредупреждения = НСтр("ru = 'Не выбрана табличная часть документа 1С в строке %2'");
				ТекстПредупреждения = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстПредупреждения, Строка(НомерСтроки));
				ПоказатьПредупреждение(, ТекстПредупреждения); 
			#КонецЕсли
			
			КонтрольПройден = Ложь;
			
		ИначеЕсли СтрокаТЧ.НастройкаТЧСтрокой <> "(Запрос)" Тогда
			
			// Проверка дублей
			ДублиСтроки = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой", СтрокаТЧ.НастройкаТЧСтрокой));
			Если ДублиСтроки.Количество() > 1 Тогда
				
				КонтрольПройден = Ложь;
				
				#Если Не ТолстыйКлиентОбычноеПриложение Тогда
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					Текст = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Текст, СтрокаТЧ.НастройкаТЧСтрокой);
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = Текст;
					Сообщение.Поле = "ТаблицаРеквизитов[" + Индекс + "].НастройкаТЧСтрокой";
					Сообщение.УстановитьДанные(ЭтаФорма);
					Сообщение.Сообщить();
				#Иначе
					Текст = НСтр("ru = 'Табличная часть «%1» используется несколько раз. Удалите дублирующие строки.'");
					ПоказатьПредупреждение(, Текст); 
				#КонецЕсли
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции 

&НаКлиенте
Процедура ЗаполнитьТабличныеНастройки()
	
	Если пТабличныеЧасти <> Неопределено Тогда
		
		Для Каждого ЭлементМассива Из пТабличныеЧасти Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТабличныеЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);
			
			Если ЭтоТиповаяНастройка
				И (НЕ ЭлементМассива.Свойство("Типовой")
				ИЛИ ЭлементМассива.Типовой <> Ложь) Тогда
				НоваяСтрока.Типовой = Истина;
			КонецЕсли;
			
			НоваяСтрока.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ЭлементМассива.ТабличнаяЧастьДокумента1С);
			
			НоваяСтрока.ТабличнаяЧастьЕстьВМетаданных = ?(Лев(НоваяСтрока.НастройкаТЧСтрокой, 1) = "(", Ложь, СтруктураДокумента1С.ТабличныеЧасти.Свойство(НоваяСтрока.НастройкаТЧСтрокой));
			Если ЭлементМассива.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") И ЭлементМассива.ВыгружатьСтрокиПоУсловиюФлаг = Истина Тогда
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = "Включено";
			Иначе
				НоваяСтрока.ВыгружатьСтрокиПоУсловию = "Выключено";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если пСвязиТабличныхЧастей <> Неопределено Тогда
		
		Для Каждого ЭлементМассива Из пСвязиТабличныхЧастей Цикл
			Если ЭлементМассива.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = СвязиТабличныхЧастей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);
			НоваяСтрока.УсловиеСравнения = "=";
			
			Если ЭтоТиповаяНастройка
				И (НЕ ЭлементМассива.Свойство("Типовой")
				ИЛИ ЭлементМассива.Типовой <> Ложь) Тогда
				НоваяСтрока.Типовой = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВосстановитьТиповоеЗначениеНастройки(ИмяНастройки)
	
	ВидОбработчика = ИмяНастройки;
	ИмяОбработчика = СтруктураВидовОбработчиков[ВидОбработчика].Обработчик;
	
	ТиповыеНастройки = Новый Структура;
	ТиповыеНастройки.Вставить(ВидОбработчика);
	ТиповыеНастройки.Вставить(ИмяОбработчика);
	ЗаполнитьЗначенияСвойств(ТиповыеНастройки, СтруктураНастроекТиповая);
	
	Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		ТиповыеНастройки[ИмяОбработчика] = "";
	КонецЕсли;
	
	// Заполняем по умолчанию, т.к в типовых может не быть данного ключа
	Если ЗначениеЗаполнено(ТиповыеНастройки[ИмяОбработчика]) Тогда
		Если НЕ ЗначениеЗаполнено(ТиповыеНастройки[ВидОбработчика]) Тогда
			ТиповыеНастройки[ВидОбработчика] = 2; // "Свой обработчик"
		КонецЕсли;
	Иначе
		ТиповыеНастройки[ВидОбработчика] = 0; // "Без обработчика"
	КонецЕсли;
	
	ЭтаФорма[ВидОбработчика] = ТиповыеНастройки[ВидОбработчика];
	ЭтаФорма[ИмяОбработчика] = ТиповыеНастройки[ИмяОбработчика];
	
	Обработчик_ИзменитьЗначение = Ложь;
	
	ВидОбработчика_ОбработкаПриИзменении(Элементы[ВидОбработчика]);
	Обработчик_ОбработкаПриИзменении(Элементы[ИмяОбработчика]);
	
	Модифицированность = Истина;
	
КонецПроцедуры 

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ФормаНастройки_ПравилаВыгрузкиПолейЗакрытие(РезультатРедактирования,ТекущаяСтрока) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, РезультатРедактирования);
		ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой 	= _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(РезультатРедактирования.ТаблицаНастроек);		
		ТекущаяСтрока.Настроить							= "Настроено";
		
		Модифицированность = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_УсловияВыгрузкиСтрокТЧЗакрытие(РезультатРедактирования, СтруктураПараметров) Экспорт
	
	Если РезультатРедактирования <> Неопределено Тогда
		
		ТекущаяСтрока 								  = СтруктураПараметров.ТекущаяСтрока;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюФлаг 	  = РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг;
		ТекущаяСтрока.ВыгружатьСтрокиПоУсловиюСтрокой = РезультатРедактирования.УдалятьСтрокиПоУсловиюСтрокой;
		
		Если РезультатРедактирования.УдалятьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Включено";
		Иначе
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Выключено";
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьНастройкиТЧЗавершение(Результат, ТекущаяСтрока) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ТиповаяСтрокаТЧ = _ЛокКонтекст.ЛокЯдро_НайтиСтруктуруВМассивеПоЭлементу(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ, "НастройкаТЧСтрокой", ТекущаяСтрока.НастройкаТЧСтрокой);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТиповаяСтрокаТЧ);
		ТекущаяСтрока.Типовой = Истина;
		
		ТекущаяСтрока.ТабличнаяЧастьДокумента1ССтрокой = _ЛокКонтекст.ЛокЯдро_ЗначениеВСтрокуXML(ТиповаяСтрокаТЧ.ТабличнаяЧастьДокумента1С);
		Если ТиповаяСтрокаТЧ.Свойство("ВыгружатьСтрокиПоУсловиюФлаг") И ТиповаяСтрокаТЧ.ВыгружатьСтрокиПоУсловиюФлаг = Истина Тогда
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Включено";
		Иначе
			ТекущаяСтрока.ВыгружатьСтрокиПоУсловию = "Выключено";
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповыеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Для каждого КлючЗначение Из СтруктураВидовОбработчиков Цикл
			ВосстановитьТиповоеЗначениеНастройки(КлючЗначение.Ключ);
		КонецЦикла;
		
		ТабличныеЧасти.Очистить();
		Если ТипЗнч(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ) = Тип("Массив") Тогда
			пТабличныеЧасти = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтруктураНастроекТиповая.НастройкаВыгрузкиТЧ);
		КонецЕсли;
		
		СвязиТабличныхЧастей.Очистить();
		Если ТипЗнч(СтруктураНастроекТиповая.СвязиТабличныхЧастей) = Тип("Массив") Тогда
			пСвязиТабличныхЧастей = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтруктураНастроекТиповая.СвязиТабличныхЧастей);
		КонецЕсли;
		
		ЗаполнитьТабличныеНастройки();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросСохранитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		пРазрешитьЗакрытие = Истина;
		Закрыть();
		
	Иначе
		пРазрешитьЗакрытие = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВосстановитьТиповоеЗначениеНастройкиЗавершение(Результат, ИмяНастройки) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВосстановитьТиповоеЗначениеНастройки(ИмяНастройки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
#КонецЕсли