			СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекСтрока.ПодчиненнаяТаблица].Реквизиты;
		КонецЕсли;
	КонецЕсли;
	НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(ТекСтрока.ПолеПодчиненнойТаблицыСиноним);
	Если НайденныйЭлементСписка<>Неопределено Тогда	
		ТекСтрока.ПолеПодчиненнойТаблицы = ТекСтрока.ПолеПодчиненнойТаблицыСиноним;
		ТекСтрока.ПолеПодчиненнойТаблицыСиноним = НайденныйЭлементСписка.Представление;
	КонецЕсли;
КонецПроцедуры

