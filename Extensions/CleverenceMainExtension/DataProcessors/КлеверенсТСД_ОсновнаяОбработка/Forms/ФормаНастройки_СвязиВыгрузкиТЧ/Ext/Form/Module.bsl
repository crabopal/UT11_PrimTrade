&НаКлиенте
Процедура СвязиТабличныхЧастейПолеГлавнойТаблицыСинонимПриИзменении(Элемент)
	ТекСтрока = Элементы.СвязиТабличныхЧастей.ТекущиеДанные;
	СписокРеквизитов1С = Новый СписокЗначений;
	СписокДополнительныхОбработчиков = _ЛокКонтекст.ЛокЯдро_ПолучитьСписокДополнительныхОбработчиковПолученияТЧ(ТипДокумента1С);
	Если СписокДополнительныхОбработчиков <> Неопределено
		И ЗначениеЗаполнено(ТекСтрока.ГлавнаяТаблица)
		И СписокДополнительныхОбработчиков.Получить(ТекСтрока.ГлавнаяТаблица) <> Неопределено Тогда
		СписокРеквизитов1С = СписокДополнительныхОбработчиков[ТекСтрока.ГлавнаяТаблица].СписокКолонок;
	КонецЕсли;
	
	Если СписокРеквизитов1С.Количество() = 0 Тогда
		Если ТекСтрока.ГлавнаяТаблица = "(Запрос)" Тогда
			ТЧЗапрос = ТабличныеЧасти.НайтиСтроки(Новый Структура("НастройкаТЧСтрокой","(Запрос)"));
			Если ТЧЗапрос.Количество() = 0 Тогда
				Сообщение = НСтр("ru = 'Не удалось получить список полей по причине ошибки выполнения запроса.';
									|en = 'The list of fields could not be retrieved due to a request execution error.';
									|be = 'Не атрымалася атрымаць спіс палёў па прычыне памылкі выканання запыту.'; es = 'No se pudo obtener la lista de campos debido a un error en la ejecución de la consulta.'; ka = 'ველების სია ვერ მოიძებნა მოთხოვნის შესრულების შეცდომის გამო.'; kk = 'Сұрауды орындау қатесі себебінен өрістер тізімін алу мүмкін болмады.'; ro = 'Lista câmpurilor nu a putut fi recuperată din cauza unei erori de execuție a cererii.'; tr = 'Sorgu yürütme hatası nedeniyle alanların listesi alınamadı.'; uk = 'Не вдалося отримати список полів через помилку виконання запиту.'; uz = 'So''rovni bajarish xatosi tufayli maydonlar ro''yxatini olishning iloji bo''lmadi.'");
				Сообщить(Сообщение); 
				СписокРеквизитов1С = Новый СписокЗначений;
			Иначе
				ТекстЗапросаВыгрузкиНаТСД = ТЧЗапрос[0].ТекстЗапросаВыгрузкиНаТСД;
				СписокРеквизитов1С = ЗаполнитьСписокПолейЗапроса(ТипДокумента1С, ТекстЗапросаВыгрузкиНаТСД);
			КонецЕсли;
		Иначе
			СписокРеквизитов1С = СтруктураДокумента1С.ТабличныеЧасти[ТекСтрока.ГлавнаяТаблица].Реквизиты;
		КонецЕсли;
	КонецЕсли;
	НайденныйЭлементСписка = СписокРеквизитов1С.НайтиПоЗначению(ТекСтрока.ПолеГлавнойТаблицыСиноним);
	Если НайденныйЭлементСписка<>Неопределено Тогда	
		ТекСтрока.ПолеГлавнойТаблицы = ТекСтрока.ПолеГлавнойТаблицыСиноним;
		ТекСтрока.ПолеГлавнойТаблицыСиноним = НайденныйЭлементСписка.Представление;
	КонецЕсли;
КонецПроцедуры

