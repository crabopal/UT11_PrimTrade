/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем ПредыдущееЗначение;

#Область ОбработчикиСобытийФорм

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	Если ЭтоТекущийУзел Тогда
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_" + ТипОбмена);
	Иначе
		ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, ID_Узла);
	КонецЕсли;
	ЗаполнитьТаблицуЗначениямиНастройки(ЗначениеНастройки, Истина);
	
	Если ЗначениеЗаполнено(НаименованиеУзла) Тогда 
		ТекстЗаголовка = НСтр("ru = 'Клеверенс: Настройки отборов бизнес-процессов для магазина  %1';
								|en = 'Cleverence: Business Process Selection settings for the store %1';
								|be = 'Cleverence: Налады адбораў бізнес-працэсаў для крамы %1'; es = 'Cleverence: Configuración de selección de procesos de negocio para la tienda %1'; ka = 'Cleverence: ბიზნეს პროცესის შერჩევის პარამეტრები მაღაზიისთვის %1'; kk = 'Cleverence: %1 дүкені үшін бизнес-процестерді таңдау параметрлері'; ro = 'Cleverence: setări de selectare a proceselor de afaceri pentru magazin %1'; tr = 'Cleverence: Mağaza için iş süreci seçim ayarları %1'; uk = 'Cleverence: Налаштування відборів бізнес-процесів для магазину %1'; uz = 'Cleverence: %1 do''koni uchun biznes-jarayonlarni tanlash sozlamalari'");
		ТекстЗаголовка = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ТекстЗаголовка, НаименованиеУзла);
		ЭтаФорма.Заголовок = ТекстЗаголовка;
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.НаименованиеУзла.Видимость = Истина;
            Элементы.ЗагрузитьНастройкиПоУмолчанию.Видимость	   = Ложь;
			Элементы.ГруппаЗагрузитьНастройкиПоУмолчанию.Видимость = Истина;
		#Иначе	
			Элементы.ДействияФормы.Кнопки.Удалить(Элементы.ДействияФормы.Кнопки.ЗагрузитьНастройкиПоУмолчанию);
		#КонецЕсли
	Иначе
		ЭтаФорма.Заголовок = НСтр("ru = 'Клеверенс: Настройки отборов бизнес-процессов (глобальные)';
									|en = 'Cleverence: Business Process Selection Settings (global)';
									|be = 'Cleverence: Налады адбораў бізнес-працэсаў (глабальныя)'; es = 'Cleverence: Configuración de selección de procesos de negocio (global)'; ka = 'Cleverence: ბიზნეს პროცესის შერჩევის პარამეტრები (გლობალური)'; kk = 'Cleverence: бизнес-процестерді таңдау параметрлері (жаһандық)'; ro = 'Cleverence: Setări de selecție a proceselor de afaceri (global)'; tr = 'Cleverence: iş süreci seçim ayarları (global)'; uk = 'Cleverence: Налаштування відбору бізнес-процесів (глобальні)'; uz = 'Cleverence: biznes jarayonlarini tanlash sozlamalari (global)'");
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.НаименованиеУзла.Видимость = Ложь;
			Элементы.ЗагрузитьНастройкиПоУмолчанию.Видимость	   = Истина;
			Элементы.ГруппаЗагрузитьНастройкиПоУмолчанию.Видимость = Ложь;
		#Иначе	
			Элементы.ДействияФормы.Кнопки.Удалить(Элементы.ДействияФормы.Кнопки.ГруппаЗагрузитьНастройкиПоУмолчанию);
		#КонецЕсли
	КонецЕсли;
	
	ТипОбменаПредставление = "";
	Если ТипОбмена = "Онлайн" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Зеленый;
		ТипОбменаПредставление = НСтр("ru = 'Онлайн';
										|en = 'Online'; be = 'Анлайн'; es = 'En línea'; ka = 'ონლაინ'; kk = 'Онлайн'; ro = 'Online'; tr = 'Çevrimiçi'; uk = 'Онлайн'; uz = 'Onlayn'");
	ИначеЕсли ТипОбмена = "Автообмен" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Красный;
		ТипОбменаПредставление = НСтр("ru = 'Автообмен';
										|en = 'Auto-exchange'; be = 'Аўтаабмен'; es = 'Intercambio automático'; ka = 'ავტომატური გაცვლა'; kk = 'АВТО алмасу'; ro = 'Schimb automat'; tr = 'Otomatik Değişim'; uk = 'Автообмін'; uz = 'Avtomatik almashtirish'");
	ИначеЕсли ТипОбмена = "Интерактивный" Тогда
		Элементы.ТипОбмена.ЦветТекста = WebЦвета.Синий;
		ТипОбменаПредставление = НСтр("ru = 'Интерактивный';
										|en = 'Interactive'; be = 'Інтэрактыўны'; es = 'Interactivo'; ka = 'ინტერაქტიული'; kk = 'Интерактивті'; ro = 'Interactiv'; tr = 'İnteraktif'; uk = 'Інтерактивний'; uz = 'Interaktiv'");
	КонецЕсли;
	
	Элементы.ТипОбмена.Заголовок = ТипОбменаПредставление;
			
	Для каждого СтрокаНастройки из НастройкиОтборов Цикл
		Если ЗначениеЗаполнено(СтрокаНастройки.НастройкаКомпоновщикаСтрокой) Тогда
			СтрокаНастройки.Настройка =  НСтр("ru = 'Настроено';
												|en = 'Configured'; be = 'Наладжваць'; es = 'Ajuste'; ka = 'კონფიგურაცია'; kk = 'Реттелген'; ro = 'Configurată'; tr = 'Akort etmek'; uk = 'Настроювати'; uz = 'Sozlangan'");			
		Иначе
			СтрокаНастройки.Настройка =  НСтр("ru = 'Настроить';
												|en = 'To configure'; be = 'Настроіць'; es = 'Ajustar'; ka = 'კონფიგურაციისთვის'; kk = 'Орнату'; ro = 'Pentru a configura'; tr = 'Özelleştirmek'; uk = 'Настроївши'; uz = 'Sozlash'");
		КонецЕсли;
	КонецЦикла;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		НастройкиОтборов.Сортировать("БизнесПроцессВключен УБЫВ");
		
		Элементы.ИнфоСтрока.Заголовок = НСтр("ru = 'Список отборов сформирован на основании текущих настроек бизнес-процессов. Если нужный отбор недоступен, проверьте, включен ли соответствующий бизнес-процесс.';
												|en = 'The selection list is based on the current business process settings. If the required selection is not available, check whether the appropriate business process is enabled.';
												|be = 'Спіс адбораў сфарміраваны на падставе бягучых налад бізнес-працэсаў. Калі патрэбны адбор недаступны, праверце, ці ўключаны адпаведны бізнес-працэс.'; es = 'La lista de selección se basa en la configuración actual de los procesos de negocio. Si la selección deseada no está disponible, compruebe si el proceso de negocio correspondiente está habilitado.'; ka = 'შერჩევის სია ეფუძნება მიმდინარე ბიზნეს პროცესის პარამეტრებს. თუ საჭირო შერჩევა არ არის ხელმისაწვდომი, შეამოწმეთ ჩართულია თუ არა შესაბამისი ბიზნეს პროცესი.'; kk = 'Іріктеу тізімі бизнес-процестердің ағымдағы параметрлері негізінде құрылады. Егер қажетті таңдау болмаса, тиісті бизнес-процестің қосылғанын тексеріңіз.'; ro = 'Lista de selecție se bazează pe setările curente ale procesului de afaceri. Dacă selecția necesară nu este disponibilă, verificați dacă procesul de afaceri corespunzător este activat.'; tr = 'Seçim listesi, iş süreçlerinin mevcut ayarlarına göre oluşturulmuştur. Doğru seçim mevcut değilse, ilgili iş sürecinin etkin olup olmadığını kontrol edin.'; uk = 'Список відборів сформований на підставі поточних налаштувань бізнес-процесів. Якщо потрібний відбір недоступний, перевірте, чи включений відповідний бізнес-процес.'; uz = 'Tanlovlar ro''yxati biznes-jarayonlarning joriy sozlamalari asosida shakllantiriladi. Agar kerakli tanlov mavjud bo''lmasa, tegishli biznes jarayoni yoqilganligini tekshiring.'");
	#Иначе
		ИнфоСтрока = НСтр("ru = 'Список отборов сформирован на основании текущих настроек бизнес-процессов. Если в списке нет нужного отбора, проверьте, включен ли соответствующий бизнес-процесс.';
							|en = 'The selection list is based on the current business process settings. If the required selection is not in the list, check if the appropriate business process is enabled.';
							|be = 'Спіс адбораў сфарміраваны на падставе бягучых налад бізнес-працэсаў. Калі ў спісе няма патрэбнага адбору, праверце, ці ўключаны адпаведны бізнес-працэс.'; es = 'La lista de selección se basa en la configuración actual de los procesos de negocio. Si no hay una selección en la lista, compruebe si el proceso de negocio correspondiente está habilitado.'; ka = 'შერჩევის სია ეფუძნება მიმდინარე ბიზნეს პროცესის პარამეტრებს. თუ საჭირო შერჩევა არ არის სიაში, შეამოწმეთ ჩართულია თუ არა შესაბამისი ბიზნეს პროცესი.'; kk = 'Іріктеу тізімі бизнес-процестердің ағымдағы параметрлері негізінде құрылады. Егер тізімде қажетті таңдау болмаса, тиісті бизнес-процестің қосылғанын тексеріңіз.'; ro = 'Lista de selecție se bazează pe setările curente ale procesului de afaceri. Dacă selecția necesară nu se află în listă, verificați dacă procesul de afaceri corespunzător este activat.'; tr = 'Seçim listesi, iş süreçlerinin mevcut ayarlarına göre oluşturulmuştur. Listede gerekli seçim yoksa, ilgili iş sürecinin etkin olup olmadığını kontrol edin.'; uk = 'Список відборів сформований на підставі поточних налаштувань бізнес-процесів. Якщо в списку немає потрібного відбору, перевірте, чи включений відповідний бізнес-процес.'; uz = 'Tanlovlar ro''yxati biznes-jarayonlarning joriy sozlamalari asosida shakllantiriladi. Agar ro''yxatda to''g''ri tanlov bo''lmasa, tegishli biznes jarayoni yoqilganligini tekshiring.'");
	#КонецЕсли
	НеВыводитьИнфоСтроку = Не _ЛокКонтекст.ЛокЯдро_ЗначениеПользовательскойНастройки("ВыводИнфоСообщенийФормаСпискаОтборы");
	ОбновитьВидимостьГруппыИнфо();
	
	//Клеверенс Автотестирование. Текст проверки должен быть последним!
	Если АвтоТестОткрытияФормы и ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
		РезОткрытия = Новый Структура;
		РезОткрытия.Вставить("ВремяЗакрытия",ТекущаяУниверсальнаяДатаВМиллисекундах());
		#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
        	РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.ИмяФормы);
		#Иначе	
			РезОткрытия.Вставить("ИмяФормы",ЭтаФорма.Заголовок);
		#КонецЕсли
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, РезОткрытия);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьИЗакрытьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОП = Новый ОписаниеОповещения("СохранитьПослеПодключения",ЭтаФорма);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,ТипБазы,,,,ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьЗначениеФлагаИспользуется(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьЗначениеФлагаИспользуется(Ложь);	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиПоУмолчанию(Команда)
		
	Если НастройкиОтборов.Количество() Тогда
		ОповещениеПредупреждениеЗавершение = Новый ОписаниеОповещения("ЗагрузитьНастройкиПоУмолчаниюЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Текущие настройки будут утеряны! Перезаписать их?';
								|en = 'The current settings will be lost! Overwrite them?'; be = 'Бягучыя налады будуць згубленыя! Перазапісаць іх?'; es = '¡La configuración actual se perderá! ¿Sobrescribirlos?'; ka = 'მიმდინარე პარამეტრები დაიკარგება! გადაწერეთ ისინი?'; kk = 'Ағымдағы параметрлер жоғалады! Оларды қайта жазасыз ба?'; ro = 'Setările curente vor fi pierdute! Le suprascrieți?'; tr = 'Mevcut ayarlar kaybolacak! Bunların üzerine yazmak mı?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Joriy Sozlamalar yo''qoladi! Ularni ustiga yozish?'");
		ПоказатьВопрос(ОповещениеПредупреждениеЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ЗагрузитьНастройкиПоУмолчаниюВыполнить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиГлавногоУзла(Команда)

	Если НастройкиОтборов.Количество() Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИзГлавногоУзла", Истина);
		
		ОповещениеПредупреждениеЗавершение = Новый ОписаниеОповещения("ЗагрузитьНастройкиПоУмолчаниюЗавершение", ЭтаФорма, ДополнительныеПараметры);
		ТекстВопроса = НСтр("ru = 'Текущие настройки будут утеряны! Перезаписать их?';
								|en = 'The current settings will be lost! Overwrite them?'; be = 'Бягучыя налады будуць згубленыя! Перазапісаць іх?'; es = '¡La configuración actual se perderá! ¿Sobrescribirlos?'; ka = 'მიმდინარე პარამეტრები დაიკარგება! გადაწერეთ ისინი?'; kk = 'Ағымдағы параметрлер жоғалады! Оларды қайта жазасыз ба?'; ro = 'Setările curente vor fi pierdute! Le suprascrieți?'; tr = 'Mevcut ayarlar kaybolacak! Bunların üzerine yazmak mı?'; uk = 'Поточні налаштування будуть втрачені! Перезаписати їх?'; uz = 'Joriy Sozlamalar yo''qoladi! Ularni ustiga yozish?'");
		ПоказатьВопрос(ОповещениеПредупреждениеЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
	Иначе
		ЗагрузитьНастройкиПоУмолчаниюВыполнить(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтборовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	НоваяСтрока = НастройкиОтборов.Добавить();
	НоваяСтрока.Настройка = "Настроить";
	#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элементы.НастройкиОтборов.ТекущаяСтрока = НоваяСтрока;
	#Иначе
	Элементы.НастройкиОтборов.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	#КонецЕсли
	ОткрытьФормуВыбораБП();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтборовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрокаНастройки = Элементы.НастройкиОтборов.ТекущиеДанные;
	Если ТекущаяСтрокаНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если НЕ ТекущаяСтрокаНастройки.БизнесПроцессВключен Тогда
			Возврат;
		КонецЕсли;	
		
		КолонкаИмя = Элементы.НастройкиОтборов.ТекущаяКолонка.Имя;
	#Иначе
		КолонкаИмя = Элементы.НастройкиОтборов.ТекущийЭлемент.Имя;
	#КонецЕсли
		
	Если КолонкаИмя = "НастройкиОтборовНастройка"
		ИЛИ Элемент = "" Тогда 
		СтандартнаяОбработка = Ложь;
		ТекущаяСтрокаНастройки = Элементы.НастройкиОтборов.ТекущиеДанные;
		ЭтоНовый = ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой = "";
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаНастройки.ID_БизнесПроцесса) Тогда			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Не выбран бизнес-процесс для настройки отбора';
									|en = 'The business process for setting up the selection has not been selected'; be = 'Не абраны бізнес-працэс для налады адбору'; es = 'No se ha seleccionado ningún proceso de negocio para configurar la selección'; ka = 'შერჩევის შექმნის ბიზნეს პროცესი არ არის შერჩეული'; kk = 'Таңдауды реттеу үшін бизнес-процесс таңдалмаған'; ro = 'Procesul de afaceri pentru configurarea selecției nu a fost selectat'; tr = 'Seçimi ayarlamak için iş süreci seçilmedi'; uk = 'Не вибрано бізнес-процес для налаштування відбору'; uz = 'Tanlovni o''rnatish uchun biznes jarayoni tanlanmagan'");
			Сообщение.Поле = "НастройкиОтборов["+Элементы.НастройкиОтборов.ТекущаяСтрока+"].Название";
			Сообщение.Сообщить(); 
			Возврат;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрокаНастройки.ТипИсходногоДокумента1С) Тогда			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'У бизнес-процесса не заполнен исходный документ 1С';
									|en = 'The business process has not completed the original 1C document';
									|be = 'У бізнес-працэсу не запоўнены зыходны дакумент 1С'; es = 'El proceso de negocio no ha completado el documento original 1C'; ka = 'ბიზნეს პროცესი არ დასრულებულა ორიგინალური 1c დოკუმენტი'; kk = 'Бизнес-процесте 1С бастапқы құжаты толтырылмаған'; ro = 'Procesul de afaceri nu a finalizat documentul original 1C'; tr = 'İş süreci orijinal 1C belgesini doldurmadı'; uk = 'У бізнес-процесу не заповнений вихідний документ 1С'; uz = 'Biznes jarayoni asl 1C hujjatini to''ldirmaydi'");
			Сообщение.Поле = "НастройкиОтборов["+Элементы.НастройкиОтборов.ТекущаяСтрока+"].ТипИсходногоДокумента1С_Синоним";
			Сообщение.Сообщить(); 
			Возврат;				
		КонецЕсли;		
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборДокументов = ПолучитьФорму("ОФ_ФормаНастройки_ОтборДокументов", ЭтаФорма);
		#Иначе
			ФормаНастройки_ОтборДокументов = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаНастройки_ОтборДокументов", , ЭтаФорма, ЭтаФорма);
			ФормаНастройки_ОтборДокументов.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		#КонецЕсли
		ФормаНастройки_ОтборДокументов.ID_Узла = ID_Узла;
		ФормаНастройки_ОтборДокументов.НаименованиеУзла = НаименованиеУзла;
		ФормаНастройки_ОтборДокументов.ID_БизнесПроцесса = ТекущаяСтрокаНастройки.ID_БизнесПроцесса;
		ФормаНастройки_ОтборДокументов.НаименованиеБП = ТекущаяСтрокаНастройки.Название;
		ФормаНастройки_ОтборДокументов.ТипДокумента1С = ТекущаяСтрокаНастройки.ТипИсходногоДокумента1С;
		ФормаНастройки_ОтборДокументов.Используется = ?(ЭтоНовый,Истина,ТекущаяСтрокаНастройки.Используется);
		ФормаНастройки_ОтборДокументов.ТипОбмена = ТипОбмена;		
		ФормаНастройки_ОтборДокументов.НастройкаКомпоновщикаСтрокой = ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой;		
		ФормаНастройки_ОтборДокументов.ВариантОтбора = ?(ТекущаяСтрокаНастройки.ВариантОтбора="","Только конструктор",ТекущаяСтрокаНастройки.ВариантОтбора);
		ФормаНастройки_ОтборДокументов.ID_ПроизвольногоОтбора = ТекущаяСтрокаНастройки.ID_ПроизвольногоОтбора;
		ФормаНастройки_ОтборДокументов._ЛокКонтекст = _ЛокКонтекст;
		
		ОП = Новый ОписаниеОповещения("ФормаНастройки_ОтборДокументовЗакрытие",ЭтаФорма);
		ФормаНастройки_ОтборДокументов.ОписаниеОповещенияОЗакрытии = ОП;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			ФормаНастройки_ОтборДокументов.ОткрытьМодально();
		#Иначе
			ФормаНастройки_ОтборДокументов.Открыть();
		#КонецЕсли
				
	КонецЕсли;
	
КонецПроцедуры

