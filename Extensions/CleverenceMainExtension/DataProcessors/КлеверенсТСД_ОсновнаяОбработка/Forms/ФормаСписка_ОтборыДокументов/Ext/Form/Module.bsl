&НаКлиенте
Процедура ОткрытьФормуВыбораБП()
	СтрокаТабличнойЧасти = Элементы.НастройкиОтборов.ТекущиеДанные;
	ПредыдущееЗначение = СтрокаТабличнойЧасти.ID_БизнесПроцесса;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборСтрокиИзТаблицы", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборСтрокиИзТаблицы", , ЭтаФорма, ЭтаФорма);
		ФормаСлужебная_ВыборСтрокиИзТаблицы.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	#КонецЕсли
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы = "БизнесПроцессыДляВыгрузки";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст = _ЛокКонтекст;
	
	ОП = Новый ОписаниеОповещения("ФормаСлужебная_ВыборСтрокиИзТаблицыЗакрытие",ЭтаФорма);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();	
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиПоУмолчаниюВыполнить(ИзГлавногоУзла = Ложь)
	
	Если ИзГлавногоУзла = Истина Тогда
		НастройкиОтборовПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, "");
	Иначе
		НастройкиОтборовПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиОтборовУзлов_ПоУмолчанию_" + ТипОбмена);
		Если НЕ ЗначениеЗаполнено(НастройкиОтборовПоУмолчанию) ИЛИ НастройкиОтборовПоУмолчанию = Ложь Тогда
			НастройкиОтборовПоУмолчанию = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуПоУмолчаниюНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, ID_Узла);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиОтборовПоУмолчанию)
		ИЛИ НастройкиОтборовПоУмолчанию = Ложь Тогда
		Если ИзГлавногоУзла = Истина Тогда
			Сообщение = НСтр("ru = 'Глобальные настройки не найдены';
								|en = 'Global settings were not found'; be = 'Глабальныя налады не знойдзены'; es = 'Configuración global no encontrada'; ka = 'გლობალური პარამეტრები ვერ მოიძებნა'; kk = 'Жаһандық параметрлер табылмады'; ro = 'Setările globale nu au fost găsite'; tr = 'Genel ayarlar bulunamadı'; uk = 'Глобальних налаштувань не знайдено'; uz = 'Global Sozlamalar topilmadi'");
		Иначе
			Сообщение = НСтр("ru = 'Настройки по умолчанию не найдены';
								|en = 'Default settings were not found'; be = 'Налады па змаўчанні не знойдзены'; es = 'No se encontraron los valores predeterminados'; ka = 'ნაგულისხმევი პარამეტრები არ იქნა ნაპოვნი'; kk = 'Әдепкі параметрлер табылмады'; ro = 'Setările implicite nu au fost găsite'; tr = 'Varsayılan ayarlar bulunamadı'; uk = 'Налаштування за замовчуванням не знайдено'; uz = 'Standart Sozlamalar topilmadi'");
		КонецЕсли;
		Сообщить(Сообщение, СтатусСообщения.Внимание); 
		Возврат;
	КонецЕсли;
	
	// Полностью перестраиваем список только при открытии из формы, при восстановлении из файла/по дефолту - дополняем существующий
	//НастройкиОтборов.Очистить();
	
	ЗаполнитьТаблицуЗначениямиНастройки(НастройкиОтборовПоУмолчанию)

КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьТаблицуЗначениямиНастройки(ЗначениеНастройки, ОткрытиеФормы = Ложь)
	
	Если ОткрытиеФормы Тогда
		// Полностью перестраиваем список только при открытии из формы, при восстановлении из файла/по дефолту - дополняем существующий
		НастройкиОтборов.Очистить();
	ИначеЕсли НЕ ЗначениеЗаполнено(ЗначениеНастройки) ИЛИ ЗначениеНастройки = Ложь Тогда
		Сообщение = НСтр("ru = 'Не удалось получить данные для заполнения настроек!';
							|en = 'Couldn''t get the data to fill in the settings!';
							|be = 'Не атрымалася атрымаць дадзеныя для запаўнення налад!'; es = '¡No se pudieron obtener los datos para completar la configuración!'; ka = 'ვერ მოხერხდა მონაცემების შევსება პარამეტრებში!'; kk = 'Параметрлерді толтыру үшін деректерді алу мүмкін болмады!'; ro = 'Nu am putut obține datele pentru a completa setările!'; tr = 'Ayarları doldurmak için veri alınamadı!'; uk = 'Не вдалося отримати дані для заповнення налаштувань!'; uz = 'Sozlamalarni to''ldirish uchun ma''lumotlarni olish mumkin emas!'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;
	
	НужноСохранить = Ложь;
	
	// Для определения списка бизнес-процессов - используем настройки бизнес-процессов из кэша.
	//
	// Для определения включен/отключен бизнес-процесс используем:
	//	Если этот узел - текущий:
	//		настройки бизнес-процессов из кэша (дополнительно ничего не получаем)
	//	Если этот узел - НЕ текущий:
	//		Если текущий узел при этом - главный:
	//			для определения включен/отключен по умолчанию - настройки бизнес-процессов из кэша (дополнительно ничего не получаем)
	//			для определения включен/отключен по узлу - пользовательские настройки по узлу (получаем пользовательские настройки по узлу)
	//		Если текущий узел при этом - НЕ главный:
	//			для определения включен/отключен по умолчанию - пользовательские настройки по главному узлу (получаем пользовательские настройки по главному узлу)
	//			для определения включен/отключен по узлу - пользовательские настройки по узлу (получаем пользовательские настройки по узлу)
	
	НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьИзКэшаНастройкуSMARTS("НастройкиБизнесПроцессов");
	Если НЕ ЗначениеЗаполнено(НастройкиБизнесПроцессов) ИЛИ НастройкиБизнесПроцессов = Ложь Тогда
		// Пока просто выводим ошибку. Если будут возникать подобные кейсы, добавим альтернативный алгоритм заполнения
		Сообщение = НСтр("ru = 'Не удалось сформировать список отборов из-за ошибки получения настроек бизнес-процессов.';
							|en = 'The selection list could not be generated due to an error in obtaining business process settings.';
							|be = 'Не атрымалася сфармаваць спіс адбораў з-за памылкі атрымання налад бізнес-працэсаў.'; es = 'No se pudo generar la lista de selección debido a un error en la obtención de la configuración de los procesos de negocio.'; ka = 'შერჩევის სია ვერ შეიქმნა ბიზნეს პროცესის პარამეტრების მიღების შეცდომის გამო.'; kk = 'Бизнес-процестердің параметрлерін алу қатесіне байланысты іріктеу тізімін құру мүмкін болмады.'; ro = 'Lista de selecție nu a putut fi generată din cauza unei erori în obținerea setărilor procesului de afaceri.'; tr = 'İş süreci ayarlarını alma hatası nedeniyle seçim listesi oluşturulamadı.'; uk = 'Не вдалося сформувати список відборів через помилку отримання налаштувань бізнес-процесів.'; uz = 'Biznes-jarayonlar sozlamalarini olishda xatolik tufayli tanlovlar ro''yxatini tuzish mumkin emas edi.'");
		Сообщить(Сообщение); 
		Возврат;
	КонецЕсли;
	
	ЭтоТекущийУзел = ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла;
	
	ПользовательскиеНастройки_ЭтотУзел 	  = Неопределено;
	ПользовательскиеНастройки_ГлавныйУзел = Неопределено;
	
	Если НЕ ЭтоТекущийУзел Тогда
		Структура_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", ID_Узла);
		Если ТипЗнч(Структура_ПользовательскиеНастройки) = Тип("Структура") Тогда
			ПользовательскиеНастройки_ЭтотУзел = Структура_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
		ИначеЕсли ТипЗнч(Структура_ПользовательскиеНастройки) = Тип("Массив") Тогда
			ПользовательскиеНастройки_ЭтотУзел = Структура_ПользовательскиеНастройки;
		КонецЕсли;
		
		Если НЕ _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла = "" Тогда // Текущий узел - НЕ главный
			Структура_ПользовательскиеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиБизнесПроцессов_ПользовательскиеНастройки", "");
			Если ТипЗнч(Структура_ПользовательскиеНастройки) = Тип("Структура") Тогда
				ПользовательскиеНастройки_ГлавныйУзел = Структура_ПользовательскиеНастройки.НастройкиБизнесПроцессов;
			ИначеЕсли ТипЗнч(Структура_ПользовательскиеНастройки) = Тип("Массив") Тогда
				ПользовательскиеНастройки_ГлавныйУзел = Структура_ПользовательскиеНастройки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НастройкиСкопированыИзГлавногоУзла = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеНастройки) ИЛИ ЗначениеНастройки = Ложь Тогда
		Если ЗначениеЗаполнено(ID_Узла) Тогда
			// Если настроек нет в торговом объекте, используем настройки главного узла
			ЗначениеНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, "");
			Если НЕ ЗначениеЗаполнено(ЗначениеНастройки) ИЛИ ЗначениеНастройки = Ложь Тогда
				ЗначениеНастройки = Новый Массив;
			КонецЕсли;
			НастройкиСкопированыИзГлавногоУзла = Истина;
		Иначе
			// Если настроек нет в главном узле, формируем новые настройки по умолчанию	
			ЗначениеНастройки = Новый Массив;
		КонецЕсли;
	Иначе
		// Если настройки получены, но необходимо скорректировать их структуру
		Колонки = _ЛокКонтекст.ЛокЯдро_РазложитьСтрокуВМассивПодстрок(ЗначениеНастройки[0].КолонкиТаблицыЗначений, ",");
		Если Колонки.Найти("Используется") = Неопределено Тогда
			ЗначениеНастройки[0].КолонкиТаблицыЗначений = ЗначениеНастройки[0].КолонкиТаблицыЗначений + ",Используется";
			НужноСохранить = Истина;
		КонецЕсли;
		Если Колонки.Найти("ВариантОтбора") = Неопределено Тогда
			ЗначениеНастройки[0].КолонкиТаблицыЗначений = ЗначениеНастройки[0].КолонкиТаблицыЗначений + ",ВариантОтбора";
			НужноСохранить = Истина;
		КонецЕсли;
    КонецЕсли;
	
	НастройкиГлавногоУзла = Неопределено;
	
	Если НЕ ОткрытиеФормы Тогда
		Для каждого ТекущаяНастройка ИЗ ЗначениеНастройки Цикл	
			Если ТекущаяНастройка.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", ТекущаяНастройка.ID_БизнесПроцесса);
			
			// Проверяем, есть ли настройка с таким ID в текущем списке
			МассивСтрок = НастройкиОтборов.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() Тогда
				ЗаполнитьЗначенияСвойств(МассивСтрок[0], ТекущаяНастройка);
				
				НужноСохранить = Истина;
			Иначе
				// Если настройки нет в списке, проверяем наличие бизнес-процесса с таким ID
				МассивБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиБизнесПроцессов, СтруктураОтбора);
				Если МассивБизнесПроцессов = Неопределено Тогда
					Сообщение = НСтр("ru = 'Не найден бизнес-процесс ""%1"" с ID = %2. Настройка отбора не загружена!';
										|en = 'The ""%1"" business process with ID was not found. %2. The selection setting is not loaded!';
										|be = 'Не знойдзены бізнес-працэс ""%1 "" з ID = %2. Настройка адбору не загружаная!'; es = 'No se encontró el proceso de negocio ""%1 "" con ID = %2. ¡La configuración de selección no está cargada!'; ka = '""%1 "" ბიზნეს პროცესი ID-ით ვერ მოიძებნა. %2. შერჩევის პარამეტრი არ არის დატვირთული!'; kk = 'ID = %2 бар ""%1 "" бизнес-процесі табылмады. Таңдау параметрі жүктелмеген!'; ro = 'Procesul de afaceri ""%1 "" cu ID = %2 nu a fost găsit. Setarea de selecție nu este încărcată!'; tr = 'İD =%2 ile ""%1"" iş süreci bulunamadı. Seçim ayarı yüklenmedi!'; uk = 'Не знайдено бізнес-процес ""%1 "" з ID = %2. Налаштування відбору не завантажено!'; uz = 'ID = %1 bilan ""%2"" ish jarayoni topilmadi. Tanlov sozlamalari yuklanmagan!'");
					Сообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(Сообщение, СокрЛП(ТекущаяНастройка.Название), СокрЛП(ТекущаяНастройка.ID_БизнесПроцесса));
					Сообщить(Сообщение); 
					Продолжить;
				Иначе
					НастройкаБП = МассивБизнесПроцессов[0];
					
					БизнесПроцессВключен = НастройкаБП.Используется;
					Если НЕ ЭтоТекущийУзел Тогда
						Если ПользовательскиеНастройки_ЭтотУзел <> Неопределено Тогда
							ПользовательскаяНастройка = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ПользовательскиеНастройки_ЭтотУзел, СтруктураОтбора);
							Если ПользовательскаяНастройка = Неопределено
								И ПользовательскиеНастройки_ГлавныйУзел <> Неопределено Тогда
								ПользовательскаяНастройка = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ПользовательскиеНастройки_ГлавныйУзел, СтруктураОтбора);
							КонецЕсли;
							
							Если ПользовательскаяНастройка <> Неопределено Тогда
								БизнесПроцессВключен = ПользовательскаяНастройка[0].Используется;
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;
					
					НоваяСтрока = НастройкиОтборов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяНастройка);
					НоваяСтрока.БизнесПроцессВключен = БизнесПроцессВключен;	
				
				    НужноСохранить = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	Иначе
		Для каждого НастройкаБП ИЗ НастройкиБизнесПроцессов Цикл
			Если НастройкаБП.Свойство("ЭтоТаблицаЗначений")	Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ НастройкаБП.Свойство("ТипИсходногоДокумента1С")
				ИЛИ НЕ ЗначениеЗаполнено(НастройкаБП.ТипИсходногоДокумента1С) Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура("ID_БизнесПроцесса", НастройкаБП.ID_БизнесПроцесса);
			
			// Определяем, включен/отключен бизнес-процесс
			БизнесПроцессВключен = НастройкаБП.Используется;
			Если НЕ ЭтоТекущийУзел Тогда
				Если ПользовательскиеНастройки_ЭтотУзел <> Неопределено Тогда
					ПользовательскаяНастройка = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ПользовательскиеНастройки_ЭтотУзел, СтруктураОтбора);
					Если ПользовательскаяНастройка = Неопределено
						И ПользовательскиеНастройки_ГлавныйУзел <> Неопределено Тогда
						ПользовательскаяНастройка = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ПользовательскиеНастройки_ГлавныйУзел, СтруктураОтбора);
					КонецЕсли;
					
					Если ПользовательскаяНастройка <> Неопределено Тогда
						БизнесПроцессВключен = ПользовательскаяНастройка[0].Используется;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			МассивНастроекОтбора = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ЗначениеНастройки, СтруктураОтбора);
			
			Если МассивНастроекОтбора = Неопределено Тогда
				// Если бизнес-процесс не включен, создавать отсутствующую настройку по умолчанию не нужно
				Если НЕ БизнесПроцессВключен Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаНастройки = Неопределено;
				
				// Если отсутствующая настройка есть в главном узле, копируем ее из главного узла
				Если ЗначениеЗаполнено(ID_Узла) И НЕ НастройкиСкопированыИзГлавногоУзла Тогда
					Если НастройкиГлавногоУзла = Неопределено Тогда
						НастройкиГлавногоУзла = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуНаСервереSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, "");
						Если НЕ ЗначениеЗаполнено(НастройкиГлавногоУзла) ИЛИ НастройкиГлавногоУзла = Ложь Тогда
							НастройкиГлавногоУзла = Новый Массив;
						КонецЕсли;
					КонецЕсли;
					
					НайденныеНастройкиГлавногоУзла = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(НастройкиГлавногоУзла, СтруктураОтбора);
					Если НЕ НайденныеНастройкиГлавногоУзла = Неопределено Тогда
						СтрокаНастройки = _ЛокКонтекст.ЛокЯдро_СкопироватьСтруктуру(НайденныеНастройкиГлавногоУзла[0]);
					КонецЕсли;
				КонецЕсли;
				
				// Если это главный узел или отсутствующей настройки нет в главном узле, создаем настройку по умолчанию
				Если СтрокаНастройки = Неопределено Тогда
					СтрокаНастройки = _ЛокКонтекст.ЛокЯдро_ПолучитьНастройкуОтбораПоУмолчанию(НастройкаБП, ID_Узла);
					
					Если СтрокаНастройки = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаНастройки.Используется = ТипОбмена <> "Автообмен";
				КонецЕсли;
				
				// Принудительное пересохранение ключа с добавленными отборами необходимо только для главного узла
				Если НЕ ЗначениеЗаполнено(ID_Узла) Тогда
					НужноСохранить = Истина;
				КонецЕсли;
			Иначе
				СтрокаНастройки = МассивНастроекОтбора[0];
				
				Если НЕ СтрокаНастройки.Свойство("Используется") Тогда
					СтрокаНастройки.Вставить("Используется", Истина);
					НужноСохранить = Истина;
				КонецЕсли;
				Если НЕ СтрокаНастройки.Свойство("ВариантОтбора") Тогда
					СтрокаНастройки.Вставить("ВариантОтбора", "Только конструктор");
					НужноСохранить = Истина;
				КонецЕсли;
			КонецЕсли;
				
			НоваяСтрока = НастройкиОтборов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
			НоваяСтрока.БизнесПроцессВключен = БизнесПроцессВключен; // Служебная колонка для настройки отображения только по включенным бизнес-процессам
		КонецЦикла;
	КонецЕсли;
	
	Если НужноСохранить Тогда
		СохранитьНастройкиОтборов();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиОтборов()
	
	МассивДляСохранения = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицы());
	_ЛокКонтекст.ЛокЯдро_СохранитьНастройкуВБазеSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, МассивДляСохранения, ID_Узла);
	Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, МассивДляСохранения);	
	КонецЕсли;
	
	// Значение кэшируемой настройки сохраняется в методе ЛокЯдро_СохранитьНастройкуВБазеSMARTS
	//_ЛокКонтекст.ЛокЯдро_СохранитьЗначениеКэшируемойНастройки("НастройкиОтборовУзлов_" + ТипОбмена, МассивДляСохранения, ID_Узла);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуОтбора(СтрокаНастройки)
	
	ДопПараметры = Новый Структура("СтрокаНастройки", СтрокаНастройки);
	ОП = Новый ОписаниеОповещения("СохранитьНастройкуОтбораПослеПодключения", ЭтаФорма, ДопПараметры);
	
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,, ТипБазы,,,, ОП);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицы()
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат ПоместитьВоВременноеХранилище(НастройкиОтборов, Новый УникальныйИдентификатор());
	#Иначе
		ТЗ = РеквизитФормыВЗначение("НастройкиОтборов");
		
		// Служебные колонки не нужно сохранять
		КолонкиТЗ = ТЗ.Колонки;
		Если НЕ КолонкиТЗ.Найти("БизнесПроцессВключен") = Неопределено Тогда
			КолонкиТЗ.Удалить("БизнесПроцессВключен");
		КонецЕсли;
		
		Возврат ПоместитьВоВременноеХранилище(ТЗ, ЭтаФорма.УникальныйИдентификатор);
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеФлагаИспользуется(Значение)
	
	МассивСтрок = НастройкиОтборов.НайтиСтроки(Новый Структура("Используется", НЕ Значение));
	Если НЕ МассивСтрок.Количество() Тогда
		// Во всех строках установлено нужное значение
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаНастройки ИЗ НастройкиОтборов Цикл
		СтрокаНастройки.Используется = Значение;
	КонецЦикла;
	
	СохранитьНастройкиОтборов();
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьВидимостьГруппыИнфо()
	
	ВидимостьГруппыИнфо = НЕ НеВыводитьИнфоСтроку;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если ВидимостьГруппыИнфо Тогда
			Элементы.ПанельИнфоСтрока.Свертка = РежимСверткиЭлементаУправления.Нет;
		Иначе
			Элементы.ПанельИнфоСтрока.Свертка = РежимСверткиЭлементаУправления.Верх;
		КонецЕсли;
	#Иначе
		Элементы.ГруппаИнфо.Видимость = ВидимостьГруппыИнфо;
		Элементы.ИнфоСтрока.Видимость = ВидимостьГруппыИнфо;
		Элементы.СкрытьИнфоСтроку.Видимость = ВидимостьГруппыИнфо;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпортаЭкспортаНастроек(РежимОбмена)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму("ОФ_ФормаСлужебная_ИмпортЭкспортНастроек", ЭтаФорма);
	#Иначе
		ФормаСлужебная_ИмпортЭкспортНастроек = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ИмпортЭкспортНастроек", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли
	ФормаСлужебная_ИмпортЭкспортНастроек.РежимОбмена = РежимОбмена;
	ФормаСлужебная_ИмпортЭкспортНастроек.ЗакрыватьПриЗакрытииВладельца = Истина;
	ФормаСлужебная_ИмпортЭкспортНастроек._ЛокКонтекст = _ЛокКонтекст;
	ФормаСлужебная_ИмпортЭкспортНастроек.Открыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура ПредложитьПользователюСохранитьНастройкиВФайлЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиПоУмолчаниюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ИзГлавногоУзла = Ложь;
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ИзГлавногоУзла", ИзГлавногоУзла) Тогда
			// Получили параметр ИзГлавногоУзла
		КонецЕсли;	
		
		ЗагрузитьНастройкиПоУмолчаниюВыполнить(ИзГлавногоУзла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНастройки_ОтборДокументовЗакрытие(РезультатНастройки, СтрокаНастройки) Экспорт
	
	Если ЗначениеЗаполнено(РезультатНастройки) Тогда
		ТекущаяСтрокаНастройки = Элементы.НастройкиОтборов.ТекущиеДанные;		
		ТекущаяСтрокаНастройки.НастройкаКомпоновщикаСтрокой = РезультатНастройки.НастройкаКомпоновщикаСтрокой;
		ТекущаяСтрокаНастройки.Используется 				= РезультатНастройки.Используется;
		ТекущаяСтрокаНастройки.ВариантОтбора 				= РезультатНастройки.ВариантОтбора;
		ТекущаяСтрокаНастройки.ID_ПроизвольногоОтбора 		= РезультатНастройки.ID_ПроизвольногоОтбора;
		ТекущаяСтрокаНастройки.Настройка 					= "Настроено";
		
		СохранитьНастройкуОтбора(ТекущаяСтрокаНастройки);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ФормаСлужебная_ВыборСтрокиИзТаблицыЗакрытие(РезультатВыбора,СтрокаНастройки) Экспорт
	Если ЗначениеЗаполнено(РезультатВыбора) И ЗначениеЗаполнено(РезультатВыбора.Данные) Тогда
		НайдСтроки = НастройкиОтборов.НайтиСтроки(Новый Структура("ID_БизнесПроцесса",РезультатВыбора.Данные.ID_БизнесПроцесса));
		Если НайдСтроки.Количество() = 0 Тогда
			// Изменяем строку
			СтрокаТабличнойЧасти = Элементы.НастройкиОтборов.ТекущиеДанные;
			Для Каждого СтрокаРезультата Из РезультатВыбора.Данные Цикл
				СтрокаТабличнойЧасти[СтрокаРезультата.Ключ] = СтрокаРезультата.Значение;
			КонецЦикла;
			Если ПредыдущееЗначение <> РезультатВыбора.Данные.ID_БизнесПроцесса Тогда
				СтрокаТабличнойЧасти.НастройкаКомпоновщикаСтрокой = "";
				СтрокаТабличнойЧасти.Настройка = "Настроить";
			КонецЕсли;
			НастройкиОтборовВыбор("", "", "", "");
		Иначе
			Сообщение = НСтр("ru = 'Для выбранного бизнес-процесса уже существуют настройки отбора!';
								|en = 'There are already selection settings for the selected business process!';
								|be = 'Для абранага бізнес-працэсу ўжо існуюць Налады адбору!'; es = '¡Ya existen ajustes de selección para el proceso de negocio seleccionado!'; ka = 'უკვე არსებობს შერჩეული ბიზნეს პროცესის შერჩევის პარამეტრები!'; kk = 'Таңдалған бизнес-процесс үшін таңдау параметрлері бар!'; ro = 'Există deja setări de selecție pentru procesul de afaceri selectat!'; tr = 'Seçilen iş süreci için seçim ayarları zaten var!'; uk = 'Для обраного бізнес-процесу вже існують Налаштування відбору!'; uz = 'Tanlangan biznes jarayoni uchun tanlov sozlamalari allaqachon mavjud!'");
			Сообщить(Сообщение); 
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрытьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт 
	
	Если Не СерверДоступен = Истина Тогда
		ОповещениеСохранитьНастройкиВФайл = Новый ОписаниеОповещения("ПредложитьПользователюСохранитьНастройкиВФайлЗавершение", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'В данный момент сервер Клеверенс недоступен для сохранения настроек.';
								|en = 'The Cleverence server is currently unavailable for saving settings.';
								|be = 'У дадзены момант сервер Cleverence недаступны для захавання налад.'; es = 'En este momento, el servidor Cleverence no está disponible para guardar la configuración.'; ka = 'Cleverence სერვერი ამჟამად არ არის ხელმისაწვდომი პარამეტრების შესანახად.'; kk = 'Қазіргі уақытта Cleverence сервері параметрлерді сақтау үшін қол жетімді емес.'; ro = 'Serverul Cleverence este momentan indisponibil pentru salvarea setărilor.'; tr = 'Şu anda, ayarları kaydetmek için Cleverence sunucusu kullanılamıyor.'; uk = 'На даний момент сервер Cleverence недоступний для збереження налаштувань.'; uz = 'Hozirda sozlamalarni saqlash uchun Cleverence server mavjud emas.'")
						+ Символы.ПС
						+ НСтр("ru = 'Сохранить настройки в файл?';
								|en = 'Save the settings to a file?'; be = 'Захаваць налады ў файл?'; es = 'Guardar la configuración en un archivo?'; ka = 'შეინახეთ პარამეტრები ფაილში?'; kk = 'Параметрлерді файлға сақтау керек пе?'; ro = 'Salvați setările într-un fișier?'; tr = 'Ayarları dosyaya mı kaydediyorsunuz?'; uk = 'Зберегти налаштування у файл?'; uz = 'Sozlamalarni faylga saqlaysizmi?'");
		ПоказатьВопрос(ОповещениеСохранитьНастройкиВФайл, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , _ЛокКонтекст.ЛокЯдро_ТекстВнимание()); 
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиОтборов();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПослеПодключения(СерверДоступен,ДопПараметры) Экспорт
	
	Если Не СерверДоступен = Истина Тогда
		Если _ЛокКонтекст.ЛокЯдро_ПредложитьПользователюСохранитьНастройкиВФайл(ЭтаФорма) Тогда
			ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
		КонецЕсли;		
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиОтборов();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуОтбораПослеПодключения(СерверДоступен, ДопПараметры) Экспорт

	Если Не СерверДоступен = Истина Тогда
		Если _ЛокКонтекст.ЛокЯдро_ПредложитьПользователюСохранитьНастройкиВФайл(ЭтаФорма) Тогда
			ОткрытьФормуИмпортаЭкспортаНастроек("Экспорт");
		КонецЕсли;		
		Возврат;
	КонецЕсли;
	
	ШаблонНастройки = _ЛокКонтекст.СтруктураМетаданных.НастройкиMS["НастройкиОтборовУзлов_" + ТипОбмена];
	
	СтруктураНастройки = Новый Структура;
	Для каждого КИЗ ИЗ ШаблонНастройки Цикл
		СтруктураНастройки.Вставить(КИЗ.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтруктураНастройки, ДопПараметры.СтрокаНастройки);
	
	Отбор = Новый Структура("ID_БизнесПроцесса", СтруктураНастройки.ID_БизнесПроцесса);
	_ЛокКонтекст.ЛокЯдро_СохранитьСтрокуВТабличнойНастройкеMS("НастройкиОтборовУзлов_" + ТипОбмена, Отбор, СтруктураНастройки, ID_Узла);
	
	// В кэш записываем настройку полностью
	Если ID_Узла = _ЛокКонтекст.ДанныеТекущегоУзла.ID_Узла Тогда
		МассивДляСохранения = _ЛокКонтекст.ЛокЯдро_ТаблицуЗначенийВМассивСтруктур(ПолучитьАдресТаблицы());
		_ЛокКонтекст.ЛокЯдро_ЗаписатьВКэшНастройкуSMARTS("НастройкиОтборовУзлов_" + ТипОбмена, МассивДляСохранения);	
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Процедура НастройкиОтборовПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
		
		Если ДанныеСтроки.Настройка = "Настроено" Тогда
			ОформлениеСтроки.Ячейки.НастройкиОтборовНастройка.ЦветТекста = WebЦвета.Зеленый;	
		Иначе	
			ОформлениеСтроки.Ячейки.НастройкиОтборовНастройка.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Если НЕ ДанныеСтроки.БизнесПроцессВключен Тогда
			Для каждого Колонка ИЗ НастройкиОтборов.Колонки Цикл
				Если Колонка.Имя = "Используется" Тогда
					ОформлениеСтроки.Ячейки["НастройкиОтборов" + Колонка.Имя].Видимость = Ложь;
				Иначе
					ОформлениеСтроки.Ячейки["НастройкиОтборов" + Колонка.Имя].ТолькоПросмотр = Истина;
					ОформлениеСтроки.Ячейки["НастройкиОтборов" + Колонка.Имя].ЦветФона	 = WebЦвета.ДымчатоБелый;
					ОформлениеСтроки.Ячейки["НастройкиОтборов" + Колонка.Имя].ЦветТекста = WebЦвета.ТемноСерый;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецПроцедуры

	Процедура ПриЗакрытии()
		Если НЕ ОписаниеОповещенияОЗакрытии = Неопределено Тогда	
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии);
		КонецЕсли;
	КонецПроцедуры

	Процедура НастройкиОтборовПриИзмененииФлажка(Элемент, Колонка)
		
		КолонкаИмя = Элементы.НастройкиОтборов.ТекущаяКолонка.Имя;
		
		Если КолонкаИмя = "НастройкиОтборовИспользуется" Тогда
			ТекущиеДанные = Элементы.НастройкиОтборов.ТекущиеДанные;
			Если ТекущиеДанные = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			СохранитьНастройкуОтбора(ТекущиеДанные);
		КонецЕсли;
			
	КонецПроцедуры

	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = Новый Структура();
	Для каждого Элемент ИЗ ЭлементыФормы Цикл
		Элементы.Вставить(Элемент.Имя,Элемент);
		Если ТипЗнч(Элемент) = Тип("ТабличноеПоле") Тогда
			Для каждого Колонка ИЗ Элемент.Колонки Цикл
				Элементы.Вставить(Колонка.Имя,Колонка.ЭлементУправления);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Объект = ЭтотОбъект;
#КонецЕсли