/////////////////////////////////////////////////////////////////////////
//Все модули Управляемых и Обычных форм обработки одинаковы и совместимы.
//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте 
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;		
#КонецЕсли

&НаКлиенте
Перем СписокУстройствMS;

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПинКодИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	Если СтрДлина(СокрЛП(Текст)) = 4 Тогда                       				
		ТекущийЭлемент = Элементы.ПринятьПинКод;		
		Элементы.УстройствоMS.Доступность = Ложь;
	Иначе
		Элементы.УстройствоMS.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьПинКод(Команда)
	
	Если ЗначениеЗаполнено(УстройствоMS) Тогда
		Закрыть(МассивУстройствMSАдрес);
	Иначе
		ЗначениеПинКода = СтрЗаменить(ПинКод, " ", "");	
		
		Если ПустаяСтрока(ЗначениеПинКода) Тогда 
			ТекстПредупреждения = НСтр("ru = 'Заполните пин-код или выберите устройство из списка.';
										|en = 'Fill in the PIN code or select a device from the list.';
										|be = 'Запоўніце пін-код або абярыце прыладу з спісу.'; es = 'Rellene el PIN o seleccione el dispositivo de la lista.'; ka = 'შეავსეთ PIN კოდი ან აირჩიეთ მოწყობილობა სიიდან.'; kk = 'ПИН-кодты толтырыңыз немесе тізімнен құрылғыны таңдаңыз.'; ro = 'Completați codul PIN sau selectați un dispozitiv din listă.'; tr = 'Pın kodunu doldurun veya listeden bir cihaz seçin.'; uk = 'Заповніть PIN-код або виберіть пристрій зі списку.'; uz = 'PIN-kodni to''ldiring yoki ro''yxatdan qurilmani tanlang.'");
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
			Возврат;
		ИначеЕсли СтрДлина(ЗначениеПинКода) < 4 Тогда
			ТекстПредупреждения = НСтр("ru = 'Пин-код введен не полностью!';
										|en = 'The PIN code is not fully entered!'; be = 'Пін-код уведзены не цалкам!'; es = '¡El código PIN no está completamente introducido!'; ka = 'PIN კოდი სრულად არ არის შეყვანილი!'; kk = 'PIN коды толық енгізілмеген!'; ro = 'Codul PIN nu este introdus complet!'; tr = 'Pın kodu tam olarak girilmedi!'; uk = 'Пін-код введений не повністю!'; uz = 'PIN-kod to''liq kiritilmagan!'");
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
			Возврат;
		Иначе
			СтрЦифр = "0123456789";		
			Для Инд = 1 По СтрДлина(ЗначениеПинКода) Цикл
				ПроверяемыйСимвол = Сред(ЗначениеПинКода, Инд, 1);
				Если _ЛокКонтекст.ЛокЯдро_СтрНайти(СтрЦифр, ПроверяемыйСимвол) = 0 Тогда
					ТекстПредупреждения = НСтр("ru = 'Ошибка: пин-код должен состоять только из цифр!';
												|en = 'Error: The PIN code must consist of numbers only!'; be = 'Памылка: пін-код павінен складацца толькі з лічбаў!'; es = 'Error: ¡el PIN debe consistir solo en números!'; ka = 'შეცდომა: PIN კოდი უნდა შედგებოდეს მხოლოდ ციფრებისგან!'; kk = 'Қате: PIN коды тек сандардан тұруы керек!'; ro = 'Eroare: codul PIN trebuie să conțină numai numere!'; tr = 'Hata: Pın kodu yalnızca rakamlardan oluşmalıdır!'; uk = 'Помилка: PIN-код повинен складатися лише з цифр!'; uz = 'Xato: PIN-kod faqat raqamlardan iborat bo''lishi kerak!'");
					ПоказатьПредупреждение(Новый ОписаниеОповещения("ПринятьПинКодЗавершение", ЭтаФорма), ТекстПредупреждения); 
					Возврат;					
				КонецЕсли;				
			КонецЦикла;   		
		КонецЕсли;
		
		Закрыть(ЗначениеПинКода);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстройствоMSНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЭтоАдресВременногоХранилища(МассивУстройствMSАдрес) Тогда
		СписокУстройствMS = ПолучитьИзВременногоХранилища(МассивУстройствMSАдрес);
	КонецЕсли;
	
	пУстройстваMS = _ЛокКонтекст.СтруктураМетаданных.УстройстваMS;
	ПользователиMS =_ЛокКонтекст.ЛокЯдро_ПодготовитьДеревоУстройствНаСервере(пУстройстваMS);
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборУстройстваMS = ПолучитьФорму("ОФ_ФормаСлужебная_ВыборПользователяИлиГруппы",ЭтаФорма);
	#Иначе	
		ФормаСлужебная_ВыборУстройстваMS = ПолучитьФорму(_ЛокКонтекст.ПолноеИмяОбъекта + ".Форма.ФормаСлужебная_ВыборПользователяИлиГруппы", , ЭтаФорма, ЭтаФорма);
	#КонецЕсли	
		
	ФормаСлужебная_ВыборУстройстваMS._ЛокКонтекст 					= _ЛокКонтекст;
	ФормаСлужебная_ВыборУстройстваMS.ЗакрыватьПриЗакрытииВладельца 	= Истина;	
	ФормаСлужебная_ВыборУстройстваMS.ТекущиеПользователи 			= УстройствоMS;
	ФормаСлужебная_ВыборУстройстваMS.ПользователиMSАдрес 			= ПользователиMS;
	ФормаСлужебная_ВыборУстройстваMS.СпособНазначения 				= "Устройству";
	ФормаСлужебная_ВыборУстройстваMS.ОдиночныйРежимВыделения 		= Истина;
	ФормаСлужебная_ВыборУстройстваMS.РежимВводаПинКода 				= Истина;
	ФормаСлужебная_ВыборУстройстваMS.РежимОткрытияОкна 				= РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	ФормаСлужебная_ВыборУстройстваMS.Заголовок 						= НСтр("ru = 'Клеверенс: Выбор устройства';
																			|en = 'Cleverence: Device Selection'; be = 'Cleverence: Выбар прылады'; es = 'Cleverence: Selección de dispositivos'; ka = 'Cleverence: მოწყობილობის შერჩევა'; kk = 'Cleverence: құрылғыны таңдау'; ro = 'Cleverence: Selectarea Dispozitivului'; tr = 'Cleverence: Cihaz seçimi'; uk = 'Cleverence: вибір пристрою'; uz = 'Cleverence: qurilmani tanlash'");
	
	ФормаСлужебная_ВыборУстройстваMS.Элементы["ПользователиMSГруппаПользователь"].Заголовок = НСтр("ru = 'Устройство';
																									|en = 'Device'; be = 'Прыстасаванне'; es = 'Dispositivo'; ka = 'მოწყობილობა'; kk = 'Құрылғы'; ro = 'Dispozitiv'; tr = 'Cihaz'; uk = 'Пристрій'; uz = 'Qurilma'");
		
	ОП = Новый ОписаниеОповещения("Служебная_ВыборУстройстваMSЗакрытие", ЭтаФорма);
	ФормаСлужебная_ВыборУстройстваMS.ОписаниеОповещенияОЗакрытии = ОП;
	ФормаСлужебная_ВыборУстройстваMS.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура УстройствоMSПриИзменении(Элемент)
	
	Если Не ПустаяСтрока(УстройствоMS) Тогда
		Элементы.ПинКод.Доступность = Ложь;
	Иначе
		Элементы.ПинКод.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстройствоMSИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда 
		УстройствоMS = "";
		Элементы.ПинКод.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры


#КонецОбласти

#Область ОписанияОповещений

&НаКлиенте
Процедура Служебная_ВыборУстройстваMSЗакрытие(РезультатРедактирования, ДопПараметры) Экспорт
		
	Если РезультатРедактирования <> Неопределено И ТипЗнч(РезультатРедактирования) = Тип("Массив") Тогда
		
		УстройствоMS = "";
		
		Для Каждого Элемент Из РезультатРедактирования Цикл								
			УстройствоMS = УстройствоMS + Элемент.Ид + "|";		
		КонецЦикла; 			
		
		УстройствоMS = Лев(УстройствоMS, СтрДлина(УстройствоMS) - 1);							
		
		МассивУстройствMSАдрес = ПоместитьВоВременноеХранилище(РезультатРедактирования);
		
	Иначе
		
		МассивУстройствMSАдрес = ПоместитьВоВременноеХранилище(СписокУстройствMS);
		
	КонецЕсли;	
	
	Если Не ПустаяСтрока(УстройствоMS) Тогда
		ТекущийЭлемент = Элементы.ПринятьПинКод;
		Элементы.ПинКод.Доступность = Ложь;
	Иначе
		Элементы.ПинКод.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьПинКодЗавершение(ДополнительныеПараметры) Экспорт
	
	// Ничего не делаем...
	
КонецПроцедуры

#КонецОбласти

#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПолноеИмяОбъекта = ЭтотОбъект.Метаданные().ПолноеИмя();
	Элементы = ЭлементыФормы;
	Объект = ЭтотОбъект;
#КонецЕсли