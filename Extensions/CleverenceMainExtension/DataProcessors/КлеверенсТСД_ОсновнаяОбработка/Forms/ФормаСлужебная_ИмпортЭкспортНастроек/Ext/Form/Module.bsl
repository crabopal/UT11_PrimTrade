//Для копирования модуля Управляемой формы в модуль Обычной формы, нужно
//	быстрой заменой закомментировать директивы "&НаКлиенте" и "&НаСервере".
//Для копирования модуля Обычной формы в модуль Управляемой формы, нужно 
//	быстрой заменой раскомментировать директивы "&НаКлиенте" и "&НаСервере"

&НаКлиенте
#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Перем _ЛокКонтекст Экспорт;
#КонецЕсли

&НаКлиенте
Перем КатегорииНастроекMS;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		РеквизитОбъект 			= РеквизитФормыВЗначение("Объект");
		ПолноеИмяОбъекта 		= РеквизитОбъект.Метаданные().ПолноеИмя();
	#КонецЕсли	
	
	// Добавляем колонки в таблицы, которые не отображаются на форме. Программное добавление сделано для совместимости с ОФ
	ДобавляемыеРеквизиты = Новый Массив;
	
	// ТаблицаБизнесПроцессов
	ИмяТаблицы = "ТаблицаБизнесПроцессов";
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ID_БизнесПроцесса",		Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Название",				Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НомерСтроки",			Новый ОписаниеТипов("Число"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Картинка",				Новый ОписаниеТипов("Картинка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Синоним",				Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	
	// ТаблицаУзлов
	ИмяТаблицы = "ТаблицаУзлов";
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Наименование",			Новый ОписаниеТипов("Строка"), 	ИмяТаблицы)); 
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ID_Узла",					Новый ОписаниеТипов("Строка"), 	ИмяТаблицы));
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Для каждого НовыйРеквизит Из ДобавляемыеРеквизиты Цикл
			ИмяТаблицы = НовыйРеквизит.Путь;
			Таблица = ЭтаФорма[ИмяТаблицы];
			Таблица.Колонки.Добавить(НовыйРеквизит.Имя, НовыйРеквизит.ТипЗначения);	
		КонецЦикла;
	#Иначе
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		ПриСозданииНаСервере(Неопределено, Неопределено);
		ДеревоНастроек.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
		КартинкаПапки = БиблиотекаКартинок.ЖурналДокументов;
	#Иначе
		КартинкаПапки = _ЛокКонтекст.ЛокЯдро_Оформление_ПолучитьВнешнююКартинку("Папка");
	#КонецЕсли
	
	РежимОбмена = ?(РежимОбмена = "" ИЛИ РежимОбмена = "0", "Импорт", РежимОбмена);
	
	// Поддерживаемые режимы
	Если НЕ (РежимОбмена = "Импорт"
		ИЛИ РежимОбмена = "Экспорт" 
		ИЛИ РежимОбмена = "Копирование") Тогда
		ВызватьИсключение "Неверный режим обмена";
	КонецЕсли;
	
	Если РежимОбмена = "Импорт" Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Импорт настроек';
							|en = 'Cleverence: Importing settings'; be = 'Cleverence: Імпарт налад'; es = 'Cleverence: Importar ajustes'; ka = 'Cleverence: პარამეტრების იმპორტი'; kk = 'Cleverence: параметрлерді импорттау'; ro = 'Cleverence: importarea setărilor'; tr = 'Cleverence: Ayarları içe aktarma'; uk = 'Cleverence: імпорт налаштувань'; uz = 'Cleverence: sozlamalarni import qilish'");
		ОписаниеШапка = НСтр("ru = 'Загрузка настроек Клеверенс из внешнего файла.';
								|en = 'Downloading the Cleverence settings from an external file.'; be = 'Загрузка налад Cleverence з вонкавага файла.'; es = 'Cargando la configuración de Cleverence desde un archivo externo.'; ka = 'Cleverence პარამეტრების ჩამოტვირთვა გარე ფაილიდან.'; kk = 'Cleverence параметрлерін сыртқы файлдан жүктеу.'; ro = 'Descărcarea setărilor Cleverence dintr-un fișier extern.'; tr = 'Cleverence ayarlarını harici bir dosyadan indirme.'; uk = 'Завантаження налаштувань Cleverence із зовнішнього файлу.'; uz = 'Tashqi fayldan Cleverence sozlamalarini yuklab oling.'");
	ИначеЕсли РежимОбмена = "Экспорт" Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Экспорт настроек';
							|en = 'Cleverence: Exporting settings'; be = 'Cleverence: Экспарт налад'; es = 'Cleverence: Exportar configuración'; ka = 'Cleverence: ექსპორტის პარამეტრები'; kk = 'Cleverence: параметрлерді экспорттау'; ro = 'Cleverence: exportarea setărilor'; tr = 'Cleverence: Ayarları dışa aktarma'; uk = 'Cleverence: експорт налаштувань'; uz = 'Cleverence: sozlamalarni eksport qilish'");
		ОписаниеШапка = НСтр("ru = 'Сохранение настроек Клеверенс во внешний файл.';
								|en = 'Saving the Cleverence settings to an external file.'; be = 'Захаванне налад Cleverence ў вонкавы файл.'; es = 'Guardar la configuración de Cleverence en un archivo externo.'; ka = 'Cleverence პარამეტრების შენახვა გარე ფაილზე.'; kk = 'Cleverence параметрлерін сыртқы файлға сақтау.'; ro = 'Salvarea setărilor Cleverence într-un fișier extern.'; tr = 'Cleverence ayarlarını harici bir dosyaya kaydetme.'; uk = 'Збереження налаштувань Cleverence у зовнішній файл.'; uz = 'Cleverence sozlamalarini tashqi faylga saqlang.'");
	ИначеЕсли РежимОбмена = "Копирование" Тогда
		Заголовок = НСтр("ru = 'Клеверенс: Копирование настроек торговых объектов';
							|en = 'Cleverence: Copying the settings of shopping facilities'; be = 'Cleverence: капіяванне налад гандлёвых аб''ектаў'; es = 'Cleverence: Copiar los ajustes de los objetos comerciales'; ka = 'Cleverence: კოპირება პარამეტრების სავაჭრო ობიექტები'; kk = 'Cleverence: сауда нысандарының параметрлерін көшіру'; ro = 'Cleverence: copierea setărilor facilităților comerciale'; tr = 'Cleverence: Ticari nesnelerin ayarlarını kopyalama'; uk = 'Cleverence: копіювання налаштувань торгових об''єктів'; uz = 'Cleverence: savdo ob''ekti sozlamalarini nusxalash'");
		ОписаниеШапка = НСтр("ru = 'Копирование настроек из одного торгового объекта в другие.';
								|en = 'Copying settings from one shopping facility to another.';
								|be = 'Капіяванне налад з аднаго гандлёвага аб''екта ў іншыя.'; es = 'Copiar los ajustes de un objeto comercial a otros.'; ka = 'პარამეტრების კოპირება ერთი სავაჭრო ობიექტიდან მეორეზე.'; kk = 'Параметрлерді бір сауда орнынан екіншісіне көшіру.'; ro = 'Copierea setărilor de la o unitate comercială la alta.'; tr = 'Ayarları bir ticaret tesisinden diğerine kopyalayın.'; uk = 'Копіювання налаштувань з одного торгового об''єкта в інші.'; uz = 'Sozlamalarni bitta savdo ob''ektidan boshqasiga nusxalash.'");
	КонецЕсли;
	
	ПереключитьОтображениеСлужебныхПолей(Неопределено);
	ЕстьЧастнаяБаза = _ЛокКонтекст.ЕстьЧастнаяБаза;
	ИнициализацияСПроверкойПодключения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ДеревоНастроекПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	//#Если ТолстыйКлиентОбычноеПриложение Тогда
	//	ТекущаяКолонка = Элементы.ДеревоНастроек.ТекущаяКолонка.Имя;
	//#Иначе
	//	ТекущаяКолонка = Элементы.ДеревоНастроек.ТекущийЭлемент.Имя;
	//#КонецЕсли
	//
	//Если ТекущаяКолонка = "ДеревоНастроекИспользовать" Тогда
	
	ТекущиеДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если НЕ ТекущиеДанные.Доступность Тогда
		Сообщить(НСтр("ru = 'Данная настройка недоступна';
						|en = 'This setting is not available'; be = 'Дадзеная налада недаступная'; es = 'Esta configuración no está disponible'; ka = 'ეს პარამეტრი არ არის ხელმისაწვდომი'; kk = 'Бұл параметр қол жетімді емес'; ro = 'Această setare nu este disponibilă'; tr = 'Bu ayar kullanılamıyor'; uk = 'Ця настройка недоступна'; uz = 'Ushbu Sozlama mavjud emas'"));
		ТекущиеДанные.Использовать = Ложь;
		Возврат;
	КонецЕсли;
	
	УстанавливатьИзменениеДетальныхЗаписей = НЕ (ТекущиеДанные.ТипСтроки = "Группа" ИЛИ ТекущиеДанные.ТипСтроки = "Файл");
	
	Если НЕ УстанавливатьИзменениеДетальныхЗаписей Тогда
		УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ТекущиеДанные), "Использовать", ТекущиеДанные.Использовать);
		ТекущиеДанные.ИзменениеДетальныхЗаписей = Ложь;
	КонецЕсли;
	
	СвязанныеЭлементыВыбраны = ВыбратьСвязанныеЭлементыНастроек(ТекущиеДанные);
	
	Если СвязанныеЭлементыВыбраны Тогда
		РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек));
	Иначе
		ПервыйРодитель = ПолучитьПервогоРодителяСтроки(ТекущиеДанные);
		Если ПервыйРодитель <> ТекущиеДанные Тогда
			РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ПолучитьЭлементыСтроки(ПервыйРодитель));
			ПервыйРодитель.Использовать = РежимИспользования > 0;
			ПервыйРодитель.ИзменениеДетальныхЗаписей = РежимИспользования = 2 
			И НЕ ПервыйРодитель.ТипСтроки = "Группа";
		КонецЕсли;
	КонецЕсли;
		
	//КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	ОчиститьСообщения();
	ТаблицаОшибок.Очистить();
	Если НЕ ПроверитьДоступностьОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимОбмена = "Импорт" Тогда
		СохранитьНастройкиВБазуSMARTS();
	ИначеЕсли РежимОбмена = "Экспорт" Тогда
		СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
		_ЛокКонтекст.ЛокЯдро_СохранитьНастройкиВФайл(СтруктураНастроек, "ИмпортЭкспортНастроек", Истина);
	ИначеЕсли РежимОбмена = "Копирование" Тогда
		ВыбратьУзлыПриемники();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина);
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "ИзменениеДетальныхЗаписей", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда = Неопределено)
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Ложь);
	УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ДеревоНастроек), "ИзменениеДетальныхЗаписей", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоУзлу(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		СписокВыбора.Добавить(СтрокаУзла.ID_Узла, СтрокаУзла.Наименование);
	КонецЦикла;
	
	ПараметрыВыбора  = Новый Структура();
	ПараметрыВыбора.Вставить("ПолеСравнения", "ID_Узла");
	ПараметрыВыбора.Вставить("КоличествоСтрок", СписокВыбора.Количество());
	ПараметрыВыбора.Вставить("ВыборПо", "Узлы");
	
	ОП = Новый ОписаниеОповещения("ВыборПоОтборуЗавершение", ЭтаФорма, ПараметрыВыбора);
	
	ЗаголовокФормы = НСтр("ru = 'Клеверенс: Выберите торговые объекты';
							|en = 'Cleverence: Select shopping facilities'; be = 'Cleverence: абярыце гандлёвыя аб''екты'; es = 'Cleverence: Seleccione objetos comerciales'; ka = 'Cleverence: აირჩიეთ სავაჭრო ობიექტები'; kk = 'Cleverence: сауда нысандарын таңдаңыз'; ro = 'Cleverence: selectați facilitățile de cumpărături'; tr = 'Cleverence: Satış tesislerini seçin'; uk = 'Cleverence: виберіть торгові об''єкти'; uz = 'Cleverence: savdo ob''ektlarini tanlang'");
	ОписаниеФормы = НСтр("ru = 'Выбрать все настройки для торговых объектов.';
							|en = 'Select all settings for retail locations.'; be = 'Выбраць усе налады для гандлёвых аб''ектаў.'; es = 'Seleccione todos los ajustes para los objetos comerciales.'; ka = 'აირჩიეთ ყველა პარამეტრი საცალო ადგილებში.'; kk = 'Сауда объектілері үшін барлық параметрлерді таңдаңыз.'; ro = 'Selectați toate setările pentru locațiile de vânzare cu amănuntul.'; tr = 'Seçiniz ticari nesneler için tüm ayarlar.'; uk = 'Вибрати всі налаштування для торгових об''єктів.'; uz = 'Tanlang barcha Sozlamalar savdo ob''ektlari uchun.'");
	ОткрытьФормуМножественногоВыбора(ЗаголовокФормы, ОписаниеФормы, СписокВыбора, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоБП(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого СтрокаУзла Из ТаблицаБизнесПроцессов Цикл
		СписокВыбора.Добавить(СтрокаУзла.ID_БизнесПроцесса, СтрокаУзла.Синоним);
	КонецЦикла;
	
	ПараметрыВыбора  = Новый Структура();
	ПараметрыВыбора.Вставить("ПолеСравнения", "Ид");
	ПараметрыВыбора.Вставить("КоличествоСтрок", СписокВыбора.Количество());
	ПараметрыВыбора.Вставить("ВыборПо", "БизнесПроцессы");
	
	ОП = Новый ОписаниеОповещения("ВыборПоОтборуЗавершение", ЭтаФорма, ПараметрыВыбора);
	
	ЗаголовокФормы = НСтр("ru = 'Клеверенс: Выберите бизнес-процессы';
							|en = 'Cleverence: Select business processes'; be = 'Cleverence: Выберыце бізнес-працэсы'; es = 'Cleverence: Seleccione los procesos de negocio'; ka = 'Cleverence: აირჩიეთ ბიზნეს პროცესები'; kk = 'Cleverence: бизнес-процестерді таңдаңыз'; ro = 'Cleverence: selectați procesele de afaceri'; tr = 'Cleverence: İş süreçlerini seçin'; uk = 'Cleverence: виберіть бізнес-процеси'; uz = 'Cleverence: biznes jarayonlarini tanlang'");
	ОписаниеФормы = НСтр("ru = 'Выбрать связанные настройки по бизнес-процессам.';
							|en = 'Select related settings for business processes.'; be = 'Выбраць звязаныя налады па бізнес-працэсам.'; es = 'Seleccionar configuraciones relacionadas por procesos de negocio.'; ka = 'აირჩიეთ დაკავშირებული პარამეტრები ბიზნეს პროცესებისთვის.'; kk = 'Таңдаңыз байланысты параметрлер бизнес-процестер бойынша.'; ro = 'Selectați Setări asociate pentru procesele de afaceri.'; tr = 'Seçmek iş süreçlerine göre ilgili ayarlar.'; uk = 'Вибрати пов''язані настройки по бізнес-процесам.'; uz = 'Tanlang tegishli Sozlamalar biznes jarayonlari bo''yicha.'");
	ОткрытьФормуМножественногоВыбора(ЗаголовокФормы, ОписаниеФормы, СписокВыбора, ОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУзелИсточник(Команда = Неопределено)
	
	ПереданнаяТаблица = Новый Массив;
	ПереданнаяТаблица.Добавить(Новый Структура("ЭтоТаблицаЗначений,КолонкиТаблицыЗначений",Истина,"Наименование,Идентификатор"));
	ПереданнаяТаблица.Добавить(ПолучитьДанныеГлавногоУзла());
	
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		НоваяСтруктура = Новый Структура();
		НоваяСтруктура.Вставить("Наименование", СтрокаУзла.Наименование);
		НоваяСтруктура.Вставить("Идентификатор", СтрокаУзла.ID_Узла);
		ПереданнаяТаблица.Добавить(НоваяСтруктура);
	КонецЦикла;
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы = ПолучитьФормуОсновнойОбработки("ФормаСлужебная_ВыборСтрокиИзТаблицы");
	ФормаСлужебная_ВыборСтрокиИзТаблицы.Заголовок 			= НСтр("ru = 'Клеверенс: Выберите торговый объект источник';
																	|en = 'Cleverence: Select a source shopping facility'; be = 'Cleverence: Выберыце гандлёвы аб''ект крыніца'; es = 'Cleverence: Seleccione el objeto de comercio fuente'; ka = 'Cleverence: აირჩიეთ წყარო სავაჭრო ობიექტი'; kk = 'Cleverence: сауда нысанын таңдаңыз дереккөз'; ro = 'Cleverence: Selectați o sursă de cumpărături'; tr = 'Cleverence: Bir satış noktası seçin kaynak'; uk = 'Cleverence: виберіть торговий об''єкт джерело'; uz = 'Cleverence: savdo ob''ektini tanlang manba'");
	ФормаСлужебная_ВыборСтрокиИзТаблицы.Описание 			= НСтр("ru = 'Торговый объект, из которого нужно скопировать настройки.';
																	|en = 'The shopping facility from which you want to copy the settings.';
																	|be = 'Гандлёвы аб''ект, з якога трэба скапіяваць Налады.'; es = 'El objeto comercial desde el que desea copiar la configuración.'; ka = 'სავაჭრო ობიექტი, საიდანაც გსურთ პარამეტრების კოპირება.'; kk = 'Параметрлерді көшіру қажет сауда орны.'; ro = 'Facilitatea de cumpărături din care doriți să copiați setările.'; tr = 'Ayarları kopyalamanız gereken ticaret nesnesi.'; uk = 'Торговий об''єкт, з якого потрібно скопіювати настройки.'; uz = 'Sozlamalarni nusxalashingiz kerak bo''lgan savdo ob''ekti.'");
	
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ИмяТаблицы 			= "Узлы";
	ФормаСлужебная_ВыборСтрокиИзТаблицы._ЛокКонтекст 		= _ЛокКонтекст;
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ПереданнаяТаблица 	= ПереданнаяТаблица;
	
	ОП = Новый ОписаниеОповещения("ВыбратьУзелИсточникЗавершение", ЭтаФорма);
	ФормаСлужебная_ВыборСтрокиИзТаблицы.ОписаниеОповещенияОЗакрытии = ОП;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_ВыборСтрокиИзТаблицы.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_ВыборСтрокиИзТаблицы.Открыть();
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОтображениеСлужебныхПолей(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		лЭлементы = Элементы.ДеревоНастроек.Колонки;
	#Иначе
		лЭлементы = Элементы;
	#КонецЕсли
	
	Видимость = НЕ лЭлементы.ДеревоНастроекИмя.Видимость;
	
	лЭлементы.ДеревоНастроекИмя.Видимость = Видимость;
	лЭлементы.ДеревоНастроекТипСтроки.Видимость = Видимость;
	лЭлементы.ДеревоНастроекИзменениеДетальныхЗаписей.Видимость = Видимость;
	лЭлементы.ДеревоНастроекЭтоРодитель.Видимость = Видимость;
	лЭлементы.ДеревоНастроекДоступность.Видимость = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьНастройки(Команда)
	
	Если ОбработкаИнициализирована Тогда
		Если РежимОбмена = "Импорт" Тогда
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучитьНастройкиИзФайлаЗавершение", ЭтаФорма);
			_ЛокКонтекст.ЛокЯдро_ПолучитьНастройкиИзФайла("ИмпортЭкспортНастроек", ОповещениеОЗавершении, Истина);
		Иначе
			ИнициализацияСПроверкойПодключения();
		КонецЕсли;
	Иначе
		ПриОткрытии(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОшибки(Команда)
	ТаблицаОшибок.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображение(КритическаяОшибка = "")
	
	ЭтоИмпорт = РежимОбмена = "Импорт";
	ЭтоКопирование = РежимОбмена = "Копирование";
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		КнопкаВыполнитьОбмен = Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ВыполнитьОбмен;
		КнопкаВыполнитьОбмен.КнопкаПоУмолчанию = Истина;
		Если ЭтоКопирование Тогда
			КнопкаВыполнитьОбмен.Текст = "Скопировать";
			КнопкаВыполнитьОбмен.Картинка = БиблиотекаКартинок.СкопироватьОбъект
		Иначе 
			КнопкаВыполнитьОбмен.Текст = ТРег(РежимОбмена);
		КонецЕсли;
		
		Элементы.ДеревоНастроек.Колонки.ДеревоНастроекИспользовать.Видимость 	= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ВыбратьВсе.Доступность 	= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.СнятьВсе.Доступность 		= ЭтоИмпорт ИЛИ ЭтоКопирование;
		
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ГруппаДеревоНастроекВыбор.Кнопки.ВыбратьПоБП.Доступность 	= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ГруппаДеревоНастроекВыбор.Кнопки.ВыбратьПоУзлу.Доступность 	= ЭтоИмпорт;
		
		Если НЕ ЭтоКопирование И Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.Найти("ВыбратьУзелИсточник") <> Неопределено Тогда
			Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.Удалить(Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ВыбратьУзелИсточник);
		КонецЕсли;
		
	#Иначе
		КнопкаВыполнитьОбмен = Элементы.ВыполнитьОбмен;
		КнопкаВыполнитьОбмен.КнопкаПоУмолчанию = Истина;
		Если ЭтоКопирование Тогда
			КнопкаВыполнитьОбмен.Заголовок = "Скопировать";
			КнопкаВыполнитьОбмен.Картинка = БиблиотекаКартинок.СкопироватьОбъект
		Иначе 
			КнопкаВыполнитьОбмен.Заголовок = ТРег(РежимОбмена);
		КонецЕсли;
		
		Элементы.ДеревоНастроекИспользовать.Видимость 	= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ВыбратьВсе.Доступность 					= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.СнятьВсе.Доступность 						= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ГруппаДеревоНастроекВыбор.Доступность 		= ЭтоИмпорт ИЛИ ЭтоКопирование;
		Элементы.ВыбратьПоУзлу.Доступность 					= ЭтоИмпорт;
		Элементы.ВыбратьУзелИсточник.Видимость 				= ЭтоКопирование;
	#КонецЕсли
	
	Элементы.ВерсияНастроек.Видимость = НЕ ПустаяСтрока(ВерсияНастроек);
	Элементы.ВерсияНастроекЗаголовок.Видимость = Элементы.ВерсияНастроек.Видимость;
	
	Если ЭтоИмпорт Тогда
		Элементы.ПеречитатьНастройки.Заголовок = НСтр("ru = 'Получить настройки из файла';
														|en = 'Get settings from a file'; be = 'Атрымаць налады з файла'; es = 'Obtener la configuración del archivo'; ka = 'მიიღეთ პარამეტრები ფაილიდან'; kk = 'Параметрлерді файлдан алыңыз'; ro = 'Obțineți Setări dintr-un fișier'; tr = 'Ayarları dosyadan alın'; uk = 'Отримати налаштування з файлу'; uz = 'Fayldan sozlamalarni oling'");
		Элементы.ПеречитатьНастройки.Картинка = БиблиотекаКартинок.ОткрытьФайл;
	Иначе
		Элементы.ПеречитатьНастройки.Заголовок = НСтр("ru = 'Перечитать настройки';
														|en = 'Re-read the settings'; be = 'Перачытаць Налады'; es = 'Volver a Leer la configuración'; ka = 'ხელახლა წაიკითხეთ პარამეტრები'; kk = 'Параметрлерді қайта оқыңыз'; ro = 'Re-citiți setările'; tr = 'Ayarları yeniden okuyun'; uk = 'Перечитати Налаштування'; uz = 'Sozlamalarni qayta o''qing'");
		Элементы.ПеречитатьНастройки.Картинка = БиблиотекаКартинок.Обновить;
	КонецЕсли;
	
	Если ЭтоКопирование Тогда
		Если ИдУзлаИсточник = "" Тогда
			НаименованиеУзлаИсточник = НСтр("ru = '<Не выбран>';
												|en = '<Not selected>'; be = '< Не абраны>'; es = '<No seleccionado>'; ka = '< არ არის შერჩეული>'; kk = '<Таңдалмаған>'; ro = '< Nu a fost selectat>'; tr = '<Seçilmedi>'; uk = '<Не вибрано>'; uz = '< Tanlanmagan>'");
		КонецЕсли;
		пСообщение = НСтр("ru = 'из торгового объекта: %1';
							|en = 'from a shopping facility: %1'; be = 'з гандлёвага аб''екта: %1'; es = 'del objeto comercial: %1'; ka = 'სავაჭრო ობიექტიდან: %1'; kk = 'сауда объектісінен: %1'; ro = 'de la o unitate comercială: %1'; tr = 'ticaret tesisinden: %1'; uk = 'з торгового об''єкта: %1'; uz = 'savdo ob''ektidan: %1'");
		ВыбратьУзелИсточникЗаголовок = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, НаименованиеУзлаИсточник); 
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Элементы.ДеревоНастроекКоманднаяПанель.Кнопки.ВыбратьУзелИсточник.Текст = ВыбратьУзелИсточникЗаголовок;
		#Иначе
			Элементы.ВыбратьУзелИсточник.Заголовок = ВыбратьУзелИсточникЗаголовок;
		#КонецЕсли
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция ПредставлениеВерсииНастроек(ДанныеНастроек)
	Возврат Строка(ДанныеНастроек.ВерсияОбработкиНастроек) + " (" + ДанныеНастроек.ДатаНастроек + ")";
КонецФункции 

&НаКлиенте
Процедура ВыборПоОтборуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ЭлементыДерева = ПолучитьЭлементыСтроки(ДеревоНастроек);
		
		Если ДополнительныеПараметры.ВыборПо = "БизнесПроцессы"
			И ДополнительныеПараметры.КоличествоСтрок = Результат.Количество() Тогда
			
			Для каждого Строка Из ЭлементыДерева Цикл
				Если Строка.Имя = "НастройкиБП_Общий"
					ИЛИ Строка.Имя = "НастройкиОтборов"
					ИЛИ Строка.Имя = "ГлобальныеПараметры_Общий"
					ИЛИ Строка.Имя = "ПроизвольныеКоды" Тогда
					УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(Строка), "Использовать", Истина);					
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			Для каждого Идентификатор Из Результат Цикл
				УстановитьЗначениеВДеревоПоУсловию(ЭлементыДерева, "Использовать", Истина, ДополнительныеПараметры.ПолеСравнения, "Равно", Идентификатор, Истина);	
			КонецЦикла;
		КонецЕсли;
		
		РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ЭлементыДерева);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьУзелИсточникЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено
		И ЗначениеЗаполнено(Результат.Данные.Идентификатор) Тогда
		
		КэшИдУзла = ИдУзлаИсточник;
		ИдУзлаИсточник = Результат.Данные.Идентификатор;
		НаименованиеУзлаИсточник = Результат.Данные.Наименование;
		
		Если ИдУзлаИсточник <> КэшИдУзла Тогда
			ИнициализацияСПроверкойПодключения();
		КонецЕсли;
		
	ИначеЕсли ИдУзлаИсточник = "" Тогда
		пСообщение = НСтр("ru = 'Не выбран торговый объект источник.';
							|en = 'The source shopping facility is not selected.'; be = 'Не абраны гандлёвы аб''ект крыніца.'; es = 'No se ha seleccionado el objeto comercial fuente.'; ka = 'წყარო სავაჭრო ობიექტი არ არის შერჩეული.'; kk = 'Сауда нысаны таңдалмаған дереккөз.'; ro = 'Facilitatea de cumpărături sursă nu este selectată.'; tr = 'Kaynak ticaret nesnesi seçilmemiştir.'; uk = 'Не обраний торговий об''єкт джерело.'; uz = 'Manba xarid qilish vositasi tanlanmagan.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУзлыПриемники()
	
	СписокВыбора = Новый СписокЗначений;
	ДанныеГлавногоУзла = ПолучитьДанныеГлавногоУзла();
	Если ИдУзлаИсточник <> ДанныеГлавногоУзла.Идентификатор Тогда
		СписокВыбора.Добавить(ДанныеГлавногоУзла.Идентификатор, ДанныеГлавногоУзла.Наименование);
	КонецЕсли;
	
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		Если ИдУзлаИсточник <> СтрокаУзла.ID_Узла Тогда
			СписокВыбора.Добавить(СтрокаУзла.ID_Узла, СтрокаУзла.Наименование);
		КонецЕсли;
	КонецЦикла;
	
	ОП = Новый ОписаниеОповещения("ВыбратьУзлыПриемникиЗавершение", ЭтаФорма);
	
	ЗаголовокФормы = НСтр("ru = 'Клеверенс: Выберите торговые объекты приемники';
							|en = 'Cleverence: Select shopping facilities receivers'; be = 'Cleverence: абярыце гандлёвыя аб''екты прымачы'; es = 'Cleverence: Seleccione los receptores de objetos comerciales'; ka = 'Cleverence: აირჩიეთ სავაჭრო ობიექტების მიმღებები'; kk = 'Cleverence: сауда нысандарын қабылдағыштарды таңдаңыз'; ro = 'Cleverence: selectați receptoare facilități de cumpărături'; tr = 'Cleverence: Alışveriş tesislerini seçin alıcılar'; uk = 'Cleverence: виберіть торгові об''єкти приймачі'; uz = 'Cleverence: savdo ob''ektlarini tanlang qabul qiluvchilar'");
	ОписаниеФормы = НСтр("ru = 'Торговые объекты, для которых нужно скопировать настройки из «%1»';
							|en = 'Shopping facilities for which you need to copy the settings from %1';
							|be = 'Гандлёвыя аб''екты, для якіх трэба скапіяваць налады з "" %1»'; es = 'Objetos comerciales para los que desea copiar la configuración de ""%1""'; ka = 'სავაჭრო ობიექტები, რომლისთვისაც თქვენ უნდა დააკოპიროთ პარამეტრები %1-დან'; kk = 'Параметрлерді""%1 "" - ден көшіру қажет сауда объектілері'; ro = 'Facilități de cumpărături pentru care trebuie să copiați setările din %1'; tr = 'Ayarları «%1» den kopyalamanız gereken ticari nesneler'; uk = 'Торгові об''єкти, для яких потрібно скопіювати налаштування з»%1""'; uz = 'Sozlamalarni""%1 "" dan nusxalashingiz kerak bo''lgan savdo ob''ektlari'");
	ОписаниеФормы = _ЛокКонтекст.ЛокЯдро_СтрШаблон(ОписаниеФормы, НаименованиеУзлаИсточник);
	ОткрытьФормуМножественногоВыбора(ЗаголовокФормы, ОписаниеФормы, СписокВыбора, ОП);
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьУзлыПриемникиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Количество() Тогда
		СкопироватьНастройкиУзла(Результат);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьДанныеГлавногоУзла()
	
	Наименование = НСтр("ru = 'Торговый объект по умолчанию';
							|en = 'The default shopping facility'; be = 'Гандлёвы аб''ект па змаўчанні'; es = 'Objeto de comercio predeterminado'; ka = 'ნაგულისხმევი სავაჭრო ობიექტი'; kk = 'Әдепкі сауда нысаны'; ro = 'Facilitatea de cumpărături implicită'; tr = 'Varsayılan ticaret nesnesi'; uk = 'Торговий об''єкт за замовчуванням'; uz = 'Standart savdo ob''ekti'");
	НоваяСтруктура = Новый Структура();
	НоваяСтруктура.Вставить("Наименование", Наименование);
	НоваяСтруктура.Вставить("Идентификатор", "ND00000000000000000000000000000000");
	Возврат НоваяСтруктура;
	
КонецФункции 

&НаКлиенте
Процедура ДобавитьЗаписьОшибки(ОписаниеОшибки, ИмяНастройки, Идентификатор)
	
	НоваяСтрока = ТаблицаОшибок.Добавить();
	НоваяСтрока.НомерСтроки = ТаблицаОшибок.Количество();
	НоваяСтрока.Описание = ОписаниеОшибки;
	НоваяСтрока.ИмяНастройки = ИмяНастройки;
	НоваяСтрока.Идентификатор = Идентификатор;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ГруппаТаблицаОшибок.Показать();
	#КонецЕсли
	
КонецПроцедуры 

#Область ИнициализацияНастроек

&НаКлиенте
Процедура ИнициализацияСПроверкойПодключения(ДанныеНастроек = Неопределено)
		
	ДопПараметры = Новый Структура("ДанныеНастроек", ДанныеНастроек);
	ОП = Новый ОписаниеОповещения("ИнициализацияПослеПодключения",ЭтаФорма, ДопПараметры);
	_ЛокКонтекст.ЛокЯдро_ПроверитьСоединениеССерверомSMARTS(,,?(ЕстьЧастнаяБаза,"Частная","Основная"),,,,ОП);
	
КонецПроцедуры 

&НаКлиенте
Процедура ИнициализацияПослеПодключения(СерверДоступен, ДополнительныеПараметры) Экспорт
	
	ЕстьУзлы = Ложь;
	ОбработкаИнициализирована = Ложь;
	АдресДанныхНастроек = "";
	ВерсияНастроек = "";
	
	ТаблицаБизнесПроцессов.Очистить();
	ТаблицаУзлов.Очистить();
	ПолучитьЭлементыСтроки(ДеревоНастроек).Очистить();
	
	Если НЕ СерверДоступен Тогда
		ОбновитьОтображение("НетПодключенияSMARTS");
		Возврат;
	КонецЕсли;
	
	КатегорииНастроекMS = _ЛокКонтекст.КомЯдро_ПолучитьЗначениеПеременной("КатегорииНастроекMS");
	Если КатегорииНастроекMS = Неопределено Тогда
		КатегорииНастроекMS = _ЛокКонтекст.ЛокЯдро_ПолучитьКатегорииНастроекMS();
	КонецЕсли;
	
	АдресаПеременных = _ЛокКонтекст.АдресаПеременных;
	
	Если РежимОбмена = "Импорт"
		И ДополнительныеПараметры.ДанныеНастроек <> Неопределено Тогда
		
		ДанныеНастроек = ДополнительныеПараметры.ДанныеНастроек;
		_ЛокКонтекст.ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ДанныеНастроек.Значения);
		АдресДанныхНастроек = ПоместитьВоВременноеХранилище(ДанныеНастроек, ЭтаФорма.УникальныйИдентификатор);
		ЗаполнитьТаблицуНастроекНаКлиенте(ДополнительныеПараметры.ДанныеНастроек, МетаданныеНастроекДляЭкспорта());
		
	ИначеЕсли РежимОбмена = "Экспорт" Тогда
		
		ДанныеНастроек = _ЛокКонтекст.ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляЭкспорта();
		АдресДанныхНастроек = ПоместитьВоВременноеХранилище(ДанныеНастроек.ДанныеНастроекЭкспорт, ЭтаФорма.УникальныйИдентификатор);
		ЗаполнитьТаблицуНастроекНаКлиенте(ДанныеНастроек.ДанныеНастроекСлужебные, МетаданныеНастроекДляЭкспорта());
		ВыбратьВсе(Неопределено);
		
	ИначеЕсли РежимОбмена = "Копирование" Тогда
		
		Если ИдУзлаИсточник <> "" Тогда
			ДанныеНастроек = _ЛокКонтекст.ЛокЯдро_ОбменНастройками_ПолучитьНастройкиДляЭкспорта();
			АдресДанныхНастроек = ПоместитьВоВременноеХранилище(ДанныеНастроек.ДанныеНастроекСлужебные, ЭтаФорма.УникальныйИдентификатор);
			ЗаполнитьТаблицуНастроекНаКлиенте(ДанныеНастроек.ДанныеНастроекСлужебные, МетаданныеНастроекДляКопирования());
		Иначе
			
			ОтборИдУзлов = Новый Массив;
			ОтборИдУзлов.Добавить("");
			
			ОтборНастроек = Новый Структура;
			ОтборНастроек.Вставить("Узлы");
			
			ЗначенияНастроек = _ЛокКонтекст.ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек, ОтборИдУзлов);
			_ЛокКонтекст.ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ЗначенияНастроек, ОтборИдУзлов);
			
			ЗаполнитьТаблицуУзлов(ЗначенияНастроек);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбработкаИнициализирована = Истина;
	ОбновитьОтображение();
	
	Если РежимОбмена = "Копирование" И ИдУзлаИсточник = "" Тогда
		ВыбратьУзелИсточник();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиИзФайлаЗавершение(СтруктураНастроек, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализацияСПроверкойПодключения(СтруктураНастроек);
	
КонецПроцедуры 

