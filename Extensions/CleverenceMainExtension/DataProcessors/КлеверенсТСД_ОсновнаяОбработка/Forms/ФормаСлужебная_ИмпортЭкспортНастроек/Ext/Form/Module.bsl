&НаКлиенте
Функция ПроверитьДоступностьОбмена()
	
	Доступно = Истина;
		
	Если АдресДанныхНастроек = "" Тогда
		пСообщение = НСтр("ru = 'Пустая таблица настроек.';
							|en = 'An empty settings table.'; be = 'Пустая табліца налад.'; es = 'Tabla de configuración vacía.'; ka = 'ცარიელი პარამეტრების ცხრილი.'; kk = 'Бос параметрлер кестесі.'; ro = 'Un tabel de setări gol.'; tr = 'Boş ayarlar tablosu.'; uk = 'Порожня таблиця налаштувань.'; uz = 'Bo''sh Sozlamalar jadvali.'");
		Сообщить(пСообщение);
		Доступно = Ложь;
	КонецЕсли;
	
	Если АдресДанныхНастроек <> "" И РежимОбмена = "Импорт" Тогда
		Отбор = Новый Структура("Использовать, ЭтоРодитель", Истина, Ложь);
		ЕстьОтмеченныеЭлементы = НайтиСтрокиДереваПоОтбору(ПолучитьЭлементыСтроки(ДеревоНастроек), Отбор, Истина);
		Если ЕстьОтмеченныеЭлементы = Неопределено Тогда
			пСообщение = НСтр("ru = 'Нет отмеченных настроек для импорта.';
								|en = 'There are no marked import settings.'; be = 'Няма адзначаных налад для імпарту.'; es = 'No hay configuraciones marcadas para importar.'; ka = 'არ არის მონიშნული იმპორტის პარამეტრები.'; kk = 'Импорттау үшін белгіленген параметрлер жоқ.'; ro = 'Nu există setări de import marcate.'; tr = 'İçe aktarılacak işaretli ayar yoktur.'; uk = 'Немає позначених налаштувань для імпорту.'; uz = 'Import qilish uchun belgilangan Sozlamalar mavjud emas.'");
			Сообщить(пСообщение);
			Доступно = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимОбмена = "Копирование" Тогда
		Если ИдУзлаИсточник = "" Тогда
			пСообщение = НСтр("ru = 'Не выбран торговый объект источник.';
								|en = 'The source shopping facility is not selected.'; be = 'Не абраны гандлёвы аб''ект крыніца.'; es = 'No se ha seleccionado el objeto comercial fuente.'; ka = 'წყარო სავაჭრო ობიექტი არ არის შერჩეული.'; kk = 'Сауда нысаны таңдалмаған дереккөз.'; ro = 'Facilitatea de cumpărături sursă nu este selectată.'; tr = 'Kaynak ticaret nesnesi seçilmemiştir.'; uk = 'Не обраний торговий об''єкт джерело.'; uz = 'Manba xarid qilish vositasi tanlanmagan.'");
			Сообщить(пСообщение);
			Доступно = Ложь;
		КонецЕсли;
		
		Если АдресДанныхНастроек <> "" Тогда
			Отбор = Новый Структура("Использовать, ЭтоРодитель", Истина, Ложь);
			ЕстьОтмеченныеЭлементы = НайтиСтрокиДереваПоОтбору(ПолучитьЭлементыСтроки(ДеревоНастроек), Отбор, Истина);
			Если ЕстьОтмеченныеЭлементы = Неопределено Тогда
				пСообщение = НСтр("ru = 'Нет отмеченных настроек для копирования.';
									|en = 'There are no marked settings for copying.'; be = 'Няма адзначаных налад для капіявання.'; es = 'No hay configuraciones marcadas para copiar.'; ka = 'კოპირებისთვის არ არის მონიშნული პარამეტრები.'; kk = 'Көшіру үшін белгіленген параметрлер жоқ.'; ro = 'Nu există setări marcate pentru copiere.'; tr = 'Kopyalanacak işaretli ayar yoktur.'; uk = 'Немає позначених налаштувань для копіювання.'; uz = 'Nusxalash uchun belgilangan Sozlamalar mavjud emas.'");
				Сообщить(пСообщение);
				Доступно = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Доступно;
	
КонецФункции 

&НаКлиенте
Процедура СохранитьНастройкиВБазуSMARTS()
	
	// Получаем список узлов и БП из SMARTS для проверки
	ОтборИдУзлов = Новый Массив;
	ОтборИдУзлов.Добавить("");
	
	ОтборНастроек = Новый Структура;
	ОтборНастроек.Вставить("Узлы");
	ОтборНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
	ОтборНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские");
	
	ЗначенияSMARTS = _ЛокКонтекст.ЛокЯдро_ОбменНастройками_ПолучитьНастройкиНаСервереSMARTS(ОтборНастроек, ОтборИдУзлов);
	_ЛокКонтекст.ЛокЯдро_ОбменНастройками_ДополнитьСтруктуруНастроекСлужебнымиЗначениями(ЗначенияSMARTS, ОтборИдУзлов);
	
	// ИдУзлов и ИдБизнесПроцессов нужны для проверки наличия значения в базе или импортируемых настройках
	ИдУзлов = ЗначенияSMARTS.ИдУзлов;
	ИдБизнесПроцессов = ЗначенияSMARTS.ИдБизнесПроцессов;
	ЗначенияSMARTS = Новый Структура("ИдУзлов, ИдБизнесПроцессов", ИдУзлов, ИдБизнесПроцессов);
	
	// Данные импортируемых настроек
	ДанныеНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
	ДанныеНастроек.Вставить("ЗначенияSMARTS", ЗначенияSMARTS);
	
	// Формируем список узлов, для которых импортируются настройки
	ВыбранныеИдУзлов = Новый Массив;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбранныеИдУзлов", ВыбранныеИдУзлов);
	
	// Структура выбранных детальных записей для импорта
	ВыбранныеЗначенияНастроек = Новый Структура;
	
	СтрокиДерева = ПолучитьЭлементыСтроки(ДеревоНастроек);
	СобратьСтруктуруВыбранныхНастроекРекурсивно(СтрокиДерева, ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
	
	Если ВыбранныеЗначенияНастроек.Количество() Тогда
		ДополнительныеПараметры = Новый Структура;
		ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьНастройкиВБазуSMARTSЗавершение", ЭтаФорма);
		ДополнительныеПараметры.Вставить("ОповещениеОбработкиЗавершения", ОписаниеОповещения);
		
		ВыбранныеЗначенияНастроек.Вставить("ВерсияОбработкиНастроек", ДанныеНастроек.Значения.ВерсияОбработкиНастроек);
		_ЛокКонтекст.ЛокЯдро_ОбменНастройками_ИмпортироватьНастройки(ВыбранныеЗначенияНастроек, ВыбранныеИдУзлов, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьНастройкиУзла(УзлыПриемники)
	
	ЗначенияSMARTS = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
	
	// Данные импортируемых настроек
	ДанныеНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
	ДанныеНастроек.Вставить("ЗначенияSMARTS", ЗначенияSMARTS.Значения);
	
	// Формируем список узлов, для которых импортируются настройки
	ВыбранныеИдУзлов = Новый Массив;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбранныеИдУзлов", ВыбранныеИдУзлов);
	
	// Структура выбранных детальных записей для импорта
	ВыбранныеЗначенияНастроек = Новый Структура;
	
	СтрокиДерева = ПолучитьЭлементыСтроки(ДеревоНастроек);
	СобратьСтруктуруВыбранныхНастроекРекурсивно(СтрокиДерева, ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
	
	Если ВыбранныеЗначенияНастроек.Количество() Тогда
		
		ИдГлавногоУзла = ПолучитьДанныеГлавногоУзла().Идентификатор;
		СтруктураНастроекПриемник = Новый Структура;
		
		// Копирование из главного узла
		Если ИдУзлаИсточник = ИдГлавногоУзла Тогда
			
			Для каждого СтрокаНастройки Из ВыбранныеЗначенияНастроек Цикл
				ЗначенияУзловПриемников = Новый Структура;
				Для каждого ИдУзла Из УзлыПриемники Цикл
					ЗначениеУзлаИсточник = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтрокаНастройки.Значение);
					ЗначенияУзловПриемников.Вставить(ИдУзла, ЗначениеУзлаИсточник);
				КонецЦикла;
				СтруктураНастроекПриемник.Вставить(СтрокаНастройки.Ключ + "_Узлы", ЗначенияУзловПриемников);
			КонецЦикла;
			
		Иначе
			// Копирование из пользовательских узлов
			Для каждого СтрокаНастройки Из ВыбранныеЗначенияНастроек Цикл
				
				ЗначенияУзловПриемников = Новый Структура;
				Для каждого ИдУзла Из УзлыПриемники Цикл
					
					ЗначениеУзлаИсточник = _ЛокКонтекст.ЛокЯдро_СкопироватьМассив(СтрокаНастройки.Значение[ИдУзлаИсточник]);
					Если ИдУзла = ИдГлавногоУзла Тогда
						Если СтрокаНастройки.Ключ = "ПользователиТСД_Узлы" Тогда
							Продолжить;
						КонецЕсли;
						
						ИмяНастройки = СтрЗаменить(СтрокаНастройки.Ключ, "_Узлы", "");
						СтруктураНастроекПриемник.Вставить(ИмяНастройки, ЗначениеУзлаИсточник);
						
						// Добавляем НастройкиБизнесПроцессов_Пользовательские понадобится в методе ЛокЯдро_ОбменНастройками_ОбработатьСвязанныеЗначенияНастроек
						Если ИмяНастройки = "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
							
							Отбор = Новый Структура("Имя", "НастройкиБизнесПроцессов_ПользовательскиеНастройки_Узлы");
							СтрокаДерева = НайтиСтрокиДереваПоОтбору(СтрокиДерева, Отбор, Истина);
							
							пВыбранныеСтроки = Новый Структура;
							ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "НастройкиБизнесПроцессов_Пользовательские", пВыбранныеСтроки, ДанныеНастроек, ДополнительныеПараметры);
							
							Если пВыбранныеСтроки.Свойство("НастройкиБизнесПроцессов_Пользовательские") Тогда
								НБП_Пользовательские = пВыбранныеСтроки.НастройкиБизнесПроцессов_Пользовательские[ИдУзлаИсточник];
								СтруктураНастроекПриемник.Вставить("НастройкиБизнесПроцессов_Пользовательские", НБП_Пользовательские);
							КонецЕсли;
							
						КонецЕсли;
						
					Иначе
						ЗначенияУзловПриемников.Вставить(ИдУзла, ЗначениеУзлаИсточник);
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЗначенияУзловПриемников.Количество() Тогда
					СтруктураНастроекПриемник.Вставить(СтрокаНастройки.Ключ, ЗначенияУзловПриемников);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		ПоискУзла = УзлыПриемники.Найти(ИдГлавногоУзла);
		Если ПоискУзла <> Неопределено Тогда
			// Если выбран главный узел, то идентификатор должен быть пустой строкой
			УзлыПриемники[ПоискУзла] = "";
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьНастройкиУзлаЗавершение", ЭтаФорма);
		ДополнительныеПараметры.Вставить("ОповещениеОбработкиЗавершения", ОписаниеОповещения);
		ДополнительныеПараметры.Вставить("РежимОбмена", РежимОбмена);
		
		СтруктураНастроекПриемник.Вставить("ВерсияОбработкиНастроек", ДанныеНастроек.Значения.ВерсияОбработкиНастроек);
		_ЛокКонтекст.ЛокЯдро_ОбменНастройками_ИмпортироватьНастройки(СтруктураНастроекПриемник, УзлыПриемники, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиВБазуSMARTSЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		пСообщение = НСтр("ru = 'Импорт настроек завершен';
							|en = 'Settings import completed'; be = 'Імпарт налад завершаны'; es = 'Se ha completado la importación de la configuración'; ka = 'პარამეტრები იმპორტი დასრულდა'; kk = 'Параметрлерді импорттау аяқталды'; ro = 'Setări import finalizat'; tr = 'Ayarların içe aktarılması tamamlandı'; uk = 'Імпорт налаштувань завершено'; uz = 'Sozlamalarni import qilish tugallandi'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьНастройкиУзлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		пСообщение = НСтр("ru = 'Копирование настроек завершено.';
							|en = 'Copying of the settings is completed.'; be = 'Капіраванне налад завершана.'; es = 'Se ha completado la copia de la configuración.'; ka = 'პარამეტრების კოპირება დასრულებულია.'; kk = 'Параметрлерді көшіру аяқталды.'; ro = 'Copierea setărilor este finalizată.'; tr = 'Ayarların kopyalanması tamamlanmıştır.'; uk = 'Копіювання налаштувань завершено.'; uz = 'Sozlamalarni nusxalash tugallandi.'");
		Сообщить(пСообщение);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура СобратьСтруктуруВыбранныхНастроекРекурсивно(СтрокиДерева, ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры = Неопределено);
	
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.Использовать Тогда
			
			Если СтрокаДерева.ТипСтроки = "Группа" Тогда
				СобратьСтруктуруВыбранныхНастроекРекурсивно(ПолучитьЭлементыСтроки(СтрокаДерева), ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
				
			ИначеЕсли СтрокаДерева.ТипСтроки = "Файл" Тогда
				
				ИмяНастройки = СтрокаДерева.Имя;
				Если ИмяНастройки = "ОбщаяСтруктураБизнесПроцессов" Тогда
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "НастройкиБизнесПроцессов_ПоУмолчанию", ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "НастройкиБизнесПроцессов_Пользовательские", ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "НастройкиБизнесПроцессов_ПользовательскиеНастройки", ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
				ИначеЕсли ИмяНастройки = "ПроизвольныеКоды" Тогда
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "ПроизвольныеКоды_ПоУмолчанию", ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, "ПроизвольныеКоды_Пользовательские", ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
				Иначе
					ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, ИмяНастройки, ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьЗначенияВыбранныхНастроек(СтрокаДерева, ИмяНастройки, ВыбранныеЗначенияНастроек, ДанныеНастроек, ДополнительныеПараметры = Неопределено)
	
	ИмяНастройкиБезУзла 			= СтрЗаменить(ИмяНастройки, "_Узлы", "");
	ID_Узла 							= СтрокаДерева.ID_Узла;
	ЗначенияИмпорт					= ДанныеНастроек.Значения;
	ИдУзлов							= ДанныеНастроек.ЗначенияSMARTS.ИдУзлов;
	ИдБизнесПроцессов 				= ДанныеНастроек.ЗначенияSMARTS.ИдБизнесПроцессов;
	ВыбранныеИдУзлов				= ДополнительныеПараметры.ВыбранныеИдУзлов;
	
	// Проверка на наличие узла в базе или импортируемых настройках
	Если ИмяНастройкиБезУзла <> "Узлы" И ID_Узла <> "" Тогда
		Если ИдУзлов.Найти(ID_Узла) = Неопределено Тогда
			УзелНастройки = ТаблицаУзлов.НайтиСтроки(Новый Структура("ID_Узла", ID_Узла))[0];
			пСообщение = НСтр("ru = 'Не удалось найти торговый объект: %1. Выберите торговые объекты для импорта';
								|en = 'Couldn''t find a shopping facility: %1. Select the retail facilities to import';
								|be = 'Не ўдалося знайсці гандлёвы аб''ект: %1. Выберыце гандлёвыя аб''екты для імпарту'; es = 'No se pudo encontrar el objeto comercial: %1. Seleccione los objetos comerciales que desea importar'; ka = 'ვერ მოიძებნა სავაჭრო ობიექტი: %1. აირჩიეთ საცალო ობიექტების იმპორტი'; kk = 'Сауда объектісін табу мүмкін болмады: %1. Импорттау үшін сауда нысандарын таңдаңыз'; ro = 'Nu am găsit o unitate de cumpărături: %1. Selectați facilitățile de vânzare cu amănuntul de importat'; tr = 'Ticaret nesnesi bulunamadı: %1. İçe aktarılacak satış nesnelerini seçin'; uk = 'Не вдалося знайти торговий об''єкт: %1. Виберіть торгові об''єкти для імпорту'; uz = 'Xarid qilish imkoniyati topilmadi: %1. Import qilish uchun savdo ob''ektlarini tanlang'");
			пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, УзелНастройки.Наименование);
			ДобавитьЗаписьОшибки(пСообщение, ИмяНастройки, ID_Узла);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеИмпорт = НайтиЗначениеНастройки(ЗначенияИмпорт, ИмяНастройки, ID_Узла);
	
	// Поиск строк в сохраненных настройках SMARTS. Нужно чтобы не затереть уже сохраненные настройки в MS
	КлючиОтбора = _ЛокКонтекст.ЛокЯдро_ПолучитьКлючиУникальностиТабличныхНастроек(ИмяНастройкиБезУзла);
	Если КлючиОтбора <> "" Тогда
		
		ПараметрыОтбора = Новый Структура("ЛевоеПоле, ПравоеПоле", КлючиОтбора, "Ид");
		ВыбранныеЗначенияИмпорт = ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ЗначениеИмпорт, ПараметрыОтбора);
		Если НЕ ТипЗнч(ВыбранныеЗначенияИмпорт) = Тип("Массив") Тогда
			Возврат;
		КонецЕсли;
		
		// Проверка на наличие БП в базе или импортируемых настройках
		Если ИмяНастройкиБезУзла =  "НастройкиБизнесПроцессов_ПользовательскиеНастройки"
			ИЛИ _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройкиБезУзла, "НастройкиОтборовУзлов") Тогда
			ОтобранныеЗначения = Новый Массив;
			Для каждого СтрокаНастройки Из ВыбранныеЗначенияИмпорт Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					ОтобранныеЗначения.Добавить(СтрокаНастройки);
				ИначеЕсли ИдБизнесПроцессов.Найти(СтрокаНастройки.ID_БизнесПроцесса) = Неопределено Тогда
					НазваниеБП = ТаблицаБизнесПроцессов.НайтиСтроки(Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса))[0].Название;
					пСообщение = НСтр("ru = 'Не удалось найти бизнес-процесс: %1. Выберите бизнес-процессы для импорта';
										|en = 'Couldn''t find the business process: %1. Select the business processes to import';
										|be = 'Не ўдалося знайсці бізнес-працэс: %1. Выберыце бізнес-працэсы для імпарту'; es = 'No se pudo encontrar el proceso de negocio: %1. Seleccione los procesos de negocio para importar'; ka = 'ვერ მოიძებნა ბიზნეს პროცესი: %1. აირჩიეთ ბიზნეს პროცესების იმპორტი'; kk = 'Бизнес-процесті табу мүмкін болмады: %1. Импорттау үшін бизнес-процестерді таңдаңыз'; ro = 'Nu am putut găsi procesul de afaceri: %1. Selectați procesele de afaceri de importat'; tr = 'İş süreci bulunamadı: %1. İçe aktarılacak iş süreçlerini seçin'; uk = 'Не вдалося знайти бізнес-процес: %1. Виберіть бізнес-процеси для імпорту'; uz = 'Ish jarayoni topilmadi: %1. Import qilish uchun biznes jarayonlarini tanlang'");
					пСообщение = _ЛокКонтекст.ЛокЯдро_СтрШаблон(пСообщение, НазваниеБП);
					ДобавитьЗаписьОшибки(пСообщение, ИмяНастройки, СтрокаНастройки.ID_БизнесПроцесса);
				Иначе
					ОтобранныеЗначения.Добавить(СтрокаНастройки);
				КонецЕсли;
			КонецЦикла;
			ВыбранныеЗначенияИмпорт = ОтобранныеЗначения;
		КонецЕсли;
		
		Если НЕ _ЛокКонтекст.ЛокЯдро_МассивСтруктурСодержитЭлементы(ВыбранныеЗначенияИмпорт) Тогда
			Возврат;
		КонецЕсли;
		
		// Сохраняем импортированные ИД узлов и БП для последующей проверки наличия
		Если ИмяНастройкиБезУзла = "Узлы" Тогда
			Для каждого СтрокаНастройки Из ВыбранныеЗначенияИмпорт Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;	
				ИдУзлов.Добавить(СтрокаНастройки.ID_Узла);
			КонецЦикла;
		ИначеЕсли ИмяНастройкиБезУзла = "НастройкиБизнесПроцессов_ПоУмолчанию" ИЛИ ИмяНастройкиБезУзла = "НастройкиБизнесПроцессов_Пользовательские" Тогда
			Для каждого СтрокаНастройки Из ВыбранныеЗначенияИмпорт Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;	
				ИдБизнесПроцессов.Добавить(СтрокаНастройки.ID_БизнесПроцесса);
			КонецЦикла;
		КонецЕсли;
		
		ЗначениеИмпорт = ВыбранныеЗначенияИмпорт;
		
	КонецЕсли;
	
	Если ID_Узла <> "" Тогда
		СтруктураЗначенияУзла = Неопределено;
		ВыбранныеЗначенияНастроек.Свойство(ИмяНастройки, СтруктураЗначенияУзла);
		СтруктураЗначенияУзла = ?(СтруктураЗначенияУзла = Неопределено, Новый Структура, СтруктураЗначенияУзла);
		СтруктураЗначенияУзла.Вставить(ID_Узла, ЗначениеИмпорт);
		ВыбранныеЗначенияНастроек.Вставить(ИмяНастройки, СтруктураЗначенияУзла);
	Иначе
		ВыбранныеЗначенияНастроек.Вставить(ИмяНастройкиБезУзла, ЗначениеИмпорт);
	КонецЕсли;
	
	Если ВыбранныеИдУзлов.Найти(ID_Узла) = Неопределено Тогда
		ВыбранныеИдУзлов.Добавить(ID_Узла);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеВыбранныхДетальныхЗаписей(СтрокаДерева, ИсточникДанных, ПараметрыОтбора)
	
	Если НЕ ТипЗнч(ИсточникДанных) = Тип("Массив") 
		ИЛИ ИсточникДанных.Количество() = 0 Тогда
		Возврат ИсточникДанных;
	КонецЕсли;
	
	Если НЕ СтрокаДерева.ИзменениеДетальныхЗаписей Тогда
		Возврат ИсточникДанных;
	КонецЕсли;
	
	МассивРезультат = Новый Массив;
	
	СтрокаКолонок = ИсточникДанных[0];
	Если СтрокаКолонок.Свойство("ЭтоТаблицаЗначений") И СтрокаКолонок.ЭтоТаблицаЗначений Тогда
		МассивРезультат.Добавить(СтрокаКолонок);
	КонецЕсли;
	
	ДетальныеЗаписи	= ПолучитьЭлементыСтроки(СтрокаДерева);
	Для каждого ДетальнаяЗапись Из ДетальныеЗаписи Цикл
		
		Если НЕ ДетальнаяЗапись.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура(ПараметрыОтбора.ЛевоеПоле, ДетальнаяЗапись[ПараметрыОтбора.ПравоеПоле]);
		РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(ИсточникДанных, СтруктураОтбора, Истина);
		Если РезультатПоиска <> Неопределено Тогда
			МассивРезультат.Добавить(РезультатПоиска);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьИменаВыбранныхНастроек(СтрокиДерева)
	
	Отбор = Новый Структура("Использовать", Истина);
	НайденныеСтроки = НайтиСтрокиДереваПоОтбору(СтрокиДерева, Отбор);
	
	ИменаНастроек = Новый Структура;
	Для каждого СтрокаДерева Из НайденныеСтроки Цикл
		Если СтрокаДерева.ТипСтроки = "Файл" Тогда
			ИменаНастроек.Вставить(СтрокаДерева.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ИменаНастроек.Вставить("Узлы");
	ИменаНастроек.Вставить("ОбщаяСтруктураБизнесПроцессов");
	
	// Выбираем связанные настройки
	Если ИменаНастроек.Свойство("ОбщаяСтруктураБизнесПроцессов") Тогда
		ИменаНастроек.Вставить("НастройкиБизнесПроцессов_ПоУмолчанию");
		ИменаНастроек.Вставить("НастройкиБизнесПроцессов_Пользовательские");
		ИменаНастроек.Вставить("НастройкиБизнесПроцессов_ПользовательскиеНастройки");
		ИменаНастроек.Удалить("ОбщаяСтруктураБизнесПроцессов");
	КонецЕсли;
	Если ИменаНастроек.Свойство("ПроизвольныеКоды") Тогда
		ИменаНастроек.Вставить("ПроизвольныеКоды_ПоУмолчанию");
		ИменаНастроек.Вставить("ПроизвольныеКоды_Пользовательские");
		ИменаНастроек.Удалить("ПроизвольныеКоды");
	КонецЕсли;
	
	Возврат ИменаНастроек;
	
КонецФункции

&НаКлиенте
Функция НайтиЗначениеНастройки(ЗначенияНастроек, ИмяНастройки, ID_Узла = "")
	
	Если НЕ ЗначенияНастроек.Свойство(ИмяНастройки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеНастройки = ЗначенияНастроек[ИмяНастройки];
	Если ID_Узла <> "" И _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройки, "_Узлы")  Тогда
		ПоискЗначения = Неопределено;
		Для каждого ЗначениеУзла Из ЗначениеНастройки Цикл
			Если ЗначениеУзла.Ключ = ID_Узла Тогда
				ПоискЗначения = ЗначениеУзла.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЗначениеНастройки = ПоискЗначения;
	КонецЕсли;
	
	Возврат ЗначениеНастройки;
	
КонецФункции 

#КонецОбласти

#Область ЗаполнениеДереваНастроек

&НаКлиенте
Процедура ЗаполнитьТаблицуНастроекНаКлиенте(ДанныеНастроек, МетаданныеНастроек)
	
	ВерсияНастроек = ДанныеНастроек.ДатаНастроек;
	
	ЗначенияНастроек = ДанныеНастроек.Значения;
	
	ЗаполнитьТаблицуУзлов(ЗначенияНастроек);
	
	НомерСтроки = 0;
	Для Каждого СтрокаНастройки Из ЗначенияНастроек.ОбщаяСтруктураБизнесПроцессов Цикл
		Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаБизнесПроцессов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
		НомерСтроки = НомерСтроки + 1;
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.Синоним = "" + НомерСтроки + ". " + НоваяСтрока.Название;
		
		Если СтрокаНастройки.Свойство("ЭтоТиповойБизнесПроцесс") И СтрокаНастройки.ЭтоТиповойБизнесПроцесс = Истина Тогда
			Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
				НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументТолькоПросмотр;		
			Иначе
				НоваяСтрока.Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			КонецЕсли;
		Иначе
			Если СтрокаНастройки.Свойство("ПользовательскаяНастройка") И СтрокаНастройки.ПользовательскаяНастройка = Истина Тогда
				НоваяСтрока.Картинка = БиблиотекаКартинок.Изменить;		
			Иначе
				НоваяСтрока.Картинка = БиблиотекаКартинок.Пользователь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьТаблицуНастроекНаСервере(ДанныеНастроек, МетаданныеНастроек);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуУзлов(ЗначенияНастроек)
	
	// Заполнение торговых объектов
	ТаблицаУзлов.Очистить();
	Если ЗначенияНастроек.ЕстьУзлы Тогда
		Для Каждого СтрокаУзла Из ЗначенияНастроек.Узлы Цикл
			Если ТипЗнч(СтрокаУзла) = Тип("Структура") И СтрокаУзла.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;	
			НоваяСтрока = ТаблицаУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУзла);
		КонецЦикла;
	КонецЕсли;
	ЕстьУзлы = ТаблицаУзлов.Количество() > 0;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицуНастроекНаСервере(ДанныеНастроек, МетаданныеНастроек)
	
	МетаданныеСписокНастроек = МетаданныеНастроек.СписокНастроек;
	КлючиПервыхСтрок = МетаданныеНастроек.КлючиПервыхСтрок;	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ЛокДеревоНастроек = ДеревоНастроек.Скопировать();
	#Иначе
		ЛокДеревоНастроек = РеквизитФормыВЗначение("ДеревоНастроек");
	#КонецЕсли
	
	ЛокДеревоНастроек.Строки.Очистить();
	
	ДополнительныеПараметры = Новый Структура("ДанныеНастроек, МетаданныеСписокНастроек", ДанныеНастроек, МетаданныеСписокНастроек);
	Для каждого КлючНастройки Из КлючиПервыхСтрок Цикл
		ДобавитьСтрокиНастроекРекурсивно(ЛокДеревоНастроек.Строки, КлючНастройки, МетаданныеСписокНастроек, ДополнительныеПараметры);
	КонецЦикла;
	
	УстановитьКартинкиРекурсивно(ЛокДеревоНастроек.Строки);
	ЗадатьПризнакРодителяРекурсивно(ЛокДеревоНастроек.Строки);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ДеревоНастроек = ЛокДеревоНастроек;
	#Иначе
		ЗначениеВРеквизитФормы(ЛокДеревоНастроек, "ДеревоНастроек");
	#КонецЕсли
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьСтрокиНастроекРекурсивно(СтрокиДерева, КлючНастройки, МетаданныеНастроек, ДополнительныеПараметры = Неопределено)
	
	МетаданныеНастройки = МетаданныеНастроек[КлючНастройки];
	
	СтрокаДерева = СтрокиДерева.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДерева, МетаданныеНастройки);
	
	Если РежимОбмена = "Копирование" Тогда
		СтрокаДерева.ID_Узла = ?(ИдУзлаИсточник = ПолучитьДанныеГлавногоУзла().Идентификатор, "", ИдУзлаИсточник);
	КонецЕсли;
	
	ДобавитьДетальныеЗаписиНастроек(СтрокаДерева.Строки, МетаданныеНастройки, ДополнительныеПараметры);
	
	Если МетаданныеНастройки.ЭтоРодитель Тогда
		
		Для каждого ТекМетаданные Из МетаданныеНастроек Цикл
			ТекМетаданные = ТекМетаданные.Значение;
			Если ТекМетаданные.Родитель <> Неопределено
				И ТекМетаданные.Родитель.Имя = КлючНастройки Тогда
				ДобавитьСтрокиНастроекРекурсивно(СтрокаДерева.Строки, ТекМетаданные.Имя, МетаданныеНастроек, ДополнительныеПараметры);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьДетальныеЗаписиНастроек(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры = Неопределено)
	
	ЗначенияНастроек = ДополнительныеПараметры.ДанныеНастроек.Значения;
	МетаданныеСписокНастроек = ДополнительныеПараметры.МетаданныеСписокНастроек;
	
	ИмяНастройки 					= МетаданныеНастройки.Имя;
	ИмяНастройкиБезДЗ 				= СтрЗаменить(ИмяНастройки, "_ДЗ", "");
	ИмяНастройкиСДЗ 				= ИмяНастройкиБезДЗ + "_ДЗ";
	ID_Узла		 					= СтрокиДерева.Родитель.ID_Узла;
	
	Если РежимОбмена = "Копирование" Тогда
		ИмяНастройкиБезРасширения = СтрЗаменить(ИмяНастройкиБезДЗ, "_Узлы", "");
	Иначе
		ИмяНастройкиБезРасширения = СтрЗаменить(ИмяНастройки, "_Узлы_ДЗ", "");
	КонецЕсли;
	
	ЗначениеНастройки = Ложь;
	Если ЗначенияНастроек.Свойство(ИмяНастройкиБезДЗ) Тогда
		ЗначениеНастройки = ЗначенияНастроек[ИмяНастройкиБезДЗ];
		Если МетаданныеНастройки.ЭтоДетальныеЗаписиУзлов
			И ТипЗнч(ЗначениеНастройки) = Тип("Структура")
			И ЗначениеНастройки.Свойство(ID_Узла) Тогда
			ЗначениеНастройки = ЗначениеНастройки[ID_Узла];
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяНастройки = "Узлы" Тогда
		
		Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаУзла.Наименование;
			ДетальнаяЗапись.Ид						= СтрокаУзла.ID_Узла;
			ДетальнаяЗапись.ID_Узла					= СтрокаУзла.ID_Узла;
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройки = "ОбщаяСтруктураБизнесПроцессов" Тогда
		
		Для каждого СтрокаНастройки Из ТаблицаБизнесПроцессов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаНастройки.Синоним;
			ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
			ДетальнаяЗапись.ID_Узла					= "";
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиБизнесПроцессов_ПользовательскиеНастройки" Тогда
		
		Для каждого СтрокаНастройки Из ТаблицаБизнесПроцессов Цикл
			ДетальнаяЗапись = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
			ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
			ДетальнаяЗапись.Синоним				= СтрокаНастройки.Синоним;
			ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
			ДетальнаяЗапись.ID_Узла					= ID_Узла;
			ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
			ДетальнаяЗапись.Использовать			= Ложь;
			ДетальнаяЗапись.Доступность			= Истина;
		КонецЦикла;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников" ИЛИ ИмяНастройкиБезРасширения = "НастройкиОбменаСправочников_Узлы" И МетаданныеНастройки.ТипСтроки <> "Группа"  Тогда
		
		Если РежимОбмена = "Копирование" 
			И ИдУзлаИсточник <> ""
			И ИдУзлаИсточник <> ПолучитьДанныеГлавногоУзла().Идентификатор Тогда
			ЗначениеНастройки = ЗначенияНастроек.НастройкиОбменаСправочников_Узлы[ИдУзлаИсточник];
		Иначе
			ЗначениеНастройки = ЗначенияНастроек[ИмяНастройкиБезДЗ];
			Если ИмяНастройкиСДЗ = "НастройкиОбменаСправочников_Узлы_ДЗ" Тогда
				ЗначениеНастройки = ЗначениеНастройки[ID_Узла];
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.ИмяТаблицыПредставление;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ИмяТаблицы;
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ?(СтрокаНастройки.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
				
			КонецЦикла;
		КонецЕсли;
			
	ИначеЕсли ИмяНастройки = "ПроизвольныеКоды" Тогда
		
		Если ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию <> Ложь И ЗначениеЗаполнено(ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию) Тогда
			Для каждого СтрокаНастройки Из ЗначенияНастроек.ПроизвольныеКоды_ПоУмолчанию Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоКода;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначенияНастроек.ПроизвольныеКоды_Пользовательские <> Ложь И ЗначениеЗаполнено(ЗначенияНастроек.ПроизвольныеКоды_Пользовательские) Тогда
			Для каждого СтрокаНастройки Из ЗначенияНастроек.ПроизвольныеКоды_Пользовательские Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоКода;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= БиблиотекаКартинок.Пользователь;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяНастройки = "ПроизвольныеОтборыДокументов" Тогда
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_ПроизвольногоОтбора;
				ДетальнаяЗапись.ID_Узла					= "";
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяНастройкиБезРасширения = "ГлобальныеПараметры_Значения" Тогда
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= СтрокаНастройки.Наименование;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_Параметра;
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ?(НЕ СтрокаНастройки.Свойство("Типовой") ИЛИ СтрокаНастройки.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЛокЯдро_СтрНайтиНаСервере(ИмяНастройки, "НастройкиОтборовУзлов") И МетаданныеНастройки.ТипСтроки <> "Группа" Тогда
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
				Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
					Продолжить;
				КонецЕсли;
				
				ПоискБП = ТаблицаБизнесПроцессов.НайтиСтроки(Новый Структура("ID_БизнесПроцесса", СтрокаНастройки.ID_БизнесПроцесса));
				Если НЕ ПоискБП.Количество() Тогда
					Продолжить;
				КонецЕсли;
				ПоискБП = ПоискБП[0];
				
				ДетальнаяЗапись = СтрокиДерева.Добавить();
				ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
				ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
				ДетальнаяЗапись.Синоним				= ПоискБП.Синоним;
				ДетальнаяЗапись.Ид						= СтрокаНастройки.ID_БизнесПроцесса;
				ДетальнаяЗапись.ID_Узла					= ID_Узла;
				ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
				ДетальнаяЗапись.Использовать			= Ложь;
				ДетальнаяЗапись.Доступность			= Истина;
				ДетальнаяЗапись.Картинка 				= ПоискБП.Картинка;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЛокЯдро_СтрНайтиНаСервере(ИмяНастройки, "НастройкиОтборовСправочников") И МетаданныеНастройки.ТипСтроки <> "Группа" Тогда
		
		Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			ЗначениеНастройки = ЗначенияНастроек.НастройкиОбменаСправочников;
			Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
				Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
					Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					
					ДетальнаяЗапись = СтрокиДерева.Добавить();
					ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, СтрокаНастройки);
					ДетальнаяЗапись.Имя						= ИмяНастройкиСДЗ;
					ДетальнаяЗапись.Синоним					= СтрокаНастройки.ИмяТаблицыПредставление;
					ДетальнаяЗапись.Ид						= СтрокаНастройки.ИмяТаблицы;
					ДетальнаяЗапись.ID_Узла					= ID_Узла;
					ДетальнаяЗапись.ТипСтроки				= "ДетальнаяЗапись";
					ДетальнаяЗапись.Использовать			= Ложь;
					ДетальнаяЗапись.Доступность				= Истина;
					ДетальнаяЗапись.Картинка 				= ?(СтрокаНастройки.Типовой, БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки, БиблиотекаКартинок.Пользователь);
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли МетаданныеНастройки.ТребуютсяТО Тогда
		ДобавитьДетальныеЗаписиТорговыхОбъектов(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьДетальныеЗаписиТорговыхОбъектов(СтрокиДерева, МетаданныеНастройки, ДополнительныеПараметры = Неопределено)
	
	Если НЕ ТаблицаУзлов.Количество() Тогда
		СтрокиДерева.Родитель.Доступность = Ложь;
	КонецЕсли;
	
	ИмяСтроки = МетаданныеНастройки.Имя;
	ИмяСтрокиБезРасширения = СтрЗаменить(ИмяСтроки, "_Общий", "");
	ТипСтроки = "Файл";
	//ТипСтроки = ?(ИмяСтроки = "НастройкиОбменаСправочников_Общий_Узлы", "Группа", "Файл");
	
	Для каждого СтрокаУзла Из ТаблицаУзлов Цикл
		ДетальнаяЗапись = СтрокиДерева.Добавить();
		ДетальнаяЗапись.Имя						= ИмяСтроки;
		ДетальнаяЗапись.Синоним				= СтрокаУзла.Наименование;
		ДетальнаяЗапись.Ид						= СтрокаУзла.ID_Узла;
		ДетальнаяЗапись.ID_Узла					= СтрокаУзла.ID_Узла;
		ДетальнаяЗапись.ТипСтроки				= ТипСтроки;
		ДетальнаяЗапись.Использовать			= Ложь;
		ДетальнаяЗапись.Доступность			= Истина;
		
		МетаданныеНастройки_ДЗ = ПолучитьСтруктуруМетаданныхНастроек();
		МетаданныеНастройки_ДЗ.Имя				= ИмяСтрокиБезРасширения + "_ДЗ";
		МетаданныеНастройки_ДЗ.Синоним			= "";
		МетаданныеНастройки_ДЗ.ТипСтроки		= "ДетальнаяЗапись";
		МетаданныеНастройки_ДЗ.ТребуютсяТО		= Ложь;
		МетаданныеНастройки_ДЗ.ЭтоРодитель		= Ложь;
		МетаданныеНастройки_ДЗ.ЭтоДетальныеЗаписиУзлов		= Истина;
		
		ДобавитьДетальныеЗаписиНастроек(ДетальнаяЗапись.Строки, МетаданныеНастройки_ДЗ, ДополнительныеПараметры);
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьЗначениеРодителейВДеревоРекурсивно(ПодчиненнаяСтрока, ИмяПоля, Значение, ПервоеВхождение = Истина)
	
	Родитель = ПолучитьРодителяСтроки(ПодчиненнаяСтрока);
	Если Родитель <> Неопределено Тогда
		УстановитьЗначениеРодителейВДеревоРекурсивно(Родитель, ИмяПоля, Значение, Ложь);
	КонецЕсли;
	
	Если НЕ ПервоеВхождение Тогда
		ПодчиненнаяСтрока[ИмяПоля] = Значение;		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗадатьПризнакРодителяРекурсивно(СтрокиДерева)
	Для каждого ТекСтрока Из СтрокиДерева Цикл
		Если ТекСтрока.ТипСтроки = "Группа"
			ИЛИ ТекСтрока.Строки.Количество() Тогда
			ТекСтрока.ЭтоРодитель = Истина;
			ЗадатьПризнакРодителяРекурсивно(ТекСтрока.Строки);
		Иначе
			ТекСтрока.ЭтоРодитель = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

&НаСервере
Процедура УстановитьКартинкиРекурсивно(СтрокиДерева)
	
	Для каждого ТекСтрока Из СтрокиДерева Цикл
		УстановитьКартинкуСтроки(ТекСтрока);
		УстановитьКартинкиРекурсивно(ТекСтрока.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКартинкуСтроки(СтрокаДерева)
	
	Картинка = Неопределено;
	Если СтрокаДерева.Картинка <> Неопределено Тогда
		Картинка = СтрокаДерева.Картинка;
	ИначеЕсли СтрокаДерева.ТипСтроки = "Группа" Тогда
		Картинка = КартинкаПапки;
	ИначеЕсли СтрокаДерева.ТипСтроки = "Файл" Тогда
		Картинка = БиблиотекаКартинок.Задача;
	ИначеЕсли СтрокаДерева.ТипСтроки = "ДетальнаяЗапись" Тогда
		Картинка = БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки;
	КонецЕсли;
	СтрокаДерева.Картинка = Картинка;
	
КонецПроцедуры

&НаКлиенте
Функция ВыбратьСвязанныеЭлементыНастроек(ДанныеСтроки)
	
	СвязанныеЭлементыВыбраны = Ложь;
	
	Родитель 							= ПолучитьРодителяСтроки(ДанныеСтроки);
	ИмяНастройки 					= ДанныеСтроки.Имя;
	ИмяНастройкиБезДЗ 				= СтрЗаменить(ИмяНастройки, "_ДЗ", "");
	ИмяНастройкиСДЗ 				= ИмяНастройкиБезДЗ + "_ДЗ";
	ИмяНастройкиБезРасширения 	= СтрЗаменить(ИмяНастройки, "_Узлы_ДЗ", "");
	
	Если ДанныеСтроки.Использовать Тогда
		
		Если ИмяНастройки = "ОбщаяСтруктураБизнесПроцессов"
			ИЛИ ИмяНастройки = "НастройкиБП_Общий" Тогда
			УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Имя", "Равно", "ГлобальныеПараметры_Значения_ДЗ");
			УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Имя", "Равно", "ПроизвольныеКоды_ДЗ");
			СвязанныеЭлементыВыбраны = Истина;
		ИначеЕсли ИмяНастройки = "ОбщаяСтруктураБизнесПроцессов_ДЗ" Тогда
			
			СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
			
			НастройкаБП = Неопределено;
			
			// Поиск настройки БП в типовых
			НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.Значения.НастройкиБизнесПроцессов_ПоУмолчанию);
			Если НастройкаБП = Неопределено И ТипЗнч(НастройкиБизнесПроцессов) = Тип("Массив") Тогда
				Для каждого СтрокаНастройки Из НастройкиБизнесПроцессов Цикл
					Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					Если СтрокаНастройки.ID_БизнесПроцесса = ДанныеСтроки.Ид Тогда
						НастройкаБП = СтрокаНастройки;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Поиск настройки БП в пользовательских
			НастройкиБизнесПроцессов = _ЛокКонтекст.ЛокЯдро_ПолучитьМассивНастроекБизнесПроцессовИзСтруктуры(СтруктураНастроек.Значения.НастройкиБизнесПроцессов_Пользовательские);
			Если НастройкаБП = Неопределено И ТипЗнч(НастройкиБизнесПроцессов) = Тип("Массив") Тогда
				Для каждого СтрокаНастройки Из НастройкиБизнесПроцессов Цикл
					Если СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					КонецЕсли;
					Если СтрокаНастройки.ID_БизнесПроцесса = ДанныеСтроки.Ид Тогда
						НастройкаБП = СтрокаНастройки;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			СвязанныеЭлементыИдентификаторы = Новый Массив;
			Если НастройкаБП.Свойство("ID_ПроизвольногоКода_Выгрузка_Документ") Тогда
				СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.ID_ПроизвольногоКода_Выгрузка_Документ);
			КонецЕсли;
			
			Если НастройкаБП.Свойство("ID_ПроизвольногоКода_Загрузка_Документ") Тогда
				СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.ID_ПроизвольногоКода_Загрузка_Документ);
			КонецЕсли;
			
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПередВыгрузкойДокумента);
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПередЗаполнениемДокумента);
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПослеВыгрузкиДокумента);
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПослеЗаполненияДокумента);
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПослеОткрытияФормыДокумента);
			СвязанныеЭлементыИдентификаторы.Добавить(НастройкаБП.Обработчик_ПослеОтправкиДокумента);
			
			ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, НастройкаБП.НастройкаВыгрузкиПолей);
			ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, НастройкаБП.НастройкаЗагрузкиПолей);
			
			Если ТипЗнч(НастройкаБП.НастройкаВыгрузкиТЧ) = Тип("Массив") Тогда
				Для каждого НастройкаТЧ Из НастройкаБП.НастройкаВыгрузкиТЧ Цикл
					Если НастройкаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					ИначеЕсли НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1С") Тогда
						ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, НастройкаТЧ.ТабличнаяЧастьДокумента1С);
					ИначеЕсли НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						РеквизитыТЧ = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаТЧ.ТабличнаяЧастьДокумента1ССтрокой);
						ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, РеквизитыТЧ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ТипЗнч(НастройкаБП.НастройкаЗагрузкиТЧ) = Тип("Массив") Тогда
				Для каждого НастройкаТЧ Из НастройкаБП.НастройкаЗагрузкиТЧ Цикл
					Если НастройкаТЧ.Свойство("ЭтоТаблицаЗначений") Тогда
						Продолжить;
					ИначеЕсли НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1С") Тогда
						ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, НастройкаТЧ.ТабличнаяЧастьДокумента1С);
					ИначеЕсли НастройкаТЧ.Свойство("ТабличнаяЧастьДокумента1ССтрокой") Тогда
						РеквизитыТЧ = _ЛокКонтекст.ЛокЯдро_ЗначениеИзСтрокиXML(НастройкаТЧ.ТабличнаяЧастьДокумента1ССтрокой);
						ПолучитьИдентификаторыПоРеквизитам(СвязанныеЭлементыИдентификаторы, РеквизитыТЧ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Для каждого Идентификатор Из СвязанныеЭлементыИдентификаторы Цикл
				Если НЕ ЗначениеЗаполнено(Идентификатор) ИЛИ Идентификатор = Ложь Тогда
					Продолжить;
				КонецЕсли;
				УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Ид", "Равно", Идентификатор);
				СвязанныеЭлементыВыбраны = Истина;
			КонецЦикла;
			
		ИначеЕсли ИмяНастройки = "ПользователиТСД_Узлы" Тогда
			УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Имя", "Равно", "Пользователи");
		ИначеЕсли _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройки, "НастройкиОтборовСправочников") Тогда	
			
			Если ДанныеСтроки.ТипСтроки = "Файл"
				ИЛИ ДанныеСтроки.ТипСтроки = "Группа" Тогда
				УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Имя", "Равно", "НастройкиОбменаСправочников_ДЗ");
				СвязанныеЭлементыВыбраны = Истина;
			ИначеЕсли ДанныеСтроки.ТипСтроки = "ДетальнаяЗапись" Тогда
				
				Отбор = Новый Структура("Имя, Ид", "НастройкиОбменаСправочников_ДЗ", ДанныеСтроки.Ид);
				СтрокаРодитель = НайтиСтрокиДереваПоОтбору(ПолучитьЭлементыСтроки(ДеревоНастроек), Отбор, Истина);
				Если СтрокаРодитель <> Неопределено Тогда
					СтрокаРодитель.Использовать = Истина;
					СвязанныеЭлементыВыбраны = Истина;
				КонецЕсли;
 				
			КонецЕсли;
			
		ИначеЕсли _ЛокКонтекст.ЛокЯдро_СтрНайти(ИмяНастройки, "НастройкиОтборовУзлов") Тогда
			
			Если ДанныеСтроки.ТипСтроки = "Файл"
				ИЛИ ДанныеСтроки.ТипСтроки = "Группа" Тогда
				УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Имя", "Равно", "ПроизвольныеОтборыДокументов_ДЗ");
				СвязанныеЭлементыВыбраны = Истина;
			ИначеЕсли ДанныеСтроки.ТипСтроки = "ДетальнаяЗапись" Тогда
				
				СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресДанныхНастроек);
				ЗначениеНастройки = СтруктураНастроек.Значения[ИмяНастройкиБезДЗ];
				Если ДанныеСтроки.ID_Узла <> "" Тогда
					ЗначениеНастройки = ЗначениеНастройки[ДанныеСтроки.ID_Узла];
				КонецЕсли;
				
				СвязанныеЭлементыИдентификаторы = Новый Массив;
				
				Если ЗначениеНастройки <> Ложь И ЗначениеЗаполнено(ЗначениеНастройки) Тогда
					Для каждого СтрокаНастройки Из ЗначениеНастройки Цикл
						Если ТипЗнч(СтрокаНастройки) = Тип("Структура") И СтрокаНастройки.Свойство("ЭтоТаблицаЗначений") Тогда
							Продолжить;
						ИначеЕсли ДанныеСтроки.Ид = СтрокаНастройки.ID_БизнесПроцесса Тогда
							НастройкаОтбора = СтрокаНастройки;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если (НастройкаОтбора.ВариантОтбора = "Только запрос"
						ИЛИ НастройкаОтбора.ВариантОтбора = "Конструктор и запрос")
						И НастройкаОтбора.Свойство("ID_ПроизвольногоОтбора") Тогда
						СвязанныеЭлементыИдентификаторы.Добавить(НастройкаОтбора.ID_ПроизвольногоОтбора);
					КонецЕсли;
					
				КонецЕсли;
				
				Для каждого Идентификатор Из СвязанныеЭлементыИдентификаторы Цикл
					Если НЕ ЗначениеЗаполнено(Идентификатор) ИЛИ Идентификатор = Ложь Тогда
						Продолжить;
					КонецЕсли;
					УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ДеревоНастроек), "Использовать", Истина, "Ид", "Равно", Идентификатор);
					СвязанныеЭлементыВыбраны = Истина;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СвязанныеЭлементыВыбраны;
	
КонецФункции 

&НаКлиенте
Процедура ПолучитьИдентификаторыПоРеквизитам(МассивЗаполнения, МассивРеквизитов)
	
	Если ТипЗнч(МассивРеквизитов) = Тип("Массив") Тогда
		
		Для каждого НастройкаПоля Из МассивРеквизитов Цикл
			Если НастройкаПоля.Свойство("ЭтоТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
			Если НастройкаПоля.ТипИсточника = "ПроизвольныйКод"
				ИЛИ НастройкаПоля.ТипИсточника = "ГлобальныйПараметр" Тогда
				МассивЗаполнения.Добавить(НастройкаПоля.ИмяИсточника);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСДеревомЗначений

&НаКлиенте
Процедура УстановитьЗначениеВДеревоРекурсивно(СтрокиДерева, ИмяПоля, Значение)
	Для каждого ТекСтрока Из СтрокиДерева Цикл
		ТекСтрока[ИмяПоля] = Значение;
		УстановитьЗначениеВДеревоРекурсивно(ПолучитьЭлементыСтроки(ТекСтрока), ИмяПоля, Значение);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеВДеревоПоУсловию(СтрокиДерева, ИмяПриемника, НовоеЗначение, ПолеСравнения, Условие, ПравоеЗначение, ВыбиратьСвязанные = Ложь)
	
	Для каждого ТекСтрока Из СтрокиДерева Цикл	
		УстановитьЗначениеВДеревоПоУсловию(ПолучитьЭлементыСтроки(ТекСтрока), ИмяПриемника, НовоеЗначение, ПолеСравнения, Условие, ПравоеЗначение, ВыбиратьСвязанные);	
		ЛевоеЗначение = ТекСтрока[ПолеСравнения];
		Если Условие = "Равно" Тогда
			Если НЕ ЛевоеЗначение = ПравоеЗначение Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		ТекСтрока[ИмяПриемника] = НовоеЗначение;
		
		Если ВыбиратьСвязанные Тогда
			ВыбратьСвязанныеЭлементыНастроек(ТекСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПервогоРодителяСтроки(СтрокаДереваЗначений)
	
	Родитель = ПолучитьРодителяСтроки(СтрокаДереваЗначений);
	Если Родитель <> Неопределено Тогда
		Возврат ПолучитьПервогоРодителяСтроки(Родитель);
	Иначе
		Возврат СтрокаДереваЗначений;
	КонецЕсли;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьЭлементыСтроки(СтрокаДерева)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат СтрокаДерева.Строки;
	#Иначе
		Возврат СтрокаДерева.ПолучитьЭлементы();
	#КонецЕсли
КонецФункции 

&НаКлиенте
Функция ПолучитьРодителяСтроки(СтрокаДерева)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Возврат СтрокаДерева.Родитель;
	#Иначе
		Возврат СтрокаДерева.ПолучитьРодителя();
	#КонецЕсли
КонецФункции

&НаКлиенте
Функция НайтиСтрокиДереваПоОтбору(СтрокиДерева, Отбор, ВернутьПервоеЗначение = Ложь)
	
	Результат = ?(ВернутьПервоеЗначение, Неопределено, Новый Массив);
	Для каждого ТекСтрока Из СтрокиДерева Цикл	
		
		Совпадает = Истина;
		Для каждого КлючЗначение Из Отбор Цикл
			Если НЕ ТекСтрока[КлючЗначение.Ключ] = КлючЗначение.Значение Тогда
				Совпадает = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Совпадает Тогда
			Если ВернутьПервоеЗначение Тогда
				Возврат ТекСтрока;
			Иначе
				Результат.Добавить(ТекСтрока);
			КонецЕсли;
		КонецЕсли;
		
		РезультатРекурсии = НайтиСтрокиДереваПоОтбору(ПолучитьЭлементыСтроки(ТекСтрока), Отбор, ВернутьПервоеЗначение);
		Если ВернутьПервоеЗначение Тогда
			Если РезультатРекурсии <> Неопределено Тогда
				Возврат РезультатРекурсии;
			КонецЕсли;
		Иначе
			Для каждого СтрокаПодчиненная Из РезультатРекурсии Цикл
				Результат.Добавить(СтрокаПодчиненная);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

