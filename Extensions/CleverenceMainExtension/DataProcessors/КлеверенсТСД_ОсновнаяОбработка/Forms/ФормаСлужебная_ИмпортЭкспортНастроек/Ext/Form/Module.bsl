#Область УниверсальныеМеханизмы

&НаКлиенте
Функция НайтиЭлементыПоВхождениюВМассив(МассивОтбор, МассивИсточник, Знач ПараметрыОтбора, ВернутьОписаниеИсточника = Ложь)
	
	МассивРезультат = Новый Массив;
	
	Если НЕ ТипЗнч(МассивОтбор) = Тип("Массив") 
		ИЛИ МассивОтбор.Количество() = 0 Тогда
		Возврат МассивРезультат;
	КонецЕсли;
	
	Если НЕ ТипЗнч(МассивИсточник) = Тип("Массив") 
		ИЛИ МассивИсточник.Количество() = 0 Тогда
		Возврат МассивРезультат;
	КонецЕсли;
	
	Если ВернутьОписаниеИсточника Тогда
		СтрокаКолонок = МассивИсточник[0];
		Если СтрокаКолонок.Свойство("ЭтоТаблицаЗначений") И СтрокаКолонок.ЭтоТаблицаЗначений Тогда
			МассивРезультат.Добавить(СтрокаКолонок);
		КонецЕсли;
	КонецЕсли;
	
	Для каждого СтрокаМассива Из МассивОтбор Цикл
		
		Если СтрокаМассива.Свойство("ЭтоТаблицаЗначений") И СтрокаМассива.ЭтоТаблицаЗначений Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаМассива);
		РезультатПоиска = _ЛокКонтекст.ЛокЯдро_НайтиВМассивеСтруктурПоОтбору(МассивИсточник, ПараметрыОтбора, Истина);
		Если РезультатПоиска <> Неопределено Тогда
			МассивРезультат.Добавить(РезультатПоиска);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции 

&НаКлиенте
Процедура ОткрытьФормуМножественногоВыбора(ЗаголовокФормы, Описание, СписокВыбора, ОповещенияОЗакрытии)
	
	ФормаСлужебная_МножественныйВыборИзСписка = ПолучитьФормуОсновнойОбработки("ФормаСлужебная_МножественныйВыборИзСписка");
	ФормаСлужебная_МножественныйВыборИзСписка.ВнешнийСписок = СписокВыбора;
	ФормаСлужебная_МножественныйВыборИзСписка.Заголовок = ЗаголовокФормы;
	ФормаСлужебная_МножественныйВыборИзСписка.ОписаниеОповещенияОЗакрытии = ОповещенияОЗакрытии;
	ФормаСлужебная_МножественныйВыборИзСписка.Описание = Описание;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаСлужебная_МножественныйВыборИзСписка.ОткрытьМодально();
	#Иначе
		ФормаСлужебная_МножественныйВыборИзСписка.Открыть();
	#КонецЕсли
	
КонецПроцедуры 

&НаКлиенте
Функция ОбновитьПризнакИспользованияРекурсивно(СтрокиДерева)
	
	КэшРежимИспользования = -1;
	Для каждого ТекСтрока Из СтрокиДерева Цикл
		
		РежимИспользования = 0;
		Если ТекСтрока.Доступность Тогда
			Если ТекСтрока.ЭтоРодитель Тогда
				РежимИспользования = ОбновитьПризнакИспользованияРекурсивно(ПолучитьЭлементыСтроки(ТекСтрока));
			Иначе
				Если ТекСтрока.Использовать
					И ТекСтрока.ИзменениеДетальныхЗаписей Тогда
					РежимИспользования = 2;
				ИначеЕсли ТекСтрока.Использовать Тогда
					РежимИспользования = 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если КэшРежимИспользования >= 0 И КэшРежимИспользования <> РежимИспользования Тогда
			КэшРежимИспользования = 2;
		Иначе
			КэшРежимИспользования	 = Макс(КэшРежимИспользования, РежимИспользования);
		КонецЕсли;
		
		ТекСтрока.Использовать = РежимИспользования > 0;
		ТекСтрока.ИзменениеДетальныхЗаписей = РежимИспользования = 2 
														И НЕ ТекСтрока.ТипСтроки = "Группа";
		
	КонецЦикла;
	
	Возврат КэшРежимИспользования;
	
КонецФункции 

