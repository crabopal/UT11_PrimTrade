	Настройка.Синоним		= НСтр("ru = 'Глобальные параметры';
									|en = 'Global parameters'; be = 'Глабальныя параметры'; es = 'Parámetros globales'; ka = 'გლობალური პარამეტრები'; kk = 'Жаһандық параметрлер'; ro = 'Parametrii globali'; tr = 'Genel parametreler'; uk = 'Глобальні параметри'; uz = 'Global parametrlar'");
	Настройка.ТипСтроки		= "Файл";
	Настройка.ТребуютсяТО	= Ложь;
	Настройка.ЭтоРодитель	= Ложь;
	Настройка.Родитель		= Неопределено;
	Настройка.ЭтоДетальныеЗаписиУзлов = ЭтоДетальныеЗаписиУзлов;
	МетаданныеСписокНастроек.Вставить(Настройка.Имя, Настройка);
	КлючиПервыхСтрок.Добавить(Настройка.Имя);
	// } Глобальные параметры
	
	
	// Пользователи {
	Если ЭтоДетальныеЗаписиУзлов Тогда
		Настройка = ПолучитьСтруктуруМетаданныхНастроек();
		Настройка.Имя				= "ПользователиТСД_Узлы";
		Настройка.Синоним		= НСтр("ru = 'Привязанные пользователи ТСД';
										|en = 'Linked Users Mobile Device'; be = 'Прывязаныя карыстальнікі мабільнае прылада'; es = 'Usuarios atados dispositivo Móvil'; ka = 'დაკავშირებული მომხმარებლები მობილური მოწყობილობა'; kk = 'Байланысты пайдаланушылар мобильді құрылғы'; ro = 'Utilizatori Conectați Dispozitiv Mobil'; tr = 'Bağlı Kullanıcılar Mobil Cihaz'; uk = 'Прив''язані користувачі мобільний пристрій'; uz = 'Bog''langan Foydalanuvchilar Mobil Qurilma'");
		Настройка.ТипСтроки		= "Файл";
		Настройка.ТребуютсяТО	= Ложь;
		Настройка.ЭтоРодитель	= Ложь;
		Настройка.Родитель		= Неопределено;
		Настройка.ЭтоДетальныеЗаписиУзлов = ЭтоДетальныеЗаписиУзлов;
		МетаданныеСписокНастроек.Вставить(Настройка.Имя, Настройка);
		КлючиПервыхСтрок.Добавить(Настройка.Имя);
	КонецЕсли;
	// } Пользователи
	
	
	МетаданныеНастроек = Новый Структура;
	МетаданныеНастроек.Вставить("СписокНастроек", МетаданныеСписокНастроек);
	МетаданныеНастроек.Вставить("КлючиПервыхСтрок", КлючиПервыхСтрок);
	
	Возврат МетаданныеНастроек;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруМетаданныхНастроек()
	
	Настройка = Новый Структура;
	Настройка.Вставить("Имя", "");
	Настройка.Вставить("Синоним", "");
	Настройка.Вставить("ТипСтроки", "");
	Настройка.Вставить("ЭтоРодитель", Ложь);
	Настройка.Вставить("Родитель");
	Настройка.Вставить("Использовать", Ложь);
	Настройка.Вставить("Доступность", Истина);
	Настройка.Вставить("ТребуютсяТО", Ложь);
	Настройка.Вставить("ЭтоДетальныеЗаписиУзлов", Ложь);
	Настройка.Вставить("КопированиеДоступно", Истина);
	
	Возврат Настройка;
	
КонецФункции 

