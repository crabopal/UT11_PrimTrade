&После("ЗаполнитьДанныеУКД_ИнформацияПродавца")
Процедура бит_ПослеЗаполнитьДанныеУКД_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ)

	бит_ПослеЗаполненияДанныхПродавцаЭДО(Основание, Данные, Отказ, Истина);

КонецПроцедуры

&После("ЗаполнитьДанныеУПД2019_ИнформацияПродавца")
Процедура бит_ПослеЗаполнитьДанныеУПД2019_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ)

	бит_ПослеЗаполненияДанныхПродавцаЭДО(Основание, Данные, Отказ, Ложь);

КонецПроцедуры

&ИзменениеИКонтроль("ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца")
Процедура бит_ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ТипОснования = ТипЗнч(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДокументОснование"));
		Если ТипОснования = Тип("ДокументСсылка.ПервичныйДокумент") Тогда
			ТекстСообщения = НСтр("ru = 'Действие недоступно для счета-фактуры, введенного на основании ""Первичного документа"".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Возврат;
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ОтчетПоКомиссииМеждуОрганизациями") Тогда
			ТекстСообщения = НСтр("ru = 'Действие недоступно для счета-фактуры, введенного на основании ""Отчета по комиссии между организациями"".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Возврат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураКомиссионеру")
		И ТипЗнч(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДокументОснование")) = Тип("ДокументСсылка.ОтчетПоКомиссииМеждуОрганизациями") Тогда
		ТекстСообщения = НСтр("ru = 'Действие недоступно для счета-фактуры, введенного на основании ""Отчета по комиссии между организациями"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		СтатусДокументаОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Статус");
		Если СтатусДокументаОснование <> Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено Тогда
			ТекстСообщения = НСтр("ru = 'Формирование ЭД возможно только для документов в статусе ""Реализовано"".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	ОписаниеЗамера = Неопределено;
	КоличествоЗаписей = 1;

	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		СтруктураЭД.Вставить("Функция", "СЧФ");
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда
		СтруктураЭД.Вставить("Функция", "СвРК");
		ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
			"ОбщийМодуль.ОбменСКонтрагентамиУТ.ЗаполнитьСведенияОРеализацииКомиссионером");
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда
		СтруктураЭД.Вставить("Функция", "СвЗК");
		ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
			"ОбщийМодуль.ОбменСКонтрагентамиУТ.ЗаполнитьДанныеСведенияОЗакупкеКомиссионером");
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратТоваровМеждуОрганизациями") Тогда
		СтруктураЭД.Вставить("Функция", "ДОП");
		ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
			"ОбщийМодуль.ОбменСКонтрагентамиУТ.ЗаполнитьДанныеИнтеркампаниВозвратДОП");
	Иначе
		СтруктураЭД.Вставить("Функция", "ДОП");
	КонецЕсли;

	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда
		ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
			"ОбщийМодуль.ОбменСКонтрагентамиУТ.ЗаполнитьДанныеИнтеркампаниСЧФДОП");
		ИначеЕсли СтруктураЭД.Функция = "ДОП" Тогда
		ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
			"ОбщийМодуль.ОбменСКонтрагентамиУТ.ЗаполнитьДанныеИнтеркампаниПередачаДОП");
		КонецЕсли;
	КонецЕсли;

	Если СтруктураЭД.Функция = "СЧФДОП" И (ТипЗнч(Основание) = Тип("ДокументСсылка.ОтчетКомитенту")
			Или ТипЗнч(Основание) = Тип("ДокументСсылка.ОтчетКомитентуОЗакупках"))
			И Основание.СтавкаНДСВознаграждения <> Справочники.СтавкиНДС.БезНДС Тогда
		СтруктураЭД.Функция = "СЧФДОП";
	КонецЕсли;

	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") И СтруктураЭД.Функция = "СЧФДОП" Тогда
		СтруктураЭД.Функция = "ДОП";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ПередачаТоваровХранителю") И СтруктураЭД.Функция = "СЧФДОП" Тогда
		СтруктураЭД.Функция = "ДОП";
	КонецЕсли;

	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.СчетФактураВыданный")
		И ТипЗнч(Основание) <> Тип("ДокументСсылка.СчетФактураКомиссионеру")
		И ТипЗнч(Основание) <> Тип("ДокументСсылка.СчетФактураВыданныйАванс")
		И СтруктураЭД.Функция = "СЧФДОП" Тогда
	
		ПараметрыРегистрации = Документы[Основание.Метаданные().Имя].ПараметрыРегистрацииСчетовФактурВыданных(Основание);
		СчетФактураНеТребуется = УчетНДСУП.СчетФактураВыданныйНеТребуется(ПараметрыРегистрации);
		Если СчетФактураНеТребуется Тогда
			СтруктураЭД.Функция = "ДОП";
		КонецЕсли;
	КонецЕсли;
	
	ДокОснование = Основание;
	Если СтруктураЭД.Функция <> "ДОП"
		И СтруктураЭД.Функция <> "СвРК"
		И СтруктураЭД.Функция <> "СвЗК" Тогда
			
		ДанныеОснования = Новый Структура("ЭтоНоваяСФ, Исправление, ИсправляемыйДокумент", Ложь, Ложь);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ОтгрузкаТоваровКлиенту") Тогда
			ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "Исправление, ИсправляемыйДокумент");
			ЗаполнитьЗначенияСвойств(ДанныеОснования, ДанныеДокумента);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ДокументОснование, ВидКорректировки");
			ДанныеОснования.Исправление = ДанныеДокумента.ВидКорректировки = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок;
			ДанныеОснования.ИсправляемыйДокумент = ДанныеДокумента.ДокументОснование;
		КонецЕсли;
		
		Если ДанныеОснования.Исправление И ЗначениеЗаполнено(ДанныеОснования.ИсправляемыйДокумент) Тогда
			
			Если ТипЗнч(ДанныеОснования.ИсправляемыйДокумент) = Тип("ДокументСсылка.ПервичныйДокумент") Тогда
				РезультатАнализа = ПолучитьСчетаФактуруПоДокументуОснования(ДанныеОснования.ИсправляемыйДокумент);
			Иначе
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(ДанныеОснования.ИсправляемыйДокумент);
				РезультатАнализа = Документы.СчетФактураВыданный.ПолучитьСчетаФактурыНаПечать(МассивОбъектов);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(РезультатАнализа.СчетаФактурыНаПечать) Тогда
				
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеОснования.ИсправляемыйДокумент, "Номер, Дата");
				НаименованиеДокумента = ДанныеОснования.ИсправляемыйДокумент.Метаданные().Синоним;
				ДатаДокумента = Формат(ЗначенияРеквизитов.Дата, "ДЛФ=ДД");
				НомерДокумента = НомерСчетаФактурыНаПечать(ЗначенияРеквизитов.Номер, 0);
				
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа-основания %1 № %2 от %3 не введена ""Счет-фактура"".'"),
					НаименованиеДокумента,
					НомерДокумента,
					ДатаДокумента);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураКомиссионеру")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
			СчетФактура = Основание;
			ДокОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "ДокументОснование");
		Иначе
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(Основание);
			РезультатАнализа = Документы.СчетФактураВыданный.ПолучитьСчетаФактурыНаПечать(МассивОбъектов);
			МассивСчетовФактур = РезультатАнализа.СчетаФактурыНаПечать;
			Если МассивСчетовФактур.Количество() = 0 Тогда
				НовыйСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
				СтрокаОснований = НовыйСчетФактура.ДокументыОснования.Добавить();

				НовыйСчетФактура.ДокументОснование = Основание;
				СтрокаОснований.ДокументОснование = Основание;
				НовыйСчетФактура.КодВидаОперации = Документы.СчетФактураВыданный.КодВидаОперации(НовыйСчетФактура.ДокументыОснования,
					НовыйСчетФактура.Покупатели,
					НовыйСчетФактура.Дата,
					Основание);
				НовыйСчетФактура.Дата = ТекущаяДатаСеанса();
				НовыйСчетФактура.ДатаВыставления = ТекущаяДатаСеанса();
				НовыйСчетФактура.ЗаполнитьПараметрыСчетаФактурыПоОснованию(Основание);
				НовыйСчетФактура.УстановитьНовыйНомер();
				НовыйСчетФактура.Исправление = ДанныеОснования.Исправление;
				
				НовыйСчетФактура.Записать(РежимЗаписиДокумента.Проведение);
				МассивСчетовФактур.Добавить(НовыйСчетФактура.Ссылка);
				ДанныеОснования.ЭтоНоваяСФ = Истина;
				
				//Запись в Реестр документов
				ТаблицыДанных = ПроведениеДокументов.ДанныеДокументаДляПроведения(НовыйСчетФактура.Ссылка, "РеестрДокументов");
				РегистрыСведений.РеестрДокументов.ЗаписатьДанные(ТаблицыДанных, НовыйСчетФактура.Ссылка,  Неопределено, Ложь);
			КонецЕсли;
			СчетФактура = МассивСчетовФактур[0];
		КонецЕсли;
		
		Если	НЕ ДанныеОснования.ЭтоНоваяСФ
				И ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный")
				И ТипЗнч(Основание) = Тип("ДокументСсылка.ОтгрузкаТоваровКлиенту") Тогда
			
			ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "Исправление, Корректировочный");
			Если	НЕ ДанныеДокумента.Исправление = ДанныеОснования.Исправление
					ИЛИ ДанныеДокумента.Корректировочный Тогда
				ОбъектСФ = СчетФактура.ПолучитьОбъект();
				ОбъектСФ.Корректировочный = Ложь;
				ОбъектСФ.Исправление = ДанныеОснования.Исправление;
				ОбъектСФ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			
		КонецЕсли;

		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(СчетФактура);
		ПараметрыПечати = Новый Структура();
		ПараметрыПечати.Вставить("ЗаполнениеЭлектронногоДокумента");

		Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
			СтруктураДанных = СчетФактураВыданныйАвансЛокализация.ПолучитьДанныеДляПечатнойФормыСчетФактура(ПараметрыПечати, МассивОбъектов);
		Иначе
			СтруктураДанных = Документы[СчетФактура.Метаданные().Имя].ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивОбъектов);
		КонецЕсли;

		ЗаполнитьДанныеСчетаФактурыУПД_5_02(СтруктураДанных, СтруктураЭД, Данные, Отказ);
		ЗаполнитьДанныеПервичногоДокументаУПД_5_02(СтруктураДанных, СтруктураЭД, Данные, Настройки, Отказ, КоличествоЗаписей);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеМеждуМОДИСМП") Тогда
		Документы.ПеремещениеМеждуМОДИСМП.ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ);
	Иначе
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, Настройки, СтруктураЭД, Данные, Отказ, КоличествоЗаписей);
	КонецЕсли;

	ФункцияУПД = СтруктураЭД.Функция;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);

	Если ФункцияУПД = "СЧФДОП" Тогда
		ПередаточныеДокументы = Новый Массив;
		Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") И СчетФактура.ДокументыОснования.Количество() > 1 Тогда
			Для Каждого ДокументОснованиеСФ Из СчетФактура.ДокументыОснования Цикл
				ПередаточныеДокументы.Добавить(ДокументОснованиеСФ.ДокументОснование);
			КонецЦикла;
		Иначе
			ПередаточныеДокументы.Добавить(ДокОснование);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Если Основание <> СчетФактура Тогда
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
	КонецЕсли;

	Если ОписаниеЗамера <> Неопределено Тогда
		ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоЗаписей);
	КонецЕсли;

	
	#Вставка
	бит_ПослеЗаполненияДанныхПродавцаЭДО(Основание, Данные, Отказ, Ложь);
	#КонецВставки

КонецПроцедуры

&После("ЗаполнитьДанныеУКД2020_ИнформацияПродавца")
Процедура бит_ПослеЗаполнитьДанныеУКД2020_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ)

	бит_ПослеЗаполненияДанныхПродавцаЭДО(Основание, Данные, Отказ, Истина);

КонецПроцедуры

Процедура бит_ПослеЗаполненияДанныхПродавцаЭДО(Основание, Данные, Отказ, ЭтоКорректировка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);

	Попытка
		бит_ДополнитьПокупателяПоДоработкам(Основание, Данные, ЭтоКорректировка);
		бит_ДоработкиКонтрагентовЭДО.ДополнитьДанныеПродавцаПоДоработкамКонтрагентов(Основание, Данные, ЭтоКорректировка);
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
	Исключение
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура бит_ДополнитьПокупателяПоДоработкам(Основание, ДеревоДанных, ЭтоКорректировка)

	Если Не ЗначениеЗаполнено(Основание) Или ТипЗнч(ДеревоДанных) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;

	Контекст = бит_ДоработкиКонтрагентовЭДО.КонтекстДокументовДоработкиЭДО(Основание);
	Если Не ЗначениеЗаполнено(Контекст.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыДерева = бит_ДоработкиКонтрагентовЭДО.ПараметрыДереваПродавцаЭДО(ДеревоДанных);
	Покупатель = бит_ДоработкиКонтрагентовЭДО.ПокупательДляДоработки(Контекст, ЭтоКорректировка);
	Если ЗначениеЗаполнено(Покупатель) Тогда
		бит_ЗаменитьПокупателяВДанныхЭДО(ДеревоДанных, Покупатель, Контекст.Дата, ПараметрыДерева);
	КонецЕсли;

КонецПроцедуры

Процедура бит_ЗаменитьПокупателяВДанныхЭДО(ДеревоДанных, Покупатель, ДатаДокумента, ПараметрыДерева)
	
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	БанковскийСчет = бит_ДоработкиКонтрагентовЭДО.БанковскийСчетПокупателяЭДО(Покупатель);
	СведенияОПокупателе = ЭлектронноеВзаимодействиеУТ.ПолучитьДанныеЮрФизЛица(Покупатель, БанковскийСчет, ДатаДокумента);
	Если Не ЗначениеЗаполнено(СведенияОПокупателе) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыДерева.Формат502
		И ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, "СведенияОСчетеФактуре.СведенияОПокупателях") Тогда
		
		Форматы = ПоддерживаемыеФорматы();
		ДанныеПокупателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПокупателе, , Ложь, Форматы.УПД_5_02.ИнформацияПродавца);
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
		ТаблицаПокупателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ТаблицаПокупателей.Очистить();
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПокупателей, ДанныеПокупателя, ПутьТаблицы, "Покупатель");
		
		УзелПокупателей = ДеревоДанных.Строки.Найти(ПутьТаблицы, "ПолныйПуть", Истина);
		Пока УзелПокупателей.Строки.Количество() > 1 Цикл
			УзелПокупателей.Строки.Удалить(УзелПокупателей.Строки.Количество() - 1);
		КонецЦикла;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, ПутьТаблицы);
	ИначеЕсли ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, "СведенияОПокупателе") Тогда
		ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОПокупателе, "СведенияОПокупателе", "Юр", ДатаДокумента);
	КонецЕсли;
	
КонецПроцедуры
