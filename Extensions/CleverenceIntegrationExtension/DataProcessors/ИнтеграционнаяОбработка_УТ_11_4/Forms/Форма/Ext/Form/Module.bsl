Функция УТ_11_4_МаркировкаТоваровИСМП_СтатусыКодыМаркировкиНанесениеНеЗавершен()
	
	ЗначенияПеречисления = Метаданные.Перечисления.СтатусыОбработкиМаркировкиТоваровИСМП.ЗначенияПеречисления;
	
	ИменаСтатусов = Новый Массив;
	ИменаСтатусов.Добавить("Черновик");
	ИменаСтатусов.Добавить("ОтчетКПередаче");
	ИменаСтатусов.Добавить("ОтчетОбрабатывается");
	ИменаСтатусов.Добавить("ОтчетОшибкаПередачи");
	ИменаСтатусов.Добавить("КодыМаркировкиНанесеныЧастично");
	ИменаСтатусов.Добавить("ОтчетСтатусНеопределен");
	
	СтатусыКодыМаркировки = Новый Массив;
	Для каждого ИмяСтатуса ИЗ ИменаСтатусов Цикл
		Если ЗначенияПеречисления.Найти(ИмяСтатуса) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтатусыКодыМаркировки.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыОбработкиМаркировкиТоваровИСМП." + ИмяСтатуса));
	КонецЦикла;
	
	Возврат СтатусыКодыМаркировки;

