&НаКлиенте
Функция ПроверитьКолонкиДереваМаркированнойПродукции(МассивДокументов, ТипПродукции = "ИСМП") Экспорт

	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("Статус", 	Истина);
	РезультатПроверки.Вставить("Сообщение", "");
	
	ИСМП_ВерсияБиблиотеки_3_0 = ИСМП_ВерсияБиблиотеки_3_0();
	Если ИСМП_ВерсияБиблиотеки_3_0 И НЕ ТипПродукции = "ИСМП" Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Попытка
		Если ИСМП_ВерсияБиблиотеки_3_0 Тогда
			ФормаПроверки = ПолучитьФорму("Обработка.ПроверкаИПодборПродукцииИС.Форма.ПроверкаИПодбор", Новый Структура("АвтоТест", Истина));
		Иначе
			Если ТипПродукции = "ИСМП" Тогда
				ФормаПроверки = ПолучитьФорму("Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор", Новый Структура("АвтоТест", Истина));
			Иначе
				ФормаПроверки = ПолучитьФорму("Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор", Новый Структура("АвтоТест", Истина));
			КонецЕсли;
		КонецЕсли;
		
		ДеревоМаркированнойПродукции = ФормаПроверки.ДеревоМаркированнойПродукции;
	Исключение
		Если ИСМП_ВерсияБиблиотеки_3_0 Тогда
			ТекстОшибки = "Не удалось получить дерево маркированной продукции из формы Обработка.ПроверкаИПодборПродукцииИС.Форма.ПроверкаИПодбор. Причина: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Иначе
			Если ТипПродукции = "ИСМП" Тогда
				ТекстОшибки = "Не удалось получить дерево маркированной продукции из формы Обработка.ПроверкаИПодборПродукцииИСМП.Форма.ПроверкаИПодбор. Причина: "
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Иначе
				ТекстОшибки = "Не удалось получить дерево маркированной продукции из формы Обработка.ПроверкаИПодборТабачнойПродукцииМОТП.Форма.ПроверкаИПодбор. Причина: "
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецЕсли;
		
		РезультатПроверки.Вставить("Статус", 	Ложь);
		РезультатПроверки.Вставить("Сообщение", ТекстОшибки);
		Возврат РезультатПроверки;	
	КонецПопытки;
	
	
	ДанныеДокументов = ПолучитьДанныеПроверкиПоМассивуДокументов(МассивДокументов, ТипПродукции, ИСМП_ВерсияБиблиотеки_3_0);
	Если ДанныеДокументов = Неопределено Тогда
		ТекстОшибки = "Не удалось получить сохраненные данные проверки и подбора " + ТипПродукции
			+ " по тестовым документам (в конфигурации отсутствует регистр сведений СтатусыПроверкиИПодбораДокументовИС/СтатусыПроверкиИПодбораДокументовИСМП)";
		
		РезультатПроверки.Вставить("Статус", 	Ложь);
		РезультатПроверки.Вставить("Сообщение", ТекстОшибки);
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Для каждого СсылкаНаДокумент ИЗ МассивДокументов Цикл
		МассивДанных = ДанныеДокументов.Получить(СсылкаНаДокумент);
		
		Если МассивДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ДанныеДокумента ИЗ МассивДанных Цикл
			ТекстОшибки = ПроверитьКолонкиИсточникаИПриемникаНаСовместимость(ДанныеДокумента, ДеревоМаркированнойПродукции);
			
			РезультатПроверки.Вставить("Статус", 	ПустаяСтрока(ТекстОшибки));
			РезультатПроверки.Вставить("Сообщение", ТекстОшибки);
			Возврат РезультатПроверки;
		КонецЦикла;
	КонецЦикла;
		
	РезультатПроверки.Вставить("Статус", Ложь);
	РезультатПроверки.Вставить("Сообщение", "Не удалось получить сохраненные данные проверки и подбора " + ТипПродукции
		+ " по тестовым документам (отсутствуют данные в регистре сведений СтатусыПроверкиИПодбораДокументовИС/СтатусыПроверкиИПодбораДокументовИСМП)");
	
	Возврат РезультатПроверки;
		
КонецФункции

&НаСервере
Функция ПолучитьДанныеПроверкиПоМассивуДокументов(МассивДокументов, ТипПродукции = "ИСМП", ИСМП_ВерсияБиблиотеки_3_0 = Истина)

	ИмяРегистраСведений = "";
	
	ИменаРегистров = Новый Массив;
	ИменаРегистров.Добавить("СтатусыПроверкиИПодбораИС");
	ИменаРегистров.Добавить("СтатусыПроверкиИПодбораДокументовИС");
	ИменаРегистров.Добавить("СтатусыПроверкиИПодбораДокументовИСМП");
	
	Для каждого ИмяРегистра ИЗ ИменаРегистров Цикл
		Если НЕ Метаданные.РегистрыСведений.Найти(ИмяРегистра) = Неопределено Тогда
			ИмяРегистраСведений = ИмяРегистра;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(ИмяРегистраСведений) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатусыПроверкиИПодбораДокументовИС.Документ КАК Документ,
	               |	СтатусыПроверкиИПодбораДокументовИС.ДанныеПроверкиИПодбора КАК ДанныеПроверкиИПодбора
	               |ИЗ
	               |	РегистрСведений.ИмяРегистраСведений КАК СтатусыПроверкиИПодбораДокументовИС
	               |ГДЕ
	               |	СтатусыПроверкиИПодбораДокументовИС.Документ В(&МассивДокументов)
	               |	//&ДополнительноеУсловие
	               |ИТОГИ ПО
	               |	Документ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРегистраСведений", ИмяРегистраСведений);
	
	Если ИСМП_ВерсияБиблиотеки_3_0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//&ДополнительноеУсловие", "");
	Иначе
		ТекстУсловия = "
		|	И ВЫБОР
	    |			КОГДА &ТипПродукции = ""ИСМП""
	    |				ТОГДА СтатусыПроверкиИПодбораДокументовИС.ВидМаркируемойПродукции В (&ВидыПродукцииИСМП)
	    |			КОГДА &ТипПродукции = ""МОТП""
	    |				ТОГДА СтатусыПроверкиИПодбораДокументовИС.ВидМаркируемойПродукции В (&ВидыПродукцииМОТП)
	    |			ИНАЧЕ ИСТИНА
	    |		КОНЕЦ";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//&ДополнительноеУсловие", ТекстУсловия);
		
		Запрос.УстановитьПараметр("ТипПродукции",	   ТипПродукции);
		Запрос.УстановитьПараметр("ВидыПродукцииИСМП", ОбработкаОбъект.УТ_11_4_ПолучитьВидыПродукцииИСМП());
		Запрос.УстановитьПараметр("ВидыПродукцииМОТП", ОбработкаОбъект.УТ_11_4_ПолучитьВидыПродукцииМОТП());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	УстановитьПривилегированныйРежим(Истина);
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеДокументов = Новый Соответствие;
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		МассивДанных = Новый Массив;
		
		УстановитьПривилегированныйРежим(Истина);
		ВыборкаДетальныеЗаписи = ВыборкаПоДокументам.Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДанныеПроверкиИПодбора = ВыборкаДетальныеЗаписи.ДанныеПроверкиИПодбора.Получить();
			
			Если ДанныеПроверкиИПодбора = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДеревоМаркированнойПродукции = ДанныеПроверкиИПодбора.ДеревоМаркированнойПродукции;
			
			МассивКолонок = Новый Массив;
			Для каждого КолонкаДерева ИЗ ДеревоМаркированнойПродукции.Колонки Цикл
				МассивКолонок.Добавить(Новый Структура("Имя, ТипЗначения",
					КолонкаДерева.Имя, КолонкаДерева.ТипЗначения));
			КонецЦикла;
			   		
			МассивДанных.Добавить(Новый Структура("Колонки", МассивКолонок));
		КонецЦикла;
	
		Если МассивДанных.Количество() Тогда
			ДанныеДокументов.Вставить(ВыборкаПоДокументам.Документ, МассивДанных);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

