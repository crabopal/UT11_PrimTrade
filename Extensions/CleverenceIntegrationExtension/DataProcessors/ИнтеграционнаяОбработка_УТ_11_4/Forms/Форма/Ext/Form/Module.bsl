	Возврат ЭтоПродукцияИСМП;

КонецФункции

&НаКлиенте
Функция УТ_11_4_МаркировкаТоваровИСМП_ПредставлениеСертификации(ВидСертификации, НомерСертификации, ДатаСертификации)
		
	Если ЗначениеЗаполнено(ВидСертификации)
		И ЗначениеЗаполнено(НомерСертификации)
		И ЗначениеЗаполнено(ДатаСертификации) Тогда
		
		ПредставлениеСертификата = 
			"" + ВидСертификации + " №" +
			НомерСертификации + " от " +
			Формат(ДатаСертификации, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	Возврат ПредставлениеСертификата;
	
КонецФункции

&НаКлиенте
Процедура УТ_11_4_МаркировкаТоваровИСМП_НастроитьЭлементыФормы_ГосИС_3(Форма)
	
	ЭлементыФормы 			   = Форма.Элементы;
	Операция                   = Форма.Объект.Операция;
	ОперацияНанесения          = Форма.Объект.ОперацияНанесения;
	ОтчетПроизводственнойЛинии = Форма.Объект.ОтчетПроизводственнойЛинии;
	ПередаватьВДекларациюАТК   = Форма.Объект.ВариантЗаполненияДекларации = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДекларацииИСМП.АТК");
	
	////////////////////////////////////////////////////////////////////////////////
	
	Попытка
		ЭтоИнтерфейс85 = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияИСКлиентСервер").ЭтоИнтерфейс85();
	Исключение
		ЭтоИнтерфейс85 = Ложь;
	КонецПопытки;
	
	////////////////////////////////////////////////////////////////////////////////
	
	ВидыПродукцииПоТоварнойГруппе = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ВидыПродукцииПоТоварнойГруппе(Форма.Объект.ТоварнаяГруппа);
	
	ПроверятьСоставУпаковокПоДаннымИСМП = Форма.Объект.ПроверятьСоставУпаковокПоДаннымИСМП;
	
	ОперацииМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ОперацииМаркировки(Операция);
	ЭтоПроизводствоВнеЕАЭС                      = ОперацииМаркировки.ЭтоПроизводствоВнеЕАЭС;
	ЭтоПроизводствоПоДоговору                   = ОперацииМаркировки.ЭтоПроизводствоПоДоговору;
	ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика = ОперацииМаркировки.ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика;
	ЭтоПолучениеПродукцииОтФизическихЛиц        = ОперацииМаркировки.ЭтоПолучениеПродукцииОтФизическихЛиц;
	ЭтоМаркировкаОстатков                       = ОперацииМаркировки.ЭтоМаркировкаОстатков;
	ЭтоТрансграничнаяТорговля                   = ОперацииМаркировки.ЭтоТрансграничнаяТорговля;
	ЭтоАгрегация                                = ОперацииМаркировки.ЭтоАгрегация;
	ЭтоИмпортСФТС                               = ОперацииМаркировки.ЭтоИмпортСФТС;
	ЭтоВводВОборот                              = ОперацииМаркировки.ЭтоВводВОборот;
	ЭтоПриемкаКИЗ                               = ОперацииМаркировки.ЭтоПриемкаКИЗ;
	
	ЭтоПродукцияПодконтрольнаяВЕТИС = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПВЕТИСКлиентСервер").ЭтоВидПродукцииИСМПВЕТИС(ВидыПродукцииПоТоварнойГруппе);
	
	ВозможнаОперацияНанесения = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступенОтчетОНанесении(ВидыПродукцииПоТоварнойГруппе);
	
	Если ЭтоИнтерфейс85 Тогда
		ДоступнаИндивидуализацияКИЗ = Ложь;
	КонецЕсли;
	
	Операции = Новый Массив;
	Операции.Добавить(Операция);
	Если ВозможнаОперацияНанесения
		И ЗначениеЗаполнено(ОперацияНанесения) Тогда
		Операции.Добавить(ОперацияНанесения);
	КонецЕсли;
	
	Если ЭтоИнтерфейс85 Тогда
		ДоступнаИндивидуализацияКИЗ = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ЭтоПродукцияПоддерживающаяИндивидуализациюКИЗ(ВидыПродукцииПоТоварнойГруппе);
	КонецЕсли;

	ТекущаяОперация = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ТекущаяОперацияПоДальнейшемуДействию(
		Операция, ОперацияНанесения, Форма.ДальнейшееДействие1);
	
	ЭтоПродукцияСоСрокамиГодности = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ЭтоВидПродукцииСоСрокамиГодности(ВидыПродукцииПоТоварнойГруппе,, Операции);
	ДляТоварнойГруппыИспользуетсяДатаПроизводства = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДляТоварнойГруппыИспользуетсяДатаПроизводства(ВидыПродукцииПоТоварнойГруппе, Операции);
	ДоступноПолеСкоропортящаясяПродукция = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеСкоропортящаясяПродукция(ВидыПродукцииПоТоварнойГруппе, Операции);
	
	//Если ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС Тогда
	//	ОтчетПроизводственнойЛинии = Истина;
	//КонецЕсли;
	
	ЭтоОперацияНанесения =
		ОперацииМаркировки.ЭтоОперацияНанесения
		Или (ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС);
	
	ПрисутствуетОперацияНанесения = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения) Или ЭтоОперацияНанесения;
	ДоступнаОперацияНанесенияПоВидуОперацииИСМП = УТ_11_4_МаркировкаТоваровИСМП_ДоступнаОперацияНанесенияПоВидуОперацииИСМП(Операция);
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.Операция.Видимость         = ЭтоВводВОборот Или ОперацииМаркировки.ЭтоПолучениеПродукцииОтФизическихЛиц Или ЭтоМаркировкаОстатков;
		ЭлементыФормы.ВводВОборот.Видимость      = Форма.ДоступныОперацииВводВОборот И Не ЭтоПриемкаКИЗ;
		ЭлементыФормы.ВводВОборот.Доступность    = ВозможнаОперацияНанесения;
		ЭлементыФормы.ОтчетОНанесении.Видимость  = ВозможнаОперацияНанесения И Не ДоступнаИндивидуализацияКИЗ И Не ЭтоПриемкаКИЗ;
		ЭлементыФормы.ОтчетОНанесении.Доступность = Форма.ДоступныОперацииВводВОборот;
		
		ЭлементыФормы.ГруппаПриемкаКИЗ.Видимость = ЭтоПриемкаКИЗ;
	КонецЕсли;
	
	ДоступенОтчетПроизводственнойЛинии = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступенОтчетПроизводственнойЛинии(ВидыПродукцииПоТоварнойГруппе, Операции);
	
	ОтчетПроизводственнойЛинии = ОтчетПроизводственнойЛинии И ДоступенОтчетПроизводственнойЛинии;
	
	Если НЕ ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ОтчетПроизводственнойЛинии.Видимость = ДоступенОтчетПроизводственнойЛинии;
	КонецЕсли;
	
	Форма.Объект.ОтчетПроизводственнойЛинии	= ОтчетПроизводственнойЛинии;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ОтчетПроизводственнойЛинии.Видимость   = ДоступенОтчетПроизводственнойЛинии;
		ЭлементыФормы.ОтчетПроизводственнойЛинии.Доступность = ДоступенОтчетПроизводственнойЛинии И Не Форма.РедактированиеФормыНеДоступно;
																																					  
	    ЭлементыФормы.Номенклатура.ОтметкаОбязательногоЗаполнения = ОтчетПроизводственнойЛинии И (ЭтоИмпортСФТС Или Форма.Объект.СоздаватьШтрихкодыУпаковок);
	Иначе
		ЭлементыФормы.ОтчетПроизводственнойЛинии.ТолькоПросмотр = Ложь;
		
		ВидПродукцииИспользуетНаборы = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер").ВидПродукцииИспользуетНаборы(ВидыПродукцииПоТоварнойГруппе);
		ВидПродукцииИспользуетГрупповыеУпаковки = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер").ВидПродукцииИспользуетГрупповыеУпаковки(ВидыПродукцииПоТоварнойГруппе);
		
		КомплектующиеМогутБытьНанесеныНезависимо = ВидПродукцииИспользуетНаборы Или ВидПродукцииИспользуетГрупповыеУпаковки
			И Не ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер").ЭтоПродукцияМОТП(ВидыПродукцииПоТоварнойГруппе);
		
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Доступность = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения);
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Видимость   = КомплектующиеМогутБытьНанесеныНезависимо И Не ЭтоИмпортСФТС;
		ЭлементыФормы.ОперацияТолькоДляНаборов.Видимость            = КомплектующиеМогутБытьНанесеныНезависимо И ЭтоОперацияНанесения;
	КонецЕсли;

	ЭлементыФормы.Номенклатура.АвтоОтметкаНезаполненного = ОтчетПроизводственнойЛинии И (ЭтоИмпортСФТС Или Форма.Объект.СоздаватьШтрихкодыУпаковок);

	ЭлементыФормы.ТоварыЗагрузитьДанныеИзТСД.Видимость     = Форма.ИспользуетсяТСД И Не ЭтоАгрегация;
	ЭлементыФормы.ТоварыЗагрузитьИзВнешнегоФайла.Видимость = Не ЭтоАгрегация;
	
	ДоступноПолеДанныеДекларации = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеТаможеннаяДекларация(
		ВидыПродукцииПоТоварнойГруппе, Операция);
	ДоступноПолеРешениеКодТаможенногоОргана = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеПринятоеРешениеКодТаможенногоОргана(
		ВидыПродукцииПоТоварнойГруппе, Операция);
		
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ГруппаДанныеДекларации.Видимость = ДоступноПолеДанныеДекларации Или ДоступноПолеРешениеКодТаможенногоОргана;
	Иначе
		ЭлементыФормы.ГруппаПраваяКолонкаДанныеДекларации.Видимость = ДоступноПолеДанныеДекларации Или ДоступноПолеРешениеКодТаможенногоОргана;
	КонецЕсли;	
		
	ЭлементыФормы.ГруппаТаможенныйОрганИРешение.Видимость       = ДоступноПолеРешениеКодТаможенногоОргана;
	
	ТребуетсяУказатьДанныеДекларации = УТ_11_4_МаркировкаТоваровИСМП_ТребуетсяУказатьДанныеДекларации(Форма);
	
	ПроверятьЗаполнениеПоляТаможеннаяДекларация = ТребуетсяУказатьДанныеДекларации
		И ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ПроверятьЗаполнениеПоляТаможеннаяДекларация(ВидыПродукцииПоТоварнойГруппе, ТекущаяОперация);
	ЭлементыФормы.РегистрационныйНомерДекларации.АвтоОтметкаНезаполненного = ПроверятьЗаполнениеПоляТаможеннаяДекларация;
	ЭлементыФормы.ДатаДекларации.АвтоОтметкаНезаполненного                 = ПроверятьЗаполнениеПоляТаможеннаяДекларация;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.РегистрационныйНомерДекларации.ОтметкаОбязательногоЗаполнения = ПроверятьЗаполнениеПоляТаможеннаяДекларация;
		ЭлементыФормы.ДатаДекларации.ОтметкаОбязательногоЗаполнения                 = ПроверятьЗаполнениеПоляТаможеннаяДекларация;
	КонецЕсли;
	
	ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана = ТребуетсяУказатьДанныеДекларации
		И ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана(ВидыПродукцииПоТоварнойГруппе, ТекущаяОперация);
	ЭлементыФормы.ПринятоеРешениеПолеВвода.АвтоОтметкаНезаполненного = ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана;
	ЭлементыФормы.КодТаможенногоОргана.АвтоОтметкаНезаполненного     = ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ПринятоеРешениеПолеВвода.ОтметкаОбязательногоЗаполнения = ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана;
		ЭлементыФормы.КодТаможенногоОргана.ОтметкаОбязательногоЗаполнения     = ПроверятьЗаполнениеПоляПринятоеРешениеКодТаможенногоОргана;
	КонецЕсли;
	
	// Для ТГ Продукция из натурального меха доступно заполнение документа только кодами маркировки.
	ДоступнаАгрегация = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ВидыУпаковокДоступныеДляАгрегацииЧерезГИСМТ(ВидыПродукцииПоТоварнойГруппе).Количество() > 0
		Или ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ВидыУпаковокДоступныеДляАгрегацииЧерезСУЗ(ВидыПродукцииПоТоварнойГруппе).Количество() > 0;
	
	ЭлементыФормы.ВариантЗаполненияДекларации.Видимость    = ЭтоИмпортСФТС И ДоступнаАгрегация;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ВариантФормированияАТКИСМП.Видимость     = ЭтоИмпортСФТС И ПередаватьВДекларациюАТК И ДоступнаАгрегация;
	Иначе
		ЭлементыФормы.ВариантФормированияАТКИСМП.Видимость     = ЭтоИмпортСФТС И ДоступнаАгрегация;
		ЭлементыФормы.ВариантФормированияАТКИСМП.Доступность   = ЭтоИмпортСФТС И ПередаватьВДекларациюАТК И ДоступнаАгрегация;
	КонецЕсли;
	
	ЭлементыФормы.ТоварыСтранаПроизводства.Видимость       = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ТоварыТаможеннаяДекларация.Видимость     = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ЗаполнитьПараметрыТовары.Видимость       = ЭтоМаркировкаОстатков;
	ЭлементыФормы.ТоварыGTIN.Видимость                     = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеGTIN(ВидыПродукцииПоТоварнойГруппе, Операции);
	
	ДоступноПолеСумма = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеСумма(ВидыПродукцииПоТоварнойГруппе, Операции);
	ЭлементыФормы.ТоварыЦена.Видимость      = ДоступноПолеСумма;
	ЭлементыФормы.ТоварыСумма.Видимость     = ДоступноПолеСумма;
	ЭлементыФормы.ТоварыСуммаНДС.Видимость  = ДоступноПолеСумма;
	ЭлементыФормы.ТоварыСуммаСНДС.Видимость = ДоступноПолеСумма;
	
	ДоступноПолеСтавкаНДС = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеСтавкаНДС(ВидыПродукцииПоТоварнойГруппе, Операции);
	ЭлементыФормы.ТоварыСтавкаНДС.Видимость = ДоступноПолеСтавкаНДС;
	
	ДоступноПолеСуммаАкциза = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеСуммаАкциза(ВидыПродукцииПоТоварнойГруппе, Операции);
	ЭлементыФормы.ТоварыСуммаАкциза.Видимость = ДоступноПолеСуммаАкциза;
	
	ДоступноПолеПервичныйДокумент = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеВидПервичногоДокумента(ВидыПродукцииПоТоварнойГруппе, Операции);
	ДоступноПолеПервичныйДокументВТабличнойЧасти = ОбщегоНазначенияКлиент.ОбщийМодуль("МаркировкаТоваровКлиентСервер").ДоступноПолеПервичныйДокументВТабличнойЧасти(ВидыПродукцииПоТоварнойГруппе, Операции);
	
	Если ДоступноПолеПервичныйДокументВТабличнойЧасти Тогда
