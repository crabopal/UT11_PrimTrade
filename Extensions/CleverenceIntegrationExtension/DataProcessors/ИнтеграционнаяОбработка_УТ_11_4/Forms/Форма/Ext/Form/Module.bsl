&НаКлиенте
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_ОбновитьВидимостьДоступностьЭлементовФормы_ГосИС_3(Форма) Экспорт
	
	ДокументОбъект = Форма.Объект;
	ЭлементыФормы  = Форма.Элементы;
	
	////////////////////////////////////////////////////////////////////////////////
	
	Попытка
		ЭтоИнтерфейс85 = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияИСКлиентСервер").ЭтоИнтерфейс85();
	Исключение
		ЭтоИнтерфейс85 = Ложь;
	КонецПопытки;
	
	////////////////////////////////////////////////////////////////////////////////
	
	ВидыПродукцииПоТоварнойГруппе = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ВидыПродукцииПоТоварнойГруппе(ДокументОбъект.ТоварнаяГруппа);
	
	УТ_11_4_ЗаказНаЭмиссиюКМ_ЗаполнитьФлагЭтоМаркировкаОстатков(Форма);
	
	ЭтоТрансграничнаяТорговля = ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение(
		"Перечисление.СпособыВводаВОборотСУЗ.ТрансграничнаяТорговля");
	
	ЭтоМех = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ЭтоПродукцияМЕХ(ВидыПродукцииПоТоварнойГруппе);
	
	ЭлементыФормы.ТоварыМаксимальнаяРозничнаяЦена.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСМПОбщегоНазначенияКлиентСервер").ДоступноПолеМРЦ(ВидыПродукцииПоТоварнойГруппе);
	ЭлементыФормы.ПроизводственныйОбъектИдентификатор.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеПроизводственныйОбъектИдентификатор(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	ЭлементыФормы.ИдентификаторПроизводственнойЛинии.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеИдентификаторПроизводственнойЛинии(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	ЭлементыФормы.ОжидаемаяДатаНачалаПроизводства.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеОжидаемаяДатаНачалаПроизводства(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	ЭлементыФормы.ПредставлениеАдресаПроизводственногоОбъекта.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеПредставлениеАдресаПроизводственногоОбъекта(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот)
		Или ЭтоМех И ДокументОбъект.СпособПолучения = ПредопределенноеЗначение(
			"Перечисление.СпособыПолученияИзготовленныхКИЗГИСМ.ДоставкаЭмитентомДоУказанногоМеста");
	
	Форма.ИспользуютсяНаборы            = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер").ВидПродукцииИспользуетНаборы(ВидыПродукцииПоТоварнойГруппе);
	Форма.ИспользуютсяГрупповыеУпаковки = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер").ВидПродукцииИспользуетГрупповыеУпаковки(ВидыПродукцииПоТоварнойГруппе);
	Форма.ШаблоныГрупповойУпаковки      = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ТоварнаяГруппа, 4);
	Форма.ШаблоныНабора                 = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ТоварнаяГруппа, 5);
	Если Форма.ИспользуютсяНаборы И Форма.ИспользуютсяГрупповыеУпаковки Тогда
		ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить наборы / групповые упаковки'");
		ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
			НСтр("ru = 'Установить отбор строк по набору / групповой упаковке'");
	ИначеЕсли Форма.ИспользуютсяНаборы Тогда
		ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить наборы'");
		ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
			НСтр("ru = 'Установить отбор строк по набору'");
	ИначеЕсли Форма.ИспользуютсяГрупповыеУпаковки Тогда
		ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Заголовок = НСтр("ru = 'Перезаполнить групповые упаковки'");
		ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Заголовок =
			НСтр("ru = 'Установить отбор строк по групповой упаковке'");
	КонецЕсли;
	ЭлементыФормы.ПерезаполнитьНаборыГрупповыеУпаковки.Видимость =
		Форма.ИспользуютсяНаборы Или Форма.ИспользуютсяГрупповыеУпаковки;
	ЭлементыФормы.ТоварыУстановитьОтборПоНаборуГрупповойУпаковке.Видимость =
		Форма.ИспользуютсяНаборы Или Форма.ИспользуютсяГрупповыеУпаковки;

	Форма.ИспользованиеСервисПровайдераЗапрещено = Не ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеСервисПровайдер(
		ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);

	ЭлементыФормы.ГруппаСервисПровайдер.Видимость = Не Форма.ИспользованиеСервисПровайдераЗапрещено;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.СервисПровайдер.Видимость = Форма.ПечатьКодовМаркировки = 1;
	КонецЕсли;
	
	ЭлементыФормы.СервисПровайдер.Доступность = Форма.ПечатьКодовМаркировки = 1;
	
	ПодсказкаВвода = "";
	Если Не Форма.ИспользованиеСервисПровайдераЗапрещено
		И Форма.ПечатьКодовМаркировки = 1
		И Не ЗначениеЗаполнено(ДокументОбъект.СервисПровайдер) Тогда
			
		Если Не ЗначениеЗаполнено(ДокументОбъект.ТоварнаяГруппа) Тогда
			ПодсказкаВвода = НСтр("ru = 'заполните поле ""Вид продукции""'");
		ИначеЕсли Не ЗначениеЗаполнено(ДокументОбъект.СпособВводаВОборот) Тогда
			ПодсказкаВвода = НСтр("ru = 'заполните поле ""Способ ввода в оборот""'");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПодсказкаВвода <> ЭлементыФормы.СервисПровайдер.ПодсказкаВвода Тогда
		
		Если ПодсказкаВвода <> "" Тогда
			ЭлементыФормы.СервисПровайдер.ПодсказкаВвода = ПодсказкаВвода;
			ЭлементыФормы.СервисПровайдер.ТолькоПросмотр = Истина;
		Иначе
			ЭлементыФормы.СервисПровайдер.ПодсказкаВвода = "";
			ЭлементыФормы.СервисПровайдер.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлементыФормы.ТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог.Видимость =
		Форма.ОтображатьКомандуТоварыПодготовитьПередатьСведенияОТоварахВНациональныйКаталог;
	ЭлементыФормы.ТоварыВключить1СНоменклатуру.Видимость =
		Форма.ОтображатьКомандуВключить1СНоменклатуру;
	
	ЭлементыФормы.БезУчетаНоменклатуры.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеБезУчетаНоменклатуры(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	
	ЭлементыФормы.ВвезенПослеДатыОбязательнойМаркировки.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеВвезенПослеДатыОбязательнойМаркировки(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	
	ЭлементыФормы.ПриобретенПроизведенПослеДатыОбязательнойМаркировки.Видимость =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеПриобретенПроизведенПослеДатыОбязательнойМаркировки(
			ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	
	Если Форма.ЭтоМаркировкаОстатков Тогда
		
		ПолноеОписание = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ИспользованиеСпособаОписанияОстатков(ВидыПродукцииПоТоварнойГруппе);
		
		ПараметрыОписанияОстатков =
			ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ИспользованиеПараметровОписанияОстатковПоВидуПродукции(
				ВидыПродукцииПоТоварнойГруппе);
		
		ЭлементыФормы.ЗаполнитьПараметрыОписанияОстатков.Видимость = ПолноеОписание <> Истина;
		
		ЭлементыФормы.ТоварыПолноеОписаниеОстатков.Видимость = ПолноеОписание = Неопределено;
		ЭлементыФормы.ТоварыКодТНВЭД.Видимость               = ПолноеОписание <> Истина;
		ЭлементыФормы.ТоварыЦелевойПол.Видимость             = ПараметрыОписанияОстатков.ИспользоватьЦелевойПол;
		ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость    = ПараметрыОписанияОстатков.ИспользоватьВозрастнуюКатегорию;
		ЭлементыФормы.ТоварыМодель.Видимость                 = ПараметрыОписанияОстатков.ИспользоватьМодель;
		ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость     = ПараметрыОписанияОстатков.ИспользоватьСпособВводаВОборот;
		ЭлементыФормы.ТоварыНаименование.Видимость           = ПараметрыОписанияОстатков.ИспользоватьНаименование;
		ЭлементыФормы.ТоварыТоварныйЗнак.Видимость           = ПараметрыОписанияОстатков.ИспользоватьТоварныйЗнак;
		
	Иначе
		
		ЭлементыФормы.ЗаполнитьПараметрыОписанияОстатков.Видимость = Ложь;
		
		ЭлементыФормы.ТоварыПолноеОписаниеОстатков.Видимость = Ложь;
		ЭлементыФормы.ТоварыКодТНВЭД.Видимость               = ЭтоМех;
		ЭлементыФормы.ТоварыЦелевойПол.Видимость             = Ложь;
		ЭлементыФормы.ТоварыВозрастнаяКатегория.Видимость    = Ложь;
		ЭлементыФормы.ТоварыМодель.Видимость                 = Ложь;
		ЭлементыФормы.ТоварыСпособВводаВОборот.Видимость     = ЭтоМех;
		ЭлементыФормы.ТоварыНаименование.Видимость           = Ложь;
		ЭлементыФормы.ТоварыТоварныйЗнак.Видимость =
			ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеТоварныйЗнак(ВидыПродукцииПоТоварнойГруппе);
		
	КонецЕсли;
	
	ЭлементыФормы.ТоварыШаблон.СписокВыбора.Очистить();
	ДоступныеШаблоны = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ШаблоныКодовПоВидуПродукции(ДокументОбъект.ТоварнаяГруппа, 3);
	Для Каждого ЭлементСпискаЗначений Из ДоступныеШаблоны Цикл
		ЭлементыФормы.ТоварыШаблон.СписокВыбора.Добавить(
			ЭлементСпискаЗначений.Значение, ЭлементСпискаЗначений.Представление);
	КонецЦикла;
	
	ЭлементыФормы.ТоварыШаблон.Заголовок       = НСтр("ru = 'Вид упаковки'");
	ЭлементыФормы.ТоварыСрокГодности.Видимость = УТ_11_4_ЗаказНаЭмиссиюКМ_ЕстьЗаполненныйСрокГодности(Форма);
	ЭлементыФормы.ТоварыСрокГодности.ТолькоПросмотр = Истина;
	
	ЭлементыФормы.ТоварыШаблон.Видимость = ЭлементыФормы.ТоварыШаблон.СписокВыбора.Количество() > 1;
	
	ЗависимыеОтСтатусаОбработкиЗаказа = Новый Массив;
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ГруппаШапка");
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("Товары");
	
	Если НЕ ЭтоИнтерфейс85 Тогда
		ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыКоманднаяПанельЕще");
	КонецЕсли;	
		
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыГруппаПодменюЗаполнить");
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыГруппаТорговоеОборудование");
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("ТоварыУказатьСерийныеНомера");
	ЗависимыеОтСтатусаОбработкиЗаказа.Добавить("Ответственный");
	
	ИнтеграцияИСКлиентСервер_УстановитьДоступностьЭлементовФормы(Форма,
		ЗависимыеОтСтатусаОбработкиЗаказа, Не Форма.РедактированиеФормыНеДоступно);
	
	ЭлементыФормы.ТоварыКоличествоЭмитировано.Видимость = Форма.ОтобразитьКоличествоЭмитировано;
	
	Если ЭтоИнтерфейс85 Тогда
		ЭлементыФормы.ТоварыГруппаОтборСтрок.Видимость = Форма.ОтобразитьКоличествоЭмитировано;
	Иначе
		ЭлементыФормы.ОтборСтрок.Видимость             = Форма.ОтобразитьКоличествоЭмитировано;
	КонецЕсли;
		                                               
	ЭлементыФормы.Контрагент.Видимость = ЭтоТрансграничнаяТорговля;

	ИспользуетсяТипОплатыКодовМаркировки =
		ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеТипОплатыКодовМаркировки(ВидыПродукцииПоТоварнойГруппе);
	
	ЭлементыФормы.ТипОплатыКодовМаркировки.Видимость = ИспользуетсяТипОплатыКодовМаркировки;
	
	Если ИспользуетсяТипОплатыКодовМаркировки Тогда
		Если ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.МаркировкаВнеПроизводстваИмпорта") Тогда
			ДокументОбъект.ТипОплатыКодовМаркировки = ПредопределенноеЗначение("Перечисление.ТипыОплатыКодовМаркировкиСУЗ.ОплатаПоЭмиссии");
			ЭлементыФормы.ТипОплатыКодовМаркировки.Доступность = Ложь;
		Иначе
			ЭлементыФормы.ТипОплатыКодовМаркировки.Доступность = Истина;
			Если Не ЗначениеЗаполнено(ДокументОбъект.ТипОплатыКодовМаркировки) Тогда
				ДокументОбъект.ТипОплатыКодовМаркировки = ПредопределенноеЗначение("Перечисление.ТипыОплатыКодовМаркировкиСУЗ.ОплатаПоНанесению");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементыФормы.GLNОрганизации.Видимость              = ЭтоМех;
	ЭлементыФормы.ФормаВиртуальнаяАгрегация.Видимость   = Не ЭтоМех;
	ЭлементыФормы.ФормаПечать.Видимость                 = Не ЭтоМех;
	ЭлементыФормы.СброситьПризнакПечати.Видимость       = Не ЭтоМех;
	ЭлементыФормы.ТоварыУказатьСерийныеНомера.Видимость = Не ЭтоМех;
	
	ЭлементыФормы.ТоварыСпособФормированияСерийногоНомера.Видимость = Не ЭтоМех;
	ЭлементыФормы.ТоварыСтатусУказанияСерийногоНомера.Видимость     = Не ЭтоМех;
	ЭлементыФормы.СпособВыпускаВОборот.Видимость                    = Не ЭтоМех;
	
	ЭлементыФормы.ТоварыВидКИЗ.Видимость                            = ЭтоМех;
	ЭлементыФормы.ТоварыРазмерКИЗ.Видимость                         = ЭтоМех;
	ЭлементыФормы.СпособПолучения.Видимость                         = ЭтоМех;
	ЭлементыФормы.НомерДоговораСОператором.Видимость                = ЭтоМех;
	ЭлементыФормы.ДатаДоговораСОператором.Видимость                 = ЭтоМех;
	
	ЭлементыФормы.ТоварыВладелецGTINСтрокой.Видимость = ОбщегоНазначенияКлиент.ОбщийМодуль("ЗаказНаЭмиссиюСУЗКлиентСервер").ДоступноПолеВладелецGTIN(
		ВидыПродукцииПоТоварнойГруппе, ДокументОбъект.СпособВводаВОборот);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НастройкиВыполненияПодключаемыхКомандИС") Тогда
		ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыИСКлиентСервер").УправлениеВидимостьюКомандПодключенныхКОбъекту(Форма);
	КонецЕсли;
	
	Если ЭтоИнтерфейс85 Тогда
		УТ_11_4_ЗаказНаЭмиссиюКМ_УстановитьОтборСтрок(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_ЗаполнитьФлагЭтоМаркировкаОстатков(Форма)
	
	Форма.ЭтоМаркировкаОстатков = Форма.Объект.СпособВводаВОборот = ПредопределенноеЗначение(
		"Перечисление.СпособыВводаВОборотСУЗ.МаркировкаОстатков");
	
КонецПроцедуры

&НаКлиенте
Функция УТ_11_4_ЗаказНаЭмиссиюКМ_ЕстьЗаполненныйСрокГодности(Форма)

	Если Не Форма.Объект.Ссылка.Пустая() Тогда
		
		Для Каждого Строка Из Форма.Объект.Товары Цикл
			Если ЗначениеЗаполнено(Строка.СрокГодности) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_УстановитьОтборСтрок(Форма)
	
	Форма.Элементы.ТоварыОтборСтрокВключить.Пометка  = Форма.ОтборСтрок;
	Форма.Элементы.ТоварыОтборСтрокОтключить.Пометка = Не Форма.ОтборСтрок;
	
	Если Форма.ОтборСтрок Тогда
		Форма.Элементы.ТоварыГруппаОтборСтрок.Заголовок = НСтр("ru = 'Отбор: не полученные коды'");
		Отбор = Новый Структура;
		Отбор.Вставить("ЕстьОтличия", Истина);
		Форма.Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	Иначе
		Форма.Элементы.ТоварыГруппаОтборСтрок.Заголовок = НСтр("ru = 'Отбор: все коды'");
		Форма.Элементы.Товары.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УТ_11_4_ЗаказНаЭмиссиюКМ_ОбновитьВидимостьДоступностьЭлементовФормы_ГосИС_1(Форма) Экспорт
	
	ДокументОбъект = Форма.Объект;
	ЭлементыФормы  = Форма.Элементы;
	
	////////////////////////////////////////////////////////////////////////////////
	
	////////////////////////////////////////////////////////////////////////////////
	
	ЗначенияПеречисления = УТ_11_4_ПолучитьЗначенияПеречисления("ВидыПродукцииИС");
		
	ЭтоНикотиносодержащаяПродукция = ЗначенияПеречисления.Найти("НикотиносодержащаяПродукция") <> Неопределено
		И ДокументОбъект.ВидПродукции = ПредопределенноеЗначение("Перечисление.ВидыПродукцииИС.НикотиносодержащаяПродукция");
		
	Форма.ЭтоМаркировкаОстатков =
		ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.МаркировкаОстатков")
		И НЕ ЭтоНикотиносодержащаяПродукция;
		
	ЭтоТрансграничнаяТорговля = ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.ТрансграничнаяТорговля");
	
	Попытка
		ЭтоКомиссия = ДокументОбъект.СпособВводаВОборот = ПредопределенноеЗначение("Перечисление.СпособыВводаВОборотСУЗ.Комиссия");
	Исключение
		// Адаптация к старым релизам
		ЭтоКомиссия = Ложь;	
	КонецПопытки;
		
	ЭтоШины                 = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Шины");
	ЭтоДухи                 = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Духи");
	ЭтоМолочнаяПродукция    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "МолочнаяПродукцияПодконтрольнаяВЕТИС");
	ЭтоОбувь                = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Обувь");
	ЭтоЛегкаяПромышленность = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ЛегкаяПромышленность")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "ЛегкаяПромышленность2025");
	ЭтоТабак                = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ДокументОбъект.ВидПродукции, "Табак");
