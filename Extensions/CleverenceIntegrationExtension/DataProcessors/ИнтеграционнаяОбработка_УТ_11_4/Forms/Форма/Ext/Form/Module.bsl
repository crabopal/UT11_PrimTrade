#Область СлужебныеПроцедурыИФункции_Производство

&НаСервереБезКонтекста
Функция УТ_11_4_ПараметрыЗаполненияВидаДеятельностиНДС(ДокументОбъект, ИмяДокумента)

	ПараметрыЗаполнения = Документы[ИмяДокумента].ПараметрыЗаполненияВидаДеятельностиНДС(ДокументОбъект);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Представления", 	ОбщегоНазначения.ОбщийМодуль("УчетНДСУПСлужебный").ПрименяемыеВидыДеятельностиНДС());
	СтруктураПараметров.Вставить("МассивДоступных", ОбщегоНазначения.ОбщийМодуль("УчетНДСУПСлужебный").ДоступныеВидыДеятельностиНДС(ПараметрыЗаполнения));
	
	Возврат СтруктураПараметров;

КонецФункции

&НаКлиенте
Процедура УТ_11_4_ЗаполнитьСписокВыбораВидаДеятельностиНДС(ЭлементВидДеятельностиНДС, ВидДеятельностиНДС, ДокументОбъект, ИмяДокумента) Экспорт
	
	СтруктураПараметров = УТ_11_4_ПараметрыЗаполненияВидаДеятельностиНДС(ДокументОбъект, ИмяДокумента);
	
	Представления 	= СтруктураПараметров.Представления;
	МассивДоступных = СтруктураПараметров.МассивДоступных;
	
	Если ЗначениеЗаполнено(ВидДеятельностиНДС) И МассивДоступных.Найти(ВидДеятельностиНДС) = Неопределено Тогда
		МассивДоступных.Добавить(ВидДеятельностиНДС);
	КонецЕсли;
	
	ЭлементВидДеятельностиНДС.СписокВыбора.Очистить();
	Для каждого Значение Из МассивДоступных Цикл
		ЭлементПредставления = Представления.НайтиПоЗначению(Значение);
		Если ЭлементПредставления <> Неопределено Тогда 
			ЭлементВидДеятельностиНДС.СписокВыбора.Добавить(Значение, ЭлементПредставления.Представление);
		Иначе
			ЭлементВидДеятельностиНДС.СписокВыбора.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	ЭлементВидДеятельностиНДС.Видимость = (ЭлементВидДеятельностиНДС.СписокВыбора.Количество() > 1);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ПереименованиеМодулей_БиблиотекаИнтеграцииГосИС_1_1_30

&НаСервере
Функция ИнтеграцияИС_МенеджерОбъектаПоСсылке(Ссылка)
	
	ИмяСобытия = "ИнтеграцияИС_МенеджерОбъектаПоСсылке";
	
	Попытка
