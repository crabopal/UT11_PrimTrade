		Форма = СтруктураПараметров.ФормаДокумента;
		
		Попытка 
			тчТовары = Форма.Объект.Товары;																		
			тчАкцизныеМарки = Форма.Объект.АкцизныеМарки;
			Для каждого Стр Из тчТовары Цикл
				
				Стр.КоличествоАкцизныхМарок = тчАкцизныеМарки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Стр.ИдентификаторСтроки)).Количество();
				
				ПараметрыЗаполнения = Новый Структура;
				ПараметрыЗаполнения.Вставить("ЗаполнитьФлагАлкогольнаяПродукция", Ложь);
				ПараметрыЗаполнения.Вставить("ИмяКолонки", "АлкогольнаяПродукция");
				
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", Стр.Характеристика);
				СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", Стр.Упаковка);
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
				СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
				
				СтруктураДействий.Вставить("ЗаполнитьПризнакМаркируемаяАлкогольнаяПродукция", Новый Структура("Номенклатура", "МаркируемаяАлкогольнаяПродукция"));
				СтруктураДействий.Вставить("ЗаполнитьНоменклатуруЕГАИС", ПараметрыЗаполнения);
				СтруктураДействий.Вставить("ЗаполнитьИндексАкцизнойМарки");		
				
				ОбщегоНазначенияКлиент_ОбщийМодуль("ОбработкаТабличнойЧастиКлиент").ОбработатьСтрокуТЧ(Стр, СтруктураДействий, Неопределено);
				
			КонецЦикла;	
		Исключение
