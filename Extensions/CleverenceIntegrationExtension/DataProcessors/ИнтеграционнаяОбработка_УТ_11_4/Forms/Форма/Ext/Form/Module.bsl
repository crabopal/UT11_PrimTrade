	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыЗагрузитьИзВнешнегоФайла");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыГруппаПерезаполнитьПоОснованию");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ГруппаТорговоеОборудование");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыНоменклатура");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыХарактеристика");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыСерия");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыКоличествоУпаковок");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыУпаковкаЕдиницаИзмерения");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыДобавить");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыСкопировать");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыИзменить");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыУдалить");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыКонтекстноеМенюДобавить");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыКонтекстноеМенюСкопировать");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыКонтекстноеМенюИзменить");
	ЗависимыеОтСтатусаПроверкиИПодбора.Добавить("ТоварыКонтекстноеМенюУдалить");

	ИнтеграцияИСКлиентСервер_УстановитьДоступностьЭлементовФормы(Форма,
		ЗависимыеОтСтатусаПроверкиИПодбора,
		Не (Форма.РедактированиеФормыНеДоступно Или УТ_11_4_МаркировкаТоваровИСМП_РедактированиеНедоступноПоСтатусуПроверкиИподбора(Форма))
			И Не Форма.РежимИсправленияОшибокПослеПередачиКодов);
	
	ЭлементыФормы.ТоварыСтатусПроверкиГосИС.Видимость = Не Форма.РедактированиеФормыНеДоступно;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НастройкиВыполненияПодключаемыхКомандИС") Тогда
		ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыИСКлиентСервер").УправлениеВидимостьюКомандПодключенныхКОбъекту(Форма);
	КонецЕсли;
	
	Если Форма.РежимОткрытияПоВидуОперации = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").РежимОткрытияАгрегация() Тогда
		
		Если ЭтоИнтерфейс85 Тогда
			ЭлементыФормы.ГруппаОперации.Видимость = Ложь;
		Иначе
			ЭлементыФормы.Операция.Видимость = Ложь;
		КонецЕсли;
			
	ИначеЕсли Форма.РежимОткрытияПоВидуОперации = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").РежимОткрытияПоступлениеКИЗ() Тогда
		ЭлементыФормы.Операция.Видимость = Ложь;
		ЭлементыФормы.ТоварнаяГруппа.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УТ_11_4_МаркировкаТоваровИСМП_НастроитьЭлементыФормы_ГосИС_1(Форма)
	
	ЭлементыФормы              = Форма.Элементы;
	Операция                   = Форма.Объект.Операция;
	ОперацияНанесения          = Форма.Объект.ОперацияНанесения;
	ОтчетПроизводственнойЛинии = Форма.Объект.ОтчетПроизводственнойЛинии;
	ВидПродукции               = Форма.Объект.ВидПродукции;
	ПередаватьВДекларациюАТК   = Форма.Объект.ВариантЗаполненияДекларации = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияДекларацииИСМП.АТК");
	
	Попытка
		ПроверятьСоставУпаковокПоДаннымИСМП = Форма.Объект.ПроверятьСоставУпаковокПоДаннымИСМП;
	Исключение
		// Адаптация к старым режимам
		ПроверятьСоставУпаковокПоДаннымИСМП = Ложь;
	КонецПопытки;
	
	ОперацииМаркировки = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПСлужебныйКлиентСервер").ОперацииМаркировки(Операция);
	ЭтоПроизводствоРФ                           = ОперацииМаркировки.Свойство("ЭтоПроизводствоРФ") И ОперацииМаркировки.ЭтоПроизводствоРФ;
	ЭтоПроизводствоВнеЕАЭС                      = ОперацииМаркировки.Свойство("ЭтоПроизводствоВнеЕАЭС") И ОперацииМаркировки.ЭтоПроизводствоВнеЕАЭС;
	ЭтоПроизводствоПоДоговору                   = ОперацииМаркировки.Свойство("ЭтоПроизводствоПоДоговору") И ОперацииМаркировки.ЭтоПроизводствоПоДоговору;
	ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика = ОперацииМаркировки.Свойство("ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика") И ОперацииМаркировки.ЭтоПроизводствоПоДоговоруНаСторонеЗаказчика;
	ЭтоПолучениеПродукцииОтФизическихЛиц        = ОперацииМаркировки.Свойство("ЭтоПолучениеПродукцииОтФизическихЛиц") И ОперацииМаркировки.ЭтоПолучениеПродукцииОтФизическихЛиц;
	ЭтоМаркировкаОстатков                       = ОперацииМаркировки.Свойство("ЭтоМаркировкаОстатков") И ОперацииМаркировки.ЭтоМаркировкаОстатков;
	ЭтоТрансграничнаяТорговля                   = ОперацииМаркировки.Свойство("ЭтоТрансграничнаяТорговля") И ОперацииМаркировки.ЭтоТрансграничнаяТорговля;
	ЭтоАгрегация                                = ОперацииМаркировки.Свойство("ЭтоАгрегация") И ОперацииМаркировки.ЭтоАгрегация;
	ЭтоИмпортСФТС                               = ОперацииМаркировки.Свойство("ЭтоИмпортСФТС") И ОперацииМаркировки.ЭтоИмпортСФТС;
	ЭтоВводВОборот                              = ОперацииМаркировки.Свойство("ЭтоВводВОборот") И ОперацииМаркировки.ЭтоВводВОборот;
	ЭтоКонтрактноеПроизводство                  = ОперацииМаркировки.Свойство("ЭтоКонтрактноеПроизводство") И ОперацииМаркировки.ЭтоКонтрактноеПроизводство;
	ЭтоПриемкаКИЗ                               = ОперацииМаркировки.Свойство("ЭтоПриемкаКИЗ") И ОперацииМаркировки.ЭтоПриемкаКИЗ;
	
	ЗначенияПеречисления = УТ_11_4_ПолучитьЗначенияПеречисления("ВидыПродукцииИС");
	
	ЭтоТабак                     = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Табак");
	ЭтоМолочнаяПродукцияВЕТИС    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МолочнаяПродукцияПодконтрольнаяВЕТИС");
	ЭтоМолочнаяПродукцияБезВЕТИС = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МолочнаяПродукцияБезВЕТИС");
	ЭтоМолочнаяПродукция         = ЭтоМолочнаяПродукцияБезВЕТИС Или ЭтоМолочнаяПродукцияВЕТИС;
	ЭтоПродукцияМОТП             = ИнтеграцияИСКлиентСервер_ЭтоПродукцияМОТП(ВидПродукции);
	ЭтоУпакованнаяВода           = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "УпакованнаяВода");
	ЭтоПиво                      = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Пиво")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ПивоВПотребительскихУпаковках");
	ЭтоБАПиво                    = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БезалкогольноеПиво");
	ЭтоБАД                       = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БАДы")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "БАДы2025")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "СпортивноеПитание");
	ЭтоМех                       = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ПродукцияИзНатуральногоМеха");
	ЭтоШины                      = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "Шины");
	ЭтоКреслаКоляски             = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "КреслаКоляски")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ТехническиеСредстваРеабилитации")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МедицинскиеИзделия")
		ИЛИ ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МедицинскиеИзделия20");
	ЭтоМорепродукты              = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "МорепродуктыПодконтрольныеВЕТИС");
	ЭтоВетеринарныеПрепараты     = ИСМП_ЭтоВидПродукции(ЗначенияПеречисления, ВидПродукции, "ВетеринарныеПрепараты");
	
	Попытка
		ЭтоПродукцияПодконтрольнаяВЕТИС = ИнтеграцияИСКлиентСервер_ЭтоПродукцияПодконтрольнаяВЕТИС(ВидПродукции);
	Исключение
		// Адаптация к старым релизам
		ЭтоПродукцияПодконтрольнаяВЕТИС	= ЭтоМолочнаяПродукцияВЕТИС ИЛИ ЭтоМорепродукты;
	КонецПопытки;
	
	// Перенесено выше по коду для определения использования срока годности/даты производства в старых релизах
	ВозможнаОперацияНанесения = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСКлиентСервер").ВидПродукцииИспользуетОтчетыОНанесенииКодовМаркировки(ВидПродукции);
	ЭтоОперацияНанесения =
		ОперацииМаркировки.ЭтоОперацияНанесения
		Или (ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС);
	
	ПрисутствуетОперацияНанесения = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения) Или ЭтоОперацияНанесения;
	ДоступнаОперацияНанесенияПоВидуОперацииИСМП = УТ_11_4_МаркировкаТоваровИСМП_ДоступнаОперацияНанесенияПоВидуОперацииИСМП(Операция);
	
	Попытка
		ЭтоПродукцияСоСрокамиГодности = ИнтеграцияИСМПКлиентСервер_ЭтоВидПродукцииСоСрокамиГодности(ВидПродукции);
		ДляВидаПродукцииИспользуетсяДатаПроизводства = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер").ДляВидаПродукцииИспользуетсяДатаПроизводства(ВидПродукции);
	Исключение
		// Адаптация к старым релизам	
		ЭтоПродукцияСоСрокамиГодности = ПрисутствуетОперацияНанесения И (ЭтоМолочнаяПродукция Или ЭтоБАД Или ЭтоПиво Или ЭтоБАПиво);
		ДляВидаПродукцииИспользуетсяДатаПроизводства = ЭтоОперацияНанесения И (ЭтоБАД Или ЭтоПиво Или ЭтоБАПиво);
	КонецПопытки;
	
	ПроверятьСоставУпаковокПоДаннымИСМП = ПроверятьСоставУпаковокПоДаннымИСМП И ЭтоАгрегация И ЭтоПродукцияМОТП;
	
	Попытка
		ТребуетсяУказатьДанныеДекларации = УТ_11_4_МаркировкаТоваровИСМП_ТребуетсяУказатьДанныеДекларации(Форма);
		Если ТребуетсяУказатьДанныеДекларации Тогда
			ЭлементыФормы.РегистрационныйНомерДекларации.АвтоОтметкаНезаполненного = Истина;
			ЭлементыФормы.ДатаДекларации.АвтоОтметкаНезаполненного                 = Истина;
			ЭлементыФормы.ПринятоеРешениеПолеВвода.АвтоОтметкаНезаполненного       = Истина;
			ЭлементыФормы.КодТаможенногоОргана.АвтоОтметкаНезаполненного           = Истина;
		Иначе
			ЭлементыФормы.РегистрационныйНомерДекларации.АвтоОтметкаНезаполненного = Ложь;
			ЭлементыФормы.ДатаДекларации.АвтоОтметкаНезаполненного                 = Ложь;
			ЭлементыФормы.ПринятоеРешениеПолеВвода.АвтоОтметкаНезаполненного       = Ложь;
			ЭлементыФормы.КодТаможенногоОргана.АвтоОтметкаНезаполненного           = Ложь;
		КонецЕсли;
	Исключение
		// Адаптация к старым релизам
		ТребуетсяУказатьДанныеДекларации = Ложь;
	КонецПопытки;
	
	Если ЭтоПродукцияПодконтрольнаяВЕТИС И Не Форма.ИспользуетсяПодсистемаВЕТИС Тогда
		ОтчетПроизводственнойЛинии = Истина;
	КонецЕсли;
	
	ДоступенОтчетПроизводственнойЛинии = УТ_11_4_МаркировкаТоваровИСМП_ОпределитьДоступностьОтчетаПроизводственнойЛинии(
		ВидПродукции, Форма.Объект.Ссылка);
	
	ОтчетПроизводственнойЛинии = ОтчетПроизводственнойЛинии И ДоступенОтчетПроизводственнойЛинии;
	
	УказаниеРеквизитовНанесенияНаПиво = ПрисутствуетОперацияНанесения И ЭтоПиво;
	
	Попытка
		ЭлементыФормы.ОтчетПроизводственнойЛинии.Видимость       = ДоступенОтчетПроизводственнойЛинии;
		Форма.Объект.ОтчетПроизводственнойЛинии             	 = ОтчетПроизводственнойЛинии;
		ЭлементыФормы.ОтчетПроизводственнойЛинии.ТолькоПросмотр  = Ложь;
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	Попытка
		ВидПродукцииИспользуетНаборы            = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетНаборы(ВидПродукции);
		ВидПродукцииИспользуетГрупповыеУпаковки = ИнтеграцияИСКлиентСервер_ВидПродукцииИспользуетГрупповыеУпаковки(ВидПродукции);
		
		КомплектующиеМогутБытьНанесеныНезависимо = ВидПродукцииИспользуетНаборы Или ВидПродукцииИспользуетГрупповыеУпаковки И Не ЭтоТабак;
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Доступность = ЗначениеЗаполнено(Форма.Объект.ОперацияНанесения);
		ЭлементыФормы.ОперацияНанесенияТолькоДляНаборов.Видимость   = КомплектующиеМогутБытьНанесеныНезависимо И Не ЭтоИмпортСФТС;
		ЭлементыФормы.ОперацияТолькоДляНаборов.Видимость            = КомплектующиеМогутБытьНанесеныНезависимо И ЭтоОперацияНанесения;
	Исключение
		// Адаптация к старым релизам
		ВидПродукцииИспользуетНаборы			 = Ложь;
		ВидПродукцииИспользуетГрупповыеУпаковки	 = Ложь;
		КомплектующиеМогутБытьНанесеныНезависимо = Ложь;
	КонецПопытки;
	
	Попытка
		ЭлементыФормы.Номенклатура.АвтоОтметкаНезаполненного = ОтчетПроизводственнойЛинии И (ЭтоИмпортСФТС Или Форма.Объект.СоздаватьШтрихкодыУпаковок);
	Исключение
		// Адаптация к старым релизам
	КонецПопытки;
	
	ЭлементыФормы.ТоварыЗагрузитьДанныеИзТСД.Видимость     = Не ЭтоАгрегация;
	ЭлементыФормы.ТоварыЗагрузитьИзВнешнегоФайла.Видимость = Не ЭтоАгрегация;
	
	ЭлементыФормы.ДатаДекларации.Видимость                 = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.ДатаДекларацииЗаголовок.Видимость        = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	
	ЭлементыФормы.РегистрационныйНомерДекларации.Видимость = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.ВариантЗаполненияДекларации.Видимость    = ЭтоИмпортСФТС И Не ЭтоМех;
	ЭлементыФормы.ВариантФормированияАТКИСМП.Видимость     = ЭтоИмпортСФТС И Не ЭтоМех;
	ЭлементыФормы.ВариантФормированияАТКИСМП.Доступность   = ЭтоИмпортСФТС И ПередаватьВДекларациюАТК И Не ЭтоМех;
	
	ЭлементыФормы.КодТаможенногоОргана.Видимость           = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	ЭлементыФормы.КодТаможенногоОрганаЗаголовок.Видимость  = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
	
	ЭлементыФормы.ПринятоеРешение.Видимость                = ЭтоПроизводствоВнеЕАЭС Или ЭтоИмпортСФТС;
