///////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции:
// - для вызова методов интеграционной обработки;
// - для обработки форм документов, загружаемых из Mobile Smarts;
// - прочее.
///////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем ПередаваемыеПараметры Экспорт;

// Вызывает метод интеграционной обработки и возвращает флаг успешности его выполнения
//
// Параметры:
//	ИмяМетода - Строка - имя вызываемого метода		
//	СтруктураПараметров - Структура, Неопределено - содержит параметры вызываемого метода
//	Результат - Произвольный - результат выполнения вызываемого метода
//	ОписаниеОшибки - Строка - описание ошибки при выполнении вызываемого метода
//
// Возвращаемое значение:
//	Булево
&НаСервере
Функция ВызватьМетодИнтеграционнойОбработки(ИмяМетода,СтруктураПараметров=Неопределено,Результат=Неопределено,ОписаниеОшибки = "") Экспорт
	
	Попытка
		//Выполнить("Результат = пОбработка."+ИмяМетода+?(СтруктураПараметров = Неопределено,"()","(СтруктураПараметров)"));
	Исключение
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

// Вызывает процедуру формы интеграционной обработки (замена конструкции "Выполнить" при вызове обработчика после открытия формы документа в ОО)
//
// Параметры:
//	ИмяПроцедуры - Строка - имя вызываемой процедуры
//	СтруктураПараметров - Структура, Неопределено - содержит параметры вызываемого метода
//
// Возвращаемое значение:
//	Структура - результат выполнения процедуры:
//		* ИнфоОбОшибке - ИнформацияОбОшибке - информация об ошибке
//		* ТекстОшибки - Строка - подробное представление об ошибке
//
&НаКлиенте
Функция ВыполнитьОбработчик_ПослеОткрытияФормыДокумента(ИмяПроцедуры, СтруктураПараметров) Экспорт
	
	ИнфоОбОшибке 	= Неопределено;
	ТекстОшибки 	= "";
	
	ПередаваемыеПараметры = СтруктураПараметров;
	
	Попытка
		ПодключитьОбработчикОжидания(ИмяПроцедуры, 0.1, Истина);
	Исключение
		ИнфоОбОшибке 	= ИнформацияОбОшибке();
		ТекстОшибки 	= ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
	КонецПопытки;
	
	СтруктураВыполнения = Новый Структура;
	СтруктураВыполнения.Вставить("ИнфоОбОшибке", 	ИнфоОбОшибке);
	СтруктураВыполнения.Вставить("ТекстОшибки", 	ТекстОшибки);
	
	Возврат СтруктураВыполнения;
	
КонецФункции

#Область Обработчики_ПослеОткрытияФормыДокумента

// Используется для обработки данных и настройки элементов формы документа, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_2_Общий_ПослеОткрытияФормыДокумента						(СтруктураПараметров) Экспорт

	Форма 				= СтруктураПараметров.ФормаДокумента;
	СсылкаНаДокумент 	= СтруктураПараметров.СсылкаНаДокумент;		
	ТипДокументаСтрокой = ПолучитьИмяТипаДокумента(СсылкаНаДокумент);		
	
	МассивИменТабличныхЧастейТовары = ПолучитьМассивИменТабличныхЧастейТовары(Форма.Объект, ТипДокументаСтрокой);															
	
	МассивНоменклатуры	= Новый Массив;			
	Для каждого ИмяТабличнойЧасти Из МассивИменТабличныхЧастейТовары Цикл		
		// т.к. в табличной части может не оказаться реквизита "Номенклатура", то ставим попытку и переходим к следующей ТЧ						
		Попытка
			Для каждого Стр Из Форма.Объект[ИмяТабличнойЧасти] Цикл											
				Если МассивНоменклатуры.Найти(Стр.Номенклатура) = Неопределено Тогда
					МассивНоменклатуры.Добавить(Стр.Номенклатура);
				КонецЕсли;	
			КонецЦикла;		
		Исключение
			Продолжить;
		КонецПопытки; 
	КонецЦикла; 
	
	СписокИменРеквизитов = Новый СписокЗначений;
	СписокИменРеквизитов.Добавить("ВидНоменклатуры.ИспользоватьХарактеристики", "ХарактеристикиИспользуются");
	СписокИменРеквизитов.Добавить("ВестиУчетПоГТД", 							"ВедетсяУчетПоГТД");
	СписокИменРеквизитов.Добавить("ТипНоменклатуры",							"ТипНоменклатуры");			
	
	СоответствиеСсылокИРеквизитовНоменклатуры = ПолучитьЗначенияРеквизитовМассиваОбъектов("Номенклатура", МассивНоменклатуры, СписокИменРеквизитов);
	
	Для каждого ИмяТабличнойЧасти Из МассивИменТабличныхЧастейТовары Цикл					
		Для каждого Стр Из Форма.Объект[ИмяТабличнойЧасти] Цикл
			Если СоответствиеСсылокИРеквизитовНоменклатуры[Стр.Номенклатура] <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Стр, СоответствиеСсылокИРеквизитовНоменклатуры[Стр.Номенклатура]);
			КонецЕсли;
		КонецЦикла;									
	КонецЦикла; 
		
	ДокументОбъект = Форма.Объект;
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре(ДокументОбъект);
	
	//Не в каждом документе используются серии, по этому ставим попытку	
	Попытка
		ПараметрыУказанияСерий = УТ_11_2_ПодготовитьЗаполнитьУстановитьВидимостьСерий(ДокументОбъект, ТипДокументаСтрокой);					
			
		УТ_11_2_УстановитьВидимостьЭлементовСерий(ДокументОбъект, Форма.Элементы, ПараметрыУказанияСерий, ТипДокументаСтрокой);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	
	Попытка
		КопироватьДанныеФормы(ДокументОбъект, Форма.Объект);				
	Исключение
	КонецПопытки;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре(ФормаОбъект, ИмяТЧ = "Товары", ПараметрыЗаполненияРеквизитов = Неопределено)
	
	Если НЕ ФормаОбъект.Свойство(ИмяТЧ) Тогда Возврат; КонецЕсли;
	
	Если НЕ ФормаОбъект[ИмяТЧ].Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыЗаполненияРеквизитов = Неопределено Тогда
		ОбщегоНазначения.ОбщийМодуль("НоменклатураСервер").ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(ФормаОбъект[ИмяТЧ], ПараметрыЗаполненияРеквизитов);
		Возврат;
	КонецЕсли;
	
	ГуидХарактеристикиИспользуются = Новый УникальныйИдентификатор();
	ГуидТипНоменклатуры			   = Новый УникальныйИдентификатор();
	ГуидАртикул					   = Новый УникальныйИдентификатор();
	СтруктураДляПроверки = Новый Структура("ХарактеристикиИспользуются, ТипНоменклатуры, Артикул", ГуидХарактеристикиИспользуются, ГуидТипНоменклатуры, ГуидАртикул);
			
	ЗаполнитьЗначенияСвойств(СтруктураДляПроверки, ФормаОбъект[ИмяТЧ][0]);
		
	ЕстьРеквизитХарактеристикиИспользуются 	= СтруктураДляПроверки["ХарактеристикиИспользуются"] <> ГуидХарактеристикиИспользуются;
	ЕстьРеквизитТипНоменклатуры				= СтруктураДляПроверки["ТипНоменклатуры"] 			 <> ГуидТипНоменклатуры;
	ЕстьРеквизитАртикул						= СтруктураДляПроверки["Артикул"] 					 <> ГуидАртикул;
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	
	Если ЕстьРеквизитХарактеристикиИспользуются Тогда
		ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	КонецЕсли;											
	Если ЕстьРеквизитТипНоменклатуры Тогда										
		ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	КонецЕсли;										
	Если ЕстьРеквизитАртикул Тогда
		ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	КонецЕсли;
	
	ОбщегоНазначения.ОбщийМодуль("НоменклатураСервер").ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(ФормаОбъект[ИмяТЧ], ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ПоступлениеТоваровУслуг, загруженного из базы Mobile Smarts.
//
&НаКлиенте
Процедура УТ_11_2_ПоступлениеТоваровУслуг_ПослеОткрытияФормыДокумента	() Экспорт

	ИмяСобытия = "УТ_11_2_ПоступлениеТоваровУслуг_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);	
		
		Форма 		   = СтруктураПараметров.ФормаДокумента;
		ДокументОбъект = Форма.Объект;
		ЭлементыФормы  = Форма.Элементы;
		
		УТ_11_4_УстановитьДоступностьСоглашений(ДокументОбъект, ЭлементыФормы);
		УТ_11_4_УстановитьДоступностьДоговора(ДокументОбъект, ЭлементыФормы.Договор.Доступность, ЭлементыФормы.Договор.Видимость, ДокументОбъект.Договор);
		УТ_11_4_УстановитьНадписьЭтапыОплаты(Форма);
		
		КоллекцияТовары  = ДокументОбъект.Товары;
		Форма.СуммаВсего = КоллекцияТовары.Итог("СуммаСНДС");
		Форма.СуммаНДС 	 = КоллекцияТовары.Итог("СуммаНДС");
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Используется для обработки данных и настройки элементов формы документа ЗаказПоставщику, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте 
Процедура УТ_11_2_ЗаказПоставщику_ПослеОткрытияФормыДокумента			() Экспорт
	
	ИмяСобытия = "УТ_11_2_ЗаказПоставщику_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;
		ЭлементыФормы  = Форма.Элементы;
		ДокументОбъект = Форма.Объект;
		
		УТ_11_4_УстановитьДоступностьСоглашений(ДокументОбъект, ЭлементыФормы);
		УТ_11_4_УстановитьДоступностьДоговора(ДокументОбъект, ЭлементыФормы.Договор.Доступность, ЭлементыФормы.Договор.Видимость, ДокументОбъект.Договор);	
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры	

// Используется для обработки данных и настройки элементов формы документа ПересчетТоваров, загруженного из базы Mobile Smarts.
//
// Параметры:
//	СтруктураПараметров - Структура - содержит:	
//		* НастройкаБизнесПроцесса - Структура - содержит настройку бизнес-процесса, используемого при загрузке
//		* СсылкаНаДокумент - ДокументСсылка - ссылка на загружаемый документ
//		* ФормаДокумента - ФормаКлиентскогоПриложения - обрабатываемая форма
&НаКлиенте
Процедура УТ_11_2_ПересчетТоваров_ПослеОткрытияФормыДокумента			() Экспорт
	
	ИмяСобытия = "УТ_11_2_ПересчетТоваров_ПослеОткрытияФормыДокумента";
	
	СтруктураПараметров = ПередаваемыеПараметры;
	Если СтруктураПараметров = Неопределено Тогда
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", "Ошибка получения структуры параметров в обработчике " + ИмяСобытия);
		Возврат;
	КонецЕсли;

	Попытка
		
		УТ_11_2_Общий_ПослеОткрытияФормыДокумента(СтруктураПараметров);
		
		Форма = СтруктураПараметров.ФормаДокумента;
		
		тчТовары = Форма.Объект.Товары;
		
		// **************************************************************************************								
		
		МассивНоменклатуры	= Новый Массив;			
		Для каждого Стр Из тчТовары Цикл
			Если МассивНоменклатуры.Найти(Стр.Номенклатура) = Неопределено Тогда
				МассивНоменклатуры.Добавить(Стр.Номенклатура);
			КонецЕсли;	
		КонецЦикла;
		
		СписокИменРеквизитов = Новый СписокЗначений;		
		СписокИменРеквизитов.Добавить("Артикул", "Артикул");
		СписокИменРеквизитов.Добавить("ТипНоменклатуры", "ТипНоменклатуры");
		
		СоответствиеСсылокИРеквизитовНоменклатуры = ПолучитьЗначенияРеквизитовМассиваОбъектов("Номенклатура", МассивНоменклатуры, СписокИменРеквизитов);				
		
		// **************************************************************************************							
		
		МассивУпаковок	= Новый Массив;			
		Для каждого Стр Из тчТовары Цикл
			Если МассивУпаковок.Найти(Стр.Упаковка) = Неопределено Тогда
				МассивУпаковок.Добавить(Стр.Упаковка);
			КонецЕсли;	
		КонецЦикла;
		
		СписокИменРеквизитов = Новый СписокЗначений;
		СписокИменРеквизитов.Добавить("ТипИзмеряемойВеличины", "ТипИзмеряемойВеличины");			
		
		СоответствиеСсылокИРеквизитовУпаковок = ПолучитьЗначенияРеквизитовМассиваОбъектов("УпаковкиЕдиницыИзмерения", МассивУпаковок, СписокИменРеквизитов);								
		
		// **************************************************************************************
		
		Для Каждого СтрТабл из тчТовары Цикл
			
			СтрТабл.Расхождение = СтрТабл.КоличествоФакт <> СтрТабл.Количество Или СтрТабл.КоличествоУпаковок <> СтрТабл.КоличествоУпаковокФакт;
			СтрТабл.КоличествоУпаковокОтклонение = СтрТабл.КоличествоУпаковокФакт - СтрТабл.КоличествоУпаковок;
			
			СтрТабл.ТипНоменклатуры = СоответствиеСсылокИРеквизитовНоменклатуры[СтрТабл.Номенклатура].ТипНоменклатуры;
