			ЭлементыФормы.ЗаказПодДеятельность,
			ДокументОбъект.ЗаказПодДеятельность,
			ДокументОбъект,
			"ЗаказНаПроизводство2_2");
		
		Попытка
			КопироватьДанныеФормы(ДокументОбъект, ФормаДокумента.Объект);				
		Исключение
			//	
		КонецПопытки;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка выполнения обработчика " + ИмяСобытия + Символы.ПС + ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ЗаписатьСобытиеВЖурналРегистрации(ИмяСобытия, "Ошибка", ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

