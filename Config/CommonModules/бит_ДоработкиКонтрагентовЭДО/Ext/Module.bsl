// +++ бит Балицкий В.В. БИТ-2815 27.11.2026
#Область ДоработкиКонтрагентовЭДО

// Дополняет данные продавца УПД/УКД правилами из подключаемого модуля Диадок
// (области Винлаб, ПервыеСемейные, РЕМИ_ЭКОНОМЫЧ). Покупатель заменяется в расширении битДоработки.
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//  ДеревоДанных - ДеревоЗначений
//  ЭтоКорректировка - Булево - Истина для УКД.
//
Процедура ДополнитьДанныеПродавцаПоДоработкамКонтрагентов(Основание, ДеревоДанных, ЭтоКорректировка) Экспорт
	
	Если Не ЗначениеЗаполнено(Основание) Или ТипЗнч(ДеревоДанных) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ДополнитьДанныеПродавцаПоДоработкамКонтрагентовВнутр(Основание, ДеревоДанных, ЭтоКорректировка);
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
	Исключение
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДополнитьДанныеПродавцаПоДоработкамКонтрагентовВнутр(Основание, ДеревоДанных, ЭтоКорректировка)
	
	Контекст = КонтекстДокументовДоработкиЭДО(Основание);
	Если Не ЗначениеЗаполнено(Контекст.Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДерева = ПараметрыДереваПродавцаЭДО(ДеревоДанных);
	НаименованиеКонтрагента = Строка(РеквизитСсылкиЭДО(Контекст.Контрагент, "Наименование"));
	ГруппаКонтрагента = НаименованиеГруппыКонтрагентаЭДО(Контекст.Контрагент, 1);
	ГруппаКонтрагентаВыше = НаименованиеГруппыКонтрагентаЭДО(Контекст.Контрагент, 2);
	ПартнерКонтрагента = РеквизитСсылкиЭДО(Контекст.Контрагент, "Партнер");
	НаименованиеПартнера = ?(ЗначениеЗаполнено(ПартнерКонтрагента),
		Строка(РеквизитСсылкиЭДО(ПартнерКонтрагента, "Наименование")), "");
	
	// Покупатель заменяется в расширении битДоработки (бит_ПослеЗаполненияДанныхПродавцаЭДО).
	Если Не ЭтоКорректировка Тогда
		ЗаполнитьПустойНомерДекларацииЭДО(ДеревоДанных, ПараметрыДерева);
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТаблицыДереваЭДО(ДеревоДанных, ПараметрыДерева.ПутьТоваров);
	ЭтоВинлаб = СтрНайти(НаименованиеКонтрагента, "Винлаб") > 0;
	ЭтоПервыеСемейные = СтрНайти(ГруппаКонтрагента, "Первые семейные") > 0
		Или СтрНайти(НаименованиеПартнера, "Первые семейные") > 0;
	ЭтоРеми = СтрНайти(НаименованиеПартнера, "реми") > 0
		Или СтрНайти(НаименованиеПартнера, "РЕМИ") > 0
		Или СтрНайти(НаименованиеПартнера, "ЭКОНОМЫЧ") > 0
		Или СтрНайти(ГруппаКонтрагента, "реми") > 0
		Или СтрНайти(ГруппаКонтрагента, "РЕМИ") > 0
		Или СтрНайти(ГруппаКонтрагентаВыше, "реми") > 0
		Или СтрНайти(ГруппаКонтрагентаВыше, "РЕМИ") > 0
		Или СтрНайти(ГруппаКонтрагентаВыше, "ЭКОНОМЫЧ") > 0
		Или СтрНайти(ГруппаКонтрагента, "ЭКОНОМЫЧ") > 0;
	
	#Область Винлаб
	
	Если ЭтоВинлаб Тогда
		Если ЭтоКорректировка Тогда
			Заказ = НомерЗаказаИзКомментарияЭДО(Контекст.КомментарийИсходногоДокумента, Ложь);
			// В модуле Диадок сравнение записано как Заказ <> 1: строка "1" совпадает с числом 1.
			Если Заказ <> "1" И ЗначениеЗаполнено(Контекст.СделкаИсходногоДокумента) Тогда
				// Сделка.Дата в доработке Диадок. В УТ 11 у сделки заполняется ДатаНачала.
				ДатаЗаказа = Формат(ДатаСделкиЭДО(Контекст.СделкаИсходногоДокумента), "ДФ=dd.MM.yyyy");
			ИначеЕсли Заказ <> "1" Тогда
				ДатаЗаказа = "1";
			Иначе
				ДатаЗаказа = Формат(Контекст.ДатаИсходногоСчетаФактуры, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			
			ПоляШапки = Новый Структура;
			ПоляШапки.Вставить("номер_заказа", Заказ);
			ПоляШапки.Вставить("дата_заказа", Строка(ДатаЗаказа));
			ПоляШапки.Вставить("номер_накладной", СокрЛП(Контекст.НомерИсходногоСчетаФактуры));
			ДобавитьИнформационныеПоляШапкиЭДО(ДеревоДанных, ПараметрыДерева.ПутьШапки, ПоляШапки);
		Иначе
			Заказ = НомерЗаказаИзКомментарияЭДО(Контекст.КомментарийСделки, Истина);
			ПоляШапки = Новый Структура;
			ПоляШапки.Вставить("номер_заказа", Заказ);
			ПоляШапки.Вставить("номер_накладной", СокрЛП(Контекст.НомерДокумента));
			ДобавитьИнформационныеПоляШапкиЭДО(ДеревоДанных, ПараметрыДерева.ПутьШапки, ПоляШапки);
		КонецЕсли;
		
		Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
			Номенклатура = НоменклатураСтрокиЭДО(СтрокаТовара);
			ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, "штрихкод", ШтрихкодНоменклатурыЭДО(Номенклатура));
			Если ЭтоКорректировка Тогда
				СкорректироватьСтрокуУКДЭДО(СтрокаТовара);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ПервыеСемейные
	
	Если ЭтоПервыеСемейные Тогда
		Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
			Номенклатура = НоменклатураСтрокиЭДО(СтрокаТовара);
			ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, "штрихкод", ШтрихкодНоменклатурыЭДО(Номенклатура));
		КонецЦикла;
	КонецЕсли;
	
	#КонецОбласти
	
	#Область РЕМИ_ЭКОНОМЫЧ
	
	Если ЭтоРеми Тогда
		GLN = "";
		Партнер = Неопределено;
		Если Метаданные.Справочники.Найти("КонтурEDI_ТочкиДоставки") <> Неопределено Тогда
			GLN = GLNПоАдресуДоставкиЭДО(Контекст.АдресДоставки);
			Партнер = ПартнерПоGLNЭДО(GLN);
		Иначе
			Партнер = РеквизитСсылкиЭДО(Контекст.Контрагент, "Партнер");
		КонецЕсли;
		
		Если Не ЭтоКорректировка Тогда
			Заказ = НомерЗаказаИзКомментарияЭДО(Контекст.КомментарийСделки, Истина);
			ПоляШапки = Новый Структура;
			ПоляШапки.Вставить("номер_заказа", Заказ);
			ПоляШапки.Вставить("номер_накладной", СокрЛП(Контекст.НомерДокумента));
			ПоляШапки.Вставить("GLN_грузополучателя", GLN);
			ДобавитьИнформационныеПоляШапкиЭДО(ДеревоДанных, ПараметрыДерева.ПутьШапки, ПоляШапки);
		КонецЕсли;
		
		НомерПозиции = 1;
		Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
			Номенклатура = НоменклатураСтрокиЭДО(СтрокаТовара);
			ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, "код_материала", КодМатериалаЭДО(Номенклатура, Партнер));
			ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, "позиция_заказа", Строка(НомерПозиции));
			ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, "штрихкод", ШтрихкодНоменклатурыЭДО(Номенклатура));
			НомерПозиции = НомерПозиции + 1;
		КонецЦикла;
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

// Покупатель для доработок: при УКД - по грузополучателю, при УПД - покупатель документа отгрузки.
//
// Параметры:
//  Контекст - Структура - см. КонтекстДокументовДоработкиЭДО.
//  ЭтоКорректировка - Булево - Истина для УКД.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты, СправочникСсылка.Организации, Неопределено.
//
Функция ПокупательДляДоработки(Контекст, ЭтоКорректировка) Экспорт

	Покупатель = Неопределено;
	Если ЭтоКорректировка Тогда
		Покупатель = ПокупательДляУКД(Контекст);
	Иначе
		Покупатель = ПокупательДокументаЭДО(Контекст.ДокументОтгрузки);
		Если Не ЗначениеЗаполнено(Покупатель) Тогда
			Покупатель = Контекст.Контрагент;
		КонецЕсли;
	КонецЕсли;

	Возврат Покупатель;

КонецФункции

Функция КонтекстДокументовДоработкиЭДО(Основание) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("СчетФактура", Документы.СчетФактураВыданный.ПустаяСсылка());
	Контекст.Вставить("ИсходныйСчетФактура", Документы.СчетФактураВыданный.ПустаяСсылка());
	Контекст.Вставить("ДокументОтгрузки", Неопределено);
	Контекст.Вставить("ДокументИсходнойОтгрузки", Неопределено);
	Контекст.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Контекст.Вставить("Дата", Дата(1, 1, 1));
	Контекст.Вставить("ДатаИсходногоСчетаФактуры", Дата(1, 1, 1));
	Контекст.Вставить("НомерДокумента", "");
	Контекст.Вставить("НомерИсходногоСчетаФактуры", "");
	Контекст.Вставить("КомментарийСделки", "");
	Контекст.Вставить("КомментарийИсходногоДокумента", "");
	Контекст.Вставить("СделкаИсходногоДокумента", Неопределено);
	Контекст.Вставить("АдресДоставки", "");
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Контекст.СчетФактура = Основание;
		Контекст.ДокументОтгрузки = ДокументОснованиеСчетаФактурыЭДО(Основание);
		Контекст.ИсходныйСчетФактура = Основание.СчетФактураОснование;
	Иначе
		Контекст.ДокументОтгрузки = Основание;
		Контекст.СчетФактура = СчетФактураПоДокументуОтгрузкиЭДО(Основание);
		Если ЗначениеЗаполнено(Контекст.СчетФактура) Тогда
			Контекст.ИсходныйСчетФактура = Контекст.СчетФактура.СчетФактураОснование;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контекст.ИсходныйСчетФактура) Тогда
		Контекст.ДокументИсходнойОтгрузки = ДокументОснованиеСчетаФактурыЭДО(Контекст.ИсходныйСчетФактура);
		Контекст.НомерИсходногоСчетаФактуры = Контекст.ИсходныйСчетФактура.Номер;
		Контекст.ДатаИсходногоСчетаФактуры = Контекст.ИсходныйСчетФактура.Дата;
	Иначе
		Контекст.ДокументИсходнойОтгрузки = Контекст.ДокументОтгрузки;
		// ИсправляемыйСчетФактура.ДокументОснование в доработке Диадок.
		Если ТипЗнч(Контекст.ДокументОтгрузки) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			ДокументИсходнойОтгрузки = Контекст.ДокументОтгрузки;
			Для Счетчик = 1 По 10 Цикл
				Если ТипЗнч(ДокументИсходнойОтгрузки) <> Тип("ДокументСсылка.КорректировкаРеализации") Тогда
					Прервать;
				КонецЕсли;
				СледующийДокумент = ДокументРеализацииПокупателяЭДО(ДокументИсходнойОтгрузки);
				Если Не ЗначениеЗаполнено(СледующийДокумент) Или СледующийДокумент = ДокументИсходнойОтгрузки Тогда
					Прервать;
				КонецЕсли;
				ДокументИсходнойОтгрузки = СледующийДокумент;
			КонецЦикла;
			Контекст.ДокументИсходнойОтгрузки = ДокументИсходнойОтгрузки;
			ИсходныйСчетФактура = СчетФактураПоДокументуОтгрузкиЭДО(ДокументИсходнойОтгрузки);
			Если ЗначениеЗаполнено(ИсходныйСчетФактура) Тогда
				Контекст.НомерИсходногоСчетаФактуры = ИсходныйСчетФактура.Номер;
				Контекст.ДатаИсходногоСчетаФактуры = ИсходныйСчетФактура.Дата;
			Иначе
				Контекст.НомерИсходногоСчетаФактуры = Строка(РеквизитСсылкиЭДО(ДокументИсходнойОтгрузки, "Номер"));
				ДатаИсходногоДокумента = РеквизитСсылкиЭДО(ДокументИсходнойОтгрузки, "Дата");
				Если ТипЗнч(ДатаИсходногоДокумента) = Тип("Дата") Тогда
					Контекст.ДатаИсходногоСчетаФактуры = ДатаИсходногоДокумента;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Контекст.Контрагент = Основание.Контрагент;
		Контекст.НомерДокумента = Основание.Номер;
		Контекст.Дата = Основание.Дата;
	ИначеЕсли РеквизитЕстьЭДО(Основание, "Контрагент") Тогда
		Контекст.Контрагент = РеквизитСсылкиЭДО(Основание, "Контрагент");
		Контекст.НомерДокумента = РеквизитСсылкиЭДО(Основание, "Номер");
		Контекст.Дата = РеквизитСсылкиЭДО(Основание, "Дата");
	КонецЕсли;
	
	Сделка = РеквизитСсылкиЭДО(Контекст.ДокументОтгрузки, "Сделка");
	Если ЗначениеЗаполнено(Сделка) Тогда
		Контекст.КомментарийСделки = РеквизитСсылкиЭДО(Сделка, "Комментарий");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контекст.ДокументИсходнойОтгрузки) Тогда
		Контекст.КомментарийИсходногоДокумента = РеквизитСсылкиЭДО(Контекст.ДокументИсходнойОтгрузки, "Комментарий");
		Контекст.СделкаИсходногоДокумента = РеквизитСсылкиЭДО(Контекст.ДокументИсходнойОтгрузки, "Сделка");
	КонецЕсли;
	Контекст.АдресДоставки = РеквизитСсылкиЭДО(Контекст.ДокументОтгрузки, "АдресДоставки");
	
	Возврат Контекст;
	
КонецФункции

Функция ПокупательДляУКД(Контекст)
	
	ДокументОснованиеИсходногоСчета = Контекст.ДокументИсходнойОтгрузки;
	Если ТипЗнч(ДокументОснованиеИсходногоСчета) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ДокументСравнения = ДокументРеализацииПокупателяЭДО(ДокументОснованиеИсходногоСчета);
	Иначе
		ДокументСравнения = ДокументОснованиеИсходногоСчета;
	КонецЕсли;
	
	Если Не РеквизитЕстьЭДО(ДокументСравнения, "Грузополучатель") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Грузополучатель = РеквизитСсылкиЭДО(ДокументСравнения, "Грузополучатель");
	ПокупательСравнения = ПокупательДокументаЭДО(ДокументСравнения);
	Если Грузополучатель = ПокупательСравнения Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИсточникПокупателя = ДокументРеализацииПокупателяЭДО(Контекст.ДокументОтгрузки);
	Покупатель = ПокупательДокументаЭДО(ИсточникПокупателя);
	Если Не ЗначениеЗаполнено(Покупатель) Тогда
		Покупатель = ПокупательСравнения;
	КонецЕсли;
	
	Возврат Покупатель;
	
КонецФункции

Функция ДокументРеализацииПокупателяЭДО(Документ)
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ИсправляемыйДокументРеализации в доработке Диадок.
	// В типовой УТ 11 у корректировки реализации реквизит называется ИсправляемыйДокумент.
	ИсправленнаяРеализация = РеквизитСсылкиЭДО(Документ, "ИсправляемыйДокументРеализации");
	Если Не ЗначениеЗаполнено(ИсправленнаяРеализация) Тогда
		ИсправленнаяРеализация = РеквизитСсылкиЭДО(Документ, "ИсправляемыйДокумент");
	КонецЕсли;
	Если ЗначениеЗаполнено(ИсправленнаяРеализация) Тогда
		Возврат ИсправленнаяРеализация;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ОснованиеКорректировки = РеквизитСсылкиЭДО(Документ, "ДокументОснование");
		Если ЗначениеЗаполнено(ОснованиеКорректировки) Тогда
			Возврат ОснованиеКорректировки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Документ;
	
КонецФункции

