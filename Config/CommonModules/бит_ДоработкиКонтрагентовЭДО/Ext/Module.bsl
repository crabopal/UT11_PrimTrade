Функция ПараметрыДереваПродавцаЭДО(ДеревоДанных) Экспорт
	
	ПараметрыДерева = Новый Структура;
	ПараметрыДерева.Вставить("Формат502", Ложь);
	ПараметрыДерева.Вставить("ПутьШапки", "ДопДанныеСчетаФактуры.ТекстоваяИнформация");
	ПараметрыДерева.Вставить("ПутьТоваров", "СведенияОТоварах");
