Функция ПартнерПоGLNЭДО(GLN)
	
	Если Не ЗначениеЗаполнено(GLN)
		Или Метаданные.Справочники.Найти("КонтурEDI_ТочкиДоставки") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТочкиДоставки.Партнер КАК Партнер
	|ИЗ
	|	Справочник.ПодставляемыйСправочник КАК ТочкиДоставки
	|ГДЕ
	|	ТочкиДоставки.GLN = &GLN";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПодставляемыйСправочник", "КонтурEDI_" + "ТочкиДоставки");
	Запрос.УстановитьПараметр("GLN", GLN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Партнер;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция КодМатериалаЭДО(Номенклатура, Партнер)
	
	КодПоУмолчанию = "00000";
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат КодПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Партнер)
		И Метаданные.РегистрыСведений.Найти("КонтурEDI_СоответствияТоваров") <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоответствияТоваров.КодТовараПартнера КАК КодМатериала
		|ИЗ
		|	РегистрСведений.ПодставляемыйРегистр КАК СоответствияТоваров
		|ГДЕ
		|	СоответствияТоваров.Номенклатура = &Номенклатура
		|	И СоответствияТоваров.Партнер = &Партнер";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПодставляемыйРегистр", "КонтурEDI_" + "СоответствияТоваров");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("Партнер", Партнер);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КодМатериала) Тогда
			Возврат СокрЛП(Выборка.КодМатериала);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Партнер) <> Тип("СправочникСсылка.Партнеры") Или Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат КодПоУмолчанию;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НоменклатураКонтрагентов.Артикул КАК Артикул,
	|	НоменклатураКонтрагентов.Код КАК Код
	|ИЗ
	|	Справочник.НоменклатураКонтрагентов КАК НоменклатураКонтрагентов
	|ГДЕ
	|	НоменклатураКонтрагентов.Владелец = &Партнер
	|	И НоменклатураКонтрагентов.Номенклатура = &Номенклатура
	|	И НЕ НоменклатураКонтрагентов.ПометкаУдаления";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Артикул) Тогда
			Возврат СокрЛП(Выборка.Артикул);
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(Выборка.Код)) Тогда
			Возврат СокрЛП(Выборка.Код);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КодПоУмолчанию;
	
КонецФункции

Функция ДатаСделкиЭДО(Сделка)
	
	Если РеквизитЕстьЭДО(Сделка, "Дата") Тогда
		ДатаСделки = РеквизитСсылкиЭДО(Сделка, "Дата");
	ИначеЕсли РеквизитЕстьЭДО(Сделка, "ДатаНачала") Тогда
		ДатаСделки = РеквизитСсылкиЭДО(Сделка, "ДатаНачала");
	Иначе
		ДатаСделки = Дата(1, 1, 1);
	КонецЕсли;
	
	Если ТипЗнч(ДатаСделки) <> Тип("Дата") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат ДатаСделки;
	
КонецФункции

Функция НомерЗаказаИзКомментарияЭДО(Комментарий, ВключатьРазделитель)
	
	Если Не ЗначениеЗаполнено(Комментарий) Тогда
		Возврат "1";
	КонецЕсли;
	
	ПозицияРазделителя = СтрНайти(Комментарий, ";");
	Если ПозицияРазделителя = 0 Тогда
		Возврат "1";
	КонецЕсли;
	
	Если ВключатьРазделитель Тогда
		Возврат Лев(Комментарий, ПозицияРазделителя);
	КонецЕсли;
	
	Возврат Лев(Комментарий, ПозицияРазделителя - 1);
	
КонецФункции

Функция НаименованиеГруппыКонтрагентаЭДО(Контрагент, Уровень)
	
	// Контрагент.Родитель в доработке Диадок.
	// В типовой УТ 11 справочник Контрагенты неиерархический, группа читается у партнера.
	ТекущаяГруппа = Контрагент;
	Если Не РеквизитЕстьЭДО(Контрагент, "Родитель") Тогда
		ТекущаяГруппа = РеквизитСсылкиЭДО(Контрагент, "Партнер");
	КонецЕсли;
	
	Для Индекс = 1 По Уровень Цикл
		Если Не ЗначениеЗаполнено(ТекущаяГруппа) Или Не РеквизитЕстьЭДО(ТекущаяГруппа, "Родитель") Тогда
			Возврат "";
		КонецЕсли;
		ТекущаяГруппа = РеквизитСсылкиЭДО(ТекущаяГруппа, "Родитель");
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекущаяГруппа) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяГруппа, "Наименование"));
	
КонецФункции

Функция РеквизитЕстьЭДО(Ссылка, ИмяРеквизита)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат МетаданныеОбъекта.СтандартныеРеквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
КонецФункции

Функция РеквизитСсылкиЭДО(Ссылка, ИмяРеквизита)
	
	Если Не РеквизитЕстьЭДО(Ссылка, ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
	
КонецФункции

