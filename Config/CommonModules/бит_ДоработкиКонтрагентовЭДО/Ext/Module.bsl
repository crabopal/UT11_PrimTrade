	ПараметрыДерева.Вставить("ИмяНомераДекларации", "ТаможеннаяДекларацияНомер");
	
	Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация") Тогда
		ПараметрыДерева.Формат502 = Истина;
		ПараметрыДерева.ПутьШапки = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
		ПараметрыДерева.ПутьТоваров = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
		ПараметрыДерева.ИмяТаблицыДекларации = "СведенияОДекларации";
		ПараметрыДерева.ИмяНомераДекларации = "НомерДекларации";
