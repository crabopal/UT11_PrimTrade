Процедура ЗаполнитьПустойНомерДекларацииЭДО(ДеревоДанных, ПараметрыДерева)
	
	Для Каждого СтрокаТовара Из СтрокиТаблицыДереваЭДО(ДеревоДанных, ПараметрыДерева.ПутьТоваров) Цикл
		ПутьДекларации = СтрокаТовара.ПолныйПуть + "." + ПараметрыДерева.ИмяТаблицыДекларации;
		УзелДеклараций = СтрокаТовара.Строки.Найти(ПутьДекларации, "ПолныйПуть", Истина);
		Если УзелДеклараций = Неопределено Или Не ЗначениеЗаполнено(УзелДеклараций.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДекларации Из УзелДеклараций.Строки Цикл
			Если ТипЗнч(СтрокаДекларации.Значение) <> Тип("Число") Или СтрокаДекларации.Значение = 0 Тогда
				Продолжить;
			КонецЕсли;
			ПутьНомера = СтрокаДекларации.ПолныйПуть + "." + ПараметрыДерева.ИмяНомераДекларации;
			НомерДекларации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаДекларации, ПутьНомера, Ложь);
			Если НомерДекларации = Неопределено Или Не ЗначениеЗаполнено(НомерДекларации) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(СтрокаДекларации, ПутьНомера, "-");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИнформационныеПоляШапкиЭДО(ДеревоДанных, Путь, Поля)
	
	Если Не ЗначениеЗаполнено(Путь)
		Или Не ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, Путь) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстоваяИнформация = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
	Для Каждого Поле Из Поля Цикл
		СтрокаИнформации = ТекстоваяИнформация.Добавить();
		СтрокаИнформации.Идентификатор = Поле.Ключ;
		СтрокаИнформации.Значение = Строка(Поле.Значение);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстоваяИнформация) Тогда
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТекстоваяИнформация, Путь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьИнформационноеПолеСтрокиЭДО(СтрокаТовара, Идентификатор, Значение)
	
	ПутьДопДанных = СтрокаТовара.ПолныйПуть + ".ДопДанныеПодписанные";
	УзелДопДанных = СтрокаТовара.Строки.Найти(ПутьДопДанных, "ПолныйПуть", Истина);
	Если УзелДопДанных = Неопределено Или УзелДопДанных.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяСтрока = УзелДопДанных.Строки[0];
	Если ТипЗнч(УзелДопДанных.Значение) = Тип("Число") И УзелДопДанных.Значение > 0 Тогда
		НоваяСтрока = УзелДопДанных.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПерваяСтрока);
		НоваяСтрока.ПолныйПуть = ПутьДопДанных + ".НомерСтроки";
		ДеревоЭлектронногоДокументаБЭД.СкопироватьСтрокиДереваРекурсивно(НоваяСтрока, ПерваяСтрока);
		НомерСтроки = УзелДопДанных.Значение + 1;
	Иначе
		НоваяСтрока = ПерваяСтрока;
		НомерСтроки = 1;
	КонецЕсли;
	
	УзелДопДанных.Значение = НомерСтроки;
	НоваяСтрока.Значение = НомерСтроки;
	
	УзелИдентификатора = НоваяСтрока.Строки.Найти(ПутьДопДанных + ".НомерСтроки.Идентификатор", "ПолныйПуть", Истина);
	УзелЗначения = НоваяСтрока.Строки.Найти(ПутьДопДанных + ".НомерСтроки.Значение", "ПолныйПуть", Истина);
	Если УзелИдентификатора <> Неопределено Тогда
		УзелИдентификатора.Значение = Идентификатор;
	КонецЕсли;
	Если УзелЗначения <> Неопределено Тогда
		УзелЗначения.Значение = Строка(Значение);
	КонецЕсли;
	
КонецПроцедуры

Процедура СкорректироватьСтрокуУКДЭДО(СтрокаТовара)
	
	Путь = СтрокаТовара.ПолныйПуть;
	
	ПутьКодаДо = Путь + ".ЕдиницаИзмеренияКодДоКорректировки";
	ПутьКодаПосле = Путь + ".ЕдиницаИзмеренияКод";
	Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(СтрокаТовара, ПутьКодаДо)
		И ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(СтрокаТовара, ПутьКодаПосле) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(СтрокаТовара, ПутьКодаПосле,
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, ПутьКодаДо, Ложь));
	КонецЕсли;
	
	ПутьНаименованияДо = Путь + ".НаименованиеЕдиницыИзмеренияДоКорректировки";
	ПутьНаименованияПосле = Путь + ".НаименованиеЕдиницыИзмеренияПослеКорректировки";
	Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(СтрокаТовара, ПутьНаименованияДо)
		И ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(СтрокаТовара, ПутьНаименованияПосле) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(СтрокаТовара, ПутьНаименованияПосле,
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, ПутьНаименованияДо, Ложь));
	КонецЕсли;
	
	ЗаменитьПустоеЗначениеСтрокиЭДО(СтрокаТовара, Путь + ".ЦенаЗаЕдиницуИзмерения", 0);
	ЗаменитьПустоеЗначениеСтрокиЭДО(СтрокаТовара, Путь + ".Количество", 0);
	
КонецПроцедуры

Процедура ЗаменитьПустоеЗначениеСтрокиЭДО(СтрокаДерева, Путь, ЗначениеПоУмолчанию)
	
	Если Не ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(СтрокаДерева, Путь) Тогда
		Возврат;
	КонецЕсли;
	
	Значение = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаДерева, Путь, Ложь);
	Если Значение = Неопределено Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(СтрокаДерева, Путь, ЗначениеПоУмолчанию);
	КонецЕсли;
	
КонецПроцедуры

Функция СтрокиТаблицыДереваЭДО(ДеревоДанных, ПутьТаблицы)
	
	СтрокиТаблицы = Новый Массив;
	Если Не ЗначениеЗаполнено(ПутьТаблицы) Тогда
		Возврат СтрокиТаблицы;
	КонецЕсли;
	
	УзелТаблицы = ДеревоДанных.Строки.Найти(ПутьТаблицы, "ПолныйПуть", Истина);
	Если УзелТаблицы = Неопределено Или Не ЗначениеЗаполнено(УзелТаблицы.Значение) Тогда
		Возврат СтрокиТаблицы;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из УзелТаблицы.Строки Цикл
		Если ТипЗнч(СтрокаТаблицы.Значение) = Тип("Число") И СтрокаТаблицы.Значение > 0 Тогда
			СтрокиТаблицы.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокиТаблицы;
	
КонецФункции

Функция НоменклатураСтрокиЭДО(СтрокаТовара)
	
	Путь = СтрокаТовара.ПолныйПуть;
	Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, Путь + ".Номенклатура", Ложь);
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Номенклатура;
	КонецЕсли;
	
	КодНоменклатуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, Путь + ".Код", Ложь);
	Если Не ЗначениеЗаполнено(КодНоменклатуры) Тогда
		КодНоменклатуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, Путь + ".КодТовара", Ложь);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КодНоменклатуры) Тогда
		КодНоменклатуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТовара, Путь + ".ТоварКод", Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(КодНоменклатуры) Тогда
		Возврат Справочники.Номенклатура.НайтиПоКоду(КодНоменклатуры);
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Функция ШтрихкодНоменклатурыЭДО(Номенклатура)
	
	ШтрихкодПоУмолчанию = "000000000";
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ШтрихкодПоУмолчанию;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если Метаданные.РегистрыСведений.Найти("Штрихкоды") <> Неопределено Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаписиРегистра.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ПодставляемыйРегистр КАК ЗаписиРегистра
		|ГДЕ
		|	ЗаписиРегистра.Владелец = &Владелец";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПодставляемыйРегистр", "Штрих" + "коды");
		Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|ГДЕ
		|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Штрихкод) Тогда
		Возврат СокрЛП(Выборка.Штрихкод);
	КонецЕсли;
	
	Возврат ШтрихкодПоУмолчанию;
	
КонецФункции

