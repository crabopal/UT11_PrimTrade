#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ФорматДокумента.СписокВыбора.Очистить();
	Элементы.ФорматДокумента.СписокВыбора.Добавить("УПД_5_03", НСтр("ru = 'УПД 5.03 (информация продавца)'"));
	Элементы.ФорматДокумента.СписокВыбора.Добавить("УКД_2020", НСтр("ru = 'УКД 2020 (информация продавца)'"));
	
	Если Не ЗначениеЗаполнено(ФорматДокумента) Тогда
		ФорматДокумента = "УПД_5_03";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьПросмотр(Команда)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите документ-основание.'"), , "ДокументОснование");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФорматДокумента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите формат.'"), , "ФорматДокумента");
		Возврат;
	КонецЕсли;
	
	РезультатПодготовки = ПодготовитьФайлДляПросмотраНаСервере();
	ТекстДиагностики = РезультатПодготовки.ТекстДиагностики;
	
	Если Не РезультатПодготовки.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПодготовки.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ПараметрыПросмотра = ИнтерфейсДокументовЭДОКлиент.НовыеПараметрыФормыПросмотраЗагрузкиЭлектронныхДокументов();
	ПараметрыПросмотра.АдресХранилищаФайла = РезультатПодготовки.АдресФайла;
	ПараметрыПросмотра.ИмяФайла = РезультатПодготовки.ИмяФайла;
	ПараметрыПросмотра.НаправлениеЭД = ПредопределенноеЗначение("Перечисление.НаправленияЭДО.Исходящий");
	ПараметрыПросмотра.ВладелецЭД = ДокументОснование;
	ПараметрыПросмотра.УникальныйИдентификатор = УникальныйИдентификатор;
	ПараметрыПросмотра.ФайлАрхива = Ложь;
	
	ОткрытьФорму("Обработка.ИнтерфейсДокументовЭДО.Форма.ЗагрузкаПросмотрЭлектронногоДокумента",
		Новый Структура("СтруктураЭД", ПараметрыПросмотра),
		ЭтотОбъект,
		ПараметрыПросмотра.УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьФайлДляПросмотраНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("АдресФайла", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстДиагностики", "");
	
	Попытка
		ДанныеЗаполнения = СформироватьДанныеЭлектронногоДокумента(ДокументОснование, ФорматДокумента);
	Исключение
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.ТекстДиагностики = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Если ДанныеЗаполнения.Отказ Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Заполнение данных электронного документа завершилось отказом.'");
		Результат.ТекстДиагностики = ДанныеЗаполнения.ТекстДиагностики;
		Возврат Результат;
	КонецЕсли;
	
	РезультатФормирования = ФорматыЭДО.СформироватьДокумент(ДанныеЗаполнения.ИдентификаторФормата, ДанныеЗаполнения.ДеревоДанных);
	Если ЗначениеЗаполнено(РезультатФормирования.Ошибки) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось сформировать XML электронного документа. См. диагностику.'");
		Результат.ТекстДиагностики = ТекстОшибокФормирования(РезультатФормирования.Ошибки)
			+ Символы.ПС + Символы.ПС + ДанныеЗаполнения.ТекстДиагностики;
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеФайла = РезультатФормирования.Документ;
	Если Не ЗначениеЗаполнено(ОписаниеФайла) Или ОписаниеФайла.ДвоичныеДанные = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'XML электронного документа не сформирован.'");
		Результат.ТекстДиагностики = ДанныеЗаполнения.ТекстДиагностики;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.АдресФайла = ПоместитьВоВременноеХранилище(ОписаниеФайла.ДвоичныеДанные, УникальныйИдентификатор);
	Результат.ИмяФайла = ?(ЗначениеЗаполнено(ОписаниеФайла.ИмяФайла), ОписаниеФайла.ИмяФайла, "ON_NSCHFDOPPR.xml");
	Результат.ТекстДиагностики = ДанныеЗаполнения.ТекстДиагностики;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СформироватьДанныеЭлектронногоДокумента(Основание, КодФормата)
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ДеревоДанных", Неопределено);
	Результат.Вставить("ИдентификаторФормата", "");
	Результат.Вставить("ТекстДиагностики", "");
	
	ПоддерживаемыеФорматы = ОбменСКонтрагентамиУТ.ПоддерживаемыеФорматы();
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	РеквизитыОснования = РеквизитыОснованияДляЭДО(Основание);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Отправитель", РеквизитыОснования.Организация);
	Настройки.Вставить("Получатель", РеквизитыОснования.Контрагент);
	Настройки.Вставить("Договор", РеквизитыОснования.Договор);
	Настройки.Вставить("ВариантыЗаполненияПолей", Новый Структура("ТоварКод", ""));
	
	Описание = Новый Структура;
	Описание.Вставить("Основания", Новый Массив);
	
	Отказ = Ложь;
	
	Если КодФормата = "УКД_2020" Тогда
		
		Настройки.Вставить("ТипДокумента", ТипыДокументов.УКД);
		Результат.ИдентификаторФормата = ПоддерживаемыеФорматы.УКД2020.ИнформацияПродавца;
		ДеревоДанных = ДеревоЭлектронногоДокументаБЭД.ДеревоЭлектронногоДокумента(
			"ОбменСКонтрагентами.УКД_ИнформацияПродавца_2020");
		ОбменСКонтрагентамиУТ.ЗаполнитьДанныеУКД2020_ИнформацияПродавца(
			Основание, Настройки, ДеревоДанных, Описание, Отказ);
		
	Иначе
		
		Настройки.Вставить("ТипДокумента", ТипыДокументов.УПД);
		Настройки.Вставить("Формат", ПоддерживаемыеФорматы.УПД_5_03.ИнформацияПродавца);
		Результат.ИдентификаторФормата = ПоддерживаемыеФорматы.УПД_5_03.ИнформацияПродавца;
		ДеревоДанных = ДеревоЭлектронногоДокументаБЭД.ДеревоЭлектронногоДокумента(
			"ОбменСКонтрагентами.УПД_ИнформацияПродавца_5_03");
		ОбменСКонтрагентамиУТ.ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца(
			Основание, Настройки, ДеревоДанных, Описание, Отказ);
		
	КонецЕсли;
	
	Результат.Отказ = Отказ;
	Результат.ДеревоДанных = ДеревоДанных;
	Результат.ТекстДиагностики = ТекстДиагностикиДопПолей(ДеревоДанных, КодФормата = "УКД_2020");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция РеквизитыОснованияДляЭДО(Основание)
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("Договор", Неопределено);
	
	ИменаРеквизитов = Новый Массив;
	МетаданныеОснования = Основание.Метаданные();
	Если МетаданныеОснования.Реквизиты.Найти("Организация") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Организация");
	КонецЕсли;
	Если МетаданныеОснования.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Контрагент");
	КонецЕсли;
	Если МетаданныеОснования.Реквизиты.Найти("Договор") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Договор");
	ИначеЕсли МетаданныеОснования.Реквизиты.Найти("ДоговорКонтрагента") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	
	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, СтрСоединить(ИменаРеквизитов, ","));
	Если ЗначенияРеквизитов.Свойство("Организация") Тогда
		Результат.Организация = ЗначенияРеквизитов.Организация;
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("Контрагент") Тогда
		Результат.Контрагент = ЗначенияРеквизитов.Контрагент;
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("Договор") Тогда
		Результат.Договор = ЗначенияРеквизитов.Договор;
	ИначеЕсли ЗначенияРеквизитов.Свойство("ДоговорКонтрагента") Тогда
		Результат.Договор = ЗначенияРеквизитов.ДоговорКонтрагента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстДиагностикиДопПолей(ДеревоДанных, ЭтоКорректировка)
	
	СтрокиДиагностики = Новый Массив;
	СтрокиДиагностики.Добавить(НСтр("ru = 'Дополнительные поля шапки:'"));
	
	Если ЭтоКорректировка Тогда
		ПутьШапки = "ДопДанныеСчетаФактуры.ТекстоваяИнформация";
		ПутьТоваров = "СведенияОТоварах";
	ИначеЕсли ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация") Тогда
		ПутьШапки = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
		ПутьТоваров = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	Иначе
		ПутьШапки = "ДопДанныеСчетаФактуры.ТекстоваяИнформация";
		ПутьТоваров = "СведенияОТоварах";
	КонецЕсли;
	
	Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, ПутьШапки) Тогда
		ТаблицаШапки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьШапки);
		Если ТаблицаШапки.Количество() = 0 Тогда
			СтрокиДиагностики.Добавить(НСтр("ru = '  (нет)'"));
		Иначе
			Для Каждого СтрокаПоля Из ТаблицаШапки Цикл
				СтрокиДиагностики.Добавить(СтрШаблон("  %1 = %2", СтрокаПоля.Идентификатор, СтрокаПоля.Значение));
			КонецЦикла;
		КонецЕсли;
	Иначе
		СтрокиДиагностики.Добавить(НСтр("ru = '  (путь шапки не найден)'"));
	КонецЕсли;
	
	СтрокиДиагностики.Добавить("");
	СтрокиДиагностики.Добавить(НСтр("ru = 'Дополнительные поля строк:'"));
	
	УзелТоваров = ДеревоДанных.Строки.Найти(ПутьТоваров, "ПолныйПуть", Истина);
	Если УзелТоваров = Неопределено Или Не ЗначениеЗаполнено(УзелТоваров.Значение) Тогда
		СтрокиДиагностики.Добавить(НСтр("ru = '  (нет строк товаров)'"));
		Возврат СтрСоединить(СтрокиДиагностики, Символы.ПС);
	КонецЕсли;
	
	ЕстьПоляСтрок = Ложь;
	Для Каждого СтрокаТовара Из УзелТоваров.Строки Цикл
		Если ТипЗнч(СтрокаТовара.Значение) <> Тип("Число") Или СтрокаТовара.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьДопДанных = СтрокаТовара.ПолныйПуть + ".ДопДанныеПодписанные";
		УзелДопДанных = СтрокаТовара.Строки.Найти(ПутьДопДанных, "ПолныйПуть", Истина);
		Если УзелДопДанных = Неопределено Или Не ЗначениеЗаполнено(УзелДопДанных.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаДопДанных Из УзелДопДанных.Строки Цикл
			Если ТипЗнч(СтрокаДопДанных.Значение) <> Тип("Число") Или СтрокаДопДанных.Значение = 0 Тогда
				Продолжить;
			КонецЕсли;
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаДопДанных, ПутьДопДанных + ".НомерСтроки.Идентификатор", Ложь);
			Значение = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаДопДанных, ПутьДопДанных + ".НомерСтроки.Значение", Ложь);
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				ЕстьПоляСтрок = Истина;
				СтрокиДиагностики.Добавить(СтрШаблон("  [%1] %2 = %3",
					СтрокаТовара.Значение, Идентификатор, Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Не ЕстьПоляСтрок Тогда
		СтрокиДиагностики.Добавить(НСтр("ru = '  (нет)'"));
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиДиагностики, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ТекстОшибокФормирования(Ошибки)
	
	СтрокиОшибок = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
			СтрокиОшибок.Добавить(Ошибка);
		ИначеЕсли ТипЗнч(Ошибка) = Тип("Структура") Тогда
			Текст = "";
			Если Ошибка.Свойство("ТекстОшибки", Текст) И ЗначениеЗаполнено(Текст) Тогда
				СтрокиОшибок.Добавить(Текст);
			ИначеЕсли Ошибка.Свойство("Текст", Текст) И ЗначениеЗаполнено(Текст) Тогда
				СтрокиОшибок.Добавить(Текст);
			Иначе
				СтрокиОшибок.Добавить(Строка(Ошибка));
			КонецЕсли;
		Иначе
			СтрокиОшибок.Добавить(Строка(Ошибка));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиОшибок, Символы.ПС);
	
КонецФункции

#КонецОбласти

// --- 1 Бит Балицкий
